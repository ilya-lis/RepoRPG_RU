		private void BuyBack(BuybackEntry b)
		{
			BuybackEntry entry = b;
			Buy("buyback:" + b.uid, "buy back " + b.item.name, b.price, delegate
			{
				RunSave data = _store.Data;
				if (data.buyback.Contains(entry))
				{
					data.buyback.Remove(entry);
					GearItem item = entry.item;
					item.uid = Guid.NewGuid().ToString("N").Substring(0, 12);
					item.freeValue = 0;
					item.scrapIn = Mathf.Max(0, _lastCharged);
					GiveGear(item, "buyback");
				}
			});
		}

		private static GearItem CloneGear(GearItem g)
		{
			return new GearItem
			{
				uid = g.uid,
				name = g.name,
				slot = g.slot,
				rarity = g.rarity,
				unique = g.unique,
				uniqueDesc = g.uniqueDesc,
				effects = (EffectDef[])g.effects.Clone(),
				set = g.set,
				crafts = g.crafts,
				rarityUps = g.rarityUps,
				hasBase = g.hasBase,
				behavior = g.behavior,
				flavor = g.flavor,
				attune = g.attune,
				sockets = g.sockets,
				modules = (string[])g.modules.Clone(),
				hidden = g.hidden,
				freeValue = g.freeValue,
				scrapIn = g.scrapIn
			};
		}

		private void NoteBuyback(GearItem g, int scrap)
		{
			if (Game.InShopLevel())
			{
				GearItem gearItem = new GearItem
				{
					uid = g.uid,
					name = g.name,
					slot = g.slot,
					rarity = g.rarity,
					unique = g.unique,
					uniqueDesc = g.uniqueDesc,
					effects = g.effects,
					set = g.set,
					crafts = g.crafts,
					rarityUps = g.rarityUps,
					hasBase = g.hasBase,
					behavior = g.behavior,
					flavor = g.flavor,
					attune = g.attune,
					sockets = g.sockets,
					modules = new string[g.sockets],
					hidden = g.hidden
				};
				for (int i = 0; i < gearItem.modules.Length; i++)
				{
					gearItem.modules[i] = "";
				}
				List<BuybackEntry> buyback = _store.Data.buyback;
				buyback.Add(new BuybackEntry
				{
					item = gearItem,
					price = Mathf.Max(0, scrap),
					uid = g.uid
				});
				if (buyback.Count > 12)
				{
					buyback.RemoveAt(0);
				}
			}
		}

		public void ServiceAffix(GearItem g, int line)
		{
			//IL_0037: Unknown result type (might be due to invalid IL or missing references)
			if (g.crafts >= Mathf.Max(1, Plugin.Cfg.MaxCraftsPerItem.Value))
			{
				Toast("This item has had all its crafts", Bad);
				return;
			}
			string uid = g.uid;
			Buy("svc:affix", "affix reroll on " + g.name, ShopX.BasePrice("svc:affix"), delegate
			{
				//IL_021b: Unknown result type (might be due to invalid IL or missing references)
				GearItem it = _store.Data.FindItem(uid);
				int num = ((it == null) ? (-1) : Plugin.Rpg.SlotIndex(it.slot));
				if (it != null && num >= 0 && line >= 0 && line < it.effects.Length)
				{
					List<AffixDef> list = new List<AffixDef>(Plugin.Rpg.slots[num].affixes);
					list.RemoveAll((AffixDef a) => Array.Exists(it.effects, (EffectDef e) => string.Equals(e.stat, a.stat, StringComparison.OrdinalIgnoreCase)));
					if (list.Count != 0)
					{
						Random random = new Random();
						AffixDef affixDef = list[random.Next(list.Count)];
						double num2 = ((double)affixDef.min + (double)(affixDef.max - affixDef.min) * random.NextDouble()) * (double)Gear.Rarity(it.rarity).mult;
						float num3 = ((Math.Abs(affixDef.max) >= 1.5f) ? ((float)Math.Round(num2)) : ((float)Math.Round(num2, 2)));
						if (num3 == 0f)
						{
							num3 = ((affixDef.max >= 0f) ? 1f : (-1f));
						}
						it.effects[line] = new EffectDef
						{
							stat = affixDef.stat,
							value = num3
						};
						ClassDatabase.ResolveAll("gear " + it.name, it.effects);
						it.crafts++;
						_statsDirty = true;
						_store.MarkDirty();
						_gearSig = int.MinValue;
						Notify(PopupKind.Loot, "Rerolled a line on " + it.name + ": " + StatInfo.Describe((Stat)it.effects[line].StatIndex, num3), RarityCol(it));
					}
				}
			});
		}

		public void ServiceAttune(GearItem g)
		{
			//IL_0030: Unknown result type (might be due to invalid IL or missing references)
			//IL_0057: Unknown result type (might be due to invalid IL or missing references)
			if (_store.Data.attuneBoosted.Contains(g.uid))
			{
				Toast("Once per item per visit", Bad);
				return;
			}
			if (g.attune >= GearX.TierAt[2] - 1)
			{
				Toast("Soulbound has to be earned", Bad);
				return;
			}
			string uid = g.uid;
			Buy("svc:attune", "attunement boost on " + g.name, ShopX.BasePrice("svc:attune"), delegate
			{
				//IL_00be: Unknown result type (might be due to invalid IL or missing references)
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem != null)
				{
					int num = GearX.Tier(gearItem);
					gearItem.attune = Mathf.Min(gearItem.attune + 20, GearX.TierAt[2] - 1);
					if (GearX.Tier(gearItem) >= 1 && gearItem.hidden.Length == 0)
					{
						RollHidden(gearItem);
					}
					_store.Data.attuneBoosted.Add(gearItem.uid);
					if (GearX.Tier(gearItem) > num)
					{
						Notify(PopupKind.Loot, gearItem.name + " is " + GearX.TierNames[GearX.Tier(gearItem) - 1] + "!", (Color?)new Color(1f, 0.85f, 0.35f), "");
					}
					_statsDirty = true;
					_store.MarkDirty();
					_gearSig = int.MinValue;
				}
			});
		}

		public void ServicePartsUp(GearItem g)
		{
			if (g.unique != "" || g.rarity >= 3 || g.rarityUps >= Mathf.Max(0, Plugin.Cfg.MaxRarityUpgrades.Value) || !CanAfford(PartsUpCost))
			{
				MenuSound(UiSound.Error);
				return;
			}
			string uid = g.uid;
			Buy("svc:partsup", "parts upgrade on " + g.name, ShopX.BasePrice("svc:partsup"), delegate
			{
				//IL_004b: Unknown result type (might be due to invalid IL or missing references)
				//IL_0326: Unknown result type (might be due to invalid IL or missing references)
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem == null || gearItem.rarity >= 3 || !CanAfford(PartsUpCost))
				{
					Toast("Parts upgrade couldn't finish (item or parts gone) - nothing changed", Bad, 4f);
				}
				else
				{
					int[] parts = Parts;
					for (int i = 0; i < 4; i++)
					{
						parts[i] -= PartsUpCost[i];
					}
					int num = gearItem.rarity + 1;
					float num2 = Gear.Rarity(num).mult / Mathf.Max(0.01f, Gear.Rarity(gearItem.rarity).mult);
					List<EffectDef> list = new List<EffectDef>();
					EffectDef[] effects = gearItem.effects;
					foreach (EffectDef effectDef in effects)
					{
						list.Add(new EffectDef
						{
							stat = effectDef.stat,
							value = (effectDef.stat.StartsWith("gear.") ? effectDef.value : ((Math.Abs(effectDef.value) >= 1.5f) ? Mathf.Round(effectDef.value * num2) : ((float)Math.Round(effectDef.value * num2, 2))))
						});
					}
					int num3 = Plugin.Rpg.SlotIndex(gearItem.slot);
					if (num3 >= 0)
					{
						List<AffixDef> list2 = new List<AffixDef>(Plugin.Rpg.slots[num3].affixes);
						list2.RemoveAll((AffixDef a) => list.Exists((EffectDef e) => string.Equals(e.stat, a.stat, StringComparison.OrdinalIgnoreCase)));
						Random random = new Random();
						if (list2.Count > 0 && list.Count < Gear.Rarity(num).affixes)
						{
							AffixDef affixDef = list2[random.Next(list2.Count)];
							double num4 = ((double)affixDef.min + (double)(affixDef.max - affixDef.min) * random.NextDouble()) * (double)Gear.Rarity(num).mult;
							list.Add(new EffectDef
							{
								stat = affixDef.stat,
								value = ((Math.Abs(affixDef.max) >= 1.5f) ? ((float)Math.Round(num4)) : ((float)Math.Round(num4, 2)))
							});
						}
					}
					gearItem.effects = list.ToArray();
					ClassDatabase.ResolveAll("gear " + gearItem.name, gearItem.effects);
					gearItem.rarity = num;
					gearItem.rarityUps++;
					if (num >= 3 && gearItem.sockets == 0)
					{
						gearItem.sockets = 1;
						gearItem.modules = new string[1] { "" };
					}
					_statsDirty = true;
					_store.MarkDirty();
					_gearSig = int.MinValue;
					Notify(PopupKind.Loot, "Upgraded " + gearItem.name + " to " + Gear.Rarity(num).name, RarityCol(gearItem));
				}
			});
		}

		private void CartAdd(string label, string key, int price, Action buy)
		{
			//IL_002c: Unknown result type (might be due to invalid IL or missing references)
			if (_cart.Exists(((string label, string key, int price, Action buy) c) => c.label == label))
			{
				Toast("Already in the cart", Color.gray);
				return;
			}
			_cart.Add((label, key, price, buy));
			MenuSound(UiSound.Click);
		}

		private int CartTotal()
		{
			int num = 0;
			foreach (var item in _cart)
			{
				num += Shop.Price(item.price);
			}
			return num;
		}

		private void BuyCart()
		{
			//IL_004d: Unknown result type (might be due to invalid IL or missing references)
			if (_cart.Count == 0)
			{
				return;
			}
			if (Scrap.Mine + 1E-06 < (double)CartTotal())
			{
				Vendor(ShopX.VendorBroke);
				MenuSound(UiSound.Error);
				Toast("The cart costs " + Scrap.Price(CartTotal()), Bad);
				return;
			}
			List<string> list = new List<string>();
			foreach (var item in _cart)
			{
				list.Add("  • " + item.label + "  " + Scrap.Price(Shop.Price(item.price)));
			}
			AskPurchase("BUY THE CART?", string.Format("Buy {0} item{1} for {2}?\n", _cart.Count, (_cart.Count == 1) ? "" : "s", Scrap.Price(CartTotal())) + string.Join("\n", list), delegate
			{
				foreach (var item2 in _cart)
				{
					_cartQueue.Enqueue(item2.buy);
				}
				_cart.Clear();
				_nextCartBuy = 0f;
			});
		}

		private void ResetSignature()
		{
			_momentum = 0;
			_frenzy = 0;
			_frenzyEnd = 0f;
			_shadowstepEnd = 0f;
			_scar = 0f;
			_rallyEnd = 0f;
			_saveHeal = 0;
			_saveHealAt = 0f;
			_stats.ClearDyn();
		}

		private void TickSignature(PlayerAvatar local)
		{
			float time = Time.time;
			float num = _stats[Stat.MomentumPower];
			int num2 = MomentumCap();
			if (num > 0f && num2 > 0)
			{
				PlayerController instance = PlayerController.instance;
				bool flag = (Object)(object)instance != (Object)null && Game.Get(instance, "sprinting", fallback: false);
				if (flag)
				{
					if (!_wasSprinting)
					{
						_momentumNext = time + 1f;
					}
					_lastSprint = time;
					if (_momentum < num2 && time >= _momentumNext)
					{
						_momentum++;
						_momentumNext = time + 1f;
					}
				}
				else if (_momentum > 0 && time - _lastSprint > 1f + _stats[Stat.MomentumGrace])
				{
					_momentum = 0;
				}
				_wasSprinting = flag;
				if (_momentum > num2)
				{
					_momentum = num2;
				}
			}
			else
			{
				_momentum = 0;
			}
			if (_frenzy > 0 && time >= _frenzyEnd)
			{
				_frenzy = 0;
			}
			_stats.ClearDyn();
			if (_momentum > 0)
			{
				_stats.AddDyn(Stat.SprintSpeed, (float)_momentum * num);
			}
			if (_frenzy > 0)
			{
				float v = (float)_frenzy * _stats.Perm(Stat.FrenzyPower);
				_stats.AddDyn(Stat.ThrowStrength, v);
				_stats.AddDyn(Stat.WeaponDamage, v);
				_stats.AddDyn(Stat.MoveSpeed, (float)_frenzy * 2f);
				_stats.AddDyn(Stat.SprintSpeed, (float)_frenzy * 2f);
			}
			if (time < _rallyEnd)
			{
				float v2 = _stats.Custom("survivor.save_speed");
				_stats.AddDyn(Stat.MoveSpeed, v2);
				_stats.AddDyn(Stat.SprintSpeed, v2);
			}
			if (_saveHeal > 0 && time >= _saveHealAt && (Object)(object)local.playerHealth != (Object)null)
			{
				Game.HealSelf(local.playerHealth, _saveHeal);
				NoteHeal(_saveHeal, HealKind.Instant, "Last Stand");
				_saveHeal = 0;
			}
			if (time < _shadowstepEnd)
			{
				float v3 = _stats[Stat.ShadowstepSpeed];
				_stats.AddDyn(Stat.MoveSpeed, v3);
				_stats.AddDyn(Stat.SprintSpeed, v3);
			}
			float num3 = _stats.Dyn(Stat.WeaponDamage);
			if (Mathf.Abs(num3 - _lastDynWeapon) > 0.01f)
			{
				_lastDynWeapon = num3;
				_nextCombatSend = 0f;
			}
			if (!(time >= _nextAuraLook))
			{
				return;
			}
			_nextAuraLook = time + 0.5f;
			_guardedBy = 0f;
			_linkRegen = 0f;
			foreach (var (aura, num4) in NearbyAuras(local))
			{
				if (aura.Guard > 0f && num4 <= aura.GuardRadius)
				{
					_guardedBy = Mathf.Max(_guardedBy, aura.Guard);
				}
				if (aura.Link > 0f && num4 <= aura.LinkRadius)
				{
					_linkRegen = Mathf.Max(_linkRegen, aura.Link);
				}
			}
			_guardedBy = Mathf.Min(_guardedBy, ShieldWallCap);
			_linkRegen = Mathf.Min(_linkRegen, 10f);
		}

		private void AddFrenzy()
		{
			//IL_00b8: Unknown result type (might be due to invalid IL or missing references)
			int num = Mathf.Clamp(Mathf.RoundToInt(_stats[Stat.FrenzyMax]), 0, 8);
			if (num > 0 && !(_stats[Stat.FrenzyPower] <= 0f))
			{
				bool num2 = _frenzy < num;
				_frenzy = Mathf.Min(num, _frenzy + 1);
				_frenzyEnd = Time.time + 15f;
				if (num2 && _frenzy == num && CurrentId == "brute")
				{
					CEv("cls.brute");
				}
				if (num2)
				{
					Toast($"Frenzy x{_frenzy}", new Color(1f, 0.35f, 0.3f), 1.5f);
				}
			}
		}

		private void OnDodged()
		{
			if (_stats[Stat.ShadowstepSpeed] > 0f)
			{
				_shadowstepEnd = Time.time + 3f + MisdirectionSeconds();
			}
			PartsOnDodge();
			AttrOnDodged();
			GearOnDodged();
			float num = Mathf.Clamp(ClassStat("phantom.alt_after"), 0f, 4f);
			if (num > 0f)
			{
				AddSelfDyn(Stat.NoiseReduction, 100f, num);
				_nextCombatSend = 0f;
			}
			float num2 = _stats[Stat.DodgeRefund];
			if (num2 > 0f && _cooldownEnd > 0f && Time.time - _lastDodgeRefund >= 1f)
			{
				_lastDodgeRefund = Time.time;
				_cooldownEnd -= num2;
			}
		}

		private float SignatureDamageMult(PlayerAvatar local, PlayerHealth ph)
		{
			float num = 1f;
			if (_stats[Stat.ScarTissue] > 0f)
			{
				num *= 1f - Mathf.Clamp(_scar, 0f, Plugin.Cfg.MaxScarTissue.Value) / 100f;
			}
			int num2 = Game.MaxHealth(ph);
			bool flag = num2 > 0 && (float)Game.Health(ph) < (float)num2 * 0.3f;
			float num3 = 0f;
			float num4 = 0f;
			_guardActor = -1;
			foreach (var (aura, num5) in NearbyAuras(local))
			{
				if (aura.Guard > 0f && num5 <= aura.GuardRadius && aura.Guard > num3)
				{
					num3 = aura.Guard;
					_guardActor = aura.Actor;
				}
				if (flag && aura.Stabilize > 0f && num5 <= aura.StabilizeRadius)
				{
					num4 = Mathf.Max(num4, aura.Stabilize);
				}
			}
			_guardPct = Mathf.Clamp(num3, 0f, ShieldWallCap);
			num *= 1f - _guardPct / 100f;
			return num * (1f - Mathf.Clamp(num4, 0f, Plugin.Cfg.MaxStabilize.Value) / 100f);
		}

		private void AddScar()
		{
			AddScar(_stats[Stat.ScarTissue]);
		}

		private void AddScar(float amount)
		{
			if (!(amount <= 0f) && !(_stats[Stat.ScarTissue] <= 0f))
			{
				float num = Mathf.Min(_stats[Stat.ScarTissueMax], Plugin.Cfg.MaxScarTissue.Value);
				_scar = Mathf.Min(num, _scar + amount);
			}
		}

		private void FillMomentum()
		{
			_momentum = Mathf.Clamp(Mathf.RoundToInt(_stats[Stat.MomentumMax]), 0, 12);
			_lastSprint = Time.time;
		}

		private void OnDeathSave()
		{
			int num = Mathf.RoundToInt(Mathf.Clamp(_stats.Custom("survivor.save_heal"), 0f, 60f));
			if (num > 0)
			{
				_saveHeal = num;
				_saveHealAt = Time.time + 0.3f;
			}
			if (_stats.Custom("survivor.save_speed") > 0f)
			{
				_rallyEnd = Time.time + 5f;
			}
		}

		public Aura LocalAura()
		{
			return new Aura
			{
				Guard = Mathf.Clamp(Mathf.Clamp(_stats.Perm(Stat.GuardAura) + _stats.Dyn(Stat.GuardAura), 0f, Plugin.Cfg.MaxShieldWall.Value) + Mathf.Max(0f, _stats.Temp(Stat.GuardAura)), 0f, ShieldWallCap),
				GuardRadius = Mathf.Clamp(_stats[Stat.GuardRadius], 0f, 25f),
				Stabilize = Mathf.Clamp(_stats[Stat.StabilizeAura], 0f, Plugin.Cfg.MaxStabilize.Value),
				StabilizeRadius = Mathf.Clamp(_stats[Stat.AuraRadius], 0f, 25f),
				Link = Mathf.Clamp(_stats[Stat.LinkStamina], 0f, 10f),
				LinkRadius = Mathf.Clamp(_stats[Stat.LinkRadius], 0f, 25f),
				Inspire = ((CurrentId == "herald") ? Mathf.Clamp(_inspire, 0f, 100f) : 0f),
				InspireRadius = Mathf.Clamp(ClassStat("herald.inspire_radius"), 0f, 25f),
				InspireSpeed = Mathf.Clamp(ClassStat("herald.inspire_speed"), 0f, 40f),
				InspireGrip = Mathf.Clamp(ClassStat("herald.inspire_grip"), 0f, 60f)
			};
		}

		private void SendAuraIfNeeded()
		{
			Aura a = LocalAura();
			bool flag = a.Guard > 0f || a.Stabilize > 0f || a.Link > 0f || a.Inspire > 0f;
			if (flag || _auraSentNonZero)
			{
				_auraSentNonZero = flag;
				Net.SendAura(a);
			}
		}

		public void OnAura(int actor, Aura a)
		{
			a.At = Time.time;
			a.Actor = actor;
			if (a.Guard <= 0f && a.Stabilize <= 0f && a.Link <= 0f && a.Inspire <= 0f)
			{
				_auras.Remove(actor);
			}
			else
			{
				_auras[actor] = a;
			}
		}

		private IEnumerable<(Aura aura, float dist)> NearbyAuras(PlayerAvatar local)
		{
			if (_auras.Count == 0)
			{
				yield break;
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && !((Object)(object)item == (Object)(object)local) && Game.IsAlive(item))
				{
					int key = Game.ActorNumber(item);
					if (_auras.TryGetValue(key, out var value) && !(Time.time - value.At > 90f))
					{
						yield return (aura: value, dist: Vector3.Distance(((Component)item).transform.position, ((Component)local).transform.position));
					}
				}
			}
		}

		private void SignatureHudLines(List<(string, Color)> lines)
		{
			//IL_00de: Unknown result type (might be due to invalid IL or missing references)
			//IL_0125: Unknown result type (might be due to invalid IL or missing references)
			//IL_0086: Unknown result type (might be due to invalid IL or missing references)
			//IL_0070: Unknown result type (might be due to invalid IL or missing references)
			//IL_01bb: Unknown result type (might be due to invalid IL or missing references)
			//IL_017a: Unknown result type (might be due to invalid IL or missing references)
			//IL_01fc: Unknown result type (might be due to invalid IL or missing references)
			int num = MomentumCap();
			if (num > 0 && _stats[Stat.MomentumPower] > 0f)
			{
				lines.Add(($"Momentum {_momentum}/{num}  (+{(float)_momentum * _stats[Stat.MomentumPower]:0}% sprint)", (_momentum >= num) ? new Color(0.4f, 0.85f, 1f) : new Color(0.6f, 0.75f, 0.85f)));
			}
			if (_frenzy > 0)
			{
				lines.Add(($"Frenzy x{_frenzy}  {Mathf.Max(0f, _frenzyEnd - Time.time):0}s", new Color(1f, 0.4f, 0.35f)));
			}
			if (Time.time < _shadowstepEnd)
			{
				lines.Add(($"Shadowstep  {_shadowstepEnd - Time.time:0.0}s", new Color(0.7f, 0.75f, 0.95f)));
			}
			if (_stats[Stat.ScarTissue] > 0f && _scar > 0f)
			{
				lines.Add(($"Scar Tissue  -{_scar:0.#}% damage", new Color(0.65f, 0.8f, 0.45f)));
			}
			if (_guardedBy > 0f)
			{
				lines.Add(($"Shield Wall  -{_guardedBy:0}% damage", new Color(1f, 0.75f, 0.35f)));
			}
			if (_linkRegen > 0f)
			{
				lines.Add(($"Power Link  +{_linkRegen:0.#} stamina/s", new Color(0.7f, 0.6f, 1f)));
			}
			NewClassHudLines(lines);
		}

		private void StaminaDiag(PlayerController pc, float maxBonus, float drainPct)
		{
			bool num = Game.Get(pc, "sprinting", fallback: false);
			float unscaledTime = Time.unscaledTime;
			float num2 = Game.Get(pc, "EnergyCurrent", 0f);
			if (!num || num2 <= 0f)
			{
				_stDiagStartE = -1f;
				return;
			}
			if (_stDiagStartE < 0f)
			{
				_stDiagStartE = num2;
				_stDiagStartT = unscaledTime;
				_stDiagFrames = 0f;
				_stDiagAt = unscaledTime + 2f;
				return;
			}
			_stDiagFrames += 1f;
			if (!(unscaledTime < _stDiagAt))
			{
				float num3 = Mathf.Max(0.01f, unscaledTime - _stDiagStartT);
				float num4 = (_stDiagStartE - num2) / num3;
				Plugin.Log.LogInfo((object)(string.Format("[stamina] sprinting {0:0.0}s: max {1:0.0} (bonus {2:0}% of {3:0}%, cap {4:0}%), ", num3, Game.Get(pc, "EnergyStart", 0f), maxBonus, _stats[Stat.MaxStamina], Plugin.Cfg.MaxStaminaBonus.Value) + string.Format("now {0:0.0}, measured drain {1:0.00}/s, game drain {2:0.00}+{3:0.00}/s ", num2, num4, Game.Get(pc, "EnergySprintDrain", 0f), Game.Get(pc, "SprintSpeedUpgrades", 0f)) + string.Format("(drain change {0:0}% of {1:0}% sprint / {2:0}% carrying, cap -{3:0}%{4}), ", drainPct, _stats[Stat.StaminaDrain], _stats[Stat.HoldingStaminaDrain], Plugin.Cfg.MaxStaminaDrainReduction.Value, _featherFree ? ", Featherlight free" : "") + string.Format("sprint drain vanilla {0:0.###} -> upgrade mods {1:0.###} -> used {2:0.###}/s (RepoRPG x{3:0.###}, floor {4:0}%{5}), ", SprintDrain.Vanilla, SprintDrain.LastGame, SprintDrain.LastUsed, SprintDrain.RpgMult, SprintDrain.FloorPct, SprintDrain.LastFloored ? " reached" : "") + $"regen bonus {StaminaRegenBonus:0.0}/s (only while recharging), {_stDiagFrames / num3:0} FPS. {Upgrades.StaminaLevelsText(Game.SteamId(Game.LocalPlayer()))}"));
				_stDiagStartE = num2;
				_stDiagStartT = unscaledTime;
				_stDiagFrames = 0f;
				_stDiagAt = unscaledTime + 2f;
			}
		}

		private void StartUnstickWatch(string why, float seconds)
		{
			float unscaledTime = Time.unscaledTime;
			if (!(_vuUntil >= unscaledTime))
			{
				_vuSince.Clear();
				_vuDone.Clear();
				_vuSnap = false;
				_vuStart = unscaledTime;
				_vuWhy = why;
			}
			else if (!_vuWhy.StartsWith("a late join") || why.StartsWith("a late join"))
			{
				_vuWhy = why;
			}
			_vuUntil = Mathf.Max(_vuUntil, unscaledTime + seconds);
		}

		private static void NoteSceneForUnstick()
		{
			if ((Object)(object)Instance != (Object)null)
			{
				Instance._vuSceneSerial++;
			}
		}

		private void TickUnstick()
		{
			//IL_0066: Unknown result type (might be due to invalid IL or missing references)
			//IL_006c: Invalid comparison between Unknown and I4
			float unscaledTime = Time.unscaledTime;
			if (unscaledTime < _vuNext)
			{
				return;
			}
			_vuNext = unscaledTime + 0.5f;
			if ((!Game.InLevel() && !Game.InLobby() && !Game.InShopLevel()) || (Game.InLevel() && Game.IsLoading()) || _transitioning)
			{
				_vuSince.Clear();
				return;
			}
			GameDirector instance = GameDirector.instance;
			if ((Object)(object)instance == (Object)null || (int)instance.currentState != 2)
			{
				_vuSince.Clear();
				return;
			}
			if (_vuScene != _vuSceneSerial)
			{
				_vuScene = _vuSceneSerial;
				bool flag = _vuUntil >= unscaledTime && _vuWhy.StartsWith("a late join");
				StartUnstickWatch(flag ? _vuWhy : "a new scene", 60f);
				_vuStart = unscaledTime;
				_vuSince.Clear();
				_vuDone.Clear();
				_vuSnap = false;
				if (flag)
				{
					Plugin.Log.LogInfo((object)"[late join] the scene is live here (the game's level state is Main); watching the game's own state.");
				}
			}
			if (unscaledTime >= _vuUntil)
			{
				return;
			}
			if (_menuOpen || _dialogOpen)
			{
				_vuSince.Clear();
				return;
			}
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val == (Object)null || !Game.Get(val, "spawned", fallback: false) || Game.Get(val, "isDisabled", fallback: false))
			{
				return;
			}
			try
			{
				CheckVanillaState(unscaledTime);
			}
			catch (Exception ex)
			{
				Game.WarnOnce("[unstick] couldn't read the game's state: " + ex.GetBaseException().Message);
				_vuUntil = 0f;
			}
		}

		private static FieldInfo? F(Type? t, string n)
		{
			if (!(t == null))
			{
				return AccessTools.Field(t, n);
			}
			return null;
		}

		private static object? UnstickVal(FieldInfo? f, object? o)
		{
			try
			{
				return (f == null || (o == null && !f.IsStatic)) ? null : f.GetValue(o);
			}
			catch
			{
				return null;
			}
		}

		private static float UnstickNum(FieldInfo? f, object? o)
		{
			object obj = UnstickVal(f, o);
			try
			{
				return (obj == null) ? 0f : Convert.ToSingle(obj);
			}
			catch
			{
				return 0f;
			}
		}

		private static bool UnstickFlag(FieldInfo? f, object? o)
		{
			object obj = UnstickVal(f, o);
			bool flag = default(bool);
			int num;
			if (obj is bool)
			{
				flag = (bool)obj;
				num = 1;
			}
			else
			{
				num = 0;
			}
			return (byte)((uint)num & (flag ? 1u : 0u)) != 0;
		}

		private static void Resolve()
		{
			if (!_vuResolved)
			{
				_vuResolved = true;
				_tMm = AccessTools.TypeByName("MenuManager");
				_tIm = AccessTools.TypeByName("InputManager");
				_tChat = AccessTools.TypeByName("ChatManager");
				_mmInst = F(_tMm, "instance");
				_mmState = F(_tMm, "currentMenuState");
				_mmPage = F(_tMm, "currentMenuPage");
				_mmText = F(_tMm, "textInputActive");
				_pageIndex = F(AccessTools.TypeByName("MenuPage"), "menuPageIndex");
				_imInst = F(_tIm, "instance");
				_imActions = F(_tIm, "inputSystemActions");
				_imMove = F(_tIm, "disableMovementTimer");
				_imExcept = F(_tIm, "disableControlsExceptTimer");
				_imInclude = F(_tIm, "disableControlsIncludeTimer");
				_chatInst = F(_tChat, "instance");
				_chatActive = F(_tChat, "chatActive");
				_chatState = F(_tChat, "chatState");
				_gdEsc = F(typeof(GameDirector), "disableEscMenuTimer");
				_gdDisable = F(typeof(GameDirector), "DisableInput");
				_gdDisableTimer = F(typeof(GameDirector), "DisableInputTimer");
				_pcInput = F(typeof(PlayerController), "InputDisableTimer");
				_closeAll = ((_tMm == null) ? null : AccessTools.Method(_tMm, "PageCloseAll", (Type[])null, (Type[])null));
				_toPlayer = ((_tIm == null) ? null : AccessTools.Method(_tIm, "SwitchToPlayerInputs", (Type[])null, (Type[])null));
				if (_imActions != null)
				{
					_actPlayer = AccessTools.Property(_imActions.FieldType, "Player");
					_actUi = AccessTools.Property(_imActions.FieldType, "UI");
				}
			}
		}

		private static bool? MapOn(PropertyInfo? map, object? actions)
		{
			try
			{
				if (map == null || actions == null)
				{
					return null;
				}
				object value = map.GetValue(actions);
				return ((value?.GetType().GetProperty("enabled"))?.GetValue(value) is bool value2) ? new bool?(value2) : ((bool?)null);
			}
			catch
			{
				return null;
			}
		}

		private VanillaState ReadVanilla()
		{
			Resolve();
			VanillaState result = new VanillaState
			{
				Page = ""
			};
			object obj = UnstickVal(_mmInst, null);
			if (obj != null)
			{
				object obj2 = UnstickVal(_mmState, obj);
				result.MenuOpen = obj2 != null && Convert.ToInt32(obj2) == 0;
				object? obj3 = UnstickVal(_mmPage, obj);
				Component val = (Component)((obj3 is Component) ? obj3 : null);
				if ((Object)(object)val != (Object)null)
				{
					object obj4 = UnstickVal(_pageIndex, val);
					result.Page = ((obj4 != null) ? obj4.ToString() : ((Object)val).name);
					result.PageVisible = val.gameObject.activeInHierarchy;
					result.MenuOnlyPage = MenuOnlyPages.Contains(result.Page);
				}
				result.TextInput = UnstickFlag(_mmText, obj);
			}
			object obj5 = UnstickVal(_imInst, null);
			if (obj5 != null)
			{
				object actions = UnstickVal(_imActions, obj5);
				result.PlayerMap = MapOn(_actPlayer, actions);
				result.UiMap = MapOn(_actUi, actions);
				result.MoveLock = UnstickNum(_imMove, obj5);
				result.ExceptLock = UnstickNum(_imExcept, obj5);
				result.IncludeLock = UnstickNum(_imInclude, obj5);
			}
			object obj6 = UnstickVal(_chatInst, null);
			if (obj6 != null)
			{
				result.ChatActive = UnstickFlag(_chatActive, obj6);
				object obj7 = UnstickVal(_chatState, obj6);
				result.ChatState = ((obj7 != null) ? Convert.ToInt32(obj7) : (-1));
			}
			GameDirector instance = GameDirector.instance;
			result.EscLock = UnstickNum(_gdEsc, instance);
			result.Disable = UnstickFlag(_gdDisable, instance);
			result.DisableTimer = UnstickNum(_gdDisableTimer, instance);
			result.InputLock = UnstickNum(_pcInput, PlayerController.instance);
			return result;
		}

		private string VanillaStateLine()
		{
			try
			{
				return Describe(ReadVanilla());
			}
			catch
			{
				return "(unreadable)";
			}
		}

		private static string Describe(VanillaState s)
		{
			return "menu manager " + (s.MenuOpen ? "OPEN" : "closed") + ((s.Page != "") ? (" (page " + s.Page + ", " + (s.PageVisible ? "visible" : "not visible") + ")") : " (no page)") + ", controls: player map " + ((!s.PlayerMap.HasValue) ? "?" : (s.PlayerMap.Value ? "on" : "OFF")) + ", UI map " + ((!s.UiMap.HasValue) ? "?" : (s.UiMap.Value ? "on" : "off")) + ", " + $"player input lock {s.InputLock:0.0} s, movement lock {s.MoveLock:0.0} s, controls lock {Mathf.Max(s.ExceptLock, s.IncludeLock):0.0} s, " + string.Format("game input off {0}, Escape lock {1:0.0} s, ", s.Disable ? $"YES ({s.DisableTimer:0.0} s)" : "no", s.EscLock) + "chat " + ((s.ChatState == 1) ? "typing" : ((s.ChatState == 3) ? "sending" : ((s.ChatState == 2) ? "possessed" : "inactive"))) + (s.ChatActive ? " (flag on)" : "") + ", text input " + (s.TextInput ? "ON" : "off");
		}

		private void CheckVanillaState(float now)
		{
			VanillaState s = ReadVanilla();
			float num = now - _vuStart;
			if (!_vuSnap && num >= 4f && (_vuWhy.StartsWith("a late join") || _vuSince.Count > 0))
			{
				_vuSnap = true;
				Plugin.Log.LogInfo((object)$"[unstick] {num:0.0} s after {_vuWhy}: {Describe(s)}.");
			}
			bool flag = s.MenuOpen && s.Page != "" && (!s.PageVisible || (s.MenuOnlyPage && num < 20f));
			Rule("menu page", flag, now, s, delegate
			{
				_closeAll?.Invoke(UnstickVal(_mmInst, null), null);
				return "the menu page '" + s.Page + "' (" + (s.PageVisible ? "a page from the menus" : "not visible") + ") was left open, so the game kept the player in menu mode (no moving, no Escape menu, no interacting): closed it";
			});
			bool flag2 = !s.MenuOpen && s.PlayerMap == false && s.ChatState != 1 && !s.TextInput;
			Rule("controls", flag2, now, s, delegate
			{
				_toPlayer?.Invoke(UnstickVal(_imInst, null), null);
				return "the game's menus are closed but its controls were still on the menu (UI) map: switched back to the player controls";
			});
			bool flag3 = s.ChatActive && s.ChatState == 0;
			Rule("chat flag", flag3, now, s, delegate
			{
				_chatActive?.SetValue(UnstickVal(_chatInst, null), false);
				return "the chat was flagged active with nobody typing (that blocks the Escape menu): flag cleared";
			});
			bool flag4 = s.TextInput && !s.MenuOpen;
			Rule("text input", flag4, now, s, delegate
			{
				_mmText?.SetValue(UnstickVal(_mmInst, null), false);
				return "a text field was flagged as being typed in with no menu open: flag cleared";
			});
			bool flag5 = s.MoveLock > 5f || s.ExceptLock > 5f || s.IncludeLock > 5f || s.EscLock > 5f;
			Rule("locks", flag5, now, s, delegate
			{
				object obj = UnstickVal(_imInst, null);
				if (s.MoveLock > 5f)
				{
					_imMove?.SetValue(obj, 0f);
				}
				if (s.ExceptLock > 5f)
				{
					_imExcept?.SetValue(obj, 0f);
				}
				if (s.IncludeLock > 5f)
				{
					_imInclude?.SetValue(obj, 0f);
				}
				if (s.EscLock > 5f)
				{
					_gdEsc?.SetValue(GameDirector.instance, 0f);
				}
				return "one of the game's own input locks was set for a long time: ended it";
			});
			Rule("input lock", !s.MenuOpen && s.InputLock > 0f, now, s, () => "the player input lock stays on with the menus closed (set every frame by something else: an item, a vehicle, a scripted moment); left alone", fix: false);
		}

		private void Rule(string id, bool on, float now, VanillaState s, Func<string> act, bool fix = true)
		{
			if (!on)
			{
				_vuSince.Remove(id);
				return;
			}
			if (!_vuSince.TryGetValue(id, out var value))
			{
				_vuSince[id] = now;
				return;
			}
			_vuDone.TryGetValue(id, out var value2);
			if (!(now - value < 3f) && value2 < ((!fix) ? 1 : 3))
			{
				_vuDone[id] = value2 + 1;
				_vuSince.Remove(id);
				string text;
				try
				{
					text = act();
				}
				catch (Exception ex)
				{
					text = "couldn't undo it (" + ex.GetBaseException().Message + ")";
				}
				string text2 = $"[unstick] {now - _vuStart:0.0} s after {_vuWhy}: {text}. State was: {Describe(s)}.";
				if (fix)
				{
					Plugin.Log.LogWarning((object)text2);
				}
				else
				{
					Plugin.Log.LogInfo((object)text2);
				}
			}
		}

