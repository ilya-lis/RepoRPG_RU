	internal static class Account
	{
		public sealed class Peer
		{
			public string Title = "";

			public bool Flare;

			public int Asc = -1;

			public readonly HashSet<string> Mastered = new HashSet<string>();
		}

		public static AccountFile Data = new AccountFile();

		public static readonly List<UnlockDef> Unlocks = new List<UnlockDef>();

		private static readonly Dictionary<string, AltPassiveDef> Alts = new Dictionary<string, AltPassiveDef>();

		private static bool _dirty;

		private static float _nextSave;

		public const int MasteryLevel = 30;

		private static readonly Dictionary<int, Peer> Peers = new Dictionary<int, Peer>();

		private static string PathFile => Path.Combine(ClassDatabase.Folder, "account.json");

		public static bool Enabled => Plugin.Cfg.AccountProgress.Value;

		public static int MasteredCount => Data.classes.FindAll((AccountClass x) => x.masteredAt != "").Count;

		public static void Load()
		{
			Unlocks.Clear();
			Alts.Clear();
			try
			{
				UnlockDef[] array = Json.Deserialize<ProgressionFile>(ClassDatabase.ReadWithOverride("progression", ClassDatabase.ReadEmbedded("progression")))?.unlocks ?? Array.Empty<UnlockDef>();
				foreach (UnlockDef unlockDef in array)
				{
					if (unlockDef != null && unlockDef.id != "")
					{
						Unlocks.Add(unlockDef);
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("progression data parse error: " + ex.Message));
			}
			try
			{
				AltPassiveDef[] array2 = Json.Deserialize<AltFile>(ClassDatabase.ReadWithOverride("altpassives", ClassDatabase.ReadEmbedded("altpassives")))?.alts ?? Array.Empty<AltPassiveDef>();
				foreach (AltPassiveDef altPassiveDef in array2)
				{
					if (altPassiveDef != null && !(altPassiveDef.@class == "") && Plugin.Db.Get(altPassiveDef.@class) != null)
					{
						AltPassiveDef altPassiveDef2 = altPassiveDef;
						if (altPassiveDef2.effects == null)
						{
							altPassiveDef2.effects = Array.Empty<EffectDef>();
						}
						ClassDatabase.ResolveAll(altPassiveDef.@class, altPassiveDef.effects);
						Alts[altPassiveDef.@class] = altPassiveDef;
					}
				}
			}
			catch (Exception ex2)
			{
				Plugin.Log.LogError((object)("alternate passives parse error: " + ex2.Message));
			}
			try
			{
				PrestigeTree[] array3 = Json.Deserialize<PrestigeFile>(ClassDatabase.ReadWithOverride("prestige", ClassDatabase.ReadEmbedded("prestige")))?.trees ?? Array.Empty<PrestigeTree>();
				foreach (PrestigeTree prestigeTree in array3)
				{
					ClassDef classDef = ((prestigeTree != null) ? Plugin.Db.Get(prestigeTree.@class) : null);
					if (classDef == null || classDef.branches.Length != 3 || prestigeTree.nodes == null || prestigeTree.nodes.Length == 0)
					{
						continue;
					}
					NodeDef[] nodes = prestigeTree.nodes;
					foreach (NodeDef nodeDef in nodes)
					{
						NodeDef nodeDef2 = nodeDef;
						if (nodeDef2.desc == null)
						{
							nodeDef2.desc = "";
						}
						nodeDef2 = nodeDef;
						if (nodeDef2.requires == null)
						{
							nodeDef2.requires = "";
						}
						if (nodeDef.maxRank < 1)
						{
							nodeDef.maxRank = 1;
						}
						string id = classDef.id;
						nodeDef2 = nodeDef;
						ClassDatabase.ResolveAll(id, nodeDef2.effects ?? (nodeDef2.effects = Array.Empty<EffectDef>()));
					}
					Array.Sort(prestigeTree.nodes, (NodeDef x, NodeDef y) => x.tier.CompareTo(y.tier));
					List<BranchDef> list = new List<BranchDef>(classDef.branches)
					{
						new BranchDef
						{
							name = prestigeTree.name,
							desc = prestigeTree.desc,
							nodes = prestigeTree.nodes
						}
					};
					classDef.branches = list.ToArray();
				}
			}
			catch (Exception ex3)
			{
				Plugin.Log.LogError((object)("prestige data parse error: " + ex3.Message));
			}
			Data = ReadFile(PathFile) ?? ReadFile(PathFile + ".bak") ?? new AccountFile();
			AccountFile data = Data;
			if (data.classes == null)
			{
				data.classes = new List<AccountClass>();
			}
			data = Data;
			if (data.unlocks == null)
			{
				data.unlocks = new List<AccountUnlock>();
			}
			data = Data;
			if (data.counters == null)
			{
				data.counters = new List<NodeRank>();
			}
			data = Data;
			if (data.seenPerks == null)
			{
				data.seenPerks = new List<string>();
			}
			data = Data;
			if (data.records == null)
			{
				data.records = new List<NodeRank>();
			}
			data = Data;
			if (data.history == null)
			{
				data.history = new List<RunHistoryEntry>();
			}
			data = Data;
			if (data.lastRecap == null)
			{
				data.lastRecap = "";
			}
			data = Data;
			if (data.seenBoons == null)
			{
				data.seenBoons = new List<string>();
			}
			data = Data;
			if (data.research == null)
			{
				data.research = new ResearchSave();
			}
			data = Data;
			if (data.ascension == null)
			{
				data.ascension = new AscensionSave();
			}
			ClassMigration.MigrateAccount(Data);
			Plugin.Log.LogInfo((object)string.Format("[account] {0} mastered classes, {1} unlocks.", Data.classes.FindAll((AccountClass c) => c.masteredAt != "").Count, Data.unlocks.Count));
		}

		private static AccountFile? ReadFile(string path)
		{
			try
			{
				return File.Exists(path) ? Json.Deserialize<AccountFile>(File.ReadAllText(path)) : null;
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[account] " + Path.GetFileName(path) + " unreadable (" + ex.Message + ")."));
				return null;
			}
		}

		public static void SaveNow()
		{
			_dirty = false;
			try
			{
				Directory.CreateDirectory(ClassDatabase.Folder);
				string text = PathFile + ".tmp";
				File.WriteAllText(text, Json.Serialize(Data));
				if (File.Exists(PathFile))
				{
					File.Copy(PathFile, PathFile + ".bak", overwrite: true);
					File.Delete(PathFile);
				}
				File.Move(text, PathFile);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[account] couldn't save: " + ex.Message));
			}
		}

		public static void MarkDirty()
		{
			_dirty = true;
		}

		public static void SeePerks(IEnumerable<string> ids)
		{
			foreach (string id in ids)
			{
				if (!string.IsNullOrEmpty(id) && !Data.seenPerks.Contains(id))
				{
					Data.seenPerks.Add(id);
					_dirty = true;
				}
			}
		}

		public static bool SeenPerk(string id)
		{
			return Data.seenPerks.Contains(id);
		}

		public static void Tick()
		{
			if (_dirty && !(Time.unscaledTime < _nextSave) && (!Game.InLevel() || !Game.IsLoading()))
			{
				_nextSave = Time.unscaledTime + 10f;
				SaveNow();
			}
		}

		public static int Counter(string id)
		{
			foreach (NodeRank counter in Data.counters)
			{
				if (counter.id == id)
				{
					return counter.rank;
				}
			}
			return 0;
		}

		private static void SetCounter(string id, int v)
		{
			foreach (NodeRank counter in Data.counters)
			{
				if (counter.id == id)
				{
					counter.rank = v;
					return;
				}
			}
			Data.counters.Add(new NodeRank
			{
				id = id,
				rank = v
			});
		}

		public static bool Record(string key, int value)
		{
			AccountFile data = Data;
			if (data.records == null)
			{
				data.records = new List<NodeRank>();
			}
			foreach (NodeRank record in Data.records)
			{
				if (!(record.id != key))
				{
					if (value <= record.rank)
					{
						return false;
					}
					record.rank = value;
					MarkDirty();
					return true;
				}
			}
			Data.records.Add(new NodeRank
			{
				id = key,
				rank = value
			});
			MarkDirty();
			return value > 0;
		}

		public static int RecordOf(string key)
		{
			if (Data.records != null)
			{
				foreach (NodeRank record in Data.records)
				{
					if (record.id == key)
					{
						return record.rank;
					}
				}
			}
			return 0;
		}

		public static void SeeBoon(string id)
		{
			AccountFile data = Data;
			if (data.seenBoons == null)
			{
				data.seenBoons = new List<string>();
			}
			if (!(id == "") && !Data.seenBoons.Contains(id))
			{
				Data.seenBoons.Add(id);
				MarkDirty();
			}
		}

		public static bool SawBoon(string id)
		{
			if (Data.seenBoons != null)
			{
				return Data.seenBoons.Contains(id);
			}
			return false;
		}

		public static void AddHistory(RunHistoryEntry e)
		{
			AccountFile data = Data;
			if (data.history == null)
			{
				data.history = new List<RunHistoryEntry>();
			}
			Data.history.Insert(0, e);
			if (Data.history.Count > 20)
			{
				Data.history.RemoveRange(20, Data.history.Count - 20);
			}
			MarkDirty();
		}

		public static void Count(string id, int n = 1)
		{
			if (Enabled && n > 0)
			{
				SetCounter(id, Mathf.Min(int.MaxValue - n, Counter(id)) + n);
				MarkDirty();
				CheckUnlocks();
			}
		}

		public static void Max(string id, int v)
		{
			if (Enabled && v > Counter(id))
			{
				SetCounter(id, v);
				MarkDirty();
				CheckUnlocks();
			}
		}

		public static int Value(string counter)
		{
			if (!(counter == "mastered"))
			{
				if (!(counter == "ascension"))
				{
					return Counter(counter);
				}
				return Ascension.HighestWon;
			}
			return MasteredCount;
		}

		public static bool Has(string unlockId)
		{
			foreach (AccountUnlock unlock in Data.unlocks)
			{
				if (unlock.id == unlockId)
				{
					return true;
				}
			}
			return false;
		}

		public static string EarnedAt(string unlockId)
		{
			foreach (AccountUnlock unlock in Data.unlocks)
			{
				if (unlock.id == unlockId)
				{
					return unlock.at;
				}
			}
			return "";
		}

		private static void CheckUnlocks()
		{
			foreach (UnlockDef unlock in Unlocks)
			{
				if (!Has(unlock.id) && Value(unlock.counter) >= unlock.target)
				{
					Data.unlocks.Add(new AccountUnlock
					{
						id = unlock.id,
						at = DateTime.Now.ToString("yyyy-MM-dd")
					});
					MarkDirty();
					RpgRuntime.Instance?.OnUnlockEarned(unlock);
				}
			}
		}

		public static bool Active(string unlockId)
		{
			if (Enabled && Plugin.Cfg.StartingUnlocks.Value)
			{
				return Has(unlockId);
			}
			return false;
		}

		public static AccountClass ClassRec(string id)
		{
			AccountClass accountClass = Data.classes.Find((AccountClass x) => x.id == id);
			if (accountClass == null)
			{
				accountClass = new AccountClass
				{
					id = id
				};
				Data.classes.Add(accountClass);
			}
			return accountClass;
		}

		public static bool Mastered(string id)
		{
			return Data.classes.Exists((AccountClass x) => x.id == id && x.masteredAt != "");
		}

		public static void OnClassXp(string cls, int xp, int level)
		{
			if (Enabled && !(cls == ""))
			{
				AccountClass accountClass = ClassRec(cls);
				accountClass.masteryXp = (int)Mathf.Min(2.1474836E+09f, (float)accountClass.masteryXp + (float)xp * Difficulty.Payout());
				if (level > accountClass.bestLevel)
				{
					accountClass.bestLevel = level;
				}
				Max("maxlevel", level);
				if (accountClass.masteredAt == "" && level >= 30)
				{
					accountClass.masteredAt = DateTime.Now.ToString("yyyy-MM-dd");
					RpgRuntime.Instance?.OnMastered(cls);
					CheckUnlocks();
					RpgRuntime.Instance?.SendAccountSummarySoon();
				}
				MarkDirty();
			}
		}

		public static AltPassiveDef? AltDef(string cls)
		{
			if (!Alts.TryGetValue(cls, out AltPassiveDef value))
			{
				return null;
			}
			return value;
		}

		public static bool AltInRun(RunSave? run, string cls)
		{
			if (run != null && Plugin.Cfg.AlternatePassives.Value && Mastered(cls) && AltDef(cls) != null)
			{
				return run.altClasses.Contains(cls);
			}
			return false;
		}

		public static bool PrestigeUsable(string cls)
		{
			if (Plugin.Cfg.PrestigeTrees.Value)
			{
				return Mastered(cls);
			}
			return false;
		}

		public static string Summary()
		{
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append(Data.title.Replace("|", "")).Append('|');
			foreach (AccountClass @class in Data.classes)
			{
				if (@class.masteredAt != "")
				{
					stringBuilder.Append(@class.id).Append(',');
				}
			}
			stringBuilder.Append('|').Append((Has("flare_callout") && Data.flareCallout) ? "1" : "0");
			stringBuilder.Append('|').Append(Ascension.HighestWon);
			return stringBuilder.ToString();
		}

		public static void OnPeer(int actor, string s)
		{
			if (s == null || s.Length > 2000)
			{
				return;
			}
			string[] array = s.Split('|');
			Peer peer = new Peer
			{
				Title = ((array.Length == 0) ? "" : ((array[0].Length > 24) ? array[0].Substring(0, 24) : array[0])),
				Flare = (array.Length > 2 && array[2] == "1")
			};
			if (array.Length > 1)
			{
				string[] array2 = array[1].Split(',');
				foreach (string text in array2)
				{
					if (text != "" && Plugin.Db.Get(text) != null)
					{
						peer.Mastered.Add(text);
					}
				}
			}
			if (array.Length > 3 && int.TryParse(array[3], out var result))
			{
				peer.Asc = Mathf.Clamp(result, -1, 20);
			}
			Peers[actor] = peer;
		}

		public static Peer? PeerOf(int actor)
		{
			if (!Peers.TryGetValue(actor, out Peer value))
			{
				return null;
			}
			return value;
		}

		public static void Forget(int actor)
		{
			Peers.Remove(actor);
		}

		public static bool HostAllowsPrestige(int actor, string cls)
		{
			if (!Plugin.Cfg.PrestigeTrees.Value)
			{
				return false;
			}
			PlayerAvatar val = Game.LocalPlayer();
			if (((Object)(object)val != (Object)null && Game.ActorNumber(val) == actor) || !Game.IsMultiplayer())
			{
				return Mastered(cls);
			}
			if (Peers.TryGetValue(actor, out Peer value))
			{
				return value.Mastered.Contains(cls);
			}
			return false;
		}

		public static string Decorate(int actor, string name)
		{
			PlayerAvatar val = Game.LocalPlayer();
			int num;
			object obj;
			if ((Object)(object)val != (Object)null)
			{
				num = ((Game.ActorNumber(val) == actor) ? 1 : 0);
				if (num != 0)
				{
					obj = (Has(TitleUnlock(Data.title)) ? Data.title : "");
					goto IL_0062;
				}
			}
			else
			{
				num = 0;
			}
			obj = PeerOf(actor)?.Title ?? "";
			goto IL_0062;
			IL_0062:
			string text = (string)obj;
			int num2 = ((num != 0) ? MasteredCount : (PeerOf(actor)?.Mastered.Count ?? 0));
			int num3 = ((num != 0) ? Ascension.HighestWon : (PeerOf(actor)?.Asc ?? (-1)));
			return ((num3 >= 1) ? $"A{num3} " : "") + ((num2 > 0) ? "★" : "") + name + ((text != "") ? (" [" + text + "]") : "");
		}

		private static string TitleUnlock(string title)
		{
			foreach (UnlockDef unlock in Unlocks)
			{
				if (unlock.kind == "title" && unlock.title == title)
				{
					return unlock.id;
				}
			}
			return "";
		}

		public static List<string> EarnedTitles()
		{
			List<string> list = new List<string>();
			foreach (UnlockDef unlock in Unlocks)
			{
				if (unlock.kind == "title" && Has(unlock.id))
				{
					list.Add(unlock.title);
				}
			}
			return list;
		}
	}
