				{
				case 'S':
					if (text == "Settings")
					{
						DrawControlsTab(rContent);
					}
					break;
				case 'R':
					if (text == "Research")
					{
						DrawResearchTab(rContent);
					}
					break;
				}
				break;
			case 10:
				if (text == "Attributes")
				{
