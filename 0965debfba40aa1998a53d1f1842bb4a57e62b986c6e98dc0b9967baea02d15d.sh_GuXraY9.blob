		public static MilestoneFile Data = new MilestoneFile();

		private static readonly Dictionary<string, BoonDef> ById = new Dictionary<string, BoonDef>();

		public static State Cur = new State();

		public static int MyVote = -1;

		public const int MaxCrew = 10;

		public static readonly string[] CrewBonus = new string[11]
		{
			"", "", "+1 Featured item in each shop restock", "+5% XP", "+10% max health", "+5% haul Scrap", "+1 gear and shop luck", "Contract rewards +10%", "+5% XP (+10% in all)", "Mod shop prices -5%",
			"Milestone payouts +25%"
		};

		private static readonly Dictionary<int, int> Votes = new Dictionary<int, int>();

		private static int _voteFor;

		private static int _sweepLevel = -1;

		private static int _sweepCount;

		private static State? _owedOf;

		private static string _owedMe = "";

		private static readonly List<int> _owed = new List<int>();

		public static int MyRouteVote = -1;

		public static int MyHeatVote = -1;

		private static ModConfig C => Plugin.Cfg;

		public static int Every
		{
			get
			{
				if (!Season.On)
				{
					return Mathf.Clamp(C.MilestoneEvery.Value, 2, 20);
				}
				return Season.LevelsPerChapter;
			}
		}

		public static int Chapter => ChapterAt(RunInfo.LevelIndex);

		public static int LevelNumber => RunInfo.LevelIndex + 1;

		public static int LevelsToMilestone
		{
			get
			{
				if (!C.MilestonesOn.Value)
				{
					return -1;
				}
				return (Every - LevelNumber % Every) % Every;
			}
		}

		private static float StreakLevels
		{
			get
			{
				if (!C.StreaksOn.Value)
				{
					return 0f;
				}
				return Mathf.Min(Cur.Streak, Mathf.Clamp(C.StreakCap.Value, 0, 30));
			}
		}

		private static float ChapterPct => (float)(Chapter - 1) * Mathf.Clamp(C.ChapterRewards.Value, 0f, 50f);

		private static float Cap => Mathf.Clamp(C.StreakMaxBonus.Value, 0f, 200f);

		public static float StreakXpPct => StreakLevels * Mathf.Clamp(C.StreakXp.Value, 0f, 20f);

		public static float StreakScrapPct => StreakLevels * Mathf.Clamp(C.StreakScrap.Value, 0f, 20f);

		public static float XpMult => 1f + Mathf.Min(Cap, StreakXpPct + ChapterPct + CrewXpPct) / 100f;

		public static float HaulScrapMult => (1f + Mathf.Min(Cap, StreakScrapPct + ChapterPct + CrewHaulPct) / 100f) * HazardPayMult;

		public static float ChapterRewardMult => 1f + Mathf.Min(Cap, ChapterPct) / 100f;

		public static float ContractScrapMult => ChapterRewardMult * (Has("tip_jar") ? 1.15f : 1f) * CrewContractMult * Market.ContractMult;

		public static float LuckBonus => StreakLevels * Mathf.Clamp(C.StreakLuck.Value, 0f, 5f) + (float)(Chapter - 1) + CrewLuck + Routes.Luck + Heat.Luck;

		public static int CrewLevel
		{
			get
			{
				if (!C.CrewOn.Value)
				{
					return 1;
				}
				return CrewLevelFor(Cur.CrewXp);
			}
		}

		public static float CrewXpPct => ((CrewLevel >= 3) ? 5f : 0f) + ((CrewLevel >= 8) ? 5f : 0f);

		public static float CrewHaulPct
		{
			get
			{
				if (CrewLevel < 5)
				{
					return 0f;
				}
				return 5f;
			}
		}

		public static float CrewHealthPct
		{
			get
			{
				if (CrewLevel < 4)
				{
					return 0f;
				}
				return 10f;
			}
		}

		public static float CrewLuck
		{
			get
			{
				if (CrewLevel < 6)
				{
					return 0f;
				}
				return 1f;
			}
		}

		public static float CrewContractMult
		{
			get
			{
				if (CrewLevel < 7)
				{
					return 1f;
				}
				return 1.1f;
			}
		}

		public static float CrewShopMult
		{
			get
			{
				if (CrewLevel < 9)
				{
					return 1f;
				}
				return 0.95f;
			}
		}

		public static float CrewPayoutMult
		{
			get
			{
				if (CrewLevel < 10)
				{
					return 1f;
				}
				return 1.25f;
			}
		}

		public static int CrewFeatured => ((CrewLevel >= 2) ? 1 : 0) + (Has("stockpile") ? 1 : 0);

		public static float HazardPayMult
		{
			get
			{
				TeamRunSave team = Team;
				if (team == null || !Has("hazard_pay") || team.levelElitesAt != RunInfo.LevelIndex)
				{
					return 1f;
				}
				return 1f + (float)Mathf.Min(10, team.levelElites) / 100f;
			}
		}

		public static float TeamLevel => (float)Cur.TeamLevel10 / 10f;

		private static TeamRunSave? Team => RpgRuntime.Instance?.HostRun?.team;

		public static void Load()
		{
			ById.Clear();
			try
			{
				Data = Json.Deserialize<MilestoneFile>(ClassDatabase.ReadWithOverride("milestones", ClassDatabase.ReadEmbedded("milestones"))) ?? new MilestoneFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("milestones data parse error: " + ex.Message));
				Data = new MilestoneFile();
			}
			MilestoneFile data = Data;
			if (data.boons == null)
			{
				data.boons = Array.Empty<BoonDef>();
			}
			BoonDef[] boons = Data.boons;
			foreach (BoonDef boonDef in boons)
			{
				if (boonDef != null && boonDef.id != "")
				{
					ById[boonDef.id] = boonDef;
				}
			}
		}

		public static BoonDef? Boon(string id)
		{
			if (!ById.TryGetValue(id ?? "", out BoonDef value))
			{
				return null;
			}
			return value;
		}

		public static bool Has(string boon)
		{
			return Array.IndexOf(Cur.Boons, boon) >= 0;
		}

		public static int ChapterAt(int cleared)
		{
			if (!C.MilestonesOn.Value)
			{
				return 1;
			}
			return 1 + Mathf.Max(0, cleared) / Every;
		}

		public static bool IsMilestoneLevel(int levelIndex)
		{
			if (C.MilestonesOn.Value)
			{
				return (levelIndex + 1) % Every == 0;
			}
			return false;
		}

		public static float ChapterThreatAt(int cleared)
		{
			int num = Mathf.Min(ChapterAt(cleared), Season.On ? Season.Chapters : int.MaxValue) - 1;
			float num2 = Mathf.Clamp(C.ChapterThreat.Value, 0f, 5f) * (Season.On ? Mathf.Min(1f, 4f / (float)Mathf.Max(1, Season.Chapters - 1)) : 1f);
			return (float)num * num2;
		}

		public static int PayoutFor(int milestone)
		{
			return Mathf.RoundToInt((float)Mathf.Clamp(C.MilestonePayout.Value, 0, 2000) * (1f + (float)Mathf.Max(0, milestone - 1) * Mathf.Clamp(C.MilestonePayoutStep.Value, 0f, 200f) / 100f) * CrewPayoutMult * (Has("deep_pockets") ? 1.3f : 1f));
		}

		public static int CrewNeed(int level)
		{
			return 150 + 75 * (Mathf.Max(1, level) - 1);
		}

		public static int CrewLevelFor(int xp)
		{
			int i;
			for (i = 1; i < 10 && xp >= CrewNeed(i); i++)
			{
				xp -= CrewNeed(i);
			}
			return i;
		}

		public static (int into, int need) CrewProgress(int xp)
		{
			int i;
			for (i = 1; i < 10 && xp >= CrewNeed(i); i++)
			{
				xp -= CrewNeed(i);
			}
			return (into: xp, need: (i < 10) ? CrewNeed(i) : 0);
		}

		public static float MilestoneBossHealth(int levelIndex)
		{
			return (Mathf.Clamp(C.MilestoneBossHealth.Value, 1f, 5f) + (float)(ChapterAt(levelIndex) - 1) * Mathf.Clamp(C.MilestoneBossHealthStep.Value, 0f, 2f)) * (Season.IsFinaleLevel(levelIndex) ? Season.FinaleHealth : 1f);
		}

		public static bool BoonVoted(int actor)
		{
			return Votes.ContainsKey(actor);
		}

		public static int[] Ballots(Dictionary<int, int> votes)
		{
			if (votes.Count == 0)
			{
				return Array.Empty<int>();
			}
			bool value = C.VotesShowWho.Value;
			int[] array = new int[votes.Count * 2];
			int num = 0;
			foreach (KeyValuePair<int, int> vote in votes)
			{
				array[num++] = vote.Key;
				array[num++] = (value ? vote.Value : (-1));
			}
			return array;
		}

		private static void Dirty()
		{
			RpgRuntime.Instance?.MarkRunDirty();
		}

		public static void HostBroadcast(string note = "")
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster())
			{
				return;
			}
			if (_voteFor != team.voteFor)
			{
				Votes.Clear();
				_voteFor = team.voteFor;
			}
			if (C.CrewOn.Value && Cur.Seq > 0)
			{
				int num = CrewLevelFor(Cur.CrewXp);
				int num2 = CrewLevelFor(team.crewXp);
				if (num2 > num)
				{
					note = ((note != "") ? (note + "\n") : "") + $"crew|Crew level {num2}: {CrewBonus[Mathf.Clamp(num2, 0, CrewBonus.Length - 1)]}";
				}
			}
			while (team.boonFrom.Count < team.boons.Count)
			{
				team.boonFrom.Add("");
			}
			State s = new State
			{
				Streak = team.streak,
				BestStreak = team.bestStreak,
				Milestones = team.milestones,
				VoteFor = team.voteFor,
				Votes = Votes.Count,
				Voters = Mathf.Max(1, Game.Players().Count),
				SecondWindLevel = team.secondWindLevel,
				Boons = team.boons.ToArray(),
				VoteOptions = team.voteOptions.ToArray(),
				Owed = team.owed.ToArray(),
				Note = note,
				Seq = Cur.Seq + 1,
				CrewXp = team.crewXp,
				TeamLevel10 = Mathf.RoundToInt(HostTeamLevel() * 10f),
				BoonFrom = team.boonFrom.ToArray(),
				VoteFrom = team.voteFrom,
				SeasonWon = team.seasonWon,
				Endless = team.endless,
				Complete = team.complete,
				RouteFor = team.routeFor,
				RouteChosen = team.routeChosen,
				RouteVotes = Routes.VoteCount,
				RouteOptions = team.routeOptions.ToArray(),
				Heat = team.heat,
				HeatFor = team.heatFor,
				HeatVotes = Heat.VoteCount,
				HeatCards = team.heatCards.ToArray(),
				HeatOffer = team.heatOffer.ToArray(),
				BoonBy = ((team.voteFor != 0) ? Ballots(Votes) : Array.Empty<int>()),
				RouteBy = ((team.routeChosen < 0) ? Routes.Ballots() : Array.Empty<int>()),
				HeatBy = ((team.heatFor != 0) ? Heat.Ballots() : Array.Empty<int>())
			};
			Apply(s);
			Net.SendRunShape(s, -1);
		}

		public static void HostSendTo(int actor)
		{
			if (Game.IsMaster() && Team != null)
			{
				Market.HostSendTo(actor);
				ResearchSamples.HostSendTo(actor);
				Research.HostBroadcastLobby(actor);
				ResearchCrew.HostSendTo(actor);
				Ascension.HostBroadcast(actor);
				if (Cur.Seq == 0)
				{
					HostBroadcast();
					return;
				}
				State cur = Cur;
				Net.SendRunShape(new State
				{
					Streak = cur.Streak,
					BestStreak = cur.BestStreak,
					Milestones = cur.Milestones,
					VoteFor = cur.VoteFor,
					Votes = cur.Votes,
					Voters = cur.Voters,
					SecondWindLevel = cur.SecondWindLevel,
					Seq = cur.Seq,
					Boons = cur.Boons,
					VoteOptions = cur.VoteOptions,
					Owed = cur.Owed,
					Note = "",
					CrewXp = cur.CrewXp,
					TeamLevel10 = Mathf.RoundToInt(HostTeamLevel() * 10f),
					BoonFrom = cur.BoonFrom,
					VoteFrom = cur.VoteFrom,
					SeasonWon = cur.SeasonWon,
					Endless = cur.Endless,
					Complete = cur.Complete,
					RouteFor = cur.RouteFor,
					RouteChosen = cur.RouteChosen,
					RouteVotes = cur.RouteVotes,
					RouteOptions = cur.RouteOptions,
					Heat = cur.Heat,
					HeatFor = cur.HeatFor,
					HeatVotes = cur.HeatVotes,
					HeatCards = cur.HeatCards,
					HeatOffer = cur.HeatOffer,
					BoonBy = cur.BoonBy,
					RouteBy = cur.RouteBy,
					HeatBy = cur.HeatBy
				}, actor);
			}
		}

		public static float HostTeamLevel()
		{
			float num = 0f;
			int num2 = 0;
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					string text = Game.SteamId(item);
					RunSave run = ((text == "") ? null : SaveBook.Get(RunInfo.Key, text));
					ClassProgress classProgress = run?.classes.Find((ClassProgress c) => c.classId == run.selectedClass);
					if (classProgress != null)
					{
						num += (float)classProgress.level;
						num2++;
					}
				}
			}
			if (num2 != 0)
			{
				return num / (float)num2;
			}
			return 0f;
		}

		private static void AddCrew(TeamRunSave t, float xp)
		{
			if (C.CrewOn.Value && !(xp <= 0f))
			{
				t.crewXp += Mathf.Max(1, Mathf.RoundToInt(xp * Mathf.Clamp(C.CrewXpScale.Value, 0f, 400f) / 100f));
			}
		}

		private static int StreakFloor(TeamRunSave t)
		{
			if (!t.boons.Contains("safety_net"))
			{
				return 0;
			}
			return t.bestStreak / 3;
		}

		private static TeamRunSave? HostTeam()
		{
			TeamRunSave team = Team;
			if (team == null)
			{
				return null;
			}
			if (team.startedUtc == "")
			{
				team.startedUtc = DateTime.UtcNow.ToString("o");
			}
			return team;
		}

		public static void HostLevelCleared()
		{
			TeamRunSave teamRunSave = HostTeam();
			if (teamRunSave == null || !Game.IsMaster())
			{
				return;
			}
			int levelIndex = RunInfo.LevelIndex;
			if (teamRunSave.countedLevel == levelIndex)
			{
				return;
			}
			teamRunSave.countedLevel = levelIndex;
			HostLevelTotals();
			teamRunSave.levelsCleared = Mathf.Max(teamRunSave.levelsCleared, levelIndex + 1);
			AddCrew(teamRunSave, 25f);
			string note = "";
			if (C.StreaksOn.Value)
			{
				teamRunSave.streak++;
				teamRunSave.bestStreak = Mathf.Max(teamRunSave.bestStreak, teamRunSave.streak);
				note = $"streak+|Streak {teamRunSave.streak}! +{Mathf.Min(Cap, (float)Mathf.Min(teamRunSave.streak, C.StreakCap.Value) * C.StreakXp.Value):0}% XP and Scrap";
			}
			bool flag = Season.IsFinaleLevel(levelIndex) && !teamRunSave.seasonWon;
			if (IsMilestoneLevel(levelIndex))
			{
				int num = (levelIndex + 1) / Every;
				if (num > teamRunSave.milestones)
				{
					teamRunSave.milestones = num;
					AddCrew(teamRunSave, 60f);
					PatchGuard.Run("milestone data", delegate
					{
						Research.HostGrantAll(25f, "Milestone");
					});
					foreach (PlayerAvatar item in Game.Players())
					{
						string text = Game.SteamId(item);
						if (text != "")
						{
							teamRunSave.owed.Add(text + "|" + num);
						}
					}
					if (!flag)
					{
						StartVote(teamRunSave, num, $"Milestone {num}");
					}
					if (!flag)
					{
						Heat.HostOpen(teamRunSave, num);
					}
					string text2 = (Season.On ? (Season.ChapterLabel(num + 1) + ": " + Season.ChapterName(num + 1)) : $"chapter {num + 1}");
					if (Season.On && Season.ChapterFlavor(num + 1) != "")
					{
						text2 = text2 + " - " + Season.ChapterFlavor(num + 1);
					}
					note = (flag ? "" : $"milestone|Milestone {num} reached - {text2} begins");
					Plugin.Log.LogInfo((object)string.Format("[run] milestone {0} reached (level {1}): {2} reward(s) owed, boon vote: {3}.", num, levelIndex + 1, teamRunSave.owed.Count, string.Join(", ", teamRunSave.voteOptions)));
				}
			}
			if (flag)
			{
				note = HostVictory(teamRunSave, note);
			}
			Routes.HostOpen(teamRunSave, levelIndex + 1);
			Dirty();
			HostBroadcast(note);
			if (flag)
			{
				HostVictoryRecap();
			}
		}

		private static string HostVictory(TeamRunSave t, string note)
		{
			t.seasonWon = true;
			int num = Mathf.Clamp(Season.Data.victoryScrap, 0, 5000);
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && num > 0)
				{
					Scrap.HostGrant(item, num, "Victory");
					Totals(t, item).scrap += num;
				}
			}
			if (t.voteFor != 0)
			{
				Decide(t);
			}
			t.voteOptions.Clear();
			t.voteOptions.Add("season:end");
			t.voteOptions.Add("season:endless");
			if (Ascension.On && Ascension.Level < 20)
			{
				t.voteOptions.Add("season:ascend");
			}
			PatchGuard.Run("ascension win", Ascension.HostCreditWin);
			t.voteFrom = "Victory";
			t.voteFor = 9000;
			Votes.Clear();
			_voteFor = t.voteFor;
			Plugin.Log.LogInfo((object)$"[season] VICTORY: the finale (level {RunInfo.LevelIndex + 1}, chapter {ChapterAt(RunInfo.LevelIndex)}) was won; {num} Scrap each; End / Endless vote open.");
			return ((note != "") ? (note + "\n") : "") + $"victory|VICTORY! The run is won - {num} {Scrap.Short} each. Vote: end the run, or keep going (Endless)";
		}

