			case ClassHost.Fx.Steps:
				ClassFx.Show(pos, 0.6f, seconds, new Color(0.28f, 0.9f, 0.37f, 0.7f));
				break;
			case ClassHost.Fx.Bet:
				ClassFx.Show(pos, radius, seconds, new Color(1f, 0.18f, 0.6f, 0.9f), 2f);
				break;
			default:
				ShowThirdWaveFx(fx, pos, radius, seconds);
				break;
			}
		}

