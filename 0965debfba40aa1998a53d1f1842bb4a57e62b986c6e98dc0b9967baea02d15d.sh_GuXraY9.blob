						_mmInstance = AccessTools.Field(type, "instance");
					}
					if (_clickMethod == null)
					{
						Game.WarnOnce("UI sounds: the game's menu sounds weren't found; the mod's menus are silent.");
					}
				}
				MethodInfo methodInfo = ((kind == UiSound.Hover) ? _hoverMethod : _clickMethod);
				object obj = _mmInstance?.GetValue(null);
				if (!(methodInfo == null) && obj != null)
				{
					if (!SoundArgs.TryGetValue(kind, out object[] value))
					{
						value = BuildArgs(methodInfo, kind);
						SoundArgs[kind] = value;
					}
					if (value != null)
					{
						methodInfo.Invoke(obj, value);
					}
				}
			}
			catch
			{
			}
		}

		private static object?[]? BuildArgs(MethodInfo m, UiSound kind)
		{
			ParameterInfo[] parameters = m.GetParameters();
			object[] array = new object[parameters.Length];
			for (int i = 0; i < parameters.Length; i++)
			{
				ParameterInfo parameterInfo = parameters[i];
				if (parameterInfo.ParameterType.IsEnum)
				{
					object obj = Enum.GetValues(parameterInfo.ParameterType).GetValue(0);
					if (SoundNames.TryGetValue(kind, out string[] value))
					{
						string[] names = Enum.GetNames(parameterInfo.ParameterType);
						string[] array2 = value;
						foreach (string w in array2)
						{
							string text = Array.Find(names, (string nm) => nm.IndexOf(w, StringComparison.OrdinalIgnoreCase) >= 0);
							if (text != null)
							{
								obj = Enum.Parse(parameterInfo.ParameterType, text);
								break;
							}
						}
					}
					array[i] = obj;
				}
				else if (parameterInfo.HasDefaultValue)
				{
					array[i] = parameterInfo.DefaultValue;
				}
				else if (parameterInfo.ParameterType.IsValueType)
				{
					array[i] = Activator.CreateInstance(parameterInfo.ParameterType);
				}
				else
				{
					array[i] = null;
				}
			}
			return array;
		}

