					continue;
				}
				RarityDef rd = Gear.Rarity(i);
				string otherReason = ((!value) ? "Milestones are off in this lobby" : (flag ? "One order per visit (ordered)" : ""));
				y = ShopRow(area, y, rd.name + " futures crate", "One <color=" + rd.color + ">" + rd.name + "</color> item, delivered at the next milestone.", price, value && !flag && open, delegate
				{
					AskPurchase("ORDER?", "Order a " + rd.name + " futures crate for " + Scrap.Price(Shop.Price(price)) + "? It's delivered when the team clears the next milestone level.", delegate
					{
						BuyFuturesE(rar);
					});
				}, otherReason);
			}
			return y + 8f;
		}

		private void BuyFuturesE(int rarity)
