		public static void NoteDestroyed(Component? c, bool hinge)
		{
			if (!Active || (Object)(object)c == (Object)null)
			{
				return;
			}
			PhotonView component = c.GetComponent<PhotonView>();
			if (!((Object)(object)component == (Object)null) && component.ViewID > 0)
			{
				if (component.InstantiationId > 0 && component.ViewID == component.InstantiationId)
