		private void FlashEdge(Rect r, Dictionary<string, float> flashes, string key)
		{
			//IL_002c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0043: Unknown result type (might be due to invalid IL or missing references)
			if (flashes.TryGetValue(key, out var value))
			{
				float num = (Time.unscaledTime - value) / 1.5f;
				if (num >= 1f)
				{
					flashes.Remove(key);
				}
				else
				{
					Border(r, new Color(1f, 0.85f, 0.35f, 1f - num), 4f);
				}
			}
		}

