			//IL_00e9: Unknown result type (might be due to invalid IL or missing references)
			float num = _stats.Custom("perk.team_speed");
			if (num > 0f && _teamNear)
			{
				_stats.AddDyn(Stat.MoveSpeed, num);
				_stats.AddDyn(Stat.SprintSpeed, num);
			}
			if (Time.time < _nextPerkTick)
			{
				return;
			}
			_nextPerkTick = Time.time + 1f;
			if (!Game.InLevel() || !Game.IsAlive(local))
			{
				_teamNear = false;
				return;
			}
			RunSave data = _store.Data;
			Vector3 position = ((Component)local).transform.position;
			bool flag = false;
			bool flag2 = false;
			if (num > 0f || Perks.Tracking(data, "near"))
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if (!((Object)(object)item == (Object)null) && !((Object)(object)item == (Object)(object)local) && Game.IsAlive(item))
					{
						Vector3 val = ((Component)item).transform.position - position;
						float sqrMagnitude = ((Vector3)(ref val)).sqrMagnitude;
						if (sqrMagnitude <= 36f)
						{
							flag = true;
						}
						if (sqrMagnitude <= 64f)
						{
							flag2 = true;
						}
					}
				}
			}
			if (flag != _teamNear)
			{
				_teamNear = flag;
			}
			if (flag2)
			{
				PerkBump("near", 1);
			}
			PlayerController instance = PlayerController.instance;
			if (!((Object)(object)instance != (Object)null) || !Game.Get(instance, "sprinting", fallback: false))
			{
				return;
			}
			PerkBump("sprint", 1);
			if (_stats.Custom("perk.sprint_heal") > 0f && !Difficulty.IronBodies && (Object)(object)local.playerHealth != (Object)null)
			{
				_sprintSampled += 1f;
				if (_sprintSampled >= 10f)
				{
					_sprintSampled = 0f;
					Game.HealSelf(local.playerHealth, 1);
					NoteHeal(1, HealKind.OverTime, "Ultramarathon");
				}
			}
		}

