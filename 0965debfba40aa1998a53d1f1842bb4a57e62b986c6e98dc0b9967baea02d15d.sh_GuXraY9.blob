			}
			int num5 = ((!(_upPickUid == g.uid) || !GearUp.AddsLine(g)) ? 1 : ((GearUp.Offers(g).Length + 2) / 2)) + ((g.sockets > 0) ? 1 : 0) + ((_modPick >= 0) ? ((DistinctModules(run).Count + 1) / 2) : 0);
