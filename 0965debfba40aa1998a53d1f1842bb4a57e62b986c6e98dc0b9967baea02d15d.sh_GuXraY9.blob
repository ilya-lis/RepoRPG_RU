		private int[] Parts
		{
			get
			{
				RunSave data = _store.Data;
				if (data.parts == null || data.parts.Length < 4)
				{
					int[] array = new int[4];
					if (data.parts != null)
					{
						Array.Copy(data.parts, array, data.parts.Length);
					}
					data.parts = array;
				}
				return data.parts;
			}
		}

