		private bool TryDeathSave(string source)
		{
			//IL_014c: Unknown result type (might be due to invalid IL or missing references)
			bool flag = false;
			if (DeathSavesLeft <= 0)
			{
				int levelIndex = RunInfo.LevelIndex;
				if (!RunShape.Has("second_wind") || RunShape.Cur.SecondWindLevel == levelIndex || _windLevel == levelIndex)
				{
					return false;
				}
				flag = true;
				_windLevel = levelIndex;
				Net.SendSecondWind(levelIndex);
			}
			RunSave data = _store.Data;
			if (!flag)
			{
				data.deathSavesUsed += Difficulty.SaveCost;
			}
			if (_neverDieLevel != RunInfo.LevelIndex && ClassStat("survivor.cap_never") > 0f && local_HealPct(ClassStat("survivor.cap_never")))
			{
				_neverDieLevel = RunInfo.LevelIndex;
			}
			_invulnUntil = Time.time + 2.5f + Mathf.Clamp(_stats.Custom("survivor.save_window"), 0f, 5f);
			OnDeathSave();
			PerkOnDeathSave();
			GearOnDeathSave(Game.LocalPlayer());
			CEv("deathsave");
			int deathSavesLeft = DeathSavesLeft;
			Toast(flag ? "Second Wind! The team's run boon saved you (once a level)" : ((source == "fall") ? $"Death save! Caught your fall ({deathSavesLeft} left this level)" : $"Death save! ({deathSavesLeft} left this level)"), new Color(1f, 0.85f, 0.3f));
			MenuSound(UiSound.Confirm);
			_store.MarkDirty();
			_store.SaveNow();
			Plugin.Log.LogInfo((object)$"Death save used ({source}); {deathSavesLeft} left this level.");
			OnDeathSaveUsed();
			return true;
		}

