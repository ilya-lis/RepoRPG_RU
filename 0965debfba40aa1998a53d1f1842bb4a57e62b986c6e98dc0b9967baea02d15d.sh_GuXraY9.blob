		private List<string> DebugCapNotes(Stat s)
		{
			List<string> list = new List<string>();
			switch (s)
			{
			case Stat.DamageTaken:
			{
				PlayerAvatar val = Game.LocalPlayer();
				float num = Mathf.Clamp(_stats.Perm(s), 0f - Plugin.Cfg.MaxDamageReduction.Value, 200f);
				float num2 = Mathf.Clamp(_stats.Temp(s), 0f - Plugin.Cfg.MaxActiveDamageReduction.Value, 200f);
				float num3 = (((Object)(object)val != (Object)null && (Object)(object)val.playerHealth != (Object)null) ? SignatureDamageMult(val, val.playerHealth) : 1f);
				float num4 = NewClassDamageMult();
				float num5 = (1f + num / 100f) * (1f + num2 / 100f) * num3 * num4;
				float num6 = 1f - Mathf.Clamp(Plugin.Cfg.MaxTotalDamageReduction.Value, 0f, 99f) / 100f;
				list.Add("Permanent part after its cap: " + Signed(num) + "%   active part after its cap: " + Signed(num2) + "%");
				list.Add($"x{num3:0.###} Scar Tissue / Shield Wall / Stabilize auras   x{num4:0.###} ally buffs and class guards");
				list.Add($"Damage taken: {num5 * 100f:0.#}% before the total cap, <b>{Mathf.Max(num5, num6) * 100f:0.#}%</b> applied (cap: at least {num6 * 100f:0.#}%)" + ((Time.time < _invulnUntil) ? "   - invulnerable right now" : ""));
				break;
			}
			case Stat.MoveSpeed:
			case Stat.SprintSpeed:
				list.Add($"Applied: {Signed(Mathf.Min(_stats[s], Plugin.Cfg.MaxSpeedBonus.Value))}% (cap {Plugin.Cfg.MaxSpeedBonus.Value:0}%, low-HP speed counts toward it)");
				break;
			case Stat.DodgeChance:
				list.Add($"Applied: {Mathf.Min(_stats[s], Plugin.Cfg.MaxDodgeChance.Value):0.#}% (cap {Plugin.Cfg.MaxDodgeChance.Value:0}%)");
				break;
			case Stat.DeathSaves:
				list.Add($"{DeathSavesLeft} left this level");
				break;
			case Stat.ShopDiscount:
				list.Add($"Applied: at most {Shop.MaxLegitDiscount():0}% from this stat; 80% total with the Quartermaster's discount");
				break;
			}
			return list;
		}

		private static string Signed(float v)
		{
			return ((v >= 0f) ? "+" : "") + v.ToString((Mathf.Abs(v % 1f) > 0.001f) ? "0.##" : "0", CultureInfo.InvariantCulture);
		}

