		private void TickCartFollowTargets(List<PlayerAvatar> players)
		{
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player == (Object)null || ClassStats.ClassOf(player) != "cartwright" || Mathf.Clamp(ClassStats.Get(player, "cartwright.follow"), 0f, 20f) <= 0f || _followOff.Contains(Game.ActorNumber(player)) || !_lastCart.TryGetValue(Game.ActorNumber(player), out PhysGrabCart value) || (Object)(object)value == (Object)null)
				{
					continue;
				}
				if (_pilots.TryGetValue(value, out Pilot value2))
				{
					if (value2.St != CartSt.Overdrive && (Object)(object)value2.Owner != (Object)(object)player)
					{
						value2.Owner = player;
						value2.AwaitOwner = false;
						CartLog(value2, "follow owner now " + Game.Get(player, "playerName", "?"));
					}
				}
				else
				{
					Pilot pilot = NewPilot(value, player);
					if (pilot != null)
					{
						_pilots[value] = pilot;
						CartLog(pilot, "follow on for " + Game.Get(player, "playerName", "?") + " (Idle until it needs to move)");
					}
				}
			}
			_pilotGone.Clear();
			foreach (KeyValuePair<PhysGrabCart, Pilot> pilot2 in _pilots)
			{
				Pilot value3 = pilot2.Value;
				if (value3.St != CartSt.Overdrive)
				{
					PhysGrabCart value4;
					if ((Object)(object)value3.Owner != (Object)null && _followOff.Contains(Game.ActorNumber(value3.Owner)))
					{
						BeginFollowOff(value3);
					}
					else if ((Object)(object)value3.Owner == (Object)null || !players.Contains(value3.Owner) || ClassStats.ClassOf(value3.Owner) != "cartwright" || ClassStats.Get(value3.Owner, "cartwright.follow") <= 0f || !_lastCart.TryGetValue(Game.ActorNumber(value3.Owner), out value4) || (Object)(object)value4 != (Object)(object)pilot2.Key)
					{
						_pilotGone.Add(pilot2.Key);
					}
				}
			}
			foreach (PhysGrabCart item in _pilotGone)
			{
				StopPilot(item, "");
			}
		}

		private Pilot? NewPilot(PhysGrabCart cart, PlayerAvatar owner)
		{
			//IL_0040: Unknown result type (might be due to invalid IL or missing references)
			//IL_0045: Unknown result type (might be due to invalid IL or missing references)
			Rigidbody component = ((Component)cart).GetComponent<Rigidbody>();
			if ((Object)(object)component == (Object)null)
			{
				return null;
			}
			Pilot pilot = new Pilot
			{
				Cart = cart,
				Rb = component,
				Pgo = ((Component)cart).GetComponent<PhysGrabObject>(),
				Owner = owner
			};
			pilot.ProgressPos = ((Component)cart).transform.position;
			pilot.ProgressAt = Time.time;
			ComputeLoad(pilot);
			return pilot;
		}

		private void StartDrive(PlayerAvatar from, Vector3 pos, float radius, float seconds, float speedMult, bool convoy)
		{
			//IL_0007: Unknown result type (might be due to invalid IL or missing references)
			//IL_0008: Unknown result type (might be due to invalid IL or missing references)
