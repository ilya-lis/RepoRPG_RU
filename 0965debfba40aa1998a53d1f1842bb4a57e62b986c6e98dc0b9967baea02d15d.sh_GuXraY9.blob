			float num = Mathf.Min(150f * _fontMul, ((Rect)(ref area)).width / 4f);
			float btnH = BtnH;
			float num2 = LineH(_smallLine) + 2f;
			Label(new Rect(((Rect)(ref area)).x, y + (BtnH - num2) / 2f, num, num2), "<b>" + label + "</b>", _smallLine);
			float num3 = ((Rect)(ref area)).x + num + 4f;
			if (Btn(new Rect(num3, y, btnH, BtnH), "‹", count > 1))
			{
				idx = (idx - 1 + count) % Mathf.Max(1, count);
				MenuSound(UiSound.Tick);
