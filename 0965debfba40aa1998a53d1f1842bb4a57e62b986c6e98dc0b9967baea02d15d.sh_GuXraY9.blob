		private static int GrabMask
		{
			get
			{
				if (_grabMask == -1)
				{
					int mask = LayerMask.GetMask(new string[2] { "PhysGrabObject", "PhysGrabObjectCart" });
					return _grabMask = ((mask != 0) ? mask : (-1));
				}
				return _grabMask;
			}
		}

