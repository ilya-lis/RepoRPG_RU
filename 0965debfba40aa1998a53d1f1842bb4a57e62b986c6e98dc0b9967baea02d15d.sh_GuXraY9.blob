	internal static class NetReliability
	{
		private sealed class Action
		{
			public byte Act;

			public object[] Payload;

			public float SentAt;

			public bool Retried;

			public bool UsesCharge;
		}

		public const float ReplyTimeout = 5f;

		private static readonly Dictionary<(int sender, byte type, int id), (byte replyType, object reply)> Replies = new Dictionary<(int, byte, int), (byte, object)>();

		private static readonly Queue<(int, byte, int)> ReplyOrder = new Queue<(int, byte, int)>();

		private static readonly Dictionary<int, Action> Actions = new Dictionary<int, Action>();

		private static int _actionSeq = new Random().Next(1, 1073741824);

		private static int _master = -1;

		private static bool _wasInRoom;

		public static bool Replay(int sender, byte type, int id, Action<byte, object, int> sendTo)
		{
			if (!Replies.TryGetValue((sender, type, id), out (byte, object) value))
			{
				return false;
			}
			if (NetDebug.Logging)
			{
				Plugin.Log.LogInfo((object)$"[net] repeat of request {type}#{id} from {sender}: answered again, not applied twice");
			}
			sendTo(value.Item1, value.Item2, sender);
			return true;
		}

		public static void ForgetReplies()
		{
			Replies.Clear();
			ReplyOrder.Clear();
		}

		public static void Remember(int sender, byte type, int id, byte replyType, object reply)
		{
			(int, byte, int) tuple = (sender, type, id);
			if (!Replies.ContainsKey(tuple))
			{
				Replies[tuple] = (replyType, reply);
				ReplyOrder.Enqueue(tuple);
				while (ReplyOrder.Count > 256)
				{
					Replies.Remove(ReplyOrder.Dequeue());
				}
			}
		}

		public static int NextActionId()
		{
			return ++_actionSeq;
		}

		public static void ActionSent(int id, byte act, object[] payload, bool usesCharge)
		{
			Actions[id] = new Action
			{
				Act = act,
				Payload = payload,
				SentAt = Time.unscaledTime,
				UsesCharge = usesCharge
			};
		}

		public static void ActionAcked(int id)
		{
			if (Actions.Remove(id))
			{
				RpgRuntime.Instance?.OnActionAcked();
			}
		}

		public static void Tick(Action<object[]> resend)
		{
			//IL_0205: Unknown result type (might be due to invalid IL or missing references)
			NetDebug.Tick();
			bool inRoom = PhotonNetwork.InRoom;
			int num = -1;
			try
			{
				if (inRoom && PhotonNetwork.MasterClient != null)
				{
					num = PhotonNetwork.MasterClient.ActorNumber;
				}
			}
			catch
			{
				num = -1;
			}
			if (inRoom != _wasInRoom)
			{
				ForgetReplies();
			}
			if (_wasInRoom && !inRoom)
			{
				CancelAll("You left the game");
			}
			else if (inRoom && _wasInRoom && _master != -1 && num != -1 && num != _master)
			{
				CancelAll("The host changed");
			}
			if (!inRoom)
			{
				_master = -1;
			}
			_wasInRoom = inRoom;
			if (num != -1)
			{
				_master = num;
			}
			if (Actions.Count == 0)
			{
				return;
			}
			float unscaledTime = Time.unscaledTime;
			List<int> list = null;
			foreach (KeyValuePair<int, Action> action in Actions)
			{
				Action value = action.Value;
				if (unscaledTime - value.SentAt < (Plugin.Cfg.ForceWaitTimeouts.Value ? 0.25f : 5f))
				{
					continue;
				}
				if (!value.Retried)
				{
					value.Retried = true;
					value.SentAt = unscaledTime;
					if (NetDebug.Logging)
					{
						Plugin.Log.LogInfo((object)$"[net] no answer to ability action #{action.Key} - sending it once more");
					}
					resend(value.Payload);
				}
				else
				{
					(list ?? (list = new List<int>())).Add(action.Key);
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (int item in list)
			{
				bool usesCharge = Actions[item].UsesCharge;
				Actions.Remove(item);
				Plugin.Log.LogWarning((object)($"[net] the host never answered ability action #{item}" + (usesCharge ? ": giving the charge back." : ".")));
				if (usesCharge)
				{
					RpgRuntime.Instance?.OnActionLost("Couldn't reach the host - ability not used");
				}
				else
				{
					RpgRuntime.Instance?.Toast("Couldn't reach the host", Color.gray);
				}
			}
		}

		public static void CancelAll(string why)
		{
			int num = 0;
			foreach (Action value in Actions.Values)
			{
				if (value.UsesCharge)
				{
					num++;
				}
			}
			Actions.Clear();
			if (num > 0)
			{
				for (int i = 0; i < num; i++)
				{
					RpgRuntime.Instance?.OnActionLost("");
				}
			}
			RpgRuntime.Instance?.CancelPendingRequests(why);
			if (NetDebug.Logging)
			{
				Plugin.Log.LogInfo((object)("[net] cancelled everything waiting on the host (" + why + ")"));
			}
		}
	}
	internal static class NetDebug
	{
		private struct Held
		{
			public float At;

			public int Sender;

			public byte Type;

			public object Data;
		}

		private static readonly List<Held> Queue = new List<Held>();

		private static readonly Random Rng = new Random();

		public static bool Logging
		{
			get
			{
				if (!(Plugin.Cfg.NetDropPercent.Value > 0f) && Plugin.Cfg.NetDelayMs.Value <= 0)
				{
					return Plugin.Cfg.AbilityDiagnostics.Value;
				}
				return true;
			}
		}

		public static void Receive(int sender, byte type, object data)
		{
			float value = Plugin.Cfg.NetDropPercent.Value;
			if (value > 0f && Rng.NextDouble() * 100.0 < (double)value)
			{
				Plugin.Log.LogInfo((object)$"[net debug] dropped message {type} from player {sender}");
				return;
			}
			int value2 = Plugin.Cfg.NetDelayMs.Value;
			if (value2 > 0)
			{
				Queue.Add(new Held
				{
					At = Time.unscaledTime + (float)value2 / 1000f,
					Sender = sender,
					Type = type,
					Data = data
				});
			}
			else
			{
				Net.Dispatch(sender, type, data);
			}
		}

		public static void Tick()
		{
			if (Queue.Count == 0)
			{
				return;
			}
			float unscaledTime = Time.unscaledTime;
			for (int i = 0; i < Queue.Count; i++)
			{
				if (!(Queue[i].At > unscaledTime))
				{
					Held held = Queue[i];
					Queue.RemoveAt(i--);
					Net.Dispatch(held.Sender, held.Type, held.Data);
				}
			}
		}
	}
