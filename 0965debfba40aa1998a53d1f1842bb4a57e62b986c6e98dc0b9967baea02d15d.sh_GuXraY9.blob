			try
			{
				array = Object.FindObjectsByType<Canvas>((FindObjectsSortMode)0);
			}
			catch
			{
				return;
			}
			Canvas[] array2 = array;
			foreach (Canvas val in array2)
			{
				if ((Object)(object)val == (Object)null || !((Behaviour)val).isActiveAndEnabled || !val.isRootCanvas || (int)val.renderMode != 0)
