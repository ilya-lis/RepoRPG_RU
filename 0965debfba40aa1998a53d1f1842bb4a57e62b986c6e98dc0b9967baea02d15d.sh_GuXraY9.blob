		private static bool OnResearchMsgX(int sender, object[] d, byte kind, bool master)
		{
			if (kind == 39 && IsFromHost(sender))
			{
				if (d.Length > 4 && d[1] is int level && d[2] is int[] array && d[3] is byte[] array2 && d[4] is float[] array3 && array.Length <= 64 && array2.Length == array.Length && array3.Length <= 16)
				{
					FieldResearch.Apply(level, array, array2, array3);
				}
				return true;
			}
			if (kind >= 39)
			{
				return kind <= 46;
			}
			return false;
		}
	}
	internal static class NetCodeCheck
	{
		private static Dictionary<short, OpCode>? _ops;

		public static void RunSoon()
		{
			Thread thread = new Thread((ThreadStart)delegate
			{
				try
				{
					Thread.Sleep(8000);
					Run();
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("Network code check couldn't run: " + ex.Message));
				}
			});
			thread.IsBackground = true;
			thread.Name = "RepoRPG code check";
			thread.Start();
		}

		private static void Run()
		{
			BuildOps();
			Assembly assembly = typeof(NetCodeCheck).Assembly;
			List<string> list = new List<string>();
			int num = 0;
			Assembly[] assemblies = AppDomain.CurrentDomain.GetAssemblies();
			foreach (Assembly assembly2 in assemblies)
			{
				if (assembly2 == assembly || assembly2.IsDynamic)
				{
					continue;
				}
				bool flag = false;
				try
				{
					AssemblyName[] referencedAssemblies = assembly2.GetReferencedAssemblies();
					for (int j = 0; j < referencedAssemblies.Length; j++)
					{
						if (referencedAssemblies[j].Name.StartsWith("Photon", StringComparison.Ordinal))
						{
							flag = true;
							break;
						}
					}
				}
				catch
				{
					continue;
				}
				if (!flag)
				{
					continue;
				}
				num++;
				Type[] array;
				try
				{
					array = assembly2.GetTypes();
				}
				catch (ReflectionTypeLoadException ex)
				{
					array = Array.FindAll(ex.Types, (Type x) => x != null);
				}
				catch
				{
					continue;
				}
				Type[] array2 = array;
				foreach (Type type in array2)
				{
					MethodBase[] array3;
					try
					{
						List<MethodBase> list2 = new List<MethodBase>(type.GetMethods(BindingFlags.DeclaredOnly | BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic));
						list2.AddRange(type.GetConstructors(BindingFlags.DeclaredOnly | BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic));
						array3 = list2.ToArray();
					}
					catch
					{
						continue;
					}
					MethodBase[] array4 = array3;
					foreach (MethodBase m in array4)
					{
						try
						{
							CheckMethod(assembly2, type, m, list);
						}
						catch
						{
						}
					}
				}
			}
			if (list.Count == 0)
			{
				Plugin.Log.LogInfo((object)($"Network code check: no conflicts. RepoRPG uses event {(byte)150} (keeps {(byte)150}-{(byte)153}); " + $"{num} other assembly(ies) using Photon checked (a mod that sends through its own helper method may not be seen; " + "events on our code that aren't ours are still caught and ignored at runtime)."));
				return;
			}
			foreach (string item in list)
			{
				Plugin.Log.LogWarning((object)($"Network code conflict: {item}. RepoRPG uses event {(byte)150}; its messages are checked and other mods' events on it are ignored, " + "but tell the mod authors so one of you can move."));
			}
		}

		private static void CheckMethod(Assembly asm, Type t, MethodBase m, List<string> conflicts)
		{
			byte[] array;
			try
			{
				array = m.GetMethodBody()?.GetILAsByteArray();
			}
			catch
			{
				return;
			}
			if (array == null || array.Length == 0)
			{
				return;
			}
			List<int> list = new List<int>();
			bool flag = false;
			bool flag2 = false;
			int num = 0;
			while (num < array.Length)
			{
				short key = ((array[num] == 254 && num + 1 < array.Length) ? ((short)(0xFE00 | array[num + 1])) : array[num]);
				if (_ops == null || !_ops.TryGetValue(key, out var value))
				{
					return;
				}
				num += value.Size;
				int num2 = 0;
				switch (value.OperandType)
				{
				case OperandType.ShortInlineBrTarget:
				case OperandType.ShortInlineVar:
					num++;
					break;
				case OperandType.ShortInlineI:
					num2 = (sbyte)array[num];
					num++;
					break;
				case OperandType.InlineVar:
					num += 2;
					break;
				case OperandType.InlineI8:
				case OperandType.InlineR:
					num += 8;
					break;
				case OperandType.ShortInlineR:
					num += 4;
					break;
				case OperandType.InlineSwitch:
				{
					int num3 = BitConverter.ToInt32(array, num);
					num += 4 + 4 * num3;
					break;
				}
				default:
					num2 = BitConverter.ToInt32(array, num);
					num += 4;
					break;
				case OperandType.InlineNone:
					break;
				}
				if (value == OpCodes.Ldc_I4 || value == OpCodes.Ldc_I4_S)
				{
					list.Add(num2);
				}
				else if (value.Value >= OpCodes.Ldc_I4_0.Value && value.Value <= OpCodes.Ldc_I4_8.Value)
				{
					list.Add(value.Value - OpCodes.Ldc_I4_0.Value);
				}
				else if (value == OpCodes.Call || value == OpCodes.Callvirt)
				{
					try
					{
						MethodBase methodBase = m.Module.ResolveMethod(num2);
						if (methodBase != null && (methodBase.Name == "RaiseEvent" || methodBase.Name == "OpRaiseEvent"))
						{
							flag = true;
						}
						if (methodBase != null && methodBase.Name == "get_Code" && methodBase.DeclaringType?.Name == "EventData")
						{
							flag2 = true;
						}
					}
					catch
					{
					}
				}
				else
				{
					if (!(value == OpCodes.Ldfld))
					{
						continue;
					}
					try
					{
						FieldInfo fieldInfo = m.Module.ResolveField(num2);
						if (fieldInfo != null && fieldInfo.Name == "Code" && fieldInfo.DeclaringType?.Name == "EventData")
						{
							flag2 = true;
						}
					}
					catch
					{
					}
				}
			}
			if (!flag && !flag2)
			{
				return;
			}
			foreach (int item in list)
			{
				if (item >= 150 && item <= 153)
				{
					conflicts.Add(string.Format("{0} ({1}.{2}) {3} event {4}", asm.GetName().Name, t.FullName, m.Name, flag ? "sends" : "listens for", item));
					break;
				}
			}
		}

		private static void BuildOps()
		{
			if (_ops != null)
			{
				return;
			}
			Dictionary<short, OpCode> dictionary = new Dictionary<short, OpCode>();
			FieldInfo[] fields = typeof(OpCodes).GetFields(BindingFlags.Static | BindingFlags.Public);
			for (int i = 0; i < fields.Length; i++)
			{
				if (fields[i].GetValue(null) is OpCode value)
				{
					dictionary[value.Value] = value;
				}
			}
			_ops = dictionary;
		}
	}
