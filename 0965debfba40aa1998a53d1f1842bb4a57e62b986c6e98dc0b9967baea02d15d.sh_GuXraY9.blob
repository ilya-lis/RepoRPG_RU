		private void SlowerLeveling()
		{
			List<string> moved = new List<string>();
			MoveI(KillXp, 25, "kill");
			MoveI(ExtractionXp, 30, "extraction");
			MoveI(LevelCompleteXp, 120, "level complete");
			MoveI(ReviveXp, 80, "revive");
			MoveI(UpgradeXp, 40, "upgrade");
			int[] array = new int[5] { 50, 90, 130, 170, 290 };
			int[] array2 = new int[5] { 24, 40, 60, 76, 130 };
			int[] array3 = new int[5] { 80, 80, 80, 80, 80 };
			int[] array4 = new int[5] { 30, 40, 65, 90, 130 };
			float[] array5 = new float[5] { 0.8f, 1f, 1.2f, 1.4f, 1.6f };
			for (int i = 0; i < array.Length; i++)
			{
				if (XpCurveBase.Value == array[i] && XpCurvePerLevel.Value == array2[i])
				{
					XpCurveBase.Value = array3[i];
					XpCurvePerLevel.Value = array4[i];
					XpCurveSquare.Value = array5[i];
					moved.Add($"XP curve {array[i]} + {array2[i]}/level -> {array3[i]} + {array4[i]}/level + {array5[i]:0.#}/level squared");
					break;
				}
			}
			float[] array6 = new float[5] { 0.6f, 0.8f, 1f, 1.2f, 1.5f };
			float[] array7 = new float[5] { 0.4f, 0.5f, 0.6f, 0.75f, 0.95f };
			for (int j = 0; j < array6.Length; j++)
			{
				if (Mathf.Abs(ThreatSpeed.Value - array6[j]) < 0.001f)
				{
					ThreatSpeed.Value = array7[j];
					moved.Add($"threat speed {array6[j]:0.##} -> {array7[j]:0.##}");
					break;
				}
			}
			if (moved.Count > 0)
			{
				Plugin.Log.LogInfo((object)("[config] slower class leveling (1.0.55): " + string.Join(", ", moved) + ". Class levels in your saves are kept."));
			}
			void MoveI(ConfigEntry<int> e, int old, string what)
			{
				if (e.Value == old)
				{
					e.Value = (int)((ConfigEntryBase)e).DefaultValue;
					moved.Add($"{what} {old} -> {e.Value}");
				}
			}
		}

		private void ClassBalance099()
		{
			List<string> moved = new List<string>();
			Move(MaxAllyHealPerPulse, 3f, "MaxAllyHealPerPulse");
			Move(MaxReviveHeal, 35f, "MaxReviveHeal");
			Move(MaxStabilize, 50f, "MaxStabilize");
			Move(MaxAppraiseBonus, 40f, "MaxAppraiseBonus");
			Move(ShepherdMaxDelay, 3f, "ShepherdMaxDelay");
			Move(MaxBetMultiplier, 3.5f, "MaxBetMultiplier");
			Move(CartSpeedBonusCap, 60f, "Carts/SpeedBonusCap");
			Move(HealPowerScaling, 0.5f, "HealPowerScaling");
			if (moved.Count > 0)
			{
				Plugin.Log.LogInfo((object)("[config] class balance (1.0.99): " + string.Join(", ", moved) + "."));
			}
			void Move(ConfigEntry<float> e, float old, string what)
			{
				if (Mathf.Approximately(e.Value, old))
				{
					e.Value = (float)((ConfigEntryBase)e).DefaultValue;
					moved.Add($"{what} {old:0.##} -> {e.Value:0.##}");
				}
			}
		}

		private static void DropRetired(ConfigFile c, params (string section, string key)[] keys)
		{
			//IL_0055: Unknown result type (might be due to invalid IL or missing references)
			//IL_005c: Expected O, but got Unknown
			try
			{
				if (!(AccessTools.Property(typeof(ConfigFile), "OrphanedEntries")?.GetValue(c) is IDictionary dictionary))
				{
					return;
				}
				List<string> list = new List<string>();
				for (int i = 0; i < keys.Length; i++)
				{
					(string section, string key) tuple = keys[i];
					string item = tuple.section;
					string item2 = tuple.key;
					ConfigDefinition key = new ConfigDefinition(item, item2);
					if (dictionary.Contains(key))
					{
						dictionary.Remove(key);
						list.Add(item + "/" + item2);
					}
				}
				if (list.Count != 0)
				{
					c.Save();
					Plugin.Log.LogInfo((object)("[config] removed settings that no longer do anything: " + string.Join(", ", list) + "."));
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[config] couldn't tidy retired settings (" + ex.Message + "); they're ignored."));
			}
		}

		private void Migrate(ConfigFile c)
		{
			int value = ConfigVersion.Value;
			int num = 0;
			foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in c)
			{
				ConfigEntryBase value2 = item.Value;
				ConfigDescription description = value2.Description;
				AcceptableValueBase val = ((description != null) ? description.AcceptableValues : null);
				if (val != null && !val.IsValid(value2.BoxedValue))
				{
					Plugin.Log.LogWarning((object)$"[config] {item.Key.Section}/{item.Key.Key} = '{value2.BoxedValue}' isn't allowed ({val.ToDescriptionString().Trim()}); reset to {value2.DefaultValue}.");
					value2.BoxedValue = value2.DefaultValue;
					num++;
				}
			}
			List<string> moved;
			if (value < 9)
			{
				if (value < 2 && CurrencyName.Value == "Semibot Scrap")
				{
					CurrencyName.Value = (string)((ConfigEntryBase)CurrencyName).DefaultValue;
				}
				if (value >= 1 && value < 3 && Mathf.Approximately(HighlightSeconds.Value, 8f))
				{
					HighlightSeconds.Value = 10f;
				}
				if (value >= 1 && value < 4)
				{
					moved = new List<string>();
					Move(HandOffKey, (KeyCode)103, "hand-off");
					Move(MimicSwapKey, (KeyCode)98, "Mimic swap");
					Move(CallOutKey, (KeyCode)118, "call out");
					Move(HumKey, (KeyCode)104, "hum");
					Move(HighlightsKey, (KeyCode)104, "highlights");
					if (moved.Count > 0)
					{
						Plugin.Log.LogInfo((object)("[config] keys that clashed with the game or other mods moved: " + string.Join(", ", moved) + "."));
					}
				}
				if (value >= 1 && value < 5 && XpCurveBase.Value == 30 && XpCurvePerLevel.Value == 12)
				{
					XpCurveBase.Value = (int)((ConfigEntryBase)XpCurveBase).DefaultValue;
					XpCurvePerLevel.Value = (int)((ConfigEntryBase)XpCurvePerLevel).DefaultValue;
					Plugin.Log.LogInfo((object)$"[config] XP curve moved to the Normal difficulty's: {XpCurveBase.Value} + {XpCurvePerLevel.Value} per level (was the old default 30 + 12).");
				}
				if (value >= 1 && value < 6 && LateJoinCatchUp.Value != CatchUp.Off)
				{
					CatchUpShare.Value = ((LateJoinCatchUp.Value == CatchUp.Half) ? 50f : 75f);
					LateJoinCatchUp.Value = CatchUp.Off;
					Plugin.Log.LogInfo((object)$"[config] late-join catch-up moved to LateJoin/CatchUpShare = {CatchUpShare.Value:0}%.");
				}
				if (value >= 1 && value < 7)
				{
					DropRetired(c, ("Classes", "MaxLanterns"), ("Classes", "LanternIntensity"), ("Classes", "FlareIntensity"));
				}
				if (value >= 1 && value < 8)
				{
					SlowerLeveling();
				}
				if (value >= 1 && value < 9)
				{
					ClassBalance099();
				}
				if (value > 0)
				{
					Plugin.Log.LogInfo((object)$"[config] settings file updated from format {value} to {9}; your settings were kept.");
				}
				ConfigVersion.Value = 9;
			}
			else if (value > 9)
			{
				Plugin.Log.LogWarning((object)$"[config] this settings file is from a newer RepoRPG (format {value}); options this version doesn't know are kept untouched.");
			}
			if (num > 0)
			{
				c.Save();
			}
			void Move(ConfigEntry<KeyCode> e, KeyCode old, string what)
			{
				//IL_0001: Unknown result type (might be due to invalid IL or missing references)
				//IL_0006: Unknown result type (might be due to invalid IL or missing references)
				//IL_0010: Unknown result type (might be due to invalid IL or missing references)
				//IL_0026: Unknown result type (might be due to invalid IL or missing references)
				//IL_002d: Unknown result type (might be due to invalid IL or missing references)
				if (e.Value == old)
				{
					e.Value = (KeyCode)((ConfigEntryBase)e).DefaultValue;
					moved.Add($"{what} {old} -> {e.Value}");
				}
			}
		}
	}
	internal static class Leveling
	{
		public const float ContractXpGrowth = 0.04f;

		public static int MaxLevel => Plugin.Cfg.MaxLevel.Value;

		public static int XpToNext(int level)
		{
			return Math.Max(1, (int)Math.Round((float)(Plugin.Cfg.XpCurveBase.Value + Plugin.Cfg.XpCurvePerLevel.Value * level) + Math.Max(0f, Plugin.Cfg.XpCurveSquare.Value) * (float)level * (float)level));
		}

		public static int EarnedPoints(int level)
		{
			int num = (level - 1) * Math.Max(0, Plugin.Cfg.PointsPerLevel.Value);
			int value = Plugin.Cfg.BonusPointEvery.Value;
			if (value > 0)
			{
				num += level / value;
			}
			return num;
		}

		public static int AvailablePoints(ClassProgress p)
		{
			return EarnedPoints(p.level) + Math.Max(0, p.bonusPoints) - p.SpentPoints();
		}

		public static int EarnedAttributePoints(ClassProgress? p, RunSave run)
		{
			int num = 1;
			foreach (ClassProgress @class in run.classes)
			{
				num = Math.Max(num, @class.level);
			}
			return (num - 1) * Math.Max(0, Plugin.Cfg.AttributePointsPerLevel.Value) + run.bonusAttributePoints;
		}

		public static int AvailableAttributePoints(ClassProgress? p, RunSave run)
		{
			return EarnedAttributePoints(p, run) - run.SpentAttributePoints();
		}

		public static bool FixOverspend(ClassProgress p)
		{
			if (AvailablePoints(p) >= 0)
			{
				return false;
			}
			p.ranks.Clear();
			return true;
		}

		public static int AddXp(ClassProgress p, int amount)
		{
			if (amount <= 0 || p.level >= MaxLevel)
			{
				return 0;
			}
			p.xp += amount;
			int num = 0;
			while (p.level < MaxLevel && p.xp >= XpToNext(p.level))
			{
				p.xp -= XpToNext(p.level);
				p.level++;
				num++;
			}
			if (p.level >= MaxLevel)
			{
				p.xp = 0;
			}
			return num;
		}
	}
	internal sealed class RunStore
	{
		private bool _dirty;

		private float _nextSave;

		private const int UnusedRunDays = 120;

		public RunSave Data { get; private set; } = new RunSave();

		public string OwnerId { get; private set; } = "";

		public string RunKey { get; private set; } = "";

		public bool Loaded
		{
			get
			{
				if (OwnerId != "")
				{
					return RunKey != "";
				}
				return false;
			}
		}

		public bool LoadedExisting { get; private set; }

		private static string Dir(string owner)
		{
			string text = Path.Combine(ClassDatabase.Folder, "runs", Safe(owner));
			Directory.CreateDirectory(text);
			return text;
		}

		public static string Safe(string s)
		{
			char[] invalidFileNameChars = Path.GetInvalidFileNameChars();
			foreach (char oldChar in invalidFileNameChars)
			{
				s = s.Replace(oldChar, '_');
			}
			return s;
		}

		private static string CachePath(string owner, string runKey)
		{
			return Path.Combine(Dir(owner), Safe(runKey) + ".json");
		}

		public static bool IsTempKey(string key)
		{
			if (!(key == "") && !key.StartsWith("session-"))
			{
				return key.StartsWith("nohost");
			}
			return true;
		}

		public void Use(string ownerId, string runKey, RunSave? data)
		{
			string text = ((Loaded && IsTempKey(RunKey)) ? Data.selectedClass : "");
			OwnerId = ownerId;
			RunKey = runKey;
			LoadedExisting = data != null;
			Data = data ?? new RunSave
			{
				runKey = runKey
			};
			Data.runKey = runKey;
			Normalize(Data);
			if (Data.selectedClass == "" && text != "")
			{
				Data.selectedClass = text;
			}
			_dirty = false;
			Plugin.Log.LogInfo((object)("Run '" + runKey + "' " + (LoadedExisting ? "restored" : "started fresh") + " for " + ownerId + ": " + $"class '{Data.selectedClass}', {Data.classes.Count} classes, {Data.inventory.Count} gear, {Data.perks.Count} perks."));
		}

		public static RunSave? ReadCache(string ownerId, string runKey, string runId)
		{
			if (IsTempKey(runKey) || string.IsNullOrEmpty(runId))
			{
				return null;
			}
			string path = CachePath(ownerId, runKey);
			SaveWriter.Flush();
			RunSave runSave = SaveWriter.ReadWithBackup<RunSave>(path, "run cache");
			if (runSave == null)
			{
				return null;
			}
			if (runSave.runId != runId)
			{
				Plugin.Log.LogInfo((object)("[run] your own copy of this save is from run '" + runSave.runId + "', not the current run '" + runId + "': not used."));
				return null;
			}
			Normalize(runSave);
			return runSave;
		}

		public static void DeleteCache(string ownerId, string runKey)
		{
			if (!IsTempKey(runKey) && !(ownerId == ""))
			{
				SaveWriter.Delete(CachePath(ownerId, runKey));
			}
		}

		public void ResetRun()
		{
			string selectedClass = Data.selectedClass;
			Data = new RunSave
			{
				runKey = RunKey,
				selectedClass = selectedClass
			};
			Normalize(Data);
			MarkDirty();
		}

		public static void Normalize(RunSave d)
		{
			d.version = Math.Max(d.version, 2);
			RunSave runSave = d;
			if (runSave.classes == null)
			{
				runSave.classes = new List<ClassProgress>();
			}
			runSave = d;
			if (runSave.attributes == null)
			{
				runSave.attributes = new List<NodeRank>();
			}
			runSave = d;
			if (runSave.inventory == null)
			{
				runSave.inventory = new List<GearItem>();
			}
			runSave = d;
			if (runSave.salvaged == null)
			{
				runSave.salvaged = new List<string>();
			}
			runSave = d;
			if (runSave.team == null)
			{
				runSave.team = new TeamRunSave();
			}
			TeamRunSave team = d.team;
			if (team.boons == null)
			{
				team.boons = new List<string>();
			}
			team = d.team;
			if (team.voteOptions == null)
			{
				team.voteOptions = new List<string>();
			}
			team = d.team;
			if (team.owed == null)
			{
				team.owed = new List<string>();
			}
			team = d.team;
			if (team.players == null)
			{
				team.players = new List<RunPlayerTotals>();
			}
			team = d.team;
			if (team.boonFrom == null)
			{
				team.boonFrom = new List<string>();
			}
			team = d.team;
			if (team.voteFrom == null)
			{
				team.voteFrom = "";
			}
			team = d.team;
			if (team.catchUpGiven == null)
			{
				team.catchUpGiven = new List<string>();
			}
			while (d.team.boonFrom.Count < d.team.boons.Count)
			{
				d.team.boonFrom.Add("");
			}
			runSave = d;
			if (runSave.contracts == null)
			{
				runSave.contracts = new List<ContractState>();
			}
			runSave = d;
			if (runSave.perks == null)
			{
				runSave.perks = new List<string>();
			}
			runSave = d;
			if (runSave.perkChoices == null)
			{
				runSave.perkChoices = new List<string>();
			}
			runSave = d;
			if (runSave.perkChoiceSets == null)
			{
				runSave.perkChoiceSets = new List<string>();
			}
			runSave = d;
			if (runSave.gambleBless == null)
			{
				runSave.gambleBless = new List<string>();
			}
			runSave = d;
			if (runSave.gambleKey == null)
			{
				runSave.gambleKey = "";
			}
			runSave = d;
			if (runSave.gambleCurse == null)
			{
				runSave.gambleCurse = "";
			}
			runSave = d;
			if (runSave.upgradeBonus == null)
			{
				runSave.upgradeBonus = new List<NodeRank>();
			}
			runSave = d;
			if (runSave.banished == null)
			{
				runSave.banished = new List<string>();
			}
			runSave = d;
			if (runSave.perkProgress == null)
			{
				runSave.perkProgress = new List<NodeRank>();
			}
			d.perkProgress.RemoveAll((NodeRank x) => x == null);
			runSave = d;
			if (runSave.evolved == null)
			{
				runSave.evolved = new List<string>();
			}
			runSave = d;
			if (runSave.moduleBag == null)
			{
				runSave.moduleBag = new List<string>();
			}
			runSave = d;
			if (runSave.loadouts == null)
			{
				runSave.loadouts = new List<GearLoadout>();
			}
			d.loadouts.RemoveAll((GearLoadout x) => x == null);
			foreach (GearLoadout loadout in d.loadouts)
			{
				GearLoadout current;
				GearLoadout gearLoadout = (current = loadout);
				if (current.uids == null)
				{
					current.uids = Array.Empty<string>();
				}
				current = gearLoadout;
				if (current.name == null)
				{
					current.name = "";
				}
			}
			runSave = d;
			if (runSave.dieUp == null)
			{
				runSave.dieUp = "";
			}
			runSave = d;
			if (runSave.dieDown == null)
			{
				runSave.dieDown = "";
			}
			runSave = d;
			if (runSave.shopStock == null)
			{
				runSave.shopStock = new List<ShopEntry>();
			}
			d.shopStock.RemoveAll((ShopEntry x) => x == null || (x.kind == "gear" && x.item == null));
			foreach (ShopEntry item2 in d.shopStock)
			{
				if (item2.item != null)
				{
					GearItem item = item2.item;
					if (item.modules == null)
					{
						item.modules = Array.Empty<string>();
					}
					item = item2.item;
					if (item.hidden == null)
					{
						item.hidden = Array.Empty<EffectDef>();
					}
					item = item2.item;
					ClassDatabase.ResolveAll("shop", item.effects ?? (item.effects = Array.Empty<EffectDef>()));
					ClassDatabase.ResolveAll("shop", item2.item.hidden);
				}
			}
			runSave = d;
			if (runSave.buyback == null)
			{
				runSave.buyback = new List<BuybackEntry>();
			}
			d.buyback.RemoveAll((BuybackEntry x) => x == null || x.item == null);
			foreach (BuybackEntry item3 in d.buyback)
			{
				GearItem item = item3.item;
				if (item.modules == null)
				{
					item.modules = Array.Empty<string>();
				}
				item = item3.item;
				if (item.hidden == null)
				{
					item.hidden = Array.Empty<EffectDef>();
				}
				item = item3.item;
				ClassDatabase.ResolveAll("buyback", item.effects ?? (item.effects = Array.Empty<EffectDef>()));
				ClassDatabase.ResolveAll("buyback", item3.item.hidden);
			}
			runSave = d;
			if (runSave.wishlist == null)
			{
				runSave.wishlist = "";
			}
			runSave = d;
			if (runSave.consBought == null)
			{
				runSave.consBought = new List<string>();
			}
			runSave = d;
			if (runSave.consActive == null)
			{
				runSave.consActive = new List<string>();
			}
			runSave = d;
			if (runSave.attuneBoosted == null)
			{
				runSave.attuneBoosted = new List<string>();
			}
			foreach (GearItem item4 in d.inventory)
			{
				if (item4 == null)
				{
					continue;
				}
				GearItem item = item4;
				if (item.behavior == null)
				{
					item.behavior = "";
				}
				item = item4;
				if (item.flavor == null)
				{
					item.flavor = "";
				}
				item = item4;
				if (item.hidden == null)
				{
					item.hidden = Array.Empty<EffectDef>();
				}
				item = item4;
				if (item.modules == null)
				{
					item.modules = Array.Empty<string>();
				}
				item4.sockets = Mathf.Clamp(item4.sockets, 0, 2);
				if (item4.modules.Length != item4.sockets)
				{
					string[] array = new string[item4.sockets];
					for (int num = 0; num < array.Length; num++)
					{
						array[num] = ((num < item4.modules.Length) ? (item4.modules[num] ?? "") : "");
					}
					item4.modules = array;
				}
				item4.attune = Mathf.Max(0, item4.attune);
			}
			runSave = d;
			if (runSave.selectedClass == null)
			{
				runSave.selectedClass = "";
			}
			int num2 = Plugin.Rpg.slots.Length;
			if (d.equipped == null || d.equipped.Length != num2)
			{
				string[] array2 = new string[num2];
				for (int num3 = 0; num3 < num2; num3++)
				{
					array2[num3] = ((d.equipped != null && num3 < d.equipped.Length) ? (d.equipped[num3] ?? "") : "");
				}
				d.equipped = array2;
			}
			d.classes.RemoveAll((ClassProgress c) => c == null);
			foreach (ClassProgress @class in d.classes)
			{
				ClassProgress classProgress = @class;
				if (classProgress.ranks == null)
				{
					classProgress.ranks = new List<NodeRank>();
				}
				@class.level = Mathf.Clamp(@class.level, 1, Leveling.MaxLevel);
				if (@class.level < Leveling.MaxLevel)
				{
					@class.xp = Mathf.Clamp(@class.xp, 0, Leveling.XpToNext(@class.level) - 1);
				}
			}
			d.inventory.RemoveAll((GearItem g) => g == null);
			foreach (GearItem item5 in d.inventory)
			{
				string classId = "gear " + item5.name;
				GearItem item = item5;
				ClassDatabase.ResolveAll(classId, item.effects ?? (item.effects = Array.Empty<EffectDef>()));
				string classId2 = "gear " + item5.name;
				item = item5;
				ClassDatabase.ResolveAll(classId2, item.hidden ?? (item.hidden = Array.Empty<EffectDef>()));
				item = item5;
				if (item.upFx == null)
				{
					item.upFx = Array.Empty<EffectDef>();
				}
				item = item5;
				if (item.upFxAt == null)
				{
					item.upFxAt = Array.Empty<int>();
				}
				item = item5;
				if (item.upOffer == null)
				{
					item.upOffer = Array.Empty<EffectDef>();
				}
				item5.up = Mathf.Clamp(item5.up, 0, GearUp.Max);
				GearUp.Resolve(item5);
			}
		}

		public static void PruneCaches(string owner)
		{
			try
			{
				FileInfo[] files = new DirectoryInfo(Dir(owner)).GetFiles("*.json*");
				foreach (FileInfo fileInfo in files)
				{
					if (fileInfo.LastWriteTimeUtc < DateTime.UtcNow.AddDays(-120.0))
					{
						fileInfo.Delete();
					}
				}
				string path = Path.Combine(Dir(owner), "checkpoints");
				if (Directory.Exists(path))
				{
					Directory.Delete(path, recursive: true);
				}
			}
			catch
			{
			}
		}

		public ClassProgress ProgressFor(string classId)
		{
			foreach (ClassProgress @class in Data.classes)
			{
				if (@class.classId == classId)
				{
					return @class;
				}
			}
			ClassProgress classProgress = new ClassProgress
			{
				classId = classId
			};
			Data.classes.Add(classProgress);
			MarkDirty();
			return classProgress;
		}

		public void MarkDirty()
		{
			_dirty = true;
		}

		public void Tick()
		{
			if (_dirty && !(Time.unscaledTime < _nextSave))
			{
				SaveNow();
			}
		}

		public void SaveNow()
		{
			if (!Loaded)
			{
				return;
			}
			_dirty = false;
			_nextSave = Time.unscaledTime + (Game.InLevel() ? 20f : 5f);
			if (IsTempKey(RunKey))
			{
				return;
			}
			try
			{
				if (Game.IsMaster())
				{
					SaveBook.Put(RunKey, OwnerId, Data);
					SaveBook.WriteNow();
				}
				else
				{
					string json = Json.Serialize(Data, pretty: false);
					Net.PushProgress(RunKey, OwnerId, json);
					SaveWriter.Queue(CachePath(OwnerId, RunKey), json);
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("Could not save run: " + ex.Message));
			}
		}
	}
	internal static class SaveBook
	{
		[Serializable]
		public class FileData
		{
			public int version = 3;

			public string saveId = "";

			public string runId = "";

			public string updatedUtc = "";

			public List<PlayerEntry> players = new List<PlayerEntry>();
		}

		[Serializable]
		public class PlayerEntry
		{
			public string steamId = "";

			public string name = "";

			public RunSave run = new RunSave();

			public bool hasRun = true;

			public double scrap;

			public bool scrapStarted;

			public AbilityLedger ledger = new AbilityLedger();
		}

		public const int Version = 3;

		private static FileData? _book;

		private static string _saveId = "";

		private static bool _dirty;

		private static float _nextWrite;

		private static readonly HashSet<string> Ended = new HashSet<string>();

		public static string Folder => Path.Combine(ClassDatabase.Folder, "saves");

		public static string CurrentId => _saveId;

		private static string PathFor(string saveId)
		{
			return Path.Combine(Folder, RunStore.Safe(saveId) + ".json");
		}

		public static void Open(string saveId)
		{
			if (!RunStore.IsTempKey(saveId) && !(saveId == _saveId))
			{
				WriteNow();
				_saveId = saveId;
				_dirty = false;
				Directory.CreateDirectory(Folder);
				SaveWriter.Flush();
				_book = SaveWriter.ReadWithBackup<FileData>(PathFor(saveId), "save data");
				if (_book != null)
				{
					Migrate(_book);
					Plugin.Log.LogInfo((object)$"Save '{saveId}': progress for {_book.players.Count} player(s) loaded.");
				}
				else
				{
					_book = new FileData
					{
						saveId = saveId
					};
					ImportOldRuns(_book);
				}
				if (string.IsNullOrEmpty(_book.runId))
				{
					_book.runId = NewRunId();
					_dirty = true;
				}
			}
		}

		public static string NewRunId()
		{
			return Guid.NewGuid().ToString("N").Substring(0, 12);
		}

		public static string RunIdFor(string saveId)
		{
			if (RunStore.IsTempKey(saveId) || Ended.Contains(saveId))
			{
				return "";
			}
			Open(saveId);
			if (_book == null || !(_saveId == saveId))
			{
				return "";
			}
			return _book.runId;
		}

		public static string StartNewRun(string saveId)
		{
			if (RunStore.IsTempKey(saveId))
			{
				return "";
			}
			Ended.Remove(saveId);
			if (_saveId != saveId)
			{
				WriteNow();
			}
			_saveId = saveId;
			_book = new FileData
			{
				saveId = saveId,
				runId = NewRunId()
			};
			_dirty = false;
			return _book.runId;
		}

		private static void Migrate(FileData b)
		{
			if (b.players == null)
			{
				b.players = new List<PlayerEntry>();
			}
			b.players.RemoveAll((PlayerEntry p) => p == null || string.IsNullOrEmpty(p.steamId));
			foreach (PlayerEntry player in b.players)
			{
				PlayerEntry current;
				PlayerEntry playerEntry = (current = player);
				if (current.run == null)
				{
					current.run = new RunSave();
				}
				RunStore.Normalize(playerEntry.run);
				current = playerEntry;
				if (current.ledger == null)
				{
					current.ledger = new AbilityLedger();
				}
				AbilityLedger ledger = playerEntry.ledger;
				if (ledger.supplied == null)
				{
					ledger.supplied = new List<string>();
				}
			}
			if (b.version > 3)
			{
				Plugin.Log.LogWarning((object)$"Save data was written by a newer RepoRPG (v{b.version}); reading what this version understands.");
			}
			b.version = 3;
		}

		private static void ImportOldRuns(FileData b)
		{
			try
			{
				string path = Path.Combine(ClassDatabase.Folder, "runs");
				if (!Directory.Exists(path))
				{
					return;
				}
				string path2 = RunStore.Safe(b.saveId) + ".json";
				DirectoryInfo[] directories = new DirectoryInfo(path).GetDirectories();
				foreach (DirectoryInfo directoryInfo in directories)
				{
					string path3 = Path.Combine(directoryInfo.FullName, path2);
					if (File.Exists(path3))
					{
						RunSave runSave = SaveWriter.ReadWithBackup<RunSave>(path3, "old run file");
						if (runSave != null)
						{
							RunStore.Normalize(runSave);
							b.players.Add(new PlayerEntry
							{
								steamId = directoryInfo.Name,
								run = runSave
							});
						}
					}
				}
				if (b.players.Count > 0)
				{
					_dirty = true;
					Plugin.Log.LogInfo((object)$"Save '{b.saveId}': brought in {b.players.Count} player(s) from the old save format.");
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("Couldn't read old run files: " + ex.Message));
			}
		}

		public static RunSave? Get(string saveId, string steamId)
		{
			Open(saveId);
			if (_book == null || saveId != _saveId || Ended.Contains(saveId))
			{
				return null;
			}
			foreach (PlayerEntry player in _book.players)
			{
				if (!(player.steamId != steamId))
				{
					if (!player.hasRun)
					{
						return null;
					}
					if (string.IsNullOrEmpty(player.run.runId))
					{
						player.run.runId = _book.runId;
					}
					if (player.run.runId != _book.runId)
					{
						Plugin.Log.LogWarning((object)("[run] " + steamId + "'s stored progress is from run '" + player.run.runId + "', not the current run '" + _book.runId + "': not used."));
						return null;
					}
					return player.run;
				}
			}
			return null;
		}

		private static PlayerEntry? Entry(string saveId, string steamId, bool create, string name = "")
		{
			if (string.IsNullOrEmpty(steamId) || Ended.Contains(saveId) || RunStore.IsTempKey(saveId))
			{
				return null;
			}
			Open(saveId);
			if (_book == null || saveId != _saveId)
			{
				return null;
			}
			PlayerEntry playerEntry = null;
			foreach (PlayerEntry player in _book.players)
			{
				if (player.steamId == steamId)
				{
					playerEntry = player;
					break;
				}
			}
			if (playerEntry == null)
			{
				if (!create)
				{
					return null;
				}
				playerEntry = new PlayerEntry
				{
					steamId = steamId,
					name = name,
					hasRun = false
				};
				_book.players.Add(playerEntry);
				_dirty = true;
			}
			if (!playerEntry.scrapStarted)
			{
				playerEntry.scrap = Math.Max(0, Plugin.Cfg.StartingScrap.Value);
				playerEntry.scrapStarted = true;
				_dirty = true;
			}
			return playerEntry;
		}

		public static AbilityLedger? Ledger(string saveId, string steamId, string name = "")
		{
			PlayerEntry playerEntry = Entry(saveId, steamId, create: true, name);
			if (playerEntry == null)
			{
				return null;
			}
			PlayerEntry playerEntry2 = playerEntry;
			if (playerEntry2.ledger == null)
			{
				playerEntry2.ledger = new AbilityLedger();
			}
			AbilityLedger ledger = playerEntry.ledger;
			if (ledger.supplied == null)
			{
				ledger.supplied = new List<string>();
			}
			return playerEntry.ledger;
		}

		public static void MarkDirty()
		{
			_dirty = true;
		}

		public static double GetScrap(string saveId, string steamId)
		{
			return Entry(saveId, steamId, create: false)?.scrap ?? ((double)Math.Max(0, Plugin.Cfg.StartingScrap.Value));
		}

		public static double AddScrap(string saveId, string steamId, double amount, string name = "")
		{
			PlayerEntry playerEntry = Entry(saveId, steamId, create: true, name);
			if (playerEntry == null)
			{
				return 0.0;
			}
			playerEntry.scrap = Math.Max(0.0, playerEntry.scrap + amount);
			_dirty = true;
			return playerEntry.scrap;
		}

		public static void Put(string saveId, string steamId, RunSave run, string name = "")
		{
			if (string.IsNullOrEmpty(steamId) || Ended.Contains(saveId))
			{
				return;
			}
			Open(saveId);
			if (_book == null || saveId != _saveId)
			{
				return;
			}
			run.runId = _book.runId;
			foreach (PlayerEntry player in _book.players)
			{
				if (!(player.steamId != steamId))
				{
					player.run = run;
					player.hasRun = true;
					if (name != "")
					{
						player.name = name;
					}
					_dirty = true;
					return;
				}
			}
			_book.players.Add(new PlayerEntry
			{
				steamId = steamId,
				name = name,
				run = run,
				scrap = Math.Max(0, Plugin.Cfg.StartingScrap.Value),
				scrapStarted = true
			});
			_dirty = true;
		}

		public static void Tick()
		{
			if (_dirty && Time.unscaledTime >= _nextWrite)
			{
				WriteNow();
			}
		}

		public static void WriteNow()
		{
			if (_book == null || _saveId == "" || !_dirty || Ended.Contains(_saveId))
			{
				return;
			}
			_dirty = false;
			_nextWrite = Time.unscaledTime + 10f;
			_book.updatedUtc = DateTime.UtcNow.ToString("o");
			_book.version = 3;
			try
			{
				SaveWriter.Queue(PathFor(_saveId), Json.Serialize(_book, pretty: false));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("Could not save run data: " + ex.Message));
			}
		}

		public static void Delete(string saveId)
		{
			if (RunStore.IsTempKey(saveId))
			{
				return;
			}
			if (Game.IsMaster() && saveId == RunInfo.Key)
			{
				PatchGuard.Run("run recap (game over)", RunShape.HostRunOver);
			}
			Ended.Add(saveId);
			if (saveId == _saveId)
			{
				_book = null;
				_saveId = "";
				_dirty = false;
			}
			SaveWriter.Delete(PathFor(saveId));
			RunInfo.ForgetSave(saveId);
			try
			{
				string path = Path.Combine(ClassDatabase.Folder, "runs");
				if (Directory.Exists(path))
				{
					DirectoryInfo[] directories = new DirectoryInfo(path).GetDirectories();
					for (int i = 0; i < directories.Length; i++)
					{
						SaveWriter.Delete(Path.Combine(directories[i].FullName, RunStore.Safe(saveId) + ".json"));
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("Couldn't remove old run files for '" + saveId + "': " + ex.Message));
			}
			Plugin.Log.LogInfo((object)("Save '" + saveId + "' was deleted by the game (run over): its RPG progress was removed too."));
			if (Game.IsMaster())
			{
				PatchGuard.Run("new run", delegate
				{
					RunReset.HostNewRun(saveId, "the game deleted the save (run over)");
				});
			}
		}

		public static void Revive(string saveId)
		{
			Ended.Remove(saveId);
		}
	}
	internal static class SaveWriter
	{
		private static readonly object Lock = new object();

		private static readonly object WriteLock = new object();

		private static readonly Dictionary<string, (string? json, long seq)> Pending = new Dictionary<string, (string, long)>();

		private static readonly Dictionary<string, long> Written = new Dictionary<string, long>();

		private static long _seq;

		private static bool _busy;

		public static void Queue(string path, string json)
		{
			Enqueue(path, json);
		}

		public static void Delete(string path)
		{
			Enqueue(path, null);
		}

		private static void Enqueue(string path, string? json)
		{
			lock (Lock)
			{
				Pending[path] = (json, ++_seq);
				if (_busy)
				{
					return;
				}
				_busy = true;
			}
			if (!ThreadPool.QueueUserWorkItem(delegate
			{
				Run();
			}))
			{
				lock (Lock)
				{
					_busy = false;
				}
				Flush();
			}
		}

		private static void Run()
		{
			while (true)
			{
				string key;
				(string, long) value;
				lock (Lock)
				{
					if (Pending.Count == 0)
					{
						_busy = false;
						break;
					}
					KeyValuePair<string, (string, long)> keyValuePair = Pending.First();
					key = keyValuePair.Key;
					value = keyValuePair.Value;
					Pending.Remove(key);
				}
				lock (WriteLock)
				{
					ApplyNewest(key, value.Item1, value.Item2);
				}
			}
		}

		public static void Flush()
		{
			List<KeyValuePair<string, (string, long)>> list;
			lock (Lock)
			{
				list = new List<KeyValuePair<string, (string, long)>>(Pending);
				Pending.Clear();
			}
			lock (WriteLock)
			{
				foreach (KeyValuePair<string, (string, long)> item in list)
				{
					ApplyNewest(item.Key, item.Value.Item1, item.Value.Item2);
				}
			}
		}

		private static void ApplyNewest(string path, string? json, long seq)
		{
			if (!Written.TryGetValue(path, out var value) || value <= seq)
			{
				Written[path] = seq;
				Apply(path, json);
			}
		}

		private static void Apply(string path, string? json)
		{
			try
			{
				if (json == null)
				{
					string[] array = new string[3]
					{
						path,
						path + ".bak",
						path + ".tmp"
					};
					foreach (string path2 in array)
					{
						if (File.Exists(path2))
						{
							File.Delete(path2);
						}
					}
					return;
				}
				Directory.CreateDirectory(Path.GetDirectoryName(path));
				string text = path + ".tmp";
				File.WriteAllText(text, json);
				if (File.Exists(path))
				{
					try
					{
						File.Replace(text, path, path + ".bak");
						return;
					}
					catch
					{
						File.Copy(path, path + ".bak", overwrite: true);
						File.Delete(path);
					}
				}
				File.Move(text, path);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("Could not write " + Path.GetFileName(path) + ": " + ex.Message));
			}
		}

		public static T? ReadWithBackup<T>(string path, string what) where T : class, new()
		{
			string[] array = new string[2]
			{
				path,
				path + ".bak"
			};
			foreach (string text in array)
			{
				if (!File.Exists(text))
				{
					continue;
				}
				try
				{
					T val = Json.Deserialize<T>(File.ReadAllText(text));
					if (val != null)
					{
						if (text != path)
						{
							Plugin.Log.LogWarning((object)(what + ": " + Path.GetFileName(path) + " was unreadable, using the previous copy."));
						}
						return val;
					}
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)(what + ": " + Path.GetFileName(text) + " is unreadable (" + ex.Message + "); kept as .bad."));
					try
					{
						File.Copy(text, text + ".bad", overwrite: true);
					}
					catch
					{
					}
				}
			}
			return null;
		}
	}
