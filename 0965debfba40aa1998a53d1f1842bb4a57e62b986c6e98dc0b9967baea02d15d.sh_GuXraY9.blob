				}
			}
			Plugin.Log.LogInfo((object)("[cart speed] players: " + string.Join(", ", list)));
		}

		private float PlayerSpeed(PlayerAvatar p)
		{
			if (!_movers.TryGetValue(Game.ActorNumber(p), out Mover value))
			{
				return 0f;
			}
			return value.Speed;
		}

