			ScaleMonsters = c.Bind<float>("Scaling", "Monsters", 100f, new ConfigDescription("Monster count and respawn rate (% of the default curve: x2.2 at 20 players).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleHealth = c.Bind<float>("Scaling", "Health", 100f, new ConfigDescription("Monster health (% of the default curve: x1.6 at 20 players).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleDamage = c.Bind<float>("Scaling", "Damage", 0f, new ConfigDescription("Monster damage (% of the default curve: x1.4 at 20 players). Off by default.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleValuables = c.Bind<float>("Scaling", "Valuables", 100f, new ConfigDescription("Valuable count and value (% of the default curve: x2.5 at 20 players).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleHaulGoal = c.Bind<float>("Scaling", "HaulGoal", 100f, new ConfigDescription("Haul goal (% of the default curve: x2.2 at 20 players).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleElites = c.Bind<float>("Scaling", "Elites", 100f, new ConfigDescription("Elite chance (% of the default curve: x1.6 at 20 players; the elite cap stays), and a boss's extra modifier at 12+ players.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			ScaleEconomy = c.Bind<float>("Scaling", "Economy", 100f, new ConfigDescription("Scrap from the haul: 100 = each player earns about what they would in a 4-player game. 0 = the haul is split as usual.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			BossHealth15 = c.Bind<float>("Bosses", "BossHealth11to15", 4f, new ConfigDescription("Boss effective health with 11-15 players (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			BossHealth20 = c.Bind<float>("Bosses", "BossHealth16to20", 4.5f, new ConfigDescription("Boss effective health with 16-20 players (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			WithMutators = c.Bind<MutatorMode>("Threat", "WithMutators", MutatorMode.SkipThreat, "With the Mutators mod, on a level that has a mutator: Stack = RepoRPG scales as usual; SkipThreat = no run-progress threat that level (its rewards neither); SkipDanger = also no player-count danger (more monsters, health, damage, elites) that level - loot and the goal still scale.");
