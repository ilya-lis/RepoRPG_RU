		private string WaitingFor(string what, int votes, Func<int, bool> voted)
		{
			if (!Game.IsMaster() || !Game.IsMultiplayer())
			{
				return "";
			}
			List<PlayerAvatar> list = Game.Players();
			string text = votes + "|" + list.Count;
			if (_waitCache.TryGetValue(what, out (string, string) value) && value.Item1 == text)
			{
				return value.Item2;
			}
			List<string> list2 = new List<string>();
			foreach (PlayerAvatar item in list)
			{
				if (!((Object)(object)item == (Object)null))
				{
					int num = Game.ActorNumber(item);
					if (!voted(num))
					{
						list2.Add(ClassClaims.NameOf(num));
					}
				}
			}
			string text2 = "";
			if (list2.Count > 0)
			{
				string text3 = ((list2.Count > 6) ? (string.Join(", ", list2.GetRange(0, 6)) + $" +{list2.Count - 6} more") : string.Join(", ", list2));
				text2 = "<color=#ffd75a>Waiting for:</color> " + text3;
			}
			_waitCache[what] = (text, text2);
			return text2;
		}

