	internal static class AttrBonus
	{
		public static readonly List<AttrMilestone> Milestones = new List<AttrMilestone>();

		public static readonly List<AttrPairing> Pairings = new List<AttrPairing>();

		private static readonly Dictionary<string, string[]> Favored = new Dictionary<string, string[]>();

		private static ModConfig C => Plugin.Cfg;

		public static bool MilestonesOn => C.AttrMilestones.Value;

		public static bool PairingsOn => C.AttrPairings.Value;

		public static float Strength => Mathf.Clamp(C.AttrMilestoneStrength.Value, 0.25f, 2f);

		public static void Load()
		{
			Milestones.Clear();
			Pairings.Clear();
			Favored.Clear();
			string text = ClassDatabase.ReadEmbedded("attrbonus");
			AttrBonusFile attrBonusFile = null;
			try
			{
				attrBonusFile = Json.Deserialize<AttrBonusFile>(ClassDatabase.ReadWithOverride("attrbonus", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("attrbonus data parse error: " + ex.Message));
			}
			if (attrBonusFile != null)
			{
				AttrMilestone[] milestones = attrBonusFile.milestones;
				if (milestones != null && milestones.Length != 0)
				{
					goto IL_0082;
				}
			}
			try
			{
				attrBonusFile = Json.Deserialize<AttrBonusFile>(text);
			}
			catch
			{
				attrBonusFile = new AttrBonusFile();
			}
			goto IL_0082;
			IL_0082:
			if (attrBonusFile == null)
			{
				return;
			}
			AttrMilestone[] array = attrBonusFile.milestones ?? Array.Empty<AttrMilestone>();
			foreach (AttrMilestone attrMilestone in array)
			{
				if (attrMilestone != null && AttributeAlloc.Find(attrMilestone.attr) != null)
				{
					AttrMilestone attrMilestone2 = attrMilestone;
					if (attrMilestone2.effects == null)
					{
						attrMilestone2.effects = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("milestone " + attrMilestone.name, attrMilestone.effects);
					Milestones.Add(attrMilestone);
				}
			}
			Milestones.Sort((AttrMilestone a, AttrMilestone b) => a.at.CompareTo(b.at));
			AttrPairing[] array2 = attrBonusFile.pairings ?? Array.Empty<AttrPairing>();
			foreach (AttrPairing attrPairing in array2)
			{
				if (attrPairing != null && AttributeAlloc.Find(attrPairing.a) != null && AttributeAlloc.Find(attrPairing.b) != null)
				{
					AttrPairing attrPairing2 = attrPairing;
					if (attrPairing2.effects == null)
					{
						attrPairing2.effects = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("pairing " + attrPairing.id, attrPairing.effects);
					Pairings.Add(attrPairing);
				}
			}
			AttrAffinity[] array3 = attrBonusFile.affinity ?? Array.Empty<AttrAffinity>();
			foreach (AttrAffinity attrAffinity in array3)
			{
				if (attrAffinity != null && attrAffinity.@class != "")
				{
					Favored[attrAffinity.@class] = attrAffinity.attrs ?? Array.Empty<string>();
				}
			}
		}

		public static bool IsFavored(string? classId, string attrId)
		{
			if (classId != null && Favored.TryGetValue(classId, out string[] value))
			{
				return Array.IndexOf(value, attrId) >= 0;
			}
			return false;
		}

		public static string[] FavoredOf(string? classId)
		{
			if (classId == null || !Favored.TryGetValue(classId, out string[] value))
			{
				return Array.Empty<string>();
			}
			return value;
		}

		public static int Needed(string? classId, AttrMilestone m)
		{
			if (!IsFavored(classId, m.attr))
			{
				return m.at;
			}
			return m.at - 1;
		}

		public static IEnumerable<AttrMilestone> MilestonesOf(string attrId)
		{
			foreach (AttrMilestone milestone in Milestones)
			{
				if (milestone.attr == attrId)
				{
					yield return milestone;
				}
			}
		}

		public static IEnumerable<AttrPairing> PairingsOf(string attrId)
		{
			foreach (AttrPairing pairing in Pairings)
			{
				if (pairing.a == attrId || pairing.b == attrId)
				{
					yield return pairing;
				}
			}
		}

		public static List<(string key, string name, string desc, EffectDef[] effects)> Active(Func<string, int> pts, string? classId)
		{
			List<(string, string, string, EffectDef[])> list = new List<(string, string, string, EffectDef[])>();
			if (MilestonesOn)
			{
				foreach (AttrMilestone milestone in Milestones)
				{
					if (pts(milestone.attr) >= Needed(classId, milestone))
					{
						list.Add(("m:" + milestone.attr + milestone.at, milestone.name, milestone.desc, milestone.effects));
					}
				}
			}
			if (PairingsOn)
			{
				foreach (AttrPairing pairing in Pairings)
				{
					if (pts(pairing.a) >= pairing.at && pts(pairing.b) >= pairing.at)
					{
						list.Add(("p:" + pairing.id, pairing.name, pairing.desc, pairing.effects));
					}
				}
			}
			return list;
		}

		public static List<(string key, string name, string desc, EffectDef[] effects)> Active(RunSave run, string? classId)
		{
			return Active((string id) => run.AttributePoints(id), classId);
		}

		public static string Title(Func<string, int> pts)
		{
			AttributeDef[] attributes = Plugin.Rpg.attributes;
			int total = 0;
			int num = 0;
			int num2 = 0;
			string text = "";
			AttributeDef[] array = attributes;
			foreach (AttributeDef attributeDef in array)
			{
				int num3 = pts(attributeDef.id);
				total += num3;
				if (num3 >= 2)
				{
					num2++;
				}
				if (num3 > num)
				{
					num = num3;
					text = attributeDef.id;
				}
			}
			if (total < 5)
			{
				return "Unspent Potential";
			}
			if (Half(new string[2] { "weapon", "vitality" }))
			{
				return "Bruiser";
			}
			if (Half(new string[2] { "stealth", "agility" }))
			{
				return "Ghost";
			}
			if (Half(new string[3] { "grip", "finesse", "endurance" }))
			{
				return "Pack Rat";
			}
			if (text == "fortune" && num >= 8)
			{
				return "Lucky Devil";
			}
			if (Half(new string[2] { "throw", "reach" }))
			{
				return "Marksman";
			}
			if (text == "focus" && num >= 8)
			{
				return "Spellslinger";
			}
			if (Half(new string[2] { "recovery", "vitality" }) && pts("recovery") >= 6)
			{
				return "Field Medic";
			}
			if (Half(new string[2] { "agility", "leap" }))
			{
				return "Acrobat";
			}
			if (num * 10 >= total * 6)
			{
				return "Specialist";
			}
			if (text == "vitality" && num >= 8)
			{
				return "Tank";
			}
			if (num2 >= 8)
			{
				return "Jack of All Trades";
			}
			return "Balanced";
			bool Half(string[] ids)
			{
				int num4 = 0;
				foreach (string arg in ids)
				{
					num4 += pts(arg);
				}
				if (total > 0)
				{
					return num4 * 2 >= total;
				}
				return false;
			}
		}
	}
	internal static class BigLobby
	{
		public const int VanillaMax = 6;

		public const int HardMax = 20;

		private static int _other = -1;

		private static int _own = 6;

		private static Type? _gmType;

		private static FieldInfo? _gmInst;

		private static MethodInfo? _setMax;

		private static float _next;

		private static bool _toldPhoton;

		private static readonly Dictionary<int, float> JoinedAt = new Dictionary<int, float>();

		private static readonly HashSet<int> ToldNoMod = new HashSet<int>();

		private static Type? _spawnType;

		private static readonly Collider[] Overlap = (Collider[])(object)new Collider[8];

		private static int _sceneSerial;

		private static int _madeForSerial = -1;

		private static int _madeCount;

		private static bool _sceneHooked;

		public static string OtherModName { get; private set; } = "";

		public static bool StandDown
		{
			get
			{
				if (_other >= 0)
				{
					return _other == 1;
				}
				_other = 0;
				try
				{
					foreach (KeyValuePair<string, PluginInfo> pluginInfo in Chainloader.PluginInfos)
					{
						string text = (pluginInfo.Key ?? "").ToLowerInvariant();
						PluginInfo value = pluginInfo.Value;
						object obj;
						if (value == null)
						{
							obj = null;
						}
						else
						{
							BepInPlugin metadata = value.Metadata;
							obj = ((metadata != null) ? metadata.Name : null);
						}
						if (obj == null)
						{
							obj = "";
						}
						string text2 = ((string)obj).ToLowerInvariant();
						if (!text.Contains("semibotrpg") && (text.Contains("moreplayers") || text2.Contains("moreplayers") || text2.Contains("more players") || text.Contains("more_players") || text2.Contains("more_players")))
						{
							_other = 1;
							PluginInfo value2 = pluginInfo.Value;
							object obj2;
							if (value2 == null)
							{
								obj2 = null;
							}
							else
							{
								BepInPlugin metadata2 = value2.Metadata;
								obj2 = ((metadata2 != null) ? metadata2.Name : null);
							}
							if (obj2 == null)
							{
								obj2 = pluginInfo.Key ?? "";
							}
							OtherModName = (string)obj2;
							Plugin.Log.LogInfo((object)("[players] '" + OtherModName + "' is installed: it controls the lobby size; RepoRPG's own lobby size, spawn points and lobby list stand down (difficulty scaling stays on)."));
							break;
						}
					}
				}
				catch
				{
				}
				return _other == 1;
			}
		}

		public static int Desired
		{
			get
			{
				if (!SettingsSync.Overridden)
				{
					_own = Plugin.Cfg.MaxPlayers.Value;
				}
				return Mathf.Clamp(_own, 1, 20);
			}
		}

		private static object? Gm()
		{
			try
			{
				if ((object)_gmType == null)
				{
					_gmType = AccessTools.TypeByName("GameManager");
				}
				if (_gmType == null)
				{
					return null;
				}
				if ((object)_gmInst == null)
				{
					_gmInst = AccessTools.Field(_gmType, "instance");
				}
				return _gmInst?.GetValue(null);
			}
			catch
			{
				return null;
			}
		}

		public static int GameMax()
		{
			object obj = Gm();
			if (obj != null)
			{
				return Game.Get(obj, "maxPlayers", 6);
			}
			return 6;
		}

		public static int PhotonMax()
		{
			object obj = Gm();
			if (obj != null)
			{
				return Mathf.Clamp(Game.Get(obj, "maxPlayersPhoton", 20), 1, 20);
			}
			return 20;
		}

		public static void Tick()
		{
			float unscaledTime = Time.unscaledTime;
			if (unscaledTime < _next)
			{
				return;
			}
			_next = unscaledTime + 1f;
			try
			{
				CheckJoiners();
			}
			catch (Exception ex)
			{
				Game.WarnOnce("[players] joiner check: " + ex.Message);
			}
			if (StandDown)
			{
				return;
			}
			object obj = Gm();
			if (obj == null)
			{
				return;
			}
			bool inRoom = PhotonNetwork.InRoom;
			if (inRoom && !PhotonNetwork.IsMasterClient)
			{
				return;
			}
			int num = PhotonMax();
			int num2 = Mathf.Clamp(Desired, 1, num);
			if (Desired > num && !_toldPhoton)
			{
				_toldPhoton = true;
				Plugin.Log.LogWarning((object)$"[players] Photon allows at most {num} players per room here: the lobby is {num}, not {Desired}.");
			}
			int num3 = Game.Get(obj, "maxPlayers", 6);
			if (num3 == num2)
			{
				return;
			}
			try
			{
				if (inRoom)
				{
					if ((object)_gmType == null)
					{
						_gmType = obj.GetType();
					}
					if ((object)_setMax == null)
					{
						_setMax = AccessTools.Method(_gmType, "SetMaxPlayers", new Type[1] { typeof(int) }, (Type[])null);
					}
					if (_setMax != null)
					{
						_setMax.Invoke(obj, new object[1] { num2 });
					}
					else
					{
						Game.Set(obj, "maxPlayers", num2);
					}
				}
				else
				{
					Game.Set(obj, "maxPlayers", num2);
				}
				Plugin.Log.LogInfo((object)$"[players] lobby size {num3} -> {num2}.");
			}
			catch (Exception ex2)
			{
				Game.WarnOnce("[players] couldn't set the lobby size: " + ex2.GetBaseException().Message);
			}
		}

		public static void OnPlayerEntered(int actor)
		{
			if (actor > 0)
			{
				JoinedAt[actor] = Time.unscaledTime;
			}
		}

		private static void CheckJoiners()
		{
			//IL_01e2: Unknown result type (might be due to invalid IL or missing references)
			if (!PhotonNetwork.InRoom)
			{
				if (JoinedAt.Count > 0 || ToldNoMod.Count > 0 || Net.HeardFrom.Count > 0)
				{
					JoinedAt.Clear();
					ToldNoMod.Clear();
					Net.HeardFrom.Clear();
				}
			}
			else
			{
				if (JoinedAt.Count == 0 || !PhotonNetwork.IsMasterClient || PhotonNetwork.CurrentRoom == null)
				{
					return;
				}
				float unscaledTime = Time.unscaledTime;
				List<int> list = null;
				foreach (KeyValuePair<int, float> item in JoinedAt)
				{
					Player player = PhotonNetwork.CurrentRoom.GetPlayer(item.Key, false);
					if (player == null || HostSettings.HasAck(item.Key) || Net.HeardFrom.ContainsKey(item.Key))
					{
						(list ?? (list = new List<int>())).Add(item.Key);
					}
					else
					{
						if (unscaledTime - item.Value < 60f || PhotonNetwork.CurrentRoom.MaxPlayers <= 6)
						{
							continue;
						}
						(list ?? (list = new List<int>())).Add(item.Key);
						if (ToldNoMod.Add(item.Key))
						{
							bool flag = Plugin.Cfg.VersionMismatch.Value == MismatchMode.Kick;
							string text = player.NickName ?? $"Player {item.Key}";
							Plugin.Log.LogWarning((object)("[players] " + text + " hasn't answered RepoRPG's settings: they probably don't have the mod (needed in lobbies over 6)" + (flag ? ": removed" : "") + "."));
							RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, text + " doesn't seem to have RepoRPG: lobbies over 6 players need it" + (flag ? " (removed)." : "."), (Color?)new Color(1f, 0.6f, 0.4f), "");
							if (flag)
							{
								Net.Kick(item.Key);
							}
						}
					}
				}
				if (list == null)
				{
					return;
				}
				foreach (int item2 in list)
				{
					JoinedAt.Remove(item2);
				}
			}
		}

		public static void BeforeMatchmaking()
		{
			if (!StandDown)
			{
				object obj = Gm();
				if (obj != null)
				{
					Game.Set(obj, "matchmakingMaxPlayers", Desired <= 6);
				}
			}
		}

		public static string SizeText()
		{
			if (!PhotonNetwork.InRoom || PhotonNetwork.CurrentRoom == null)
			{
				return "";
			}
			int maxPlayers = PhotonNetwork.CurrentRoom.MaxPlayers;
			if (maxPlayers <= 0)
			{
				return $"{PhotonNetwork.CurrentRoom.PlayerCount} players";
			}
			return $"{PhotonNetwork.CurrentRoom.PlayerCount} / {maxPlayers} players";
		}

		public static void HookScenes()
		{
			if (!_sceneHooked)
			{
				_sceneHooked = true;
				SceneManager.sceneLoaded += delegate
				{
					_sceneSerial++;
				};
			}
		}

