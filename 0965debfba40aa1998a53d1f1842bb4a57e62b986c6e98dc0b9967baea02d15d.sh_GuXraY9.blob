			int num2 = 0;
			for (int num3 = 1; num3 <= 3; num3++)
			{
				if (list.Count + num2 >= num)
				{
					break;
				}
				for (int num4 = 0; num4 < 8; num4++)
				{
					if (list.Count + num2 >= num)
