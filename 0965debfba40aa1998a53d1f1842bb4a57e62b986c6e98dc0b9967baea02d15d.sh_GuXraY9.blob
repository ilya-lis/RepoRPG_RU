		private static BrawlFile Brawl
		{
			get
			{
				if (_brawl != null)
				{
					return _brawl;
				}
				BrawlFile brawlFile;
				try
				{
					brawlFile = Json.Deserialize<BrawlFile>(ClassDatabase.ReadWithOverride("brawl", ClassDatabase.ReadEmbedded("brawl"))) ?? new BrawlFile();
				}
				catch (Exception ex)
				{
					Plugin.Log.LogError((object)("brawl data parse error: " + ex.Message));
					brawlFile = new BrawlFile();
				}
				BrawlFile brawlFile2 = brawlFile;
				if (brawlFile2.neverAttack == null)
				{
					brawlFile2.neverAttack = Array.Empty<string>();
				}
				brawlFile2 = brawlFile;
				if (brawlFile2.neverTarget == null)
				{
					brawlFile2.neverTarget = Array.Empty<string>();
				}
				if (brawlFile.hitDamage == null || brawlFile.hitDamage.Length == 0)
				{
					brawlFile.hitDamage = new int[3] { 10, 18, 28 };
				}
				Types(brawlFile.neverAttack, NeverAttackTypes);
				Types(brawlFile.neverTarget, NeverTargetTypes);
				Plugin.Log.LogInfo((object)$"[fights] {NeverAttackTypes.Count} monster types never attack, {NeverTargetTypes.Count} are never attacked.");
				_brawl = brawlFile;
				return brawlFile;
				static void Types(string[] names, List<Type> into)
				{
					foreach (string text in names)
					{
						Type type = AccessTools.TypeByName(text);
						if (type != null)
						{
							into.Add(type);
						}
						else
						{
							Plugin.Log.LogInfo((object)("[fights] brawl.json: no monster type '" + text + "' in this game version (ignored)."));
						}
					}
				}
			}
		}

		private void AttrOnHolding(PlayerAvatar p, PhysGrabObject now, bool fresh)
		{
			float num = Mathf.Clamp(ClassStats.Get(p, "attr.steady"), 0f, 40f);
			if (num > 0f && ClassStats.ClassOf(p) != "physicist")
			{
				now.OverrideAngularDrag(1f + num / 10f, 0.25f);
			}
			if (fresh)
			{
				float num2 = Mathf.Clamp(ClassStats.Get(p, "attr.reel_in"), 0f, 3f);
				if (num2 > 0f)
				{
					now.OverrideIndestructible(num2);
				}
			}
		}

		private void TickAttrHost(List<PlayerAvatar> players, float now)
		{
			//IL_0195: Unknown result type (might be due to invalid IL or missing references)
			//IL_01a0: Unknown result type (might be due to invalid IL or missing references)
			//IL_01a5: Unknown result type (might be due to invalid IL or missing references)
			//IL_01aa: Unknown result type (might be due to invalid IL or missing references)
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player == (Object)null || (Object)(object)player.playerHealth == (Object)null)
				{
					continue;
				}
				int key = Game.ActorNumber(player);
				int num = Game.Health(player.playerHealth);
				if (_lastHp.TryGetValue(key, out var value) && num < value && ClassStats.Get(player, "attr.porter") > 0f)
				{
					PhysGrabObject val = HeldBy(player);
					if ((Object)(object)val != (Object)null && (Object)(object)((Component)val).GetComponent<ValuableObject>() != (Object)null)
					{
						val.OverrideIndestructible(1f);
					}
				}
				_lastHp[key] = num;
				float num2 = Mathf.Clamp(ClassStats.Get(player, "attr.ghosting"), 0f, 6f);
				if (num2 <= 0f || !Game.IsAlive(player))
				{
					_ghostAt.Remove(key);
					continue;
				}
				bool num3 = Game.Get(player, "isCrouching", fallback: false) && StandingStill(player);
				_ghostAt.TryGetValue(key, out (float, float) value2);
				if (!num3)
				{
					value2.Item1 = 0f;
					_ghostAt[key] = value2;
					continue;
				}
				if (value2.Item1 <= 0f)
				{
					value2.Item1 = now;
				}
				if (now - value2.Item1 >= 2f && now >= value2.Item2)
				{
					value2.Item2 = now + 30f;
					int num4 = 0;
					Game.EnemyList.Enumerator enumerator2 = Game.LivingEnemies().GetEnumerator();
					while (enumerator2.MoveNext())
					{
						EnemyHealth current2 = enumerator2.Current;
						Vector3 val2 = ((Component)current2).transform.position - ((Component)player).transform.position;
						if (((Vector3)(ref val2)).sqrMagnitude <= 225f)
						{
							CalmEnemy(current2, num2, 0f);
							num4++;
						}
					}
					if (num4 > 0)
					{
						Net.SendNotice(player, Notice.Text, 0f, "Ghosting: monsters lost your trail");
					}
				}
				_ghostAt[key] = value2;
			}
		}

