		public static string RewardLine(int lvl)
		{
			if (lvl > 0)
			{
				return $"+{(float)lvl * C.AscXpPerLevel.Value:0}% XP, +{(float)lvl * C.AscScrapPerLevel.Value:0}% Scrap, +{(float)lvl * C.AscDataPerLevel.Value:0}% Data" + ((lvl >= 4) ? $", +{lvl / 4} gear luck" : "");
			}
			return "normal rewards";
		}

		public static int ClassBest(string cls)
		{
			NodeRank nodeRank = Mine.classBest.Find((NodeRank x) => x.id == cls);
			if (nodeRank == null)
			{
				return -1;
			}
			return nodeRank.rank - 1;
		}

		public static int HostMaxPick()
		{
			int num = HighestWon;
			if (C.AscSource.Value == AscensionSource.Anyone)
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if (!((Object)(object)item == (Object)null))
					{
						Account.Peer peer = Account.PeerOf(Game.ActorNumber(item));
						if (peer != null)
						{
							num = Mathf.Max(num, peer.Asc);
						}
					}
				}
			}
			return Mathf.Clamp(num + 1, 0, 20);
		}

		public static void HostPick(int lvl)
		{
			TeamRunSave teamRunSave = RpgRuntime.Instance?.HostRun?.team;
			if (teamRunSave != null && CanPick)
			{
				teamRunSave.ascension = Mathf.Clamp(lvl, 0, HostMaxPick());
				RpgRuntime.Instance?.MarkRunDirty();
				HostBroadcast();
				Plugin.Log.LogInfo((object)$"[ascension] host picked A{teamRunSave.ascension}.");
			}
		}

		public static void HostBroadcast(int actor = -1)
		{
			if (Game.IsMaster())
			{
				Net.SendAscension(HostLevel, actor);
			}
		}

		public static void Apply(int lvl)
		{
			_synced = Mathf.Clamp(lvl, 0, 20);
			RpgRuntime.Instance?.OnAscensionChanged();
		}

		public static void HostNewRun()
		{
			TeamRunSave teamRunSave = RpgRuntime.Instance?.HostRun?.team;
			if (teamRunSave != null && Game.IsMaster() && On)
			{
				int num = ((Mine.nextPick >= 0) ? Mine.nextPick : 0);
				teamRunSave.ascension = Mathf.Clamp(num, 0, HostMaxPick());
				Mine.nextPick = -1;
				Account.MarkDirty();
				HostBroadcast();
			}
		}

		public static void HostCreditWin()
		{
			if (!On)
			{
				return;
			}
			int level = Level;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null)
				{
					Net.SendAscensionWin(item, level);
				}
			}
			Plugin.Log.LogInfo((object)$"[ascension] win at A{level} credited to {Game.Players().Count} player(s).");
		}

		public static string DebugWinNext()
		{
			if (!Game.IsMaster())
			{
				return "host only";
			}
			if (!On)
			{
				return "Ascension is off (Ascension/On, Season/On)";
			}
			int num = Mathf.Clamp(HighestWon + 1, 0, 20);
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null)
				{
					Net.SendAscensionWin(item, num);
				}
			}
			Plugin.Log.LogInfo((object)$"[ascension] debug: win at A{num} for {Game.Players().Count} player(s).");
			return $"Ascension win at A{num} (everyone)";
		}

		public static void OnWin(int lvl, string cls)
		{
			AscensionSave mine = Mine;
			lvl = Mathf.Clamp(lvl, 0, 20);
			bool flag = lvl > mine.highest;
			if (flag)
			{
				mine.highest = lvl;
			}
			if (cls != "")
			{
				NodeRank nodeRank = mine.classBest.Find((NodeRank x) => x.id == cls);
				if (nodeRank == null)
				{
					mine.classBest.Add(new NodeRank
					{
						id = cls,
						rank = lvl + 1
					});
				}
				else if (nodeRank.rank < lvl + 1)
				{
					nodeRank.rank = lvl + 1;
				}
			}
			if (!mine.rewarded.Contains(lvl))
			{
				mine.rewarded.Add(lvl);
				Research.Receive(100f + 25f * (float)lvl, $"Ascension {lvl} win");
			}
			Account.Max("ascension", mine.highest);
			Account.MarkDirty();
			Account.SaveNow();
			RpgRuntime.Instance?.SendAccountSummarySoon();
			RpgRuntime.Instance?.OnAscensionWin(lvl, flag);
		}

		public static bool UniqueAllowed(string unlock)
		{
			if (!(unlock == "asc10"))
			{
				if (!(unlock == "asc20"))
				{
					return true;
				}
				return HighestWon >= 20;
			}
			return HighestWon >= 10;
		}

		public static void NoteScrap(PlayerAvatar p, double amount)
		{
			if (!A(19) || (Object)(object)p == (Object)null || amount <= 0.0)
			{
				return;
			}
			if (_scrapLevel != RunInfo.LevelIndex)
			{
				ScrapLastLevel.Clear();
				foreach (KeyValuePair<int, double> item in ScrapThisLevel)
				{
					ScrapLastLevel[item.Key] = item.Value;
				}
				ScrapThisLevel.Clear();
				_scrapLevel = RunInfo.LevelIndex;
			}
			int key = Game.ActorNumber(p);
			ScrapThisLevel.TryGetValue(key, out var value);
			ScrapThisLevel[key] = value + amount;
		}

		public static void HostTick()
		{
			if (!Game.IsMaster() || !On || Time.time < _nextTick)
			{
				return;
			}
			if (CanPick && Mine.nextPick >= 0 && RpgRuntime.Instance?.HostRun != null)
			{
				int nextPick = Mine.nextPick;
				Mine.nextPick = -1;
				Account.MarkDirty();
				HostPick(nextPick);
			}
			if (Level <= 0 || !Game.InLevel() || Game.IsLoading())
			{
				return;
			}
			_nextTick = Time.time + 1f;
			int levelIndex = RunInfo.LevelIndex;
			if (A(19) && _markLevel != levelIndex)
			{
				_markLevel = levelIndex;
				MarkedActor = 0;
				double num = 0.0;
				foreach (KeyValuePair<int, double> item in ScrapLastLevel)
				{
					if (item.Value > num)
					{
						num = item.Value;
						MarkedActor = item.Key;
					}
				}
				foreach (PlayerAvatar item2 in Game.Players())
				{
					if ((Object)(object)item2 != (Object)null && Game.ActorNumber(item2) == MarkedActor)
					{
						Net.SendNotice(item2, Notice.Popup, 0f, "Ascension: you're the Marked Earner this level - noises near you carry farther");
					}
				}
			}
			EnemyHealth val = null;
			Game.EnemyList.Enumerator enumerator3 = Game.LivingEnemies().GetEnumerator();
			while (enumerator3.MoveNext())
			{
				EnemyHealth current3 = enumerator3.Current;
				if (Elites.TryGet(current3, out var info) && info.Tier >= 3)
				{
					val = current3;
					break;
				}
			}
			if ((Object)(object)val == (Object)null)
			{
				return;
			}
			bool flag = Season.IsFinaleLevel(levelIndex);
			if (A(14) && _escortLevel != levelIndex && Time.time - Bosses.SpawnedAt > 3f)
			{
				_escortLevel = levelIndex;
				Escort(val, (!flag) ? 1 : 2);
			}
			if (!(A(20) && flag) || _thirdLevel == levelIndex)
			{
				return;
			}
			int num2 = Game.Get(val, "health", 0);
			int num3 = Game.Get(val, "healthCurrent", 0);
			if (num2 <= 0 || !((float)num3 <= (float)num2 * 0.25f))
			{
				return;
			}
			_thirdLevel = levelIndex;
			int viewId = Elites.ViewId((Component)(object)val);
			if (Elites.TryGet(viewId, out var info2))
			{
				EliteMod[] array = new EliteMod[4]
				{
					EliteMod.Swift,
					EliteMod.Unstoppable,
					EliteMod.Regenerating,
					EliteMod.Brutish
				};
				foreach (EliteMod eliteMod in array)
				{
					if ((info2.Mods & eliteMod) == 0)
					{
						Elites.Set(viewId, info2.Mods | eliteMod, info2.Tier);
						Net.BroadcastElite(viewId, info2.Mods | eliteMod, info2.Tier);
						break;
					}
				}
			}
			Escort(val, 1);
			Plugin.Log.LogInfo((object)"[ascension] Final Form: the finale boss's third phase.");
		}

		private static void Escort(EnemyHealth boss, int count)
		{
			//IL_0055: Unknown result type (might be due to invalid IL or missing references)
			//IL_0060: Unknown result type (might be due to invalid IL or missing references)
			//IL_0065: Unknown result type (might be due to invalid IL or missing references)
			//IL_006a: Unknown result type (might be due to invalid IL or missing references)
			Random random = new Random();
			for (int i = 0; i < count; i++)
			{
				EnemyHealth val = null;
				float num = float.MaxValue;
				Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
				while (enumerator.MoveNext())
				{
					EnemyHealth current = enumerator.Current;
					if (!((Object)(object)current == (Object)(object)boss) && !Elites.TryGet(current, out var _) && !BossGraveyard.IsRetired(current))
					{
						Vector3 val2 = ((Component)current).transform.position - ((Component)boss).transform.position;
						float sqrMagnitude = ((Vector3)(ref val2)).sqrMagnitude;
						if (sqrMagnitude < num)
						{
							num = sqrMagnitude;
							val = current;
						}
					}
				}
				if ((Object)(object)val == (Object)null)
				{
					break;
				}
				List<EliteMod> list = new List<EliteMod>(Elites.ModList);
				EliteMod eliteMod = EliteMod.None;
				for (int j = 0; j < 2; j++)
				{
					if (list.Count <= 0)
					{
						break;
					}
					int index = random.Next(list.Count);
					eliteMod |= list[index];
					list.RemoveAt(index);
				}
				int num2 = Elites.ViewId((Component)(object)val);
				Elites.Set(num2, eliteMod, 2);
				Net.BroadcastElite(num2, eliteMod, 2);
				HostDirector.Instance?.TrackElite(val, num2);
				Plugin.Log.LogInfo((object)("[ascension] boss escort: " + ((Object)val).name + " (" + Elites.Describe(eliteMod) + ")."));
			}
		}

		public static void Reset()
		{
			_synced = 0;
			_escortLevel = (_thirdLevel = (_markLevel = -1));
			MarkedActor = 0;
			ScrapThisLevel.Clear();
			ScrapLastLevel.Clear();
		}
	}
