	internal static class GunTuner
	{
		private sealed class Orig
		{
			public float Cooldown;

			public float Recoil;

			public float Range;
		}

		private static readonly Dictionary<ItemGun, Orig> Tuned = new Dictionary<ItemGun, Orig>();

		private static readonly Dictionary<int, float> BarAcc = new Dictionary<int, float>();

		private static readonly List<ItemGun> Gone = new List<ItemGun>();

		private static readonly HashSet<ItemGun> Seen = new HashSet<ItemGun>();

		private static float _next;

		private static PlayerAvatar? Holder(Component c)
		{
			PhysGrabObject val = c.GetComponent<PhysGrabObject>() ?? c.GetComponentInParent<PhysGrabObject>();
			if ((Object)(object)val == (Object)null || val.playerGrabbing == null)
			{
				return null;
			}
			foreach (PhysGrabber item in val.playerGrabbing)
			{
				if ((Object)(object)item != (Object)null && (Object)(object)item.playerAvatar != (Object)null)
				{
					return item.playerAvatar;
				}
			}
			return null;
		}

		public static float BatterySave(Component battery)
		{
			PlayerAvatar val = Holder(battery);
			if ((Object)(object)val == (Object)null || ClassStats.ClassOf(val) != "gunsmith")
			{
				return 0f;
			}
			PhysGrabObject val2 = battery.GetComponent<PhysGrabObject>() ?? battery.GetComponentInParent<PhysGrabObject>();
			if ((Object)(object)val2 == (Object)null || !OverclockWeapons.Supported(val2, out string _))
			{
				return 0f;
			}
			return Mathf.Clamp(ClassStats.Get(val, "gunsmith.battery_save"), 0f, 60f);
		}

		public static bool SkipBar(Component battery, float save)
		{
			int instanceID = ((Object)battery).GetInstanceID();
			BarAcc.TryGetValue(instanceID, out var value);
			value += save;
			bool num = value >= 100f;
			if (num)
			{
				value -= 100f;
			}
			BarAcc[instanceID] = value;
			if (BarAcc.Count > 256)
			{
				BarAcc.Clear();
			}
			return num;
		}

		public static void Tick()
		{
			if (Time.time < _next)
			{
				return;
			}
			_next = Time.time + 0.25f;
			Seen.Clear();
			if (Game.InLevel())
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item == (Object)null)
					{
						continue;
					}
					PhysGrabber physGrabber = item.physGrabber;
					PhysGrabObject val = (((Object)(object)physGrabber != (Object)null && Game.Get(physGrabber, "grabbed", fallback: false)) ? Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null) : null);
					ItemGun val2 = (((Object)(object)val != (Object)null) ? ((Component)val).GetComponent<ItemGun>() : null);
					if ((Object)(object)val2 == (Object)null)
					{
						continue;
					}
					bool num = ClassStats.ClassOf(item) == "gunsmith";
					float num2 = 0f;
					float num3 = (num ? Mathf.Clamp(ClassStats.Get(item, "gunsmith.recoil"), 0f, 60f) : 0f);
					float num4 = (num ? Mathf.Clamp(ClassStats.Get(item, "gunsmith.range"), 0f, 40f) : 0f);
					if (!(num2 <= 0f) || !(num3 <= 0f) || !(num4 <= 0f))
					{
						if (!Tuned.TryGetValue(val2, out Orig value))
						{
							Dictionary<ItemGun, Orig> tuned = Tuned;
							Orig obj = new Orig
							{
								Cooldown = Game.Get(val2, "shootCooldown", 0.1f),
								Recoil = Game.Get(val2, "gunRecoilForce", 1f),
								Range = Game.Get(val2, "gunRange", 10f)
							};
							value = obj;
							tuned[val2] = obj;
						}
						Put(val2, value.Cooldown / (1f + Mathf.Clamp(num2, 0f, 100f) / 100f), value.Recoil * (1f - num3 / 100f), value.Range * (1f + num4 / 100f));
						Seen.Add(val2);
					}
				}
			}
			if (Tuned.Count == 0)
			{
				return;
			}
			Gone.Clear();
			foreach (KeyValuePair<ItemGun, Orig> item2 in Tuned)
			{
				if (!Seen.Contains(item2.Key))
				{
					Gone.Add(item2.Key);
				}
			}
			foreach (ItemGun item3 in Gone)
			{
				Orig orig = Tuned[item3];
				Tuned.Remove(item3);
				if (!((Object)(object)item3 == (Object)null))
				{
					Put(item3, orig.Cooldown, orig.Recoil, orig.Range);
				}
			}
		}

		private static void Put(ItemGun gun, float cooldown, float recoil, float range)
		{
			Game.Set(gun, "shootCooldown", cooldown);
			Game.Set(gun, "gunRecoilForce", recoil);
			Game.Set(gun, "gunRange", range);
		}

		public static void Reset()
		{
			foreach (KeyValuePair<ItemGun, Orig> item in Tuned)
			{
				if ((Object)(object)item.Key != (Object)null)
				{
					Put(item.Key, item.Value.Cooldown, item.Value.Recoil, item.Value.Range);
				}
			}
			Tuned.Clear();
			BarAcc.Clear();
		}
	}
	[BepInPlugin("rpgmod.semibotrpg", "RepoRPG", "1.0.100")]
	[BepInDependency(/*Could not decode attribute arguments.*/)]
	public class Plugin : BaseUnityPlugin
	{
		public const string Guid = "rpgmod.semibotrpg";

		public const string Name = "RepoRPG";

		public const string Version = "1.0.100";

		internal static Plugin Instance;

		internal static ManualLogSource Log;

		internal static ModConfig Cfg;

		internal static ClassDatabase Db;

		internal static RpgData Rpg;

		private Harmony? _harmony;

		private void Awake()
		{
			//IL_011d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0127: Expected O, but got Unknown
			//IL_0137: Unknown result type (might be due to invalid IL or missing references)
			//IL_013c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0142: Expected O, but got Unknown
			//IL_0142: Unknown result type (might be due to invalid IL or missing references)
			//IL_014a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0151: Unknown result type (might be due to invalid IL or missing references)
			//IL_01be: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d5: Unknown result type (might be due to invalid IL or missing references)
			Instance = this;
			Log = ((BaseUnityPlugin)this).Logger;
			RenameMigration.MigrateData();
			RenameMigration.CheckOldInstall();
			MigrateOldConfig();
			MenuLibCheck.CheckInstall();
			Cfg = new ModConfig(((BaseUnityPlugin)this).Config);
			try
			{
				DifficultyPresets.Validate();
			}
			catch (Exception ex)
			{
				Log.LogWarning((object)("[difficulty] preset table check failed: " + ex.Message));
			}
			VanillaStyle.LoadSaved();
			Db = ClassDatabase.Load();
			Rpg = ClassDatabase.LoadRpgData();
			GearSets.Load();
			GearX.Load();
			Market.Load();
			Research.Load();
			ShopX.Load();
			Perks.Load();
			AttrBonus.Load();
			Synergies.Load();
			Account.Load();
			Guide.Load();
			Bosses.Load();
			RunShape.Load();
			Season.Load();
			Routes.Load();
			Heat.Load();
			RunDepth.Load();
			TeamContracts.Load();
			ContractBoard.Load();
			Log.LogInfo((object)$"Loaded {Db.Classes.Count} classes, {Rpg.attributes.Length} attributes, {Rpg.slots.Length} gear slots.");
			_harmony = new Harmony("rpgmod.semibotrpg");
			PatchAllSafely(_harmony);
			GameObject val = new GameObject("RepoRPG.Runtime");
			Object.DontDestroyOnLoad((Object)val);
			((Object)val).hideFlags = (HideFlags)61;
			val.AddComponent<RpgRuntime>();
			val.AddComponent<HostDirector>();
			val.AddComponent<ClassHost>();
			Net.Init();
			NetCodeCheck.RunSoon();
			((BaseUnityPlugin)this).Config.SettingChanged += delegate(object _, SettingChangedEventArgs e)
			{
				if (!SettingsSync.Applying && SettingsSync.IsSynced(e.ChangedSetting.Definition) && Game.IsMaster() && !SettingsSync.Overridden)
				{
					RpgRuntime.Instance?.MarkSettingsDirty();
				}
			};
			Log.LogInfo((object)string.Format("{0} {1} ready. Menu: {2}, ability: {3}.", "RepoRPG", "1.0.100", Cfg.MenuKey.Value, Cfg.AbilityKey.Value));
		}

		internal static void ReportPatchNeighbours()
		{
			Harmony harmony = Instance._harmony;
			if (harmony == null)
			{
				return;
			}
			int num = 0;
			try
			{
				foreach (MethodBase patchedMethod in harmony.GetPatchedMethods())
				{
					Patches patchInfo = Harmony.GetPatchInfo(patchedMethod);
					if (patchInfo == null)
					{
						continue;
					}
					HashSet<string> hashSet = new HashSet<string>();
					bool flag = false;
					foreach (Patch prefix in patchInfo.Prefixes)
					{
						if (prefix.owner != "rpgmod.semibotrpg")
						{
							hashSet.Add(prefix.owner);
							if (prefix.PatchMethod.ReturnType == typeof(bool))
							{
								flag = true;
							}
						}
					}
					foreach (Patch transpiler in patchInfo.Transpilers)
					{
						if (transpiler.owner != "rpgmod.semibotrpg")
						{
							hashSet.Add(transpiler.owner);
							flag = true;
						}
					}
					foreach (Patch postfix in patchInfo.Postfixes)
					{
						if (postfix.owner != "rpgmod.semibotrpg")
						{
							hashSet.Add(postfix.owner);
						}
					}
					foreach (Patch finalizer in patchInfo.Finalizers)
					{
						if (finalizer.owner != "rpgmod.semibotrpg")
						{
							hashSet.Add(finalizer.owner);
						}
					}
					if (hashSet.Count != 0)
					{
						num++;
						string text = patchedMethod.DeclaringType?.Name + "." + patchedMethod.Name;
						string text2 = string.Join(", ", hashSet);
						if (flag)
						{
							Log.LogWarning((object)(text + " is also changed by " + text2 + " in a way that can skip or rewrite it. If a RepoRPG feature tied to it stops working, that mod is the likely cause."));
						}
						else
						{
							Log.LogInfo((object)(text + " is also patched by " + text2 + " (compatible: both run)."));
						}
					}
				}
			}
			catch (Exception ex)
			{
				Log.LogDebug((object)("Patch report skipped: " + ex.Message));
			}
			if (num == 0)
			{
				Log.LogInfo((object)"No other mod patches the same game methods as RepoRPG.");
			}
		}

		private void MigrateOldConfig()
		{
			try
			{
				string text = Path.Combine(Paths.ConfigPath, "nakeem.semibotrpg.cfg");
				string configFilePath = ((BaseUnityPlugin)this).Config.ConfigFilePath;
				if (File.Exists(text) && !string.Equals(text, configFilePath, StringComparison.OrdinalIgnoreCase))
				{
					if (!File.Exists(configFilePath) || new FileInfo(configFilePath).Length <= 200)
					{
						File.Copy(text, configFilePath, overwrite: true);
						((BaseUnityPlugin)this).Config.Reload();
						Log.LogInfo((object)"[config] settings carried over from the old settings file to rpgmod.semibotrpg.cfg.");
					}
					string text2 = Path.Combine(Paths.ConfigPath, "RepoRPG");
					Directory.CreateDirectory(text2);
					string text3 = Path.Combine(text2, "old-settings.cfg.bak");
					if (File.Exists(text3))
					{
						File.Delete(text3);
					}
					File.Move(text, text3);
				}
			}
			catch (Exception ex)
			{
				Log.LogWarning((object)("[config] couldn't carry over the old settings file (" + ex.Message + "); defaults are used."));
			}
		}

		private static void PatchAllSafely(Harmony harmony)
		{
			Type[] source;
			try
			{
				source = typeof(Plugin).Assembly.GetTypes();
			}
			catch (ReflectionTypeLoadException ex)
			{
				source = ex.Types.Where((Type t) => t != null).ToArray();
			}
			IEnumerable<Type> enumerable = source.Where((Type t) => t.GetCustomAttributes(typeof(HarmonyPatch), inherit: true).Length != 0);
			List<string> list = new List<string>();
			foreach (Type item in enumerable)
			{
				try
				{
					List<MethodInfo> list2 = harmony.CreateClassProcessor(item).Patch();
					if (list2 == null || list2.Count == 0)
					{
						list.Add(item.Name);
					}
				}
				catch (Exception ex2)
				{
					Log.LogWarning((object)("Patch " + item.Name + " skipped (game may have changed): " + ex2.GetBaseException().Message));
					list.Add(item.Name);
				}
			}
			GameCheck.Run(list);
			try
			{
				BigLobby.HookScenes();
			}
			catch (Exception ex3)
			{
				Guard.DisableForSession("SpawnPointsPatch");
				Log.LogWarning((object)("[compat] couldn't watch scene loads (" + ex3.Message + "): extra spawn points are off."));
			}
		}
	}
