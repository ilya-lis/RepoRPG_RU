			{
				EndFight(_fights[0], quiet: true);
				_fights.RemoveAt(0);
			}
			Fight fight = new Fight
			{
				Attacker = attacker,
				Target = target,
				Owner = owner,
				End = time + seconds,
				HardEnd = time + seconds + 3f,
				Power = Mathf.Clamp(power, 0.2f, 3f),
				BadBlood = badBlood,
				Copied = copied,
				NextHit = time + 0.6f,
				Refundable = refundable,
				ProgressAt = time,
				NextLog = time + 2f
