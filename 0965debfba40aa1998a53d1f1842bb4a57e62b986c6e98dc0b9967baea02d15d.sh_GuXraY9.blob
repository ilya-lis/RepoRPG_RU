		public static Color RarityColor(int r)
		{
			//IL_0025: Unknown result type (might be due to invalid IL or missing references)
			//IL_002a: Unknown result type (might be due to invalid IL or missing references)
			//IL_003c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0041: Unknown result type (might be due to invalid IL or missing references)
			//IL_0053: Unknown result type (might be due to invalid IL or missing references)
			//IL_0058: Unknown result type (might be due to invalid IL or missing references)
			//IL_0070: Unknown result type (might be due to invalid IL or missing references)
			//IL_006a: Unknown result type (might be due to invalid IL or missing references)
			//IL_006f: Unknown result type (might be due to invalid IL or missing references)
			return (Color)(r switch
			{
				1 => new Color(0.35f, 0.68f, 1f), 
				2 => new Color(0.76f, 0.47f, 1f), 
				3 => new Color(1f, 0.74f, 0.22f), 
				_ => new Color(0.8f, 0.82f, 0.85f), 
			});
		}

		public static string RarityName(int r)
		{
			return RarityNames[Mathf.Clamp(r, 0, 3)];
		}

		public static Color ColorOf(PerkDef p)
		{
			//IL_0014: Unknown result type (might be due to invalid IL or missing references)
			//IL_000e: Unknown result type (might be due to invalid IL or missing references)
			if (!p.cursed)
			{
				return RarityColor(p.rarity);
			}
			return CursedColor;
		}

		public static string LabelOf(PerkDef p)
		{
			if (!p.cursed)
			{
				return RarityName(p.rarity);
			}
			return "Cursed";
		}

		public static void Load()
		{
			Tags.Clear();
			TagById.Clear();
			string text = ClassDatabase.ReadEmbedded("perks");
			PerkPack perkPack = null;
			try
			{
				perkPack = Json.Deserialize<PerkPack>(ClassDatabase.ReadWithOverride("perks", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("perks data parse error: " + ex.Message));
			}
			if (perkPack == null)
			{
				goto IL_0079;
			}
			PerkDef[] meta = perkPack.meta;
			if (meta == null || meta.Length == 0)
			{
				PerkDef[] perks = perkPack.perks;
				if (perks == null || perks.Length == 0)
				{
					goto IL_0079;
				}
			}
			goto IL_008b;
			IL_0079:
			try
			{
				perkPack = Json.Deserialize<PerkPack>(text);
			}
			catch
			{
				perkPack = new PerkPack();
			}
			goto IL_008b;
			IL_008b:
			if (perkPack == null)
			{
				return;
			}
			RpgData rpg = Plugin.Rpg;
			PerkDef[] perks2 = rpg.perks;
			for (int i = 0; i < perks2.Length; i++)
			{
				Fix(perks2[i]);
			}
			perks2 = perkPack.meta ?? Array.Empty<PerkDef>();
			foreach (PerkDef perkDef in perks2)
			{
				PerkDef perkDef2 = ((perkDef == null) ? null : rpg.Perk(perkDef.id));
				if (perkDef2 != null)
				{
					perkDef2.rarity = Mathf.Clamp(perkDef.rarity, 0, 3);
					perkDef2.tags = perkDef.tags ?? Array.Empty<string>();
					perkDef2.cursed = perkDef.cursed;
					perkDef2.evolveCounter = perkDef.evolveCounter ?? "";
					perkDef2.evolveTarget = perkDef.evolveTarget;
					perkDef2.evolveHow = perkDef.evolveHow ?? "";
					perkDef2.evolveName = perkDef.evolveName ?? "";
					perkDef2.evolveDesc = perkDef.evolveDesc ?? "";
					perkDef2.evolveEffects = perkDef.evolveEffects ?? Array.Empty<EffectDef>();
					ClassDatabase.ResolveAll("perk " + perkDef2.id, perkDef2.evolveEffects);
				}
			}
			List<PerkDef> list = new List<PerkDef>(rpg.perks);
			perks2 = perkPack.perks ?? Array.Empty<PerkDef>();
			foreach (PerkDef np in perks2)
			{
				if (np != null && !(np.id == "") && rpg.Perk(np.id) == null && !list.Exists((PerkDef x) => x.id == np.id))
				{
					Fix(np);
					ClassDatabase.ResolveAll("perk " + np.id, np.effects);
					ClassDatabase.ResolveAll("perk " + np.id, np.evolveEffects);
					list.Add(np);
				}
			}
			rpg.perks = list.ToArray();
			PerkTagDef[] array = perkPack.tags ?? Array.Empty<PerkTagDef>();
			foreach (PerkTagDef perkTagDef in array)
			{
				if (perkTagDef != null && !(perkTagDef.tag == "") && !TagById.ContainsKey(perkTagDef.tag))
				{
					PerkTagDef perkTagDef2 = perkTagDef;
					if (perkTagDef2.three == null)
					{
						perkTagDef2.three = Array.Empty<EffectDef>();
					}
					perkTagDef2 = perkTagDef;
					if (perkTagDef2.five == null)
					{
						perkTagDef2.five = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("tag " + perkTagDef.tag, perkTagDef.three);
					ClassDatabase.ResolveAll("tag " + perkTagDef.tag, perkTagDef.five);
					Tags.Add(perkTagDef);
					TagById[perkTagDef.tag] = perkTagDef;
				}
			}
		}

		private static void Fix(PerkDef p)
		{
			PerkDef perkDef = p;
			if (perkDef.effects == null)
			{
				perkDef.effects = Array.Empty<EffectDef>();
			}
			perkDef = p;
			if (perkDef.tags == null)
			{
				perkDef.tags = Array.Empty<string>();
			}
			perkDef = p;
			if (perkDef.evolveEffects == null)
			{
				perkDef.evolveEffects = Array.Empty<EffectDef>();
			}
			perkDef = p;
			if (perkDef.evolveCounter == null)
			{
				perkDef.evolveCounter = "";
			}
			perkDef = p;
			if (perkDef.evolveHow == null)
			{
				perkDef.evolveHow = "";
			}
			perkDef = p;
			if (perkDef.evolveName == null)
			{
				perkDef.evolveName = "";
			}
			perkDef = p;
			if (perkDef.evolveDesc == null)
			{
				perkDef.evolveDesc = "";
			}
			p.rarity = Mathf.Clamp(p.rarity, 0, 3);
		}

		public static PerkTagDef? Tag(string tag)
		{
			if (!TagById.TryGetValue(tag, out PerkTagDef value))
			{
				return null;
			}
			return value;
		}

		public static bool Counts(PerkDef? p)
		{
			if (p != null)
			{
				if (p.cursed)
				{
					return CursedOn;
				}
				return true;
			}
			return false;
		}

		public static bool HasTag(PerkDef p, string tag)
		{
			string[] tags = p.tags;
			for (int i = 0; i < tags.Length; i++)
			{
				if (string.Equals(tags[i], tag, StringComparison.OrdinalIgnoreCase))
				{
					return true;
				}
			}
			return false;
		}

		public static Dictionary<string, int> TagCounts(IEnumerable<string> owned)
		{
			Dictionary<string, int> dictionary = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
			foreach (string item in owned)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(item);
				if (Counts(perkDef))
				{
					string[] tags = perkDef.tags;
					foreach (string key in tags)
					{
						dictionary.TryGetValue(key, out var value);
						dictionary[key] = value + 1;
					}
				}
			}
			return dictionary;
		}

		public static int TagCount(RunSave run, string tag)
		{
			if (!TagCounts(run.perks).TryGetValue(tag, out var value))
			{
				return 0;
			}
			return value;
		}

		public static List<(PerkTagDef tag, int tier, EffectDef[] effects, string desc)> ActiveTags(IEnumerable<string> owned)
		{
			List<(PerkTagDef, int, EffectDef[], string)> list = new List<(PerkTagDef, int, EffectDef[], string)>();
			if (!TagsOn)
			{
				return list;
			}
			Dictionary<string, int> dictionary = TagCounts(owned);
			foreach (PerkTagDef tag in Tags)
			{
				dictionary.TryGetValue(tag.tag, out var value);
				if (value >= 3)
				{
					list.Add((tag, 3, tag.three, tag.threeDesc));
				}
				if (value >= 5)
				{
					list.Add((tag, 5, tag.five, tag.fiveDesc));
				}
			}
			return list;
		}

		public static bool IsEvolved(RunSave run, string id)
		{
			if (EvolveOn)
			{
				return run.evolved.Contains(id);
			}
			return false;
		}

		public static int Progress(RunSave run, string id)
		{
			foreach (NodeRank item in run.perkProgress)
			{
				if (item.id == id)
				{
					return item.rank;
				}
			}
			return 0;
		}

		public static List<PerkDef> Bump(RunSave run, string counter, int amount)
		{
			List<PerkDef> list = new List<PerkDef>();
			if (!EvolveOn || amount <= 0)
			{
				return list;
			}
			foreach (string perk in run.perks)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(perk);
				if (perkDef == null || !perkDef.Evolves || perkDef.evolveCounter != counter || run.evolved.Contains(perk))
				{
					continue;
				}
				NodeRank nodeRank = null;
				foreach (NodeRank item in run.perkProgress)
				{
					if (item.id == perk)
					{
						nodeRank = item;
						break;
					}
				}
				if (nodeRank == null)
				{
					nodeRank = new NodeRank
					{
						id = perk
					};
					run.perkProgress.Add(nodeRank);
				}
				nodeRank.rank = Mathf.Min(perkDef.evolveTarget, nodeRank.rank + amount);
				if (nodeRank.rank >= perkDef.evolveTarget)
				{
					run.evolved.Add(perk);
					list.Add(perkDef);
				}
			}
			return list;
		}

		public static bool Tracking(RunSave run, string counter)
		{
			if (!EvolveOn)
			{
				return false;
			}
			foreach (string perk in run.perks)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(perk);
				if (perkDef != null && perkDef.Evolves && perkDef.evolveCounter == counter && !run.evolved.Contains(perk))
				{
					return true;
				}
			}
			return false;
		}

		public static bool Offerable(RunSave run, PerkDef p)
		{
			if (!run.perks.Contains(p.id) && !run.banished.Contains(p.id))
			{
				if (p.cursed)
				{
					return CursedOn;
				}
				return true;
			}
			return false;
		}

		public static string? WeightedPick(List<string> pool, RunSave run, string? classId, Random rng)
		{
			if (pool.Count == 0)
			{
				return null;
			}
			Dictionary<string, int> dictionary = TagCounts(run.perks);
			ClassTags.TryGetValue(classId ?? "", out string[] value);
			double num = 0.0;
			double[] array = new double[pool.Count];
			for (int i = 0; i < pool.Count; i++)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(pool[i]);
				if (perkDef == null)
				{
					continue;
				}
				double num2 = RarityWeight[Mathf.Clamp(perkDef.rarity, 0, 3)];
				bool flag = false;
				bool flag2 = false;
				string[] tags = perkDef.tags;
				foreach (string text in tags)
				{
					if (dictionary.ContainsKey(text))
					{
						flag = true;
					}
					if (value != null && Array.IndexOf(value, text) >= 0)
					{
						flag2 = true;
					}
				}
				if (flag)
				{
					num2 *= 1.5;
				}
				if (flag2)
				{
					num2 *= 1.3;
				}
				array[i] = num2;
				num += num2;
			}
			if (num <= 0.0)
			{
				return pool[rng.Next(pool.Count)];
			}
			double num3 = rng.NextDouble() * num;
			for (int k = 0; k < pool.Count; k++)
			{
				num3 -= array[k];
				if (num3 <= 0.0)
				{
					return pool[k];
				}
			}
			return pool[pool.Count - 1];
		}

		public static int RerollBase(RunSave run)
		{
			return C.PricePerkReroll.Value + Mathf.Max(0, C.PerkRerollStep.Value) * ((run.rerollLevel == RunInfo.LevelIndex) ? run.rerollCount : 0);
		}

		public static int BanishesLeft(RunSave run)
		{
			int num = 0;
			foreach (string item in run.banished)
			{
				if (Plugin.Rpg.Perk(item) != null)
				{
					num++;
				}
			}
			return Mathf.Max(0, C.PerkBanishes.Value - num);
		}

		public static List<string> PickPreview(RunSave run, PerkDef p)
		{
			List<string> list = new List<string>();
			if (TagsOn && Counts(p))
			{
				Dictionary<string, int> dictionary = TagCounts(run.perks);
				string[] tags = p.tags;
				foreach (string text in tags)
				{
					dictionary.TryGetValue(text, out var value);
					if (value + 1 == 3 || value + 1 == 5)
					{
						list.Add($"Completes {text} x{value + 1}");
					}
					else if (value + 1 < 5)
					{
						list.Add($"{text} {value + 1}/{((value + 1 < 3) ? 3 : 5)}");
					}
				}
			}
			if (EvolveOn && p.Evolves)
			{
				list.Add("Starts a challenge: " + p.evolveHow);
			}
			return list;
		}

		public static string TagLine(PerkDef p)
		{
			if (p.tags.Length != 0)
			{
				return string.Join(" · ", p.tags);
			}
			return "";
		}
	}
	internal static class PlayerScaling
	{
		public struct Values
		{
			public int Players;

			public float Monsters;

			public float Health;

			public float Damage;

			public float Valuables;

			public float Haul;

			public float Elites;

			public float Economy;

			public float Threat;

			public bool BossExtra;

			public bool Neutral
			{
				get
				{
					if (Mathf.Abs(Monsters - 1f) < 0.005f && Mathf.Abs(Health - 1f) < 0.005f && Mathf.Abs(Damage - 1f) < 0.005f && Mathf.Abs(Valuables - 1f) < 0.005f && Mathf.Abs(Haul - 1f) < 0.005f && Mathf.Abs(Elites - 1f) < 0.005f && Mathf.Abs(Economy - 1f) < 0.005f)
					{
						return !BossExtra;
					}
					return false;
				}
			}

			public static Values One(int n)
			{
				return new Values
				{
					Players = n,
					Monsters = 1f,
					Health = 1f,
					Damage = 1f,
					Valuables = 1f,
					Haul = 1f,
					Elites = 1f,
					Economy = 1f
				};
			}
		}

		public const float WMonsters = 1f;

		public const float WHealth = 0.5f;

		public const float WDamage = 0.3f;

		public const float WValuables = 1.2f;

		public const float WHaul = 1f;

		public const float WElites = 0.5f;

		private static string _mutatorNote = "";

		private static Values _current = Values.One(1);

		private static int _levelKey = int.MinValue;

		private static bool _haveFromHost;

		private static MethodInfo? _pick;

		private static readonly Dictionary<int, int> BaseTotalAmount = new Dictionary<int, int>();

		public static bool ValuablesHooked;

		private static Values _descV;

		private static string _descS = "";

		private static bool _descHave;

		private static string _bannerText = "";

		private static float _bannerAt = -1f;

		private static ModConfig C => Plugin.Cfg;

		public static Values Current
		{
			get
			{
				if (Game.IsMaster())
				{
					EnsureHost();
				}
				return _current;
			}
		}

		public static bool Known
		{
			get
			{
				if (!Game.IsMaster())
				{
					return _haveFromHost;
				}
				return _levelKey != int.MinValue;
			}
		}

		public static float DamageTaken
		{
			get
			{
				if (!Game.InLevel())
				{
					return 1f;
				}
				return Mathf.Clamp(_current.Damage, 0.25f, 4f);
			}
		}

		public static float MonsterHealth
		{
			get
			{
				if (!Game.InLevel())
				{
					return 1f;
				}
				return Mathf.Clamp(Current.Health, 0.25f, 4f);
			}
		}

		public static float EliteChance => Mathf.Clamp(Current.Elites, 0.25f, 4f);

		public static float Economy => Mathf.Clamp(_current.Economy, 0.25f, 6f);

		public static bool BossExtraModifier => Current.BossExtra;

		public static float HaulAdjust
		{
			get
			{
				Values current = Current;
				float num = (RunShape.Has("light_load") ? 0.9f : 1f);
				return Mathf.Clamp((ValuablesHooked ? (current.Haul / Mathf.Max(0.25f, current.Valuables)) : current.Haul) * num, 0.2f, 5f);
			}
		}

		public static Values For(int players)
		{
			Values result = ForScaled(players);
			result.Monsters = Mathf.Clamp(result.Monsters * BasePct(C.MonsterCount.Value), 0.25f, 4f);
			result.Health = Mathf.Clamp(result.Health * BasePct(C.MonsterHealth.Value), 0.25f, 4f);
			result.Damage = Mathf.Clamp(result.Damage * BasePct(C.MonsterDamage.Value), 0.25f, 4f);
			result.Damage = Mathf.Clamp(result.Damage * Ascension.MonsterDamage, 0.25f, 4f);
			result.Health = Mathf.Clamp(result.Health * Ascension.MonsterHealth, 0.25f, 4f);
			result.Haul = Mathf.Clamp(result.Haul * Ascension.HaulMult, 0.25f, 4f);
			result.Monsters = Mathf.Clamp(result.Monsters * Heat.Monsters, 0.25f, 4f);
			if (RunDepth.HasMods)
			{
				result.Monsters = Mathf.Clamp(result.Monsters * RunDepth.Monsters, 0.25f, 4f);
				result.Valuables = Mathf.Clamp(result.Valuables * RunDepth.Valuables, 0.25f, 4f);
				result.Haul = Mathf.Clamp(result.Haul * RunDepth.Haul, 0.25f, 4f);
			}
			return result;
		}

		private static float BasePct(float pct)
		{
			return Mathf.Clamp(pct, 25f, 300f) / 100f;
		}

		private static Values ForScaled(int players)
		{
			Values result = ForPlayers(players);
			MutatorMode value = Plugin.Cfg.WithMutators.Value;
			string text = ((value == MutatorMode.Stack) ? "" : Compat.ActiveMutator());
			if (text != "")
			{
				if (value == MutatorMode.SkipDanger)
				{
					result.Monsters = (result.Health = (result.Damage = (result.Elites = 1f)));
					result.BossExtra = false;
				}
				string text2 = $"{RunInfo.LevelIndex}:{text}";
				if (text2 != _mutatorNote)
				{
					_mutatorNote = text2;
					Plugin.Log.LogInfo((object)("[scaling] mutator '" + text + "' this level: RepoRPG's threat" + ((value == MutatorMode.SkipDanger) ? " and player-count danger" : "") + " left out (Threat/WithMutators)."));
				}
				return result;
			}
			float num = (result.Threat = RunThreat.Rating);
			if (num > 0.001f)
			{
				result.Monsters = Mathf.Clamp(result.Monsters * RunThreat.Monsters(num), 0.25f, 4f);
				result.Health = Mathf.Clamp(result.Health * RunThreat.Health(num), 0.25f, 4f);
				result.Damage = Mathf.Clamp(result.Damage * RunThreat.Damage(num), 0.25f, 4f);
				result.Elites = Mathf.Clamp(result.Elites * RunThreat.Elites(num), 0.25f, 4f);
				float num2 = Mathf.Max(1f, Mathf.Min(RunThreat.Loot(num), Mathf.Min(4f / Mathf.Max(0.01f, result.Valuables), 4f / Mathf.Max(0.01f, result.Haul))));
				result.Valuables *= num2;
				result.Haul *= num2;
			}
			return result;
		}

		private static Values ForPlayers(int players)
		{
			int num = Mathf.Clamp(players, 1, 20);
			Values result = Values.One(num);
			if (!C.ScalingEnabled.Value)
			{
				return result;
			}
			if (num <= 4 && !C.ScaleSmallLobbies.Value)
			{
				return result;
			}
			float s = Mathf.Clamp(C.ScalingStrength.Value, 0f, 200f) / 100f;
			float k = Mathf.Sqrt((float)num / 4f) - 1f;
			result.Monsters = M(1f, C.ScaleMonsters.Value);
			result.Health = M(0.5f, C.ScaleHealth.Value);
			result.Damage = M(0.3f, C.ScaleDamage.Value);
			result.Valuables = M(1.2f, C.ScaleValuables.Value);
			result.Haul = M(1f, C.ScaleHaulGoal.Value);
			result.Elites = M(0.5f, C.ScaleElites.Value);
			if (num > 4)
			{
				float num2 = (float)num / 4f / Mathf.Max(0.25f, result.Valuables);
				result.Economy = Mathf.Clamp(1f + (num2 - 1f) * Mathf.Clamp(C.ScaleEconomy.Value, 0f, 200f) / 100f, 0.25f, 6f);
			}
			result.BossExtra = num >= 12 && s > 0f && C.ScaleElites.Value > 0f;
			return result;
			float M(float w, float pct)
			{
				return Mathf.Clamp(1f + w * s * Mathf.Clamp(pct, 0f, 200f) / 100f * k, 0.25f, 4f);
			}
		}

		public static int RoomPlayers()
		{
			try
			{
				if (PhotonNetwork.InRoom && PhotonNetwork.CurrentRoom != null)
				{
					return Mathf.Max(1, PhotonNetwork.CurrentRoom.PlayerCount);
				}
			}
			catch
			{
			}
			return Mathf.Max(1, Game.Players().Count);
		}

		private static int LevelKey()
		{
			try
			{
				LevelGenerator instance = LevelGenerator.Instance;
				return ((Object)(object)instance != (Object)null) ? ((Object)instance).GetInstanceID() : 0;
			}
			catch
			{
				return 0;
			}
		}

		private static void EnsureHost()
		{
			if (Game.InLevel())
			{
				int num = LevelKey();
				if (num != 0 && num != _levelKey)
				{
					_levelKey = num;
					RunShape.HostRouteDecide();
					_current = For(RoomPlayers());
					Plugin.Log.LogInfo((object)$"[scaling] level {RunInfo.LevelIndex + 1}: {Describe(_current, forLog: true)}");
					Net.SendScaling(_current);
				}
			}
		}

		public static void Resend()
		{
			if (Game.IsMaster() && _levelKey != int.MinValue)
			{
				Net.SendScaling(_current);
			}
		}

		public static void FromHost(Values v)
		{
			if (!Game.IsMaster())
			{
				_current = v;
				_haveFromHost = true;
			}
		}

		public static void Reset()
		{
			_current = Values.One(1);
			_levelKey = int.MinValue;
			_haveFromHost = false;
		}

		public static void AfterEnemyAmounts(object director)
		{
			if (!Game.IsMaster() || director == null || !Game.InLevel())
			{
				return;
			}
			float monsters = Current.Monsters;
			if (Mathf.Abs(monsters - 1f) < 0.01f)
			{
				return;
			}
			int num = Game.Get(director, "amountCurve1Value", 0);
			int num2 = Game.Get(director, "amountCurve2Value", 0);
			int num3 = Game.Get(director, "amountCurve3Value", 0);
			int num4 = num + num2 + num3;
			if (num4 <= 0)
			{
				return;
			}
			float num5 = (float)num4 * monsters;
			int num6 = Mathf.FloorToInt(num5);
			if (Random.value < num5 - (float)num6)
			{
				num6++;
			}
			num6 = Mathf.Max(1, num6);
			if (num6 == num4)
			{
				return;
			}
			if (num6 > num4)
			{
				if ((object)_pick == null)
				{
					_pick = AccessTools.Method(director.GetType(), "PickEnemies", (Type[])null, (Type[])null);
				}
				if (_pick == null)
				{
					Game.WarnOnce("[scaling] EnemyDirector.PickEnemies not found: monster count isn't scaled.");
					return;
				}
				object obj = Game.Get<object>(director, "enemiesDifficulty1", null);
				object obj2 = Game.Get<object>(director, "enemiesDifficulty2", null);
				object obj3 = Game.Get<object>(director, "enemiesDifficulty3", null);
				int num7 = num6 - num4;
				int num8 = 0;
				for (int i = 0; i < num7; i++)
				{
					float num9 = Random.value * (float)num4;
					int num10 = ((num9 < (float)num3) ? 3 : ((!(num9 < (float)(num3 + num2))) ? 1 : 2));
					object obj4 = num10 switch
					{
						2 => obj2, 
						3 => obj3, 
						_ => obj, 
					};
					if (obj4 != null)
					{
						try
						{
							_pick.Invoke(director, new object[1] { obj4 });
						}
						catch (Exception ex)
						{
							Game.WarnOnce("[scaling] couldn't add a monster pick: " + ex.GetBaseException().Message);
							break;
						}
						switch (num10)
						{
						case 3:
							Game.Set(director, "amountCurve3Value", Game.Get(director, "amountCurve3Value", 0) + 1);
							break;
						case 2:
							Game.Set(director, "amountCurve2Value", Game.Get(director, "amountCurve2Value", 0) + 1);
							break;
						default:
							Game.Set(director, "amountCurve1Value", Game.Get(director, "amountCurve1Value", 0) + 1);
							break;
						}
						num8++;
					}
				}
				Game.Set(director, "totalAmount", Game.Get(director, "totalAmount", num4) + num8);
				Plugin.Log.LogInfo((object)$"[scaling] monsters {num4} -> {num4 + num8} (x{monsters:0.00}).");
			}
			else
			{
				IList list = Game.Get<IList>(director, "enemyList", null);
				IList list2 = Game.Get<IList>(director, "enemyListCurrent", null);
				if (list == null || list.Count < num4)
				{
					return;
				}
				int num11 = num4 - num6;
				int num12 = 0;
				int num13 = list.Count - num4;
				int[] array = new int[3] { num3, num2, num };
				int[] array2 = new int[3];
				for (int j = 0; j < 3; j++)
				{
					array2[j] = Mathf.Min(array[j], Mathf.RoundToInt((float)array[j] * (1f - monsters)));
				}
				int num14 = array2[0] + array2[1] + array2[2];
				int num15 = 2;
				while (num14 < num11 && num15 >= 0)
				{
					int num16 = Mathf.Min(array[num15] - array2[num15], num11 - num14);
					array2[num15] += num16;
					num14 += num16;
					num15--;
				}
				int num17 = 0;
				while (num14 > num11 && num17 < 3)
				{
					int num18 = Mathf.Min(array2[num17], num14 - num11);
					array2[num17] -= num18;
					num14 -= num18;
					num17++;
				}
				int[] array3 = new int[3]
				{
					num13,
					num13 + num3,
					num13 + num3 + num2
				};
				string[] array4 = new string[3] { "amountCurve3Value", "amountCurve2Value", "amountCurve1Value" };
				for (int num19 = 2; num19 >= 0; num19--)
				{
					for (int k = 0; k < array2[num19]; k++)
					{
						int num20 = array3[num19] + array[num19] - 1 - k;
						if (num20 < num13 || num20 >= list.Count)
						{
							break;
						}
						object value = list[num20];
						list.RemoveAt(num20);
						list2?.Remove(value);
						num12++;
					}
					Game.Set(director, array4[num19], Mathf.Max(0, array[num19] - array2[num19]));
				}
				if (num12 > 0)
				{
					Game.Set(director, "totalAmount", Mathf.Max(1, Game.Get(director, "totalAmount", num4) - num12));
					Plugin.Log.LogInfo((object)$"[scaling] monsters {num4} -> {num4 - num12} (x{monsters:0.00}).");
				}
			}
			float num21 = Game.Get(director, "despawnedTimeMultiplier", 1f);
			if (num21 > 0f)
			{
				Game.Set(director, "despawnedTimeMultiplier", num21 / Mathf.Sqrt(Mathf.Clamp(monsters, 0.25f, 4f)));
			}
		}

		public static void BeforeValuables(object director)
		{
			if (!Game.IsMaster() || !Game.InLevel())
			{
				return;
			}
			Object val = (Object)((director is Object) ? director : null);
			if (val == null || val == (Object)null)
			{
				return;
			}
			int instanceID = val.GetInstanceID();
			if (!BaseTotalAmount.TryGetValue(instanceID, out var value))
			{
				if (BaseTotalAmount.Count > 16)
				{
					BaseTotalAmount.Clear();
				}
				value = Game.Get(director, "totalMaxAmount", 50);
				BaseTotalAmount[instanceID] = value;
			}
			float valuables = Current.Valuables;
			Game.Set(director, "totalMaxAmount", Mathf.Max(1, Mathf.RoundToInt((float)value * valuables)));
		}

		public static int ValuableInt(int value)
		{
			try
			{
				if (!Game.IsMaster() || !Game.InLevel())
				{
					return value;
				}
				float valuables = Current.Valuables;
				if (Mathf.Abs(valuables - 1f) < 0.01f || value <= 0)
				{
					return value;
				}
				return Mathf.Max(1, Mathf.RoundToInt((float)value * valuables));
			}
			catch
			{
				return value;
			}
		}

		public static string DescribeCurrent()
		{
			Values current = Current;
			if (!_descHave || !Same(current, _descV))
			{
				_descV = current;
				_descS = Describe(current);
				_descHave = true;
			}
			return _descS;
		}

		private static bool Same(Values a, Values b)
		{
			if (a.Players == b.Players && a.Monsters == b.Monsters && a.Health == b.Health && a.Damage == b.Damage && a.Valuables == b.Valuables && a.Haul == b.Haul && a.Elites == b.Elites && a.Economy == b.Economy && a.BossExtra == b.BossExtra)
			{
				return a.Threat == b.Threat;
			}
			return false;
		}

		public static string Describe(Values v, bool forLog = false)
		{
			string text = string.Format("{0} player{1}", v.Players, (v.Players == 1) ? "" : "s");
			if (v.Neutral)
			{
				if (!forLog)
				{
					return "";
				}
				return text + ": no scaling";
			}
			List<string> parts = new List<string>();
			P("Monsters", v.Monsters);
			P("Health", v.Health);
			P("Damage", v.Damage);
			P("Valuables", v.Valuables);
			P("Haul goal", v.Haul);
			P("Elites", v.Elites);
			P("Scrap", v.Economy);
			if (v.BossExtra)
			{
				parts.Add("Bosses +1 modifier");
			}
			return text + ": " + string.Join(", ", parts);
			void P(string name, float x)
			{
				if (Mathf.Abs(x - 1f) >= 0.005f)
				{
					parts.Add($"{name} x{x:0.0#}");
				}
			}
		}

		public static string Banner()
		{
			float unscaledTime = Time.unscaledTime;
			if (unscaledTime - _bannerAt < 0.5f)
			{
				return _bannerText;
			}
			_bannerAt = unscaledTime;
			string text = BigLobby.SizeText();
			int num = RoomPlayers();
			string text2 = Describe(For(num));
			string text3 = RunThreat.BannerText();
			bool flag = BigLobby.GameMax() > 6 || num > 4;
			string text4 = DifficultyPresets.BannerText;
			string text5 = RpgRuntime.RunShapeBanner();
			if (text5 != "")
			{
				text4 = text4 + "  ·  " + text5;
			}
			if (text2 == "" && !flag && text3 == "")
			{
				_bannerText = text4;
				return _bannerText;
			}
			string text6 = ((!(text3 != "")) ? text : ((text != "") ? (text + "  ·  " + text3) : text3));
			text6 = ((text6 != "") ? (text4 + "  ·  " + text6) : text4);
			if (text2 != "")
			{
				text6 = ((text6 != "") ? (text6 + "  ·  ") : "") + "Next level: " + text2.Substring(text2.IndexOf(':') + 1).Trim();
			}
			else if (!C.ScalingEnabled.Value && num > 4)
			{
				text6 += "  ·  Difficulty scaling off";
			}
			if (BigLobby.StandDown && text6 != "")
			{
				text6 = text6 + "  ·  lobby size by " + BigLobby.OtherModName;
			}
			_bannerText = text6;
			return _bannerText;
		}

		public static float StackShare(int rank)
		{
			if (rank <= 0)
			{
				return 1f;
			}
			if (!C.ScalingEnabled.Value || RoomPlayers() <= 4)
			{
				return 1f;
			}
			return 1f / (float)(rank + 1);
		}
	}
	public class ResearchFile
	{
		public int version;

		public int[] costs = Array.Empty<int>();

		public int[] levels = Array.Empty<int>();

		public ResearchBranchDef[] branches = Array.Empty<ResearchBranchDef>();

		public ResearchDef[] projects = Array.Empty<ResearchDef>();
	}
	public class ResearchBranchDef
	{
		public string id = "";

		public string name = "";
	}
	public class ResearchDef
	{
		public string id = "";

		public string branch = "";

		public string name = "";

		public string scope = "you";

		public string unlock = "";

		public int tier = 1;

		public string[] requires = Array.Empty<string>();

		public bool built;
	}
	[Serializable]
	public class ResearchSave
	{
		public int version = 1;

		public float data;

		public float earned;

		public List<string> done = new List<string>();

		public List<ResearchActive> active = new List<ResearchActive>();

		public List<string> unseen = new List<string>();

		public string lastRun = "";

		public int lastLevel = -1;

		public string borrowId = "";

		public string borrowRun = "";
	}
	[Serializable]
	public class ResearchActive
	{
		public string id = "";

		public int progress;

		public int need;
	}
	internal static class Research
	{
		public enum St
		{
			Locked,
			Available,
			Active,
			Done,
			InDev
		}

		public static ResearchFile File = new ResearchFile();

		private static readonly Dictionary<string, ResearchDef> ById = new Dictionary<string, ResearchDef>();

		public static HashSet<string> LobbySet = new HashSet<string>();

		private static readonly Dictionary<int, List<string>> Reported = new Dictionary<int, List<string>>();

		private static HashSet<string>? _hostSet;

		private static float _hostSetAt = -9f;

		private static string _sentLobby = "\u0001";

		private static ModConfig C => Plugin.Cfg;

		public static bool On => C.ResearchOn.Value;

		public static ResearchSave Mine
		{
			get
			{
				AccountFile data;
				AccountFile accountFile = (data = Account.Data);
				if (data.research == null)
				{
					data.research = new ResearchSave();
				}
				ResearchSave research = accountFile.research;
				if (research.done == null)
				{
					research.done = new List<string>();
				}
				research = accountFile.research;
				if (research.active == null)
				{
					research.active = new List<ResearchActive>();
				}
				research = accountFile.research;
				if (research.unseen == null)
				{
					research.unseen = new List<string>();
				}
				return accountFile.research;
			}
		}

		public static int Slots
		{
			get
			{
				if (!Done("lab_network"))
				{
					if (!Done("parallel_lab"))
					{
						return 1;
					}
					return 2;
				}
				return 3;
			}
		}

		public static IEnumerable<KeyValuePair<int, List<string>>> AllReported => Reported;

		public static void Load()
		{
			string embedded = ClassDatabase.ReadEmbedded("research");
			try
			{
				File = Json.Deserialize<ResearchFile>(ClassDatabase.ReadWithOverride("research", embedded)) ?? new ResearchFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("research data parse error: " + ex.Message));
				File = new ResearchFile();
			}
			ResearchFile file = File;
			if (file.projects == null)
			{
				file.projects = Array.Empty<ResearchDef>();
			}
			file = File;
			if (file.branches == null)
			{
				file.branches = Array.Empty<ResearchBranchDef>();
			}
			if (File.costs == null || File.costs.Length < 5)
			{
				File.costs = new int[5] { 80, 150, 250, 350, 600 };
			}
			if (File.levels == null || File.levels.Length < 5)
			{
				File.levels = new int[5] { 2, 2, 3, 4, 5 };
			}
			ById.Clear();
			ResearchDef[] projects = File.projects;
			foreach (ResearchDef researchDef in projects)
			{
				if (researchDef != null && !(researchDef.id == ""))
				{
					ResearchDef researchDef2 = researchDef;
					if (researchDef2.requires == null)
					{
						researchDef2.requires = Array.Empty<string>();
					}
					ById[researchDef.id] = researchDef;
				}
			}
		}

		public static ResearchDef? Def(string id)
		{
			if (!ById.TryGetValue(id, out ResearchDef value))
			{
				return null;
			}
			return value;
		}

		public static int Cost(ResearchDef d)
		{
			return Mathf.RoundToInt((float)File.costs[Mathf.Clamp(d.tier, 1, 5) - 1] * Mathf.Clamp(C.ResearchCostScale.Value, 10f, 500f) / 100f);
		}

		public static int Levels(ResearchDef d)
		{
			return File.levels[Mathf.Clamp(d.tier, 1, 5) - 1];
		}

		public static string BranchName(string id)
		{
			ResearchBranchDef[] branches = File.branches;
			foreach (ResearchBranchDef researchBranchDef in branches)
			{
				if (researchBranchDef.id == id)
				{
					return researchBranchDef.name;
				}
			}
			return id;
		}

		public static bool Done(string id)
		{
			return Mine.done.Contains(id);
		}

		public static bool InProgress(string id)
		{
			return Mine.active.Exists((ResearchActive a) => a.id == id);
		}

		public static bool Has(string id)
		{
			if (On)
			{
				if (!Done(id))
				{
					return ResearchCrew.Borrowed(id);
				}
				return true;
			}
			return false;
		}

		public static bool Lobby(string id)
		{
			if (On)
			{
				if (!Game.IsMaster() && Game.IsMultiplayer())
				{
					return LobbySet.Contains(id);
				}
				return HostLobbySet().Contains(id);
			}
			return false;
		}

		public static bool Unlocked(ResearchDef d, out string needs)
		{
			needs = "";
			string[] requires = d.requires;
			foreach (string text in requires)
			{
				if (text == "*")
				{
					List<string> list = new List<string>();
					ResearchDef[] projects = File.projects;
					foreach (ResearchDef researchDef in projects)
					{
						if (researchDef.branch == d.branch && researchDef.id != d.id && !Done(researchDef.id))
						{
							list.Add(researchDef.name);
						}
					}
					if (list.Count > 0)
					{
						needs = "Every other " + BranchName(d.branch) + " project";
						return false;
					}
					continue;
				}
				bool flag = false;
				List<string> list2 = new List<string>();
				string[] array = text.Split('|');
				foreach (string id in array)
				{
					ResearchDef researchDef2 = Def(id);
					if (researchDef2 != null)
					{
						list2.Add(researchDef2.name);
						if (Done(id))
						{
							flag = true;
						}
					}
				}
				if (!flag)
				{
					needs = string.Join(" or ", list2);
					return false;
				}
			}
			return true;
		}

		public static St StateOf(ResearchDef d)
		{
			if (Done(d.id))
			{
				return St.Done;
			}
			if (InProgress(d.id))
			{
				return St.Active;
			}
			if (!d.built)
			{
				return St.InDev;
			}
			if (!Unlocked(d, out string _))
			{
				return St.Locked;
			}
			return St.Available;
		}

		public static bool CanStart(ResearchDef d, out string why)
		{
			why = "";
			if (!On)
			{
				why = "Research is turned off in this lobby";
				return false;
			}
			switch (StateOf(d))
			{
			case St.Done:
				why = "Done";
				return false;
			case St.Active:
				why = "In progress";
				return false;
			case St.InDev:
				why = "Coming in a later update";
				return false;
			default:
			{
				if (!Unlocked(d, out string needs))
				{
					why = "Requires " + needs;
					return false;
				}
				if (Mine.active.Count >= Slots)
				{
					why = ((Slots == 1) ? "Lab slot in use (Parallel Lab adds a second)" : $"All {Slots} lab slots in use");
					return false;
				}
				if (Mine.data + 0.001f < (float)Cost(d))
				{
					why = $"Needs {Cost(d)} Data (you have {Mathf.FloorToInt(Mine.data)})";
					return false;
				}
				return true;
			}
			}
		}

		public static bool Start(ResearchDef d)
		{
			if (!CanStart(d, out string _))
			{
				return false;
			}
			ResearchSave mine = Mine;
			mine.data -= Cost(d);
			mine.active.Add(new ResearchActive
			{
				id = d.id,
				progress = 0,
				need = Levels(d)
			});
			Account.MarkDirty();
			Account.SaveNow();
			Plugin.Log.LogInfo((object)$"[research] started {d.name} ({Cost(d)} Data, {Levels(d)} levels). {mine.data:0} Data left.");
			SendMineToHost();
			return true;
		}

		public static void Cancel(string id)
		{
			ResearchSave mine = Mine;
			ResearchActive researchActive = mine.active.Find((ResearchActive x) => x.id == id);
			ResearchDef researchDef = Def(id);
			if (researchActive != null && researchDef != null)
			{
				mine.active.Remove(researchActive);
				mine.data += (float)Cost(researchDef) / 2f;
				Account.MarkDirty();
				Account.SaveNow();
				Plugin.Log.LogInfo((object)$"[research] cancelled {researchDef.name}: {Cost(researchDef) / 2} Data back.");
			}
		}

		public static void TickProgress()
		{
			if (!On)
			{
				return;
			}
			ResearchSave mine = Mine;
			string runId = RunInfo.RunId;
			int levelIndex = RunInfo.LevelIndex;
			if (runId == "")
			{
				return;
			}
			if (mine.lastRun != runId || levelIndex < mine.lastLevel)
			{
				mine.lastRun = runId;
				mine.lastLevel = levelIndex;
				Account.MarkDirty();
			}
			else
			{
				if (levelIndex <= mine.lastLevel)
				{
					return;
				}
				int num = Mathf.Clamp(levelIndex - mine.lastLevel, 1, 3);
				mine.lastLevel = levelIndex;
				for (int num2 = mine.active.Count - 1; num2 >= 0; num2--)
				{
					ResearchActive researchActive = mine.active[num2];
					researchActive.progress += num;
					if (researchActive.progress >= researchActive.need)
					{
						mine.active.RemoveAt(num2);
						if (!mine.done.Contains(researchActive.id))
						{
							mine.done.Add(researchActive.id);
						}
						if (!mine.unseen.Contains(researchActive.id))
						{
							mine.unseen.Add(researchActive.id);
						}
						ResearchDef researchDef = Def(researchActive.id);
						Plugin.Log.LogInfo((object)("[research] finished " + (researchDef?.name ?? researchActive.id) + "."));
						RpgRuntime.Instance?.OnResearchFinished(researchDef);
					}
				}
				Account.MarkDirty();
				Account.SaveNow();
				SendMineToHost();
			}
		}

		public static void Receive(float amount, string reason)
		{
			if (On && !(amount <= 0f))
			{
				ResearchSave mine = Mine;
				amount = Mathf.Clamp(amount, 0f, 2000f);
				mine.data += amount;
				mine.earned += amount;
				Account.MarkDirty();
				Plugin.Log.LogInfo((object)$"[research] +{amount:0} Data ({reason}); {mine.data:0} now.");
				RpgRuntime.Instance?.OnResearchData(amount, reason);
			}
		}

		public static void OnContractDone(string contractId)
		{
			if (On)
			{
				int num = 0;
				string text = contractId + RunInfo.LevelIndex;
				foreach (char c in text)
				{
					num = num * 31 + c;
				}
				if ((num & 3) == 0)
				{
					Receive(Mathf.Round((5f + (float)((num >> 4) & 7) * 1.5f) * DataMult()), "contract");
				}
			}
		}

		public static float DataMult()
		{
			return Mathf.Clamp(C.ResearchDataMult.Value, 0f, 5f) * Ascension.DataMult * (RunShape.Has("data_mine") ? 1.2f : 1f);
		}

		public static void HostGrantAll(float baseAmount, string reason)
		{
			if (!On || !Game.IsMaster())
			{
				return;
			}
			float num = Mathf.Round(baseAmount * DataMult());
			if (num <= 0f)
			{
				return;
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null)
				{
					Net.SendResearchData(item, num, reason);
				}
			}
			Plugin.Log.LogInfo((object)$"[research] {num:0} Data to each of {Game.Players().Count} player(s): {reason}.");
		}

		private static HashSet<string> HostLobbySet()
		{
			if (_hostSet != null && Time.unscaledTime - _hostSetAt < 2f)
			{
				return _hostSet;
			}
			_hostSetAt = Time.unscaledTime;
			HashSet<string> hashSet = new HashSet<string>();
			foreach (string item in Mine.done)
			{
				if (Def(item)?.scope == "lobby")
				{
					hashSet.Add(item);
				}
			}
			if (C.ResearchLobby.Value == ResearchLobbyRule.Anyone)
			{
				foreach (KeyValuePair<int, List<string>> item2 in Reported)
				{
					foreach (string item3 in item2.Value)
					{
						if (Def(item3)?.scope == "lobby")
						{
							hashSet.Add(item3);
						}
					}
				}
			}
			_hostSet = hashSet;
			return hashSet;
		}

		public static void SendMineToHost()
		{
			if (Game.IsMaster() || !Game.IsMultiplayer())
			{
				_hostSet = null;
				HostBroadcastLobby();
			}
			else
			{
				Net.SendResearchMine(string.Join(",", Mine.done));
			}
		}

		public static void HostOnReported(int actor, string csv)
		{
			List<string> list = new List<string>();
			string[] array = csv.Split(',');
			foreach (string text in array)
			{
				if (text != "" && Def(text) != null && list.Count < 64)
				{
					list.Add(text);
				}
			}
			Reported[actor] = list;
			_hostSet = null;
			HostBroadcastLobby();
		}

		public static void HostBroadcastLobby(int actor = -1)
		{
			if (!Game.IsMaster())
			{
				return;
			}
			List<string> list = new List<string>(HostLobbySet());
			list.Sort(StringComparer.Ordinal);
			string text = string.Join(",", list);
			if (actor >= 0 || !(text == _sentLobby))
			{
				if (actor < 0)
				{
					_sentLobby = text;
				}
				Net.SendResearchLobby(text, actor);
			}
		}

		public static void ApplyLobby(string csv)
		{
			HashSet<string> hashSet = new HashSet<string>();
			string[] array = csv.Split(',');
			foreach (string text in array)
			{
				if (text != "")
				{
					hashSet.Add(text);
				}
			}
			LobbySet = hashSet;
		}

		public static void OnPlayerLeft(int actor)
		{
			if (Reported.Remove(actor))
			{
				_hostSet = null;
				HostBroadcastLobby();
			}
		}
	}
	internal enum ResearchLobbyRule
	{
		Host,
		Anyone
	}
	[Serializable]
	public class CrewResearchSave
	{
		public List<string> drills = new List<string>();

		public int drillFor;

		public int drillDone;

		public List<string> drillOffer = new List<string>();

		public string sponsor = "";

		public List<string> sponsorOffer = new List<string>();

		public int sponsorBase;

		public int sponsorTarget;

		public int sponsorBest;

		public int sponsorLevels;

		public bool sponsorPaid;
	}
	internal static class ResearchCrew
	{
