		public void OnLateJoinNote(int where, float pickSeconds, int catchUpLevel, float shieldSeconds)
		{
			//IL_0077: Unknown result type (might be due to invalid IL or missing references)
			//IL_00d5: Unknown result type (might be due to invalid IL or missing references)
			//IL_012a: Unknown result type (might be due to invalid IL or missing references)
			//IL_01b4: Unknown result type (might be due to invalid IL or missing references)
			RunSave runSave = _store?.Data;
			string text = where switch
			{
				1 => "in the shop", 
				2 => "mid-level", 
				_ => "in the truck", 
			};
			if (where == 2 && Current == null && pickSeconds > 0f)
			{
				Game.LateJoinPickUntil = Time.unscaledTime + Mathf.Clamp(pickSeconds, 10f, 120f);
				Notify(PopupKind.Other, $"You joined {text}: pick a class in the next {pickSeconds:0} s ({MenuPrompt})", Accent, "chooseclass");
			}
			else if (Current == null)
			{
				Notify(PopupKind.Other, (where == 2) ? "You joined mid-level: pick a class in the next lobby or shop" : ("You joined " + text + ": choose your class (" + MenuPrompt + ")"), Accent, "chooseclass");
			}
			else
			{
				Notify(PopupKind.Other, string.Format("You joined {0} - welcome back, {1} Lv {2}", text, Current?.name ?? "your class", CurrentProgress?.level ?? 1), Accent);
			}
			if (shieldSeconds > 0f)
			{
				_ljShieldUntil = Time.time + Mathf.Clamp(shieldSeconds, 0f, 30f);
			}
			if (runSave != null && catchUpLevel > 1 && !runSave.catchUpDone && runSave.classes.Count == 0)
			{
				runSave.catchUpLevel = catchUpLevel;
				_store?.MarkDirty();
			}
			if (where == 2 && runSave != null)
			{
				Toast("Contracts: the next board is between levels", new Color(0.8f, 0.8f, 0.8f), 4f);
			}
		}

