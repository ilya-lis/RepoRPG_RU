					BoonDef boonDef = RunShape.Boon(text3);
					string name = (flag3 ? Season.OptionName(text3) : (boonDef?.name ?? text3));
					string shortLine = (flag3 ? "" : ((boonDef != null) ? (BoonRarityNames[Mathf.Clamp(boonDef.rarity, 0, 2)] + " · " + StripRich(boonDef.desc)) : ""));
					NewOpt(vCard3, name, shortLine, VoteLine(cur.VoteFor, text3), RunShape.MyVote == j, !flag, "Votes are cast in the truck or the shop.");
				}
				vCard3.Rules = (flag3 ? "Decided when everyone has voted, or when the next level starts. A tie, or nobody voting, keeps the run going (Endless)." : "One boon for the whole team, for the rest of the run. Decided when everyone has voted, or when the next level starts; a tie is settled at random.");
			}
			if (Routes.On && cur.RouteFor >= 0 && cur.RouteOptions.Length > 1 && cur.RouteChosen < 0 && !flag)
			{
				VCard vCard4 = NewCard();
				vCard4.Id = "route";
				vCard4.Kind = "Route vote";
				vCard4.Icon = "mobility";
				vCard4.Col = new Color(0.55f, 0.9f, 0.75f);
				vCard4.Anchor = "route";
				vCard4.Mine = RunShape.MyRouteVote < 0;
				vCard4.Title = $"Route for level {cur.RouteFor + 1}";
				vCard4.Deadline = "Closes when the level starts";
				vCard4.Votes = cur.RouteVotes;
				vCard4.Voters = num2;
				vCard4.By = cur.RouteBy;
				for (int k = 0; k < cur.RouteOptions.Length && k < 4; k++)
				{
					string text4 = cur.RouteOptions[k];
					string name2;
					string shortLine2;
					if (text4 == "safe")
					{
						name2 = "Safe Route";
						shortLine2 = "No risk, no extra reward";
					}
					else if (text4 == "expedition")
					{
						name2 = "Expedition";
						shortLine2 = StripRich("<b>Expedition</b>\n<color=#ff9a8a>Risk: monsters +20%, haul goal +10%</color>\n<color=#73ff66>Reward: 40% more valuables and twice the research samples</color>").Replace('\n', ' ');
					}
					else
					{
						(MapModifierDef? risk, RouteRewardDef? reward) tuple = Routes.Parse(text4);
						MapModifierDef item = tuple.risk;
						RouteRewardDef item2 = tuple.reward;
						name2 = item?.name ?? "?";
						shortLine2 = (item?.risk ?? "?") + " · Reward: " + (item2?.name ?? "?");
					}
					NewOpt(vCard4, name2, shortLine2, Routes.Text(text4), RunShape.MyRouteVote == k);
				}
				vCard4.Rules = "Decided when everyone has voted, or when the next level starts. No votes = Safe; a tie goes to the safer route.";
			}
			if (Heat.On && cur.HeatFor != 0 && cur.HeatOffer.Length > 1 && !flag)
			{
				VCard vCard5 = NewCard();
				vCard5.Id = "heat";
				vCard5.Kind = "Heat vote";
				vCard5.Icon = "monster";
				vCard5.Col = new Color(1f, 0.55f, 0.3f);
				vCard5.Anchor = "heat";
				vCard5.Mine = RunShape.MyHeatVote < 0;
				vCard5.Title = $"Heat {cur.Heat}: raise it?";
				vCard5.Deadline = "Closes when the next level starts";
				vCard5.Votes = cur.HeatVotes;
				vCard5.Voters = num2;
				vCard5.By = cur.HeatBy;
				for (int l = 0; l < cur.HeatOffer.Length && l < 6; l++)
				{
					string text5 = cur.HeatOffer[l];
					HeatCardDef heatCardDef = ((text5 == "skip") ? null : Heat.Card(text5));
					string shortLine3 = ((heatCardDef == null) ? $"Heat stays at {cur.Heat}" : $"+{heatCardDef.heat} heat · {StripRich(heatCardDef.desc)}");
					NewOpt(vCard5, Heat.Name(text5), shortLine3, Heat.Text(text5), RunShape.MyHeatVote == l);
				}
				vCard5.Rules = "A card stays all run; more heat pays more haul Scrap and luck. Decided when everyone has voted, or when the next level starts. No votes or a tie = Skip.";
			}
			if (flag || !Research.On)
			{
				return;
			}
			ResearchCrew.State cur2 = ResearchCrew.Cur;
			if (cur2.DrillFor != 0 && cur2.DrillOffer.Length != 0)
			{
				VCard vCard6 = NewCard();
				vCard6.Id = "drill";
				vCard6.Kind = "Crew drill";
				vCard6.Icon = "support";
				vCard6.Col = DrillCol;
				vCard6.Anchor = "drill";
				vCard6.Mine = ResearchCrew.MyDrillVote < 0;
				vCard6.Title = $"Crew level {cur2.DrillFor}: a crew drill";
				vCard6.Deadline = "Closes when the next level starts";
				vCard6.Votes = cur2.DrillVotes;
				vCard6.Voters = num2;
				vCard6.By = cur2.DrillBy;
				for (int m = 0; m < cur2.DrillOffer.Length && m < 4; m++)
				{
					ResearchCrew.Drill drill = ResearchCrew.DrillDef(cur2.DrillOffer[m]);
					NewOpt(vCard6, drill?.Name ?? cur2.DrillOffer[m], (drill != null) ? StripRich(drill.Desc) : "", CrewOptionText(drill: true, cur2.DrillOffer[m]), ResearchCrew.MyDrillVote == m);
				}
				vCard6.Rules = "The drill is a team rule for the rest of the run. Decided when everyone has voted, or when the next level starts; a tie or no votes is settled at random.";
			}
			if (cur2.Sponsor == "" && cur2.SponsorOffer.Length != 0)
			{
				VCard vCard7 = NewCard();
				vCard7.Id = "sponsor";
				vCard7.Kind = "Sponsor vote";
				vCard7.Icon = "loot";
				vCard7.Col = SponsorCol;
				vCard7.Anchor = "sponsor";
				vCard7.Mine = ResearchCrew.MySponsorVote < 0;
				vCard7.Title = "The run's sponsor";
				vCard7.Deadline = "Closes when the next level starts";
				vCard7.Votes = cur2.SponsorVotes;
				vCard7.Voters = num2;
				vCard7.By = cur2.SponsorBy;
				for (int n = 0; n < cur2.SponsorOffer.Length && n < 4; n++)
				{
					string id = cur2.SponsorOffer[n];
					NewOpt(vCard7, ResearchCrew.SponsorName(id), StripRich(ResearchCrew.SponsorGoal(id, ResearchCrew.TargetFor(id, num2))), CrewOptionText(drill: false, id), ResearchCrew.MySponsorVote == n);
				}
				vCard7.Rules = "The sponsor's goal runs all run and pays at the end (half at half way). Decided when everyone has voted, or when the next level starts; a tie or no votes is settled at random.";
			}
		}

		private void CastVote(VCard c, int opt)
		{
			//IL_004e: Unknown result type (might be due to invalid IL or missing references)
			if (opt < 0 || opt >= c.Opts.Count)
			{
				return;
			}
			VOpt vOpt = c.Opts[opt];
			if (!vOpt.Enabled)
			{
				if (vOpt.Why != "")
				{
					Toast(vOpt.Why, Color.gray);
				}
				MenuSound(UiSound.Error);
			}
			else
			{
				if (vOpt.Mine)
				{
					return;
				}
				RunShape.State cur = RunShape.Cur;
				string id = c.Id;
				if (id == null)
				{
					return;
				}
				switch (id.Length)
				{
				default:
					return;
				case 4:
					switch (id[0])
					{
					default:
						return;
					case 't':
						if (!(id == "team"))
						{
							return;
						}
						VoteTeam(opt == 0);
						break;
					case 'h':
						if (!(id == "heat"))
						{
							return;
						}
						Notices.ActedOn("heat");
						RunShape.MyHeatVote = opt;
						Net.SendHeatVote(cur.HeatFor, opt);
						break;
					}
					break;
				case 5:
					switch (id[0])
					{
					default:
						return;
					case 'r':
						if (!(id == "route"))
						{
							return;
						}
						Notices.ActedOn("route");
						RunShape.MyRouteVote = opt;
						Net.SendRouteVote(cur.RouteFor, opt);
						break;
					case 'd':
						if (!(id == "drill"))
						{
							return;
						}
						ResearchCrew.MyDrillVote = opt;
						Net.SendCrewVote(0, ResearchCrew.Cur.DrillFor, opt);
						break;
					}
					break;
				case 9:
				{
					if (!(id == "milestone"))
					{
						return;
					}
					List<int> list = RunShape.MyOwed();
					if (list.Count == 0)
					{
						return;
					}
					int m = list[0];
					int num = RunShape.PayoutFor(m);
					if (opt == 0)
					{
						AskConfirm("TAKE A UNIQUE?", $"A random Unique for one of your gear slots (one you don't have yet).\n\nThe {num} {Scrap.Short} payout is gone once you take it.", "Take it", delegate
						{
							TakeMilestone(m, 0);
						});
					}
					else
					{
						AskConfirm("TAKE THE PAYOUT?", $"{num} {Scrap.Short} now.\n\nThe Unique is gone once you take it.", "Take it", delegate
						{
							TakeMilestone(m, 1);
						});
					}
					return;
				}
				case 3:
					if (!(id == "run"))
					{
						return;
					}
					Notices.ActedOn("boon");
					RunShape.MyVote = opt;
					Net.SendBoonVote(cur.VoteFor, opt);
					break;
				case 7:
					if (!(id == "sponsor"))
					{
						return;
					}
					ResearchCrew.MySponsorVote = opt;
					Net.SendCrewVote(1, 0, opt);
					break;
				case 6:
				case 8:
					return;
				}
				_vSig = int.MinValue;
				MenuSound(UiSound.Confirm);
			}
		}

		private void NoteVoteResult(string text, string detail)
		{
			_voteResults.Add(new VResult
			{
				Text = text,
				Detail = detail,
				Phase = VotePhase
			});
			if (_voteResults.Count > 10)
			{
				_voteResults.RemoveAt(0);
			}
			_vSig = int.MinValue;
		}

		private void NoteRunShapeResults(RunShape.State old, RunShape.State s)
		{
			try
			{
				if (old.RouteFor >= 0 && old.RouteChosen < 0 && s.RouteFor == old.RouteFor && s.RouteChosen >= 0 && s.RouteChosen < s.RouteOptions.Length)
				{
					NoteVoteResult("Route: " + RouteShort(s.RouteOptions[s.RouteChosen]), Routes.Text(s.RouteOptions[s.RouteChosen]) + Tally(old.RouteBy, old.RouteOptions, Routes.Name));
				}
				if (old.HeatFor != 0 && s.HeatFor == 0)
				{
					string text = ((s.HeatCards.Length > old.HeatCards.Length) ? s.HeatCards[s.HeatCards.Length - 1] : "");
					NoteVoteResult((text != "") ? $"Heat: {Heat.Name(text)} (+{Heat.Card(text)?.heat ?? 1})" : "Heat: skipped", ((!(text != "")) ? $"Heat stays at {s.Heat}." : (Heat.Card(text)?.desc ?? "")) + Tally(old.HeatBy, old.HeatOffer, Heat.Name));
				}
				if (old.VoteFor == 0 || s.VoteFor == old.VoteFor)
				{
					return;
				}
				if (Season.IsSeasonVote(old.VoteFor))
				{
					NoteVoteResult(s.Complete ? "Run: end it" : "Run: keep going (Endless)", s.Complete ? "The team chose to end the run." : ("Endless: the run goes on." + Tally(old.BoonBy, old.VoteOptions, Season.OptionName)));
					return;
				}
				BoonDef boonDef = RunShape.Boon((s.Boons.Length > old.Boons.Length) ? s.Boons[s.Boons.Length - 1] : "");
				if (boonDef != null)
				{
					NoteVoteResult("Boon: " + boonDef.name, boonDef.desc + Tally(old.BoonBy, old.VoteOptions, BoonName));
				}
			}
			catch (Exception e)
			{
				UiDiag.Error(e);
			}
		}

		private void NoteCrewResults(ResearchCrew.State old, ResearchCrew.State s)
		{
			try
			{
				if (old.DrillFor != 0 && s.DrillFor == 0 && s.Drills.Length > old.Drills.Length)
				{
					string id = s.Drills[s.Drills.Length - 1];
					NoteVoteResult("Crew drill: " + ResearchCrew.DrillName(id), ResearchCrew.DrillDef(id)?.Desc + Tally(old.DrillBy, old.DrillOffer, ResearchCrew.DrillName));
				}
				if (old.Sponsor == "" && s.Sponsor != "")
				{
					NoteVoteResult("Sponsor: " + ResearchCrew.SponsorName(s.Sponsor), s.SponsorLine + Tally(old.SponsorBy, old.SponsorOffer, ResearchCrew.SponsorName));
				}
			}
			catch (Exception e)
			{
				UiDiag.Error(e);
			}
		}

		private void NoteTeamResult(int before, int state)
		{
			if (before == 0 && state != 0 && _tcDef != null)
			{
				bool flag = state == 1 || state == 2;
				NoteVoteResult("Team contract: " + _tcDef.name + " " + (flag ? "accepted" : "declined"), TeamContracts.Goal(_tcDef, _tcTarget) + "\n" + ((TeamVoters() != "") ? TeamVoters() : ""));
			}
		}

		private static string RouteShort(string o)
		{
			object obj;
			if (!(o == "safe"))
			{
				if (o == "expedition")
				{
					return "Expedition";
				}
				obj = Routes.Parse(o).risk?.name;
				if (obj == null)
				{
					return Routes.Name(o);
				}
			}
			else
			{
				obj = "Safe Route";
			}
			return (string)obj;
		}

		private static string Tally(int[] by, string[] options, Func<string, string> name)
		{
			if (by.Length < 2)
			{
				return "";
			}
			StringBuilder stringBuilder = new StringBuilder("\n\n<color=#9a9ca0>Votes:</color> ");
			bool flag = false;
			for (int i = 1; i < by.Length; i += 2)
			{
				if (by[i] >= 0)
				{
					flag = true;
					break;
				}
			}
			if (!flag)
			{
				return stringBuilder.Append($"{by.Length / 2} cast").ToString();
			}
			for (int j = 0; j < options.Length; j++)
			{
				List<string> list = new List<string>();
				for (int k = 0; k + 1 < by.Length; k += 2)
				{
					if (by[k + 1] == j)
					{
						list.Add(ClassClaims.NameOf(by[k]));
					}
				}
				if (list.Count != 0)
				{
					if (stringBuilder.Length > 40)
					{
						stringBuilder.Append(" · ");
					}
					stringBuilder.Append(string.Format("{0} {1} ({2})", name(options[j]), list.Count, string.Join(", ", list)));
				}
			}
			return stringBuilder.ToString();
		}

		private void DrawVotesTab(Rect area)
		{
			//IL_000b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0011: Invalid comparison between Unknown and I4
			//IL_0193: Unknown result type (might be due to invalid IL or missing references)
			//IL_01a9: Unknown result type (might be due to invalid IL or missing references)
			//IL_02dc: Unknown result type (might be due to invalid IL or missing references)
			//IL_0310: Unknown result type (might be due to invalid IL or missing references)
			//IL_0313: Unknown result type (might be due to invalid IL or missing references)
			//IL_0326: Unknown result type (might be due to invalid IL or missing references)
			//IL_032b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0330: Unknown result type (might be due to invalid IL or missing references)
			//IL_03b2: Unknown result type (might be due to invalid IL or missing references)
			BuildVoteCards();
			bool flag = (int)Event.current.type == 7;
			if (flag)
			{
				_vtPinSeen = false;
			}
			if (_padMode)
			{
				_vtPin = "";
			}
			if (_voteSel != "")
			{
				if (!_padMode)
				{
					_vtPin = "card:" + _voteSel;
				}
				_voteSel = "";
			}
			List<VResult> vShownResults = _vShownResults;
			vShownResults.Clear();
			int votePhase = VotePhase;
			int num = _voteResults.Count - 1;
			while (num >= 0 && vShownResults.Count < 4)
			{
				if (_voteResults[num].Phase >= votePhase - 1)
				{
					vShownResults.Add(_voteResults[num]);
				}
				num--;
			}
			float num2 = LineH(_smallLine);
			LineH(_bodyB);
			float num3 = num2 + 8f;
			float num4 = ((vShownResults.Count > 0) ? (LineH(_metaB) + 4f + (float)vShownResults.Count * (num3 + 4f)) : 0f);
			Rect r = default(Rect);
			((Rect)(ref r))..ctor(((Rect)(ref area)).x, ((Rect)(ref area)).yMax - num4, ((Rect)(ref area)).width, num4);
			Rect val = default(Rect);
			((Rect)(ref val))..ctor(((Rect)(ref area)).x, ((Rect)(ref area)).y, ((Rect)(ref area)).width, Mathf.Max(0f, ((Rect)(ref area)).height - ((num4 > 0f) ? (num4 + 16f) : 0f)));
			if (vShownResults.Count > 0)
			{
				DrawVoteResults(r, vShownResults);
			}
			if (_vCards.Count == 0)
			{
				EmptyState(val, "list", "No votes right now", "Votes appear in the shop and between levels: the route, heat and boons, crew drills and sponsors, and team contracts at the start of a level.");
				if (flag && _vtPin != "" && !_vtPinSeen)
				{
					_vtPin = "";
				}
				ShowDetail(TabDetail("No votes", "Open votes show here when they start."));
				return;
			}
			int num5 = ((!(((Rect)(ref val)).width >= 676f)) ? 1 : 2);
			float num6 = 16f;
			bool shortLines = true;
			float num7 = GridH(((Rect)(ref val)).width, num5, num6, shortLines);
			if (num7 > ((Rect)(ref val)).height)
			{
				num6 = 8f;
				num7 = GridH(((Rect)(ref val)).width, num5, num6, shortLines);
			}
			if (num7 > ((Rect)(ref val)).height)
			{
				shortLines = false;
				num7 = GridH(((Rect)(ref val)).width, num5, num6, shortLines);
			}
			if (num7 > ((Rect)(ref val)).height && num5 == 2 && GridH(((Rect)(ref val)).width, 1, num6, shortLines: false) <= ((Rect)(ref val)).height)
			{
				num5 = 1;
				num7 = GridH(((Rect)(ref val)).width, 1, num6, shortLines: false);
			}
			bool flag2 = num7 > ((Rect)(ref val)).height;
			float num8 = (flag2 ? ScrollW(val) : ((Rect)(ref val)).width);
			float num9 = (num8 - (float)(num5 - 1) * num6) / (float)num5;
			float num10 = ((Rect)(ref val)).y;
			float num11 = ((Rect)(ref val)).x;
			if (flag2)
			{
				_voteScroll = BeginScroll(41, val, _voteScroll, new Rect(0f, 0f, num8, num7));
				num10 = 0f;
				num11 = 0f;
			}
			for (int i = 0; i < _vCards.Count; i += num5)
			{
				float num12 = 0f;
				for (int j = i; j < i + num5 && j < _vCards.Count; j++)
				{
					num12 = Mathf.Max(num12, CardHeight(_vCards[j], num9, shortLines));
				}
				for (int k = i; k < i + num5 && k < _vCards.Count; k++)
				{
					DrawVoteCard(new Rect(num11 + (float)(k - i) * (num9 + num6), num10, num9, num12), k, shortLines);
				}
				num10 += num12 + num6;
			}
			if (flag2)
			{
				EndScroll();
			}
			if (flag && _vtPin != "" && !_vtPinSeen)
			{
				_vtPin = "";
			}
			ShowDetail(TabDetail("Point at a vote", "Every option in full, the rules, who voted for what - and the Vote buttons. Click a vote to keep it here."));
		}

		private float GridH(float width, int cols, float gap, bool shortLines)
		{
			float w = (width - (float)(cols - 1) * gap) / (float)cols;
			float num = 0f;
			for (int i = 0; i < _vCards.Count; i += cols)
			{
				float num2 = 0f;
				for (int j = i; j < i + cols && j < _vCards.Count; j++)
				{
					num2 = Mathf.Max(num2, CardHeight(_vCards[j], w, shortLines));
				}
				num += num2 + gap;
			}
			return num - gap;
		}

		private bool OptsInRow(VCard c, float inner)
		{
			int count = c.Opts.Count;
			if (count == 0 || count > 4)
			{
				return false;
			}
			float num = (inner - (float)(count - 1) * 4f) / (float)count;
			foreach (VOpt opt in c.Opts)
			{
				if (TextW(opt.Name, _metaB) + 16f + LineH(_smallLine) > num)
				{
					return false;
				}
			}
			return num >= 96f;
		}

		private float CardHeight(VCard c, float w, bool shortLines)
		{
			float inner = w - 16f - 3f;
			float num = LineH(_smallLine);
			float num2 = LineH(_bodyB);
			float num3 = LineH(_metaB);
			float num4 = (OptsInRow(c, inner) ? (8f + num3 + (shortLines ? num : 0f)) : ((float)c.Opts.Count * (num + 8f + 4f) - 4f));
			float num5 = Mathf.Max(num, IconSz);
			return 16f + num2 + 4f + num + 8f + num4 + 8f + num5;
		}

