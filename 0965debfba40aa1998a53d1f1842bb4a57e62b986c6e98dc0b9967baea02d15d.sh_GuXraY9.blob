		public float XpBonusMult(Stat? specific)
		{
			float num = (specific.HasValue ? _stats[specific.Value] : 0f);
			float num2 = (1f + (_stats[Stat.XpGain] + num) / 100f) * RunShape.XpMult * RunDepth.XpMult * DebtXpMult * ResearchXpMultC();
			float num3 = 1f + Mathf.Clamp(Plugin.Cfg.MaxXpBonus.Value, 0f, 500f) / 100f;
			if (num2 > num3 && _xpCapNoted != RunInfo.LevelIndex)
			{
				_xpCapNoted = RunInfo.LevelIndex;
				Plugin.Log.LogInfo((object)$"[xp] XP bonuses x{num2:0.00} capped at x{num3:0.00} (Leveling/MaxXpBonus).");
			}
			return Mathf.Max(0f, Mathf.Min(num2, num3));
		}

		private void GiveXp(int baseAmount, Stat? specific, string reason)
		{
			if (Current != null && CurrentProgress != null && baseAmount > 0)
			{
				float num = XpBonusMult(specific) * Plugin.Cfg.XpMultiplier.Value * BehindXpMult * ParasiteXpMult * Ascension.XpMult;
				int num2 = Mathf.Max(1, Mathf.RoundToInt((float)baseAmount * num));
				int num3 = Leveling.AddXp(CurrentProgress, num2);
				_store.MarkDirty();
				PerkBump("xp", num2);
				PopupXpGain(num2, reason);
				Account.OnClassXp(Current.id, num2, CurrentProgress.level);
				if (num3 > 0)
				{
					LoopTrace.Note($"level up: {Current.id} Lv {CurrentProgress.level} (+{num3}), {Leveling.AvailablePoints(CurrentProgress)} skill point(s) to spend");
					_statsDirty = true;
					int num4 = Leveling.AvailablePoints(CurrentProgress);
					int num5 = Leveling.AvailableAttributePoints(CurrentProgress, _store.Data);
					Notify(PopupKind.Level, $"Level up! {Current.name} Lv {CurrentProgress.level} – {num4} skill / {num5} attribute points ({MenuPrompt})", null, "level");
					CheckPerkMilestones();
					_store.SaveNow();
				}
			}
		}

		public void OnEnemyKilled(EnemyHealth eh)
		{
			//IL_00f0: Unknown result type (might be due to invalid IL or missing references)
			//IL_0100: Unknown result type (might be due to invalid IL or missing references)
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val == (Object)null || (Object)(object)eh == (Object)null)
			{
				return;
			}
			Elites.Info info;
			bool flag = Elites.TryGet(eh, out info);
			RewardContracts(Contracts.Progress(_store.Data.contracts, "Exterminate"));
			if (flag)
			{
				RewardContracts(Contracts.Progress(_store.Data.contracts, "EliteHunter"));
			}
			if (flag)
			{
				CEv("elite");
			}
			if (flag && info.Tier >= 3)
			{
				CEv("boss");
			}
			if (flag && info.Tier >= 3 && Game.InLevel())
			{
				PatchGuard.Run("boss reward", delegate
				{
					BossReward(eh);
				});
			}
			if (!Game.IsAlive(val))
			{
				return;
			}
			float num = Vector3.Distance(((Component)val).transform.position, ((Component)eh).transform.position);
			OnKillNear(num);
			if (num > Plugin.Cfg.KillShareRadius.Value)
			{
				return;
			}
			CEv("kill");
			int num2 = Plugin.Cfg.KillXp.Value * Game.EnemyTier(eh);
			if (flag)
			{
				num2 *= Plugin.Cfg.EliteXpMultiplier.Value + ((info.Tier >= 2) ? 1 : 0);
			}
			if (flag && info.Tier >= 3)
			{
				num2 *= 2;
			}
			GiveXp(num2, Stat.KillXp, flag ? (Elites.TierName(info.Tier) + " kill") : "kill");
			AddFrenzy();
			PerkBump("kills", 1);
			AttrOnKill();
			GearOnKill(val);
			CursesOnKill();
			if (flag)
			{
				PerkOnEliteKill();
			}
			float num3 = _stats[Stat.KillCooldownRefund];
			if (num3 > 0f && _cooldownEnd > 0f)
			{
				_cooldownEnd -= num3;
			}
			int num4 = ((!Difficulty.IronBodies) ? Mathf.RoundToInt(Mathf.Min(_stats[Stat.HealOnKill], Plugin.Cfg.MaxHealOnKill.Value)) : 0);
			if (num4 > 0 && (Object)(object)val.playerHealth != (Object)null)
			{
				Game.HealSelf(val.playerHealth, num4);
				NoteHeal(num4, HealKind.Instant, "Kill");
			}
			if (flag && info.Tier < 3)
			{
				FindGear((info.Tier < 2) ? 1 : 2, "elite drop");
				if (Random.value * 100f < RunDepth.EliteGearChance)
				{
					FindGear(1, "Elite Night");
				}
				OnEliteDiedNear();
				RollModuleDrop(Plugin.Cfg.ModuleDropChance.Value, "elite drop");
				if (Random.value * 100f < _stats[Stat.EliteExtraDrop])
				{
					FindGear(1, "bounty");
				}
			}
		}

		public void OnPlayerRevived(PlayerAvatar revived)
		{
			//IL_00c5: Unknown result type (might be due to invalid IL or missing references)
			//IL_010b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0116: Unknown result type (might be due to invalid IL or missing references)
			PlayerAvatar val = Game.LocalPlayer();
