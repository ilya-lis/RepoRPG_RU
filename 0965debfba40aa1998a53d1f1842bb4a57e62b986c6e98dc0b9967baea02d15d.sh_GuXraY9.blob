			return "<b><color=" + Hex(Accent) + ">[" + text + "]</color></b>";
		}

		private List<string> StatSheetLines()
		{
			List<string> list = new List<string>();
			foreach (Stat value in Enum.GetValues(typeof(Stat)))
			{
				float num = _stats[value];
				if (Mathf.Abs(num) < 0.001f)
				{
					continue;
				}
				List<string> list2 = new List<string>();
				float num2 = 0f;
				foreach (var (arg, num3) in StatSheet.Explain(value.ToString(), Current, CurrentProgress, _store.Data, Plugin.Rpg))
				{
					list2.Add($"{arg} {num3:+0.#;-0.#}");
					num2 += num3;
				}
				float num4 = _stats.Perm(value) - num2;
				if (Mathf.Abs(num4) > 0.001f)
				{
					list2.Add($"class bonus {num4:+0.#;-0.#}");
				}
				if (Mathf.Abs(_stats.Temp(value)) > 0.001f)
				{
					list2.Add($"active ability {_stats.Temp(value):+0.#;-0.#}");
				}
				if (Mathf.Abs(_stats.Dyn(value)) > 0.001f)
				{
					list2.Add($"right now {_stats.Dyn(value):+0.#;-0.#}");
				}
				list.Add("<b>" + StatInfo.Describe(value, num) + "</b>\n<color=#9a9ca0>   " + string.Join("  ·  ", list2) + "</color>");
			}
			if (list.Count == 0)
			{
				list.Add((Current == null) ? "Pick a class to see your stats." : "No bonuses yet: level up, spend points and equip gear.");
			}
			return list;
		}

		public void NoteHeal(int amount, HealKind kind, string source, string fromPlayer = "")
		{
			HealFeedbackLevel healLevel = HealLevel;
			if (healLevel < HealFeedbackLevel.Standard)
			{
				return;
			}
			bool flag = fromPlayer != "";
			bool flag2 = kind == HealKind.Instant && amount >= Mathf.Max(1, Plugin.Cfg.LargeHealThreshold.Value);
			if (kind == HealKind.Revive || (flag && kind != HealKind.OverTime) || flag2 || healLevel == HealFeedbackLevel.Detailed)
			{
				if (kind == HealKind.Revive)
				{
					PopupHeal(flag ? ("revive:" + fromPlayer) : "revive", amount, flag ? ("Revived by " + fromPlayer) : "Revived");
				}
				else
				{
					string label = (flag ? ("Healed by " + fromPlayer + ((healLevel == HealFeedbackLevel.Detailed && source != "") ? (" (" + source + ")") : "")) : source);
					PopupHeal(flag ? ("mate:" + fromPlayer + ":" + ((healLevel == HealFeedbackLevel.Detailed) ? source : "")) : ("self:" + source), amount, label);
				}
				if (((flag && kind != HealKind.OverTime) || kind == HealKind.Revive) && Plugin.Cfg.HealSounds.Value)
				{
					MenuSound(UiSound.Tick);
				}
			}
		}

		private void PopupHeal(string key, int amount, string label)
		{
			//IL_001f: Unknown result type (might be due to invalid IL or missing references)
			if (Plugin.Cfg.PopupsEnabled.Value)
			{
				Popup popup = Merge("heal:" + key, PopupKind.Other, HealGreen);
				popup.Amount += Mathf.Max(0, amount);
				popup.Text = ((popup.Amount > 0) ? $"+{popup.Amount} HP – {label}" : label);
			}
		}

		private void TickHealFeedback(PlayerAvatar? local)
		{
			float unscaledTime = Time.unscaledTime;
			if (unscaledTime < _healNextSample)
			{
				return;
			}
			_healNextSample = unscaledTime + 0.25f;
			PlayerHealth val = (((Object)(object)local != (Object)null) ? local.playerHealth : null);
			if ((Object)(object)val == (Object)null || !Game.IsAlive(local))
			{
				_healSampleHp = -1;
				return;
			}
			int num = Game.Health(val);
			if (_healSampleHp >= 0 && num > _healSampleHp)
			{
				if (unscaledTime - _healLastAt > 2f)
				{
					_healCount = 0;
				}
				_healCount += num - _healSampleHp;
				_healLastAt = unscaledTime;
			}
			_healSampleHp = num;
		}

