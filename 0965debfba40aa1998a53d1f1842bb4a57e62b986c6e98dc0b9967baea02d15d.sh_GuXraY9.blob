		private string TabLabel(int t)
		{
			string text = TabNames[t];
			int num = (RunReady ? (text switch
			{
				"Class" => (CurrentProgress != null) ? Mathf.Max(0, Leveling.AvailablePoints(CurrentProgress)) : 0, 
				"Attributes" => Mathf.Max(0, Leveling.AvailableAttributePoints(CurrentProgress, _store.Data)), 
				"Perks" => _store.Data.perkPicksPending, 
				_ => 0, 
			}) : 0);
			int num2 = num;
			string text2 = (((_promptDevice == NavDevice.Pad && Pad.Connected) || t >= 9) ? "" : (t + 1 + " "));
			if (TabHasPending(text))
			{
				return text2 + text + " •";
			}
			if (num2 <= 0)
