			StartScrapPerLevel = c.Bind<int>("LateJoin", "StartScrapPerLevel", 20, new ConfigDescription("A new joiner's starting Scrap: this much per level the team has cleared (at most 300). Once per player per run.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 100), Array.Empty<object>()));
