			AscXpPerLevel = c.Bind<float>("Ascension", "XpPerLevel", 4f, new ConfigDescription("Extra XP (%) per Ascension level (outside the XP bonus cap, like the difficulty).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 20f), Array.Empty<object>()));
			AscScrapPerLevel = c.Bind<float>("Ascension", "ScrapPerLevel", 5f, new ConfigDescription("Extra haul Scrap (%) per Ascension level.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 20f), Array.Empty<object>()));
			AscDataPerLevel = c.Bind<float>("Ascension", "DataPerLevel", 5f, new ConfigDescription("Extra Research Data (%) per Ascension level.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 20f), Array.Empty<object>()));
			ResearchOn = c.Bind<bool>("Research", "Enabled", true, "Research: earn Research Data in runs (samples, bosses, milestones, some contracts) and spend it on projects that unlock new mechanics for good (kept with your account, never reset by a run).");
			ResearchLobby = c.Bind<ResearchLobbyRule>("Research", "LobbyRule", ResearchLobbyRule.Host, "Lobby-wide unlocks (map features, shop sections, extraction rules...): Host = the host's research decides; Anyone = anything anyone in the lobby has researched.");
			ResearchDataMult = c.Bind<float>("Research", "DataMultiplier", 1f, new ConfigDescription("Research Data from every source (set by the difficulty: Relaxed 0.5, Easy 0.75, Normal 1, Hard 1.35, Brutal 1.75).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 5f), Array.Empty<object>()));
			ResearchCostScale = c.Bind<float>("Research", "CostScale", 100f, new ConfigDescription("Research project costs (% of normal).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(10f, 500f), Array.Empty<object>()));
			ResearchSampleChance = c.Bind<float>("Research", "SampleChance", 50f, new ConfigDescription("Chance (%) of one more research sample on a level (a third one: more likely deeper in the run and on harder difficulties). Every level has at least SamplesPerLevel.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
			ResearchSamplesMin = c.Bind<int>("Research", "SamplesPerLevel", 1, new ConfigDescription("Research samples every level has at least (1-3 per level in all).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 3), Array.Empty<object>()));
			MarketOn = c.Bind<bool>("Market", "Enabled", true, "The living economy: each valuable category's price moves with what the team extracts (and recovers), shop prices follow what's bought, a market request each level, and market events announced at the shop.");
