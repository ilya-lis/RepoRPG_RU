					{
						Net.SendNotice(from, Notice.Text, 0f, "Hand-off: they're out of sight");
						return;
					}
					try
					{
						PhysGrabber physGrabber = from.physGrabber;
						if ((Object)(object)physGrabber != (Object)null)
						{
							if ((Object)(object)from == (Object)(object)Game.LocalPlayer() || !Game.IsMultiplayer())
