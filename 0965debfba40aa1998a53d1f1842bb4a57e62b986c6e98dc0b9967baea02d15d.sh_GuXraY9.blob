		{
			get
			{
				string text = ((_tab < TabNames.Length) ? TabNames[_tab] : "");
				foreach (var (undoKind, key) in _undo)
				{
					if ((text == "Class" && undoKind == UndoKind.Talent && _talentPending.ContainsKey(key)) || (text == "Attributes" && undoKind == UndoKind.Attribute && _attrPending.ContainsKey(key)))
					{
						return true;
					}
				}
				return false;
			}
		}

