	internal static class ContractKind
	{
		public const int Personal = 0;

		public const int Class = 1;

		public const int Rival = 2;

		public const int Chain = 3;

		public static readonly string[] Names = new string[4] { "Personal", "Class", "Rival", "Chain" };

		public static string Name(int k)
		{
			if (k < 0 || k >= Names.Length)
			{
				return "Contract";
			}
			return Names[k];
		}

		public static int Parse(string s)
		{
			if (!(s == "class"))
			{
				if (!(s == "rival"))
				{
					return 0;
				}
				return 2;
			}
			return 1;
		}
	}
	internal static class ContractBoard
	{
		public static ContractFile Data = new ContractFile();

		private static readonly Dictionary<string, ContractDef> ById = new Dictionary<string, ContractDef>();

		public static readonly string[] TierNames = new string[3] { "Easy", "Hard", "Brutal" };

		public static readonly Color[] TierColors = (Color[])(object)new Color[3]
		{
			new Color(0.55f, 0.9f, 0.55f),
			new Color(1f, 0.75f, 0.3f),
			new Color(1f, 0.4f, 0.35f)
		};

		public static readonly int[] TierScrap = new int[3] { 15, 30, 50 };

		public static readonly int[] TierXp = new int[3] { 60, 110, 180 };

		public static readonly int[] TierRep = new int[3] { 1, 2, 3 };

		public const int RepHard = 3;

		public const int RepBrutal = 6;

		public const int RepExtra = 10;

		public const int RepMax = 15;

		public const float ChainChance = 0.2f;

		public static readonly string[] RepTierNames = new string[4] { "Stranger", "Known", "Trusted", "Partner" };

		public const float AuditorFine = 0.15f;

		public const string OptGear = "gear";

		public const string OptParts = "parts";

		public const string OptModule = "module";

		public const string OptRep = "rep";

		public static IEnumerable<ContractDef> All => ById.Values;

		public static int BoardSize => Mathf.Clamp(Plugin.Cfg.ContractBoardSize.Value, 3, 8) + (Account.Active("contract_board") ? 1 : 0);

		public static int Slots => Mathf.Clamp(Plugin.Cfg.ContractSlots.Value, 1, 5) + (Account.Active("contractors_license") ? 1 : 0);

		public static int HostMaxSlots => Mathf.Clamp(Plugin.Cfg.ContractSlots.Value, 1, 5) + 1;

		public static float RewardMult => Mathf.Clamp(Plugin.Cfg.ContractRewardMultiplier.Value, 0f, 4f);

		public static void Load()
		{
			ById.Clear();
			string text = ClassDatabase.ReadEmbedded("contracts");
			ContractFile contractFile = null;
			try
			{
				contractFile = Json.Deserialize<ContractFile>(ClassDatabase.ReadWithOverride("contracts", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("contracts data parse error: " + ex.Message));
			}
			if (contractFile?.contracts == null || contractFile.contracts.Length == 0)
			{
				try
				{
					contractFile = Json.Deserialize<ContractFile>(text);
				}
				catch
				{
					contractFile = new ContractFile();
				}
			}
			Data = contractFile ?? new ContractFile();
			ContractFile data = Data;
			if (data.givers == null)
			{
				data.givers = Array.Empty<ContractGiverDef>();
			}
			data = Data;
			if (data.teamGivers == null)
			{
				data.teamGivers = Array.Empty<TeamGiverDef>();
			}
			data = Data;
			if (data.chains == null)
			{
				data.chains = Array.Empty<ChainDef>();
			}
			ContractDef[] array = Data.contracts ?? Array.Empty<ContractDef>();
			foreach (ContractDef contractDef in array)
			{
				if (contractDef == null || contractDef.id == "" || ById.ContainsKey(contractDef.id))
				{
					continue;
				}
				if (contractDef.targets == null || contractDef.targets.Length < 3)
				{
					int[] array2 = new int[3];
					for (int j = 0; j < 3; j++)
					{
						array2[j] = ((contractDef.targets == null || contractDef.targets.Length == 0) ? 1 : contractDef.targets[Math.Min(j, contractDef.targets.Length - 1)]);
					}
					contractDef.targets = array2;
				}
				ById[contractDef.id] = contractDef;
			}
			Validate();
		}

		public static ContractDef? Get(string id)
		{
			if (!ById.TryGetValue(id ?? "", out ContractDef value))
			{
				return null;
			}
			return value;
		}

		public static ChainDef? Chain(string id)
		{
			ChainDef[] chains = Data.chains;
			foreach (ChainDef chainDef in chains)
			{
				if (chainDef != null && chainDef.id == id)
				{
					return chainDef;
				}
			}
			return null;
		}

		public static int GiverIndex(string id)
		{
			for (int i = 0; i < Data.givers.Length; i++)
			{
				if (Data.givers[i].id == id)
				{
					return i;
				}
			}
			return -1;
		}

		public static ContractGiverDef? Giver(string id)
		{
			int num = GiverIndex(id);
			if (num < 0)
			{
				return null;
			}
			return Data.givers[num];
		}

		public static string TeamGiver(string teamId)
		{
			TeamGiverDef[] teamGivers = Data.teamGivers;
			foreach (TeamGiverDef teamGiverDef in teamGivers)
			{
				if (teamGiverDef != null && teamGiverDef.id == teamId)
				{
					return teamGiverDef.giver;
				}
			}
			return "";
		}

		public static Color GiverColor(string id)
		{
			//IL_0028: Unknown result type (might be due to invalid IL or missing references)
			//IL_002e: Unknown result type (might be due to invalid IL or missing references)
			ContractGiverDef contractGiverDef = Giver(id);
			Color result = default(Color);
			if (contractGiverDef == null || !ColorUtility.TryParseHtmlString(contractGiverDef.color, ref result))
			{
				return new Color(0.8f, 0.8f, 0.8f);
			}
			return result;
		}

		public static string Line(string[]? lines, int salt)
		{
			if (lines == null || lines.Length == 0)
			{
				return "";
			}
			return lines[(uint)salt % (uint)lines.Length];
		}

		public static int Rep(RunSave run, string giver)
		{
			int num = GiverIndex(giver);
			if (num < 0 || run.giverRep == null || num >= run.giverRep.Length)
			{
				return 0;
			}
			return run.giverRep[num];
		}

		public static bool AddRep(RunSave run, string giver, int delta)
		{
			int num = GiverIndex(giver);
			if (num < 0)
			{
				Plugin.Log.LogWarning((object)$"[rep] reputation {delta:+0;-0} for unknown giver '{giver}' - the contract has no valid giver.");
				return false;
			}
			if (run.giverRep == null || run.giverRep.Length < Data.givers.Length)
			{
				int[] array = new int[Math.Max(4, Data.givers.Length)];
				if (run.giverRep != null)
				{
					Array.Copy(run.giverRep, array, Math.Min(run.giverRep.Length, array.Length));
				}
				run.giverRep = array;
			}
			run.giverRep[num] = Mathf.Clamp(run.giverRep[num] + delta, 0, 15);
			return true;
		}

		public static int RepTier(int rep)
		{
			if (rep < 10)
			{
				if (rep < 6)
				{
					return (rep >= 3) ? 1 : 0;
				}
				return 2;
			}
			return 3;
		}

		public static int NextTierAt(int rep)
		{
			if (rep >= 3)
			{
				if (rep >= 6)
				{
					if (rep >= 10)
					{
						return -1;
					}
					return 10;
				}
				return 6;
			}
			return 3;
		}

		public static string TierUnlock(int tier)
		{
			return tier switch
			{
				1 => "Hard contracts", 
				2 => "Brutal contracts and their chain", 
				3 => "a third reward option", 
				_ => "", 
			};
		}

		private static void Validate()
		{
			int bad = 0;
			HashSet<string> ids = new HashSet<string>();
			ContractGiverDef[] givers = Data.givers;
			foreach (ContractGiverDef contractGiverDef in givers)
			{
				if (contractGiverDef != null && contractGiverDef.id != "")
				{
					ids.Add(contractGiverDef.id);
				}
			}
			if (ids.Count == 0)
			{
				Plugin.Log.LogError((object)"[contracts] no contract givers in contracts.json: reputation can't work.");
				return;
			}
			ContractDef[] array = Data.contracts ?? Array.Empty<ContractDef>();
			foreach (ContractDef contractDef in array)
			{
				if (contractDef != null)
				{
					Check("contract", contractDef.id, contractDef.giver);
				}
			}
			ChainDef[] chains = Data.chains;
			foreach (ChainDef chainDef in chains)
			{
				if (chainDef != null)
				{
					Check("chain", chainDef.id, chainDef.giver);
				}
			}
			TeamGiverDef[] teamGivers = Data.teamGivers;
			foreach (TeamGiverDef teamGiverDef in teamGivers)
			{
				if (teamGiverDef != null)
				{
					Check("team contract", teamGiverDef.id, teamGiverDef.giver);
				}
			}
			int[] tierRep = TierRep;
			for (int i = 0; i < tierRep.Length; i++)
			{
				if (tierRep[i] <= 0)
				{
					bad++;
					Plugin.Log.LogWarning((object)"[contracts] a contract tier gives no reputation.");
				}
			}
			Plugin.Log.LogInfo((object)((bad == 0) ? $"[contracts] data OK: {ById.Count} contracts, {Data.chains.Length} chains, {Data.teamGivers.Length} team contracts, {ids.Count} givers with reputation tiers {3}/{6}/{10} (max {15})." : $"[contracts] {bad} problem(s) in the contract data (see above)."));
			void Check(string what, string id, string giver)
			{
				if (!ids.Contains(giver ?? ""))
				{
					bad++;
					Plugin.Log.LogWarning((object)("[contracts] " + what + " '" + id + "' has giver '" + giver + "', which isn't one of " + string.Join(", ", ids) + ": it gives no reputation."));
				}
			}
		}

		public static int MaxTier(int rep)
		{
			if (rep < 6)
			{
				return (rep >= 3) ? 1 : 0;
			}
			return 2;
		}

		public static int RerollPrice(int done)
		{
			if (RunShape.Has("free_estimate"))
			{
				if (done <= 0)
				{
					return 0;
				}
				done--;
			}
			return Mathf.Max(0, Plugin.Cfg.ContractRerollScrap.Value) + Mathf.Max(0, Plugin.Cfg.ContractRerollStep.Value) * Mathf.Max(0, done);
		}

		private static int Target(int t)
		{
			return Mathf.Max(1, Mathf.CeilToInt((float)(RunShape.Has("easy_money") ? Mathf.CeilToInt((float)t * 0.8f) : t) * Ascension.ContractTargetMult));
		}

		public static int ScrapFor(int kind, int tier, bool bonus)
		{
			int num = ((kind == 2 || kind == 3) ? 1 : Mathf.Clamp(tier, 0, 2));
			float num2 = (float)TierScrap[num] * (bonus ? 1.5f : 1f) * RewardMult * RunThreat.RewardMult(RunThreat.Fixed) * RunShape.ContractScrapMult * RunDepth.ContractMult;
			return Mathf.Max(0, Mathf.RoundToInt(num2));
		}

		public static int XpFor(int kind, int tier, int level)
		{
			int num = ((kind == 2 || kind == 3) ? 1 : Mathf.Clamp(tier, 0, 2));
			return Mathf.RoundToInt((float)TierXp[num] * (1f + (float)Mathf.Max(0, level) * 0.04f));
		}

		public static string NewUid()
		{
			return Guid.NewGuid().ToString("N").Substring(0, 10);
		}

		public static ContractState Make(ContractDef d, int tier, bool withBonus, int level)
		{
			tier = Mathf.Clamp(tier, 0, 2);
			int num = ContractKind.Parse(d.kind);
			if (num == 2)
			{
				tier = 1;
				withBonus = false;
			}
			return new ContractState
			{
				type = "Board",
				uid = NewUid(),
				id = d.id,
				giver = d.giver,
				obj = d.obj,
				cls = d.cls,
				kind = num,
				tier = tier,
				target = Target(d.targets[tier]),
				level = level,
				rewardGearFloor = -1,
				bonus = (withBonus ? d.bonus : ""),
				bonusArg = d.bonusArg,
				rewardScrap = Mathf.RoundToInt((float)ScrapFor(num, tier, bonus: false) * Mathf.Clamp(d.rewardMult, 0.1f, 5f)),
				rewardXp = Mathf.RoundToInt((float)XpFor(num, tier, level) * Mathf.Clamp(d.rewardMult, 0.1f, 5f))
			};
		}

		public static ContractState? MakeChainStep(string chainId, int step, int level)
		{
			ChainDef chainDef = Chain(chainId);
			if (chainDef == null || step < 0 || step >= chainDef.steps.Length)
			{
				return null;
			}
			ChainStepDef chainStepDef = chainDef.steps[step];
			ContractState obj = new ContractState
			{
				type = "Board",
				uid = NewUid(),
				id = chainDef.id + "#" + step,
				giver = chainDef.giver,
				obj = chainStepDef.obj,
				kind = 3,
				tier = 1,
				target = Target(chainStepDef.target),
				level = level,
				chain = chainDef.id,
				chainStep = step,
				rewardGearFloor = -1
			};
			obj.rewardScrap = ScrapFor(obj.kind, 1, bonus: false);
			obj.rewardXp = XpFor(obj.kind, 1, level);
			return obj;
		}

		public static List<ContractState> Generate(Random rng, RunSave run, string classId, int level, int players)
		{
			List<ContractState> list = new List<ContractState>();
			int boardSize = BoardSize;
			bool flag = players >= 2;
			if (run.chain != "")
			{
				ContractState contractState = MakeChainStep(run.chain, run.chainStep, level);
				if (contractState != null)
				{
					list.Add(contractState);
				}
			}
			else
			{
				List<ChainDef> list2 = new List<ChainDef>();
				ChainDef[] chains = Data.chains;
				foreach (ChainDef chainDef in chains)
				{
					if (chainDef != null && chainDef.steps.Length != 0 && Rep(run, chainDef.giver) >= 6 && !run.chainsDone.Contains(chainDef.id))
					{
						list2.Add(chainDef);
					}
				}
				if (list2.Count > 0 && rng.NextDouble() < 0.20000000298023224)
				{
					ContractState contractState2 = MakeChainStep(list2[rng.Next(list2.Count)].id, 0, level);
					if (contractState2 != null)
					{
						list.Add(contractState2);
					}
				}
			}
			if (classId != "")
			{
				foreach (ContractDef value in ById.Values)
				{
					if (value.kind == "class" && value.cls == classId && (flag || !value.mp))
					{
						list.Add(Roll(rng, value, run, level));
						break;
					}
				}
			}
			if (flag && Plugin.Cfg.RivalContracts.Value && list.Count < boardSize && rng.NextDouble() < 0.5)
			{
				List<ContractDef> list3 = new List<ContractDef>();
				foreach (ContractDef value2 in ById.Values)
				{
					if (value2.kind == "rival")
					{
						list3.Add(value2);
					}
				}
				if (list3.Count > 0)
				{
					list.Add(Roll(rng, list3[rng.Next(list3.Count)], run, level));
				}
			}
			List<ContractDef> list4 = new List<ContractDef>();
			foreach (ContractDef value3 in ById.Values)
			{
				if (value3.kind == "personal" && (flag || !value3.mp) && (value3.unlock == "" || RunDepth.Unlocked(value3.unlock)) && (value3.research == "" || Research.Lobby(value3.research)))
				{
					list4.Add(value3);
				}
			}
			list4.Sort((ContractDef a, ContractDef b) => string.CompareOrdinal(a.id, b.id));
			while (list.Count < boardSize && list4.Count > 0)
			{
				int index = rng.Next(list4.Count);
				ContractDef pick = list4[index];
				list.Add(Roll(rng, pick, run, level));
				list4.RemoveAt(index);
				if (pick.unlock != "")
				{
					list4.RemoveAll((ContractDef x) => x.giver == pick.giver && x.unlock != "");
				}
				if (pick.research != "")
				{
					list4.RemoveAll((ContractDef x) => x.giver == pick.giver && x.research != "");
				}
			}
			return list;
		}

		public static ContractState Roll(Random rng, ContractDef d, RunSave run, int level)
		{
			int num = MaxTier(Rep(run, d.giver));
			double num2 = rng.NextDouble();
			return Make(d, num switch
			{
				1 => (!(num2 < 0.6)) ? 1 : 0, 
				0 => 0, 
				_ => (!(num2 < 0.4)) ? ((num2 < 0.8) ? 1 : 2) : 0, 
			}, d.bonus != "" && rng.NextDouble() < 0.5, level);
		}

		public static string Name(ContractState c)
		{
			if (c.kind == 3)
			{
				ChainDef chainDef = Chain(c.chain);
				if (chainDef == null)
				{
					return c.id;
				}
				return $"{chainDef.name} ({c.chainStep + 1}/{chainDef.steps.Length})";
			}
			ContractDef contractDef = Get(c.id);
			if (contractDef == null)
			{
				if (!(c.type != "") || !(c.type != "Board"))
				{
					return c.id;
				}
				return Contracts.Title(c);
			}
			return contractDef.name;
		}

		private static bool IsMoney(string obj)
		{
			switch (obj)
			{
			default:
				return obj == "cls.restorer";
			case "value":
			case "strictvalue":
			case "cls.appraiser":
				return true;
			}
		}

		public static string Objective(ContractState c)
		{
			if (c.type != "Board")
			{
				return Contracts.Title(c);
			}
			string text;
			if (c.kind == 3)
			{
				ChainDef chainDef = Chain(c.chain);
				text = ((chainDef != null && c.chainStep < chainDef.steps.Length) ? chainDef.steps[c.chainStep].desc : c.obj);
			}
			else
			{
				text = Get(c.id)?.desc ?? c.obj;
			}
			string newValue = (IsMoney(c.obj) ? c.target.ToString("N0") : c.target.ToString());
			return text.Replace("{t}", newValue).Replace("{s}", (c.target == 1) ? "" : "s");
		}

		public static string BonusText(ContractState c)
		{
			if (c.bonus == "")
			{
				return "";
			}
			ContractDef contractDef = Get(c.id);
			if (contractDef == null || !(contractDef.bonusDesc != ""))
			{
				return c.bonus;
			}
			return contractDef.bonusDesc;
		}

		public static string ChainLine(ContractState c)
		{
			ChainDef chainDef = Chain(c.chain);
			if (chainDef == null || c.chainStep >= chainDef.steps.Length)
			{
				return "";
			}
			return chainDef.steps[c.chainStep].line;
		}

		public static string RewardText(ContractState c)
		{
			string text = $"{c.rewardScrap} {Scrap.Short} + {c.rewardXp} XP";
			if (c.bonus != "")
			{
				text += $"  (bonus: +{Mathf.RoundToInt((float)c.rewardScrap * 0.5f)} {Scrap.Short})";
			}
			if (c.giver == "archivist")
			{
				text += ResearchCrew.ArchivistRewardText(c.tier);
			}
			if (c.kind == 2)
			{
				return $"Winner: {c.rewardScrap} {Scrap.Short} + {c.rewardXp} XP + a reward pick";
			}
			if (c.kind == 3)
			{
				ChainDef chainDef = Chain(c.chain);
				if (chainDef == null || c.chainStep != chainDef.steps.Length - 1 || chainDef == null)
				{
					return text;
				}
				return text + " + " + chainDef.rewardDesc;
			}
			return text + " + a reward pick";
		}

		public static List<string> RewardOptions(ContractState c, int giverRep)
		{
			int num = ((c.kind == 2) ? 1 : Mathf.Clamp(c.tier, 0, 2));
			List<string> list = new List<string> { "gear", "rep" };
			if (Plugin.Cfg.CraftingParts.Value)
			{
				list.Add("parts");
			}
			if (num >= 1)
			{
				list.Add("module");
			}
			Random random = new Random(RunInfo.StableHash(c.uid));
			int num2 = Mathf.Min(list.Count, (giverRep >= 10) ? 3 : 2);
			List<string> list2 = new List<string>();
			while (list2.Count < num2)
			{
				int index = random.Next(list.Count);
				list2.Add(list[index]);
				list.RemoveAt(index);
			}
			return list2;
		}

		public static int[] PartsFor(int tier)
		{
			if (tier < 2)
			{
				if (tier == 1)
				{
					return new int[4] { 0, 2, 0, 0 };
				}
				return new int[4] { 3, 0, 0, 0 };
			}
			return new int[4] { 0, 0, 1, 0 };
		}

		public static int RepFor(int tier)
		{
			if (tier < 2)
			{
				if (tier != 1)
				{
					return 15;
				}
				return 30;
			}
			return 60;
		}

		public static string OptionText(string opt, int tier)
		{
			tier = Mathf.Clamp(tier, 0, 2);
			switch (opt)
			{
			case "gear":
				return "Gear: " + Gear.Rarity(Mathf.Min(Gear.MaxRarity, tier + 1)).name + " or better";
			case "parts":
				return "Crafting parts: " + Crafting.Describe(PartsFor(tier));
			case "module":
				if (tier < 2)
				{
					return "A random module";
				}
				return "A module of your choice";
			case "rep":
				return $"+{RepFor(tier)} shop reputation";
			default:
				return opt;
			}
		}
	}
	internal static class ContractHost
	{
		private sealed class Rec
		{
			public string Uid = "";

			public string Id = "";

			public string Obj = "";

			public string Chain = "";

			public int Kind;

			public int Tier;

			public int Level;

			public int Target;

			public bool Claimed;
		}

		private static readonly Dictionary<int, List<Rec>> Recs = new Dictionary<int, List<Rec>>();

		private static readonly Dictionary<int, Dictionary<string, float>> Tally = new Dictionary<int, Dictionary<string, float>>();

		private static readonly Dictionary<int, (int level, int n)> Rerolls = new Dictionary<int, (int, int)>();

		private static readonly Dictionary<int, int> Lenient = new Dictionary<int, int>();

		private static readonly HashSet<string> Paid = new HashSet<string>();

		private static bool _rivalsJudged;

		private static int _boardSeenLevel = -1;

		private static string _runKey = "";

		private static readonly HashSet<string> HostCounted = new HashSet<string> { "value", "strictvalue", "carry", "cleancarry", "rarecarry", "bigclean", "cls.hauler" };

		public static bool BoardOpen => Game.ClassSelectionOpenForLobby();

		private static void CheckRun()
		{
			string key = RunInfo.Key;
			Room currentRoom = PhotonNetwork.CurrentRoom;
			string text = key + "@" + ((currentRoom != null) ? currentRoom.Name : null);
			if (!(text == _runKey))
			{
				_runKey = text;
				Recs.Clear();
				Tally.Clear();
				Rerolls.Clear();
				Lenient.Clear();
				Paid.Clear();
				_boardSeenLevel = -1;
				_rivalsJudged = false;
			}
		}

		public static void HostNoteBoard()
		{
			CheckRun();
			_boardSeenLevel = RunInfo.LevelIndex;
		}

		public static void NewLevel()
		{
			CheckRun();
			Tally.Clear();
			Lenient.Clear();
			_rivalsJudged = false;
			int now = RunInfo.LevelIndex;
			foreach (List<Rec> value in Recs.Values)
			{
				value.RemoveAll((Rec r) => r.Level < now);
			}
		}

		public static void PlayerLeft(int actor)
		{
			Tally.Remove(actor);
		}

		private static List<Rec> RecsOf(int actor)
		{
			if (!Recs.TryGetValue(actor, out List<Rec> value))
			{
				value = (Recs[actor] = new List<Rec>());
			}
			return value;
		}

		private static float Get(int actor, string key)
		{
			if (!Tally.TryGetValue(actor, out Dictionary<string, float> value) || !value.TryGetValue(key, out var value2))
			{
				return 0f;
			}
			return value2;
		}

		private static void Add(int actor, string key, float v)
		{
			if (!Tally.TryGetValue(actor, out Dictionary<string, float> value))
			{
				value = (Tally[actor] = new Dictionary<string, float>());
			}
			value.TryGetValue(key, out var value2);
			value[key] = value2 + v;
		}

		public static PlayerAvatar? PlayerOf(int actor)
		{
			if (!Game.IsMultiplayer() || actor == ClassClaims.LocalActor)
			{
				return Game.LocalPlayer();
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					return item;
				}
			}
			return null;
		}

		public static void Ev(int actor, string key, float amount = 1f)
		{
			if (Game.IsMaster() && (actor >= 0 || !Game.IsMultiplayer()) && !(amount <= 0f) && Game.InLevel())
			{
				Net.SendContractEvent(actor, key, amount);
			}
		}

		public static void Ev(PlayerAvatar? p, string key, float amount = 1f)
		{
			if ((Object)(object)p != (Object)null)
			{
				Ev(Game.ActorNumber(p), key, amount);
			}
		}

		public static void ClsEv(int actor, string cls, float amount = 1f)
		{
			if (Game.IsMaster() && Game.InLevel() && !(ClassClaims.ClassOf(actor) != cls))
			{
				Ev(actor, "cls." + cls, amount);
			}
		}

		public static void ClsEv(PlayerAvatar? p, string cls, float amount = 1f)
		{
			if ((Object)(object)p != (Object)null)
			{
				ClsEv(Game.ActorNumber(p), cls, amount);
			}
		}

		public static void HostCarried(int actor, float value, ValuableObject? v)
		{
			if (!Game.IsMaster() || value <= 0f)
			{
				return;
			}
			float num = (((Object)(object)v != (Object)null) ? Game.Get(v, "dollarValueOriginal", value) : value);
			bool flag = value >= num * 0.99f;
			int num2 = 0;
			if ((Object)(object)v != (Object)null)
			{
				PhotonView val = ((Component)v).GetComponent<PhotonView>() ?? ((Component)v).GetComponentInParent<PhotonView>();
				if ((Object)(object)val != (Object)null)
				{
					num2 = Gear.ValuableRarity(val.ViewID);
				}
			}
			Add(actor, "value", value);
			Add(actor, "carry", 1f);
			if (flag)
			{
				Add(actor, "cleancarry", 1f);
			}
			if (num2 >= 2)
			{
				Add(actor, "rarecarry", 1f);
			}
			if (flag && value >= 10000f)
			{
				Add(actor, "bigclean", 1f);
			}
			if (value >= 3000f)
			{
				Add(actor, "cls.hauler", 1f);
			}
			Net.SendContractEvent(actor, "valuable", value, flag ? 1 : 0, num2);
		}

		public static void HostBroke(int actor)
		{
			if (Game.IsMaster() && Game.InLevel())
			{
				Add(actor, "broke", 1f);
				Net.SendContractEvent(actor, "broke", 1f);
			}
		}

		public static string HostAccept(int actor, string uid, string id, int tier, int level, int slots)
		{
			CheckRun();
			if (!BoardOpen)
			{
				return "closed";
			}
			_boardSeenLevel = RunInfo.LevelIndex;
			if (level != RunInfo.LevelIndex)
			{
				return "stale";
			}
			if (uid.Length == 0 || uid.Length > 16)
			{
				return "bad";
			}
			List<Rec> list = RecsOf(actor);
			int num = 0;
			foreach (Rec item in list)
			{
				if (item.Uid == uid)
				{
					return "";
				}
				if (item.Level == level)
				{
					num++;
				}
			}
			int num2 = Mathf.Clamp(slots, 1, ContractBoard.HostMaxSlots);
			if (num >= num2)
			{
				return "full";
			}
			Rec rec = new Rec
			{
				Uid = uid,
				Id = id,
				Level = level,
				Tier = Mathf.Clamp(tier, 0, 2)
			};
			int num3 = id.IndexOf('#');
			if (num3 > 0)
			{
				ChainDef chainDef = ContractBoard.Chain(id.Substring(0, num3));
				if (chainDef == null || !int.TryParse(id.Substring(num3 + 1), out var result) || result < 0 || result >= chainDef.steps.Length)
				{
					return "bad";
				}
				rec.Kind = 3;
				rec.Tier = 1;
				rec.Chain = chainDef.id;
				rec.Obj = chainDef.steps[result].obj;
				rec.Target = chainDef.steps[result].target;
			}
			else
			{
				ContractDef contractDef = ContractBoard.Get(id);
				if (contractDef == null)
				{
					return "bad";
				}
				rec.Kind = ContractKind.Parse(contractDef.kind);
				rec.Obj = contractDef.obj;
				rec.Target = contractDef.targets[rec.Tier];
				if (rec.Kind == 2)
				{
					if (!Plugin.Cfg.RivalContracts.Value)
					{
						return "rivals off";
					}
					if (Game.Players().Count < 2)
					{
						return "solo";
					}
					rec.Tier = 1;
				}
				foreach (Rec item2 in list)
				{
					if (item2.Level == level && item2.Id == id)
					{
						return "dup";
					}
				}
			}
			list.Add(rec);
			return "";
		}

		public static void HostDrop(int actor, string uid)
		{
			if (BoardOpen)
			{
				RecsOf(actor).RemoveAll((Rec r) => r.Uid == uid && !r.Claimed);
			}
		}

		public static int HostRerollPrice(int actor)
		{
			(int, int) value;
			return ContractBoard.RerollPrice((Rerolls.TryGetValue(actor, out value) && value.Item1 == RunInfo.LevelIndex) ? value.Item2 : 0);
		}

		public static (bool ok, int charged, string reason) HostReroll(int actor, string steamId)
		{
			CheckRun();
			if (!BoardOpen)
			{
				return (ok: false, charged: 0, reason: "closed");
			}
			if (steamId == "")
			{
				return (ok: false, charged: 0, reason: "not verified");
			}
			int num = HostRerollPrice(actor);
			if (num > 0 && !Scrap.HostTrySpend(steamId, actor, num))
			{
				return (ok: false, charged: num, reason: "not enough");
			}
			(int, int) value;
			int num2 = ((Rerolls.TryGetValue(actor, out value) && value.Item1 == RunInfo.LevelIndex) ? value.Item2 : 0);
			Rerolls[actor] = (RunInfo.LevelIndex, num2 + 1);
			return (ok: true, charged: num, reason: "");
		}

		public static (bool ok, int scrap, string reason) HostClaim(int actor, string uid, bool bonus, int clientTier, int clientKind)
		{
			CheckRun();
			if (!Game.InLevel())
			{
				return (ok: false, scrap: 0, reason: "not in a level");
			}
			string item = RunInfo.Key + "#" + RunInfo.LevelIndex + "#" + actor + "#" + uid;
			if (Paid.Contains(item))
			{
				return (ok: false, scrap: 0, reason: "paid");
			}
			Rec rec = null;
			foreach (Rec item2 in RecsOf(actor))
			{
				if (item2.Uid == uid)
				{
					rec = item2;
					break;
				}
			}
			int num;
			int tier;
			if (rec == null)
			{
				if (_boardSeenLevel == RunInfo.LevelIndex)
				{
					return (ok: false, scrap: 0, reason: "not accepted");
				}
				foreach (Rec item3 in RecsOf(actor))
				{
					if (item3.Level == RunInfo.LevelIndex)
					{
						return (ok: false, scrap: 0, reason: "not accepted");
					}
				}
				Lenient.TryGetValue(actor, out var value);
				if (value >= ContractBoard.HostMaxSlots)
				{
					return (ok: false, scrap: 0, reason: "not accepted");
				}
				Lenient[actor] = value + 1;
				num = Mathf.Clamp(clientKind, 0, 3);
				tier = Mathf.Clamp(clientTier, 0, 2);
				if (num == 2)
				{
					return (ok: false, scrap: 0, reason: "rival");
				}
			}
			else
			{
				if (rec.Claimed)
				{
					return (ok: false, scrap: 0, reason: "paid");
				}
				if (rec.Level != RunInfo.LevelIndex)
				{
					return (ok: false, scrap: 0, reason: "stale");
				}
				if (rec.Kind == 2)
				{
					return (ok: false, scrap: 0, reason: "rival");
				}
				if (HostCounted.Contains(rec.Obj) && Get(actor, (rec.Obj == "strictvalue") ? "value" : rec.Obj) < (float)rec.Target * 0.95f)
				{
					return (ok: false, scrap: 0, reason: "not reached");
				}
				if (rec.Obj == "strictvalue" && Get(actor, "broke") > 0f)
				{
					return (ok: false, scrap: 0, reason: "not reached");
				}
				rec.Claimed = true;
				num = rec.Kind;
				tier = rec.Tier;
			}
			Paid.Add(item);
			if (Paid.Count > 2000)
			{
				Paid.Clear();
			}
			int num2 = ContractBoard.ScrapFor(num, tier, bonus);
			PlayerAvatar val = PlayerOf(actor);
			if (num2 > 0 && (Object)(object)val != (Object)null)
			{
				Scrap.HostGrant(val, num2, "Contract");
			}
			if ((Object)(object)val != (Object)null && rec != null)
			{
				ResearchCrew.HostContractPaid(val, rec.Id, tier);
			}
			return (ok: true, scrap: num2, reason: "");
		}

		public static void HostLevelDone()
		{
			if (!Game.IsMaster() || _rivalsJudged)
			{
				return;
			}
			_rivalsJudged = true;
			foreach (PlayerAvatar item2 in Game.Players())
			{
				if ((Object)(object)item2 != (Object)null)
				{
					Net.SendContractEvent(Game.ActorNumber(item2), "leveldone", 1f);
				}
			}
			Dictionary<string, List<int>> dictionary = new Dictionary<string, List<int>>();
			foreach (KeyValuePair<int, List<Rec>> rec in Recs)
			{
				if ((Object)(object)PlayerOf(rec.Key) == (Object)null)
				{
					continue;
				}
				foreach (Rec item3 in rec.Value)
				{
					if (item3.Kind == 2 && item3.Level == RunInfo.LevelIndex)
					{
						if (!dictionary.TryGetValue(item3.Id, out var value))
						{
							value = (dictionary[item3.Id] = new List<int>());
						}
						if (!value.Contains(rec.Key))
						{
							value.Add(rec.Key);
						}
					}
				}
			}
			foreach (KeyValuePair<string, List<int>> item4 in dictionary)
			{
				ContractDef contractDef = ContractBoard.Get(item4.Key);
				if (contractDef == null)
				{
					continue;
				}
				List<int> value2 = item4.Value;
				if (value2.Count < 2)
				{
					foreach (int item5 in value2)
					{
						Net.SendRivalResult(item5, item4.Key, 0, 0, "No rivals took it - void");
					}
					continue;
				}
				List<(int, float)> list2 = new List<(int, float)>();
				foreach (int item6 in value2)
				{
					list2.Add((item6, RivalScore(contractDef.obj, item6)));
				}
				list2.Sort(((int actor, float score) x, (int actor, float score) y) => y.score.CompareTo(x.score));
				int num = ((value2.Count < 5) ? 1 : 2);
				float item = list2[Mathf.Min(num, list2.Count) - 1].Item2;
				List<int> list3 = new List<int>();
				foreach (var item7 in list2)
				{
					if (item7.Item2 >= item && item7.Item2 > 0f)
					{
						list3.Add(item7.Item1);
					}
				}
				int num2 = ContractBoard.ScrapFor(2, 1, bonus: false) * num;
				int num3 = ((list3.Count > 0) ? Mathf.Max(1, num2 / list3.Count) : 0);
				string standing = Standing(contractDef, list2);
				foreach (int item8 in value2)
				{
					bool flag = list3.Contains(item8);
					PlayerAvatar val = PlayerOf(item8);
					if (flag && (Object)(object)val != (Object)null && num3 > 0)
					{
						Scrap.HostGrant(val, num3, "Rival contract");
					}
					Net.SendRivalResult(item8, item4.Key, flag ? 1 : 2, flag ? num3 : 0, standing);
				}
			}
		}

		private static float RivalScore(string obj, int actor)
		{
			return obj switch
			{
				"rival.value" => TeamPlay.HostValue(actor, TeamPlay.Ev.Carried), 
				"rival.kills" => TeamPlay.HostValue(actor, TeamPlay.Ev.Kills), 
				"rival.guard" => TeamPlay.HostValue(actor, TeamPlay.Ev.Healed) + 25f * TeamPlay.HostValue(actor, TeamPlay.Ev.Revives), 
				"rival.carry" => Get(actor, "carry"), 
				_ => 0f, 
			};
		}

		private static string Standing(ContractDef d, List<(int actor, float score)> scores)
		{
			List<string> list = new List<string>();
			for (int i = 0; i < scores.Count && i < 4; i++)
			{
				float item = scores[i].score;
				string arg = ((d.obj == "rival.value") ? $"${item:N0}" : $"{item:0}");
				list.Add($"{i + 1}. {ClassClaims.NameOf(scores[i].actor)} {arg}");
			}
			string text = string.Join("  ", list);
			if (text.Length <= 120)
			{
				return text;
			}
			return text.Substring(0, 120);
		}
	}
	internal static class Contracts
	{
		private sealed class Template
		{
			public string Type = "";

			public bool MultiplayerOnly;

			public Func<int, int> Target = (int _) => 1;

			public int Xp;

			public int GearFloor = -1;

			public int AttributePoints;
		}

		public const int Active = 0;

		public const int Done = 1;

		public const int Failed = 2;

		private static readonly Template[] Templates = new Template[7]
		{
			new Template
			{
				Type = "Exterminate",
				Target = (int lvl) => Mathf.Clamp(2 + lvl / 3, 2, 6),
				Xp = 70
			},
			new Template
			{
				Type = "EliteHunter",
				Target = (int _) => 1,
				Xp = 90,
				GearFloor = 2,
				AttributePoints = 1
			},
			new Template
			{
				Type = "Speedrun",
				Target = (int lvl) => 8 + lvl / 2,
				Xp = 120,
				GearFloor = 1
			},
			new Template
			{
				Type = "NoCasualties",
				Target = (int _) => 1,
				Xp = 110,
				GearFloor = 1,
				MultiplayerOnly = true
			},
			new Template
			{
				Type = "Rescue",
				Target = (int _) => 1,
				Xp = 60,
				AttributePoints = 1,
				MultiplayerOnly = true
			},
			new Template
			{
				Type = "Specialist",
				Target = (int _) => 3,
				Xp = 90
			},
			new Template
			{
				Type = "Haul",
				Target = (int _) => 2,
				Xp = 60,
				GearFloor = 0
			}
		};

		public static List<ContractState> Roll(int levelIndex, bool multiplayer, int extra = 0)
		{
			Random random = RunInfo.RngFor(levelIndex * 7477 + 11);
			List<Template> list = new List<Template>();
			Template[] templates = Templates;
			foreach (Template template in templates)
			{
				if (multiplayer || !template.MultiplayerOnly)
				{
					list.Add(template);
				}
			}
			List<ContractState> list2 = new List<ContractState>();
			int num = Math.Min(RunInfo.ContractCount + Math.Max(0, extra), list.Count);
			for (int j = 0; j < num; j++)
			{
				int index = random.Next(list.Count);
				Template template2 = list[index];
				list.RemoveAt(index);
				list2.Add(new ContractState
				{
					type = template2.Type,
					target = template2.Target(levelIndex),
					rewardXp = Mathf.RoundToInt((float)template2.Xp * (1f + (float)levelIndex * 0.04f)),
					rewardGearFloor = template2.GearFloor,
					rewardAttributePoints = template2.AttributePoints
				});
			}
			return list2;
		}

		public static List<(ContractState c, bool multiplayerOnly)> Catalog(int levelIndex)
		{
			List<(ContractState, bool)> list = new List<(ContractState, bool)>();
			Template[] templates = Templates;
			foreach (Template template in templates)
			{
				list.Add((new ContractState
				{
					type = template.Type,
					target = template.Target(levelIndex),
					rewardXp = Mathf.RoundToInt((float)template.Xp * (1f + (float)levelIndex * 0.04f)),
					rewardGearFloor = template.GearFloor,
					rewardAttributePoints = template.AttributePoints
				}, template.MultiplayerOnly));
			}
			return list;
		}

		public static string Title(ContractState c)
		{
			return c.type switch
			{
				"Exterminate" => $"Exterminate: kill {c.target} enemies", 
				"EliteHunter" => "Elite Hunter: kill an elite enemy", 
				"Speedrun" => $"Speedrun: finish the level within {c.target} min", 
				"NoCasualties" => "No Casualties: nobody dies this level", 
				"Rescue" => "Rescue: revive a teammate", 
				"Specialist" => $"Specialist: use your ability {c.target} times (personal)", 
				"Haul" => $"Haul: complete {c.target} extraction points", 
				_ => c.type, 
			};
		}

		public static string Reward(ContractState c)
		{
			List<string> list = new List<string> { $"{c.rewardXp} XP" };
			if (c.rewardGearFloor >= 0)
			{
				list.Add((c.rewardGearFloor > 0) ? (Gear.Rarity(c.rewardGearFloor).name + "+ gear") : "gear");
			}
			if (c.rewardAttributePoints > 0)
			{
				list.Add($"+{c.rewardAttributePoints} attribute point");
			}
			return string.Join(", ", list);
		}

		public static List<ContractState> Progress(List<ContractState> list, string type, int amount = 1)
		{
			List<ContractState> list2 = new List<ContractState>();
			foreach (ContractState item in list)
			{
				if (item.status == 0 && !(item.type != type))
				{
					item.progress = Math.Min(item.target, item.progress + amount);
					if (item.progress >= item.target)
					{
						item.status = 1;
						list2.Add(item);
					}
				}
			}
			return list2;
		}

		public static void Fail(List<ContractState> list, string type)
		{
			foreach (ContractState item in list)
			{
				if (item.status == 0 && item.type == type)
				{
					item.status = 2;
				}
			}
		}

		public static List<ContractState> LevelCompleted(List<ContractState> list, float elapsedSeconds)
		{
			List<ContractState> list2 = new List<ContractState>();
			foreach (ContractState item in list)
			{
				if (item.status == 0)
				{
					if (item.type == "NoCasualties" || (item.type == "Speedrun" && elapsedSeconds <= (float)item.target * 60f))
					{
						item.progress = item.target;
						item.status = 1;
						list2.Add(item);
					}
					else if (item.type == "Speedrun")
					{
						item.status = 2;
					}
				}
			}
			return list2;
		}

		public static void TickTimers(List<ContractState> list, float elapsedSeconds)
		{
			foreach (ContractState item in list)
			{
				if (item.status == 0 && item.type == "Speedrun" && elapsedSeconds > (float)item.target * 60f)
				{
					item.status = 2;
				}
			}
		}
	}
	internal static class Crafting
	{
		private sealed class Drop
		{
			public Vector3 Pos;

			public int[] Counts = new int[4];

			public float Until;

			public readonly HashSet<int> Taken = new HashSet<int>();
		}

		public static readonly string[] Names = new string[4] { "Sinew", "Core Shard", "Prime Essence", "Boss Heart" };

		public static readonly string[] Short = new string[4] { "S", "C", "P", "H" };

		public static readonly Color[] Colors = (Color[])(object)new Color[4]
		{
			new Color(0.85f, 0.75f, 0.6f),
			new Color(0.45f, 0.75f, 1f),
			new Color(0.75f, 0.5f, 1f),
			new Color(1f, 0.6f, 0.25f)
		};

		private static readonly Dictionary<int, Drop> Drops = new Dictionary<int, Drop>();

		private static readonly HashSet<int> LureGranted = new HashSet<int>();

		private static int _nextId = 1;

		private static readonly Random Rng = new Random();

		public static string Describe(int[] counts)
		{
			List<string> list = new List<string>();
			for (int i = 0; i < 4 && i < counts.Length; i++)
			{
				if (counts[i] > 0)
				{
					list.Add($"{counts[i]} {Names[i]}");
				}
			}
			if (list.Count != 0)
			{
				return string.Join(", ", list);
			}
			return "nothing";
		}

		public static void NewLevel()
		{
			Drops.Clear();
			LureGranted.Clear();
		}

		public static void HostOnEnemyDied(EnemyHealth eh)
		{
			//IL_0261: Unknown result type (might be due to invalid IL or missing references)
			//IL_0266: Unknown result type (might be due to invalid IL or missing references)
			//IL_0270: Unknown result type (might be due to invalid IL or missing references)
			//IL_0275: Unknown result type (might be due to invalid IL or missing references)
			//IL_027a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0288: Unknown result type (might be due to invalid IL or missing references)
			//IL_028a: Unknown result type (might be due to invalid IL or missing references)
			//IL_02aa: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.IsMaster() || !Plugin.Cfg.CraftingParts.Value || (Object)(object)eh == (Object)null || !Game.InLevel())
			{
				return;
			}
			int[] array = new int[4];
			Elites.Info info;
			bool flag = Elites.TryGet(eh, out info);
			if (flag && info.Tier >= 3)
			{
				array[0] = 3;
				array[1] = 2;
				array[2] = 1;
				array[3] = 1;
			}
			else if (flag && info.Tier == 2)
			{
				array[0] = 2;
				array[1] = 2;
				array[2] = 1;
			}
			else if (flag)
			{
				array[0] = 2;
				array[1] = 1;
				array[2] = ((Rng.NextDouble() < 0.25) ? 1 : 0);
			}
			else if (Game.EnemyTier(eh) >= 2)
			{
				array[0] = 1;
				array[1] = ((Rng.NextDouble() < 0.4) ? 1 : 0);
			}
			else
			{
				array[0] = ((Rng.NextDouble() < 0.35) ? 1 : 0);
			}
			if (RunShape.Has("bone_collectors"))
			{
				for (int i = 0; i < 4; i++)
				{
					float num = (float)array[i] * 1.5f;
					array[i] = Mathf.FloorToInt(num) + ((Rng.NextDouble() < (double)(num - Mathf.Floor(num))) ? 1 : 0);
				}
			}
			if (ResearchCrew.HasDrill("salvage_drill"))
			{
				for (int j = 0; j < 4; j++)
				{
					float num2 = (float)array[j] * 1.25f;
					array[j] = Mathf.FloorToInt(num2) + ((Rng.NextDouble() < (double)(num2 - Mathf.Floor(num2))) ? 1 : 0);
				}
			}
			if (Ascension.PartsMult < 0.999f)
			{
				for (int k = 0; k < 4; k++)
				{
					float num3 = (float)array[k] * Ascension.PartsMult;
					array[k] = Mathf.FloorToInt(num3) + ((Rng.NextDouble() < (double)(num3 - Mathf.Floor(num3))) ? 1 : 0);
				}
			}
			if (array[0] + array[1] + array[2] + array[3] == 0)
			{
				return;
			}
			if (Drops.Count >= 60)
			{
				int num4 = int.MaxValue;
				foreach (int key in Drops.Keys)
				{
					num4 = Mathf.Min(num4, key);
				}
				Drops.Remove(num4);
			}
			int num5 = _nextId++;
			float num6 = Mathf.Clamp(Plugin.Cfg.PartLifetime.Value, 15f, 600f);
			Vector3 pos = ((Component)eh).transform.position + Vector3.up * 0.3f;
			Drops[num5] = new Drop
			{
				Pos = pos,
				Counts = array,
				Until = Time.time + num6
			};
			Net.SendPartDrop(num5, pos, array, num6);
		}

		public static void HostTake(int actor, int id)
		{
			//IL_00b5: Unknown result type (might be due to invalid IL or missing references)
			//IL_00bb: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c0: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c5: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.IsMaster())
			{
				return;
			}
			if (!Drops.TryGetValue(id, out Drop value) || Time.time >= value.Until)
			{
				Net.SendPartGrant(actor, id, new int[4], "gone");
				return;
			}
			if (value.Taken.Contains(actor))
			{
				Net.SendPartGrant(actor, id, new int[4], "taken");
				return;
			}
			PlayerAvatar val = null;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					val = item;
					break;
				}
			}
			if (!((Object)(object)val == (Object)null) && Game.IsAlive(val))
			{
				Vector3 val2 = ((Component)val).transform.position - value.Pos;
				if (!(((Vector3)(ref val2)).sqrMagnitude > 12.25f))
				{
					value.Taken.Add(actor);
					Net.SendPartGrant(actor, id, (int[])value.Counts.Clone(), "pickup");
					return;
				}
			}
			Net.SendPartGrant(actor, id, new int[4], "far");
		}

		public static void HostLures(int actor, float total)
		{
			if (Game.IsMaster() && Plugin.Cfg.CraftingParts.Value && !(total < 5f) && LureGranted.Add(actor))
			{
				Net.SendPartGrant(actor, -1, new int[4] { 0, 1, 0, 0 }, "5 monsters lured");
			}
		}

		public static void HostTick()
		{
			if (Drops.Count == 0)
			{
				return;
			}
			float time = Time.time;
			List<int> list = new List<int>();
			foreach (KeyValuePair<int, Drop> drop in Drops)
			{
				if (time >= drop.Value.Until)
				{
					list.Add(drop.Key);
				}
			}
			foreach (int item in list)
			{
				Drops.Remove(item);
			}
		}
	}
	internal static class Cursed
	{
		public const string ColorHex = "#E0344B";

		public const string CurseHex = "#FF8A8A";

		public static readonly Color Frame = new Color(0.7f, 0.07f, 0.18f);

		public static readonly Color Text = new Color(0.88f, 0.2f, 0.29f);

		private static readonly Dictionary<string, CursedDef> ById = new Dictionary<string, CursedDef>();

		public static IEnumerable<CursedDef> All => ById.Values;

		public static int Count => ById.Count;

		public static void Load(GearPack pack)
		{
			ById.Clear();
			CursedDef[] array = pack.cursed ?? Array.Empty<CursedDef>();
			foreach (CursedDef cursedDef in array)
			{
				if (cursedDef != null && !(cursedDef.id == ""))
				{
					CursedDef cursedDef2 = cursedDef;
					if (cursedDef2.effects == null)
					{
						cursedDef2.effects = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("cursed " + cursedDef.id, cursedDef.effects);
					ById[cursedDef.id] = cursedDef;
				}
			}
		}

		public static CursedDef? Def(string? id)
		{
			if (string.IsNullOrEmpty(id) || !ById.TryGetValue(id, out CursedDef value))
			{
				return null;
			}
			return value;
		}

		public static bool Is(GearItem? g)
		{
			if (g != null)
			{
				return !string.IsNullOrEmpty(g.cursed);
			}
			return false;
		}

		public static float Strength(GearItem g)
		{
			CursedDef cursedDef = Def(g.cursed);
			if (cursedDef == null || cursedDef.fixedCurse)
			{
				return 1f;
			}
			int num = GearX.Tier(g);
			if (num < 3)
			{
				if (num < 2)
				{
					return 1f;
				}
				return 0.85f;
			}
			return 0.7f;
		}

		public static bool IsMarker(EffectDef e)
		{
			return e.stat.StartsWith("gear.cursed.", StringComparison.Ordinal);
		}

		public static GearItem Make(Random rng, CursedDef d)
		{
			RpgData rpg = Plugin.Rpg;
			int num = Math.Max(0, rpg.SlotIndex(d.slot));
			GearItem gearItem = GearX.RollItem(rng, Gear.MaxRarity, rpg.slots[num], allowUnique: false);
			List<EffectDef> list = new List<EffectDef>(gearItem.effects);
			EffectDef[] effects = d.effects;
			foreach (EffectDef effectDef in effects)
			{
				list.Add(new EffectDef
				{
					stat = effectDef.stat,
					value = effectDef.value
				});
			}
			gearItem.effects = list.ToArray();
			gearItem.cursed = d.id;
			gearItem.cursedLines = d.effects.Length;
			gearItem.name = d.name;
			gearItem.flavor = d.flavor;
			gearItem.set = "";
			if (gearItem.sockets < 1)
			{
				gearItem.sockets = 1;
				gearItem.modules = new string[1] { "" };
			}
			ClassDatabase.ResolveAll("gear " + gearItem.name, gearItem.effects);
			return gearItem;
		}

		public static void AppendLines(GearItem from, List<EffectDef> into)
		{
			CursedDef cursedDef = Def(from.cursed);
			if (cursedDef != null)
			{
				EffectDef[] effects = cursedDef.effects;
				foreach (EffectDef effectDef in effects)
				{
					into.Add(new EffectDef
					{
						stat = effectDef.stat,
						value = effectDef.value
					});
				}
			}
			else
			{
				for (int j = Math.Max(0, from.effects.Length - from.cursedLines); j < from.effects.Length; j++)
				{
					into.Add(new EffectDef
					{
						stat = from.effects[j].stat,
						value = from.effects[j].value
					});
				}
			}
		}

		public static string RarityName(GearItem g)
		{
			if (!Is(g))
			{
				if (!Starters.Is(g))
				{
					return Gear.Rarity(g.rarity).name;
				}
				return "Starter";
			}
			return "Cursed";
		}

		public static string RarityHex(GearItem g)
		{
			if (!Is(g))
			{
				if (!Starters.Is(g))
				{
					return Gear.Rarity(g.rarity).color;
				}
				return "#8fd18f";
			}
			return "#E0344B";
		}

		public static string Describe(GearItem g)
		{
			CursedDef cursedDef = Def(g.cursed);
			if (cursedDef == null)
			{
				return "";
			}
			float num = Strength(g);
			string text = (cursedDef.fixedCurse ? "  <color=#9a9ca0>(this curse doesn't weaken)</color>" : ((num < 0.999f) ? $"  <color=#9a9ca0>(attunement: {Mathf.RoundToInt((1f - num) * 100f)}% weaker)</color>" : ""));
			return "<color=#E0344B><b>CURSED:</b></color> " + cursedDef.benefit + "\n<color=#FF8A8A><b>[!] CURSE:</b> " + cursedDef.curse + "</color>" + text;
		}

		public static float DropChance()
		{
			ModConfig cfg = Plugin.Cfg;
			float num = Mathf.Min((float)Mathf.Max(0, RunShape.Chapter - 1) * Mathf.Clamp(cfg.CursedMilestoneBonus.Value, 0f, 20f), Mathf.Clamp(cfg.CursedMilestoneBonusMax.Value, 0f, 50f));
			return Mathf.Clamp(cfg.CursedDropChance.Value + num, 0f, 100f);
		}

		public static void HostRollDrops(EnemyHealth eh)
		{
			//IL_0025: Unknown result type (might be due to invalid IL or missing references)
			//IL_002a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0035: Unknown result type (might be due to invalid IL or missing references)
			//IL_0040: Unknown result type (might be due to invalid IL or missing references)
			//IL_004b: Unknown result type (might be due to invalid IL or missing references)
			if (!Plugin.Cfg.CursedGear.Value || Count == 0)
			{
				return;
			}
			float num = DropChance();
			Vector3 position = ((Component)eh).transform.position;
			string text = string.Format(CultureInfo.InvariantCulture, "{0:0.##}|{1:0.##}|{2:0.##}", position.x, position.y, position.z);
			Random random = new Random();
			int num2 = 0;
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && !(random.NextDouble() * 100.0 >= (double)num))
				{
					num2++;
					Net.SendNotice(item, Notice.CursedDrop, 0f, text);
				}
			}
			Plugin.Log.LogInfo((object)$"[cursed] boss down: {num2} cursed drop(s) at {num:0.#}% each ({Game.Players().Count} player(s)).");
		}

		public static bool TryParsePos(string text, out Vector3 pos)
		{
			//IL_0001: Unknown result type (might be due to invalid IL or missing references)
			//IL_0006: Unknown result type (might be due to invalid IL or missing references)
			//IL_0062: Unknown result type (might be due to invalid IL or missing references)
			//IL_0067: Unknown result type (might be due to invalid IL or missing references)
			pos = Vector3.zero;
			string[] array = text.Split('|');
			if (array.Length < 3)
			{
				return false;
			}
			float result;
			float result2;
			float result3;
			bool num = float.TryParse(array[0], NumberStyles.Float, CultureInfo.InvariantCulture, out result) & float.TryParse(array[1], NumberStyles.Float, CultureInfo.InvariantCulture, out result2) & float.TryParse(array[2], NumberStyles.Float, CultureInfo.InvariantCulture, out result3);
			if (num)
			{
				pos = new Vector3(result, result2, result3);
			}
			return num;
		}
	}
	internal enum DifficultyTier
	{
		Relaxed,
		Standard,
		Hard,
		Brutal,
		Nightmare
	}
	internal enum DifficultyPreset
	{
		Relaxed,
		Easy,
		Normal,
		Hard,
		Brutal
	}
	internal static class Difficulty
	{
		private static ModConfig C => Plugin.Cfg;

		public static DifficultyTier Tier => C.Tier.Value;

		private static bool GlassCannon
		{
			get
			{
				if (!C.ModGlassCannon.Value)
				{
					return Heat.Has("glass_cannon");
				}
				return true;
			}
		}

		public static int SaveCost
		{
			get
			{
				if (Tier < DifficultyTier.Nightmare)
				{
					return 1;
				}
				return 2;
			}
		}

		public static bool Hardcore => C.ModHardcore.Value;

		public static bool NoShop => C.ModNoShop.Value;

		public static bool FragileGoods
		{
			get
			{
				if (C.ModFragileGoods.Value || Heat.Has("fragile_goods"))
				{
					return !Compat.FragileValuables;
				}
				return false;
			}
		}

		public static bool LoneWolves => C.ModLoneWolves.Value;

		public static bool ThinWallets
		{
			get
			{
				if (!C.ModThinWallets.Value)
				{
					return Heat.Has("thin_wallets");
				}
				return true;
			}
		}

		public static bool IronBodies
		{
			get
			{
				if (!C.ModIronBodies.Value)
				{
					return Heat.Has("iron_bodies");
				}
				return true;
			}
		}

		public static bool ShortFuse
		{
			get
			{
				if (!C.ModShortFuse.Value)
				{
					return Heat.Has("short_fuse");
				}
				return true;
			}
		}

		public static bool Blackout
		{
			get
			{
				if (!C.ModBlackout.Value)
				{
					return Heat.Has("blackout");
				}
				return true;
			}
		}

		private static float TierPay => Tier switch
		{
			DifficultyTier.Relaxed => 0.8f, 
			DifficultyTier.Hard => 1.3f, 
			DifficultyTier.Brutal => 1.7f, 
			DifficultyTier.Nightmare => 2.2f, 
			_ => 1f, 
		};

		public static float DamageTakenMult()
		{
			float num = Tier switch
			{
				DifficultyTier.Relaxed => 0.75f, 
				DifficultyTier.Hard => 1.2f, 
				DifficultyTier.Brutal => 1.4f, 
				DifficultyTier.Nightmare => 1.6f, 
				_ => 1f, 
			};
			if (GlassCannon)
			{
				num *= 1.3f;
			}
			return num;
		}

		public static float PlayerDamageMult()
		{
			if (!GlassCannon)
			{
				return 1f;
			}
			return 1.3f;
		}

		public static float EliteBonus()
		{
			return Tier switch
			{
				DifficultyTier.Relaxed => -10f, 
				DifficultyTier.Hard => 10f, 
				DifficultyTier.Brutal => 20f, 
				DifficultyTier.Nightmare => 30f, 
				_ => 0f, 
			};
		}

		public static float EliteMult()
		{
			return ((C.ModEliteSwarm.Value || Heat.Has("elite_swarm")) ? 2f : 1f) * Ascension.EliteChanceMult;
		}

		public static int BossEvery(int every)
		{
			if (Tier < DifficultyTier.Brutal)
			{
				return every;
			}
			return Mathf.Min(every, 2);
		}

		public static int BossMods(int mods)
		{
			if (Tier < DifficultyTier.Nightmare)
			{
				return mods;
			}
			return Mathf.Max(mods, 4);
		}

		public static float Payout(bool forScrap = false)
		{
			float num = TierPay;
			if (C.ModHardcore.Value)
			{
				num += 0.2f;
			}
			if (C.ModGlassCannon.Value)
			{
				num += 0.15f;
			}
			if (C.ModNoShop.Value)
			{
				num += 0.2f;
			}
			if (C.ModFragileGoods.Value)
			{
				num += 0.15f;
			}
			if (C.ModEliteSwarm.Value)
			{
				num += 0.25f;
			}
			if (C.ModLoneWolves.Value)
			{
				num += 0.1f;
			}
			if (C.ModThinWallets.Value && !forScrap)
			{
				num += 0.1f;
			}
			if (C.ModIronBodies.Value)
			{
				num += 0.25f;
			}
			if (C.ModShortFuse.Value)
			{
				num += 0.15f;
			}
			if (C.ModBlackout.Value)
			{
				num += 0.1f;
			}
			return num;
		}

		public static float ScrapMult()
		{
			return Payout(forScrap: true) * (ThinWallets ? 0.5f : 1f) * Market.HaulScrapMult * Ascension.ScrapMult;
		}

		public static List<string> ActiveMods()
		{
			List<string> list = new List<string>();
			if (C.ModHardcore.Value)
			{
				list.Add("Hardcore");
			}
			if (C.ModGlassCannon.Value)
			{
				list.Add("Glass Cannon");
			}
			if (C.ModNoShop.Value)
			{
				list.Add("No Shop");
			}
			if (C.ModFragileGoods.Value)
			{
				list.Add("Fragile Goods");
			}
			if (C.ModEliteSwarm.Value)
			{
				list.Add("Elite Swarm");
			}
			if (C.ModLoneWolves.Value)
			{
				list.Add("Lone Wolves");
			}
			if (C.ModThinWallets.Value)
			{
				list.Add("Thin Wallets");
			}
			if (C.ModIronBodies.Value)
			{
				list.Add("Iron Bodies");
			}
			if (C.ModShortFuse.Value)
			{
				list.Add("Short Fuse");
			}
			if (C.ModBlackout.Value)
			{
				list.Add("Blackout");
			}
			return list;
		}

		public static string Badge()
		{
			int count = ActiveMods().Count;
			if (Tier == DifficultyTier.Standard && count == 0)
			{
				return "";
			}
			return string.Format("PAYOUT {0}{1}  x{2:0.##}", Tier.ToString().ToUpperInvariant(), (count > 0) ? $" +{count}" : "", Payout());
		}
	}
