			PlayerAvatar val = list.Find((PlayerAvatar a) => (Object)(object)a != (Object)null && ((Object)(object)Game.DeathHead(a) == (Object)null || !Object.op_Implicit((Object)(object)Game.Get<Component>(a, "tumble", null))));
