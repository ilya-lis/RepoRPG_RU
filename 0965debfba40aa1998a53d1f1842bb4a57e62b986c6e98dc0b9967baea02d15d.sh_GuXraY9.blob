			float num2 = (Plugin.Cfg.ForceWaitTimeouts.Value ? 5f : 150f);
			if (num > num2)
			{
				_ljJoining = false;
				Plugin.Log.LogWarning((object)$"[late join] stopped waiting for the level to build after {num:0} s; nothing of RepoRPG's waits on it any more.");
				return;
			}
