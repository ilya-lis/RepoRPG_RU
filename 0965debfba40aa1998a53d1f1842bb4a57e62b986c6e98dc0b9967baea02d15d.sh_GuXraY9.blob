		private string TalentSummary(bool busy)
		{
			if (busy)
			{
				return "<color=#73ff66><b>Applying...</b></color>";
			}
			if (!TalentsHavePending || Current == null)
			{
				return "<color=#9a9ca0>Click a talent (or select it) to add a point, right-click (or the remove button) to take it back, then confirm.</color>";
			}
			List<string> list = new List<string>();
			foreach (KeyValuePair<string, int> item2 in _talentPending)
			{
				NodeDef item = TalentAlloc.Find(Current, item2.Key).n;
				if (item != null)
				{
					list.Add($"{item.name} +{item2.Value}");
				}
			}
			return $"<color=#73ff66><b>{TalentPendingTotal()} pending:</b></color>  " + string.Join(", ", list);
		}

		private string PerkSummary(bool busy)
		{
			if (busy)
			{
				return "<color=#73ff66><b>Applying...</b></color>";
			}
			if (!PerksHavePending)
			{
				return "<color=#9a9ca0>Select a perk for each pick, then confirm.</color>";
			}
			List<string> list = new List<string>();
			foreach (KeyValuePair<int, string> item in _perkPending)
			{
				list.Add(Plugin.Rpg.Perk(item.Value)?.name ?? item.Value);
			}
			return $"<color=#73ff66><b>{_perkPending.Count} selected:</b></color>  " + string.Join(", ", list);
		}

		private List<string> PendingLines()
		{
			List<string> list = new List<string>();
			if (SettingsSync.Unsaved)
			{
				int num = SettingsSync.UnsavedCount();
				list.Add(string.Format("Settings: {0} change{1} not saved", num, (num == 1) ? "" : "s"));
			}
			if (TalentsHavePending && Current != null)
			{
				int num2 = TalentPendingTotal();
				list.Add(string.Format("Class: {0} talent point{1} ({2})", num2, (num2 == 1) ? "" : "s", Current.name));
			}
			if (AttrHasPending)
			{
				int num3 = AttrPendingTotal();
				list.Add(string.Format("Attributes: {0} point{1}", num3, (num3 == 1) ? "" : "s"));
			}
			if (PerksHavePending)
			{
				list.Add(string.Format("Perks: {0} pick{1}", _perkPending.Count, (_perkPending.Count == 1) ? "" : "s"));
			}
			return list;
		}

		private void ConfirmAll()
		{
			if (TalentsHavePending)
			{
				ConfirmTalents();
			}
			if (AttrHasPending)
			{
				ConfirmAttributes();
			}
			if (PerksHavePending)
			{
				ConfirmPerks();
			}
		}

		private void DiscardAll()
		{
			_talentPending.Clear();
			_attrPending.Clear();
			_perkPending.Clear();
		}

		private string PlayAsText(ClassDef def)
		{
			if (Current == null || CurrentProgress == null)
			{
				if (!ClassClaims.Active)
				{
					return "You'll play " + def.name + " for this run.";
				}
				return def.name + " will be yours for this game - nobody else can play it while you do.";
			}
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append($"You'll stop playing {Current.name}. Your {Current.name} progress (level {CurrentProgress.level}, " + $"{CurrentProgress.SpentPoints()} talent points) is kept and comes back if you switch back - nothing is refunded or lost. ");
			stringBuilder.Append("Attributes, gear and perks are shared by all your classes and stay.");
			if (TalentsHavePending)
			{
				stringBuilder.Append($" <color=#ff9999>Your {TalentPendingTotal()} unconfirmed talent points will be discarded.</color>");
			}
			stringBuilder.Append(MilestoneSwitchText(def));
			return stringBuilder.ToString();
		}

