		private void StartLayoutCheck()
		{
			if (_menuOpen && !LayoutCheckRunning)
			{
				_lcIssues.Clear();
				_lcSeen.Clear();
				_lcByKind.Clear();
				_lcTexts = 0;
				_lcStep = 0;
				LayoutCheckSummary = "Running...";
				Plugin.Log.LogInfo((object)$"[layout] check started: {TabNames.Length} tabs x {CheckSizes.Length} sizes x {CheckScales.Length} text scales.");
			}
		}

		private void LayoutCheckStep()
		{
			//IL_020b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0212: Unknown result type (might be due to invalid IL or missing references)
			//IL_0015: Unknown result type (might be due to invalid IL or missing references)
			//IL_001b: Invalid comparison between Unknown and I4
			//IL_0083: Unknown result type (might be due to invalid IL or missing references)
			//IL_0088: Unknown result type (might be due to invalid IL or missing references)
			//IL_008a: Unknown result type (might be due to invalid IL or missing references)
			//IL_008f: Unknown result type (might be due to invalid IL or missing references)
			//IL_018c: Unknown result type (might be due to invalid IL or missing references)
			//IL_00db: Unknown result type (might be due to invalid IL or missing references)
			//IL_00e0: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ee: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f3: Unknown result type (might be due to invalid IL or missing references)
			//IL_0111: Unknown result type (might be due to invalid IL or missing references)
			if (!LayoutCheckRunning || !_menuOpen || (int)Event.current.type != 7)
			{
				if (LayoutCheckRunning && !_menuOpen)
				{
					FinishLayoutCheck(stopped: true);
				}
			}
			else
			{
				if (_dialogOpen)
				{
					return;
				}
				int num = CheckSizes.Length * CheckScales.Length;
				(int, int, string) tuple = CheckSizes[_lcStep / CheckScales.Length];
				float num2 = CheckScales[_lcStep % CheckScales.Length];
				int tab = _tab;
				Matrix4x4 matrix = GUI.matrix;
				Color color = GUI.color;
				bool enabled = GUI.enabled;
				_probeOn = true;
				_probeW = tuple.Item1;
				_probeH = tuple.Item2;
				_probeTs = num2;
				_lcSize = tuple.Item3;
				_lcScale = num2;
				try
				{
					float num3 = UiScale();
					EnsureStyles();
					GUI.matrix = Matrix4x4.TRS(Vector3.zero, Quaternion.identity, new Vector3(num3, num3, 1f));
					GUI.color = new Color(1f, 1f, 1f, 0f);
					float num4 = (float)tuple.Item1 / num3;
					float num5 = (float)tuple.Item2 / num3;
					for (int i = 0; i < TabNames.Length; i++)
					{
						_tab = i;
						_lcTab = TabNames[i];
						_lcRegion = "";
						_lcScrolls.Clear();
						_lcRegions.Clear();
						try
						{
							DrawMenu(num4, num5);
							CheckRegions(new Rect(0f, 0f, num4, num5));
						}
						catch (Exception ex)
						{
							LcIssue("error", "drawing failed: " + ex.GetType().Name + ": " + ex.Message);
						}
						finally
						{
							_lcScrolls.Clear();
							_currentScrollId = 0;
						}
					}
				}
				finally
				{
					_probeOn = false;
					_tab = tab;
					_lcRegion = "";
					GUI.matrix = matrix;
					GUI.color = color;
					GUI.enabled = enabled;
					UiScale();
					EnsureStyles();
				}
				_lcStep++;
				if (_lcStep >= num)
				{
					FinishLayoutCheck(stopped: false);
				}
			}
		}

		private void FinishLayoutCheck(bool stopped)
		{
			//IL_02c1: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ba: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ec: Unknown result type (might be due to invalid IL or missing references)
			int count = _lcIssues.Count;
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.AppendLine(string.Format("RepoRPG {0} layout check, {1:yyyy-MM-dd HH:mm}", "1.0.100", DateTime.Now) + (stopped ? " (STOPPED: the menu closed)" : ""));
			stringBuilder.AppendLine("Tabs: " + string.Join(", ", TabNames) + " (each in the state it was in when the check ran).");
			stringBuilder.AppendLine("Sizes: " + string.Join(", ", Array.ConvertAll(CheckSizes, ((int w, int h, string name) s) => s.name)) + ". Text scales: 75%, 100%, 150%, 200%.");
			stringBuilder.AppendLine($"Texts checked: {_lcTexts:N0}. Issues: {count}" + ((count > 0) ? (" (" + string.Join(", ", ByKind()) + ")") : "") + ".");
			stringBuilder.AppendLine();
			foreach (string lcIssue in _lcIssues)
			{
				stringBuilder.AppendLine(lcIssue);
			}
			string text = "";
			try
			{
				text = Path.Combine(Paths.ConfigPath, "RepoRPG_layout_check.txt");
				File.WriteAllText(text, stringBuilder.ToString());
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[layout] couldn't write the report: " + ex.Message));
				text = "";
			}
			LayoutCheckSummary = (stopped ? "Stopped. " : "") + ((count == 0) ? $"No issues ({_lcTexts:N0} texts checked)." : ($"{count} issues: " + string.Join(", ", ByKind()) + ".")) + ((text != "") ? " Report: BepInEx/config/RepoRPG_layout_check.txt" : "");
			Plugin.Log.LogInfo((object)("[layout] " + LayoutCheckSummary));
			for (int num = 0; num < _lcIssues.Count && num < 60; num++)
			{
				Plugin.Log.LogInfo((object)("[layout] " + _lcIssues[num]));
			}
			if (_lcIssues.Count > 60)
			{
				Plugin.Log.LogInfo((object)$"[layout] ... and {_lcIssues.Count - 60} more in the report file.");
			}
			Toast((count == 0) ? "Layout check: no issues" : $"Layout check: {count} issues (see the report)", (count == 0) ? Good : Bad);
			_lcStep = -1;
			if (!stopped)
			{
				StartHudProbe(1.5f, forLayout: true);
				Toast("Close the menu: the HUD part of the check runs then", Accent);
			}
		}

		private List<string> ByKind()
		{
			List<string> list = new List<string>();
			foreach (KeyValuePair<string, int> item in _lcByKind)
			{
				list.Add($"{item.Value} {item.Key}");
			}
			return list;
		}

		private void LcIssue(string kind, string what)
		{
			string item = kind + "|" + _lcTab + "|" + what;
			string item2 = $"[{kind}] {_lcTab} @ {_lcSize}, text {_lcScale * 100f:0}%: {what}";
			if (_lcSeen.Add(item))
			{
				_lcByKind.TryGetValue(kind, out var value);
				_lcByKind[kind] = value + 1;
				if (_lcIssues.Count < 2000)
				{
					_lcIssues.Add(item2);
				}
			}
		}

