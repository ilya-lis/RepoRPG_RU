			{
				why = "the level is loading";
				return false;
			}
			try
			{
				GameDirector instance = GameDirector.instance;
				if (Game.InLevel() && (Object)(object)instance != (Object)null && (int)instance.currentState != 2)
				{
					why = "the level is ending";
					return false;
				}
			}
