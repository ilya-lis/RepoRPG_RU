			});
		}

		public void BanishPerk(int pick, string id)
		{
			//IL_004c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0190: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			PerkDef perkDef = Plugin.Rpg.Perk(id);
			if (perkDef == null || PerksBusy)
			{
				return;
			}
			if (Perks.BanishesLeft(data) <= 0)
			{
				Toast((Plugin.Cfg.PerkBanishes.Value <= 0) ? "Banishing is off in this lobby" : "No banishes left this run", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			List<List<string>> list = PerkAlloc.Sets(data);
			if (pick < 0 || pick >= list.Count || !list[pick].Contains(id))
			{
				return;
			}
			data.banished.Add(id);
			foreach (KeyValuePair<int, string> item in new List<KeyValuePair<int, string>>(_perkPending))
			{
				if (item.Value == id)
				{
					_perkPending.Remove(item.Key);
				}
			}
			int num = list[pick].IndexOf(id);
			list[pick].RemoveAt(num);
			List<string> list2 = RollPerkSet(data, list, new Random(), 1, Current?.id);
			if (list2.Count > 0)
			{
				list[pick].Insert(Mathf.Min(num, list[pick].Count), list2[0]);
			}
			PerkAlloc.WriteSets(data, list);
			EnsurePerkChoices();
			_store.MarkDirty();
			_store.SaveNow();
			Notify(PopupKind.Perk, "Banished: " + perkDef.name + " (never offered again this run)", Perks.CursedColor);
			MenuSound(UiSound.Back);
		}

		public void BuyGearReroll(GearItem g, bool upgrade)
		{
			//IL_0049: Unknown result type (might be due to invalid IL or missing references)
			if (upgrade && g.rarity >= Gear.MaxRarity)
			{
				return;
			}
			if (Starters.Is(g))
			{
				Toast("Starter items can't be rerolled or upgraded", Color.white);
				return;
			}
			string uid = g.uid;
			int amount = Shop.Price(upgrade ? Plugin.Cfg.PriceGearUpgrade.Value : Plugin.Cfg.PriceGearReroll.Value);
			string arg = (upgrade ? ("Upgrades to " + Gear.Rarity(g.rarity + 1).name + " and rerolls") : "Rerolls");
			string body = string.Format("{0}: {1} affix{2}", arg, GearX.RandomAffixCount(g), (GearX.RandomAffixCount(g) == 1) ? "" : "es") + (upgrade ? " (the base stat grows with the rarity)" : "") + "\nKeeps: " + RerollKeeps(g) + "\n\nCost: " + Scrap.Price(amount);
			AskConfirm(upgrade ? ("RARITY UP: " + g.name.ToUpperInvariant() + "?") : ("REROLL " + g.name.ToUpperInvariant() + "?"), body, upgrade ? "Rarity up" : "Reroll", delegate
			{
				Buy(upgrade ? "upgrade" : "reroll", (upgrade ? "upgrade " : "reroll ") + g.name, upgrade ? Plugin.Cfg.PriceGearUpgrade.Value : Plugin.Cfg.PriceGearReroll.Value, delegate
				{
					//IL_004d: Unknown result type (might be due to invalid IL or missing references)
					//IL_01fb: Unknown result type (might be due to invalid IL or missing references)
					RunSave data = _store.Data;
					int num = data.inventory.FindIndex((GearItem x) => x.uid == uid);
					if (num < 0)
					{
						Toast("That item is gone - bought a gear crate roll instead", Color.gray);
						FindGear(1, "refund");
					}
					else
					{
						GearItem gearItem = data.inventory[num];
						GearItem gearItem2 = GearX.Reroll(gearItem, new Random(), upgrade ? Mathf.Min(gearItem.rarity + 1, Gear.MaxRarity) : gearItem.rarity);
						if (gearItem2.freeValue < 0)
						{
							gearItem2.freeValue = SalvageCalc.Gross(gearItem);
						}
						gearItem2.scrapIn = gearItem.scrapIn + Mathf.Max(0, _lastCharged);
						data.inventory[num] = gearItem2;
						_statsDirty = true;
						_store.MarkDirty();
						_store.SaveNow();
						Plugin.Log.LogInfo((object)string.Format("[gear] {0} {1} -> {2}: set '{3}', sockets {4} [{5}], attune {6}, unique '{7}'.", upgrade ? "upgraded" : "rerolled", gearItem.name, gearItem2.name, gearItem2.set, gearItem2.sockets, string.Join(",", gearItem2.modules), gearItem2.attune, gearItem2.unique));
						RarityDef rarityDef = Gear.Rarity(gearItem2.rarity);
						Notify(PopupKind.Loot, (upgrade ? "Upgraded" : "Rerolled") + ": " + rarityDef.name + " " + gearItem2.name, ParseColor(rarityDef.color));
						string text = string.Join("\n", Lines(gearItem));
						string text2 = string.Join("\n", Lines(gearItem2));
						AskConfirm("REROLL RESULT", "<b>BEFORE</b> - " + gearItem.name + "\n" + text + "\n\n<b>NOW</b> - " + gearItem2.name + "\n<color=#73ff66>" + text2 + "</color>\n\n<color=#9a9ca0>Kept: " + RerollKeeps(gearItem2) + "</color>", "OK", delegate
						{
						});
					}
				});
			});
		}

		private static string RerollKeeps(GearItem g)
		{
			List<string> list = new List<string>();
			SetDef setDef = GearSets.Get(g.set);
			if (setDef != null)
			{
				list.Add(setDef.name);
			}
			if (g.unique != "")
			{
				list.Add("its Unique effect and name");
			}
			if (g.sockets > 0)
			{
				int num = 0;
				string[] modules = g.modules;
				for (int i = 0; i < modules.Length; i++)
				{
					if (!string.IsNullOrEmpty(modules[i]))
					{
						num++;
					}
				}
				list.Add(string.Format("{0} socket{1}", g.sockets, (g.sockets == 1) ? "" : "s") + ((num > 0) ? string.Format(" with {0} module{1}", num, (num == 1) ? "" : "s") : ""));
			}
			if (g.attune > 0)
			{
				list.Add("attunement");
			}
			if (g.hasBase)
			{
				list.Add("base stat");
			}
			if (g.up > 0)
			{
				list.Add($"upgrade level +{g.up}" + ((g.upSteps > 0) ? $" and its +{(float)g.upSteps * (GearX.Pack.upgrades ?? new GearUpgradeDef()).step:0}%" : "") + ((g.upFx.Length != 0) ? " (its upgrade lines roll again on a reroll)" : ""));
			}
			if (g.crafts > 0)
			{
				list.Add("crafting");
			}
			if (list.Count != 0)
			{
				return string.Join(", ", list) + ", slot and rarity";
			}
			return "slot and rarity";
		}

		public void OnAppraised(int gained, int count, int bestRarity)
		{
			//IL_0067: Unknown result type (might be due to invalid IL or missing references)
			if (gained > 0 && count > 0)
			{
				string arg = ((count != 1) ? $"{count} items" : ((bestRarity >= 2) ? ("a " + Gear.Rarity(bestRarity).name + " item") : "1 item"));
				Notify(PopupKind.Loot, $"Appraised {arg}: +${gained:N0} value", (Color?)new Color(0.94f, 0.63f, 0.82f), "");
			}
		}

		public void OnUpgradeUsed(string key, int viewId)
		{
			//IL_0121: Unknown result type (might be due to invalid IL or missing references)
			//IL_0153: Unknown result type (might be due to invalid IL or missing references)
			if (string.IsNullOrEmpty(key))
			{
				return;
			}
			RunSave data = _store.Data;
			int num = (Plugin.Cfg.UpgradeRarity.Value ? Upgrades.Rarity(viewId) : 0);
			bool flag = Current != null && Current.HasAffinity(key);
			RarityDef rarityDef = Gear.Rarity(num);
			int num2 = ((!flag) ? 1 : 2);
			bool flag2 = false;
			foreach (NodeRank upgradeBonu in data.upgradeBonus)
			{
				if (upgradeBonu.id == key)
				{
					upgradeBonu.rank += num2;
					flag2 = true;
					break;
				}
			}
			if (!flag2)
			{
				data.upgradeBonus.Add(new NodeRank
				{
					id = key,
					rank = num2
				});
			}
			_statsDirty = true;
			Notify(PopupKind.Loot, rarityDef.name + " " + Upgrades.Name(key) + " upgrade" + (flag ? " – class affinity x2!" : ""), ParseColor(rarityDef.color));
			if (Current == null)
			{
				Toast("Pick a class (" + MenuPrompt + ") to earn XP from upgrades", Color.gray, 4f);
			}
			int baseAmount = Mathf.RoundToInt((float)Plugin.Cfg.UpgradeXp.Value * Upgrades.XpMultiplier(num) * (flag ? 2f : 1f));
			GiveXp(baseAmount, null, "upgrade");
			if (num >= 2)
			{
				data.bonusAttributePoints++;
				Notify(PopupKind.Level, "+1 attribute point (upgrade)");
			}
			if (num >= 3)
			{
				FindGear(2, "upgrade bonus");
			}
			if (num >= 4)
			{
				data.perkPicksPending++;
				Account.Max("runpicks", data.perks.Count + data.perkPicksPending);
				EnsurePerkChoices();
				Notify(PopupKind.Perk, "Perk pick! Choose one in the menu (" + MenuPrompt + ")", null, "perkpick");
			}
			_store.SaveNow();
		}

		private void CheckPerkMilestones()
		{
			RunSave data = _store.Data;
			int value = Plugin.Cfg.PerkEvery.Value;
			if (value <= 0 || Plugin.Rpg.perks.Length == 0)
			{
				return;
			}
			int num = 1;
			foreach (ClassProgress @class in data.classes)
			{
				num = Mathf.Max(num, @class.level);
			}
			int num2 = 0;
			PerkDef[] perks = Plugin.Rpg.perks;
			foreach (PerkDef p in perks)
			{
				if (Perks.Offerable(data, p))
				{
					num2++;
				}
			}
			while (data.perkMilestone + value <= num)
			{
				data.perkMilestone += value;
				if (data.perkPicksPending < num2)
				{
					data.perkPicksPending++;
					Account.Max("runpicks", data.perks.Count + data.perkPicksPending);
					Notify(PopupKind.Perk, "Perk ready! Choose one in the menu (" + MenuPrompt + ")", null, "perkpick");
				}
			}
			EnsurePerkChoices();
			_store.MarkDirty();
		}

		private void EnsurePerkChoices()
		{
			RunSave run = _store.Data;
			List<List<string>> list = PerkAlloc.Sets(run);
			bool flag = false;
			foreach (List<string> item in list)
			{
				if (item.RemoveAll((string id) => run.perks.Contains(id) || Plugin.Rpg.Perk(id) == null) > 0)
				{
					flag = true;
				}
			}
			int num = Mathf.Max(0, run.perkPicksPending);
			if (list.Count > num)
			{
				list.RemoveRange(num, list.Count - num);
				flag = true;
			}
			Random rng = new Random();
			int n = Mathf.Clamp(Plugin.Cfg.PerkChoices.Value + (Account.Active("wider_pick") ? 1 : 0), 1, 6);
			for (int num2 = 0; num2 < list.Count; num2++)
			{
				if (list[num2].Count <= 0)
				{
					List<string> list2 = RollPerkSet(run, list, rng, n, Current?.id);
					if (list2.Count == 0)
					{
						break;
					}
					list[num2] = list2;
					flag = true;
				}
			}
			while (list.Count > 0 && list[list.Count - 1].Count == 0)
			{
				list.RemoveAt(list.Count - 1);
				flag = true;
			}
			while (list.Count < num)
			{
				List<string> list3 = RollPerkSet(run, list, rng, n, Current?.id);
				if (list3.Count == 0)
				{
					break;
				}
				list.Add(list3);
				flag = true;
			}
			if (list.Count < num)
			{
				run.perkPicksPending = list.Count;
				flag = true;
			}
			if (flag)
			{
				PerkAlloc.WriteSets(run, list);
				_store.MarkDirty();
			}
		}

		private static List<string> RollPerkSet(RunSave run, List<List<string>> sets, Random rng, int n, string? classId)
		{
			List<string> list = new List<string>();
			List<string> list2 = new List<string>();
			List<string> list3 = new List<string>();
			PerkDef[] perks = Plugin.Rpg.perks;
			foreach (PerkDef p in perks)
			{
				if (Perks.Offerable(run, p) && !sets.Exists((List<string> s) => s.Contains(p.id)))
				{
					(p.cursed ? list3 : list2).Add(p.id);
				}
			}
			if (list2.Count == 0 && list3.Count == 0)
			{
				perks = Plugin.Rpg.perks;
				foreach (PerkDef perkDef in perks)
				{
					if (Perks.Offerable(run, perkDef))
					{
						(perkDef.cursed ? list3 : list2).Add(perkDef.id);
					}
				}
			}
			bool flag = list3.Count > 0 && n >= 2 && list2.Count > 0 && rng.NextDouble() * 100.0 < 5.0;
			for (int num = 0; num < n; num++)
			{
				if (list2.Count <= 0)
				{
					break;
				}
				if (flag && num == n - 1)
				{
					break;
				}
				string text = Perks.WeightedPick(list2, run, classId, rng);
				if (text == null)
				{
					break;
				}
				list.Add(text);
				list2.Remove(text);
			}
			if (flag)
			{
				string item = list3[rng.Next(list3.Count)];
				list.Insert(rng.Next(list.Count + 1), item);
			}
			return list;
		}

		public void RollPerkChoices()
		{
			RunSave data = _store.Data;
			_perkPending.Clear();
			data.perkChoices.Clear();
			data.perkChoiceSets.Clear();
			EnsurePerkChoices();
			if (data.perkChoices.Count == 0)
			{
				data.perkPicksPending = 0;
			}
			_store.MarkDirty();
		}

		public void PickPerk(string id)
		{
			RunSave data = _store.Data;
			if (data.perkPicksPending > 0 && data.perkChoices.Contains(id) && !PerksBusy)
			{
				_perkPending.Clear();
				_perkPending[0] = id;
				ConfirmPerks();
			}
		}

