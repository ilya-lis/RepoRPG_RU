			MaxPlayers = c.Bind<int>("Players", "MaxPlayers", 6, new ConfigDescription("Lobby size (players). 6 = vanilla. Set before hosting; changing it in a lobby applies at once. Everyone needs RepoRPG. Stands down when another more-players mod is installed.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(1, 20), Array.Empty<object>()));
