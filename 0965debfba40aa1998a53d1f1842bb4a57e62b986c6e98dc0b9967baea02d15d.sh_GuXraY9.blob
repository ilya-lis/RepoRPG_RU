			Banner(flag ? "REPORPG PAUSED: THE HOST NEEDS TO UPDATE" : ("REPORPG PAUSED: HOST HAS VERSION " + hostVersion.ToUpperInvariant()), new Color(1f, 0.5f, 0.4f), 10f);
