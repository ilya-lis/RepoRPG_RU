		private static string KeyGlyph(KeyCode key, string chord)
		{
			//IL_00bf: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c2: Unknown result type (might be due to invalid IL or missing references)
			if (Pad.Connected && !string.IsNullOrWhiteSpace(chord))
			{
				string[] array = chord.Split('+');
				for (int i = 0; i < array.Length; i++)
				{
					string text = array[i].Trim().ToLowerInvariant();
					string[] array2 = array;
					int num = i;
					array2[num] = text switch
					{
						"up" => "D-UP", 
						"down" => "D-DOWN", 
						"left" => "D-LEFT", 
						"right" => "D-RIGHT", 
						_ => PadLabel(text, Pad.Kind), 
					};
				}
				return string.Join("+", array);
			}
			if ((int)key != 0)
			{
				return KeyLabel(key);
			}
			return "-";
		}

		private HcKey AddKey(List<HcKey> into, KeyCode key, string chord, string label)
		{
			//IL_0035: Unknown result type (might be due to invalid IL or missing references)
			//IL_0069: Unknown result type (might be due to invalid IL or missing references)
			int count = into.Count;
			while (_hcKeyPool.Count <= count)
			{
				_hcKeyPool.Add(new HcKey());
			}
			HcKey hcKey = _hcKeyPool[count];
			hcKey.Glyph = KeyGlyph(key, chord);
			hcKey.Label = label;
			hcKey.State = "";
			hcKey.On = false;
			hcKey.Usable = true;
			hcKey.HasState = false;
			if ((int)key == 0 && !Pad.Connected)
			{
				hcKey.Usable = false;
				hcKey.State = "unbound";
			}
			into.Add(hcKey);
			return hcKey;
		}

		private static void Grey(HcKey k, string why)
		{
			if (k.Usable)
			{
				k.Usable = false;
				k.State = why;
			}
