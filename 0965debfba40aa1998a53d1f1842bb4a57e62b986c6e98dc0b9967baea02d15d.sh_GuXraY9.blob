		private static string F(float v)
		{
			if (!(Mathf.Abs(v - Mathf.Round(v)) < 0.005f))
			{
				return v.ToString("0.##", CultureInfo.InvariantCulture);
			}
			return Mathf.Round(v).ToString("0", CultureInfo.InvariantCulture);
		}

		private static AbilityNums Ability(ClassDef c, ClassDef? copy, StatSheet s, float cdMult)
		{
			ActiveMods mods = c.active.mods;
			ActiveDef activeDef = ((copy != null) ? copy.active : c.active);
			bool flag = copy != null;
			float num = (flag ? (Mathf.Clamp(s.Custom("mimic.copy_power"), 10f, 100f) / 100f) : 1f);
			float num2 = (flag ? (copy.active.cooldown * (1f + Mathf.Max(0f, s.Custom("mimic.copy_cdpenalty")) / 100f)) : (-1f));
			AbilityNums abilityNums = new AbilityNums
			{
				Scale = num
			};
			abilityNums.Charges = 1 + Mathf.Max(0, Mathf.FloorToInt(s[Stat.AbilityCharges] + s.Custom(mods.charges)));
			float num3 = ((abilityNums.Charges > 1) ? Mathf.Clamp(s.Custom("perk.charge_rate"), 0f, 30f) : 0f);
			float num4 = s[Stat.CooldownReduction] + s.Custom(mods.cooldown) + num3;
			float value = Plugin.Cfg.MaxCooldownReduction.Value;
			abilityNums.CdrCapped = num4 >= value - 0.001f && num4 > 0f;
			abilityNums.Cdr = Mathf.Min(num4, value);
			float num5 = ((num2 > 0f) ? num2 : activeDef.cooldown) * cdMult;
			abilityNums.Cd = Mathf.Max(1f, num5 * (1f - abilityNums.Cdr / 100f));
			float num6 = s[Stat.ActivePower] + s.Custom(mods.power);
			abilityNums.Power = (1f + num6 / 100f) * num;
			abilityNums.HealPower = (1f + num6 / 100f * Mathf.Clamp01(Plugin.Cfg.HealPowerScaling.Value)) * num;
			float num7 = 1f + (s[Stat.ActiveDuration] + s.Custom(mods.duration)) / 100f;
			abilityNums.Dur = activeDef.duration * num7;
			abilityNums.Radius = activeDef.radius * (1f + (s[Stat.ActiveArea] + s.Custom(mods.area)) / 100f);
			ActionDef[] actions;
			if (flag)
			{
				actions = activeDef.actions;
				foreach (ActionDef actionDef in actions)
				{
					if (actionDef.type == "BreachCharge" || actionDef.type == "ZeroGField" || actionDef.type == "DecoyBeacon")
					{
						abilityNums.Radius *= num;
					}
					if (actionDef.type == "BreachCharge")
					{
						abilityNums.Dur *= num;
					}
				}
			}
			actions = activeDef.actions;
			foreach (ActionDef actionDef2 in actions)
			{
				switch (actionDef2.type)
				{
				case "ScanValuables":
					abilityNums.Acts.Add(("items", Mathf.Max(1, Mathf.RoundToInt(actionDef2.value * abilityNums.Power))));
					break;
				case "DamageEnemies":
					abilityNums.Acts.Add(("damage", Mathf.RoundToInt(actionDef2.value * abilityNums.Power)));
					break;
				case "BreachCharge":
					abilityNums.Acts.Add(("damage", actionDef2.value * abilityNums.Power));
					break;
				case "StunEnemies":
					abilityNums.Acts.Add(("s stun", actionDef2.value * num7 * (flag ? num : 1f) + ((flag || c.id != "herald") ? 0f : s.Custom("herald.rally_stun"))));
					break;
				case "HealSelfPct":
					abilityNums.Acts.Add(("% self heal", actionDef2.value * abilityNums.HealPower));
					break;
				case "HealAllies":
					abilityNums.Acts.Add(("HP ally heal", Mathf.RoundToInt(actionDef2.value * abilityNums.HealPower)));
					break;
				case "HealOverTime":
					abilityNums.Acts.Add(("% heal over time", actionDef2.value * abilityNums.HealPower));
					break;
				case "RallyCry":
					abilityNums.Acts.Add(("rally strength", actionDef2.value * abilityNums.Power));
					break;
				case "Reboot":
					abilityNums.Acts.Add(("% revive health", Mathf.Clamp(actionDef2.value * abilityNums.Power, 1f, 100f)));
					break;
				}
			}
			if (!flag)
			{
				RiderDef[] riders = activeDef.riders;
				foreach (RiderDef riderDef in riders)
				{
					if (s.Custom(riderDef.stat) > 0f)
					{
						abilityNums.Riders.Add((riderDef.action != "") ? Regex.Replace(riderDef.action, "(?<!^)([A-Z])", " $1") : "bonus buff");
					}
				}
			}
			return abilityNums;
		}

		private StatSheet SheetFor(ClassDef c, ClassProgress? prog, RunSave run)
		{
			StatSheet statSheet = new StatSheet();
			statSheet.Rebuild(c, prog, run, Plugin.Rpg);
			if (c == Current && c.id == "gambler")
			{
				if (run.gambleKey == RunInfo.Key + ":" + RunInfo.LevelIndex)
				{
					float mult = 1f + Mathf.Max(0f, statSheet.Custom("gambler.bless_power")) / 100f;
					float mult2 = Mathf.Max(0f, 1f - Mathf.Max(0f, statSheet.Custom("gambler.curse_soft")) / 100f);
					foreach (string item in run.gambleBless)
					{
						PerkDef perkDef = Find(Plugin.Rpg.blessings, item);
						if (perkDef != null)
						{
							statSheet.AddPermEffects(perkDef.effects, mult);
						}
					}
					PerkDef perkDef2 = Find(Plugin.Rpg.curses, run.gambleCurse);
					if (perkDef2 != null)
					{
						statSheet.AddPermEffects(perkDef2.effects, mult2);
					}
				}
				statSheet.AddPerm(Stat.GearFind, statSheet.Custom("gambler.gear_find"));
			}
			if (c == Current && c.id == "quartermaster")
			{
				statSheet.AddPerm(Stat.ScrapBonus, statSheet.Custom("quartermaster.scrap"));
			}
			return statSheet;
		}

		private static string Chain(float without, float now, float pending, bool hasPending, string unit, string col)
		{
			bool flag = Mathf.Abs(now - without) > 0.004f;
			bool flag2 = hasPending && Mathf.Abs(pending - now) > 0.004f;
			if (!flag && !flag2)
			{
				return "";
			}
			string text = (flag ? ("<color=#a4a6aa>" + F(without) + unit + "</color> → <color=#ffffff>" + F(now) + unit + "</color>") : ("<color=#ffffff>" + F(now) + unit + "</color>"));
			if (flag2)
			{
				text = text + " <color=" + col + ">→ " + F(pending) + unit + "</color>";
			}
			return text;
		}

		private static float CapOf(Stat s)
		{
			if (!Caps.TryGetValue(s, out string value))
			{
				return -1f;
			}
			try
			{
				object? obj = typeof(ModConfig).GetField(value)?.GetValue(Plugin.Cfg);
				ConfigEntryBase val = (ConfigEntryBase)((obj is ConfigEntryBase) ? obj : null);
				return (val == null) ? (-1f) : Convert.ToSingle(val.BoxedValue, CultureInfo.InvariantCulture);
			}
			catch
			{
				return -1f;
			}
		}

		private static bool IsCapped(Stat s, float total)
		{
			float num = CapOf(s);
			if (num <= 0f)
			{
				return false;
			}
			if (s != Stat.DamageTaken && s != Stat.StaminaDrain && s != Stat.HoldingStaminaDrain)
			{
				return total >= num - 0.001f;
			}
			return 0f - total >= num - 0.001f;
		}

		private static string NodeAt(NodeDef n, int rank)
		{
			string text = (n.desc ?? "").Replace("CAPSTONE: ", "");
			if (text == "")
			{
				List<string> list = new List<string>();
				EffectDef[] effects = n.effects;
				foreach (EffectDef effectDef in effects)
				{
					if (effectDef.StatIndex >= 0)
					{
						list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value * (float)rank));
					}
				}
				return string.Join(", ", list);
			}
			if (rank <= 1)
			{
				return text;
			}
			return Num.Replace(text, delegate(Match m)
			{
				if (!float.TryParse(m.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var result))
				{
					return m.Value;
				}
				EffectDef[] effects2 = n.effects;
				for (int j = 0; j < effects2.Length; j++)
				{
					if (Mathf.Abs(Mathf.Abs(effects2[j].value) - result) < 0.001f)
					{
						return F(result * (float)rank);
					}
				}
				return m.Value;
			});
		}

		private void BuildEffects(ClassDef vc, ClassProgress vp, ClassProgress shown, bool isCurrent, float wLeft, float wRight)
		{
			//IL_0035: Unknown result type (might be due to invalid IL or missing references)
			//IL_003f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0049: Unknown result type (might be due to invalid IL or missing references)
			_effectsLines.Clear();
			_effectsSplit = int.MaxValue;
			RunSave data = _store.Data;
			string text = "#" + ColorUtility.ToHtmlStringRGB(ClassTheme.Readable(ParseColor(vc.color), ClassTheme.Cur.Panel, 4.5f));
			float w = wLeft;
			bool flag = isCurrent && shown != vp;
			bool flag2 = false;
			int num = Mathf.Min(vc.branches.Length, Account.PrestigeUsable(vc.id) ? 4 : 3);
			for (int i = 0; i < num; i++)
			{
				NodeDef[] nodes = vc.branches[i].nodes;
				foreach (NodeDef nodeDef in nodes)
				{
					if (shown.RankOf(nodeDef.id) > 0 || vp.RankOf(nodeDef.id) > 0)
					{
						flag2 = true;
					}
				}
			}
			if (!flag2)
			{
				Add("<color=#9a9ca0>No talents yet: spend skill points in any tree to see their effects here.</color>", _small);
				return;
			}
			StatSheet s = SheetFor(vc, new ClassProgress
			{
				classId = vc.id,
				level = vp.level
			}, data);
			StatSheet statSheet = SheetFor(vc, vp, data);
			StatSheet statSheet2 = (flag ? SheetFor(vc, shown, data) : statSheet);
			Add("YOUR ABILITIES NOW", _bodyB);
			Add("<color=#9a9ca0>Without talents → now" + (flag ? (" <color=" + text + ">→ after Confirm</color>") : "") + ". Ability numbers include gear, perks and attributes; passives show what talents add.</color>", _small);
			float num2 = 1f;
			if (vc == Current)
			{
				num2 *= SynergyCooldownMult(vc.id);
				if (TeamContracts.CurseNow == "Drained")
				{
					num2 *= 1.2f;
				}
				if (Difficulty.ShortFuse)
				{
					num2 *= 1.25f;
				}
			}
			ClassDef classDef = null;
			if (vc.id == "mimic" && isCurrent)
			{
				classDef = MimicCopy();
				float v = Mathf.Clamp(statSheet.Custom("mimic.copy_power"), 10f, 100f);
				if (classDef != null)
				{
					Add("<b>" + vc.active.name + "</b>: copying <color=" + classDef.color + ">" + classDef.name + "</color>'s " + classDef.active.name + " at <b>" + F(v) + "%</b> strength", _small);
				}
				else
				{
					Add("<b>" + vc.active.name + "</b>: copy strength <b>" + F(v) + "%</b> (no ability copied yet)", _small);
				}
			}
			ActiveDef activeDef = ((classDef != null) ? classDef.active : vc.active);
			AbilityNums abilityNums = Ability(vc, classDef, s, num2);
			AbilityNums abilityNums2 = Ability(vc, classDef, statSheet, num2);
			AbilityNums abilityNums3 = (flag ? Ability(vc, classDef, statSheet2, num2) : abilityNums2);
			List<string> list = new List<string>();
			for (int k = 0; k < abilityNums2.Acts.Count && k < abilityNums.Acts.Count; k++)
			{
				string item = abilityNums2.Acts[k].label;
				string unit = ((item.StartsWith("%") || item.StartsWith("s ")) ? item : (" " + item));
				string text2 = Chain(abilityNums.Acts[k].value, abilityNums2.Acts[k].value, (k < abilityNums3.Acts.Count) ? abilityNums3.Acts[k].value : abilityNums2.Acts[k].value, flag, unit, text);
				if (text2 != "")
				{
					list.Add(text2);
				}
			}
			if (activeDef.radius > 0f)
			{
				string text3 = Chain(abilityNums.Radius, abilityNums2.Radius, abilityNums3.Radius, flag, " m range", text);
				if (text3 != "")
				{
					list.Add(text3);
				}
			}
			if (activeDef.duration > 0f)
			{
				string text4 = Chain(abilityNums.Dur, abilityNums2.Dur, abilityNums3.Dur, flag, " s", text);
				if (text4 != "")
				{
					list.Add(text4);
				}
			}
			string text5 = Chain(abilityNums.Cd, abilityNums2.Cd, abilityNums3.Cd, flag, " s cooldown", text);
			if (text5 != "")
			{
				list.Add(text5 + (abilityNums2.CdrCapped ? " <color=#ffcc66>(cooldown reduction capped)</color>" : ""));
			}
			string text6 = Chain(abilityNums.Charges, abilityNums2.Charges, abilityNums3.Charges, flag, (abilityNums2.Charges == 1) ? " charge" : " charges", text);
			if (text6 != "")
			{
				list.Add(text6);
			}
			float without = (abilityNums.Power / abilityNums.Scale - 1f) * 100f;
			float now = (abilityNums2.Power / abilityNums2.Scale - 1f) * 100f;
			float pending = (abilityNums3.Power / abilityNums3.Scale - 1f) * 100f;
			string text7 = Chain(without, now, pending, flag, "% power", text);
			if (text7 != "")
			{
				list.Add(text7);
			}
			foreach (string rider in abilityNums2.Riders)
			{
				list.Add("adds <b>" + rider + "</b>");
			}
			if (flag)
			{
				foreach (string rider2 in abilityNums3.Riders)
				{
					if (!abilityNums2.Riders.Contains(rider2))
					{
						list.Add("<color=" + text + ">adds " + rider2 + "</color>");
					}
				}
			}
			Add("<b>" + activeDef.name + "</b>: " + ((list.Count > 0) ? string.Join("  ·  ", list) : "<color=#9a9ca0>no changes from talents yet</color>"), _small);
			AltPassiveDef altPassiveDef = (Account.AltInRun(data, vc.id) ? Account.AltDef(vc.id) : null);
			PassiveDef[] passives = vc.passives;
			foreach (PassiveDef passiveDef in passives)
			{
