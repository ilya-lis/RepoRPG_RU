			ThreatLoot = c.Bind<float>("Threat", "Loot", 100f, new ConfigDescription("Valuables and the haul goal together per threat point (% of +3%): the goal stays the same share of the map.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
