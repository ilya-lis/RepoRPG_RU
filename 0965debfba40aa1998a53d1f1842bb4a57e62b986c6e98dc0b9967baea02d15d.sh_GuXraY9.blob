		private static string BuildMarketText()
		{
			Market.State cur = Market.Cur;
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append("<b>THE MARKET</b>  <color=#9a9ca0>Valuables are worth more or less by category. What the team extracts gets cheaper, what nobody brings gets dearer, and prices drift back toward normal. Prices change between levels only, so a level's haul goal never moves.</color>\n\n");
			stringBuilder.Append("<b>Since last level:</b> " + Market.Movers(4) + "\n");
			string text = Market.EventText();
			if (text != "")
			{
				stringBuilder.Append("<color=#ffd75a><b>Event:</b> " + text + "</color>\n");
			}
			string text2 = Market.RequestText();
			if (text2 != "")
			{
				stringBuilder.Append("<color=#99e6ff><b>Request:</b> " + text2 + "</color>\n");
			}
			stringBuilder.Append('\n');
			for (int i = 0; i < 8; i++)
			{
				float num = Market.CatMult(i);
				float num2 = cur.Prev[i];
				int num3 = Mathf.RoundToInt((num - 1f) * 100f);
				int num4 = Mathf.RoundToInt((cur.Mult[i] / Mathf.Max(0.01f, num2) - 1f) * 100f);
				string text3 = ((num4 > 0) ? $"<color=#73ff66>rising +{num4}%</color>" : ((num4 < 0) ? $"<color=#ff8a7a>falling {num4}%</color>" : "<color=#9a9ca0>steady</color>"));
				string text4 = ((num3 == 0) ? "normal" : string.Format("{0}{1}%", (num3 > 0) ? "+" : "", num3));
				stringBuilder.Append($"<b>{Market.Names[i]}</b>  x{num:0.00} ({text4})  {text3}\n");
			}
			StringBuilder stringBuilder2 = new StringBuilder();
			StringBuilder stringBuilder3 = new StringBuilder();
			for (int j = 0; j < cur.DemandKeys.Length && j < cur.DemandMult.Length; j++)
			{
				float num5 = cur.DemandMult[j];
				if (!(num5 <= 0.01f) && !(Mathf.Abs(num5 - 1f) < 0.025f))
				{
					string arg = DemandName(cur.DemandKeys[j]);
					((num5 > 1f) ? stringBuilder2 : stringBuilder3).Append(((stringBuilder2.Length > 0 && num5 > 1f) || (stringBuilder3.Length > 0 && num5 < 1f)) ? ", " : "").Append(string.Format("{0} {1}{2}%", arg, (num5 > 1f) ? "+" : "", Mathf.RoundToInt((num5 - 1f) * 100f)));
				}
			}
			if (stringBuilder2.Length > 0 || stringBuilder3.Length > 0)
			{
				stringBuilder.Append("\n<b>SHOP DEMAND</b>  <color=#9a9ca0>What the team buys a lot costs more; what nobody buys goes on sale.</color>\n");
				if (stringBuilder2.Length > 0)
				{
					stringBuilder.Append($"<color=#ff8a7a>Dearer:</color> {stringBuilder2}\n");
				}
				if (stringBuilder3.Length > 0)
				{
					stringBuilder.Append($"<color=#73ff66>On sale:</color> {stringBuilder3}\n");
				}
			}
			return stringBuilder.ToString();
		}

		private static string DemandName(string key)
		{
			if (key.StartsWith("gear", StringComparison.Ordinal) && int.TryParse(key.Substring(4), out var result))
			{
				return Gear.Rarity(result).name + " gear";
			}
			switch (key)
			{
			case "unique":
				return "Uniques";
			case "module":
				return "Modules";
			case "crate":
				return "Mystery Crates";
			case "premium":
				return "Premium Crates";
			default:
				if (key.StartsWith("cons:", StringComparison.Ordinal))
				{
					foreach (ConsumableDef consumable in ShopX.Consumables)
					{
						if ("cons:" + consumable.id == key)
						{
							return consumable.name;
						}
					}
				}
				return key;
			}
		}

		private static string MarketDetailsLine()
		{
			if (!Market.On || Market.Cur.Seq == 0)
			{
				return "";
			}
			string text = Market.EventText(withTiming: false);
			string text2 = Market.RequestText();
			return "Market: " + Market.Movers() + ((text != "") ? ("\n<color=#ffd75a>" + text + "</color>") : "") + ((text2 != "") ? ("\n" + text2) : "");
		}

		private bool MenuHintVisible()
