		private void OpenPresetEdit(PresetEdit kind, string from)
		{
			_presetEdit = kind;
			_presetFrom = from;
			_presetName = ((kind == PresetEdit.Rename) ? from : "");
			_presetNamerTitle = ((kind == PresetEdit.Rename) ? ("Rename preset '" + from + "' to:") : "Name for the new preset (the current settings, including pending changes):");
			_presetCaps = false;
			_presetFocusPending = _padMode && _promptDevice == NavDevice.Pad;
			if (_promptDevice != NavDevice.Pad)
