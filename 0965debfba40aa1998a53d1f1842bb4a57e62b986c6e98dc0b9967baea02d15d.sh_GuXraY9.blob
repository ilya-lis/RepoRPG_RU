		}

		private void BankPad()
		{
			if (_padItems.Count == 0)
			{
				return;
			}
			RoundDirector instance = RoundDirector.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return;
			}
			if ((object)_totalHaul == null)
			{
				_totalHaul = AccessTools.Field(((object)instance).GetType(), "totalHaul");
			}
			float num = 0f;
			_padLast.Clear();
			_padLast.AddRange(_padItems);
			foreach (ValuableObject item in _padLast)
			{
				if ((Object)(object)item == (Object)null)
				{
					continue;
				}
				float num2 = Game.Get(item, "dollarValueCurrent", 0f) * (1f + _padBonus / 100f);
				num += num2;
				PhysGrabObject component = ((Component)item).GetComponent<PhysGrabObject>();
				try
				{
					if (component != null)
					{
						component.DestroyPhysGrabObject();
					}
				}
				catch (Exception ex)
				{
					Game.WarnOnce("Drop Pad: couldn't remove a delivered item (" + ex.GetBaseException().Message + ")");
				}
			}
			AddNumber(_totalHaul, instance, num);
			TeamContracts.HostOnExtracted(num);
			RunShape.HostExtracted(num);
			_padItems.Clear();
			_padCredit = 0f;
			_padLast.Clear();
			foreach (PlayerAvatar item2 in Game.Players())
			{
				if ((Object)(object)item2 != (Object)null && ClassStats.ClassOf(item2) == "courier")
				{
					Net.SendNotice(item2, Notice.Popup, 0f, $"Drop Pad delivered: ${num:N0} with the haul");
				}
			}
			Plugin.Log.LogInfo((object)$"[courier] Drop Pad delivered ${num:N0} with the extraction.");
		}

