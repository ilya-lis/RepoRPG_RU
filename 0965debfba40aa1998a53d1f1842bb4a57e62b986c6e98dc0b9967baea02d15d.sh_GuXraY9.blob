			bool canEditHost = CanEditHost;
			bool locked = _transitioning || (Game.InLevel() && Game.IsLoading());
			if (Time.unscaledTime - _hostHeadAt >= 0.5f || Mathf.Abs(((Rect)(ref area)).width - _hostHeadW) > 0.5f)
			{
				_hostHeadAt = Time.unscaledTime;
				_hostHeadW = ((Rect)(ref area)).width;
				_hostHead = BuildHostHead(canEditHost);
				_hostHeadH = TextH(_hostHead, _body, ((Rect)(ref area)).width);
			}
			string hostHead = _hostHead;
			float hostHeadH = _hostHeadH;
			Label(new Rect(((Rect)(ref area)).x, ((Rect)(ref area)).y, ((Rect)(ref area)).width, hostHeadH + 2f), hostHead, _body);
			float y = ((Rect)(ref area)).y + hostHeadH + 8f;
			y = DrawDifficultySelector(area, y, settingsTab: false);
			ShowDetail(TabDetail("Point at a setting", "What it does, when it applies and its default show here."));
			DrawHostTabBody(area, canEditHost, locked, y);
		}

		private string BuildHostHead(bool edit)
		{
			string text = ((!edit) ? (SettingsSync.VersionBlocked ? ("<color=#ff9999>Paused: the host runs RepoRPG " + SettingsSync.HostModVersion + ", you run 1.0.100.</color>") : "<color=#9a9ca0>[LOCKED] Set by host - read only. Your own config file is never changed.</color>") : (Game.IsMultiplayer() ? $"You're the host: these rules apply to everyone. Settings version {SettingsSync.Version}, confirmed by {HostSettings.AckedCount(SettingsSync.Version)} player(s)." : "Your settings (singleplayer). In a lobby the host's apply to everyone."));
			string text2 = ((Game.InLevel() && PlayerScaling.Known) ? PlayerScaling.DescribeCurrent() : "");
			if (text2 != "")
			{
				text = text + "\n<color=#ffcc66>This level: " + text2 + "</color>";
			}
			string text3 = RunThreat.BannerText();
			if (text3 != "")
			{
				text = text + "\n<color=#ff8c4d>" + text3 + "</color>";
			}
			if (BigLobby.StandDown)
			{
				text = text + "\n<color=#9a9ca0>Lobby size is controlled by " + BigLobby.OtherModName + "; Players/MaxPlayers is ignored.</color>";
			}
			return text;
		}

