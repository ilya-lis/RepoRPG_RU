			{
				_barPool.Add(new UiAction());
			}
			UiAction uiAction = _barPool[_barUsed++];
			uiAction.Label = label;
			uiAction.Kind = kind;
			uiAction.Enabled = enabled;
			uiAction.Run = run;
			uiAction.Right = right;
			uiAction.Why = why;
			_barActs.Add(uiAction);
		}

