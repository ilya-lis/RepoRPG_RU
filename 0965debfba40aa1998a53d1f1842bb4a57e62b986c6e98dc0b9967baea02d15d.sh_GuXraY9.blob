					{
						item.Value.Retried = true;
						item.Value.SentAt = unscaledTime;
						(list2 ?? (list2 = new List<int>())).Add(item.Key);
					}
					else
					{
						(list ?? (list = new List<int>())).Add(item.Key);
					}
				}
			}
			if (list2 != null)
			{
				foreach (int item2 in list2)
				{
					Net.Salvage(item2, _pendingSalvage[item2].Uid, _pendingSalvage[item2].Bulk);
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (int item3 in list)
			{
				PendingSalvage pendingSalvage = _pendingSalvage[item3];
				_pendingSalvage.Remove(item3);
				_rowLabels.Remove(pendingSalvage.Uid);
				Toast("Couldn't reach the host - " + pendingSalvage.Name + " not salvaged", Color.gray);
				Plugin.Log.LogWarning((object)$"[net] salvage of {pendingSalvage.Name} (#{item3}) got no answer from the host: nothing changed.");
			}
		}

		public void OnSalvageResult(int id, bool ok, string uid, int scrap, string reason)
		{
			//IL_00f3: Unknown result type (might be due to invalid IL or missing references)
			_pendingSalvage.TryGetValue(id, out PendingSalvage value);
			_pendingSalvage.Remove(id);
			RunSave data = _store.Data;
			GearItem gearItem = data.FindItem(uid);
			_rowLabels.Remove(uid);
			if (!ok)
			{
				if (value != null)
				{
					string text = reason switch
					{
						"equipped" => "unequip it first", 
						"gone" => "the host doesn't have that item (try again in a moment)", 
						"done" => "it was already salvaged", 
						_ => reason, 
					};
					if (reason == "done" && gearItem != null)
					{
						data.inventory.Remove(gearItem);
						_gearRowText.Remove(uid);
						_store.MarkDirty();
					}
					Toast("Couldn't salvage " + value.Name + ": " + text, new Color(1f, 0.4f, 0.35f));
					MenuSound(UiSound.Error);
				}
				return;
			}
			bool flag = gearItem != null && GearX.Has(gearItem, "gear.studious");
			if (gearItem != null)
			{
				NoteBuyback(gearItem, scrap);
			}
			if (gearItem != null)
			{
				Unequip(gearItem);
				ModulesBackToBag(gearItem);
				data.inventory.Remove(gearItem);
				_gearRowText.Remove(uid);
			}
			if (!data.salvaged.Contains(uid))
			{
				data.salvaged.Add(uid);
			}
			if (Plugin.Cfg.SalvageGivesXp.Value && value != null)
			{
				int num = Gear.Rarity(value.Rarity).salvageXp;
				if (CurrentId == "quartermaster")
				{
					num = Mathf.RoundToInt((float)num * (1f + Mathf.Clamp(ClassStat("quartermaster.salvage"), 0f, 100f) / 100f));
				}
				if (flag)
				{
					num *= 2;
				}
				GiveXp(num, null, "salvage");
			}
			if (value != null)
			{
				PartsOnSalvage(value.Rarity);
			}
			Account.Count("salvages");
			_store.MarkDirty();
			_store.SaveNow();
			MenuSound(UiSound.Confirm);
		}

		public static (bool ok, int scrap, string reason) HostSalvage(int actor, string steamId, string uid, bool isLocal, bool bulk)
		{
			RpgRuntime instance = Instance;
			RunSave runSave = ((!isLocal) ? SaveBook.Get(RunInfo.Key, steamId) : instance?._store.Data);
			if (runSave == null || (RunStore.IsTempKey(RunInfo.Key) && !isLocal))
			{
				return (ok: false, scrap: 0, reason: "not verified");
			}
			if (runSave.salvaged.Contains(uid))
			{
				return (ok: false, scrap: 0, reason: "done");
			}
			if (TradeLocked(uid))
			{
				return (ok: false, scrap: 0, reason: "it's in a gear trade right now");
			}
			GearItem gearItem = runSave.FindItem(uid);
			if (gearItem == null)
			{
				return (ok: false, scrap: 0, reason: "gone");
			}
			if (runSave.IsEquipped(gearItem))
			{
				return (ok: false, scrap: 0, reason: "equipped");
			}
			float num = ((!isLocal) ? Scrap.BonusOf(actor) : (instance?.StatValue(Stat.ScrapBonus) ?? 0f));
			if (isLocal)
			{
				if ((Object)(object)instance != (Object)null && instance.CurrentId == "scavenger")
				{
					num += Mathf.Clamp(instance.ClassStat("scavenger.salvage"), 0f, 30f);
				}
			}
			else
			{
				ClassStats.Entry entry = ClassStats.Of(actor);
				if (entry != null && entry.ClassId == "scavenger" && entry.Stats.TryGetValue("scavenger.salvage", out var value))
				{
					num += Mathf.Clamp(value, 0f, 30f);
				}
			}
			int num2 = SalvageCalc.Value(gearItem, num);
			ShopX.HostNoteSalvage(actor, uid, num2);
			runSave.inventory.Remove(gearItem);
			runSave.salvaged.Add(uid);
			if (runSave.salvaged.Count > 400)
			{
				runSave.salvaged.RemoveRange(0, runSave.salvaged.Count - 400);
			}
			string steamId2 = ((steamId == "") ? "local" : steamId);
			double balance = ((num2 > 0) ? SaveBook.AddScrap(RunInfo.Key, steamId2, num2) : Scrap.HostBalance(steamId2));
			if (!isLocal)
			{
				SaveBook.MarkDirty();
			}
			Scrap.Tell(actor, steamId2, balance, num2, bulk ? "Salvaged gear" : ("Salvaged " + gearItem.name));
			Plugin.Log.LogInfo((object)$"Salvage: {ClassClaims.NameOf(actor)} salvaged {Gear.Rarity(gearItem.rarity).name} {gearItem.name} for {num2} {Scrap.Short}.");
			return (ok: true, scrap: num2, reason: "");
		}

		private void OpenSalvageDialog()
		{
			OpenDialog(DialogKind.Salvage, null);
		}

		private string DebugStarterAgain()
		{
			if (Current == null)
			{
				return "pick a class first";
			}
			if (!Starters.GearOn && !Starters.ToolsOn)
			{
				return "starter items are off (Starters/Gear, Starters/Tools)";
			}
			RunSave data = _store.Data;
			for (int num = data.inventory.Count - 1; num >= 0; num--)
			{
				GearItem g = data.inventory[num];
				if (Starters.Is(g))
				{
					if (data.IsEquipped(g))
					{
						Unequip(g);
					}
					data.inventory.RemoveAt(num);
				}
			}
			data.starterFor = "";
			Starters.DebugResetTools();
			EnsureStarterGear();
			_store.MarkDirty();
			if (!Game.InLevel() && !Game.InShopLevel())
			{
				return "Starter reset: the piece comes in the next level or shop";
			}
			if (Starters.Def(Current.id) != null)
			{
				return "Starter piece given; tools spawn in a few seconds (in a level)";
			}
			return "This class has no starter items";
		}

		private void EnsureStarterGear()
		{
			if (!Starters.GearOn || Current == null || (!Game.InLevel() && !Game.InShopLevel()) || RunStore.IsTempKey(RunInfo.Key))
			{
				return;
			}
			RunSave data = _store.Data;
			if (data.starterFor == Current.id)
			{
				return;
			}
			StarterDef starterDef = Starters.Def(Current.id);
			for (int num = data.inventory.Count - 1; num >= 0; num--)
			{
				GearItem gearItem = data.inventory[num];
				if (Starters.Is(gearItem) && !(gearItem.starter == Current.id))
				{
					if (data.IsEquipped(gearItem))
					{
						Unequip(gearItem);
					}
					data.inventory.RemoveAt(num);
				}
			}
			data.starterFor = Current.id;
			_store.MarkDirty();
			if (starterDef == null)
			{
				return;
			}
			foreach (GearItem item in data.inventory)
			{
				if (item.starter == Current.id)
				{
					return;
				}
			}
			GearItem gearItem2 = Starters.Make(starterDef);
			if (gearItem2 != null)
			{
				GiveGear(gearItem2, "class starter");
				int num2 = Plugin.Rpg.SlotIndex(gearItem2.slot);
				if (num2 >= 0 && num2 < data.equipped.Length && string.IsNullOrEmpty(data.equipped[num2]))
				{
					Equip(gearItem2);
				}
				_statsDirty = true;
			}
		}

		public void MarkRunDirty()
		{
			_store.MarkDirty();
		}

		public void OnTeamOffer(object[] d)
		{
			if (d == null || d.Length < 5 || !(d[0] is string text) || !(d[1] is int tcTarget) || !(d[2] is int num))
			{
				return;
			}
			TeamContractDef teamContractDef = TeamContracts.Get(text);
			if (teamContractDef != null)
			{
				if (_tcDef == null || _tcLevel != num || _tcDef.id != text)
				{
					_tcVoted = false;
					_tcRewarded = false;
				}
				_tcDef = teamContractDef;
				_tcTarget = tcTarget;
				_tcLevel = num;
				float num2 = Convert.ToSingle(d[3]);
				_tcBoardVote = num2 < 0f;
				_tcVoteEnd = Time.time + Mathf.Clamp(num2, 0f, 180f);
				_tcScale = Mathf.Clamp(Convert.ToSingle(d[4]), 0.1f, 10f);
				if (_tcState < 0)
				{
					_tcState = 0;
				}
				Notices.Poke();
			}
		}

		public void OnTeamState(object[] d)
		{
			//IL_0286: Unknown result type (might be due to invalid IL or missing references)
			//IL_0270: Unknown result type (might be due to invalid IL or missing references)
			if (d == null || d.Length < 7 || !(d[0] is int num) || !(d[1] is string text))
			{
				return;
			}
			if (_tcDef == null || _tcDef.id != text)
			{
				TeamContractDef teamContractDef = TeamContracts.Get(text);
				if (teamContractDef == null)
				{
					return;
				}
				_tcDef = teamContractDef;
			}
			if (d.Length > 7 && d[7] is int tcLevel)
			{
				_tcLevel = tcLevel;
			}
			int tcState = _tcState;
			_tcState = num;
			NoteTeamResult(tcState, num);
			_tcYes = ((d[2] is int num2) ? num2 : 0);
			_tcVotes = ((d[3] is int num3) ? num3 : 0);
			float num4 = Convert.ToSingle(d[4]);
			_tcBoardVote = num4 < 0f && num == 0;
			_tcVoteEnd = Time.time + Mathf.Clamp(num4, 0f, 180f);
			_tcParticipants = (d[5] as int[]) ?? Array.Empty<int>();
			_tcYesBy = ((d.Length > 8) ? ((d[8] as int[]) ?? Array.Empty<int>()) : Array.Empty<int>());
			_tcNoBy = ((d.Length > 9) ? ((d[9] as int[]) ?? Array.Empty<int>()) : Array.Empty<int>());
			_tcHaul = ((d.Length > 10 && d[10] is float num5) ? num5 : 0f);
			_tcNeed = ((d.Length > 11 && d[11] is float num6) ? num6 : 0f);
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val != (Object)null && (Array.IndexOf(_tcYesBy, Game.ActorNumber(val)) >= 0 || Array.IndexOf(_tcNoBy, Game.ActorNumber(val)) >= 0))
			{
				_tcVoted = true;
			}
			string text2 = (d[6] as string) ?? "";
			if (text2 != "" && tcState != num)
			{
				Notify(PopupKind.Contract, (text2.Length > 80) ? text2.Substring(0, 80) : text2, (Color?)((num == 3) ? new Color(1f, 0.45f, 0.4f) : new Color(1f, 0.8f, 0.35f)), "teamcontract");
			}
			if ((num == 2 || num == 3) && tcState != num)
			{
				ApplyTeamResult(num == 2);
			}
			_contractSig = "";
			Notices.Poke();
		}

		private bool IsTeamParticipant()
		{
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val != (Object)null)
			{
				return Array.IndexOf(_tcParticipants, Game.ActorNumber(val)) >= 0;
			}
			return false;
		}

		private void ApplyTeamResult(bool won)
		{
			//IL_012f: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ee: Unknown result type (might be due to invalid IL or missing references)
			if (_tcDef == null || _tcRewarded || !IsTeamParticipant())
			{
				return;
			}
			_tcRewarded = true;
			TeamContractDef tcDef = _tcDef;
			if (won)
			{
				if (tcDef.gear >= 0)
				{
					GearItem gearItem = Gear.RollExact(new Random(), tcDef.gear, null, allowUnique: false);
					gearItem.freeValue = SalvageCalc.Gross(gearItem);
					GiveGear(gearItem, "team contract");
				}
				if (tcDef.attr > 0)
				{
					_store.Data.bonusAttributePoints += tcDef.attr;
					Notify(PopupKind.Level, $"+{tcDef.attr} attribute point (team contract)");
				}
				AddParts(TeamContracts.ScaledParts(tcDef, _tcScale), "team contract");
				Banner("TEAM CONTRACT COMPLETE: " + tcDef.name.ToUpperInvariant(), new Color(0.55f, 1f, 0.55f), 5f);
				Account.Count("teamwins");
			}
			else
			{
				Banner("TEAM CONTRACT FAILED: " + tcDef.name.ToUpperInvariant(), new Color(1f, 0.45f, 0.4f), 5f);
			}
			string text = ContractBoard.TeamGiver(tcDef.id);
			if (text != "")
			{
				ChangeRep(text, won ? ContractBoard.TierRep[1] : (-1), "team contract " + tcDef.name);
			}
			_statsDirty = true;
			_store.MarkDirty();
		}

		public void OnCurse(string curse, int level)
		{
			//IL_007b: Unknown result type (might be due to invalid IL or missing references)
			TeamContracts.SetCurse(curse, level);
			RunSave runSave = _store?.Data;
			if (runSave != null && curse != "" && !Game.IsMaster())
			{
				runSave.curse = curse;
				runSave.curseLevel = level;
			}
			if (curse != "" && level == RunInfo.LevelIndex)
			{
				Notify(PopupKind.Other, "Cursed this level: " + curse + " - " + TeamContracts.CurseDesc(curse), (Color?)new Color(1f, 0.45f, 0.4f), "curse");
			}
			_contractSig = "";
		}

		private void TeamContractLevelReset()
		{
			if (_tcDef != null && _tcLevel == RunInfo.LevelIndex && _tcState >= 0)
			{
				_tcHoldStart = -1f;
				return;
			}
			_tcDef = null;
			_tcState = -1;
			_tcVoted = false;
			_tcRewarded = false;
			_tcParticipants = Array.Empty<int>();
			_tcHoldStart = -1f;
		}

		private string TeamVoters()
		{
			List<string> list = new List<string>();
			if (_tcState == 0)
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if (!((Object)(object)item == (Object)null))
					{
						int num = Game.ActorNumber(item);
						if (Array.IndexOf(_tcYesBy, num) < 0 && Array.IndexOf(_tcNoBy, num) < 0)
						{
							list.Add(ClassClaims.NameOf(num));
						}
					}
				}
			}
			List<string> list2 = new List<string>();
			if (_tcYesBy.Length != 0)
			{
				list2.Add("<color=#73ff66>Accept:</color> " + Names(_tcYesBy));
			}
			if (_tcNoBy.Length != 0)
			{
				list2.Add("<color=#ff7a6b>Decline:</color> " + Names(_tcNoBy));
			}
			if (list.Count > 0)
			{
				list2.Add("<color=#ffd75a>Waiting:</color> " + string.Join(", ", list));
			}
			return string.Join("   ", list2);
			static string Names(int[] a)
			{
				List<string> list3 = new List<string>();
				foreach (int actor in a)
				{
					list3.Add(ClassClaims.NameOf(actor));
				}
				return string.Join(", ", list3);
			}
		}

		private string TeamVoteCount()
		{
			int num = Mathf.Max(1, Game.Players().Count);
			int num2 = _tcNoBy.Length;
			int num3 = ((_tcYesBy.Length != 0 || num2 > 0) ? _tcYesBy.Length : _tcYes);
			return $"Accept {num3} · Decline {num2} · Waiting {Mathf.Max(0, num - num3 - num2)} (of {num})";
		}

		private string TeamHaulLine()
		{
			if (_tcDef == null || !(_tcDef.id == "big_haul") || !(_tcNeed > 0f))
			{
				return "";
			}
			return $"Hauled ${_tcHaul:N0} / ${_tcNeed:N0} ({_tcTarget}% of the level's goal)";
		}

		private static string VoteRuleText()
		{
			return Plugin.Cfg.TeamVoteMode.Value switch
			{
				TeamVote.Host => "the host decides", 
				TeamVote.Unanimous => "everyone must accept", 
				_ => "majority decides", 
			};
		}

		private void VoteTeam(bool accept)
		{
			//IL_0071: Unknown result type (might be due to invalid IL or missing references)
			//IL_005b: Unknown result type (might be due to invalid IL or missing references)
			if (TeamVoting && !_tcVoted)
			{
				_tcVoted = true;
				Notices.ActedOn("team");
				Net.SendTeamVote(accept);
				Toast(accept ? ("You voted to accept " + _tcDef.name) : ("You voted to decline " + _tcDef.name), (Color)(accept ? new Color(0.55f, 1f, 0.55f) : Color.gray), 2.5f);
			}
		}

		private void TickTeamVoteHold(PlayerAvatar local)
		{
			//IL_004d: Unknown result type (might be due to invalid IL or missing references)
			if (!TeamVoting || _tcVoted || _menuOpen || !Game.IsAlive(local) || ChatOpen.Value())
			{
				_tcHoldStart = -1f;
				return;
			}
			if (!_held.Contains(Plugin.Cfg.CallOutKey.Value) && (!Pad.Connected || !Pad.ChordHeld(Plugin.Cfg.PadCallOutButton.Value)))
			{
				_tcHoldStart = -1f;
				return;
			}
			if (_tcHoldStart < 0f)
			{
				_tcHoldStart = Time.unscaledTime;
			}
			if (Time.unscaledTime - _tcHoldStart >= 1f)
			{
				_tcHoldStart = -1f;
				VoteTeam(accept: true);
			}
		}

