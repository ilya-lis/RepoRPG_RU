		private float TryRestore(ValuableObject v, float want, int by = 0, float extraPct = 0f)
		{
			if ((Object)(object)v == (Object)null || want <= 0f)
			{
				return 0f;
			}
			ValueBook valueBook = Book((Component)(object)v);
			float num = Mathf.Clamp(Plugin.Cfg.RestorerMaxPercent.Value + extraPct, 0f, 100f) / 100f * valueBook.Lost - valueBook.Restored;
			num = Mathf.Min(num, valueBook.Lost - valueBook.Insured - valueBook.Restored);
			float num2 = Game.Get(v, "dollarValueCurrent", 0f);
			float num3 = Game.Get(v, "dollarValueOriginal", num2);
			num = Mathf.Min(num, num3 - num2);
			float num4 = Mathf.Min(want, num);
			if (num4 < 1f)
			{
				return 0f;
			}
			valueBook.Restored += num4;
			TeamPlay.HostAdd(by, TeamPlay.Ev.Restored, num4);
			ContractHost.ClsEv(by, "restorer", num4);
			Game.SetValuableValue(v, num2 + num4);
			return num4;
		}

