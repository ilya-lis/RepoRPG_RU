				}
			}
			object? obj3 = AccessTools.Field(type2, "SoundMasterGroup")?.GetValue(obj);
			return (AudioMixerGroup?)((obj3 is AudioMixerGroup) ? obj3 : null);
		}

		public static void Shutdown()
