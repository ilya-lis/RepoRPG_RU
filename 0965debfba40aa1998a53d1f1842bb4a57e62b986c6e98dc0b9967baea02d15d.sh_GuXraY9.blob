		private string EvolveLine(RunSave run, PerkDef p)
		{
			if (!Perks.EvolveOn)
			{
				return "<color=#9a9ca0>Evolves (turned off by the host)</color>";
			}
			if (run.evolved.Contains(p.id))
			{
				return "<color=#ffd75a>Evolved: " + p.evolveDesc + "</color>";
			}
			string text = (run.perks.Contains(p.id) ? $" ({Perks.Progress(run, p.id):N0}/{p.evolveTarget:N0})" : "");
			return "<color=#ffb21e>Evolves into " + p.evolveName + ":</color> <color=#9a9ca0>" + p.evolveHow + text + " – " + p.evolveDesc + "</color>";
		}

		private static Popup[] CreatePool()
		{
			Popup[] array = new Popup[8];
			for (int i = 0; i < 8; i++)
			{
				array[i] = new Popup();
			}
			return array;
		}

		private static bool KindEnabled(PopupKind k)
		{
			ModConfig cfg = Plugin.Cfg;
			if (!cfg.PopupsEnabled.Value)
			{
				return false;
			}
			return k switch
			{
				PopupKind.Xp => cfg.PopupXp.Value, 
				PopupKind.Level => cfg.PopupLevel.Value, 
				PopupKind.Loot => cfg.PopupLoot.Value, 
				PopupKind.Contract => cfg.PopupContracts.Value, 
				PopupKind.Perk => cfg.PopupPerks.Value, 
				PopupKind.Currency => cfg.PopupCurrency.Value, 
				_ => cfg.PopupOther.Value, 
			};
		}

		private static Color KindColor(PopupKind k)
		{
			//IL_0031: Unknown result type (might be due to invalid IL or missing references)
			//IL_002b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0025: Unknown result type (might be due to invalid IL or missing references)
			//IL_001f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0019: Unknown result type (might be due to invalid IL or missing references)
			//IL_0013: Unknown result type (might be due to invalid IL or missing references)
			return (Color)(k switch
			{
				PopupKind.Currency => Scrap.Color, 
				PopupKind.Perk => PopPerk, 
				PopupKind.Contract => PopContract, 
				PopupKind.Level => PopLevel, 
				PopupKind.Xp => PopXp, 
				_ => PopOther, 
			});
		}

		private static (string one, string many) XpLabel(string reason)
		{
			switch (reason)
			{
			case "kill":
				return (one: "Monster killed", many: "Monsters killed");
			case "revive":
				return (one: "Revived teammate", many: "Revived teammates");
			case "extraction":
				return (one: "Extraction complete", many: "Extractions complete");
			case "level complete":
				return (one: "Level complete", many: "Level complete");
			case "contract":
				return (one: "Contract reward", many: "Contract rewards");
			case "salvage":
				return (one: "Salvaged gear", many: "Salvaged gear");
			case "upgrade":
				return (one: "Shop upgrade used", many: "Shop upgrades used");
			case "debug":
				return (one: "Debug", many: "Debug");
			default:
				if (reason.EndsWith(" kill"))
				{
					string text = reason.Substring(0, reason.Length - 5);
					return (one: text + " killed", many: text + "s killed");
				}
				return (one: Capital(reason), many: Capital(reason));
			}
		}

		private static string Capital(string s)
		{
			if (!string.IsNullOrEmpty(s))
			{
				return char.ToUpperInvariant(s[0]) + s.Substring(1);
			}
			return s;
		}

		private void PopupXpGain(int amount, string reason)
		{
			//IL_0027: Unknown result type (might be due to invalid IL or missing references)
			_xpPulseUntil = Time.unscaledTime + 0.6f;
			if (KindEnabled(PopupKind.Xp))
			{
				Popup popup = Merge("xp:" + reason, PopupKind.Xp, PopXp);
				popup.Amount += amount;
				(string one, string many) tuple = XpLabel(reason);
				string item = tuple.one;
				string item2 = tuple.many;
				popup.Text = ((popup.Count > 1) ? $"+{popup.Amount} XP – {item2} (x{popup.Count})" : $"+{popup.Amount} XP – {item}");
			}
		}

		public void PopupScrap(double amount, string reason)
		{
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			if (KindEnabled(PopupKind.Currency))
			{
				Popup popup = Merge("scrap:" + reason, PopupKind.Currency, Scrap.Color);
				if (popup.Count == 1)
				{
					popup.Total = 0.0;
				}
