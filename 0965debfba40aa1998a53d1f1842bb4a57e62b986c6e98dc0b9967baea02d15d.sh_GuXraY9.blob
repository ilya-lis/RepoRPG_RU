		private void TickResearchC(PlayerAvatar? local)
		{
			float unscaledTime = Time.unscaledTime;
			if (!(unscaledTime < _crewNextTick))
			{
				_crewNextTick = unscaledTime + 1f;
				if (Game.IsMaster())
				{
					PatchGuard.Run("research crew", ResearchCrew.HostCheck);
					PatchGuard.Run("gear trade", HostTradeTick);
				}
				if (_tradeState != 0 && unscaledTime > _tradeUntil + 10f)
				{
					ClearTrade();
				}
			}
		}

		private void ResearchLevelStartClientC()
		{
			ClearTrade();
		}

		private float ResearchXpMultC()
		{
			float num = 1f;
			if (RunShape.Has("quick_study"))
			{
				num *= 1.1f;
			}
			if (ResearchCrew.HasDrill("study_hall"))
			{
				num *= 1.06f;
			}
			string currentId = CurrentId;
			if (currentId == "physicist" || currentId == "appraiser")
			{
				PlayerAvatar val = Game.LocalPlayer();
				if ((Object)(object)val != (Object)null && Synergies.Has(val, "study_group"))
				{
					num *= 1f + Mathf.Clamp(Synergies.V("study_group"), 0f, 30f) / 100f;
				}
			}
			return num;
		}

		private float ResearchDamageMultC(PlayerAvatar me, string c)
		{
			//IL_0067: Unknown result type (might be due to invalid IL or missing references)
			//IL_006c: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a2: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a7: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a8: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ad: Unknown result type (might be due to invalid IL or missing references)
			float num = 1f;
			if ((c == "warden" || c == "juggernaut") && Synergies.Has(me, "iron_wall"))
			{
				num *= 1f - Mathf.Clamp(Synergies.V("iron_wall"), 0f, 20f) / 100f;
			}
			if (ResearchCrew.HasDrill("tight_formation"))
			{
				Vector3 position = ((Component)me).transform.position;
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item != (Object)null && (Object)(object)item != (Object)(object)me && Game.IsAlive(item))
					{
						Vector3 val = ((Component)item).transform.position - position;
						if (((Vector3)(ref val)).sqrMagnitude <= 64f)
						{
							num *= 0.94f;
							break;
						}
					}
				}
			}
			return num;
		}

		private float ResearchCooldownMultC(string cls)
		{
			float num = 1f;
			if (cls == "medic" || cls == "scout")
			{
				PlayerAvatar val = Game.LocalPlayer();
				if ((Object)(object)val != (Object)null && Synergies.Has(val, "quick_patch"))
				{
					num *= 1f - Mathf.Clamp(Synergies.V("quick_patch"), 0f, 30f) / 100f;
				}
			}
			if (ResearchCrew.HasDrill("quick_draw"))
			{
				num *= 0.94f;
			}
			return num;
		}

