			}
			float num = 1f;
			float num2 = CartGuard(val);
			if (num2 > 0f)
			{
				num *= 1f - num2 / 100f;
			}
			if (val.playerGrabbing != null)
			{
				foreach (PhysGrabber item in val.playerGrabbing)
				{
