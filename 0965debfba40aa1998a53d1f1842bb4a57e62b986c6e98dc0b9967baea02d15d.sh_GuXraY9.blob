		private static string LobbyWord()
		{
			if (Plugin.Cfg.ResearchLobby.Value != ResearchLobbyRule.Anyone)
			{
				return "Lobby-wide (host decides)";
			}
			return "Lobby-wide (anyone's counts)";
		}

		private static string ScopeLobbyText()
		{
			return "Works for everyone in the lobby once the host has it" + ((Plugin.Cfg.ResearchLobby.Value == ResearchLobbyRule.Anyone) ? " (in this lobby: once anyone has it)." : ". Your own counts when you host.");
		}

		private DetailInfo ResearchDetail()
		{
			DetailInfo resDetail = _resDetail;
			ResearchDef d = Research.Def(_resSel);
			if (d == null)
			{
				if (resDetail.Name != "" || resDetail.EmptyTitle == "")
				{
					resDetail.Begin("");
					resDetail.EmptyTitle = "Select a project";
					resDetail.EmptyText = "What it unlocks, what it costs and what it needs show here.";
				}
				_resDetailSig = int.MinValue;
				return resDetail;
			}
			Research.St st = Research.StateOf(d);
			string why;
			bool flag = Research.CanStart(d, out why);
			ResearchSave mine = Research.Mine;
			HashCode hashCode = default(HashCode);
			hashCode.Add(d.id);
			hashCode.Add((int)st);
			hashCode.Add(flag);
			hashCode.Add(why);
			hashCode.Add(Mathf.FloorToInt(mine.data));
			hashCode.Add(Research.Slots);
			hashCode.Add(mine.active.Count);
			foreach (ResearchActive item in mine.active)
			{
				hashCode.Add(item.id);
				hashCode.Add(item.progress);
			}
			hashCode.Add(Research.Lobby(d.id));
			hashCode.Add(_layoutVersion);
			int num = hashCode.ToHashCode();
			if (num == _resDetailSig && resDetail.Name != "")
			{
				return resDetail;
			}
			_resDetailSig = num;
			resDetail.Begin(num.ToString());
			bool flag2 = d.scope == "lobby";
			resDetail.Type = $"{Research.BranchName(d.branch)} · Tier {d.tier} · " + (flag2 ? LobbyWord() : "Personal");
			resDetail.Name = d.name;
			switch (st)
			{
			case Research.St.Done:
				resDetail.Status.Add((UiStatus.Maxed, "Done"));
				break;
			case Research.St.Active:
			{
				string text = "";
				foreach (ResearchActive item2 in mine.active)
				{
					if (item2.id == d.id)
					{
						text = $" {item2.progress}/{item2.need}";
					}
				}
				resDetail.Status.Add((UiStatus.Pending, "In progress" + text));
				break;
			}
			case Research.St.InDev:
				resDetail.Status.Add((UiStatus.InDev, ""));
				break;
			case Research.St.Locked:
				resDetail.Status.Add((UiStatus.Locked, ""));
				break;
			default:
				resDetail.Status.Add(flag ? (UiStatus.Available, "") : (UiStatus.Locked, "Can't start yet"));
				break;
			}
			resDetail.Status.Add((UiStatus.Selected, flag2 ? "Lobby-wide" : "Personal"));
			if (st == Research.St.Done)
			{
				resDetail.Now = d.unlock + ((flag2 && Research.Lobby(d.id)) ? "\n<color=#9a9ca0>Active in this lobby.</color>" : "");
			}
			else
			{
				resDetail.Now = "Not researched yet.";
				resDetail.NextNote = d.unlock;
			}
			Research.Unlocked(d, out string needs);
			string text2 = ((st == Research.St.Locked && needs != "") ? ("Requires " + needs + ".\n") : "");
			string text3 = $"{Research.Cost(d)} Data (you have {Mathf.FloorToInt(mine.data)}) · takes {Research.Levels(d)} levels cleared, in any run";
			Research.St st2 = st;
			string text4;
			if (st2 != Research.St.Available)
			{
				if (st2 != Research.St.InDev)
				{
					goto IL_0472;
				}
				text4 = "\n<color=#ffd75a>Coming in a later update.</color>";
			}
			else
			{
				if (flag || !(why != ""))
				{
					goto IL_0472;
				}
				text4 = "\n<color=#ff9a8a>" + why + "</color>";
			}
			goto IL_0479;
			IL_0472:
			text4 = "";
			goto IL_0479;
			IL_0479:
			string text5 = text4;
			resDetail.Needs = ((st == Research.St.Done) ? "" : (text2 + text3 + text5));
			switch (st)
			{
			case Research.St.Active:
				resDetail.Act("Cancel (half back)", BtnKind.Danger, enabled: true, delegate
				{
					AskCancelResearch(d);
				});
				break;
			default:
				resDetail.Act("Start research", BtnKind.Primary, flag, delegate
				{
					AskStartResearch(d);
				}, why);
				break;
			case Research.St.Done:
			case Research.St.InDev:
				break;
			}
			return resDetail;
		}

		private void AskStartResearch(ResearchDef d)
		{
			AskConfirm("START " + d.name.ToUpperInvariant() + "?", $"{d.unlock}\n\nCosts {Research.Cost(d)} Data now ({Mathf.FloorToInt(Research.Mine.data)} available) and finishes after {Research.Levels(d)} levels cleared, in any run.", "Start", delegate
			{
				//IL_0028: Unknown result type (might be due to invalid IL or missing references)
				if (Research.Start(d))
				{
					Toast("Researching " + d.name, ResTeal);
					MenuSound(UiSound.Confirm);
				}
				else
				{
					MenuSound(UiSound.Error);
				}
			});
		}

		private void AskCancelResearch(ResearchDef d)
		{
			AskConfirm("CANCEL " + d.name.ToUpperInvariant() + "?", $"You get {Research.Cost(d) / 2} Data back and its progress is lost.", "Cancel it", delegate
			{
				Research.Cancel(d.id);
				MenuSound(UiSound.Back);
			});
		}

		public void OnHaggled(string key, float mult)
		{
			//IL_000e: Unknown result type (might be due to invalid IL or missing references)
			//IL_00dc: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c6: Unknown result type (might be due to invalid IL or missing references)
			if (mult <= 0f)
			{
				Toast("You've already haggled this visit", Color.gray);
				MenuSound(UiSound.Error);
				return;
			}
			_haggled[key] = mult;
			foreach (ShopEntry item in _store.Data.shopStock)
			{
				if (item.key == key && !item.sold)
				{
					item.price = Mathf.Max(1, Mathf.RoundToInt((float)item.price * mult));
				}
			}
			Toast((mult < 1f) ? "Haggled: 25% off!" : "Haggling backfired: 10% more", (mult < 1f) ? new Color(0.45f, 1f, 0.5f) : new Color(1f, 0.6f, 0.5f));
			MenuSound((mult < 1f) ? UiSound.Confirm : UiSound.Error);
		}

		private float HaggleMult(string key)
		{
			if (_haggleLevel != RunInfo.LevelIndex)
			{
				_haggleLevel = RunInfo.LevelIndex;
				_haggled.Clear();
			}
			if (!_haggled.TryGetValue(key, out var value))
			{
				return 1f;
			}
			return value;
		}

