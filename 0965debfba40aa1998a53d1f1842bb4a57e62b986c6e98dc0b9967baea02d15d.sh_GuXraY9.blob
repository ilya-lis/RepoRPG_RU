		private void BossReward(EnemyHealth eh)
		{
			//IL_017b: Unknown result type (might be due to invalid IL or missing references)
			//IL_01aa: Unknown result type (might be due to invalid IL or missing references)
			//IL_01af: Unknown result type (might be due to invalid IL or missing references)
			//IL_01b4: Unknown result type (might be due to invalid IL or missing references)
			//IL_01cd: Unknown result type (might be due to invalid IL or missing references)
			//IL_01e2: Unknown result type (might be due to invalid IL or missing references)
			//IL_0200: Unknown result type (might be due to invalid IL or missing references)
			if (_bossRewarded.Add(RunInfo.Key + ":" + RunInfo.LevelIndex + ":" + Elites.ViewId((Component)(object)eh)))
			{
				if (_bossRewarded.Count > 200)
				{
					_bossRewarded.Clear();
				}
				Random random = new Random();
				bool flag = RunShape.IsMilestoneLevel(RunInfo.LevelIndex) || random.NextDouble() * 100.0 < (double)Plugin.Cfg.BossLegendaryChance.Value;
				bool allowUnique = flag && (Season.IsFinaleLevel(RunInfo.LevelIndex) || random.NextDouble() * 100.0 < (double)Plugin.Cfg.BossUniqueChance.Value);
				GearItem gearItem = Gear.RollExact(random, flag ? Gear.MaxRarity : Mathf.Max(0, Gear.MaxRarity - 1), null, allowUnique);
				if (random.NextDouble() < 0.5)
				{
					GearSets.MakeSetPiece(gearItem, random);
				}
				gearItem.freeValue = SalvageCalc.Gross(gearItem);
				GiveGear(gearItem, "boss");
				RollModuleDrop(100f, "boss");
				Account.Count("bosses");
				string text = Bosses.NameFor(Elites.ViewId((Component)(object)eh));
				Banner(text.ToUpperInvariant() + " IS DOWN!", new Color(1f, 0.85f, 0.35f), 5f);
				AddWorldMark("boss:" + Elites.ViewId((Component)(object)eh), ((Component)eh).transform.position + Vector3.up, "BOSS DOWN", new Color(1f, 0.85f, 0.35f), 15f);
				ClassFx.Show(((Component)eh).transform.position, 2f, 15f, new Color(1f, 0.85f, 0.35f), 1f);
			}
		}

