		private void RebuildAll(RunSave run, List<List<string>> sets)
		{
			(int, int, int, int, int, int, string) tuple = (run.perks.Count, run.banished.Count, _perkRarityF, _perkTagF, _perkOwnF, Account.Data.seenPerks.Count, _perkQuery);
			(int, int, int, int, int, int, string) tuple2 = tuple;
			(int, int, int, int, int, int, string) allKey = _allKey;
			if (tuple2.Item1 == allKey.Item1 && tuple2.Item2 == allKey.Item2 && tuple2.Item3 == allKey.Item3 && tuple2.Item4 == allKey.Item4 && tuple2.Item5 == allKey.Item5 && tuple2.Item6 == allKey.Item6 && tuple2.Item7 == allKey.Item7)
			{
				return;
			}
			_allKey = tuple;
			_allList.Clear();
			string text = _perkQuery.Trim().ToLowerInvariant();
			PerkDef[] perks = Plugin.Rpg.perks;
			foreach (PerkDef perkDef in perks)
			{
				bool flag = run.perks.Contains(perkDef.id);
				bool flag2 = run.banished.Contains(perkDef.id);
				if ((_perkRarityF < 0 || _perkRarityF > 3 || (!perkDef.cursed && perkDef.rarity == _perkRarityF)) && (_perkRarityF != 4 || perkDef.cursed) && (_perkTagF < 0 || Perks.HasTag(perkDef, Perks.TagNames[_perkTagF])) && (_perkOwnF != 1 || flag) && !(_perkOwnF == 2 && flag) && (_perkOwnF != 3 || flag2) && (!(text != "") || (IsSilhouette(run, perkDef) ? "legendary" : (perkDef.name + " " + perkDef.desc + " " + string.Join(" ", perkDef.tags) + " " + Perks.LabelOf(perkDef)).ToLowerInvariant()).Contains(text)))
				{
					_allList.Add(perkDef);
				}
			}
			_allList.Sort((PerkDef a, PerkDef b) => (Rank(a) == Rank(b)) ? ((a.rarity == b.rarity) ? string.CompareOrdinal(a.name, b.name) : b.rarity.CompareTo(a.rarity)) : Rank(a).CompareTo(Rank(b)));
			int Rank(PerkDef p)
			{
				if (!run.perks.Contains(p.id))
				{
					if (!sets.Exists((List<string> st) => st.Contains(p.id)))
					{
						if (!run.banished.Contains(p.id))
						{
							return 2;
						}
						return 3;
					}
					return 1;
				}
				return 0;
			}
		}

		private static bool IsSilhouette(RunSave run, PerkDef p)
		{
			if (p.rarity >= 3 && !p.cursed && !run.perks.Contains(p.id))
			{
				return !Account.SeenPerk(p.id);
			}
			return false;
		}

