		private (string name, string line, Color col) EntryLook(ShopEntry e)
		{
			//IL_0098: Unknown result type (might be due to invalid IL or missing references)
			//IL_00fb: Unknown result type (might be due to invalid IL or missing references)
			//IL_014c: Unknown result type (might be due to invalid IL or missing references)
			if (e.kind == "gear" && e.item != null)
			{
				GearBehaviorDef gearBehaviorDef = GearX.Behavior(e.item.behavior);
				string item = ((e.item.unique != "") ? e.item.uniqueDesc : ((gearBehaviorDef != null) ? (gearBehaviorDef.name + ": " + gearBehaviorDef.desc) : string.Join(" · ", Lines(e.item))));
				return (name: e.item.name, line: item, col: RarityCol(e.item));
			}
			if (e.kind == "module")
			{
				GearModuleDef gearModuleDef = GearX.Module(e.id);
				return (name: gearModuleDef?.name ?? e.id, line: (gearModuleDef != null) ? FxLine(gearModuleDef.effects) : "", col: new Color(0.5f, 0.85f, 1f));
			}
			ConsumableDef consumableDef = ShopX.Cons(e.id);
			return (name: consumableDef?.name ?? e.id, line: consumableDef?.desc ?? "", col: new Color(0.75f, 1f, 0.6f));
		}

		private string PriceText(int basePrice)
		{
			int num = Shop.Price(basePrice);
			if (num >= basePrice)
			{
				return "<b>" + Scrap.Price(num) + "</b>";
			}
			return $"<b>{Scrap.Price(num)}</b> <color=#9a9ca0>(was {basePrice})</color>";
		}

