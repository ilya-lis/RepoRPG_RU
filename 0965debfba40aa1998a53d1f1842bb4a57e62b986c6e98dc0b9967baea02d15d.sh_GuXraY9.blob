						obj = null;
					}
					else
					{
						BepInPlugin metadata = value.Metadata;
						obj = ((metadata != null) ? metadata.Name : null);
					}
					string text = (key + " " + (string?)obj).ToLowerInvariant().Replace(" ", "").Replace("_", "");
					if (text.Contains("sharedupgradesplus"))
					{
						SharedUpgradesPlus = true;
					}
					else if (text.Contains("sharedupgradesfix"))
					{
						SharedUpgradesFix = true;
					}
					if (text.Contains("bulletbot.moreupgrades") || (text.Contains("moreupgrades") && !text.Contains("fix")))
					{
						MoreUpgrades = true;
						object cfg;
						if (value == null)
						{
							cfg = null;
						}
						else
						{
							BaseUnityPlugin instance = value.Instance;
							cfg = ((instance != null) ? instance.Config : null);
						}
						ReadMoreUpgradesSharing((ConfigFile?)cfg);
					}
					if (text.Contains("latejoin") || text == "nilaier.late")
					{
						LateJoinMod = true;
					}
					if (text.Contains("cartfix"))
					{
						CartFix = true;
					}
					if (text.Contains("cartspeedsync"))
					{
						CartSpeedSync = true;
					}
					if (text.Contains("morerevivehp"))
					{
						MoreReviveHP = true;
						object obj2;
						if (value == null)
						{
							obj2 = null;
						}
						else
						{
							BaseUnityPlugin instance2 = value.Instance;
							obj2 = ((instance2 != null) ? instance2.Config : null);
						}
						ConfigFile val = (ConfigFile)obj2;
						if (val != null)
						{
							foreach (ConfigDefinition key2 in val.Keys)
							{
								if (key2.Key == "ExtraHealth")
								{
									_moreReviveExtra = val[key2];
									break;
								}
							}
						}
					}
					if (text.Contains("showenemyhealth"))
					{
						ShowEnemyHealth = true;
					}
					if (text.Contains("mutators"))
					{
						Mutators = true;
					}
					if (text.Contains("fragilevaluables"))
					{
						FragileValuables = true;
					}
					if (text.Contains("keybindlib"))
					{
						KeybindLib = true;
					}
					if (text.Contains("modulesize") || text.Contains("customlevelsize"))
					{
						CustomLevelSizes = true;
					}
					if (text.Contains("interestinglevels"))
					{
						InterestingLevels = true;
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogInfo((object)("[compat] couldn't read the plugin list: " + ex.Message));
			}
			List<string> list = new List<string>();
			if (UpgradeSharingMod)
			{
				list.Add("upgrade sharing by " + (SharedUpgradesPlus ? "SharedUpgradesPlus" : "") + ((SharedUpgradesPlus && SharedUpgradesFix) ? " + " : "") + (SharedUpgradesFix ? "SharedUpgradesFix" : "") + " (RepoRPG only logs extra levels)");
			}
			if (MoreUpgradesTeamShared.Count > 0)
			{
				list.Add("MoreUpgrades team options on for " + string.Join(", ", MoreUpgradesTeamShared));
			}
			if (LateJoinMod)
			{
				list.Add("late join by another mod (RepoRPG catches joiners up)");
			}
			if (CartSpeedSync)
			{
				list.Add("CartSpeedSync (Teamster boost applied after its sync)");
			}
			if (CartFix)
			{
				list.Add("CartFix (cart mass left to it)");
			}
			if (MoreReviveHP)
			{
				list.Add($"MoreReviveHP (+{MoreReviveExtra} HP counted in the Medic's revive cap)");
			}
			if (ShowEnemyHealth)
			{
				list.Add("ShowEnemyHealth (threat labels raised above its numbers)");
			}
			if (Mutators)
			{
				list.Add($"Mutators (on mutator levels: {Plugin.Cfg.WithMutators.Value})");
			}
			if (FragileValuables)
			{
				list.Add("FragileValuables (RepoRPG's Fragile Goods modifier skipped)");
			}
			if (KeybindLib)
			{
				list.Add("KeybindLib (its keys are checked for clashes)");
			}
			if (CustomLevelSizes || InterestingLevels)
			{
				list.Add("custom level layouts (spawn points keep the game's own as fallback)");
			}
			Plugin.Log.LogInfo((object)((list.Count > 0) ? ("[compat] modes: " + string.Join("; ", list) + ".") : "[compat] no mods that need a compatibility mode."));
		}

		private static void ReadMoreUpgradesSharing(ConfigFile? cfg)
		{
			if (cfg == null)
			{
				return;
			}
			try
			{
				bool flag = default(bool);
				foreach (ConfigDefinition key in cfg.Keys)
				{
					int num;
					if (key.Key == "Allow Team Upgrades" || key.Key == "Sync Host Upgrades")
					{
						object boxedValue = cfg[key].BoxedValue;
						if (boxedValue is bool)
						{
							flag = (bool)boxedValue;
							num = 1;
						}
						else
						{
							num = 0;
						}
					}
					else
					{
						num = 0;
					}
					if (((uint)num & (flag ? 1u : 0u)) != 0 && !MoreUpgradesTeamShared.Contains(key.Section))
					{
						MoreUpgradesTeamShared.Add(key.Section);
					}
				}
			}
			catch
			{
			}
		}

		public static string ActiveMutator()
		{
			if (!Mutators)
			{
				return "";
			}
			try
			{
				if (!_mmLooked)
				{
					_mmLooked = true;
					Type type = AccessTools.TypeByName("Mutators.Managers.MutatorManager");
					_mmInstance = ((type == null) ? null : AccessTools.Property(type, "Instance"));
					_mmCurrent = ((type == null) ? null : AccessTools.Property(type, "CurrentMutator"));
				}
				object obj = _mmInstance?.GetValue(null);
				object obj2 = ((obj == null) ? null : _mmCurrent?.GetValue(obj));
				if (obj2 == null)
				{
					return "";
				}
				string text = (AccessTools.Property(obj2.GetType(), "NamespacedName")?.GetValue(obj2) as string) ?? "";
				if (text == "" || text.EndsWith(":none", StringComparison.OrdinalIgnoreCase))
				{
					return "";
				}
				return (AccessTools.Property(obj2.GetType(), "Name")?.GetValue(obj2) as string) ?? text;
			}
			catch
			{
				return "";
			}
		}

		public static void CheckKeysOnce()
