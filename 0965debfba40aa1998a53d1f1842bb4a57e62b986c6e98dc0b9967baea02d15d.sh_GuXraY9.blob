		private void TickTeamHealth(List<PlayerAvatar> players, float now)
		{
			if (now < _teamHealthNext)
			{
				return;
			}
			_teamHealthNext = now + 0.25f;
			int num = 0;
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player != (Object)null)
				{
					num++;
				}
			}
			int[] array = new int[num];
			int[] array2 = new int[num];
			int[] array3 = new int[num];
			int[] array4 = new int[num];
			int num2 = 0;
			int num3 = 17;
			foreach (PlayerAvatar player2 in players)
			{
				if (!((Object)(object)player2 == (Object)null))
				{
					array[num2] = Game.ActorNumber(player2);
					PlayerHealth playerHealth = player2.playerHealth;
					array2[num2] = (((Object)(object)playerHealth != (Object)null) ? Game.Health(playerHealth) : 0);
					array3[num2] = (((Object)(object)playerHealth != (Object)null) ? Game.MaxHealth(playerHealth) : 100);
					array4[num2] = ((!Game.IsAlive(player2)) ? 1 : 0);
					num3 = num3 * 31 + array[num2];
					num3 = num3 * 31 + array2[num2];
					num3 = num3 * 31 + array3[num2];
					num3 = num3 * 31 + array4[num2];
					num2++;
				}
			}
			if (num3 != _teamHealthSig || !(now < _teamHealthFull))
			{
				_teamHealthSig = num3;
				_teamHealthFull = now + 2f;
				Net.SendTeamHealth(array, array2, array3, array4);
			}
		}

		public void OnPlayerLeft(int actor)
		{
			Research.OnPlayerLeft(actor);
			_held.Remove(actor);
			_lastCart.Remove(actor);
			_followOff.Remove(actor);
			ThirdWavePlayerLeft(actor);
		}

