			list.Clear();
			foreach (PlayerAvatar item in held)
			{
				if ((Object)(object)item != (Object)null)
				{
					list.Add(item);
				}
			}
			foreach (PlayerAvatar item2 in list2)
			{
				if ((Object)(object)item2 != (Object)null && !list.Contains(item2))
				{
					list.Add(item2);
				}
			}
			foreach (PlayerAvatar a in list2)
			{
				if ((Object)(object)a == (Object)null)
				{
					continue;
				}
				if (Plugin.Cfg.LateJoinSpawn.Value == JoinSpawn.Host)
				{
					PatchGuard.Run("late join spawn", delegate
					{
						SpawnNearHost(a);
					});
				}
				if ((Object)(object)a.photonView != (Object)null)
				{
					AddToEnemies(a.photonView.ViewID);
				}
				Plugin.Log.LogInfo((object)string.Format("[late join] spawned {0} ({1}).", Game.Get(a, "playerName", "a player"), Plugin.Cfg.LateJoinSpawn.Value));
			}
		}

