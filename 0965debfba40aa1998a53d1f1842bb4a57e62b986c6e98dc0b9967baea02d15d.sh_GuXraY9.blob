		private void ResetClassView()
		{
			_classViewSet = false;
		}

		private void ApplyClassStartView(ClassProgress vp, bool isCurrent)
		{
			if (_classViewSet)
			{
				return;
			}
			_classViewSet = true;
			_classTalents = true;
			switch (Plugin.Cfg.ClassTabStart.Value)
			{
			case ClassTabStartView.Overview:
				_showEffects = true;
				break;
			case ClassTabStartView.TalentsWhenPoints:
				if (isCurrent && (Leveling.AvailablePoints(vp) > 0 || TalentsHavePending))
				{
					_showEffects = false;
				}
				break;
			default:
				_showEffects = false;
				break;
			}
		}

