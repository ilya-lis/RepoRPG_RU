			attrDetailInfo.NextNote = ((_sAfter != "") ? (_sAfter + "\n") : "") + _sNext;
			attrDetailInfo.Needs = ((num5 >= attrFocus.maxPoints) ? "Maxed." : ((CurrentProgress == null) ? "Pick a class first: attribute points come from class levels." : $"1 attribute point per point (you have {avail} to spend)."));
			bool enabled = !busy && avail > 0 && num5 < attrFocus.maxPoints && CurrentProgress != null;
			AttributeDef a = attrFocus;
			attrDetailInfo.Act("+1 point", BtnKind.Secondary, enabled, delegate
			{
				AttrAddPending(a);
			}, (avail <= 0) ? "No attribute points left." : "Maxed.");
			attrDetailInfo.Act("Take one back", BtnKind.Secondary, !busy && num4 > 0, delegate
			{
				AttrRemovePending(a);
			}, "Only points not confirmed yet can be taken back.");
			return attrDetailInfo;
		}

