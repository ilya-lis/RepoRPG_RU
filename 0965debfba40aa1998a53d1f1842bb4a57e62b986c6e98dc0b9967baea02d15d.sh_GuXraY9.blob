		private static readonly Dictionary<string, bool> Now = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);

		private static readonly Dictionary<string, bool> Before = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);

