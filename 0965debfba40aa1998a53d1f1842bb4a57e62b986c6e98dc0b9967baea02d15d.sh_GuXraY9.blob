			if (num <= 0)
			{
				return "Respec";
			}
			return "Respec " + Scrap.Price(num);
		}

		private string PerkFx(PerkDef p)
		{
			if (_perkFx.TryGetValue(p.id, out string value))
			{
				return value;
			}
			List<string> list = new List<string>();
			EffectDef[] effects = p.effects;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex >= 0)
				{
					list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
				}
			}
			value = string.Join(", ", list);
			_perkFx[p.id] = value;
			return value;
		}

