		private static void OnContractMsg(int sender, object data, bool master)
		{
			if (!(data is object[] array) || array.Length < 2)
			{
				return;
			}
			object obj = array[0];
			if (!(obj is byte))
			{
				return;
			}
			switch ((byte)obj)
			{
			case 1:
				if (master && array.Length >= 7 && array[1] is int num3 && array[4] is int tier && array[5] is int level && array[6] is int slots && !NetReliability.Replay(sender, 59, num3, SendTo))
				{
					string text = ContractHost.HostAccept(sender, Cut(array[2], 16), Cut(array[3], 48), tier, level, slots);
					object[] array3 = new object[6]
					{
						(byte)5,
						num3,
						(byte)1,
						text == "",
						0,
						text
					};
					SendTo(59, array3, sender);
					NetReliability.Remember(sender, 59, num3, 59, array3);
				}
				break;
			case 2:
				if (master)
				{
					ContractHost.HostDrop(sender, Cut(array[1], 16));
				}
				break;
			case 3:
				if (master && array[1] is int num4 && !NetReliability.Replay(sender, 59, num4, SendTo))
				{
					(bool ok, int charged, string reason) tuple2 = ContractHost.HostReroll(sender, SenderSteamId(sender, ""));
					bool item4 = tuple2.ok;
					int item5 = tuple2.charged;
					string item6 = tuple2.reason;
					object[] array4 = new object[6]
					{
						(byte)5,
						num4,
						(byte)3,
						item4,
						item5,
						item6
					};
					SendTo(59, array4, sender);
					NetReliability.Remember(sender, 59, num4, 59, array4);
				}
				break;
			case 4:
				if (master && array.Length >= 6 && array[1] is int num2 && array[3] is bool bonus && array[4] is int clientTier && array[5] is int clientKind && !NetReliability.Replay(sender, 59, num2, SendTo))
				{
					(bool ok, int scrap, string reason) tuple = ContractHost.HostClaim(sender, Cut(array[2], 16), bonus, clientTier, clientKind);
					bool item = tuple.ok;
					int item2 = tuple.scrap;
					string item3 = tuple.reason;
					object[] array2 = new object[6]
					{
						(byte)5,
						num2,
						(byte)4,
						item,
						item2,
						item3
					};
					SendTo(59, array2, sender);
					NetReliability.Remember(sender, 59, num2, 59, array2);
				}
				break;
			case 5:
				if (IsFromHost(sender) && array.Length >= 6 && array[1] is int req && array[2] is byte what && array[3] is bool ok && array[4] is int value2)
				{
					RpgRuntime.Instance?.OnContractReply(req, what, ok, value2, Cut(array[5], 40));
				}
				break;
			case 6:
				if (IsFromHost(sender) && array.Length >= 5 && array[2] is float num5 && array[3] is int a && array[4] is int b)
				{
					RpgRuntime.Instance?.OnContractEvent(Cut(array[1], 32), Mathf.Clamp(num5, 0f, 1000000f), a, b);
				}
				break;
			case 7:
				if (IsFromHost(sender) && array.Length >= 5 && array[2] is int result && array[3] is int scrap)
				{
					RpgRuntime.Instance?.OnRivalResult(Cut(array[1], 48), result, scrap, Cut(array[4], 120));
				}
				break;
			case 8:
			{
				if (array.Length >= 3 && array[2] is float num && !(Cut(array[1], 32) != "cls.juggernaut") && (!AssistAt.TryGetValue(sender, out var value) || !(Time.unscaledTime - value < 0.5f)))
				{
					AssistAt[sender] = Time.unscaledTime;
					RpgRuntime.Instance?.OnContractEvent("cls.juggernaut", Mathf.Clamp(num, 0f, 100f), 0, 0);
				}
				break;
			}
			}
		}

