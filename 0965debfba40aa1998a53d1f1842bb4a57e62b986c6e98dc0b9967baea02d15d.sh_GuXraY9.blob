			}
		}

		private static void EnsureSceneHook()
		{
			if (!_sceneHooked)
			{
				_sceneHooked = true;
				SceneManager.sceneLoaded += delegate
				{
					PatchGuard.Run("late join cache", ClearOldViews);
				};
			}
		}

		private static void ClearOldViews()
		{
			List<int> oldViews = _oldViews;
			_oldViews = null;
			if (oldViews == null || !PhotonNetwork.InRoom || !PhotonNetwork.IsMasterClient)
			{
				return;
			}
			foreach (int item in oldViews)
			{
				try
				{
					PhotonNetwork.RemoveBufferedRPCs(item, (string)null, (int[])null);
				}
				catch
				{
				}
			}
			if (Plugin.Cfg.HudDiagnostics.Value)
			{
				Plugin.Log.LogInfo((object)$"[late join] old scene's buffered calls cleared ({oldViews.Count} views).");
			}
		}

		private static IEnumerator ClearRoutine(List<int> insts)
		{
