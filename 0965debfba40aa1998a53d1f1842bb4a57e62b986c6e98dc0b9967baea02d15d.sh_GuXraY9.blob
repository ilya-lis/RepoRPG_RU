		private ElemStatus ElemOf(EnemyHealth eh)
		{
			int instanceID = ((Object)eh).GetInstanceID();
			if (!_elem.TryGetValue(instanceID, out ElemStatus value))
			{
				Dictionary<int, ElemStatus> elem = _elem;
				ElemStatus obj = new ElemStatus
				{
					Eh = eh,
					ViewId = Elites.ViewId((Component)(object)eh)
				};
				value = obj;
				elem[instanceID] = obj;
			}
			return value;
		}

		private static bool ElementalHit(PlayerAvatar attacker, Component col, out bool blast)
		{
			blast = ClassHost.IsExplosion(col);
			PhysGrabber physGrabber = attacker.physGrabber;
			PhysGrabObject val = (((Object)(object)physGrabber != (Object)null && Game.Get(physGrabber, "grabbed", fallback: false)) ? Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null) : null);
			if ((Object)(object)val == (Object)null)
			{
				return false;
			}
			if (!OverclockWeapons.Supported(val, out string _) && !((Object)(object)((Component)val).GetComponent<ItemMelee>() != (Object)null) && !((Object)(object)((Component)val).GetComponentInChildren<ItemMelee>() != (Object)null))
			{
				return false;
			}
			PhysGrabObject componentInParent = col.GetComponentInParent<PhysGrabObject>();
			if (!((Object)(object)componentInParent == (Object)null))
			{
				return (Object)(object)componentInParent == (Object)(object)val;
			}
			return true;
		}

		private void ElementOnHit(PlayerAvatar attacker, EnemyHealth target, HurtCollider col, int dealt)
		{
			if (!Elements.On || (Object)(object)target == (Object)null || dealt <= 0)
			{
				return;
			}
			int e = Elements.Of(attacker);
			if (e == 0)
			{
				return;
			}
			if (!ElementalHit(attacker, (Component)(object)col, out var blast))
			{
				ElemLogOnce(attacker, e, "miss", () => $"[elements] {Game.ActorNumber(attacker)}:{ClassClaims.NameOf(Game.ActorNumber(attacker))} has {Elements.Names[e]} but this hit didn't carry it ({HeldText(attacker)}; hit by {((Object)col).name}).");
				return;
			}
			ApplyElement(target, e, dealt, blast, chained: false);
			ElemLogOnce(attacker, e, "hit", () => "[elements] " + ClassClaims.NameOf(Game.ActorNumber(attacker)) + "'s " + Elements.Names[e] + " (" + Elements.SourceOf(attacker, e) + ") applied " + Elements.Status[e] + " to " + ClassHost.EnemyName((Component)(object)target) + (blast ? " (blast)" : "") + " with " + HeldText(attacker) + ".");
		}

		private void ElemLogOnce(PlayerAvatar p, int e, string kind, Func<string> line)
		{
			if (_elemLogged.Add(RunInfo.LevelIndex + ":" + Game.ActorNumber(p) + ":" + e + ":" + kind))
			{
				if (_elemLogged.Count > 400)
				{
					_elemLogged.Clear();
				}
				Plugin.Log.LogInfo((object)line());
			}
		}

		private static string HeldText(PlayerAvatar p)
		{
			PhysGrabber physGrabber = p.physGrabber;
			PhysGrabObject val = (((Object)(object)physGrabber != (Object)null && Game.Get(physGrabber, "grabbed", fallback: false)) ? Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null) : null);
			if ((Object)(object)val == (Object)null)
			{
				return "holding nothing";
			}
			string what;
			bool flag = OverclockWeapons.Supported(val, out what) || (Object)(object)((Component)val).GetComponentInChildren<ItemMelee>() != (Object)null;
			return "holding " + ((Object)val).name + " (" + (flag ? "supported" : "not a supported weapon") + ")";
		}

		private void ElementsPlayersTick()
		{
			if (!Elements.On)
			{
				if (_elemPlayersSent != "")
				{
					_elemPlayersSent = "";
					Net.SendPlayerElements(Array.Empty<int>(), Array.Empty<byte>());
				}
				return;
			}
			List<int> list = new List<int>();
			List<byte> list2 = new List<byte>();
			StringBuilder stringBuilder = new StringBuilder();
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					int num = Elements.Of(item);
					if (num != 0)
					{
						int num2 = Game.ActorNumber(item);
						list.Add(num2);
						list2.Add((byte)num);
						stringBuilder.Append(ClassClaims.NameOf(num2)).Append(' ').Append(Elements.Names[num])
							.Append(" (")
							.Append(Elements.SourceOf(item, num))
							.Append("); ");
					}
				}
			}
			string text = stringBuilder.ToString();
			if (!(text == _elemPlayersSent))
			{
				_elemPlayersSent = text;
				Plugin.Log.LogInfo((object)("[elements] weapon elements: " + ((text == "") ? "none" : text.TrimEnd(' ', ';'))));
				Net.SendPlayerElements(list.ToArray(), list2.ToArray());
			}
		}

		private void ApplyElement(EnemyHealth eh, int e, int dealt, bool blast, bool chained)
		{
			//IL_0121: Unknown result type (might be due to invalid IL or missing references)
			//IL_031f: Unknown result type (might be due to invalid IL or missing references)
			//IL_032a: Unknown result type (might be due to invalid IL or missing references)
			//IL_032f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0334: Unknown result type (might be due to invalid IL or missing references)
			//IL_0338: Unknown result type (might be due to invalid IL or missing references)
			//IL_02bf: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ca: Unknown result type (might be due to invalid IL or missing references)
			//IL_02cf: Unknown result type (might be due to invalid IL or missing references)
			//IL_02d4: Unknown result type (might be due to invalid IL or missing references)
			float now = Time.time;
			float strength = Elements.Strength;
			ElemStatus elemStatus = ElemOf(eh);
			Elites.Info info;
			bool flag = Elites.TryGet(eh, out info) && info.Tier >= 3;
			Elites.Info info2;
			(int resist, int weak) tuple = Elements.Affinity(elemStatus.ViewId, Elites.TryGet(eh, out info2) ? info2.Tier : 0);
			int item = tuple.resist;
			int item2 = tuple.weak;
			float num = ((item == e) ? 0.5f : ((item2 == e) ? 2f : 1f));
			int num2 = Mathf.Max(1, Mathf.RoundToInt((float)((!(num >= 2f)) ? 1 : 2)));
			if (num < 1f && Random.value < 0.5f)
			{
				num2 = 0;
			}
			float num3 = (flag ? 0.5f : 1f) * num * strength;
			switch (e)
			{
			case 1:
				if (!blast && now < elemStatus.FrozenUntil)
				{
					elemStatus.FrozenUntil = now;
					Game.HurtEnemy(eh, Mathf.RoundToInt(((float)dealt * 0.3f + 15f) * strength), Vector3.up);
					Net.SendElementCombo(elemStatus.ViewId, "SHATTER");
				}
				elemStatus.Burn = Mathf.Min(3, ((now < elemStatus.BurnEnd) ? elemStatus.Burn : 0) + num2);
				elemStatus.BurnEnd = now + 4f;
				if (!flag && now >= elemStatus.PanicReady && elemStatus.Burn > 0)
				{
					elemStatus.PanicReady = now + 8f;
					Game.StunEnemy(eh, 0.6f * strength);
				}
				break;
			case 2:
			{
				if (now >= elemStatus.StaticReady || chained)
				{
					elemStatus.StaticReady = now + 3f;
					bool flag2 = elemStatus.Chill > 0 && now < elemStatus.ChillEnd;
					float num4 = 0.4f * num3 * ((flag2 && !blast) ? 2f : 1f);
					if (flag2 && !blast)
					{
						Net.SendElementCombo(elemStatus.ViewId, "OVERLOAD");
					}
					if (num4 > 0.05f)
					{
						Game.StunEnemy(eh, num4);
					}
				}
				if (chained || blast || !(Random.value < 0.15f * strength))
				{
					break;
				}
				EnemyHealth val = null;
				float num5 = 25f;
				Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
				Vector3 val2;
				while (enumerator.MoveNext())
				{
					EnemyHealth current = enumerator.Current;
					if (!((Object)(object)current == (Object)null) && !((Object)(object)current == (Object)(object)eh) && !((Object)(object)((Component)current).transform.root == (Object)(object)((Component)eh).transform.root))
					{
						val2 = ((Component)current).transform.position - ((Component)eh).transform.position;
						float sqrMagnitude = ((Vector3)(ref val2)).sqrMagnitude;
						if (sqrMagnitude < num5)
						{
							num5 = sqrMagnitude;
							val = current;
						}
					}
				}
				if ((Object)(object)val != (Object)null)
				{
					EnemyHealth eh2 = val;
					int damage = Mathf.Max(1, Mathf.RoundToInt((float)dealt * 0.2f));
					val2 = ((Component)val).transform.position - ((Component)eh).transform.position;
					Game.HurtEnemy(eh2, damage, ((Vector3)(ref val2)).normalized);
					ApplyElement(val, 2, 0, blast: false, chained: true);
					if (elemStatus.Burn > 0 && now < elemStatus.BurnEnd)
					{
						ElemStatus elemStatus2 = ElemOf(val);
						elemStatus2.Burn = Mathf.Min(3, ((now < elemStatus2.BurnEnd) ? elemStatus2.Burn : 0) + 1);
						elemStatus2.BurnEnd = now + 4f;
						Net.SendElementCombo(elemStatus2.ViewId, "SHORT CIRCUIT");
					}
				}
				break;
			}
			case 3:
			{
				elemStatus.Chill = Mathf.Min(4, ((now < elemStatus.ChillEnd) ? elemStatus.Chill : 0) + num2);
				elemStatus.ChillEnd = now + 4f;
				if (!Elites.TryGet(eh, out var _))
				{
					_slows[((Object)eh).GetInstanceID()] = (eh, elemStatus.ChillEnd, 1f - Mathf.Min(0.4f, 0.1f * (float)elemStatus.Chill * strength));
				}
				if (blast)
				{
					break;
				}
				elemStatus.ChillHits.RemoveAll((float x) => now - x > 4f);
				elemStatus.ChillHits.Add(now);
				if (elemStatus.ChillHits.Count >= 5 && now >= elemStatus.FreezeImmuneUntil)
				{
					elemStatus.ChillHits.Clear();
					float num6 = 1.5f * num3;
					if (num6 > 0.05f)
					{
						Game.StunEnemy(eh, num6);
						elemStatus.FrozenUntil = now + num6;
						elemStatus.FreezeImmuneUntil = now + num6 + 8f;
					}
				}
				break;
			}
			case 4:
				elemStatus.Rot = Mathf.Min(4, ((now < elemStatus.RotEnd) ? elemStatus.Rot : 0) + num2);
				elemStatus.RotEnd = now + 6f;
				break;
			case 5:
				elemStatus.Weaken = Mathf.Min(3, ((now < elemStatus.WeakenEnd) ? elemStatus.Weaken : 0) + num2);
				elemStatus.WeakenEnd = now + 5f;
				break;
			}
		}

		private float ElementRotPct(EnemyHealth eh)
		{
			if (_elem.Count == 0 || !_elem.TryGetValue(((Object)eh).GetInstanceID(), out ElemStatus value) || value.Rot == 0 || Time.time >= value.RotEnd)
			{
				return 0f;
			}
			return Mathf.Min((float)Mathf.Clamp(value.Rot, 0, 4) * 5f * Elements.Strength, Plugin.Cfg.MaxMarkDamage.Value);
		}

		private void TickElements()
		{
			//IL_0145: Unknown result type (might be due to invalid IL or missing references)
			if (_elem.Count == 0 || Time.time < _elemNext)
			{
				return;
			}
			float time = Time.time;
			_elemNext = time + 0.25f;
			_elemGone.Clear();
			foreach (KeyValuePair<int, ElemStatus> item in _elem)
			{
				ElemStatus value = item.Value;
				if ((Object)(object)value.Eh == (Object)null || Game.Get(value.Eh, "dead", fallback: false) || Game.Get(value.Eh, "healthCurrent", 1) <= 0)
				{
					_elemGone.Add(item.Key);
					continue;
				}
				if (value.Burn > 0 && time < value.BurnEnd)
				{
					bool flag = value.Rot > 0 && time < value.RotEnd;
					value.BurnAcc += 3f * (float)value.Burn * 0.25f * Elements.Strength * (flag ? 1.5f : 1f);
					int num = Mathf.FloorToInt(value.BurnAcc);
					if (num > 0)
					{
						value.BurnAcc -= num;
						Game.HurtEnemy(value.Eh, num, Vector3.up);
					}
				}
				if (value.Empty(time))
				{
					_elemGone.Add(item.Key);
				}
			}
			foreach (int item2 in _elemGone)
			{
				_elem.Remove(item2);
			}
			if (time < _elemSendNext)
			{
				return;
			}
			_elemSendNext = time + 0.5f;
			List<int> list = new List<int>(_elem.Count);
			List<byte> list2 = new List<byte>(_elem.Count * 5);
			StringBuilder stringBuilder = new StringBuilder();
			foreach (ElemStatus value2 in _elem.Values)
			{
				if (value2.ViewId != 0 && list.Count < 64)
				{
					byte b = (byte)((time < value2.BurnEnd) ? ((uint)value2.Burn) : 0u);
					byte b2 = (byte)((time < value2.ChillEnd) ? ((uint)value2.Chill) : 0u);
					byte b3 = (byte)((time < value2.RotEnd) ? ((uint)value2.Rot) : 0u);
					byte b4 = (byte)((time < value2.WeakenEnd) ? ((uint)value2.Weaken) : 0u);
					bool flag2 = time < value2.FrozenUntil;
					bool flag3 = time < value2.StaticReady - 2.6f;
					byte b5 = (byte)(((b > 0) ? 1u : 0u) | (uint)(flag3 ? 2 : 0) | (uint)((b2 > 0) ? 4 : 0) | (uint)((b3 > 0) ? 8 : 0) | (uint)((b4 > 0) ? 16 : 0) | (uint)(flag2 ? 64 : 0));
					if (b5 != 0)
					{
						list.Add(value2.ViewId);
						list2.Add(b5);
						list2.Add(b);
						list2.Add(b2);
						list2.Add(b3);
						list2.Add(b4);
						stringBuilder.Append(value2.ViewId).Append(':').Append(b5)
							.Append(b)
							.Append(b2)
							.Append(b3)
							.Append(b4)
							.Append(';');
					}
				}
			}
			string text = stringBuilder.ToString();
			if (!(text == _elemSent))
			{
				_elemSent = text;
				Net.SendElements(list.ToArray(), list2.ToArray());
			}
		}

		public bool WasAppraised(Component v)
		{
			if ((Object)(object)v != (Object)null)
			{
				return _appraised.Contains(((Object)v).GetInstanceID());
			}
			return false;
		}

		private void Awake()
		{
			Instance = this;
		}

		public void OnLevelStart()
		{
			_levelStartAt = Time.time;
			_valuablesDone.Clear();
			_appraised.Clear();
			_valuableRarity.Clear();
			_carried.Clear();
			_contrib.Clear();
			_marks.Clear();
			_firstStruck.Clear();
			_staticHits.Clear();
			_slows.Clear();
			ElementsLevelStart();
			PatchGuard.Run("research E level", ResearchLevelStartE);
			PatchGuard.Run("research X level", ResearchLevelStartX);
			PatchGuard.Run("research C level", ResearchLevelStartC);
			_valuableList.Clear();
			_enemiesRolled.Clear();
			_eliteCache.Clear();
			_regenAcc.Clear();
			_lastHurt.Clear();
			_shields.Clear();
			_speed.Clear();
			_agents.Clear();
			_bleeds.Clear();
			_rng = RunInfo.RngFor(RunInfo.LevelIndex * 9973 + 5);
			if (Game.IsMaster())
			{
				Elites.Clear();
			}
		}

		public void SetCombat(int actor, Combat c)
		{
			_combat[actor] = c;
		}

		public Combat CombatOf(PlayerAvatar? p)
		{
			return CombatFor(p);
		}

		public float NoiseMultiplier(Vector3 at)
		{
			//IL_0041: Unknown result type (might be due to invalid IL or missing references)
			//IL_0046: Unknown result type (might be due to invalid IL or missing references)
			//IL_0047: Unknown result type (might be due to invalid IL or missing references)
			//IL_004c: Unknown result type (might be due to invalid IL or missing references)
			float num = 0f;
			float num2 = 0f;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item == (Object)null || !Game.IsAlive(item))
				{
					continue;
				}
				Vector3 val = ((Component)item).transform.position - at;
				if (((Vector3)(ref val)).sqrMagnitude > 12.25f)
				{
					continue;
				}
				float num3 = CombatFor(item).Noise;
				if (num3 >= 0f && Game.Get(item, "isSprinting", fallback: false))
				{
					num3 += Mathf.Clamp(ClassStats.Get(item, "attr.sprint_noise"), 0f, 30f);
				}
				if (num3 >= 0f && Game.Get(item, "isCrouching", fallback: false))
				{
					num3 += Mathf.Clamp(ClassStats.Get(item, "perk.crouch_noise"), 0f, 20f);
					num3 += Mathf.Clamp(ClassStats.Get(item, "attr.crouch_noise"), 0f, 20f);
					if (ClassStats.Get(item, "perk.quiet_crouch") > 0f)
					{
						num3 = Plugin.Cfg.MaxNoiseReduction.Value;
					}
				}
				num = Mathf.Max(num, num3);
				num2 = Mathf.Min(num2, num3);
			}
			return (1f - Mathf.Clamp(num, 0f, Plugin.Cfg.MaxNoiseReduction.Value) / 100f) * (1f - Mathf.Clamp(num2, -50f, 0f) / 100f);
		}

		private Combat CombatFor(PlayerAvatar? p)
		{
			if ((Object)(object)p == (Object)null)
			{
				return default(Combat);
			}
			if ((Object)(object)p == (Object)(object)Game.LocalPlayer())
			{
				return RpgRuntime.Instance?.LocalCombat() ?? default(Combat);
			}
			int key = Game.ActorNumber(p);
			if (!_combat.TryGetValue(key, out var value))
			{
				return default(Combat);
			}
			return value;
		}

		public float HeldItemProtection(Component? detector)
		{
			try
			{
				if ((Object)(object)detector == (Object)null)
				{
					return 0f;
				}
				PhysGrabObject val = detector.GetComponent<PhysGrabObject>();
				if ((Object)(object)val == (Object)null)
				{
					val = detector.GetComponentInParent<PhysGrabObject>();
				}
				if ((Object)(object)val == (Object)null)
				{
					return 0f;
				}
				IList list = Game.Get<IList>(val, "playerGrabbing", null);
				if (list == null || list.Count == 0)
				{
					return 0f;
				}
				float num = 0f;
				foreach (object item in list)
				{
					Component val2 = (Component)((item is Component) ? item : null);
					if (val2 != null && !((Object)(object)val2 == (Object)null))
					{
						PlayerAvatar val3 = Game.Get<PlayerAvatar>(val2, "playerAvatar", null);
						if ((Object)(object)val3 == (Object)null)
						{
							val3 = val2.GetComponentInParent<PlayerAvatar>();
						}
						num = Mathf.Max(num, CombatFor(val3).ItemProtection);
					}
				}
				return Mathf.Clamp(num, 0f, RpgRuntime.ItemProtectionCap);
			}
			catch
			{
				return 0f;
			}
		}

		private void Update()
		{
			if (Game.IsMaster() && Game.LevelReady() && Guard.On("host director"))
			{
				long t = NetMeter.Begin();
				Perf.Mark m = Perf.Start();
				try
				{
					UpdateMain();
				}
				catch (Exception e)
				{
					Guard.Fail("host director", e);
				}
				Perf.Stop(Perf.S.HostDirector, m);
				NetMeter.EndHost(t);
			}
		}

		private void UpdateMain()
		{
			if (Time.time >= _nextScan)
			{
				_nextScan = Time.time + 1f;
				_valuableList.Clear();
				Game.ValuableList.Enumerator enumerator = Game.Valuables().GetEnumerator();
				while (enumerator.MoveNext())
				{
					ValuableObject item = enumerator.Current.obj;
					_valuableList.Add(item);
				}
				TrackCarriers();
				if (Plugin.Cfg.ValuableRarity.Value)
				{
					ScanValuables();
				}
				if (Plugin.Cfg.EliteEnemies.Value)
				{
					ScanEnemies();
				}
				if (Plugin.Cfg.EliteEnemies.Value)
				{
					Bosses.HostTick(_rng);
				}
				Crafting.HostTick();
				TeamContracts.HostTick();
				Starters.HostTick(Time.time - _levelStartAt);
				ElementsPlayersTick();
				PatchGuard.Run("research E tick", ResearchTickE);
				PatchGuard.Run("research X tick", ResearchTickX);
				PatchGuard.Run("research C tick", ResearchTickC);
			}
			if (Time.time >= _nextAppraise)
			{
				_nextAppraise = Time.time + 0.5f;
				TickAppraisals();
			}
			if (Plugin.Cfg.EliteEnemies.Value)
			{
				TickElites();
			}
			TickBleeds();
			if (_slows.Count > 0)
			{
				TickSlows();
			}
			TickElements();
		}

		private void ScanValuables()
		{
			foreach (ValuableObject valuable in _valuableList)
			{
				if ((Object)(object)valuable == (Object)null)
				{
					continue;
				}
				float num = Game.Get(valuable, "dollarValueCurrent", 0f);
				int instanceID = ((Object)valuable).GetInstanceID();
				if (!_valuablesDone.Contains(instanceID) && Game.Get(valuable, "dollarValueSet", fallback: false) && !(num <= 0f))
				{
					_valuablesDone.Add(instanceID);
					int num2 = Gear.ValuableRarity(Elites.ViewId((Component)(object)valuable));
					_valuableRarity[instanceID] = num2;
					float valueMult = Gear.Rarity(num2).valueMult;
					if (valueMult > 1.001f)
					{
						Game.SetValuableValue(valuable, Mathf.Round(num * valueMult));
					}
				}
			}
		}

		private void PerkHaul()
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item == (Object)null)
				{
					continue;
				}
				string text = Game.SteamId(item);
				if (string.IsNullOrEmpty(text) || !_perkHaul.TryGetValue(text, out (int, float) value))
				{
					continue;
				}
				Net.SendPerkEvent(1, value.Item1, 0, Game.ActorNumber(item));
				float num = Mathf.Clamp(ClassStats.Get(item, "perk.haul_scrap"), 0f, 10f);
				if (num > 0f)
				{
					double num2 = Scrap.FromDollars(value.Item2) * (double)num / 100.0;
					if (num2 >= 0.5)
					{
						Scrap.HostGrant(item, num2, "Haul Hound");
					}
				}
			}
		}

		public Dictionary<string, double> Contributions()
		{
			return _contrib;
		}

		private void TrackCarriers()
		{
			_present.Clear();
			foreach (ValuableObject valuable in _valuableList)
			{
				if ((Object)(object)valuable == (Object)null)
				{
					continue;
				}
				int instanceID = ((Object)valuable).GetInstanceID();
				_present.Add(instanceID);
				_carried.TryGetValue(instanceID, out (string, float, PhysGrabObject) value);
				if ((Object)(object)value.Item3 == (Object)null)
				{
					value.Item3 = ((Component)valuable).GetComponent<PhysGrabObject>();
					if ((Object)(object)value.Item3 == (Object)null)
					{
						value.Item3 = ((Component)valuable).GetComponentInParent<PhysGrabObject>();
					}
				}
				IList list = (((Object)(object)value.Item3 == (Object)null) ? null : Game.Get<IList>(value.Item3, "playerGrabbing", null));
				if (list != null)
				{
					foreach (object item in list)
					{
						Component val = (Component)((item is Component) ? item : null);
						if (val != null && !((Object)(object)val == (Object)null))
						{
							PlayerAvatar val2 = Game.Get<PlayerAvatar>(val, "playerAvatar", null);
							if ((Object)(object)val2 == (Object)null)
							{
								val2 = val.GetComponentInParent<PlayerAvatar>();
							}
							string text = (((Object)(object)val2 == (Object)null) ? "" : Game.SteamId(val2));
							if (!string.IsNullOrEmpty(text))
							{
								value.Item1 = text;
								break;
							}
						}
					}
				}
				value.Item2 = Game.Get(valuable, "dollarValueCurrent", 0f);
				_carried[instanceID] = value;
			}
			_goneIds.Clear();
			foreach (KeyValuePair<int, (string, float, PhysGrabObject)> item2 in _carried)
			{
				if (!_present.Contains(item2.Key))
				{
					_goneIds.Add(item2.Key);
				}
			}
			_perkHaul.Clear();
			foreach (int goneId in _goneIds)
			{
				(string, float, PhysGrabObject) tuple = _carried[goneId];
				if (!string.IsNullOrEmpty(tuple.Item1) && tuple.Item2 > 0f)
				{
					_contrib.TryGetValue(tuple.Item1, out var value2);
					_contrib[tuple.Item1] = value2 + (double)tuple.Item2;
					_perkHaul.TryGetValue(tuple.Item1, out (int, float) value3);
					_perkHaul[tuple.Item1] = (value3.Item1 + 1, value3.Item2 + tuple.Item2);
				}
				_carried.Remove(goneId);
			}
			if (_perkHaul.Count > 0)
			{
				PatchGuard.Run("perk haul", PerkHaul);
			}
		}

		private void TickAppraisals()
		{
			//IL_013f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0144: Unknown result type (might be due to invalid IL or missing references)
			//IL_0174: Unknown result type (might be due to invalid IL or missing references)
			//IL_0179: Unknown result type (might be due to invalid IL or missing references)
			//IL_017b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0180: Unknown result type (might be due to invalid IL or missing references)
			_appraisers.Clear();
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					Combat stats = CombatFor(item);
					if (!(stats.Appraise <= 0f) && !(stats.AppraiseRadius <= 0f) && !Game.Get(item, "isDisabled", fallback: false))
					{
						_appraisers.Add(new Appraiser
						{
							Avatar = item,
							Stats = stats,
							RadiusSq = stats.AppraiseRadius * stats.AppraiseRadius
						});
					}
				}
			}
			if (_appraisers.Count == 0)
			{
				return;
			}
			foreach (ValuableObject valuable in _valuableList)
			{
				if ((Object)(object)valuable == (Object)null)
				{
					continue;
				}
				int instanceID = ((Object)valuable).GetInstanceID();
				if (_appraised.Contains(instanceID) || !Game.Get(valuable, "dollarValueSet", fallback: false) || (Plugin.Cfg.ValuableRarity.Value && !_valuablesDone.Contains(instanceID)))
				{
					continue;
				}
				_valuableRarity.TryGetValue(instanceID, out var value);
				Vector3 position = ((Component)valuable).transform.position;
				Appraiser appraiser = null;
				float num = 0f;
				foreach (Appraiser appraiser2 in _appraisers)
				{
					Vector3 val = ((Component)appraiser2.Avatar).transform.position - position;
					if (!(((Vector3)(ref val)).sqrMagnitude > appraiser2.RadiusSq))
					{
						float num2 = appraiser2.Stats.Appraise + ((value >= 2) ? appraiser2.Stats.AppraiseRare : 0f);
						if (num2 > num)
						{
							num = num2;
							appraiser = appraiser2;
						}
					}
				}
				if (appraiser != null)
				{
					_appraised.Add(instanceID);
					float num3 = Game.Get(valuable, "dollarValueCurrent", 0f);
					if (!(num3 <= 0f))
					{
						num = Mathf.Min(num, Plugin.Cfg.MaxAppraiseBonus.Value);
						float num4 = Mathf.Round(num3 * (1f + num / 100f));
						Game.SetValuableValue(valuable, num4);
						appraiser.Gained += Mathf.RoundToInt(num4 - num3);
						appraiser.Count++;
						appraiser.BestRarity = Mathf.Max(appraiser.BestRarity, value);
					}
				}
			}
			foreach (Appraiser appraiser3 in _appraisers)
			{
				if (appraiser3.Count > 0)
				{
					Net.SendAppraised(Game.ActorNumber(appraiser3.Avatar), (Object)(object)appraiser3.Avatar == (Object)(object)Game.LocalPlayer(), appraiser3.Gained, appraiser3.Count, appraiser3.BestRarity);
				}
			}
		}

		public void OnEnemyDied(EnemyHealth eh)
		{
			if (!Game.IsMaster() || (Object)(object)eh == (Object)null)
			{
				return;
			}
			PatchGuard.Run("killed bosses", delegate
			{
				BossGraveyard.HostOnDied(eh);
			});
			PatchGuard.Run("research X enemy died", delegate
			{
				ResearchEnemyDiedX(eh);
			});
			if (_lastHitBy.TryGetValue(((Object)eh).GetInstanceID(), out (int, float) value))
			{
				_lastHitBy.Remove(((Object)eh).GetInstanceID());
				if (Time.time - value.Item2 <= 10f)
				{
					TeamPlay.HostAdd(value.Item1, TeamPlay.Ev.Kills, 1f);
					if (Elites.TryGet(eh, out var _))
					{
						TeamPlay.HostAdd(value.Item1, TeamPlay.Ev.Elites, 1f);
					}
				}
			}
			if (_lastHitBy.Count > 128)
			{
				_lastHitBy.Clear();
			}
			PatchGuard.Run("boss kill", delegate
			{
				Bosses.HostOnKilled(eh);
			});
			PatchGuard.Run("part drop", delegate
			{
				Crafting.HostOnEnemyDied(eh);
			});
			PatchGuard.Run("team contract kill", delegate
			{
				TeamContracts.HostOnKill(eh);
			});
			if (Elites.TryGet(eh, out var info2) && info2.Tier < 3)
			{
				PatchGuard.Run("run shape (elite)", delegate
				{
					RunShape.HostEliteKilled();
					if (RunShape.Has("bounty_board"))
					{
						foreach (PlayerAvatar item in Game.Players())
						{
							if ((Object)(object)item != (Object)null)
							{
								Scrap.HostGrant(item, 10.0, "Elite kill (Bounty Board)");
							}
						}
					}
					if (ResearchCrew.HasDrill("bounty_drill"))
					{
						foreach (PlayerAvatar item2 in Game.Players())
						{
							if ((Object)(object)item2 != (Object)null)
							{
								Scrap.HostGrant(item2, 4.0, "Elite kill (Bounty drill)");
							}
						}
					}
				});
			}
			if (!BossGraveyard.IsRetired(eh))
			{
				_enemiesRolled.Remove(Elites.ViewId((Component)(object)eh));
			}
		}

		private void ScanEnemies()
		{
			_eliteCache.Clear();
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				EnemyHealth current = enumerator.Current;
				int num = Elites.ViewId((Component)(object)current);
				if (Elites.Contains(num))
				{
					_eliteCache.Add((current, num));
				}
				if (_enemiesRolled.Add(num) && !BossGraveyard.IsRetired(num) && Elites.Roll(_rng, RunInfo.LevelIndex, out var mods, out var tier))
				{
					Elites.Set(num, mods, tier);
					_eliteCache.Add((current, num));
					Net.BroadcastElite(num, mods, tier);
					Plugin.Log.LogInfo((object)("Elite " + Elites.TierName(tier) + " (" + Elites.Describe(mods) + ") on " + ((Object)current).name + "."));
				}
			}
		}

		public void TrackElite(EnemyHealth eh, int id)
