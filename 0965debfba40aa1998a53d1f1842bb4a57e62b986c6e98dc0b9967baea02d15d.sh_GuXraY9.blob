						_craftTarget = gearItem.uid;
						OpenCraft(gearItem);
					}
				}, "Starter items can't be crafted.");
			}
			return gearDetail;
		}

		private List<string> DistinctModules(RunSave run)
		{
			_distinctMods.Clear();
			foreach (string item in run.moduleBag)
			{
				if (!_distinctMods.Contains(item))
				{
					_distinctMods.Add(item);
				}
			}
			return _distinctMods;
		}

