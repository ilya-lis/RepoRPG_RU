		}

		private float CooldownSeconds()
		{
			if (Current == null)
			{
				return 30f;
			}
			float num = ((MaxCharges > 1) ? Mathf.Clamp(_stats.Custom("perk.charge_rate"), 0f, 30f) : 0f);
			float num2 = Mathf.Min(_stats[Stat.CooldownReduction] + _stats.Custom(Current.active.mods.cooldown) + num, Plugin.Cfg.MaxCooldownReduction.Value);
			float num3 = Current.active.cooldown;
			if (Current.id == "mimic")
			{
				ClassDef classDef = MimicCopy();
				if (classDef != null)
				{
					num3 = classDef.active.cooldown * (1f + Mathf.Max(0f, ClassStat("mimic.copy_cdpenalty")) / 100f);
				}
			}
			num3 *= SynergyCooldownMult(Current.id);
			if (TeamContracts.CurseNow == "Drained")
			{
				num3 *= 1.2f;
			}
			if (Difficulty.ShortFuse)
			{
				num3 *= 1.25f;
			}
			return Mathf.Max(1f, num3 * (1f - num2 / 100f));
		}

		private void TickCharges()
		{
			int maxCharges = MaxCharges;
			if (_charges > maxCharges)
			{
				_charges = maxCharges;
			}
			if (_charges >= maxCharges)
			{
				_cooldownEnd = 0f;
			}
			else if (_cooldownEnd <= 0f)
			{
				_cooldownEnd = Time.time + CooldownSeconds();
			}
			else if (Time.time >= _cooldownEnd)
			{
				_charges++;
				_freshUsed = false;
				_cooldownEnd = ((_charges < maxCharges) ? (Time.time + CooldownSeconds()) : 0f);
			}
		}

		private void ResetAbilityState(bool keepCooldown = false)
		{
			ResetSignature();
			if (!keepCooldown)
			{
				_cooldownEnd = 0f;
				_charges = MaxCharges;
			}
			_buffEnd = 0f;
			_hotEnd = 0f;
			_scanEnd = 0f;
			ClearScan();
			_stats.SetTemp(null, 0f);
			_nextCombatSend = 0f;
		}

		private void TryUseActive()
		{
			//IL_00a9: Unknown result type (might be due to invalid IL or missing references)
			//IL_0046: Unknown result type (might be due to invalid IL or missing references)
