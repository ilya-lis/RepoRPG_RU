		private void FillPerkDetail(DetailInfo d, RunSave run, PerkDef def, bool hidden, int pick)
		{
			//IL_00a5: Unknown result type (might be due to invalid IL or missing references)
			bool flag = run.perks.Contains(def.id);
			bool flag2 = Perks.IsEvolved(run, def.id);
			bool flag3 = run.banished.Contains(def.id);
			d.Type = (hidden ? "Legendary perk" : StripRich(PerkKindLine(def)));
			if (hidden)
			{
				d.Name = "? ? ?";
				d.Status.Add((UiStatus.Locked, "Not discovered"));
				d.Now = "<color=#9a9ca0>Not discovered yet. A Legendary perk shows here once it has been offered to you.</color>";
				return;
			}
			d.Name = (flag2 ? def.evolveName : def.name);
			d.NameColor = Perks.ColorOf(def);
			if (flag2)
			{
				d.Status.Add((UiStatus.Maxed, "Evolved"));
			}
			else if (flag)
			{
				d.Status.Add(Perks.Counts(def) ? (UiStatus.Equipped, "Owned") : (UiStatus.Locked, "Off"));
			}
			else if (pick >= 0)
			{
				d.Status.Add((UiStatus.Available, "On offer"));
			}
			if (flag3)
			{
				d.Status.Add((UiStatus.Locked, "Banished"));
			}
			if (def.cursed)
			{
				d.Status.Add((UiStatus.Cursed, ""));
			}
			string text = PerkFx(def);
			d.Now = (flag2 ? (def.evolveDesc + "\n<color=#9a9ca0>Evolved from " + def.name + ".</color>") : def.desc) + ((text != "") ? ("\n<color=#9a9ca0>" + text + "</color>") : "");
			if (def.Evolves && !flag2)
			{
				d.NextNote = EvolveLine(run, def);
			}
			if (pick >= 0)
			{
				List<string> list = Perks.PickPreview(run, def);
				if (list.Count > 0)
				{
					d.Needs = string.Join("\n", list);
				}
				int pi = pick;
				string id = def.id;
				d.Act((_perkPending.TryGetValue(pi, out string value) && value == id) ? "Unselect" : "Select", BtnKind.Primary, !PerksBusy, delegate
				{
					PerkSelect(pi, id);
				});
			}
		}

		private string PerkKindLine(PerkDef p)
