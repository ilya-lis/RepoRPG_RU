			int num = ShopSections.Length;
			float num2 = 24f;
			float[] array = new float[num];
			float num3 = 0f;
			for (int i = 0; i < num; i++)
			{
				array[i] = Mathf.Max(90f, TextW("> " + SectionLabel(i, run).ToUpperInvariant() + " ✖", _btn) + num2);
				num3 += array[i] + 4f;
			}
			num3 -= 4f;
			if (num3 <= ((Rect)(ref area)).width)
			{
				float num4 = (((Rect)(ref area)).width - num3) / (float)num;
				float num5 = ((Rect)(ref area)).x;
				for (int j = 0; j < num; j++)
				{
					DrawSectionTab(new Rect(num5, y, array[j] + num4, BtnH), j, run);
					num5 += array[j] + num4 + 4f;
				}
				return y + BtnH + 8f;
			}
			float btnH = BtnH;
			float num6 = ((Rect)(ref area)).width - 2f * (btnH + 4f);
			_shopSecFirst = Mathf.Clamp(_shopSecFirst, 0, num - 1);
			if (_shopSection < _shopSecFirst)
			{
				_shopSecFirst = _shopSection;
			}
			int num7 = LastFitting(array, _shopSecFirst, num6);
			while (_shopSection > num7 && _shopSecFirst < num - 1)
			{
				_shopSecFirst++;
				num7 = LastFitting(array, _shopSecFirst, num6);
			}
			if (Btn(new Rect(((Rect)(ref area)).x, y, btnH, BtnH), "‹", _shopSecFirst > 0))
			{
				_shopSecFirst--;
			}
			if (Btn(new Rect(((Rect)(ref area)).xMax - btnH, y, btnH, BtnH), "›", num7 < num - 1))
			{
				_shopSecFirst++;
			}
			float num8 = 0f;
			for (int k = _shopSecFirst; k <= num7; k++)
			{
				num8 += array[k] + 4f;
			}
			float num9 = ((num7 >= _shopSecFirst) ? Mathf.Max(0f, (num6 - num8 + 4f) / (float)(num7 - _shopSecFirst + 1)) : 0f);
			float num10 = ((Rect)(ref area)).x + btnH + 4f;
			for (int l = _shopSecFirst; l <= num7; l++)
			{
				DrawSectionTab(new Rect(num10, y, array[l] + num9, BtnH), l, run);
				num10 += array[l] + num9 + 4f;
			}
			return y + BtnH + 8f;
		}

		private static int LastFitting(float[] widths, int first, float inner)
		{
			float num = 0f;
			int result = first;
			for (int i = first; i < widths.Length && (!(num + widths[i] > inner) || i <= first); i++)
			{
				num += widths[i] + 4f;
				result = i;
			}
			return result;
		}

