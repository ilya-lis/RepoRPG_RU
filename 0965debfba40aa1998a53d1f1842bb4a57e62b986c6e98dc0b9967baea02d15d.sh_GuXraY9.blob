	internal static class ResearchEcon
	{
		private static readonly int[] GearPrice = new int[5] { 20, 35, 70, 140, 280 };

		public const int GunBenchPrice = 35;

		public static readonly string[] GunMods = new string[3] { "gun_suppressor", "gun_choke", "gun_stock" };

		private static readonly string[] NewCons = new string[3] { "smoke", "decoy", "flash" };

		private static readonly Dictionary<string, int> PawnBook = new Dictionary<string, int>();

		private static readonly HashSet<string> PawnBack = new HashSet<string>();

		private static string _pawnRun = "\u0001";

		public static void AddConsumables(List<ConsumableDef> list)
		{
			Add(list, new ConsumableDef
			{
				id = "smoke",
				name = "Smoke Canister",
				price = 30,
				desc = "The first time your health drops below 50% in a level, smoke bursts: monsters within 8 m lose sight of you for 6 s.",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.smoke",
						value = 1f
					}
				}
			});
			Add(list, new ConsumableDef
			{
				id = "decoy",
				name = "Decoy Whistle",
				price = 25,
				desc = "The first time a monster comes within 6 m of you in a level, you throw a whistle 10 m ahead: monsters within 20 m go to check it out.",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.decoy",
						value = 1f
					}
				}
			});
			Add(list, new ConsumableDef
			{
				id = "flash",
				name = "Flash Charge",
				price = 30,
				desc = "The first time a monster comes within 3 m of you in a level, a flash stuns monsters within 5 m for 2.5 s.",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.flash",
						value = 1f
					}
				}
			});
			Add(list, new ConsumableDef
			{
				id = "gun_suppressor",
				name = "Suppressor",
				price = 35,
				desc = "Gun Bench: monsters barely hear the shots of guns you hold (next level).",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.gun_quiet",
						value = 1f
					}
				}
			});
			Add(list, new ConsumableDef
			{
				id = "gun_choke",
				name = "Scatter Choke",
				price = 35,
				desc = "Gun Bench: guns you hold fire one extra pellet per shot, with a much wider spread (next level).",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.gun_choke",
						value = 1f
					}
				}
			});
			Add(list, new ConsumableDef
			{
				id = "gun_stock",
				name = "Stock",
				price = 35,
				desc = "Gun Bench: guns you hold kick 70% less (next level).",
				effects = new EffectDef[1]
				{
					new EffectDef
					{
						stat = "shop.gun_stock",
						value = 1f
					}
				}
			});
		}

		private static void Add(List<ConsumableDef> l, ConsumableDef c)
		{
			if (!l.Exists((ConsumableDef x) => x.id == c.id))
			{
				l.Add(c);
			}
		}

		public static bool IsGunMod(string? id)
		{
			return id?.StartsWith("gun_", StringComparison.Ordinal) ?? false;
		}

		public static bool ConsOffered(string id)
		{
			if (IsGunMod(id))
			{
				return false;
			}
			if (Array.IndexOf(NewCons, id) >= 0)
			{
				return Research.Has("consumables2");
			}
			return true;
		}

		private static int Scale(float v)
		{
			return Mathf.Max(1, Mathf.RoundToInt(v * ShopX.Mult));
		}

		public static int BasePrice(string key)
		{
			if (key.StartsWith("futures:", StringComparison.Ordinal))
			{
				if (!Research.Lobby("futures") || !int.TryParse(key.Substring(8), out var result) || result < 1 || result > Gear.MaxRarity)
				{
					return -1;
				}
				return Scale((float)GearPrice[Mathf.Clamp(result, 0, GearPrice.Length - 1)] * 0.9f);
			}
			if (key.StartsWith("gunbench:", StringComparison.Ordinal))
			{
				string id = key.Substring(9);
				if (!IsGunMod(id) || ShopX.Cons(id) == null)
				{
					return -1;
				}
				return Scale(35f);
			}
			return -1;
		}

		public static int PawnPay(int salvageValue)
		{
			return Mathf.RoundToInt((float)Mathf.Max(0, salvageValue) * 0.6f);
		}

		public static int PawnPrice(int salvageValue)
		{
			return Mathf.Max(PawnPay(salvageValue) + 1, Mathf.RoundToInt((float)Mathf.Max(0, salvageValue) * 0.8f));
		}

		private static void PawnRunCheck()
		{
			if (!(_pawnRun == RunInfo.RunId))
			{
				_pawnRun = RunInfo.RunId;
				PawnBook.Clear();
				PawnBack.Clear();
			}
		}

		public static void HostNotePawn(string steamId, string uid, int price)
		{
			PawnRunCheck();
			PawnBook[steamId + "|" + uid] = price;
			PawnBack.Remove(steamId + "|" + uid);
		}

		public static int HostPawnPrice(int actor, string uid)
		{
			if (!Research.Lobby("pawn_counter"))
			{
				return -1;
			}
			PawnRunCheck();
			string text = Net.ResSteamIdE(actor);
			string text2 = text + "|" + uid;
			if (PawnBack.Contains(text2))
			{
				return -1;
			}
			if (PawnBook.TryGetValue(text2, out var value))
			{
				return value;
			}
			return RpgRuntime.HostPawnFallbackE(actor, text, uid);
		}

		public static void HostForgetPawn(int actor, string uid)
		{
			string text = Net.ResSteamIdE(actor) + "|" + uid;
			PawnBook.Remove(text);
			PawnBack.Add(text);
			if (PawnBack.Count > 500)
			{
				PawnBack.Clear();
			}
		}

		public static string ModuleText(string stat)
		{
			return stat switch
			{
				"gear.tracer" => "Monsters you hit are marked for the team for 3 s", 
				"gear.spotter" => "Aim at a valuable to see its value", 
				"gear.tether" => "Items you let go float for 1 s", 
				_ => "", 
			};
		}

		public static bool IsProto(GearItem? g)
		{
			if (g != null && g.behavior != null)
			{
				return g.behavior.StartsWith("proto_", StringComparison.Ordinal);
			}
			return false;
		}

		public static string ProtoSlot(string behaviorId)
		{
			return behaviorId switch
			{
				"proto_mender" => "plating", 
				"proto_bulwark" => "plating", 
				"proto_static" => "core", 
				"proto_medic" => "core", 
				"proto_surge" => "servos", 
				_ => "weapon", 
			};
		}
	}
	internal static class GunBench
	{
		private sealed class Orig
		{
			public float Inv;

			public float Spread;

			public float Shake;

			public float Recoil;

			public int Bullets;

			public bool Recoiled;
		}

		private static readonly Dictionary<ItemGun, Orig> Tuned = new Dictionary<ItemGun, Orig>();

		private static readonly List<ItemGun> Gone = new List<ItemGun>();

		private static readonly HashSet<ItemGun> Seen = new HashSet<ItemGun>();

		private static float _next;

		public static void Tick()
		{
			if (Time.time < _next)
			{
				return;
			}
			_next = Time.time + 0.25f;
			Seen.Clear();
			if (Game.InLevel())
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item == (Object)null)
					{
						continue;
					}
					float num = ClassStats.Get(item, "shop.gun_quiet");
					float num2 = ClassStats.Get(item, "shop.gun_choke");
					float num3 = ClassStats.Get(item, "shop.gun_stock");
					if (num <= 0f && num2 <= 0f && num3 <= 0f)
					{
						continue;
					}
					PhysGrabber physGrabber = item.physGrabber;
					PhysGrabObject val = (((Object)(object)physGrabber != (Object)null && Game.Get(physGrabber, "grabbed", fallback: false)) ? Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null) : null);
					ItemGun val2 = (((Object)(object)val != (Object)null) ? ((Component)val).GetComponent<ItemGun>() : null);
					if (!((Object)(object)val2 == (Object)null) && !Seen.Contains(val2))
					{
						if (!Tuned.TryGetValue(val2, out Orig value))
						{
							Dictionary<ItemGun, Orig> tuned = Tuned;
							Orig obj = new Orig
							{
								Inv = Game.Get(val2, "investigateRadius", 20f),
								Spread = Game.Get(val2, "gunRandomSpread", 0f),
								Shake = Game.Get(val2, "cameraShakeMultiplier", 1f),
								Recoil = Game.Get(val2, "gunRecoilForce", 1f),
								Bullets = Game.Get(val2, "numberOfBullets", 1)
							};
							value = obj;
							tuned[val2] = obj;
						}
						bool flag = ClassStats.ClassOf(item) == "gunsmith" && ClassStats.Get(item, "gunsmith.recoil") > 0f;
						Game.Set(val2, "investigateRadius", (num > 0f) ? (value.Inv * 0.25f) : value.Inv);
						Game.Set(val2, "gunRandomSpread", (num2 > 0f) ? Mathf.Max(value.Spread * 1.8f, value.Spread + 8f) : value.Spread);
						Game.Set(val2, "numberOfBullets", (num2 > 0f) ? (value.Bullets + 1) : value.Bullets);
						Game.Set(val2, "cameraShakeMultiplier", (num3 > 0f) ? (value.Shake * 0.3f) : value.Shake);
						if (num3 > 0f && !flag)
						{
							Game.Set(val2, "gunRecoilForce", value.Recoil * 0.3f);
							value.Recoiled = true;
						}
						else if (value.Recoiled && !flag)
						{
							Game.Set(val2, "gunRecoilForce", value.Recoil);
							value.Recoiled = false;
						}
						Seen.Add(val2);
					}
				}
			}
			if (Tuned.Count == 0)
			{
				return;
			}
			Gone.Clear();
			foreach (KeyValuePair<ItemGun, Orig> item2 in Tuned)
			{
				if (!Seen.Contains(item2.Key))
				{
					Gone.Add(item2.Key);
				}
			}
			foreach (ItemGun item3 in Gone)
			{
				Orig o = Tuned[item3];
				Tuned.Remove(item3);
				if (!((Object)(object)item3 == (Object)null))
				{
					Put(item3, o);
				}
			}
		}

		private static void Put(ItemGun gun, Orig o)
		{
			Game.Set(gun, "investigateRadius", o.Inv);
			Game.Set(gun, "gunRandomSpread", o.Spread);
			Game.Set(gun, "numberOfBullets", o.Bullets);
			Game.Set(gun, "cameraShakeMultiplier", o.Shake);
			if (o.Recoiled)
			{
				Game.Set(gun, "gunRecoilForce", o.Recoil);
			}
		}

		public static void Reset()
		{
			foreach (KeyValuePair<ItemGun, Orig> item in Tuned)
			{
				if ((Object)(object)item.Key != (Object)null)
				{
					Put(item.Key, item.Value);
				}
			}
			Tuned.Clear();
		}
	}
