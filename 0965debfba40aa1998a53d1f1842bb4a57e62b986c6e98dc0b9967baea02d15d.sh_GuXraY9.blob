			attrDetailInfo.Begin(num2.ToString());
			int num3 = run.AttributePoints(attrFocus.id);
			int num4 = AttrPendingOf(attrFocus.id);
			int num5 = num3 + num4;
			attrDetailInfo.Type = attrFocus.category + " · " + ((num4 > 0) ? $"{num3} → {num5}/{attrFocus.maxPoints} points" : $"{num3}/{attrFocus.maxPoints} points");
			attrDetailInfo.Name = attrFocus.name;
			if (num4 > 0)
			{
				attrDetailInfo.Status.Add((UiStatus.Pending, $"+{num4} pending"));
			}
			if (num5 >= attrFocus.maxPoints)
			{
				attrDetailInfo.Status.Add((UiStatus.Maxed, ""));
			}
			if (AttrBonus.IsFavored(Current?.id, attrFocus.id))
			{
				attrDetailInfo.Status.Add((UiStatus.Selected, "Suggested for your class"));
			}
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append(attrFocus.desc).Append('\n').Append(_sNow);
			stringBuilder.Append("\n\n<b>MILESTONES</b>  <color=#9a9ca0>" + _sMilesSum + "</color>");
			foreach (var sMile in _sMiles)
			{
				stringBuilder.Append('\n').Append(sMile.full);
			}
			stringBuilder.Append("\n\n<b>PAIRINGS</b>  <color=#9a9ca0>" + _sPairsSum + "</color>");
			foreach (var sPair in _sPairs)
			{
				stringBuilder.Append('\n').Append(sPair.full);
			}
