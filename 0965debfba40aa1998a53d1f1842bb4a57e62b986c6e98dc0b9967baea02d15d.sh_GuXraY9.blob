		private void BuildNoticeRows()
		{
			//IL_01a4: Unknown result type (might be due to invalid IL or missing references)
			//IL_01f5: Unknown result type (might be due to invalid IL or missing references)
			//IL_0139: Unknown result type (might be due to invalid IL or missing references)
			_nlRows.Clear();
			_nlRowIds.Clear();
			int num = 0;
			int num2 = 0;
			StringBuilder stringBuilder = new StringBuilder();
			foreach (ActionNotice item in Notices.Active)
			{
				if ((_nCtx == 1 && !item.IsVote) || !OnScreen(item))
				{
					continue;
				}
				if (!item.Important)
				{
					stringBuilder.Append((stringBuilder.Length > 0) ? "  " : "").Append((item.Short != "") ? item.Short : item.Title.ToUpperInvariant());
					continue;
				}
				num++;
				if (num2 < 5)
				{
					num2++;
					string text = Countdown(item);
					_nlRows.Add((NoticeMark(item) + " <b>" + item.Title + "</b>  → " + TabPath(item.Tab) + ((text != "") ? ("  <color=#d8d8dc>(" + text + ")</color>") : ""), NoticeColor(item), item.Id == _nSelId));
					_nlRowIds.Add(item.Id);
				}
			}
			if (num > num2)
			{
				_nlRows.Add(($"+{num - num2} more", TextMain, false));
				_nlRowIds.Add("");
			}
			if (stringBuilder.Length > 0)
			{
				_nlRows.Add(("· UNSPENT: " + stringBuilder?.ToString() + "  → " + MinorTabs(), NoticeMinorCol, IsMinorSelected()));
				_nlRowIds.Add("\u0001minor");
			}
			_nlHead = ((num > 0) ? $"ACTION NEEDED ({num})" : "REMINDERS");
			_nlFoot = "[" + MenuPrompt + "] open   [" + NoticeCyclePrompt + "] next   [" + NoticeDismissPrompt + "] dismiss (hold: all)";
			_nlW = TextW(_nlFoot, _small);
			foreach (var nlRow in _nlRows)
			{
				_nlW = Mathf.Max(_nlW, TextW(nlRow.text, _small));
			}
			_nlW = Mathf.Max(_nlW, TextW(_nlHead, _small));
		}

		private string MinorTabs()
		{
			List<string> list = new List<string>(3);
			foreach (ActionNotice item in Notices.Active)
			{
				if (!item.Important && !list.Contains(item.Tab))
				{
					list.Add(item.Tab);
				}
			}
			return string.Join(" / ", list);
		}

		private bool IsMinorSelected()
		{
			ActionNotice actionNotice = ((_nSelId != "") ? NoticeById(_nSelId) : null);
			if (actionNotice != null)
			{
				return !actionNotice.Important;
			}
			return false;
		}

		private bool IsDismissed(ActionNotice n)
		{
			if (!n.Important)
			{
				return _nDismissed.Contains(n.Id + "@" + RunInfo.LevelIndex);
			}
			return _nDismissed.Contains(n.Id);
		}

		private bool OnScreen(ActionNotice n)
		{
			if (IsDismissed(n))
			{
				return false;
			}
			ModConfig cfg = Plugin.Cfg;
			if (!_nRecalled.Contains(n.Id))
			{
				if ((n.IsVote && cfg.NoticeHideVotes.Value) || (n.Kind == NoticeKind.Choice && cfg.NoticeHideChoices.Value) || (!n.Important && cfg.NoticeHideReminders.Value))
				{
					return false;
				}
				float value = cfg.NoticeAutoHide.Value;
				if (value > 0.5f && Time.unscaledTime - n.Since > value)
				{
					return false;
				}
			}
			return true;
		}

		private void DismissNotice(string id)
		{
			if (id == "")
			{
				return;
			}
			if (id == "\u0001minor")
			{
				foreach (ActionNotice item in Notices.Active)
				{
					if (!item.Important)
					{
						_nDismissed.Add(item.Id + "@" + RunInfo.LevelIndex);
					}
				}
			}
			else
			{
				_nDismissed.Add(id);
			}
			_nRecalled.Remove(id);
			if (_nSelId == id)
			{
				_nSelId = "";
			}
			_nbIds.Remove(id);
			_nbBuilt = -1;
			_nlBuilt = -1;
			MenuSound(UiSound.Tick);
			Plugin.Log.LogInfo((object)("[notices] dismissed " + ((id == "\u0001minor") ? "the reminders" : id) + " (hidden on screen only; still in the menu)."));
		}

		private void DismissSelected()
		{
			ActionNotice actionNotice = ((_nSelId != "") ? NoticeById(_nSelId) : null);
			if (actionNotice != null && OnScreen(actionNotice))
			{
				DismissNotice(actionNotice.Important ? actionNotice.Id : "\u0001minor");
				return;
			}
			foreach (ActionNotice item in Notices.Active)
			{
				if (OnScreen(item) && (_nCtx != 1 || item.IsVote))
				{
					DismissNotice(item.Important ? item.Id : "\u0001minor");
					break;
				}
			}
		}

		private void DismissAll()
		{
			int num = 0;
			foreach (ActionNotice item in Notices.Active)
			{
				if (OnScreen(item))
				{
					if (item.Important)
					{
						_nDismissed.Add(item.Id);
					}
					else
					{
						_nDismissed.Add(item.Id + "@" + RunInfo.LevelIndex);
					}
					num++;
				}
			}
			_nRecalled.Clear();
			_nSelId = "";
			_nbIds.Clear();
			_nbBuilt = -1;
			_nlBuilt = -1;
			if (num > 0)
			{
				MenuSound(UiSound.Back);
				Plugin.Log.LogInfo((object)$"[notices] dismissed all ({num}) on screen; still in the menu.");
			}
		}

