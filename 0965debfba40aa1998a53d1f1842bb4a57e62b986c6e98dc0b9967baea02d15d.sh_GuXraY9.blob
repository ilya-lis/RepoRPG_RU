					_resEPawnTarget = list2[(num2 - 1 + list2.Count) % list2.Count].uid;
				}
			};
			if (Btn(r, (gearItem == null) ? "Item: no gear to pawn" : ("Item: " + gearItem.name + " (" + Cursed.RarityName(gearItem) + (run.IsEquipped(gearItem) ? ", equipped" : "") + ")"), gearItem != null))
			{
				action();
			}
			AdjustHandlers(r, dec, action);
			y += BtnH + 4f;
			if (gearItem != null)
			{
				int salvageValue = SalvagePreview(gearItem);
				int num = ResearchEcon.PawnPay(salvageValue);
				int amount = ResearchEcon.PawnPrice(salvageValue);
				bool flag = _resEPawnPending.Count > 0;
				string text = ((!open) ? "Shop closed - it opens between levels" : ((num <= 0) ? "Worth nothing to the pawn counter" : (flag ? "Waiting for the host" : "")));
				string label = ((text == "") ? ("Pawn it: +" + Scrap.Price(num) + " (buy back " + Scrap.Price(amount) + ")") : text);
				GearItem target = gearItem;
				if (Btn(new Rect(((Rect)(ref area)).x, y, ((Rect)(ref area)).width, BtnH), label, text == ""))
				{
					AskConfirm("PAWN?", "Pawn " + target.name + " for " + Scrap.Price(num) + "? You can buy it back for " + Scrap.Price(amount) + " until the run ends." + (run.IsEquipped(target) ? " It's equipped: it will be unequipped first." : "") + " Its modules go back to your bag.", "Pawn", delegate
					{
						RequestPawnE(target.uid);
					}, focusCancel: true);
				}
				y += BtnH + 8f;
			}
			foreach (PawnTicket item in new List<PawnTicket>(ec.pawned))
			{
				PawnTicket tk = item;
				int price = item.price;
				string desc = Cursed.RarityName(item.item) + " " + Gear.SlotName(item.item.slot) + ": " + string.Join(" · ", Lines(item.item)) + "\n<color=#9a9ca0>Pawned for " + Scrap.Price(item.paid) + ". Exact price: " + Scrap.Price(price) + " (discounts don't apply)</color>";
				y = ShopRow(area, y, "Pawned: " + item.item.name, desc, price, open && Scrap.Mine + 1E-06 >= (double)price, delegate
				{
					AskPurchase("BUY BACK?", "Buy back " + tk.item.name + " for " + Scrap.Price(price) + "?", delegate
					{
						PawnBuyBackE(tk);
					});
				}, (Scrap.Mine + 1E-06 < (double)price) ? ("Need " + Scrap.Format(Math.Ceiling((double)price - Scrap.Mine)) + " more " + Scrap.Short) : "");
			}
			return y + 8f;
		}

		private void RequestPawnE(string uid)
		{
			RunSave data = _store.Data;
			GearItem gearItem = data.FindItem(uid);
			if (gearItem == null || SalvagePending(uid) || Starters.Is(gearItem))
			{
				return;
			}
			float unscaledTime = Time.unscaledTime;
			foreach (int item in new List<int>(_resEPawnPending.Keys))
			{
				if (unscaledTime - _resEPawnPending[item].At > 15f)
				{
					_resEPawnPending.Remove(item);
				}
			}
			foreach (PendingPawn value in _resEPawnPending.Values)
			{
				if (value.Uid == uid)
				{
					return;
				}
			}
			if (data.IsEquipped(gearItem))
			{
				Unequip(gearItem);
			}
			_store.MarkDirty();
			_store.SaveNow();
			int num = ++_resEPawnSeq;
			_resEPawnPending[num] = new PendingPawn
			{
				Uid = uid,
				Item = gearItem,
				At = unscaledTime
			};
			Net.SendPawnE(num, uid);
		}

		public void OnPawnResultE(int id, bool ok, string uid, int pay, int price, string reason)
		{
			//IL_00f0: Unknown result type (might be due to invalid IL or missing references)
			//IL_0204: Unknown result type (might be due to invalid IL or missing references)
			_resEPawnPending.TryGetValue(id, out PendingPawn value);
			_resEPawnPending.Remove(id);
			RunSave data = _store.Data;
			if (!ok)
			{
				if (value != null)
				{
					Toast("Couldn't pawn " + value.Item.name + ": " + reason switch
					{
						"equipped" => "unequip it first", 
						"gone" => "the host doesn't have that item (try again in a moment)", 
						"done" => "it was already sold or salvaged", 
						"shop closed" => "the shop is closed", 
						"off" => "the Pawn Counter isn't on in this lobby", 
						"worthless" => "it's worth nothing", 
						_ => reason, 
					}, Bad);
					MenuSound(UiSound.Error);
				}
				return;
			}
			GearItem gearItem = data.FindItem(uid) ?? value?.Item;
			if (gearItem != null)
			{
				Unequip(gearItem);
				ModulesBackToBag(gearItem);
				data.inventory.Remove(gearItem);
				GearItem gearItem2 = CopyE(gearItem);
				gearItem2.modules = new string[gearItem2.sockets];
				for (int i = 0; i < gearItem2.modules.Length; i++)
				{
					gearItem2.modules[i] = "";
				}
				ResearchEconSave researchEconSave = Econ(data);
				researchEconSave.pawned.RemoveAll((PawnTicket t) => t.uid == uid);
				researchEconSave.pawned.Add(new PawnTicket
				{
					uid = uid,
					item = gearItem2,
					paid = pay,
					price = price
				});
				Toast("Pawned " + gearItem.name + " for " + Scrap.Price(pay), new Color(1f, 0.74f, 0.22f));
			}
			if (!data.salvaged.Contains(uid))
			{
				data.salvaged.Add(uid);
			}
			_gearSig = int.MinValue;
			_statsDirty = true;
			_store.MarkDirty();
			_store.SaveNow();
			MenuSound(UiSound.Confirm);
		}

		private void PawnBuyBackE(PawnTicket t)
		{
			PawnTicket tk = t;
			Buy("buyback:pawn:" + t.uid, "buy back " + t.item.name, t.price, delegate
			{
				ResearchEconSave researchEconSave = Econ(_store.Data);
				if (researchEconSave.pawned.Contains(tk))
				{
					researchEconSave.pawned.Remove(tk);
					GearItem gearItem = CopyE(tk.item);
					gearItem.uid = Guid.NewGuid().ToString("N").Substring(0, 12);
					gearItem.freeValue = 0;
					gearItem.scrapIn = Mathf.Max(0, _lastCharged);
					ResolveE(gearItem);
					GiveGear(gearItem, "pawn counter");
				}
			});
		}

		internal static (bool ok, int pay, int price, string reason) HostPawnE(int actor, string steamId, string uid, bool isLocal)
		{
			if (!Research.Lobby("pawn_counter"))
			{
				return (ok: false, pay: 0, price: 0, reason: "off");
			}
			if (!Shop.OpenNow)
			{
				return (ok: false, pay: 0, price: 0, reason: "shop closed");
			}
			RpgRuntime instance = Instance;
			RunSave runSave = ((!isLocal) ? SaveBook.Get(RunInfo.Key, steamId) : instance?._store.Data);
			if (runSave == null || (RunStore.IsTempKey(RunInfo.Key) && !isLocal))
			{
				return (ok: false, pay: 0, price: 0, reason: "not verified");
			}
			if (runSave.salvaged.Contains(uid))
			{
				return (ok: false, pay: 0, price: 0, reason: "done");
			}
			GearItem gearItem = runSave.FindItem(uid);
			if (gearItem == null)
			{
				return (ok: false, pay: 0, price: 0, reason: "gone");
			}
			if (runSave.IsEquipped(gearItem))
			{
				return (ok: false, pay: 0, price: 0, reason: "equipped");
			}
			if (Starters.Is(gearItem))
			{
				return (ok: false, pay: 0, price: 0, reason: "worthless");
			}
			float scrapBonusPct = ((!isLocal) ? Scrap.BonusOf(actor) : (instance?.StatValue(Stat.ScrapBonus) ?? 0f));
			int salvageValue = SalvageCalc.Value(gearItem, scrapBonusPct);
			int num = ResearchEcon.PawnPay(salvageValue);
			int num2 = ResearchEcon.PawnPrice(salvageValue);
			if (num <= 0)
			{
				return (ok: false, pay: 0, price: 0, reason: "worthless");
			}
			runSave.inventory.Remove(gearItem);
			runSave.salvaged.Add(uid);
			if (runSave.salvaged.Count > 400)
			{
				runSave.salvaged.RemoveRange(0, runSave.salvaged.Count - 400);
			}
			string steamId2 = ((steamId == "") ? "local" : steamId);
			ResearchEcon.HostNotePawn(steamId2, uid, num2);
			double balance = SaveBook.AddScrap(RunInfo.Key, steamId2, num);
			if (!isLocal)
			{
				SaveBook.MarkDirty();
			}
			Scrap.Tell(actor, steamId2, balance, num, "Pawned " + gearItem.name);
			Plugin.Log.LogInfo((object)$"[research] pawn: {ClassClaims.NameOf(actor)} pawned {Gear.Rarity(gearItem.rarity).name} {gearItem.name} for {num} {Scrap.Short} (buy back {num2}).");
			return (ok: true, pay: num, price: num2, reason: "");
		}

		internal static int HostPawnFallbackE(int actor, string steamId, string uid)
		{
			PawnTicket pawnTicket = ((Game.IsMultiplayer() && actor != ClassClaims.LocalActor) ? SaveBook.Get(RunInfo.Key, steamId) : Instance?._store.Data)?.econ?.pawned?.Find((PawnTicket x) => x != null && x.uid == uid);
			if (pawnTicket == null || pawnTicket.item == null)
			{
				return -1;
			}
			GearItem item = pawnTicket.item;
			ClassDatabase.ResolveAll("pawn", item.effects ?? (item.effects = Array.Empty<EffectDef>()));
			return Mathf.Max(pawnTicket.price, ResearchEcon.PawnPrice(SalvageCalc.Value(pawnTicket.item, 0f)));
		}

		private float DrawFuturesE(Rect area, float y, RunSave run, ResearchEconSave ec, bool open)
