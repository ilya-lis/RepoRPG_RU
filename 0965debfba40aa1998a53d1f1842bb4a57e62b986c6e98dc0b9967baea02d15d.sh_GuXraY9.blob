			{
				return;
			}
			_padSent = num;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && ClassStats.ClassOf(item) == "courier")
				{
					Net.SendNotice(item, Notice.Courier, _padCredit, $"pad|{count}|{slots}");
