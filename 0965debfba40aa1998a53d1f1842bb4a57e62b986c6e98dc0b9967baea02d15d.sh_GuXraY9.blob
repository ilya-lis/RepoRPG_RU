		{
			Seen.Clear();
			SeenPad = false;
			SeenAnomaly = false;
			SeenLevel = int.MinValue;
		}
	}
	internal static class Roster
	{
		public sealed class Row
		{
			public int Actor;

			public int Level;

			public int Unspent;

			public int Join;

			public float Xp;

			public string Name = "";

			public string Class = "";

			public bool Mastered;

			public bool Choosing;

			public bool Host;

			public bool Down;
		}

		public static readonly List<Row> Rows = new List<Row>();

		private static string _applied = "";

		private static string _sent = "";

		private static float _nextBuild;

		private static float _nextResend;

		private static float _nextChoosing;

		private static bool _choosingSent;

		private static readonly Dictionary<int, bool> ChoosingOf = new Dictionary<int, bool>();

		private static readonly StringBuilder Sb = new StringBuilder();

		public static int Version { get; private set; }

		public static Row? Of(int actor)
		{
			foreach (Row row in Rows)
			{
				if (row.Actor == actor)
				{
					return row;
				}
			}
			return null;
		}

		public static void Tick()
		{
			float unscaledTime = Time.unscaledTime;
			RpgRuntime instance = RpgRuntime.Instance;
			bool flag = (Object)(object)instance != (Object)null && instance.ChoosingClass;
			bool flag2 = !Game.IsMultiplayer() || !PhotonNetwork.InRoom;
			if (flag != _choosingSent || unscaledTime >= _nextChoosing)
			{
				_choosingSent = flag;
				_nextChoosing = unscaledTime + 10f;
				if (flag2 || PhotonNetwork.IsMasterClient)
				{
					ChoosingOf[ClassClaims.LocalActor] = flag;
				}
				else
				{
					Net.SendRosterChoosing(flag);
				}
			}
			if ((flag2 || PhotonNetwork.IsMasterClient) && !(unscaledTime < _nextBuild))
			{
				_nextBuild = unscaledTime + 0.5f;
				string text = Build();
				bool flag3 = text != _sent;
				if (flag3)
				{
					Apply(text);
				}
				if (!flag2 && (flag3 || unscaledTime >= _nextResend))
				{
					_sent = text;
					_nextResend = unscaledTime + 10f;
					Net.SendRoster(text);
				}
				else if (flag2)
				{
					_sent = text;
				}
			}
		}

		public static void OnChoosing(int actor, bool on)
		{
			ChoosingOf[actor] = on;
		}

		public static void PlayerLeft(int actor)
		{
			ChoosingOf.Remove(actor);
		}

		private static string Clean(string s)
		{
			return (s ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
		}

		private static string Build()
		{
			Sb.Clear();
			RpgRuntime instance = RpgRuntime.Instance;
			int localActor = ClassClaims.LocalActor;
			List<PlayerAvatar> list = Game.Players();
			if (!Game.IsMultiplayer() || !PhotonNetwork.InRoom)
			{
				PlayerAvatar val = Game.LocalPlayer();
				Line(localActor, ((Object)(object)val != (Object)null) ? Game.Get(val, "playerName", "You") : "You", host: true, val, instance, 0);
			}
			else
			{
				int num = 0;
				Player[] playerList = PhotonNetwork.PlayerList;
				foreach (Player val2 in playerList)
				{
					if (val2 == null || num >= 24)
					{
						continue;
					}
					PlayerAvatar av = null;
					foreach (PlayerAvatar item in list)
					{
						if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == val2.ActorNumber)
						{
							av = item;
							break;
						}
					}
					Line(val2.ActorNumber, val2.NickName ?? "Player", val2.IsMasterClient, av, instance, val2.ActorNumber);
					num++;
				}
			}
			return Sb.ToString();
		}

		private static void Line(int actor, string name, bool host, PlayerAvatar? av, RpgRuntime? rt, int join)
		{
			bool flag = actor == ClassClaims.LocalActor || !Game.IsMultiplayer();
			string cls = ((!flag) ? ClassClaims.ClassOf(actor) : (rt?.CurrentId ?? ""));
			if (cls == "" && (Object)(object)av != (Object)null)
			{
				cls = ClassStats.ClassOf(av);
			}
			int value = 0;
			int value2 = 0;
			int value3 = 0;
			ClassProgress classProgress = null;
			if (cls != "")
			{
				if (flag)
				{
					classProgress = rt?.CurrentProgress;
				}
				else if ((Object)(object)av != (Object)null)
				{
					string text = Game.SteamId(av);
					classProgress = ((text != "") ? SaveBook.Get(RunInfo.Key, text) : null)?.classes.Find((ClassProgress c) => c.classId == cls);
				}
			}
			if (classProgress != null)
			{
				value = classProgress.level;
				value2 = Math.Max(0, Leveling.AvailablePoints(classProgress));
				int num = ((classProgress.level < Leveling.MaxLevel) ? Math.Max(1, Leveling.XpToNext(classProgress.level)) : 0);
				value3 = ((num > 0) ? Mathf.Clamp(Mathf.RoundToInt((float)classProgress.xp * 100f / (float)num), 0, 100) : 100);
			}
			bool num2 = cls != "" && (flag ? Account.Mastered(cls) : (Account.PeerOf(actor)?.Mastered.Contains(cls) ?? false));
			ChoosingOf.TryGetValue(flag ? ClassClaims.LocalActor : actor, out var value4);
			bool flag2 = (Object)(object)av != (Object)null && Game.InLevel() && !Game.IsAlive(av);
			int value5 = (int)((num2 ? 1u : 0u) | (uint)((value4 && cls == "") ? 2 : 0) | (uint)(host ? 4 : 0)) | (flag2 ? 8 : 0);
			Sb.Append(actor).Append('\t').Append(Clean(name))
				.Append('\t')
				.Append(cls)
				.Append('\t')
				.Append(value)
				.Append('\t')
				.Append(value3)
				.Append('\t')
				.Append(value2)
				.Append('\t')
				.Append(value5)
				.Append('\t')
				.Append(join)
				.Append('\n');
		}

		public static void Apply(string text)
		{
			if (text == null || text.Length > 8000 || text == _applied)
			{
				return;
			}
			_applied = text;
			Rows.Clear();
			string[] array = text.Split('\n');
			for (int i = 0; i < array.Length; i++)
			{
				string[] array2 = array[i].Split('\t');
				if (array2.Length >= 8 && int.TryParse(array2[0], out var result))
				{
					int.TryParse(array2[3], NumberStyles.Integer, CultureInfo.InvariantCulture, out var result2);
					int.TryParse(array2[4], NumberStyles.Integer, CultureInfo.InvariantCulture, out var result3);
					int.TryParse(array2[5], NumberStyles.Integer, CultureInfo.InvariantCulture, out var result4);
					int.TryParse(array2[6], NumberStyles.Integer, CultureInfo.InvariantCulture, out var result5);
					int.TryParse(array2[7], NumberStyles.Integer, CultureInfo.InvariantCulture, out var result6);
					string text2 = ((Plugin.Db.Get(array2[2]) != null) ? array2[2] : "");
					Rows.Add(new Row
					{
						Actor = result,
						Name = ((array2[1].Length > 32) ? array2[1].Substring(0, 32) : array2[1]),
						Class = text2,
						Level = Mathf.Clamp(result2, 0, 999),
						Xp = Mathf.Clamp01((float)result3 / 100f),
						Unspent = Mathf.Clamp(result4, 0, 999),
						Join = result6,
						Mastered = ((result5 & 1) != 0),
						Choosing = ((result5 & 2) != 0),
						Host = ((result5 & 4) != 0),
						Down = ((result5 & 8) != 0)
					});
					if (Rows.Count >= 24)
					{
						break;
					}
				}
			}
			Version++;
		}

		public static void Clear()
		{
			Rows.Clear();
			ChoosingOf.Clear();
			_applied = "";
			_sent = "";
			_nextResend = 0f;
			Version++;
		}
	}
