							if (num3 > 0f && __0 < Game.Health(__instance))
							{
								__0 = Mathf.Max(1, Mathf.RoundToInt((float)__0 * (1f + 0.2f * num3)));
							}
						}
					}
					float num4 = PlayerScaling.DamageTaken;
					if (num2 != 0 && Elements.On && (Object)(object)__instance == (Object)(object)Game.LocalPlayer()?.playerHealth)
					{
