		private void BuildContractLines(List<(string, Color)> lines, RunSave run)
		{
			//IL_0027: Unknown result type (might be due to invalid IL or missing references)
			//IL_01f5: Unknown result type (might be due to invalid IL or missing references)
			//IL_01df: Unknown result type (might be due to invalid IL or missing references)
			//IL_01c9: Unknown result type (might be due to invalid IL or missing references)
			lines.Clear();
			if (run.contractLevel != RunInfo.LevelIndex || run.contracts.Count == 0)
			{
				return;
			}
			lines.Add(("CONTRACTS", Accent));
			bool flag = run.contracts.Count > 4;
			foreach (ContractState contract in run.contracts)
			{
				string text = ((contract.status == 1) ? "[done] " : ((contract.status == 2) ? "[failed] " : ""));
				string text3;
				if (contract.type != "Board")
				{
					string text2 = ((contract.status == 0 && contract.target > 1 && contract.type != "Speedrun") ? $" ({contract.progress}/{contract.target})" : "");
					text3 = text + Contracts.Title(contract) + text2;
				}
				else
				{
					string text4 = ((contract.status != 0) ? "" : HudCount(contract));
					string text5 = ((contract.bonus == "") ? "" : ((contract.bonusState == 1) ? " +BONUS" : ((contract.bonusState == 2) ? "" : " (+bonus)")));
					text3 = ((flag || contract.status != 0) ? (text + ContractBoard.Name(contract) + text4 + text5) : (text + ContractBoard.Name(contract) + ": " + ContractBoard.Objective(contract) + text4 + text5));
				}
				lines.Add((text3.ToUpperInvariant(), (contract.status == 1) ? new Color(0.6f, 1f, 0.6f) : ((contract.status == 2) ? new Color(0.6f, 0.6f, 0.6f) : new Color(0.95f, 0.85f, 0.6f))));
			}
		}

		private static string HudCount(ContractState c)
		{
			switch (c.obj)
			{
			case "speed":
			case "speedall":
			case "nodeath":
				return "";
			case "unscathed":
				return $" ({c.progress}/{c.target} DMG)";
			case "value":
			case "strictvalue":
			case "cls.appraiser":
			case "cls.restorer":
				return $" (${c.progress:N0}/${c.target:N0})";
			default:
				if (c.kind != 2 && (c.target > 1 || !(c.bonus != "double")))
				{
					return $" ({c.progress}/{c.target})";
				}
				return "";
			}
		}

