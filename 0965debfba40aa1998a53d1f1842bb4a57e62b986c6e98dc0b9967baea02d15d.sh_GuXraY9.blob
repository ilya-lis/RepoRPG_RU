		private static bool IsNavKey(KeyCode k)
		{
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			//IL_0013: Unknown result type (might be due to invalid IL or missing references)
			//IL_0021: Unknown result type (might be due to invalid IL or missing references)
			//IL_002f: Unknown result type (might be due to invalid IL or missing references)
			if (Array.IndexOf(NavKeysUp, k) < 0 && Array.IndexOf(NavKeysDown, k) < 0 && Array.IndexOf(NavKeysLeft, k) < 0)
			{
				return Array.IndexOf(NavKeysRight, k) >= 0;
			}
			return true;
		}

		private static string PrettyChord(string chord)
		{
			if (string.IsNullOrWhiteSpace(chord))
			{
				return "UNBOUND";
			}
			string[] array = chord.Split('+');
			for (int i = 0; i < array.Length; i++)
			{
				string text = array[i].Trim().ToLowerInvariant();
				string[] array2 = array;
				int num = i;
				array2[num] = text switch
				{
					"up" => "D-PAD UP", 
					"down" => "D-PAD DOWN", 
					"left" => "D-PAD LEFT", 
					"right" => "D-PAD RIGHT", 
					"ls" => "L-STICK CLICK", 
					"rs" => "R-STICK CLICK", 
					"select" => "VIEW / SELECT", 
					"start" => "MENU / START", 
					_ => text.ToUpperInvariant(), 
				};
			}
			return string.Join(" + ", array);
		}

