			{
				string text2 = ((text.Length > 60) ? text.Substring(0, 60) : text);
				string item = text2 + VanillaStyle.Hex(fg);
				if (Logged.Count <= 2000 && Logged.Add(item))
				{
					Plugin.Log.LogWarning((object)$"Contrast {num:0.00}:1 (needs {min:0.#}:1): \"{text2}\" {VanillaStyle.Hex(fg)} on {VanillaStyle.Hex(bg)}");
				}
			}
		}
	}
