		private bool CanAffordShop(int price)
		{
			if (price > 0)
			{
				return Scrap.Mine + 1E-06 >= (double)Shop.Price(price);
			}
			return true;
		}

		private void BuyEntry(ShopEntry e)
		{
			//IL_0100: Unknown result type (might be due to invalid IL or missing references)
			//IL_007e: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c9: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			if (e.sold)
			{
				return;
			}
			if (!CanAffordShop(e.price))
			{
				Vendor(ShopX.VendorBroke);
				MenuSound(UiSound.Error);
				return;
			}
			if (e.kind == "cons")
			{
				if (ShopX.Cons(e.id) == null)
				{
					return;
				}
				if (data.consBought.Contains(e.id))
				{
					Toast("One of each consumable per visit", Bad);
					return;
				}
				if (data.consBought.Count >= Plugin.Cfg.ShopConsumablesPerLevel.Value)
				{
					Toast($"Consumable limit reached ({Plugin.Cfg.ShopConsumablesPerLevel.Value} per visit)", Bad);
					return;
				}
			}
			if (e.kind == "module" && data.moduleBag.Count >= 10)
			{
				Toast("Your module bag is full", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			string label = ((e.kind == "gear") ? e.item.name : ((!(e.kind == "module")) ? (ShopX.Cons(e.id)?.name ?? "item") : (GearX.Module(e.id)?.name ?? "module")));
			ShopEntry entry = e;
			Buy(e.key, label + (e.featured ? " (featured)" : ""), e.price, delegate
			{
				RunSave data2 = _store.Data;
				if (!entry.sold)
				{
					entry.sold = true;
					if (entry.kind == "gear" && entry.item != null)
					{
						GearItem item = entry.item;
						entry.item = CloneGear(item);
						item.uid = Guid.NewGuid().ToString("N").Substring(0, 12);
						item.freeValue = 0;
						item.scrapIn = Mathf.Max(0, _lastCharged);
						GiveGear(item, "mod shop");
					}
					else if (entry.kind == "module")
					{
						AddModule(entry.id, "mod shop");
					}
					else if (entry.kind == "cons")
					{
						if (!data2.consBought.Contains(entry.id))
						{
							data2.consBought.Add(entry.id);
						}
						if (!data2.consActive.Contains(entry.id))
						{
							data2.consActive.Add(entry.id);
						}
						_statsDirty = true;
					}
					_shopFlash[label] = Time.unscaledTime;
					Vendor(ShopX.VendorBuy);
					_store.MarkDirty();
				}
			});
		}

		private void LockEntry(ShopEntry e)
		{
			//IL_0061: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a8: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			int num = 0;
			foreach (ShopEntry item in data.shopStock)
			{
				if (item.locked)
				{
					num++;
				}
			}
			if (ShopTier < 1)
			{
				Toast("Locks unlock at Customer reputation", Bad);
				return;
			}
			if (e.locked)
			{
				e.locked = false;
				_store.MarkDirty();
				return;
			}
			int shopMaxLocksE = ShopMaxLocksE;
			if (num >= shopMaxLocksE)
			{
				Toast($"You can lock {shopMaxLocksE} items at most", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			ShopEntry entry = e;
			bool freeLock = FreeLockReadyE;
			Buy("lock", "lock " + (e.item?.name ?? e.id), (!freeLock) ? Plugin.Cfg.ShopLockFee.Value : 0, delegate
			{
				entry.locked = true;
				if (freeLock)
				{
					UseFreeLockE();
				}
				_store.MarkDirty();
			});
		}

