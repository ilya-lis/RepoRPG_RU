					Plugin.Log.LogWarning((object)("[death] made a missing death head for " + Game.Get(item, "playerName", "?") + " (the game's level start didn't)."));
				}
			}
		}

		private void LogDeathSequence(PlayerAvatar me)
		{
			Plugin.Log.LogInfo((object)("[death] local player died: " + DeathState(me)));
			((MonoBehaviour)this).StartCoroutine(DeathFollowUp(me));
		}

		private IEnumerator DeathFollowUp(PlayerAvatar me)
		{
			float[] array = new float[2] { 1.5f, 4f };
			foreach (float wait in array)
			{
				yield return (object)new WaitForSeconds(wait);
				if ((Object)(object)me == (Object)null || !Game.InLevel())
				{
					break;
				}
				Plugin.Log.LogInfo((object)$"[death] +{((wait > 2f) ? 5.5f : 1.5f):0.#}s: {DeathState(me)}");
			}
		}

		private static string DeathState(PlayerAvatar me)
		{
			try
			{
				PlayerDeathHead val = Game.DeathHead(me);
				SpectateCamera instance = SpectateCamera.instance;
				Camera main = Camera.main;
				return "death head " + ((!((Object)(object)val != (Object)null)) ? "MISSING" : (((Component)val).gameObject.activeInHierarchy ? "active" : "inactive")) + ", " + string.Format("deadSet {0}, disabled {1}, avatar active {2}, ", Game.Get(me, "deadSet", fallback: false), Game.Get(me, "isDisabled", fallback: false), ((Component)me).gameObject.activeInHierarchy) + "spectate camera " + (((Object)(object)instance != (Object)null) ? "on" : "off") + ", main camera " + (((Object)(object)main != (Object)null) ? ((Object)main).name : "none") + ", player controller " + (((Object)(object)PlayerController.instance != (Object)null && (Object)(object)Game.Get<Component>(PlayerController.instance, "playerAvatarScript", null) != (Object)null) ? "ok" : "MISSING");
			}
			catch (Exception ex)
			{
				return "unreadable (" + ex.GetBaseException().Message + ")";
			}
		}

