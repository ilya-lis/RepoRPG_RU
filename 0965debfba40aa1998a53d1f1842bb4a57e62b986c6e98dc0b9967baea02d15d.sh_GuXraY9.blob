			Rect r = default(Rect);
			((Rect)(ref r))..ctor(num3 + btnH + 4f, y, ((Rect)(ref area)).xMax - num3 - 2f * (btnH + 4f), BtnH);
			Fill(r, new Color(0f, 0f, 0f, 0.3f));
			Label(new Rect(((Rect)(ref r)).x + 6f, ((Rect)(ref r)).y + (BtnH - num2) / 2f, ((Rect)(ref r)).width - 12f, num2), value, _smallLine);
			if (Btn(new Rect(((Rect)(ref area)).xMax - btnH, y, btnH, BtnH), "›", count > 1))
