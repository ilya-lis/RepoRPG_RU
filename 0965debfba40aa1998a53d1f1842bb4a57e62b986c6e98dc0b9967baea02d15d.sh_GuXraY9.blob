			{
				Id = "salvage_drill",
				Name = "Salvage Drill",
				Desc = "Monsters drop 25% more crafting parts."
			},
			new Drill
			{
				Id = "bounty_drill",
				Name = "Bounty Drill",
				Desc = "Every elite killed pays everyone 4 Scrap."
			}
		};

		public static readonly string[] SponsorIds = new string[5] { "brass", "kaboom", "hollis", "dispatch", "auditor" };

		public const int SponsorScrap = 150;

		public const int SponsorData = 60;

		public static State Cur = new State();

		public static int MyDrillVote = -1;

		public static int MySponsorVote = -1;

		private static readonly int[] ArchivistBase = new int[3] { 8, 14, 22 };

		private static readonly HashSet<int> SamplesOut = new HashSet<int>();

		private static int _samplesLevel = int.MinValue;

		private static readonly Dictionary<int, int> DrillVotes = new Dictionary<int, int>();

		private static readonly Dictionary<int, int> SponsorVotes = new Dictionary<int, int>();

		private static string _sentSig = "\u0001";

