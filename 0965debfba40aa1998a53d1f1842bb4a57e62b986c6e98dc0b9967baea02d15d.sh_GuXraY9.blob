		private bool WeaponLike(PhysGrabObject held)
		{
			int instanceID = ((Object)held).GetInstanceID();
			if (_weaponLike.TryGetValue(instanceID, out var value))
			{
				return value;
			}
			value = false;
			MonoBehaviour[] componentsInChildren = ((Component)held).GetComponentsInChildren<MonoBehaviour>();
			foreach (MonoBehaviour val in componentsInChildren)
			{
				if (!((Object)(object)val == (Object)null))
				{
					string name = ((object)val).GetType().Name;
					if (name.IndexOf("Gun", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("Melee", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("Weapon", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("Launcher", StringComparison.OrdinalIgnoreCase) >= 0)
					{
						value = true;
						break;
					}
				}
			}
			if (_weaponLike.Count > 256)
			{
				_weaponLike.Clear();
			}
			_weaponLike[instanceID] = value;
			return value;
		}

