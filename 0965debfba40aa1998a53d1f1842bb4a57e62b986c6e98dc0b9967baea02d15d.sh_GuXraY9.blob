			FirstBossLevel = c.Bind<int>("Bosses", "FirstBossLevel", 3, new ConfigDescription("The first level with a boss (1 = the first level).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(1, 50), Array.Empty<object>()));
			BossModifiers = c.Bind<int>("Bosses", "BossModifiers", 3, new ConfigDescription("Modifiers a boss rolls.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(1, 5), Array.Empty<object>()));
			BossHealth1 = c.Bind<float>("Bosses", "BossHealthSolo", 2f, new ConfigDescription("Boss effective health with 1 player (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			BossHealth3 = c.Bind<float>("Bosses", "BossHealth2to3", 2.5f, new ConfigDescription("Boss effective health with 2-3 players (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			BossHealth6 = c.Bind<float>("Bosses", "BossHealth4to6", 3f, new ConfigDescription("Boss effective health with 4-6 players (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			BossHealth10 = c.Bind<float>("Bosses", "BossHealth7to10", 3.5f, new ConfigDescription("Boss effective health with 7-10 players (x).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			BossUniqueChance = c.Bind<float>("Bosses", "BossUniqueChance", 25f, new ConfigDescription("Chance (%) a boss's Legendary drop is a Unique.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
			StartersGear = c.Bind<bool>("Starters", "Gear", true, "Class starter gear: each class gets one small, class-bound Common item once per run (it can't be salvaged for Scrap or rerolled).");
			StartersTools = c.Bind<bool>("Starters", "Tools", true, "Class starter tools: Medic, Trickster, Demolitionist and Gunsmith also get a shop item next to them at their first level of the run (25 Scrap instead if the item isn't in the game).");
			ElementsOn = c.Bind<bool>("Elements", "Enabled", true, "Elemental weapons: Fire, Shock, Frost, Corrosive and Void from Weapon Module affixes, element modules and shop coatings; statuses on monsters, combos, elite resistances and weaknesses.");
			ElementStrength = c.Bind<float>("Elements", "Strength", 100f, new ConfigDescription("How strong elemental effects are (% of normal: damage, stacks' effect, stun and freeze times).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 300f), Array.Empty<object>()));
			ElementVfx = c.Bind<ElementVfx>("Elements", "Vfx", RepoRPG.ElementVfx.Full, "Elemental visuals: Full (weapon glow and status icons), Reduced (status icons only), Off (status icons only, no glow). Reduced effects also turns the glow off.");
			AscensionOn = c.Bind<bool>("Ascension", "Enabled", true, "Ascension: win a run (beat the finale), then replay at higher Ascension levels (up to 20) - each adds a modifier on top of the lower ones, and gives better rewards.");
