			HighlightSeconds = c.Bind<float>("Team", "HighlightSeconds", 10f, new ConfigDescription("How long the highlights card stays up in the shop (seconds). Each player can hide it early or hold its key to keep it.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(5f, 30f), Array.Empty<object>()));
			CallOuts = c.Bind<bool>("Team", "CallOuts", true, "Death heads can call out: a marker teammates can see.");
			CallOutCooldown = c.Bind<float>("Team", "CallOutCooldown", 10f, new ConfigDescription("Seconds between call-outs from one death head.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(3f, 60f), Array.Empty<object>()));
