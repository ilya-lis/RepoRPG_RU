		private int GearSignature(RunSave run)
		{
			HashCode hashCode = default(HashCode);
			hashCode.Add(_gearFilter);
			hashCode.Add(_gearSort);
			hashCode.Add(_gearRarityF);
			hashCode.Add(_gearKindF);
			hashCode.Add(_gearQuery);
			string[] modules;
			foreach (GearItem item in run.inventory)
			{
				hashCode.Add(item.uid);
				hashCode.Add(item.rarity);
				hashCode.Add(item.attune);
				hashCode.Add(RuntimeHelpers.GetHashCode(item));
				modules = item.modules;
				foreach (string value in modules)
				{
					hashCode.Add(value);
				}
			}
			modules = run.equipped;
			foreach (string value2 in modules)
			{
				hashCode.Add(value2);
			}
			hashCode.Add(run.moduleBag.Count);
			hashCode.Add(run.dieLevel);
			hashCode.Add(_newThisView.Count);
			return hashCode.ToHashCode();
		}

		private bool KindMatch(GearItem g)
		{
			return _gearKindF switch
			{
				1 => GearSets.Get(g.set) != null, 
				2 => !string.IsNullOrEmpty(g.unique), 
				3 => _newThisView.Contains(g.uid), 
				4 => g.behavior != "", 
				5 => GearX.Tier(g) >= 1, 
				6 => Cursed.Is(g), 
				_ => true, 
			};
		}

		private void RefreshGear(RunSave run)
		{
			int num = GearSignature(run);
			if (num == _gearSig)
			{
				return;
			}
			_gearSig = num;
			_gearItems.Clear();
			string text = _gearQuery.Trim().ToLowerInvariant();
			foreach (GearItem item in run.inventory)
			{
				if ((!(_gearFilter != "") || !(item.slot != _gearFilter)) && (_gearRarityF < 0 || item.rarity == _gearRarityF) && KindMatch(item) && (!(text != "") || SearchHay(item).Contains(text)))
				{
					_gearItems.Add(item);
				}
			}
			Dictionary<GearItem, int> order = new Dictionary<GearItem, int>();
			for (int i = 0; i < run.inventory.Count; i++)
			{
				order[run.inventory[i]] = i;
			}
			switch (GearSorts[_gearSort % GearSorts.Length])
			{
			case "Slot":
				_gearItems.Sort((GearItem a, GearItem b) => (!(a.slot != b.slot)) ? ByRarity(a, b) : string.CompareOrdinal(a.slot, b.slot));
				break;
			case "Newest":
				_gearItems.Sort((GearItem a, GearItem b) => order[b].CompareTo(order[a]));
				break;
			case "Attunement":
				_gearItems.Sort((GearItem a, GearItem b) => (b.attune == a.attune) ? ByRarity(a, b) : b.attune.CompareTo(a.attune));
				break;
			default:
				_gearItems.Sort(ByRarity);
				break;
			}
			_gearRowText.Clear();
			_inspectText.Clear();
			_rowLabels.Clear();
			BuildGearSide(run);
			static int ByRarity(GearItem a, GearItem b)
			{
				if (b.rarity == a.rarity)
				{
					if (!(a.slot != b.slot))
					{
						return string.CompareOrdinal(a.name, b.name);
					}
					return string.CompareOrdinal(a.slot, b.slot);
				}
				return b.rarity.CompareTo(a.rarity);
			}
		}

		private string SearchHay(GearItem g)
		{
			StringBuilder stringBuilder = new StringBuilder(GearUp.Title(g)).Append(' ').Append(Cursed.RarityName(g)).Append(' ')
				.Append(Gear.SlotName(g.slot));
			CursedDef cursedDef = Cursed.Def(g.cursed);
			if (cursedDef != null)
			{
				stringBuilder.Append(" cursed ").Append(cursedDef.benefit).Append(' ')
					.Append(cursedDef.curse);
			}
			SetDef setDef = GearSets.Get(g.set);
			if (setDef != null)
			{
				stringBuilder.Append(' ').Append(setDef.name).Append(" set");
			}
			if (g.unique != "")
			{
				stringBuilder.Append(" unique ").Append(g.uniqueDesc);
			}
			GearBehaviorDef gearBehaviorDef = GearX.Behavior(g.behavior);
			if (gearBehaviorDef != null)
			{
				stringBuilder.Append(' ').Append(gearBehaviorDef.name).Append(' ')
					.Append(gearBehaviorDef.desc);
			}
			EffectDef[] effects = g.effects;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex >= 0)
				{
					stringBuilder.Append(' ').Append(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
				}
			}
			return stringBuilder.ToString().ToLowerInvariant();
		}

		private static List<string> Lines(GearItem g)
		{
			List<string> list = new List<string>();
			EffectDef[] effects = g.effects;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex >= 0)
				{
					list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
				}
			}
			return list;
		}

		private string CardText(GearItem g)
		{
			if (_gearRowText.TryGetValue(g.uid, out string value))
			{
				return value;
			}
			value = string.Join("  ·  ", Lines(g));
			GearBehaviorDef gearBehaviorDef = GearX.Behavior(g.behavior);
			if (gearBehaviorDef != null)
			{
				value = value + "\n<color=#7fd8ff><b>" + gearBehaviorDef.name + "</b></color>";
			}
			if (g.unique != "")
			{
				value = value + "\n<color=" + Gear.Rarity(g.rarity).color + "><b>UNIQUE</b></color>";
			}
			CursedDef cursedDef = Cursed.Def(g.cursed);
			if (cursedDef != null)
			{
				value = value + "\n<color=#E0344B><b>CURSED</b></color>  <color=#FF8A8A>[!] " + cursedDef.curse + "</color>";
			}
			SetDef setDef = GearSets.Get(g.set);
			if (setDef != null)
			{
				value = value + "  <color=" + setDef.color + ">" + setDef.name + " set</color>";
			}
			_gearRowText[g.uid] = value;
			return value;
		}

		private string InspectText(GearItem g, RunSave run)
		{
			string key = g.uid + (run.IsEquipped(g) ? "e" : "");
			if (_inspectText.TryGetValue(key, out string value))
			{
				return value;
			}
			StringBuilder stringBuilder = new StringBuilder();
			RarityDef rarityDef = Gear.Rarity(g.rarity);
			if (!Starters.Is(g))
			{
				stringBuilder.Append($"<color=#ffd75a>UPGRADE {GearUp.Pips(g)} +{g.up}/{GearUp.Max}</color>\n");
			}
			int num = ((GearX.Tier(g) >= 2) ? GearX.StrongestLine(g) : (-1));
			for (int i = 0; i < g.effects.Length; i++)
			{
				EffectDef effectDef = g.effects[i];
				if (effectDef.StatIndex >= 0)
				{
					string text = ((i == 0 && g.hasBase) ? "  <color=#9a9ca0>(base)</color>" : ((i >= g.effects.Length - g.cursedLines) ? "  <color=#E0344B>(cursed)</color>" : ""));
					if (i == num)
					{
						text += "  <color=#ffd75a>(Tempered +25%)</color>";
					}
					if (i == 0 && GearX.Tier(g) >= 3)
					{
						text += "  <color=#ffd75a>(Soulbound +25%)</color>";
					}
					float num2 = GearUp.LineMult(g, i);
					if (num2 > 1.001f)
					{
						text += $"  <color=#ffd75a>(upgraded +{(num2 - 1f) * 100f:0}%)</color>";
					}
					stringBuilder.Append(StatInfo.Describe((Stat)effectDef.StatIndex, GearUp.Shown(effectDef.value * num2))).Append(text).Append('\n');
				}
			}
			for (int j = 0; j < g.upFx.Length; j++)
			{
				EffectDef effectDef2 = g.upFx[j];
				if (effectDef2.StatIndex >= 0)
				{
					int num3 = ((j < g.upFxAt.Length) ? g.upFxAt[j] : 0);
					stringBuilder.Append(StatInfo.Describe((Stat)effectDef2.StatIndex, GearUp.Shown(effectDef2.value * GearUp.UpMult(g, effectDef2)))).Append($"  <color=#ffd75a>(+{num3})</color>\n");
				}
			}
			GearBehaviorDef gearBehaviorDef = GearX.Behavior(g.behavior);
			if (gearBehaviorDef != null)
			{
				stringBuilder.Append("<color=#7fd8ff><b>" + gearBehaviorDef.name + ":</b> " + gearBehaviorDef.desc + "</color>\n");
			}
			if (g.unique != "")
			{
				stringBuilder.Append("<color=" + rarityDef.color + "><b>UNIQUE:</b> " + g.uniqueDesc + "</color>\n");
				if (g.flavor != "")
				{
					stringBuilder.Append("<color=#9a9ca0><i>\"" + g.flavor + "\"</i></color>\n");
				}
			}
			if (Starters.Is(g))
			{
				stringBuilder.Append(Starters.Describe(g));
			}
			if (Cursed.Is(g))
			{
				stringBuilder.Append(Cursed.Describe(g)).Append('\n');
				if (g.flavor != "")
				{
					stringBuilder.Append("<color=#9a9ca0><i>\"" + g.flavor + "\"</i></color>\n");
				}
				stringBuilder.Append("<color=#9a9ca0>One cursed item can be worn at a time. Rerolls change only its normal affixes.</color>\n");
			}
			if (g.hidden.Length != 0 || GearX.Tier(g) == 0)
			{
				EffectDef effectDef3 = ((g.hidden.Length != 0) ? g.hidden[0] : null);
				if (GearX.Tier(g) >= 1 && effectDef3 != null && effectDef3.StatIndex >= 0)
				{
					stringBuilder.Append("<color=#ffd75a>Hidden affix: " + StatInfo.Describe((Stat)effectDef3.StatIndex, effectDef3.value) + "</color>\n");
				}
				else
				{
					stringBuilder.Append("<color=#9a9ca0>Hidden affix: revealed at Bonded</color>\n");
				}
			}
			int num4 = GearX.Tier(g);
			var (num5, num6) = GearX.NextTier(g);
			stringBuilder.Append($"\n<b>Attunement</b> {g.attune}" + ((num4 > 0) ? ("  <color=#ffd75a>" + GearX.TierNames[num4 - 1] + "</color>") : "") + ((num6 > 0) ? $"  <color=#9a9ca0>(next: {GearX.TierNames[num4]} in {num6 - num5})</color>" : "") + "\n");
			for (int k = 0; k < 3; k++)
			{
				stringBuilder.Append(string.Format("<color={0}>{1} {2}: {3} - {4}</color>\n", (num4 > k) ? "#73ff66" : "#9a9ca0", (num4 > k) ? "[x]" : "[ ]", GearX.TierAt[k], GearX.TierNames[k], GearMilestoneText(k + 1)));
			}
			if (g.sockets > 0)
			{
				stringBuilder.Append("\n<b>Sockets</b>\n");
				for (int l = 0; l < g.modules.Length; l++)
				{
					GearModuleDef gearModuleDef = GearX.Module(g.modules[l]);
					stringBuilder.Append((gearModuleDef != null) ? ("<color=#7fd8ff>" + gearModuleDef.name + "</color>: " + FxLine(gearModuleDef.effects) + "\n") : "<color=#9a9ca0>Empty socket</color>\n");
				}
			}
			SetDef setDef = GearSets.Get(g.set);
			if (setDef != null)
			{
				GearSets.Worn(run.EquippedItems()).TryGetValue(setDef.id, out var value2);
				stringBuilder.Append('\n').Append(GearSets.Progress(setDef, value2)).Append('\n');
			}
			if (g.crafts > 0)
			{
				stringBuilder.Append($"<color=#9a9ca0>Crafts: {g.crafts}/{Plugin.Cfg.MaxCraftsPerItem.Value}</color>\n");
			}
			stringBuilder.Append($"<color=#9fe6c0>Salvage: +{SalvagePreview(g)} {Scrap.Short}" + (Plugin.Cfg.SalvageGivesXp.Value ? string.Format(", +{0} XP", Gear.Rarity(g.rarity).salvageXp * ((!GearX.Has(g, "gear.studious")) ? 1 : 2)) : "") + "</color>\n");
			value = stringBuilder.ToString().TrimEnd('\n');
			_inspectText[key] = value;
			return value;
		}

		private static string ElementText(string stat)
		{
			//IL_0034: Unknown result type (might be due to invalid IL or missing references)
			for (int i = 1; i <= 5; i++)
			{
				if (stat.EndsWith("_" + Elements.Keys[i], StringComparison.Ordinal))
				{
					return "<color=#" + ColorUtility.ToHtmlStringRGB(Elements.Colors[i]) + ">Element: " + Elements.Names[i] + " (" + Elements.Status[i] + ")</color> on your weapon's hits (guns, launchers, melee, supported modded weapons; not thrown objects)";
				}
			}
			return "";
		}

		private static string FxLine(EffectDef[] fx)
		{
			List<string> list = new List<string>();
			foreach (EffectDef effectDef in fx)
			{
				if (effectDef.StatIndex >= 0)
				{
					list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
					continue;
				}
				if (effectDef.stat.StartsWith("gear.elem", StringComparison.Ordinal))
				{
					list.Add(ElementText(effectDef.stat));
					continue;
				}
				string text = ResearchEcon.ModuleText(effectDef.stat);
				if (text != null && text != "")
				{
					list.Add(text);
				}
			}
			return string.Join(", ", list);
		}

		private void SumGear(RunSave run, float[] into, GearItem? swapIn)
		{
			Array.Clear(into, 0, into.Length);
			SlotDef[] slots = Plugin.Rpg.slots;
			int num = ((swapIn != null) ? Plugin.Rpg.SlotIndex(swapIn.slot) : (-1));
			for (int i = 0; i < slots.Length; i++)
			{
				GearItem gearItem = ((i == num) ? swapIn : ((i < run.equipped.Length) ? run.FindItem(run.equipped[i]) : null));
				if (gearItem != null)
				{
					GearX.AddStats(gearItem, into);
				}
			}
		}

		private void BuildGearSide(RunSave run)
		{
			SumGear(run, _gearTotals, null);
			StringBuilder stringBuilder = new StringBuilder("<b>GEAR TOTALS</b>\n");
			int num = 0;
			for (int i = 0; i < _gearTotals.Length; i++)
			{
				if (Mathf.Abs(_gearTotals[i]) > 0.0001f)
				{
					stringBuilder.Append(StatInfo.Describe((Stat)i, _gearTotals[i])).Append((++num % 2 == 0) ? "\n" : "     ");
				}
			}
			if (num == 0)
			{
				stringBuilder.Append("<color=#9a9ca0>Nothing equipped yet.</color>");
			}
			stringBuilder.Append('\n');
			foreach (KeyValuePair<string, int> item in GearSets.Worn(run.EquippedItems()))
			{
				SetDef setDef = GearSets.Get(item.Key);
				if (setDef != null)
				{
					stringBuilder.Append($"\n<color={setDef.color}><b>{setDef.name} set {item.Value}/4</b></color>" + ((item.Value >= 4) ? " (2 + 4 piece on)" : ((item.Value >= 2) ? " (2 piece on)" : "")));
				}
			}
			foreach (GearItem item2 in run.EquippedItems())
			{
				if (item2.unique != "")
				{
					stringBuilder.Append("\n<color=" + Gear.Rarity(item2.rarity).color + "><b>" + item2.unique + ":</b></color> " + item2.uniqueDesc);
				}
				CursedDef cursedDef = Cursed.Def(item2.cursed);
				if (cursedDef != null)
				{
					stringBuilder.Append("\n<color=#E0344B><b>" + cursedDef.name + ":</b></color> " + cursedDef.benefit + " <color=#FF8A8A>[!] " + cursedDef.curse + "</color>");
				}
				GearBehaviorDef gearBehaviorDef = GearX.Behavior(item2.behavior);
				if (gearBehaviorDef != null)
				{
					stringBuilder.Append("\n<color=#7fd8ff><b>" + gearBehaviorDef.name + "</b></color> (" + item2.name + "): " + gearBehaviorDef.desc);
				}
				int num2 = GearX.Tier(item2);
				if (num2 > 0)
				{
					stringBuilder.Append($"\n<color=#ffd75a>{GearX.TierNames[num2 - 1]}</color> {item2.name} ({item2.attune})");
				}
			}
			if (run.dieLevel == RunInfo.LevelIndex && run.dieUp != "")
			{
				stringBuilder.Append("\n<color=#ffb21e>Gambler's Die is rolled for this level.</color>");
			}
			_gearSideText = stringBuilder.ToString();
		}

