		private void CommitPresetName()
		{
			string name = HostSettings.CleanName(_presetName);
			if (name == "")
			{
				PresetNote("Type a name first", good: false);
				MenuSound(UiSound.Error);
				return;
			}
			if (_presetEdit == PresetEdit.Rename)
			{
				string from = _presetFrom;
				if (string.Equals(name, from, StringComparison.Ordinal))
				{
					ClosePresetEdit();
					return;
				}
				HostSettings.PresetInfo presetInfo = HostSettings.Find(name);
				if (presetInfo != null && !string.Equals(presetInfo.Name, from, StringComparison.OrdinalIgnoreCase))
				{
					string name2 = presetInfo.Name;
					AskConfirm("REPLACE PRESET?", "A preset named '" + name2 + "' already exists. Rename '" + from + "' to '" + name + "' and replace it? This can't be undone.", "Replace", delegate
					{
						DoRenamePreset(from, name, replace: true);
					}, focusCancel: true);
				}
				else
				{
					DoRenamePreset(from, name, replace: false);
				}
				return;
			}
			HostSettings.PresetInfo presetInfo2 = HostSettings.Find(name);
			if (presetInfo2 != null)
			{
				AskConfirm("OVERWRITE PRESET?", "A preset named '" + presetInfo2.Name + "' already exists. Overwrite it with the current settings? Its old values can't be recovered.", "Overwrite", delegate
				{
					DoSavePreset(name);
				}, focusCancel: true);
			}
			else
			{
				DoSavePreset(name);
			}
		}

		private static bool HasNameChars(string s)
		{
			for (int i = 0; i < s.Length; i++)
			{
				if (char.IsLetterOrDigit(s[i]))
				{
					return true;
				}
			}
			return false;
		}

		private void PresetType(char c)
		{
			if (_presetName.Length >= 24)
			{
				MenuSound(UiSound.Error);
				return;
			}
			bool flag = _presetCaps || _presetName.Length == 0 || _presetName[_presetName.Length - 1] == ' ';
			_presetName += ((!char.IsLetter(c)) ? c : (flag ? char.ToUpperInvariant(c) : char.ToLowerInvariant(c)));
		}

