				Name = "Quick Draw",
				Desc = "Ability cooldowns are 6% shorter."
			},
			new Drill
			{
				Id = "study_hall",
				Name = "Study Hall",
				Desc = "Everyone earns 6% more XP (inside the XP bonus cap)."
			},
			new Drill
			{
