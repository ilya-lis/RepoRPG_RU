					if (obj != null)
					{
						text = Game.Get(obj, "itemName", "");
					}
				}
				if (text != "")
				{
					return text;
				}
			}
			catch
			{
			}
			return ((Object)c.gameObject).name.Replace("(Clone)", "").Replace("Item ", "").Trim();
		}

