		public static Vector2 RightStick { get; private set; }

		public static bool Connected { get; private set; }

		public static string Kind
		{
			get
			{
				string text = Source.ToLowerInvariant();
				if (text.Contains("dualshock") || text.Contains("dualsense") || text.Contains("playstation") || text.Contains("wireless controller"))
				{
					return "PlayStation";
				}
				if (!IsDeck)
				{
					return "Xbox";
				}
				return "Steam Deck";
			}
		}

		public static bool AnyActivity { get; private set; }

		public static string Source { get; private set; } = "none";

		private static string[] ChordParts(string chord)
		{
			if (!Chords.TryGetValue(chord, out string[] value))
			{
				value = chord.Split('+');
				for (int i = 0; i < value.Length; i++)
				{
					value[i] = value[i].Trim();
				}
				Chords[chord] = value;
			}
			return value;
		}

		private static void Diagnose()
		{
			StringBuilder stringBuilder = new StringBuilder("Controller check: ");
			stringBuilder.Append("XInput: ").Append(XInput.Describe()).Append(". ");
			stringBuilder.Append("Unity Input System devices: ").Append(UnityPad.DescribeDevices()).Append(". ");
			try
			{
				string[] joystickNames = Input.GetJoystickNames();
				stringBuilder.Append("Legacy joysticks: ").Append((joystickNames.Length == 0) ? "none" : string.Join(", ", joystickNames)).Append('.');
			}
			catch (Exception ex)
			{
				stringBuilder.Append("Legacy input unavailable (").Append(ex.GetType().Name).Append(").");
			}
			Plugin.Log.LogInfo((object)stringBuilder.ToString());
			if (XInput.AllSlotsEmpty())
			{
				Plugin.Log.LogInfo((object)"Windows reports no Xbox controller to this game. If one is connected, Steam Input is most likely hiding it: Steam > R.E.P.O. > Properties > Controller > 'Disable Steam Input', then restart the game.");
			}
		}

		public static void Poll()
		{
			//IL_0234: Unknown result type (might be due to invalid IL or missing references)
			//IL_0239: Unknown result type (might be due to invalid IL or missing references)
			//IL_0066: Unknown result type (might be due to invalid IL or missing references)
			//IL_006b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0249: Unknown result type (might be due to invalid IL or missing references)
			//IL_024e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0129: Unknown result type (might be due to invalid IL or missing references)
			//IL_0130: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ce: Unknown result type (might be due to invalid IL or missing references)
			//IL_00d4: Unknown result type (might be due to invalid IL or missing references)
			string[] all = All;
			foreach (string key in all)
			{
				Before[key] = Now.TryGetValue(key, out var value) && value;
			}
			all = All;
			foreach (string key2 in all)
			{
				Now[key2] = false;
			}
			LeftStick = (RightStick = Vector2.zero);
			Vector2 left2;
			Vector2 right2;
			string name;
			if (Plugin.Cfg.PadUseXInput.Value && XInput.Poll(Now, out var left, out var right, out var slot))
			{
				Connected = true;
				if (slot != _lastXSlot)
				{
					_lastXSlot = slot;
					_xSource = $"XInput (Xbox controller, slot {slot + 1})";
				}
				Source = _xSource;
				LeftStick = left;
				RightStick = right;
			}
			else if (UnityPad.Poll(Now, out left2, out right2, out name))
			{
				Connected = true;
				if (name != _lastUName)
				{
					_lastUName = name;
					_uSource = "Unity Input System (" + name + ")";
				}
				Source = _uSource;
				LeftStick = left2;
				RightStick = right2;
			}
			else
			{
				Connected = false;
				Source = "none";
			}
			if (Source != _lastSource)
			{
				_lastSource = Source;
				Plugin.Log.LogInfo((object)(Connected ? ("Controller detected via " + Source + ".") : "No controller detected."));
			}
			if (!Connected && _diagnoseCount < 3 && Time.unscaledTime >= _nextDiagnose)
			{
				_diagnoseCount++;
				_nextDiagnose = Time.unscaledTime + ((_diagnoseCount == 1) ? 25f : 90f);
				try
				{
					Diagnose();
				}
				catch (Exception ex)
				{
					Plugin.Log.LogInfo((object)("Controller check failed: " + ex.Message));
				}
			}
			AnyActivity = false;
			all = All;
			foreach (string key3 in all)
			{
				if (Now[key3])
				{
					AnyActivity = true;
				}
			}
			Vector2 val = LeftStick;
			if (!(((Vector2)(ref val)).sqrMagnitude > 0.25f))
			{
				val = RightStick;
				if (!(((Vector2)(ref val)).sqrMagnitude > 0.25f))
				{
					return;
				}
			}
			AnyActivity = true;
		}

		public static bool Held(string button)
		{
			bool value;
			return Now.TryGetValue(button, out value) && value;
		}

		public static bool Down(string button)
		{
			bool value;
			if (Held(button))
			{
				return !(Before.TryGetValue(button, out value) && value);
			}
			return false;
		}

		public static bool ChordDown(string chord)
		{
			if (string.IsNullOrWhiteSpace(chord))
			{
				return false;
			}
			bool result = false;
			string[] array = ChordParts(chord);
			foreach (string button in array)
			{
				if (!Held(button))
				{
					return false;
				}
				if (Down(button))
				{
					result = true;
				}
			}
			return result;
		}

		public static bool ChordHeld(string chord)
		{
			if (string.IsNullOrWhiteSpace(chord))
			{
				return false;
			}
			string[] array = ChordParts(chord);
			for (int i = 0; i < array.Length; i++)
			{
				if (!Held(array[i]))
				{
					return false;
				}
			}
			return true;
		}
	}
