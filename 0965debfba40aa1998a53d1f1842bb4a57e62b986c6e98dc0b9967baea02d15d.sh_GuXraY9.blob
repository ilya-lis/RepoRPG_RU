			{
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem != null)
				{
					if (_store.Data.IsEquipped(gearItem))
					{
						Unequip(gearItem);
					}
					else
					{
						EquipFx(gearItem);
					}
				}
			});
			gearDetail.Act(SalvagePending(g.uid) ? "Salvaging..." : $"Salvage +{SalvagePreview(g)}", BtnKind.Danger, !SalvagePending(g.uid), delegate
			{
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem != null)
				{
					AskSalvage(gearItem);
				}
			});
			gearDetail.Act("Reroll " + Scrap.Price(amount), BtnKind.Secondary, openNow && !flag2, delegate
			{
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem != null)
				{
					BuyGearReroll(gearItem, upgrade: false);
				}
			}, flag2 ? "Starter items can't be rerolled." : "Only while the shop is open.");
			if (g.rarity < Gear.MaxRarity)
