		public static void Kick(int actor)
		{
			try
			{
				if (Online && PhotonNetwork.IsMasterClient)
				{
					Room currentRoom = PhotonNetwork.CurrentRoom;
					Player val = ((currentRoom != null) ? currentRoom.GetPlayer(actor, false) : null);
					if (val != null && !val.IsLocal)
					{
						PhotonNetwork.CloseConnection(val);
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)$"[settings] couldn't remove player {actor}: {ex.Message}");
			}
		}

		public static void Buy(int requestId, string item, int cost)
		{
			if (!Online || PhotonNetwork.IsMasterClient)
			{
				int localActor = ClassClaims.LocalActor;
				var (flag, charged, reason) = HostDecide(localActor, item, cost, isLocal: true);
				RpgRuntime.Instance?.OnBuyResult(requestId, flag, charged, reason);
				if (flag && Online)
				{
					AnnouncePurchase(localActor, item, charged);
				}
			}
			else
			{
				Send(10, new object[3] { requestId, item, cost }, (ReceiverGroup)2);
			}
		}

		private static (bool ok, int charged, string reason) HostDecide(int actor, string item, int clientCost, bool isLocal)
		{
			bool flag = item.StartsWith("buyback:", StringComparison.Ordinal);
			int num = (flag ? ShopX.HostBuybackPrice(actor, item.Substring(8)) : Shop.HostBasePrice(item));
			if (num <= 0)
			{
				return (ok: false, charged: 0, reason: "unknown item");
			}
			if (!flag)
			{
				num = Mathf.Max(1, Mathf.RoundToInt((float)num * Haggle.HostMult(actor, item)));
			}
			if (item == "perkreroll")
			{
				num += Mathf.Max(0, Plugin.Cfg.PerkRerollStep.Value) * Shop.HostPerkRerolls(actor);
			}
			if (!Shop.OpenNow)
			{
				return (ok: false, charged: 0, reason: "shop closed");
			}
			if (!isLocal && !Shop.HostRateOk(actor))
			{
				return (ok: false, charged: 0, reason: "too fast");
			}
			string text = ShopX.HostLimit(actor, item);
			if (text != "")
			{
				return (ok: false, charged: 0, reason: text);
			}
			int num2 = (flag ? num : Mathf.Max(Shop.HostPriceFor(actor, num, isLocal), Mathf.Min(clientCost, num)));
			string text2 = (isLocal ? LocalSteamId() : SenderSteamId(actor, ""));
			if (text2 == "")
			{
				return (ok: false, charged: num2, reason: "not verified");
			}
			if (!Scrap.HostTrySpend(text2, actor, num2))
			{
				return (ok: false, charged: num2, reason: "not enough");
			}
			if (item == "perkreroll")
			{
				Shop.HostNoteReroll(actor);
			}
			if (flag)
			{
				ShopX.HostForgetBuyback(actor, item.Substring(8));
			}
			ShopX.HostNoteBought(actor, item);
			Market.HostBought(item);
			return (ok: true, charged: num2, reason: "");
		}

		private static string LocalSteamId()
		{
			PlayerAvatar val = Game.LocalPlayer();
			string text = (((Object)(object)val == (Object)null) ? "" : Game.SteamId(val));
			if (!string.IsNullOrEmpty(text))
			{
				return text;
			}
			if (!Game.IsMultiplayer())
			{
				return "local";
			}
			return "";
		}

