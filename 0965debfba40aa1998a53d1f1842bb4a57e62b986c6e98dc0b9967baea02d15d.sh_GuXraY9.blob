			}
			double num2 = numSpec.Hi - numSpec.Lo;
			numSpec.Whole = e.SettingType == typeof(int) || (IsWhole(numSpec.Lo) && IsWhole(numSpec.Hi) && IsWhole(num) && num2 >= 20.0);
			if (numSpec.Whole)
			{
