		private static readonly bool IsDeck = Environment.GetEnvironmentVariable("SteamDeck") == "1";

		private static string _lastSource = "";

		private static int _lastXSlot = -1;

		private static string _xSource = "";

		private static string _uSource = "";

		private static string _lastUName = "";

		private static readonly Dictionary<string, string[]> Chords = new Dictionary<string, string[]>();

		private static float _nextDiagnose = 5f;

		private static int _diagnoseCount;

		public static IReadOnlyList<string> ButtonNames => All;

