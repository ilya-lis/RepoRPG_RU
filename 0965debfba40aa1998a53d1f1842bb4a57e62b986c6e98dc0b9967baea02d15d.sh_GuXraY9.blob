		private static readonly Dictionary<int, Entry> Remote = new Dictionary<int, Entry>();

		public static string ClassOf(PlayerAvatar? p)
		{
			if ((Object)(object)p == (Object)null)
			{
				return "";
			}
			if ((Object)(object)p == (Object)(object)Game.LocalPlayer())
			{
				return RpgRuntime.Instance?.CurrentId ?? "";
			}
			if (!Remote.TryGetValue(Game.ActorNumber(p), out Entry value))
			{
				return "";
			}
			return value.ClassId;
		}

		public static float Get(PlayerAvatar? p, string stat)
		{
			if ((Object)(object)p == (Object)null)
			{
				return 0f;
			}
			if ((Object)(object)p == (Object)(object)Game.LocalPlayer())
			{
				return RpgRuntime.Instance?.ClassStat(stat) ?? 0f;
			}
			if (!Remote.TryGetValue(Game.ActorNumber(p), out Entry value) || !value.Stats.TryGetValue(stat, out var value2))
			{
				return 0f;
			}
			return value2;
		}

		public static Entry? Of(int actor)
		{
			if (!Remote.TryGetValue(actor, out Entry value))
			{
				return null;
			}
			return value;
		}

		public static string Encode(string classId, Dictionary<string, float> stats)
		{
			StringBuilder stringBuilder = new StringBuilder(classId);
			stringBuilder.Append('|');
			bool flag = true;
			foreach (KeyValuePair<string, float> stat in stats)
			{
				if (!flag)
				{
					stringBuilder.Append(';');
				}
				flag = false;
				stringBuilder.Append(stat.Key).Append('=').Append(stat.Value.ToString("0.###", CultureInfo.InvariantCulture));
			}
			return stringBuilder.ToString();
		}

		public static void OnRemote(int actor, string payload, float grab, float thr)
		{
			if (payload.Length > 4000)
			{
				return;
			}
			if (!Remote.TryGetValue(actor, out Entry value))
			{
				value = (Remote[actor] = new Entry());
			}
			value.Stats.Clear();
			int num = payload.IndexOf('|');
			value.ClassId = ((num > 0) ? payload.Substring(0, num) : "");
			if (num >= 0)
			{
				string[] array = payload.Substring(num + 1).Split(';');
				foreach (string text in array)
				{
					int num2 = text.IndexOf('=');
					if (num2 > 0)
					{
						string text2 = text.Substring(0, num2);
						if ((text2.StartsWith(value.ClassId + ".", StringComparison.Ordinal) || text2.StartsWith("set.", StringComparison.Ordinal) || text2.StartsWith("perk.", StringComparison.Ordinal) || text2.StartsWith("attr.", StringComparison.Ordinal) || text2.StartsWith("gear.", StringComparison.Ordinal) || text2.StartsWith("shop.", StringComparison.Ordinal)) && float.TryParse(text.Substring(num2 + 1), NumberStyles.Float, CultureInfo.InvariantCulture, out var result) && !float.IsNaN(result))
						{
							value.Stats[text2] = Mathf.Clamp(result, -1000f, 1000f);
						}
					}
				}
			}
			value.Grab = ((grab < 0f || float.IsNaN(grab)) ? (-1f) : Mathf.Clamp(grab, 0f, 20f));
			value.Throw = ((float.IsNaN(thr) || thr <= -9f) ? float.NaN : Mathf.Clamp(thr, -0.5f, 20f));
			value.At = Time.unscaledTime;
		}

		public static void Forget(int actor)
		{
			Remote.Remove(actor);
		}

		public static void Clear()
		{
			Remote.Clear();
		}
	}
