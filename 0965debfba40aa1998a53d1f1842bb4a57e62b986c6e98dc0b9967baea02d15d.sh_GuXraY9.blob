		private string SynergyLine(ClassDef c)
		{
			if (!_synLineCache.TryGetValue(c.id, out string value))
			{
				value = (_synLineCache[c.id] = BuildSynergyLine(c));
			}
			if (value == "")
			{
				return value;
			}
			return (Plugin.Cfg.Synergies.Value ? "<color=#ffb21e><b>SYNERGIES</b></color>  " : "<color=#9a9ca0><b>SYNERGIES (off on this host)</b></color>  ") + value;
		}

		private static string BuildSynergyLine(ClassDef c)
		{
			StringBuilder stringBuilder = new StringBuilder();
			foreach (SynergyDef item in Synergies.For(c.id))
			{
				ClassDef classDef = Plugin.Db.Get(item.PartnerOf(c.id));
				if (classDef != null)
				{
					stringBuilder.Append((stringBuilder.Length == 0) ? "" : "   ·   ");
					stringBuilder.Append("<b>" + item.name + "</b> with <color=" + classDef.color + "><b>" + classDef.name + "</b></color>: " + item.Text);
				}
			}
			return stringBuilder.ToString();
		}

		private static string WeaknessOf(ClassDef c)
		{
			PassiveDef[] passives = c.passives;
			foreach (PassiveDef passiveDef in passives)
			{
				int num = passiveDef.desc.IndexOf("Weakness:", StringComparison.OrdinalIgnoreCase);
				if (num >= 0)
				{
					return passiveDef.desc.Substring(num + 9).Trim();
				}
			}
			return "(see passives)";
		}

		private string CompareColumn(ClassDef c)
		{
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append("<color=#ffb21e><b>ROLE</b></color>  " + c.group + " / " + c.role + "\n");
			stringBuilder.Append("<color=#ffb21e><b>COMPLEXITY</b></color>  " + Complexity.TipLine(c) + "\n");
			stringBuilder.Append($"<color=#ffb21e><b>ACTIVE</b></color>  <b>{c.active.name}</b> ({c.active.cooldown:0}s)\n{c.active.desc}\n");
			PassiveDef[] passives = c.passives;
			foreach (PassiveDef passiveDef in passives)
			{
				string text = passiveDef.desc;
				int num = text.IndexOf("Weakness:", StringComparison.OrdinalIgnoreCase);
				if (num >= 0)
				{
					text = text.Substring(0, num).Trim();
				}
				if (!(text == ""))
				{
					stringBuilder.Append("<color=#ffb21e><b>PASSIVE</b></color>  <b>" + passiveDef.name + "</b>: " + text + "\n");
				}
			}
			stringBuilder.Append("<color=#ff9999><b>WEAKNESS</b></color>  " + WeaknessOf(c) + "\n");
			List<string> list = new List<string>();
			foreach (SynergyDef item in Synergies.For(c.id))
			{
				ClassDef classDef = Plugin.Db.Get(item.PartnerOf(c.id));
				if (classDef != null)
				{
					list.Add(item.name + " (" + classDef.name + ")");
				}
			}
			if (list.Count > 0)
			{
				stringBuilder.Append("<color=#ffb21e><b>SYNERGIES</b></color>  " + string.Join(" · ", list) + "\n");
			}
			stringBuilder.Append("<color=#ffb21e><b>TREES</b></color>  ");
			for (int j = 0; j < c.branches.Length; j++)
			{
				stringBuilder.Append(c.branches[j].name).Append((j < c.branches.Length - 1) ? " · " : "");
			}
			return stringBuilder.ToString();
		}

