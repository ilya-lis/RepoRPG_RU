		private bool RosterVisible()
		{
			if (!Plugin.Cfg.LobbyRoster.Value || _menuOpen || _dialogOpen || Game.IsLoading())
			{
				return false;
			}
			if (Game.InLobbyMenu())
			{
				if (!_hintPageOk)
				{
					return Game.LobbyPageOnly();
				}
				return true;
			}
			if (Plugin.Cfg.RosterInShop.Value && Game.InShopLevel())
			{
				return !VanillaPageUp();
			}
			return false;
		}

		private void BuildRosterLines()
		{
