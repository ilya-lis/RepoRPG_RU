		private void ApplyPendingHealth(PlayerAvatar local)
		{
			PlayerHealth playerHealth = local.playerHealth;
			if ((Object)(object)playerHealth == (Object)null || Game.Get(local, "isDisabled", fallback: false))
			{
				if (Time.time - _pendingHealthAt > 5f)
				{
					_pendingHealthPct = 0f;
				}
				return;
			}
			int num = Game.MaxHealth(playerHealth);
			int num2 = Game.Health(playerHealth);
			int num3 = Mathf.RoundToInt((float)num * Mathf.Clamp(_pendingHealthPct, 0f, 100f) / 100f);
			_pendingHealthPct = 0f;
			if (num3 > num2)
			{
				playerHealth.Heal(num3 - num2, false);
			}
		}

		private bool TryBet(float power)
		{
			//IL_0015: Unknown result type (might be due to invalid IL or missing references)
			//IL_004a: Unknown result type (might be due to invalid IL or missing references)
			ValuableObject val = Game.HeldValuable();
