		private string EffectiveAbilityClass()
		{
			if (Current == null)
			{
				return "";
			}
			if (Current.id == "mimic")
			{
				return MimicCopy()?.id ?? "";
			}
			return Current.id;
		}

		private BetMark? MyBet()
		{
			int localActor = ClassClaims.LocalActor;
			foreach (KeyValuePair<int, BetMark> betMark in _betMarks)
			{
				if (betMark.Value.Actor == localActor || !Game.IsMultiplayer())
				{
					return betMark.Value;
				}
			}
			return null;
		}

		private string AbilityLimitText()
		{
			string text = EffectiveAbilityClass();
			if (!(text == "quartermaster"))
			{
				if (text == "gambler")
				{
					BetMark betMark = MyBet();
					if (betMark != null)
					{
						return $"  x{betMark.Mult:0.0}  {Mathf.CeilToInt(betMark.Remaining)}s" + ((betMark.Armed < 1f) ? "  (arming)" : "");
					}
					int num = (LimitsKnown ? _betUses : Plugin.Cfg.BetUsesPerLevel.Value);
					int num2 = (LimitsKnown ? _betLeft : num);
					return $"  {num2}/{num} this level";
				}
				return "";
			}
			int num3 = (LimitsKnown ? _supplyCharges : (Plugin.Cfg.ResupplyCharges.Value + ((Current?.id == "quartermaster") ? Mathf.FloorToInt(ClassStat("quartermaster.supply_extra") + 0.001f) : 0)));
			int num4 = (LimitsKnown ? _supplyLeft : num3);
			string text2 = $"  {num4}/{num3} this level";
			if (num4 == 0 && LimitsKnown && _supplyPrice >= 0)
			{
				text2 = text2 + "  - next " + Scrap.Price(_supplyPrice);
			}
			return text2;
		}

		private bool ResupplyAllowedLocally()
		{
			//IL_001f: Unknown result type (might be due to invalid IL or missing references)
			if (LimitsKnown && _supplyLeft == 0 && _supplyPrice < 0)
			{
				Toast("Resupply: no charges left this level", Color.gray);
				MenuSound(UiSound.Error);
				return false;
			}
			return true;
		}

		private bool BetAllowedLocally()
		{
			//IL_000e: Unknown result type (might be due to invalid IL or missing references)
			//IL_003b: Unknown result type (might be due to invalid IL or missing references)
			if (MyBet() != null)
			{
				Toast("You already have a bet running", Color.gray);
				MenuSound(UiSound.Error);
				return false;
			}
			if (LimitsKnown && _betLeft == 0)
			{
				Toast("Double or Nothing: already used this level", Color.gray);
				MenuSound(UiSound.Error);
				return false;
			}
			return true;
		}

