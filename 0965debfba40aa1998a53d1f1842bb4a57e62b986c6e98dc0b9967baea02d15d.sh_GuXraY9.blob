				Plugin.Log.LogError((object)$"[debug] {src.active.name} threw: {arg}");
				Toast(src.active.name + " threw - see the log", Bad);
			}
			finally
			{
				_inActive = false;
				ClassHost.DebugAnyClass = false;
				_refundAfterUse = false;
				_rallyRefund = 0f;
			}
			AbilityDiag(flag2 ? ("debug run: " + src.active.name + " ran") : ("debug run: " + src.active.name + " refused (see the message)"));
			if (flag2)
			{
				Toast("Debug: " + src.active.name + (asCopy ? " (copy)" : ""), ParseColor(src.color));
			}
		}

