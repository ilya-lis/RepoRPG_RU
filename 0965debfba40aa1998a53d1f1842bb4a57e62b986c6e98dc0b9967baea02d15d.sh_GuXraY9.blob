			{
				return false;
			}
			bool flag = Game.ClassPickOpen();
			bool flag2 = Plugin.Cfg.MenuHintInLevels.Value && Game.LevelReady() && Game.IsAlive(Game.LocalPlayer());
			if (!flag && !flag2)
			{
				return false;
			}
			if (ChatOpen.Value())
			{
				return false;
			}
			if (Time.unscaledTime >= _nextHintPageCheck)
			{
				_nextHintPageCheck = Time.unscaledTime + 0.25f;
				_hintPageOk = ((!flag || !Game.InLobbyMenu()) ? (!VanillaPageUp()) : (Game.LobbyPageOnly() || !VanillaPageUp()));
			}
			return _hintPageOk;
		}

