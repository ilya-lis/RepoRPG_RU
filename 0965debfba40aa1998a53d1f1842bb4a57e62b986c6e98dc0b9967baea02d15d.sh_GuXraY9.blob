	[HarmonyPatch]
	internal static class ValuableAmountsPatch
	{
		private static readonly HashSet<string> Fields = new HashSet<string> { "totalMaxValue", "tinyMaxAmount", "smallMaxAmount", "mediumMaxAmount", "bigMaxAmount", "wideMaxAmount", "tallMaxAmount", "veryTallMaxAmount" };

		private static MethodBase? TargetMethod()
		{
			MethodInfo methodInfo = AccessTools.Method(AccessTools.TypeByName("ValuableDirector"), "SetupHost", (Type[])null, (Type[])null);
			if (!(methodInfo == null))
			{
				return AccessTools.EnumeratorMoveNext((MethodBase)methodInfo);
			}
			return null;
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			return TargetMethod() != null;
		}

		private static IEnumerable<CodeInstruction> Transpiler(IEnumerable<CodeInstruction> instructions)
		{
			//IL_0138: Unknown result type (might be due to invalid IL or missing references)
			//IL_0142: Expected O, but got Unknown
			//IL_0160: Unknown result type (might be due to invalid IL or missing references)
			//IL_016a: Expected O, but got Unknown
			List<CodeInstruction> list = new List<CodeInstruction>(instructions);
			MethodInfo methodInfo = AccessTools.Method(typeof(Mathf), "RoundToInt", new Type[1] { typeof(float) }, (Type[])null);
			MethodInfo methodInfo2 = AccessTools.Method(typeof(PlayerScaling), "ValuableInt", (Type[])null, (Type[])null);
			MethodInfo methodInfo3 = AccessTools.Method(typeof(ValueScale), "Budget", (Type[])null, (Type[])null);
			int num = 0;
			for (int i = 0; i < list.Count; i++)
			{
				if (!(list[i].opcode == OpCodes.Call) || !(list[i].operand is MethodInfo methodInfo4) || !(methodInfo4 == methodInfo))
				{
					continue;
				}
				int num2 = i + 1;
				if (num2 < list.Count && list[num2].opcode == OpCodes.Conv_R4)
				{
					num2++;
				}
				if (num2 < list.Count && !(list[num2].opcode != OpCodes.Stfld) && list[num2].operand is FieldInfo fieldInfo && Fields.Contains(fieldInfo.Name))
				{
					list.Insert(i + 1, new CodeInstruction(OpCodes.Call, (object)methodInfo2));
					if (fieldInfo.Name == "totalMaxValue")
					{
						list.Insert(i + 2, new CodeInstruction(OpCodes.Call, (object)methodInfo3));
						i++;
					}
					num++;
					i++;
				}
			}
			PlayerScaling.ValuablesHooked = num > 0;
			if (num == 0)
			{
				Plugin.Log.LogWarning((object)"[scaling] the valuable setup has changed: valuable counts aren't scaled (the haul goal still is).");
			}
			else
			{
				Plugin.Log.LogInfo((object)$"[scaling] valuable setup hooked ({num} amounts).");
			}
			return list;
		}
	}
