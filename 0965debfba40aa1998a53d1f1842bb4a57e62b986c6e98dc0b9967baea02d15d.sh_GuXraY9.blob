	internal static class TalentAlloc
	{
		public static int HostActor;

		public static ClassProgress Clone(ClassProgress p)
		{
			ClassProgress classProgress = new ClassProgress
			{
				classId = p.classId,
				level = p.level,
				xp = p.xp,
				bonusPoints = p.bonusPoints
			};
			foreach (NodeRank rank in p.ranks)
			{
				classProgress.ranks.Add(new NodeRank
				{
					id = rank.id,
					rank = rank.rank
				});
			}
			return classProgress;
		}

		public static Dictionary<string, int> Simulate(ClassDef c, ClassProgress confirmed, Dictionary<string, int> pending, out ClassProgress sim, out string error)
		{
			sim = Clone(confirmed);
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			foreach (KeyValuePair<string, int> item in pending)
			{
				if (item.Value > 0)
				{
					dictionary[item.Key] = item.Value;
				}
			}
			Dictionary<string, int> dictionary2 = new Dictionary<string, int>();
			error = "";
			bool flag = true;
			while (flag && dictionary.Count > 0)
			{
				flag = false;
				BranchDef[] branches = c.branches;
				foreach (BranchDef branchDef in branches)
				{
					NodeDef[] nodes = branchDef.nodes;
					foreach (NodeDef nodeDef in nodes)
					{
						if (dictionary.TryGetValue(nodeDef.id, out var value) && ClassDatabase.CanRankUp(c, branchDef, nodeDef, sim) == ClassDatabase.RankBlock.None)
						{
							sim.SetRank(nodeDef.id, sim.RankOf(nodeDef.id) + 1);
							dictionary2.TryGetValue(nodeDef.id, out var value2);
							dictionary2[nodeDef.id] = value2 + 1;
							if (value <= 1)
							{
								dictionary.Remove(nodeDef.id);
							}
							else
							{
								dictionary[nodeDef.id] = value - 1;
							}
							flag = true;
						}
					}
				}
			}
			using (Dictionary<string, int>.Enumerator enumerator = dictionary.GetEnumerator())
			{
				if (enumerator.MoveNext())
				{
					var (branchDef2, nodeDef2) = Find(c, enumerator.Current.Key);
					if (nodeDef2 == null || branchDef2 == null)
					{
						error = "unknown talent";
					}
					else
					{
						error = ClassDatabase.CanRankUp(c, branchDef2, nodeDef2, sim) switch
						{
							ClassDatabase.RankBlock.Maxed => nodeDef2.name + " is already maxed", 
							ClassDatabase.RankBlock.NoPoints => "not enough skill points", 
							ClassDatabase.RankBlock.LevelTooLow => $"{nodeDef2.name} unlocks at level {ClassDatabase.UnlockLevel(nodeDef2)}", 
							ClassDatabase.RankBlock.NeedsPrevious => nodeDef2.name + " needs " + ClassDatabase.RequiredNode(c, branchDef2, nodeDef2)?.name, 
							_ => nodeDef2.name + " can't be learned", 
						};
					}
				}
			}
			return dictionary2;
		}

		public static (BranchDef? b, NodeDef? n) Find(ClassDef c, string id)
		{
			BranchDef[] branches = c.branches;
			foreach (BranchDef branchDef in branches)
			{
				NodeDef[] nodes = branchDef.nodes;
				foreach (NodeDef nodeDef in nodes)
				{
					if (nodeDef.id == id)
					{
						return (b: branchDef, n: nodeDef);
					}
				}
			}
			return (b: null, n: null);
		}

		public static string HostHandle(RunSave run, string payload, out string result)
		{
			result = "";
			int num = payload.IndexOf('|');
			if (num <= 0)
			{
				return "invalid request";
			}
			string classId = payload.Substring(0, num);
			ClassDef classDef = Plugin.Db.Get(classId);
			if (classDef == null)
			{
				return "unknown class";
			}
			if (run.selectedClass != classId)
			{
				return "you aren't playing " + classDef.name;
			}
			ClassProgress classProgress = run.classes.Find((ClassProgress x) => x.classId == classId);
			if (classProgress == null)
			{
				return "no progress for that class yet";
			}
			Dictionary<string, int> dictionary = AttributeAlloc.Decode(payload.Substring(num + 1));
			if (dictionary == null || dictionary.Count == 0)
			{
				return "invalid request";
			}
			if (classDef.branches.Length > 3)
			{
				foreach (string key in dictionary.Keys)
				{
					if (Array.IndexOf<NodeDef>(classDef.branches[3].nodes, Find(classDef, key).n) >= 0 && !Account.HostAllowsPrestige(HostActor, classId))
					{
						return "that prestige tree isn't unlocked";
					}
				}
			}
			ClassProgress sim;
			string error;
			Dictionary<string, int> dictionary2 = Simulate(classDef, classProgress, dictionary, out sim, out error);
			if (error != "")
			{
				return error;
			}
			Dictionary<string, int> dictionary3 = new Dictionary<string, int>();
			foreach (KeyValuePair<string, int> item in dictionary2)
			{
				classProgress.SetRank(item.Key, sim.RankOf(item.Key));
				dictionary3[item.Key] = sim.RankOf(item.Key);
			}
			result = classId + "|" + AttributeAlloc.Encode(dictionary3);
			return "";
		}
	}
	internal static class PerkAlloc
	{
		public static List<List<string>> Sets(RunSave run)
		{
			List<List<string>> list = new List<List<string>>
			{
				new List<string>(run.perkChoices)
			};
			foreach (string perkChoiceSet in run.perkChoiceSets)
			{
				list.Add(new List<string>(perkChoiceSet.Split(new char[1] { ',' }, StringSplitOptions.RemoveEmptyEntries)));
			}
			return list;
		}

		public static void WriteSets(RunSave run, List<List<string>> sets)
		{
			run.perkChoices = ((sets.Count > 0) ? new List<string>(sets[0]) : new List<string>());
			run.perkChoiceSets = new List<string>();
			for (int i = 1; i < sets.Count; i++)
			{
				run.perkChoiceSets.Add(string.Join(",", sets[i]));
			}
		}

		public static string Encode(Dictionary<int, string> picks)
		{
			StringBuilder stringBuilder = new StringBuilder();
			foreach (KeyValuePair<int, string> pick in picks)
			{
				if (stringBuilder.Length > 0)
				{
					stringBuilder.Append(';');
				}
				stringBuilder.Append(pick.Key).Append(':').Append(pick.Value);
			}
			return stringBuilder.ToString();
		}

		public static Dictionary<int, string>? Decode(string s)
		{
			Dictionary<int, string> dictionary = new Dictionary<int, string>();
			if (string.IsNullOrEmpty(s))
			{
				return dictionary;
			}
			string[] array = s.Split(';');
			if (array.Length > 20)
			{
				return null;
			}
			string[] array2 = array;
			foreach (string text in array2)
			{
				int num = text.IndexOf(':');
				if (num <= 0 || !int.TryParse(text.Substring(0, num), out var result) || dictionary.ContainsKey(result))
				{
					return null;
				}
				dictionary[result] = text.Substring(num + 1);
			}
			return dictionary;
		}

		public static string Validate(RunSave run, Dictionary<int, string> picks)
		{
			if (picks.Count == 0)
			{
				return "nothing to apply";
			}
			if (picks.Count > run.perkPicksPending)
			{
				return "not that many perk picks";
			}
			List<List<string>> list = Sets(run);
			HashSet<string> hashSet = new HashSet<string>();
			foreach (KeyValuePair<int, string> pick in picks)
			{
				if (pick.Key < 0 || pick.Key >= list.Count || pick.Key >= run.perkPicksPending)
				{
					return "that pick isn't available";
				}
				if (!list[pick.Key].Contains(pick.Value))
				{
					return "that perk isn't on offer";
				}
				if (run.perks.Contains(pick.Value))
				{
					return "you already have that perk";
				}
				if (!hashSet.Add(pick.Value))
				{
					return "the same perk was picked twice";
				}
				PerkDef perkDef = Plugin.Rpg.Perk(pick.Value);
				if (perkDef == null)
				{
					return "unknown perk";
				}
				if (run.banished.Contains(pick.Value))
				{
					return "that perk was banished";
				}
				if (perkDef.cursed && !Perks.CursedOn)
				{
					return "cursed perks are turned off";
				}
			}
			return "";
		}

		public static void Apply(RunSave run, Dictionary<int, string> picks)
		{
			List<List<string>> list = Sets(run);
			List<int> list2 = new List<int>(picks.Keys);
			list2.Sort();
			foreach (KeyValuePair<int, string> pick in picks)
			{
				run.perks.Add(pick.Value);
			}
			for (int num = list2.Count - 1; num >= 0; num--)
			{
				if (list2[num] < list.Count)
				{
					list.RemoveAt(list2[num]);
				}
			}
			WriteSets(run, list);
			run.perkPicksPending = Math.Max(0, run.perkPicksPending - picks.Count);
		}

		public static string HostHandle(RunSave run, string payload, out string result)
		{
			result = "";
			Dictionary<int, string> dictionary = Decode(payload);
			if (dictionary == null)
			{
				return "invalid request";
			}
			string text = Validate(run, dictionary);
			if (text != "")
			{
				return text;
			}
			Apply(run, dictionary);
			result = payload;
			return "";
		}
	}
	internal static class Commit
	{
		public const byte Talents = 1;

		public const byte Perks = 2;

		public const byte Claim = 3;

		public static string HostHandle(byte type, string key, string steamId, int actor, string playerName, string payload, out string result)
		{
			result = "";
			if (type == 3)
			{
				ClassDef classDef = Plugin.Db.Get(payload);
				if (classDef == null)
				{
					return "unknown class";
				}
				if (!Game.ClassSelectionOpenForLobby() && !LateJoinHost.InPickWindow(actor))
				{
					return "class selection is only open in the lobby or shop";
				}
				if (!ClassClaims.HostTryClaim(actor, classDef.id, out string ownerName))
				{
					return "taken by " + ownerName;
				}
				result = classDef.id;
				return "";
			}
			if (key != RunInfo.Key || RunStore.IsTempKey(key))
			{
				return "the host is on a different save";
			}
			if (string.IsNullOrEmpty(steamId))
			{
				return "not verified";
			}
			RunSave runSave = SaveBook.Get(key, steamId);
			if (runSave == null)
			{
				return "the host doesn't have your progress yet - try again in a moment";
			}
			TalentAlloc.HostActor = actor;
			object obj = type switch
			{
				2 => PerkAlloc.HostHandle(runSave, payload, out result), 
				1 => TalentAlloc.HostHandle(runSave, payload, out result), 
				_ => "invalid request", 
			};
			if ((string?)obj == "")
			{
				SaveBook.Put(key, steamId, runSave, playerName);
			}
			return (string)obj;
		}
	}
	internal enum PerfPreset
	{
		Auto,
		Low,
		Medium,
		High,
		Custom
	}
	internal static class PerfVis
	{
		private static ConfigEntryBase[]? _all;

		private static bool _autoDone;

		private static float _autoStart = -1f;

		private static float _autoSum;

		private static int _autoFrames;

		public static ConfigEntryBase[] All
		{
			get
			{
				if (_all != null)
				{
					return _all;
				}
				ModConfig cfg = Plugin.Cfg;
				_all = (ConfigEntryBase[]?)(object)new ConfigEntryBase[7]
				{
					(ConfigEntryBase)cfg.ReducedEffects,
					(ConfigEntryBase)cfg.HudScanOutlines,
					(ConfigEntryBase)cfg.HudBeams,
					(ConfigEntryBase)cfg.ElementVfx,
					(ConfigEntryBase)cfg.NameplateRange,
					(ConfigEntryBase)cfg.PerfBarRange,
					(ConfigEntryBase)cfg.PerfFxRings
				};
				return _all;
			}
		}

		private static object? Value(PerfPreset p, ConfigEntryBase e)
		{
			ModConfig cfg = Plugin.Cfg;
			bool flag = p == PerfPreset.Low;
			if ((object)e == cfg.ReducedEffects)
			{
				return flag;
			}
			if ((object)e == cfg.HudScanOutlines || (object)e == cfg.HudBeams)
			{
				return !flag;
			}
			if ((object)e == cfg.ElementVfx)
			{
				return flag ? ElementVfx.Reduced : ElementVfx.Full;
			}
			if ((object)e == cfg.NameplateRange)
			{
				return flag ? 12f : ((p == PerfPreset.High) ? 30f : 20f);
			}
			if ((object)e == cfg.PerfBarRange)
			{
				return flag ? 15f : 120f;
			}
			if ((object)e == cfg.PerfFxRings)
			{
				return flag ? 6 : 12;
			}
			return null;
		}

		public static void Apply(PerfPreset p, bool record = true)
		{
			if (record)
			{
				SettingsSync.SaveLocalChange(Set);
			}
			else
			{
				Set();
			}
			void Set()
			{
				Plugin.Cfg.PerfPreset.Value = p;
				if (p != PerfPreset.Auto && p != PerfPreset.Custom)
				{
					ConfigEntryBase[] all = All;
					foreach (ConfigEntryBase val in all)
					{
						object obj = Value(p, val);
						if (obj != null && !object.Equals(val.BoxedValue, obj))
						{
							val.BoxedValue = obj;
						}
					}
				}
			}
		}

		public static PerfPreset Matching()
		{
			PerfPreset[] array = new PerfPreset[3]
			{
				PerfPreset.Low,
				PerfPreset.Medium,
				PerfPreset.High
			};
			foreach (PerfPreset perfPreset in array)
			{
				bool flag = true;
				ConfigEntryBase[] all = All;
				foreach (ConfigEntryBase val in all)
				{
					object obj = Value(perfPreset, val);
					if (obj != null && !object.Equals(val.BoxedValue, obj))
					{
						flag = false;
						break;
					}
				}
				if (flag)
				{
					return perfPreset;
				}
			}
			return PerfPreset.Custom;
		}

		public static void TickAuto()
		{
			//IL_0175: Unknown result type (might be due to invalid IL or missing references)
			if (_autoDone || Plugin.Cfg.PerfPreset.Value != PerfPreset.Auto || !Game.InLevel() || Game.IsLoading() || RpgRuntime.MenuBlocksGame)
			{
				return;
			}
			float unscaledDeltaTime = Time.unscaledDeltaTime;
			if (unscaledDeltaTime <= 0f || unscaledDeltaTime > 0.5f)
			{
				return;
			}
			if (_autoStart < 0f)
			{
				_autoStart = Time.unscaledTime;
			}
			_autoSum += unscaledDeltaTime;
			_autoFrames++;
			if (Time.unscaledTime - _autoStart < 60f)
			{
				return;
			}
			_autoDone = true;
			float num = (float)_autoFrames / Mathf.Max(0.001f, _autoSum);
			PerfPreset perfPreset = ((num >= 55f) ? PerfPreset.High : ((!(num >= 35f)) ? PerfPreset.Low : PerfPreset.Medium));
			ConfigEntryBase[] all = All;
			foreach (ConfigEntryBase val in all)
			{
				object obj = Value(perfPreset, val);
				if (obj != null && !object.Equals(val.BoxedValue, obj))
				{
					val.BoxedValue = obj;
				}
			}
			Plugin.Cfg.PerfAutoPicked.Value = $"{perfPreset} ({num:0} FPS in the first minute)";
			Plugin.Log.LogInfo((object)$"[performance] Auto: {num:0} FPS over the first minute of play -> {perfPreset}.");
			RpgRuntime.Instance?.Toast($"Performance (Auto): {perfPreset} - {num:0} FPS measured. Settings > Performance to change it.", new Color(0.6f, 0.85f, 1f), 4f);
		}

		public static string Describe(PerfPreset p)
		{
			return p switch
			{
				PerfPreset.Auto => "Measures your first minute in a level, then picks Low, Medium or High.", 
				PerfPreset.Low => "Reduced effects, no outlines or light beams, element icons without the glow, shorter nameplate and health bar range, fewer floor rings.", 
				PerfPreset.Medium => "RepoRPG's normal visuals.", 
				PerfPreset.High => "Everything on, nameplates seen from further away.", 
				_ => "Set by hand.", 
			};
		}
	}
	internal enum RunLineShow
	{
		Always,
		TruckAndShop,
		Never
	}
	internal sealed class SearchDoc
	{
		public string Hay = "";

		public string[] Words = Array.Empty<string>();
	}
	internal static class TextSearch
	{
		private static readonly char[] Space = new char[1] { ' ' };

		private static readonly (string has, string add)[] Related = new(string, string)[37]
		{
			("scrap", "money currency coins cash"),
			("currency", "money scrap coins cash"),
			("price", "cost money buy"),
			("shop", "store buy price"),
			("xp", "experience exp leveling"),
			("level", "xp leveling"),
			("health", "hp heal"),
			("hp", "health heal"),
			("heal", "health hp healing"),
			("revive", "revival respawn death dead"),
			("death", "dead die revive"),
			("elite", "elites champion monster enemy"),
			("enem", "monster monsters enemy"),
			("monster", "enemy enemies"),
			("boss", "bosses"),
			("player", "players lobby count"),
			("lobby", "players"),
			("stamina", "sprint energy run"),
			("sprint", "stamina run energy"),
			("upgrade", "upgrades"),
			("cooldown", "ability cd"),
			("abilit", "ability abilities skill cooldown"),
			("contract", "contracts quest quests mission missions"),
			("damage", "dmg"),
			("threat", "difficulty hard"),
			("difficult", "hard threat"),
			("cap", "limit max maximum"),
			("late join", "latejoin join joining"),
			("carry", "carrying hold holding"),
			("valuable", "loot items haul"),
			("gear", "items equipment loot"),
			("craft", "crafting parts"),
			("perk", "perks"),
			("attribute", "attributes stats"),
			("chance", "odds probability"),
			("percent", "%"),
			("%", "percent")
		};

		private static int[] _r0 = new int[64];

		private static int[] _r1 = new int[64];

		private static int[] _r2 = new int[64];

		private static bool[] _mark = new bool[256];

		public static string[] Tokens(string query)
		{
			if (string.IsNullOrEmpty(query))
			{
				return Array.Empty<string>();
			}
			return query.ToLowerInvariant().Split(Space, StringSplitOptions.RemoveEmptyEntries);
		}

		public static SearchDoc Doc(string text, bool related = true)
		{
			string text2 = (text ?? "").ToLowerInvariant();
			if (related)
			{
				StringBuilder stringBuilder = new StringBuilder(text2);
				(string, string)[] related2 = Related;
				for (int i = 0; i < related2.Length; i++)
				{
					var (value, value2) = related2[i];
					if (text2.Contains(value))
					{
						stringBuilder.Append(' ').Append(value2);
					}
				}
				text2 = stringBuilder.ToString();
			}
			List<string> list = new List<string>();
			HashSet<string> hashSet = new HashSet<string>();
			int num = -1;
			for (int j = 0; j <= text2.Length; j++)
			{
				if (j < text2.Length && char.IsLetterOrDigit(text2[j]))
				{
					if (num < 0)
					{
						num = j;
					}
				}
				else
				{
					if (num < 0)
					{
						continue;
					}
					if (j - num >= 3)
					{
						string item = text2.Substring(num, j - num);
						if (hashSet.Add(item))
						{
							list.Add(item);
						}
					}
					num = -1;
				}
			}
			return new SearchDoc
			{
				Hay = text2,
				Words = list.ToArray()
			};
		}

		public static int Tolerance(int len)
		{
			if (len > 3)
			{
				if (len > 6)
				{
					return 2;
				}
				return 1;
			}
			return 0;
		}

		public static bool Matches(SearchDoc d, string[] tokens)
		{
			foreach (string t in tokens)
			{
				if (!TokenMatches(d, t))
				{
					return false;
				}
			}
			return true;
		}

		public static bool TokenMatches(SearchDoc d, string t)
		{
			if (d.Hay.IndexOf(t, StringComparison.Ordinal) >= 0)
			{
				return true;
			}
			int num = Tolerance(t.Length);
			if (num == 0)
			{
				return false;
			}
			string[] words = d.Words;
			foreach (string text in words)
			{
				if (Close(t, text, 0, text.Length, num))
				{
					return true;
				}
			}
			return false;
		}

		private static bool Close(string t, string w, int from, int len, int k)
		{
			if (Math.Abs(len - t.Length) <= k && Lev(t, w, from, len, k) <= k)
			{
				return true;
			}
			for (int i = Math.Max(1, t.Length - 1); i <= t.Length + 1 && i < len; i++)
			{
				if (Lev(t, w, from, i, k) <= k)
				{
					return true;
				}
			}
			return false;
		}

		private static int Lev(string a, string b, int from, int len, int k)
		{
			int length = a.Length;
			if (len + 1 > _r0.Length)
			{
				_r0 = new int[len + 16];
				_r1 = new int[len + 16];
				_r2 = new int[len + 16];
			}
			int[] array = _r2;
			int[] array2 = _r0;
			int[] array3 = _r1;
			for (int i = 0; i <= len; i++)
			{
				array2[i] = i;
			}
			for (int j = 1; j <= length; j++)
			{
				array3[0] = j;
				int num = j;
				for (int l = 1; l <= len; l++)
				{
					int num2 = ((a[j - 1] != b[from + l - 1]) ? 1 : 0);
					int num3 = Math.Min(Math.Min(array2[l] + 1, array3[l - 1] + 1), array2[l - 1] + num2);
					if (j > 1 && l > 1 && a[j - 1] == b[from + l - 2] && a[j - 2] == b[from + l - 1])
					{
						num3 = Math.Min(num3, array[l - 2] + 1);
					}
					array3[l] = num3;
					if (num3 < num)
					{
						num = num3;
					}
				}
				if (num > k)
				{
					return k + 1;
				}
				int[] array4 = array;
				array = array2;
				array2 = array3;
				array3 = array4;
			}
			return array2[len];
		}

		public static string Highlight(string text, string[] tokens, string hex)
		{
			if (string.IsNullOrEmpty(text) || tokens.Length == 0)
			{
				return text;
			}
			string text2 = text.ToLowerInvariant();
			if (text2.Length != text.Length)
			{
				return text;
			}
			if (_mark.Length < text.Length)
			{
				_mark = new bool[text.Length + 64];
			}
			Array.Clear(_mark, 0, text.Length);
			bool flag = false;
			foreach (string text3 in tokens)
			{
				int startIndex = 0;
				int num = 0;
				while ((startIndex = text2.IndexOf(text3, startIndex, StringComparison.Ordinal)) >= 0)
				{
					for (int j = startIndex; j < startIndex + text3.Length; j++)
					{
						_mark[j] = true;
					}
					startIndex += Math.Max(1, text3.Length);
					num++;
					flag = true;
				}
				if (num > 0)
				{
					continue;
				}
				int num2 = Tolerance(text3.Length);
				if (num2 == 0)
				{
					continue;
				}
				int num3 = -1;
				for (int k = 0; k <= text2.Length; k++)
				{
					if (k < text2.Length && char.IsLetterOrDigit(text2[k]))
					{
						if (num3 < 0)
						{
							num3 = k;
						}
						continue;
					}
					if (num3 >= 0 && k - num3 >= 3 && Close(text3, text2, num3, k - num3, num2))
					{
						for (int l = num3; l < k; l++)
						{
							_mark[l] = true;
						}
						flag = true;
					}
					num3 = -1;
				}
			}
			if (!flag)
			{
				return text;
			}
			StringBuilder stringBuilder = new StringBuilder(text.Length + 32);
			bool flag2 = false;
			for (int m = 0; m < text.Length; m++)
			{
				if (_mark[m] && !flag2)
				{
					stringBuilder.Append("<color=").Append(hex).Append('>');
					flag2 = true;
				}
				else if (!_mark[m] && flag2)
				{
					stringBuilder.Append("</color>");
					flag2 = false;
				}
				stringBuilder.Append(text[m]);
			}
			if (flag2)
			{
				stringBuilder.Append("</color>");
			}
			return stringBuilder.ToString();
		}
	}
	internal static class UiAudio
	{
		private sealed class Entry
		{
			public AudioClip[] Clips = Array.Empty<AudioClip>();

			public float Volume = 0.5f;

			public float VolumeRandom;

			public float Pitch = 1f;

			public float PitchRandom;

			public AudioMixerGroup? Group;
		}

		private static readonly Dictionary<RpgRuntime.UiSound, Entry?> Cache = new Dictionary<RpgRuntime.UiSound, Entry>();

		private static GameObject? _root;

		private static AudioSource? _hover;

		private static readonly AudioSource[] Pool = (AudioSource[])(object)new AudioSource[3];

		private static int _next;

		private static float _lastHover = -99f;

		private static readonly Random Rng = new Random();

		public static int Played;

		public static int Throttled;

		public static int Fallback;

		private static string FieldFor(RpgRuntime.UiSound k)
		{
			return k switch
			{
				RpgRuntime.UiSound.Hover => "soundHover", 
				RpgRuntime.UiSound.Tick => "soundTick", 
				RpgRuntime.UiSound.Confirm => "soundConfirm", 
				RpgRuntime.UiSound.Error => "soundDeny", 
				RpgRuntime.UiSound.Back => "soundDud", 
				_ => "soundAction", 
			};
		}

		public static bool Play(RpgRuntime.UiSound kind)
		{
			bool flag = kind == RpgRuntime.UiSound.Hover || kind == RpgRuntime.UiSound.Tick;
			float unscaledTime = Time.unscaledTime;
			if (flag)
			{
				if (unscaledTime - _lastHover < Mathf.Clamp(Plugin.Cfg.HoverSoundMs.Value, 20f, 500f) / 1000f)
				{
					Throttled++;
					return true;
				}
				_lastHover = unscaledTime;
			}
			Entry entry = Get(kind);
			if (entry == null || entry.Clips.Length == 0 || !EnsurePool())
			{
				return false;
			}
			AudioClip val = entry.Clips[(entry.Clips.Length != 1) ? Rng.Next(entry.Clips.Length) : 0];
			if ((Object)(object)val == (Object)null)
			{
				return false;
			}
			float volume = Mathf.Clamp01(entry.Volume + (float)(Rng.NextDouble() * 2.0 - 1.0) * entry.VolumeRandom);
			float pitch = Mathf.Clamp(entry.Pitch + (float)(Rng.NextDouble() * 2.0 - 1.0) * entry.PitchRandom, 0.5f, 2f);
			object obj = (flag ? ((object)_hover) : ((object)Pool[_next++ % Pool.Length]));
			((AudioSource)obj).Stop();
			((AudioSource)obj).outputAudioMixerGroup = entry.Group;
			((AudioSource)obj).clip = val;
			((AudioSource)obj).volume = volume;
			((AudioSource)obj).pitch = pitch;
			((AudioSource)obj).Play();
			Played++;
			return true;
		}

		private static bool EnsurePool()
		{
			//IL_0021: Unknown result type (might be due to invalid IL or missing references)
			//IL_0026: Unknown result type (might be due to invalid IL or missing references)
			//IL_0033: Expected O, but got Unknown
			if ((Object)(object)_root != (Object)null && (Object)(object)_hover != (Object)null)
			{
				return true;
			}
			_root = new GameObject("RepoRPG UI Audio")
			{
				hideFlags = (HideFlags)61
			};
			Object.DontDestroyOnLoad((Object)(object)_root);
			_hover = Make();
			for (int i = 0; i < Pool.Length; i++)
			{
				Pool[i] = Make();
			}
			return true;
			static AudioSource Make()
			{
				AudioSource obj = _root.AddComponent<AudioSource>();
				obj.playOnAwake = false;
				obj.spatialBlend = 0f;
				obj.ignoreListenerPause = true;
				obj.priority = 32;
				return obj;
			}
		}

		private static Entry? Get(RpgRuntime.UiSound kind)
		{
			if (Cache.TryGetValue(kind, out Entry value))
			{
				return value;
			}
			Type type = AccessTools.TypeByName("MenuManager");
			object obj = ((type == null) ? null : AccessTools.Field(type, "instance")?.GetValue(null));
			if (obj == null)
			{
				return null;
			}
			Entry entry = null;
			try
			{
				object obj2 = AccessTools.Field(type, FieldFor(kind))?.GetValue(obj) ?? AccessTools.Field(type, "soundAction")?.GetValue(obj);
				if (obj2 != null)
				{
					Type type2 = obj2.GetType();
					entry = new Entry
					{
						Clips = ((AccessTools.Field(type2, "Sounds")?.GetValue(obj2) as AudioClip[]) ?? Array.Empty<AudioClip>()),
						Volume = F(type2, obj2, "Volume", 0.5f),
						VolumeRandom = F(type2, obj2, "VolumeRandom", 0f),
						Pitch = F(type2, obj2, "Pitch", 1f),
						PitchRandom = F(type2, obj2, "PitchRandom", 0f)
					};
					entry.Group = GroupFor(AccessTools.Field(type2, "Type")?.GetValue(obj2)?.ToString() ?? "");
					if (entry.Clips.Length == 0)
					{
						entry = null;
					}
				}
			}
			catch (Exception ex)
			{
				Game.WarnOnce($"UI sounds: couldn't read the game's {kind} sound ({ex.GetBaseException().Message}); using the game's call.");
				entry = null;
			}
			Cache[kind] = entry;
			return entry;
		}

		private static float F(Type t, object o, string name, float fallback)
		{
			try
			{
				return (AccessTools.Field(t, name)?.GetValue(o) is float num) ? num : fallback;
			}
			catch
