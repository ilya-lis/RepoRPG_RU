				DrawPerkGrid(val, run, _allList, owned: false, sets);
			}
		}

		private string PerkSummaryLine(PerkDef p)
		{
			if (_perkSummary.TryGetValue(p.id, out string value))
			{
				return value;
			}
			string text = StripRich(p.desc);
			int num = text.IndexOf(". ", StringComparison.Ordinal);
			value = ((num > 0) ? text.Substring(0, num + 1) : text);
			_perkSummary[p.id] = value;
			return value;
		}

