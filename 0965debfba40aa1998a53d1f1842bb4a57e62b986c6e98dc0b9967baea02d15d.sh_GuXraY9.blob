		private void AttuneAdd(int points)
		{
			//IL_00f2: Unknown result type (might be due to invalid IL or missing references)
			if (points <= 0)
			{
				return;
			}
			RunSave data = _store.Data;
			int num = Mathf.RoundToInt((float)points * Mathf.Clamp(Plugin.Cfg.AttunementSpeed.Value, 0f, 5f));
			if (num <= 0)
			{
				return;
			}
			bool flag = false;
			foreach (GearItem item in data.EquippedItems())
			{
				int num2 = GearX.Tier(item);
				item.attune = Mathf.Min(item.attune + num, 9999);
				int num3 = GearX.Tier(item);
				flag = true;
				if (num3 > num2)
				{
					if (num3 >= 1 && item.hidden.Length == 0)
					{
						RollHidden(item);
					}
					Notify(PopupKind.Loot, item.name + " is " + GearX.TierNames[num3 - 1] + "! " + GearMilestoneText(num3), (Color?)new Color(1f, 0.85f, 0.35f), "");
					_gearFlash[item.uid] = Time.unscaledTime;
					MenuSound(UiSound.Confirm);
					_statsDirty = true;
				}
			}
			if (flag)
			{
				_store.MarkDirty();
				_gearSig = int.MinValue;
			}
		}

		private static string GearMilestoneText(int tier)
		{
			return tier switch
			{
				1 => "A hidden affix appears.", 
				2 => "Its strongest affix gets +25%.", 
				_ => "Base stat +25%, and it's never auto-salvaged.", 
			};
		}

		private static void RollHidden(GearItem it)
		{
			int num = Plugin.Rpg.SlotIndex(it.slot);
			if (num < 0)
			{
				return;
			}
			List<AffixDef> list = new List<AffixDef>(Plugin.Rpg.slots[num].affixes);
			list.RemoveAll((AffixDef a) => Array.Exists(it.effects, (EffectDef e) => string.Equals(e.stat, a.stat, StringComparison.OrdinalIgnoreCase)));
			if (list.Count != 0)
			{
				Random random = new Random(it.uid.GetHashCode());
				AffixDef affixDef = list[random.Next(list.Count)];
				float num2 = (float)(((double)affixDef.min + (double)(affixDef.max - affixDef.min) * random.NextDouble()) * (double)Gear.Rarity(it.rarity).mult * 0.5);
				num2 = ((Mathf.Abs(affixDef.max) >= 1.5f) ? Mathf.Round(num2) : ((float)Math.Round(num2, 2)));
				if (num2 == 0f)
				{
					num2 = ((affixDef.max >= 0f) ? 1f : (-1f));
				}
				it.hidden = new EffectDef[1]
				{
					new EffectDef
					{
						stat = affixDef.stat,
						value = num2
					}
				};
				ClassDatabase.ResolveAll("gear " + it.name, it.hidden);
			}
		}

		public void AddModule(string id, string source)
		{
			//IL_00a5: Unknown result type (might be due to invalid IL or missing references)
			//IL_003d: Unknown result type (might be due to invalid IL or missing references)
			GearModuleDef gearModuleDef = GearX.Module(id);
			if (gearModuleDef != null)
			{
				List<string> moduleBag = _store.Data.moduleBag;
				if (moduleBag.Count >= 10)
				{
					Notify(PopupKind.Loot, "Module bag full: " + gearModuleDef.name + " was lost", Bad);
					return;
				}
				moduleBag.Add(id);
				_store.MarkDirty();
				Notify(PopupKind.Loot, "Module: " + gearModuleDef.name + " (" + source + ")", (Color?)new Color(0.55f, 0.85f, 1f), "");
			}
		}

		private void RollModuleDrop(float chance, string source)
		{
			if (Random.value * 100f >= chance)
			{
				return;
			}
			List<GearModuleDef> list = new List<GearModuleDef>(GearX.AllModules);
			if (Elements.On && Random.value < 0.35f)
			{
				List<GearModuleDef> list2 = list.FindAll((GearModuleDef x) => x.id.EndsWith("_mod", StringComparison.Ordinal));
				if (list2.Count > 0)
				{
					list = list2;
				}
			}
			if (list.Count > 0)
			{
				AddModule(list[Random.Range(0, list.Count)].id, source);
			}
		}

		private void ModulesBackToBag(GearItem g)
		{
			//IL_0084: Unknown result type (might be due to invalid IL or missing references)
			for (int i = 0; i < g.modules.Length; i++)
			{
				if (!string.IsNullOrEmpty(g.modules[i]))
				{
					if (_store.Data.moduleBag.Count < 10)
					{
						_store.Data.moduleBag.Add(g.modules[i]);
					}
					else
					{
						Notify(PopupKind.Loot, "Module bag full: " + (GearX.Module(g.modules[i])?.name ?? "a module") + " was lost", Bad);
					}
					g.modules[i] = "";
				}
			}
		}

		public void SlotModule(GearItem g, int socket, string id)
		{
			//IL_00d1: Unknown result type (might be due to invalid IL or missing references)
			List<string> moduleBag = _store.Data.moduleBag;
			if (socket < 0 || socket >= g.modules.Length || g.modules[socket] != "" || !moduleBag.Contains(id))
			{
				MenuSound(UiSound.Error);
				return;
			}
			moduleBag.Remove(id);
			g.modules[socket] = id;
			_statsDirty = true;
			_store.MarkDirty();
			_store.SaveNow();
			_gearSig = int.MinValue;
			_gearFlash[g.uid] = Time.unscaledTime;
			MenuSound(UiSound.Confirm);
			Notify(PopupKind.Loot, "Slotted " + GearX.Module(id)?.name + " into " + g.name, (Color?)new Color(0.55f, 0.85f, 1f), "");
		}

		public void RemoveModule(GearItem g, int socket)
		{
			//IL_0066: Unknown result type (might be due to invalid IL or missing references)
			if (socket < 0 || socket >= g.modules.Length || g.modules[socket] == "")
			{
				return;
			}
			if (_store.Data.moduleBag.Count >= 10)
			{
				Toast("Your module bag is full", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			string uid = g.uid;
			Buy("moduleremove", "remove module from " + g.name, Plugin.Cfg.ModuleRemoveCost.Value, delegate
			{
				GearItem gearItem = _store.Data.FindItem(uid);
				if (gearItem != null && socket < gearItem.modules.Length && !(gearItem.modules[socket] == ""))
				{
					_store.Data.moduleBag.Add(gearItem.modules[socket]);
					gearItem.modules[socket] = "";
					_statsDirty = true;
					_store.MarkDirty();
					_store.SaveNow();
					_gearSig = int.MinValue;
				}
			});
		}

		public void CraftModule(string? chosen)
		{
			//IL_0030: Unknown result type (might be due to invalid IL or missing references)
			//IL_0065: Unknown result type (might be due to invalid IL or missing references)
			int[] array = ((chosen == null) ? ModuleRandomCost : ModuleChosenCost);
			if (!Plugin.Cfg.CraftingParts.Value || !CanAfford(array))
			{
				Toast("Not enough parts", Color.gray);
				MenuSound(UiSound.Error);
				return;
			}
			if (_store.Data.moduleBag.Count >= 10)
			{
				Toast("Your module bag is full", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			string text = chosen ?? "";
			if (text == "")
			{
				List<GearModuleDef> list = new List<GearModuleDef>(GearX.AllModules);
				if (list.Count == 0)
				{
					return;
				}
				text = list[Random.Range(0, list.Count)].id;
			}
			int[] parts = Parts;
			for (int i = 0; i < 4; i++)
			{
				parts[i] -= array[i];
			}
			AddModule(text, "crafted");
			_store.SaveNow();
			MenuSound(UiSound.Confirm);
		}

		private GearLoadout LoadoutAt(int i)
		{
			List<GearLoadout> loadouts = _store.Data.loadouts;
			while (loadouts.Count < 3)
			{
				loadouts.Add(new GearLoadout
				{
					name = $"Loadout {loadouts.Count + 1}"
				});
			}
			return loadouts[i];
		}

		public void SaveLoadout(int i)
		{
			GearLoadout gearLoadout = LoadoutAt(i);
			gearLoadout.uids = (string[])_store.Data.equipped.Clone();
			_store.MarkDirty();
			_store.SaveNow();
			MenuSound(UiSound.Confirm);
			Notify(PopupKind.Other, gearLoadout.name + " saved");
		}

		public void ApplyLoadout(int i)
		{
			//IL_000d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0051: Unknown result type (might be due to invalid IL or missing references)
			if (!LoadoutSwapAllowed)
			{
				Toast("Loadouts swap in the truck or the shop, not mid-level", Bad);
				MenuSound(UiSound.Error);
				return;
			}
			RunSave data = _store.Data;
			GearLoadout gearLoadout = LoadoutAt(i);
			if (gearLoadout.uids.Length == 0)
			{
				Toast(gearLoadout.name + " is empty - save one first", Color.gray);
				MenuSound(UiSound.Error);
				return;
			}
			int num = 0;
			for (int j = 0; j < data.equipped.Length; j++)
			{
				string text = ((j < gearLoadout.uids.Length) ? gearLoadout.uids[j] : "");
				if (text != "" && data.FindItem(text) == null)
				{
					num++;
					text = "";
				}
				data.equipped[j] = text;
			}
			EnforceOneCursed();
			_statsDirty = true;
			_store.MarkDirty();
			_store.SaveNow();
			_gearSig = int.MinValue;
			MenuSound(UiSound.Confirm);
			Notify(PopupKind.Other, gearLoadout.name + " equipped" + ((num > 0) ? string.Format(" ({0} item{1} gone)", num, (num == 1) ? "" : "s") : ""));
		}

		public void OnLateJoinWelcome(int where)
		{
