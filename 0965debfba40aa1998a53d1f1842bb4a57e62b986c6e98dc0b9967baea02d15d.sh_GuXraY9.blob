		private int RunShapeKey()
		{
			return ((!RunUnderWay) ? 7777777 : 0) + RunInfo.LevelIndex * 1000003 + RunShape.Cur.Streak * 7919 + RunShape.Cur.Seq * 31 + (Game.InLevel() ? 1 : 0) + RunShape.Every * 2 + ((!Plugin.Cfg.MilestonesOn.Value) ? 97 : 0) + ((!Plugin.Cfg.StreaksOn.Value) ? 389 : 0);
		}

		public string RunShapeHudLine()
		{
			int num = RunShapeKey();
			if (num == _rsHudFor)
			{
				return _rsHud;
			}
			_rsHudFor = num;
			if (!RunUnderWay)
			{
				_rsHud = "";
				return _rsHud;
			}
			List<string> list = new List<string>();
			ModConfig cfg = Plugin.Cfg;
			if (cfg.MilestonesOn.Value)
			{
				int levelsToMilestone = RunShape.LevelsToMilestone;
				bool num2 = Game.InLevel() && RunShape.IsMilestoneLevel(RunInfo.LevelIndex);
				string text = (Season.On ? Season.ChapterLabel(RunShape.Chapter).ToUpperInvariant() : $"CHAPTER {RunShape.Chapter}");
				bool flag = Season.IsFinaleLevel(RunInfo.LevelIndex);
				if (num2)
				{
					list.Add(flag ? ("FINALE - " + text) : ("MILESTONE LEVEL - " + text));
				}
				else if (!Game.InLevel())
				{
					list.Add((levelsToMilestone == 0) ? (text + " · NEXT LEVEL IS " + (Season.IsFinaleLevel(RunInfo.LevelIndex) ? "THE FINALE" : "A MILESTONE")) : $"{text} · MILESTONE IN {levelsToMilestone + 1}");
				}
			}
			if (cfg.StreaksOn.Value && RunShape.Cur.Streak > 0)
			{
				list.Add($"STREAK {RunShape.Cur.Streak} +{RunShape.StreakXpPct:0}%");
			}
			if (cfg.ShowBoons.Value && RunShape.Cur.Boons.Length != 0)
			{
				list.Add($"BOONS {RunShape.Cur.Boons.Length}");
			}
			if (Heat.Total > 0)
			{
				list.Add($"HEAT {Heat.Total}");
			}
			if (Ascension.Level > 0)
			{
				list.Add($"A{Ascension.Level}");
			}
			if (cfg.CrewOn.Value && !Game.InLevel())
			{
				list.Add($"CREW {RunShape.CrewLevel}");
			}
			_rsHud = string.Join("  ·  ", list);
			return _rsHud;
		}

		public string RunBoonsHudLine()
		{
			bool behind = _behind;
			bool runUnderWay = RunUnderWay;
			int num = RunShape.Cur.Seq * 8 + (Plugin.Cfg.ShowBoons.Value ? 1 : 0) + (behind ? 2 : 0) + (runUnderWay ? 4 : 0);
			if (num == _boonsHudFor)
			{
				return _boonsHud;
			}
			_boonsHudFor = num;
			if (!runUnderWay)
			{
				_boonsHud = "";
				return _boonsHud;
			}
			StringBuilder stringBuilder = new StringBuilder();
			if (Plugin.Cfg.ShowBoons.Value && RunShape.Cur.Boons.Length != 0)
			{
				stringBuilder.Append("BOONS");
				string[] boons = RunShape.Cur.Boons;
				foreach (string text in boons)
				{
					BoonDef boonDef = RunShape.Boon(text);
					stringBuilder.Append(' ').Append((boonDef != null && boonDef.code != "") ? boonDef.code : ((text.Length >= 2) ? text.Substring(0, 2).ToUpperInvariant() : text));
				}
			}
			if (behind)
			{
				stringBuilder.Append((stringBuilder.Length > 0) ? "  ·  " : "").Append($"CATCH-UP +{Mathf.Clamp(Plugin.Cfg.BehindXpBonus.Value, 0f, 100f):0}% XP");
			}
			_boonsHud = stringBuilder.ToString();
			return _boonsHud;
		}

		public static string RunShapeBanner()
		{
			RpgRuntime instance = Instance;
			if ((Object)(object)instance == (Object)null)
			{
				return "";
			}
			int num = instance.RunShapeKey();
			if (num == instance._rsBannerFor)
			{
				return instance._rsBanner;
			}
			instance._rsBannerFor = num;
			if (!RunUnderWay)
			{
				instance._rsBanner = "";
				return instance._rsBanner;
			}
			List<string> list = new List<string>();
			ModConfig cfg = Plugin.Cfg;
			if (cfg.MilestonesOn.Value && RunInfo.LevelIndex >= 0)
			{
				int levelsToMilestone = RunShape.LevelsToMilestone;
				string text = (Season.On ? (Season.ChapterLabel(RunShape.Chapter) + " - " + Season.ChapterName(RunShape.Chapter)) : $"Chapter {RunShape.Chapter}");
				list.Add((levelsToMilestone == 0) ? (text + " · next level: " + (Season.IsFinaleLevel(RunInfo.LevelIndex) ? "THE FINALE" : "milestone boss")) : $"{text} · next milestone: {levelsToMilestone + 1} levels");
				if (Season.On && Season.Won)
				{
					list.Add(Season.Endless ? "Endless" : "Run won");
				}
			}
			if (cfg.StreaksOn.Value && RunShape.Cur.Streak > 0)
			{
				list.Add($"Streak {RunShape.Cur.Streak} (+{RunShape.StreakXpPct:0}%)");
			}
			if (RunShape.Cur.Boons.Length != 0)
			{
				list.Add(string.Format("{0} run boon{1}", RunShape.Cur.Boons.Length, (RunShape.Cur.Boons.Length == 1) ? "" : "s"));
			}
			if (Routes.On && RunShape.Cur.RouteFor == RunInfo.LevelIndex && RunShape.Cur.RouteChosen < 0 && RunShape.Cur.RouteOptions.Length > 1)
			{
				list.Add("Route vote open (Shop tab)");
			}
			else
			{
				string text2 = Routes.ChosenFor(RunInfo.LevelIndex);
				if (text2 != null && text2 != "")
				{
					list.Add("Next level: " + Routes.Name(text2));
				}
				else if (RunDepth.HasMods)
				{
					List<string> list2 = new List<string>();
					foreach (MapModifierDef levelMod in RunDepth.LevelMods)
					{
						list2.Add(levelMod.name);
					}
					list.Add("Next level: " + string.Join(" + ", list2));
				}
			}
			if (Heat.On && (RunShape.Cur.Heat > 0 || RunShape.Cur.HeatFor != 0))
			{
				list.Add((RunShape.Cur.HeatFor != 0) ? $"Heat {RunShape.Cur.Heat} · heat vote open (Shop tab)" : $"Heat {RunShape.Cur.Heat} (Scrap +{(float)Mathf.Min(RunShape.Cur.Heat, Heat.Data.maxRewardHeat) * Heat.Data.scrapPerHeat:0}%)");
			}
			if (cfg.CrewOn.Value)
			{
				var (num2, num3) = RunShape.CrewProgress(RunShape.Cur.CrewXp);
				list.Add((num3 > 0) ? $"Crew {RunShape.CrewLevel} ({num2}/{num3})" : $"Crew {RunShape.CrewLevel} (max)");
			}
			instance._rsBanner = string.Join("  ·  ", list);
			return instance._rsBanner;
		}

		public void OnRecap(string json)
		{
			//IL_0422: Unknown result type (might be due to invalid IL or missing references)
			RunShape.Recap recap;
			try
			{
				recap = Json.Deserialize<RunShape.Recap>(json);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[run] the recap couldn't be read: " + ex.Message));
				return;
			}
			if (recap == null)
			{
				return;
			}
			_recap = recap;
			_recapRecords.Clear();
			string text = Game.SteamId(Game.LocalPlayer());
			RunPlayerTotals runPlayerTotals = null;
			foreach (RunPlayerTotals player in recap.players)
			{
				if (player.steamId == text)
				{
					runPlayerTotals = player;
				}
			}
			Rec("levels", recap.levels, "Most levels cleared");
			Rec("levels." + DifficultyName(recap.difficulty), recap.levels, "Most levels on " + DifficultyName(recap.difficulty));
			Rec("streak", recap.bestStreak, "Best streak");
			Rec("chapter", recap.chapter, "Highest chapter");
			Rec("bosses", recap.bosses, "Most bosses in a run");
			if (recap.victory && recap.heat > 0)
			{
				Rec("heatwin", recap.heat, "Highest heat at Victory");
				Rec("heatwin." + DifficultyName(recap.difficulty), recap.heat, "Highest heat at Victory on " + DifficultyName(recap.difficulty));
			}
			if (recap.victory)
			{
				Account.Count("wins");
				Account.Count("wins." + DifficultyName(recap.difficulty));
				if (Current != null)
				{
					Account.Count("wins.class." + Current.id);
				}
				_recapRecords.Add(string.Format("Season won on {0} (wins: {1})", DifficultyName(recap.difficulty), Account.Counter("wins")));
			}
			if (runPlayerTotals != null)
			{
				Rec("scrap", Mathf.RoundToInt(runPlayerTotals.scrap), "Most Scrap in a run");
				Rec("haul", Mathf.RoundToInt(runPlayerTotals.bestCarryLevel), "Biggest haul carried in one level ($)");
			}
			List<string> list = new List<string>();
			foreach (ClassProgress @class in _store.Data.classes)
			{
				ClassDef classDef = Plugin.Db.Get(@class.classId);
				if (classDef != null)
				{
					list.Add(classDef.name);
				}
			}
			Account.AddHistory(new RunHistoryEntry
			{
				endedUtc = recap.ended,
				difficulty = recap.difficulty,
				classes = string.Join(", ", list),
				levels = recap.levels,
				chapter = recap.chapter,
				bestStreak = recap.bestStreak,
				bosses = recap.bosses,
				scrap = (runPlayerTotals?.scrap ?? 0f),
				lost = (recap.failed > 0 && !recap.victory),
				won = recap.victory
			});
			Account.Data.lastRecap = json;
			Account.MarkDirty();
			Notify(PopupKind.Other, (recap.victory ? $"VICTORY: {recap.levels} levels, the finale beaten! " : string.Format("Run over: {0} level{1}, chapter {2}. ", recap.levels, (recap.levels == 1) ? "" : "s", recap.chapter)) + "The recap is on the Account tab (" + MenuPrompt + ")" + ((_recapRecords.Count > 0) ? string.Format(" - {0} new record{1}!", _recapRecords.Count, (_recapRecords.Count == 1) ? "" : "s") : ""), (Color?)new Color(1f, 0.85f, 0.35f), "");
			_recapText = "";
			if (!recap.victory)
			{
				RunShape.Reset();
			}
			void Rec(string key, int v, string what)
			{
				if (Account.Record(key, v))
				{
					_recapRecords.Add($"{what}: {v:N0}");
				}
			}
		}

		private static string DifficultyName(string label)
		{
			if (label.Contains("Custom"))
			{
				return "Custom";
			}
			string[] names = DifficultyPresets.Names;
			foreach (string text in names)
			{
				if (label.Contains(text))
				{
					return text;
				}
			}
			return "Custom";
		}

		private void EnsureRecap()
		{
			if (_recap == null && !string.IsNullOrEmpty(Account.Data.lastRecap))
			{
				try
				{
					_recap = Json.Deserialize<RunShape.Recap>(Account.Data.lastRecap);
				}
				catch
				{
					_recap = null;
				}
				_recapText = "";
			}
		}

		private void DrawRunsPage(Rect area)
		{
			//IL_008e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0148: Unknown result type (might be due to invalid IL or missing references)
			//IL_014a: Unknown result type (might be due to invalid IL or missing references)
			//IL_016e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0173: Unknown result type (might be due to invalid IL or missing references)
			//IL_0178: Unknown result type (might be due to invalid IL or missing references)
			//IL_01c5: Unknown result type (might be due to invalid IL or missing references)
			//IL_01f9: Unknown result type (might be due to invalid IL or missing references)
			//IL_022d: Unknown result type (might be due to invalid IL or missing references)
			//IL_025b: Unknown result type (might be due to invalid IL or missing references)
			//IL_019c: Unknown result type (might be due to invalid IL or missing references)
			EnsureRecap();
			if (_recapText == "")
			{
				_recapText = BuildRecapText();
			}
			int num = Account.Data.history?.Count ?? 0;
			if (_historyFor != num + Account.Data.records.Count * 1000)
			{
				_historyFor = num + Account.Data.records.Count * 1000;
				_historyText = BuildHistoryText();
				_recordsText = BuildRecordsText();
			}
			float num2 = ScrollW(area);
			string text = RunDetailsText();
			string text2 = ((text != "") ? ("<b>THIS RUN</b>\n" + text) : "");
			float num3 = ((text2 != "") ? (TextH(text2, _body, num2) + 16f) : 0f);
			float num4 = TextH(_recapText, _body, num2);
			float num5 = TextH(_recordsText, _body, num2);
			float num6 = TextH(_historyText, _small, num2);
			float num7 = num3 + num4 + 16f + num5 + 16f + num6 + 8f;
			_accountScroll = BeginScroll(11, area, _accountScroll, new Rect(0f, 0f, num2, Mathf.Max(num7, ((Rect)(ref area)).height - 2f)));
			float num8 = 0f;
			if (text2 != "")
			{
				Label(new Rect(0f, num8, num2, num3), text2, _body);
				num8 += num3;
			}
			Label(new Rect(0f, num8, num2, num4 + 2f), _recapText, _body);
			num8 += num4 + 16f;
			Label(new Rect(0f, num8, num2, num5 + 2f), _recordsText, _body);
			num8 += num5 + 16f;
			Label(new Rect(0f, num8, num2, num6 + 2f), _historyText, _small);
			RegisterFocus(new Rect(0f, 0f, num2, Mathf.Min(num7, 40f)));
			EndScroll();
		}

		private string BuildRecapText()
		{
			RunShape.Recap recap = _recap;
			if (recap == null)
			{
				return "<b>LAST RUN</b>\n<color=#9a9ca0>No run has ended yet. When one does, its recap shows here.</color>";
			}
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append(recap.victory ? ("<b>LAST RUN</b>  <color=#ffd75a><b>VICTORY</b></color>  <color=#9a9ca0>" + Date(recap.ended) + "  ·  " + recap.difficulty + "</color>\n") : ("<b>LAST RUN</b>  <color=#9a9ca0>" + Date(recap.ended) + "  ·  " + recap.difficulty + "</color>\n"));
			stringBuilder.Append($"Levels cleared <b>{recap.levels}</b>  ·  chapter <b>{recap.chapter}</b>  ·  milestones <b>{recap.milestones}</b>  ·  best streak <b>{recap.bestStreak}</b>\n");
			stringBuilder.Append(string.Format("Total haul <b>${0:N0}</b>  ·  bosses <b>{1}</b>{2}  ·  elites <b>{3}</b>\n", recap.haul, recap.bosses, (recap.milestoneBosses > 0) ? $" ({recap.milestoneBosses} milestone)" : "", recap.elites));
			float num = 0f;
			foreach (RunPlayerTotals player in recap.players)
			{
				num += player.scrap;
			}
			stringBuilder.Append($"Scrap earned by the team <b>{num:N0}</b>\n");
			if (_recapRecords.Count > 0)
			{
				stringBuilder.Append("<color=#ffd75a><b>New record!</b> " + string.Join("  ·  ", _recapRecords) + "</color>\n");
			}
			if (recap.moments.Count > 0)
			{
				stringBuilder.Append("\n<color=#ffcc66>BEST MOMENTS</color>\n").Append(string.Join("\n", recap.moments.ConvertAll((string m) => "  • " + m))).Append('\n');
			}
			if (recap.mvps.Count > 0)
			{
				stringBuilder.Append("\n<color=#ffcc66>MVPS</color>\n").Append(string.Join("\n", recap.mvps.ConvertAll((string m) => "  • " + m)));
			}
			return stringBuilder.ToString();
		}

		private static string Date(string utc)
		{
			if (!DateTime.TryParse(utc, null, DateTimeStyles.RoundtripKind, out var result))
			{
				return "";
			}
			return result.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
		}

		private static string BuildRecordsText()
		{
			StringBuilder stringBuilder = new StringBuilder("<b>PERSONAL BESTS</b>\n");
			(string, string)[] obj = new(string, string)[8]
			{
				("levels", "Most levels cleared"),
				("streak", "Best streak"),
				("chapter", "Highest chapter"),
				("bosses", "Most bosses in a run"),
				("scrap", "Most Scrap in a run"),
				("haul", "Biggest haul carried in one level ($)"),
				("heat", "Highest heat a chapter was cleared at"),
				("heatwin", "Highest heat at Victory")
			};
			bool flag = false;
			(string, string)[] array = obj;
			for (int i = 0; i < array.Length; i++)
			{
				(string, string) tuple = array[i];
				string item = tuple.Item1;
				string item2 = tuple.Item2;
				int num = Account.RecordOf(item);
				if (num > 0)
				{
					stringBuilder.Append($"{item2}: <b>{num:N0}</b>\n");
					flag = true;
				}
			}
			List<string> list = new List<string>();
			string[] names = DifficultyPresets.Names;
			foreach (string text in names)
			{
				int num2 = Account.RecordOf("levels." + text);
				if (num2 > 0)
				{
					list.Add($"{text} {num2}");
				}
			}
			List<string> list2 = new List<string>();
			names = DifficultyPresets.Names;
			foreach (string text2 in names)
			{
				int num3 = Mathf.Max(Account.RecordOf("heat." + text2), Account.RecordOf("heatwin." + text2));
				if (num3 > 0)
				{
					list2.Add($"{text2} {num3}");
				}
			}
			if (list2.Count > 0)
			{
				stringBuilder.Append("Best heat by difficulty: ").Append(string.Join("  ·  ", list2)).Append('\n');
				flag = true;
			}
			if (list.Count > 0)
			{
				stringBuilder.Append("Most levels by difficulty: ").Append(string.Join("  ·  ", list)).Append('\n');
				flag = true;
			}
			int num4 = Account.Counter("wins");
			if (num4 > 0)
			{
				List<string> list3 = new List<string>();
				names = DifficultyPresets.Names;
				foreach (string text3 in names)
				{
					int num5 = Account.Counter("wins." + text3);
					if (num5 > 0)
					{
						list3.Add($"{text3} {num5}");
					}
				}
				stringBuilder.Append(string.Format("Seasons won: <b>{0}</b>{1}\n", num4, (list3.Count > 0) ? ("  (" + string.Join("  ·  ", list3) + ")") : ""));
				flag = true;
			}
			if (!flag)
			{
				stringBuilder.Append("<color=#9a9ca0>None yet.</color>\n");
			}
			return stringBuilder.ToString();
		}

		private static string BuildHistoryText()
		{
			List<RunHistoryEntry> history = Account.Data.history;
			StringBuilder stringBuilder = new StringBuilder("<b>RUN HISTORY</b>  <color=#9a9ca0>(the last 20)</color>\n");
			if (history == null || history.Count == 0)
			{
				return stringBuilder.Append("<color=#9a9ca0>No runs yet.</color>").ToString();
			}
			foreach (RunHistoryEntry item in history)
			{
				stringBuilder.Append(string.Format("{0}  ·  {1}{2}  ·  {3} level{4}, chapter {5}  ·  streak {6}  ·  {7} boss{8}  ·  {9:N0} {10}", Date(item.endedUtc), item.won ? "<color=#ffd75a>WON</color>  ·  " : "", item.difficulty, item.levels, (item.levels == 1) ? "" : "s", item.chapter, item.bestStreak, item.bosses, (item.bosses == 1) ? "" : "es", item.scrap, Scrap.Short) + ((item.classes != "") ? ("  ·  " + item.classes) : "") + "\n");
			}
			return stringBuilder.ToString();
		}

		private string RunDetailsText()
		{
			if (!RunUnderWay)
			{
				return "";
			}
			string text = PlayerScaling.Banner();
			string text2 = text + "|" + RunShape.Cur.Seq;
			if (text2 == _runDetailsFor)
			{
				return _runDetails;
			}
			_runDetailsFor = text2;
			List<string> list = new List<string>();
			string[] array = text.Split(new string[1] { "  ·  " }, StringSplitOptions.RemoveEmptyEntries);
			for (int i = 0; i < array.Length; i++)
			{
				string text3 = array[i].Trim();
				if (text3.StartsWith("Next level:", StringComparison.Ordinal) && text3.Contains(" x"))
				{
					text3 = "<color=#9a9ca0>Next level:</color> " + text3.Substring(11).Trim();
				}
				list.Add(text3);
			}
			if (Plugin.Cfg.ShowBoons.Value && RunShape.Cur.Boons.Length != 0)
			{
				List<string> list2 = new List<string>();
				array = RunShape.Cur.Boons;
				foreach (string text4 in array)
				{
					list2.Add(RunShape.Boon(text4)?.name ?? text4);
				}
				list.Add("Boons: " + string.Join(", ", list2));
			}
			if (Ascension.Level > 0)
			{
				list.Add($"<color=#c79aff>Ascension {Ascension.Level}</color> <color=#9a9ca0>({Ascension.RewardLine(Ascension.Level)}) - Account > Ascension lists the modifiers</color>");
			}
			string text5 = MarketDetailsLine();
			if (text5 != "")
			{
				list.Add(text5);
			}
			_runDetails = string.Join("\n", list);
			return _runDetails;
		}

		private void TickRunSummary()
		{
			//IL_0263: Unknown result type (might be due to invalid IL or missing references)
			TickMarketReport();
			bool flag = (Game.InLobby() || Game.InShopLevel()) && !Game.IsLoading();
			bool num = flag && !_wasInTruck;
			_wasInTruck = flag;
			if (!num || !RunReady)
			{
				return;
			}
			RunShape.State cur = RunShape.Cur;
			float rating = RunThreat.Rating;
			string runSnap = $"{RunShape.Chapter}|{rating:0.0}|{cur.Boons.Length}|{cur.Heat}|{RunShape.CrewLevel}";
			List<string> list = new List<string>();
			if (_runSnap != "" && _runSnapLevel != RunInfo.LevelIndex)
			{
				string[] array = _runSnap.Split('|');
				if (array.Length == 5)
				{
					if (array[0] != RunShape.Chapter.ToString())
					{
						list.Add(Season.On ? (Season.ChapterLabel(RunShape.Chapter) + " - " + Season.ChapterName(RunShape.Chapter)) : $"Chapter {RunShape.Chapter}");
					}
					if (array[1] != $"{rating:0.0}")
					{
						list.Add($"Threat rating {array[1]} → {rating:0.0}");
					}
					if (array[2] != cur.Boons.Length.ToString())
					{
						list.Add($"Run boons: {cur.Boons.Length}");
					}
					if (array[3] != cur.Heat.ToString())
					{
						list.Add($"Heat {array[3]} → {cur.Heat}");
					}
					if (array[4] != RunShape.CrewLevel.ToString())
					{
						list.Add($"Crew level {RunShape.CrewLevel}");
					}
				}
			}
			_runSnap = runSnap;
			_runSnapLevel = RunInfo.LevelIndex;
			if (list.Count != 0 && Plugin.Cfg.RunSummaryCard.Value)
			{
				_runCardText = string.Join("\n", list) + "\n<color=#9a9ca0>Full run details: hold " + KeyLabel(Plugin.Cfg.TeamPanelKey.Value) + ", or Account > Runs</color>";
				_runCardStart = Time.unscaledTime;
			}
		}

