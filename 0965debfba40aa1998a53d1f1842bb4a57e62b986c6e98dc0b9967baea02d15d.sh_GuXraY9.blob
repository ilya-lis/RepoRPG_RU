		{
			_encoreCount = 0;
			_teamNear = false;
			_sprintSampled = 0f;
		}

		public void MarkSettingsDirty()
		{
			_settingsDirtyAt = Time.unscaledTime;
		}

		private static bool PcReady(object pc)
		{
			return Game.Get(pc, "playerOriginalSprintSpeed", 0f) > 0f;
		}

		private static bool PcOverridden(object pc)
		{
			if (!(Game.Get(pc, "overrideSpeedTimer", 0f) > 0f))
			{
				return Game.Get(pc, "overrideTimeScaleTimer", 0f) > 0f;
			}
			return true;
		}

		private static bool HealthReady(object ph)
		{
			return Game.Get(ph, "healthSet", fallback: false);
		}

		private void Start()
		{
			NativeMenu.TryRegister();
			Compat.Detect();
			((MonoBehaviour)this).StartCoroutine(ReportNeighbours());
		}

		private IEnumerator ReportNeighbours()
		{
			yield return (object)new WaitForSecondsRealtime(5f);
			Plugin.ReportPatchNeighbours();
		}

		public void OpenModMenu()
		{
			SetMenuOpen(open: true);
		}

		public List<string> StatusLines()
		{
			List<string> list = new List<string>();
			RunSave data = _store.Data;
			if (Current == null || CurrentProgress == null)
			{
				list.Add("No class picked yet");
			}
			else
			{
				list.Add($"{Current.name}  -  Level {CurrentProgress.level}");
				list.Add($"Skill points: {Leveling.AvailablePoints(CurrentProgress)}");
			}
			list.Add($"Attribute points: {Leveling.AvailableAttributePoints(CurrentProgress, data)}");
			if (data.perkPicksPending > 0)
			{
				list.Add($"Perk picks ready: {data.perkPicksPending}");
			}
			list.Add($"Gear: {data.inventory.Count} items, perks: {data.perks.Count}");
			return list;
		}

		private void Awake()
		{
			((MonoBehaviour)this).useGUILayout = false;
			_instances++;
			if ((Object)(object)Instance != (Object)null && (Object)(object)Instance != (Object)(object)this)
			{
				Plugin.Log.LogWarning((object)"A second RepoRPG runtime was created - removed (only one may run)");
				((Behaviour)this).enabled = false;
				Object.Destroy((Object)(object)this);
				return;
			}
			Instance = this;
			RunInfo.Changed += delegate
			{
				_statsDirty = true;
			};
			SceneManager.sceneLoaded += delegate
			{
				Game.SceneLoaded();
				NoteSceneLoaded();
				NoteSceneForUnstick();
				TrackedField.OpenRebaseWindow();
				ForceCloseMenu("the scene changed");
				Scrap.ResetBaseline();
				((MonoBehaviour)this).StartCoroutine(VanillaStyle.ProbeSoon());
				PatchGuard.Run("scene change cleanup", delegate
				{
					ThirdWaveReset();
					ClassHost.Instance?.OnSceneChanged();
				});
			};
		}

		private void OnApplicationQuit()
		{
			RestoreGameValues();
			_store.SaveNow();
			SaveBook.WriteNow();
			SaveWriter.Flush();
			Account.SaveNow();
		}

		private void Update()
		{
			Perf.Tick();
			try
			{
				PerfVis.TickAuto();
			}
			catch (Exception ex)
			{
				Game.WarnOnce("[performance] auto: " + ex.Message);
			}
			Guard.TickNotice();
			GameCheck.TickNotice();
			try
			{
				BigLobby.Tick();
				NetMeter.Tick();
			}
			catch (Exception ex2)
			{
				Game.WarnOnce("[players] " + ex2.GetBaseException().Message);
			}
			if (Guard.On("player runtime"))
			{
				long t = NetMeter.Begin();
				Perf.Mark m = Perf.Start();
				try
				{
					UpdateMain();
				}
				catch (Exception e)
				{
					Guard.Fail("player runtime", e);
				}
				Perf.Stop(Perf.S.ClientUpdate, m);
				NetMeter.EndMod(t);
			}
		}

		private void UpdateMain()
		{
			//IL_04a6: Unknown result type (might be due to invalid IL or missing references)
			TickTransition();
			WatchLevelEnd();
			UiDiag.Tick();
			try
			{
				HandleInput();
			}
			catch (Exception e)
			{
				UiDiag.Error(e);
			}
			NetReliability.Tick(Net.ResendAction);
			TickPendingBuys();
			TickPendingSalvage();
			TickContractRequests();
			SyncUiInputBlock();
			TickAttributes();
			TickCommits();
			try
			{
				TickClassWindow();
			}
			catch (Exception e2)
			{
				UiDiag.Error(e2);
			}
			if (!ValueScale.Ready && Time.frameCount % 90 == 0 && Game.InMenuLevel())
			{
				try
				{
					if ((Object)(object)RunManager.instance != (Object)null)
					{
						((MonoBehaviour)this).StartCoroutine(ValueScale.BuildSlowly());
					}
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("[valuables] catalog: " + ex.Message));
				}
			}
			try
			{
				HostSettings.TickDefault();
			}
			catch (Exception ex2)
			{
				Plugin.Log.LogWarning((object)("[presets] default preset: " + ex2.Message));
			}
			if (Guard.On("late join"))
			{
				try
				{
					LateJoinHost.Tick();
					TickLateJoinJoiner();
					TickJoinWatch();
					TickUnstick();
					if (Time.frameCount % 120 == 0)
					{
						Compat.CheckKeysOnce();
					}
				}
				catch (Exception e3)
				{
					Guard.Fail("late join", e3);
				}
			}
			if ((Game.InLevel() && Game.IsLoading()) || WaitingForHostSettings())
			{
				return;
			}
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val == (Object)null || !EnsureRun(val))
			{
				return;
			}
			_store.Tick();
			if (Game.IsMaster())
			{
				SaveBook.Tick();
				Scrap.HostPoll();
				PatchGuard.Run("highlights (shop)", TeamPlay.HostShopTick);
			}
			TickHighlightsCard();
			RunThreat.Tick();
			Account.Tick();
			TickAccountSummary();
			TickRunShape();
			Perf.Mark m = Perf.Start();
			if (Guard.On("mod shop"))
			{
				try
				{
					TickShop(val);
				}
				catch (Exception e4)
				{
					Guard.Fail("mod shop", e4);
				}
			}
			if (Guard.On("contracts"))
			{
				try
				{
					TickContracts(val);
				}
				catch (Exception e5)
				{
					Guard.Fail("contracts", e5);
				}
			}
			Perf.Stop(Perf.S.ClientShopContracts, m);
			if (Guard.On("part pickups"))
			{
				try
				{
					TickParts(val);
					TickTeamVoteHold(val);
				}
				catch (Exception e6)
				{
					Guard.Fail("part pickups", e6);
				}
			}
			ClassClaims.Tick(Current?.id);
			if (Guard.On("roster"))
			{
				try
				{
					Roster.Tick();
				}
				catch (Exception e7)
				{
					Guard.Fail("roster", e7);
				}
			}
			if (_statsDirty)
			{
				_stats.Rebuild(Current, CurrentProgress, _store.Data, Plugin.Rpg);
				ApplyClassExtras();
				ApplyRunExtras();
				_statsDirty = false;
				_statsVersion++;
				_classStatsSendAt = 0f;
				_nextCombatSend = 0f;
			}
			if (Time.time >= _nextCombatSend)
			{
				_nextCombatSend = Time.time + 30f;
				Net.SendCombat(LocalCombat());
				SendAuraIfNeeded();
			}
			if (Game.InLevel())
			{
				Contracts.TickTimers(_store.Data.contracts, Time.time - _levelStartTime);
			}
			if (Game.InLevel())
			{
				TeamPlay.TickClient(Time.time);
			}
			TickCharges();
			TickHealFeedback(Game.LocalPlayer());
			TickClassStatsSend();
			TickPerkReport();
			if (Game.IsMaster())
			{
				PatchGuard.Run("market", Market.HostTick);
			}
			if (Game.IsMaster())
			{
				PatchGuard.Run("ascension", Ascension.HostTick);
			}
			Perf.Mark m2 = Perf.Start();
			if (Guard.On("research"))
			{
				try
				{
					TickResearch(Game.LocalPlayer());
				}
				catch (Exception e8)
				{
					Guard.Fail("research", e8);
				}
			}
			Perf.Stop(Perf.S.ClientResearch, m2);
			if (_settingsDirtyAt > 0f && Time.unscaledTime - _settingsDirtyAt > 0.5f)
			{
				_settingsDirtyAt = 0f;
				if (Game.IsMaster() && !SettingsSync.Overridden)
				{
					Net.BroadcastSettings();
				}
			}
			if (Time.time >= _buffEnd && _buffEnd > 0f)
			{
				_buffEnd = 0f;
				_stats.SetTemp(null, 0f);
				_nextCombatSend = 0f;
				Toast(Current?.active.name + " ended", new Color(0.7f, 0.7f, 0.7f));
			}
			if (Game.IsAlive(val))
			{
				TickFallGuard(val);
			}
			if (Current == null)
			{
				if (_pull != null)
				{
					EndPull("class changed");
				}
				return;
			}
			TickSignature(val);
			Perf.Mark m3 = Perf.Start();
			if (Guard.On("class abilities"))
			{
				try
				{
					TickNewClasses(val);
				}
				catch (Exception e9)
				{
					Guard.Fail("class abilities", e9);
				}
			}
			Perf.Stop(Perf.S.ClientClassAbilities, m3);
			Perf.Mark m4 = Perf.Start();
			if (Guard.On("perks"))
			{
				try
				{
					TickPerks(val);
					TickAttrs(val);
					TickGear(val);
				}
				catch (Exception e10)
				{
					Guard.Fail("perks", e10);
				}
			}
			Perf.Stop(Perf.S.ClientPerksGear, m4);
			Perf.Mark m5 = Perf.Start();
			ApplyStats(val);
			Perf.Stop(Perf.S.ClientStats, m5);
			if (Game.IsAlive(val))
			{
				Perf.Mark m6 = Perf.Start();
				TickRegen(val);
				TickAura(val);
				TickHealOverTime(val);
				Perf.Stop(Perf.S.ClientRegenAura, m6);
				Perf.Mark m7 = Perf.Start();
				TickSense(val);
				TickScan(val);
				Perf.Stop(Perf.S.ClientScanSense, m7);
			}
		}

		private bool EnsureRun(PlayerAvatar local)
		{
			//IL_02e7: Unknown result type (might be due to invalid IL or missing references)
			string text = Game.SteamId(local);
			if (string.IsNullOrEmpty(text))
			{
				if (Game.IsMultiplayer())
				{
					return false;
				}
				text = "local";
			}
			RunInfo.CheckRoom();
			if (Game.IsMaster())
			{
				if (RunInfo.Key == "" || !RunInfo.FromHost || !Game.InLevel())
				{
					RunInfo.RefreshAsHost();
				}
			}
			else
			{
				RunInfo.EnsureClient();
				if (!RunInfo.FromHost)
				{
					if (_waitForHostSince < 0f)
					{
						_waitForHostSince = Time.unscaledTime;
					}
					if (Time.unscaledTime - _waitForHostSince < 6f)
					{
						return false;
					}
				}
				else
				{
					_waitForHostSince = -1f;
				}
			}
			if (_store.OwnerId != text || _store.RunKey != RunInfo.Key || _reloadFromHost)
			{
				string text2 = ((_store.OwnerId != text) ? "player" : ((_store.RunKey != RunInfo.Key) ? ("run key '" + _store.RunKey + "' -> '" + RunInfo.Key + "'") : "progress from the host"));
				_reloadFromHost = false;
				if (!LoadRun(text))
				{
					return false;
				}
				NoteRunReload(text2);
				RefundOldTrees();
				if (Current != null || _store.Data.selectedClass != "")
				{
					ClassTrace("run data (re)loaded (" + text2 + "): class in this save '" + _store.Data.selectedClass + "' (was playing '" + (Current?.id ?? "none") + "')");
				}
				ClassDef current = Current;
				Current = null;
				SelectClass(_store.Data.selectedClass, announce: false);
				if (Current == null && current != null)
				{
					RaiseClassChanged(current, null, "the run was reloaded");
				}
				CheckPerkMilestones();
				_statsDirty = true;
				if (_store.LoadedExisting && !RunStore.IsTempKey(RunInfo.Key) && Current != null && CurrentProgress != null)
				{
					Toast($"Welcome back - {Current.name} Lv {CurrentProgress.level}, {_store.Data.inventory.Count} gear, " + $"{_store.Data.perks.Count} perks restored", new Color(1f, 0.7f, 0.12f), 5f);
				}
			}
			if (RunInfo.RunId != "" && _store.RunKey == RunInfo.Key && _store.Data.runId != RunInfo.RunId)
			{
				if (_store.Data.runId == "")
				{
					_store.Data.runId = RunInfo.RunId;
					_store.MarkDirty();
				}
				else
				{
					NewRunReset(text, "run '" + _store.Data.runId + "' ended, now run '" + RunInfo.RunId + "'");
				}
			}
			RunSave run = _store.Data;
			if (Game.InLevel())
			{
				if (RunInfo.LevelIndex > run.highestLevelSeen)
				{
					run.highestLevelSeen = RunInfo.LevelIndex;
					_store.MarkDirty();
				}
				if (run.contractLevel != RunInfo.LevelIndex)
				{
					run.contractLevel = RunInfo.LevelIndex;
					_levelStartTime = Time.time;
					PatchGuard.Run("contracts level start", delegate
					{
						ContractsLevelStart(run);
					});
					GiveStarterUnlocks(run);
					PatchGuard.Run("class starter", EnsureStarterGear);
					PatchGuard.Run("research level", delegate
					{
						ResearchLevelStartClientE();
						ResearchLevelStartClientX();
						ResearchLevelStartClientC();
					});
					_store.MarkDirty();
				}
			}
			return true;
		}

		private bool LoadRun(string id)
		{
			string key = RunInfo.Key;
			if (_store.Loaded && _store.RunKey != key)
			{
				_store.SaveNow();
			}
			if (RunStore.IsTempKey(key))
			{
				_store.Use(id, key, null);
				return true;
			}
			if (Game.IsMaster())
			{
				RunSave runSave = SaveBook.Get(key, id);
				_store.Use(id, key, runSave);
				if (runSave == null)
				{
					_store.SaveNow();
				}
				RunStore.PruneCaches(id);
				return true;
			}
			if (_askKey != key)
			{
				_askKey = key;
				_askSince = Time.unscaledTime;
				_askNext = 0f;
				_gotKey = "";
				_gotData = null;
				_fellBackKey = "";
			}
			if (_gotKey == key)
			{
				RunSave runSave2 = _gotData ?? RunStore.ReadCache(id, key, RunInfo.RunId);
				if (_gotData == null && runSave2 != null)
				{
					Plugin.Log.LogInfo((object)"The host had no progress for you in this save; using your own copy.");
				}
				_store.Use(id, key, runSave2);
				_store.SaveNow();
				RunStore.PruneCaches(id);
				return true;
			}
			if (Time.unscaledTime - _askSince > 8f)
			{
				Plugin.Log.LogWarning((object)"The host didn't send your progress (older mod version?); using your own copy of this save.");
				RunSave runSave3 = RunStore.ReadCache(id, key, RunInfo.RunId);
				_store.Use(id, key, runSave3);
				_fellBackKey = key;
				if (runSave3 != null)
				{
					_store.SaveNow();
				}
				return true;
			}
			if (Time.unscaledTime >= _askNext)
			{
				_askNext = Time.unscaledTime + 2f;
				Net.AskProgress(key, id);
			}
			return false;
		}

		public void ResendState()
		{
			float num = ((PlayerScaling.RoomPlayers() > 6) ? ((float)(Game.ActorNumber(Game.LocalPlayer()) % 20) * 0.1f) : 0f);
			_nextCombatSend = ((num > 0f) ? (Time.time + num) : 0f);
			_nextPerkReport = ((num > 0f) ? (Time.unscaledTime + num) : 0f);
		}

		private void RefundOldTrees()
		{
			//IL_00ba: Unknown result type (might be due to invalid IL or missing references)
			//IL_018d: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			if (ClassMigration.MigrateRun(data))
			{
				_store.MarkDirty();
			}
			if (data.attributeVersion != Plugin.Rpg.attributeVersion)
			{
				int num = data.SpentAttributePoints();
				data.attributes.Clear();
				data.attributeVersion = Plugin.Rpg.attributeVersion;
				_store.MarkDirty();
				if (num > 0)
				{
					Plugin.Log.LogInfo((object)$"Attributes changed (v{data.attributeVersion}): refunded {num} attribute point(s).");
					Toast(string.Format("Attributes reworked - your {0} attribute point{1} were refunded", num, (num == 1) ? "" : "s"), new Color(1f, 0.7f, 0.12f), 6f);
				}
			}
			int treeVersion = Plugin.Db.TreeVersion;
			if (data.treeVersion == treeVersion)
			{
				return;
			}
			int num2 = 0;
			foreach (ClassProgress @class in data.classes)
			{
				num2 += @class.SpentPoints();
				@class.ranks.Clear();
			}
			data.treeVersion = treeVersion;
			_store.MarkDirty();
			if (num2 > 0)
			{
				Plugin.Log.LogInfo((object)$"Skill trees changed (v{treeVersion}): refunded {num2} skill point(s).");
				Toast(string.Format("Skill trees redesigned - your {0} skill point{1} were refunded", num2, (num2 == 1) ? "" : "s"), new Color(1f, 0.7f, 0.12f), 6f);
			}
		}

		private void NewRunReset(string id, string why)
		{
			//IL_0150: Unknown result type (might be due to invalid IL or missing references)
			LoopTrace.Note("NEW RUN: progress reset (" + why + ")");
			string runKey = _store.RunKey;
			int count = _store.Data.classes.Count;
			int count2 = _store.Data.inventory.Count;
			RunStore.DeleteCache(id, runKey);
			_store.Use(id, runKey, null);
			_store.Data.runId = RunInfo.RunId;
			_store.MarkDirty();
			ClassDef current = Current;
			Current = null;
			if (current != null)
			{
				RaiseClassChanged(current, null, "a new run started");
			}
			RunShape.Reset();
			Market.Reset();
			ResearchSamples.Reset();
			Ascension.Reset();
			if (Game.IsMaster())
			{
				PatchGuard.Run("ascension (new run)", Ascension.HostNewRun);
			}
			Scrap.ForgetLocal();
			ClearPendingBuys();
			DropAllPending();
			_cart.Clear();
			_shopVote = "";
			_statsDirty = true;
			_store.SaveNow();
			Plugin.Log.LogInfo((object)$"[run] new run ({why}): your run progress was reset ({count} class(es), {count2} gear item(s), loadouts, modules, parts, shop and reputation cleared); account progress kept.");
			Notify(PopupKind.Other, "New run started: everyone's run progress was reset (account unlocks and records are kept)", (Color?)new Color(1f, 0.85f, 0.35f), "newrun");
		}

		public void OnProgressFromHost(string key, RunSave? data)
		{
			if (!(key != RunInfo.Key))
			{
				_gotKey = key;
				_gotData = data;
				if (_fellBackKey == key && data != null && _store.RunKey == key)
				{
					_fellBackKey = "";
					_reloadFromHost = true;
				}
			}
		}

		public bool CanSwitchClass(out string reason)
		{
			reason = "";
			if (Game.ClassPickOpen())
			{
				return true;
			}
			reason = "Class selection opens in the lobby or shop.";
			return false;
		}

		public void SelectClass(string? id, bool announce = true)
		{
			//IL_00d3: Unknown result type (might be due to invalid IL or missing references)
			//IL_0090: Unknown result type (might be due to invalid IL or missing references)
			//IL_014e: Unknown result type (might be due to invalid IL or missing references)
			ClassDef classDef = Plugin.Db.Get(id);
			if (classDef != Current || classDef == null)
			{
				if (!string.IsNullOrEmpty(id) && classDef == null)
				{
					ClassTrace("6 class '" + id + "' isn't in the class list (classes.json / override) - can't be set");
				}
				ClassDef current = Current;
				RestoreGameValues();
				_talentPending.Clear();
				Current = classDef;
				CurrentProgress = ((classDef == null) ? null : _store.ProgressFor(classDef.id));
				if (CurrentProgress != null && Leveling.FixOverspend(CurrentProgress))
				{
					Toast("Skill tree refunded (level settings changed)", Color.white);
				}
				if (Leveling.AvailableAttributePoints(CurrentProgress, _store.Data) < 0)
				{
					_store.Data.attributes.Clear();
					Toast("Attribute points refunded", Color.white);
				}
				_store.Data.selectedClass = classDef?.id ?? "";
				_store.MarkDirty();
				_statsDirty = true;
				ResetAbilityState(keepCooldown: true);
				ClassClaims.AnnounceLocal(classDef?.id);
				if (announce && classDef != null)
				{
					Toast("Class: " + classDef.name, ParseColor(classDef.color));
				}
				if (current != classDef)
				{
					RaiseClassChanged(current, classDef, announce ? "picked" : "loaded / synced");
				}
				if (announce && classDef != null)
				{
					PatchGuard.Run("late join catch-up", LateJoinCatchUp);
				}
				OnClaimsUpdated();
			}
		}

		public void OnClaimsUpdated()
		{
			//IL_00c5: Unknown result type (might be due to invalid IL or missing references)
			if (Current != null && ClassClaims.LostTieFor(Current.id, out string ownerName))
			{
				ClassTrace("6 " + Current.id + " is held by " + ownerName + " in this lobby - given up");
				string name = Current.name;
				SelectClass(null, announce: false);
				Toast(ownerName + " is playing " + name + " - " + (Pad.Connected ? "" : "press ") + MenuPrompt + " to pick another class", new Color(1f, 0.6f, 0.4f), 6f);
			}
		}

		public bool TryRankUp(BranchDef b, NodeDef n)
		{
			if (Current == null || CurrentProgress == null)
			{
				return false;
			}
			if (ClassDatabase.CanRankUp(Current, b, n, CurrentProgress) != ClassDatabase.RankBlock.None)
			{
				return false;
			}
			CurrentProgress.SetRank(n.id, CurrentProgress.RankOf(n.id) + 1);
			_store.MarkDirty();
			_statsDirty = true;
			return true;
		}

		public void Respec()
		{
			//IL_005a: Unknown result type (might be due to invalid IL or missing references)
			if (CurrentProgress != null && Plugin.Cfg.AllowRespec.Value)
			{
				_talentPending.Clear();
				_commits.Remove(1);
				CurrentProgress.ranks.Clear();
				_store.MarkDirty();
				_statsDirty = true;
				Toast("Skill points refunded", Color.white);
			}
		}

		private void ApplyStats(PlayerAvatar local)
		{
			PlayerHealth playerHealth = local.playerHealth;
			PlayerController instance = PlayerController.instance;
			PhysGrabber val = null;
			try
			{
				val = PhysGrabber.instance;
			}
			catch
			{
			}
			float num = 0f;
			if ((Object)(object)playerHealth != (Object)null)
			{
				_maxHealth.Apply(playerHealth, 1.0 + (double)_stats[Stat.MaxHealth] / 100.0);
				if (playerHealth != _hpFilledFor && Game.Get(playerHealth, "healthSet", fallback: false))
				{
					_hpFilledFor = playerHealth;
					int num2 = Game.Health(playerHealth);
					int num3 = Game.MaxHealth(playerHealth);
					if (num2 >= (int)Math.Round(_maxHealth.Base) && num3 > num2)
					{
						Game.RawHeal = true;
						try
						{
							Game.HealSelf(playerHealth, num3 - num2);
						}
						finally
						{
							Game.RawHeal = false;
						}
					}
				}
				int num4 = Game.MaxHealth(playerHealth);
				if (num4 > 0 && (float)Game.Health(playerHealth) < (float)num4 * 0.35f)
				{
					num = _stats[Stat.LowHealthSpeed];
				}
			}
			if ((Object)(object)instance != (Object)null)
			{
				double val2 = Plugin.Cfg.MaxSpeedBonus.Value;
				_move.Apply(instance, Math.Max(0.2, 1.0 + Math.Min(_stats[Stat.MoveSpeed] + num, val2) / 100.0));
				_sprint.Apply(instance, Math.Max(0.2, 1.0 + Math.Min(_stats[Stat.SprintSpeed] + num, val2) / 100.0));
				_crouch.Apply(instance, Math.Max(0.2, 1.0 + (double)_stats[Stat.CrouchSpeed] / 100.0));
				_jumpForce.Apply(instance, Math.Max(0.2, 1.0 + (double)_stats[Stat.JumpForce] / 100.0));
				_jumpExtra.Apply(instance, 1.0, Math.Round(_stats[Stat.ExtraJumps]));
				float num5 = Mathf.Min(_stats[Stat.MaxStamina], Plugin.Cfg.MaxStaminaBonus.Value);
				_energyMax.Apply(instance, Math.Max(0.2, 1.0 + (double)num5 / 100.0));
				float num6 = _stats[Stat.StaminaDrain];
				if (Game.IsHoldingSomething())
				{
					num6 += _stats[Stat.HoldingStaminaDrain];
				}
				int num7;
				if (!_featherFree)
				{
					num7 = ((_stats.Temp(Stat.StaminaDrain) <= -99.9f) ? 1 : 0);
					if (num7 == 0)
					{
						num6 = Mathf.Max(num6, 0f - Plugin.Cfg.MaxStaminaDrainReduction.Value);
					}
				}
				else
				{
					num7 = 1;
				}
				SprintDrain.RpgMult = Mathf.Max(0f, 1f + num6 / 100f);
