		private bool CtItem(Rect r, string id, int ver, int kind, object? obj, out bool activated)
		{
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			//IL_001d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0023: Invalid comparison between Unknown and I4
			//IL_00ae: Unknown result type (might be due to invalid IL or missing references)
			//IL_0093: Unknown result type (might be due to invalid IL or missing references)
			activated = false;
			bool num = Hover(r);
			bool flag = _ctPin == id;
			if ((int)Event.current.type == 7 && !_probeOn)
			{
				if (flag)
				{
					_ctPinSeen = true;
					if (_tabDetailTab != TabNames[_tab] || _tabDetailId != id || _tabDetailVer != ver)
					{
						CtSelect(id, ver, kind, obj);
					}
				}
				else if ((_padMode || _ctPin == "") && DetailHit(r, id, ver))
				{
					CtFill(_tabDetail, kind, obj);
				}
			}
			if (Clicked(r))
			{
				if (_padMode)
				{
					activated = true;
				}
				else
				{
					_ctPin = (flag ? "" : id);
					if (!flag)
					{
						CtSelect(id, ver, kind, obj);
					}
				}
			}
			return num || flag;
		}

		private void CtSelect(string id, int ver, int kind, object? obj)
		{
			_tabDetailTab = TabNames[_tab];
			_tabDetailId = id;
			_tabDetailVer = ver;
			_tabDetail.Begin(_tabDetailTab + "|" + id + "|" + ver);
			CtFill(_tabDetail, kind, obj);
		}

		private void CtFill(DetailInfo d, int kind, object? obj)
		{
			switch (kind)
			{
			case 0:
			case 1:
			case 2:
				if (obj is ContractState c)
				{
					FillContractDetail(d, c, kind);
				}
				break;
			case 3:
				FillTeamDetail(d);
				break;
			case 4:
				if (obj is ChainDef ch)
				{
					FillChainDetail(d, ch);
				}
				break;
			case 5:
				if (obj is ContractGiverDef g)
				{
					FillGiverDetail(d, g);
				}
				break;
			case 6:
				FillCrewDetail(d);
				break;
			case 7:
				FillHistoryDetail(d);
				break;
			}
		}

