			}
		}

		public static void HostVictoryRecap()
		{
			SendRecap(victory: true);
		}

		public static void HostRunEnded()
		{
			SendRecap(victory: false);
		}

		private static void SendRecap(bool victory)
		{
			RunSave runSave = RpgRuntime.Instance?.HostRun;
			TeamRunSave teamRunSave = runSave?.team;
			if (teamRunSave == null || !Game.IsMaster() || teamRunSave.recapped || (teamRunSave.levelsCleared <= 0 && teamRunSave.levelsFailed <= 0 && teamRunSave.startedUtc == ""))
			{
				return;
			}
			if (!victory)
			{
				teamRunSave.recapped = true;
			}
			ResearchCrew.HostRunEnd(teamRunSave);
			Recap recap = new Recap
			{
				difficulty = DifficultyPresets.Label,
				ended = DateTime.UtcNow.ToString("o"),
				startedUtc = teamRunSave.startedUtc,
				levels = teamRunSave.levelsCleared,
				failed = teamRunSave.levelsFailed,
				chapter = ChapterAt(teamRunSave.levelsCleared),
				milestones = teamRunSave.milestones,
				bestStreak = teamRunSave.bestStreak,
				bosses = teamRunSave.bosses,
				milestoneBosses = teamRunSave.milestoneBosses,
				elites = teamRunSave.elites,
				haul = teamRunSave.haul,
				players = new List<RunPlayerTotals>(teamRunSave.players),
				victory = (victory || teamRunSave.seasonWon),
				chapters = (Season.On ? Season.Chapters : 0),
				heat = teamRunSave.heat
			};
			List<HighlightSave> list = new List<HighlightSave>(runSave.highlights);
			list.Sort((HighlightSave a, HighlightSave b) => b.score.CompareTo(a.score));
			foreach (HighlightSave item in list)
			{
				if (recap.moments.Count >= 3)
				{
					break;
				}
				recap.moments.Add(string.Format("Level {0}: {1} - {2}{3}", item.level + 1, item.title, item.who, (item.detail != "") ? (" (" + item.detail + ")") : ""));
			}
			if (teamRunSave.milestoneBosses > 0)
			{
				recap.moments.Add(string.Format("{0} milestone boss{1} down", teamRunSave.milestoneBosses, (teamRunSave.milestoneBosses == 1) ? "" : "es"));
			}
			if (teamRunSave.bestStreak >= 3)
			{
				recap.moments.Add($"A {teamRunSave.bestStreak}-level streak");
			}
			recap.mvps = Mvps(recap.players);
			Plugin.Log.LogInfo((object)string.Format("[run] {0}: {1} level(s) cleared, chapter {2}, best streak {3}, ${4:N0} hauled. Recap sent.", victory ? "VICTORY recap" : "run ended", recap.levels, recap.chapter, recap.bestStreak, recap.haul));
			string json = Json.Serialize(recap, pretty: false);
			Net.SendRecap(json);
			RpgRuntime.Instance?.OnRecap(json);
		}

		private static List<string> Mvps(List<RunPlayerTotals> ps)
		{
			List<string> l = new List<string>();
			if (ps.Count == 0)
			{
				return l;
			}
			Best("Most valuable carried", (RunPlayerTotals p) => p.carried, "${0:N0}");
			Best("Most revives", (RunPlayerTotals p) => p.revives, "{0:0}");
			Best("Most kills", (RunPlayerTotals p) => p.kills, "{0:0}");
			Best("Most contracts", (RunPlayerTotals p) => p.contracts, "{0:0}");
			Best("Most Scrap earned", (RunPlayerTotals p) => p.scrap, "{0:N0}");
			if (ps.Count > 1)
			{
				Best("Fewest deaths", (RunPlayerTotals p) => p.deaths, "{0:0}", low: true);
			}
			return l;
			void Best(string title, Func<RunPlayerTotals, float> f, string fmt, bool low = false)
			{
				RunPlayerTotals runPlayerTotals = null;
				foreach (RunPlayerTotals p in ps)
				{
					if (runPlayerTotals == null || (low ? (f(p) < f(runPlayerTotals)) : (f(p) > f(runPlayerTotals))))
					{
						runPlayerTotals = p;
					}
				}
				if (runPlayerTotals != null && (low || f(runPlayerTotals) > 0f))
				{
					l.Add(title + ": " + runPlayerTotals.name + " (" + string.Format(fmt, f(runPlayerTotals)) + ")");
				}
			}
		}

		public static void Apply(State s)
		{
			State cur = Cur;
			if (s.VoteFor != cur.VoteFor)
			{
				MyVote = -1;
			}
			Cur = s;
			RpgRuntime.Instance?.OnRunShape(cur, s);
		}

		public static List<int> MyOwed()
		{
			string text = Game.SteamId(Game.LocalPlayer());
			if (_owedOf == Cur && text == _owedMe)
			{
				return _owed;
			}
			_owedOf = Cur;
			_owedMe = text;
			List<int> owed = _owed;
			owed.Clear();
			if (text == "")
			{
				return owed;
			}
			string[] owed2 = Cur.Owed;
			foreach (string text2 in owed2)
			{
				int num = text2.LastIndexOf('|');
				if (num > 0 && text2.Substring(0, num) == text && int.TryParse(text2.Substring(num + 1), out var result))
				{
					owed.Add(result);
				}
			}
			owed.Sort();
			return owed;
		}

		public static void Reset()
		{
			Cur = new State();
			MyVote = -1;
			MyRouteVote = -1;
			MyHeatVote = -1;
			Routes.Reset();
			Heat.Reset();
			Votes.Clear();
			_voteFor = 0;
			_sweepLevel = -1;
			_sweepCount = 0;
		}
	}
	internal static class RunThreat
	{
		private static int _seenLevel = -1;

		private static float _seenRating;

		private static string _banner = "";

		private static int _bannerLv = -1;

		private static float _bannerKey = -1f;

		private static ModConfig C => Plugin.Cfg;

		public static int LevelsCleared => Mathf.Max(0, RunInfo.LevelIndex);

		public static float Rating => RatingAt(LevelsCleared);

		public static float Fixed
		{
			get
			{
				if (!PlayerScaling.Known)
				{
					return Rating;
				}
				return PlayerScaling.Current.Threat;
			}
		}

		public static float Ahead => Rating;

		public static float RatingAt(int cleared)
		{
			if (!C.ThreatEnabled.Value)
			{
				return 0f;
			}
			float num = Mathf.Clamp(C.ThreatCap.Value, 0f, 20f);
			if (num <= 0f)
			{
				return 0f;
			}
			float num2 = Mathf.Max(0, cleared - Mathf.Clamp(C.ThreatGraceLevels.Value, 0, 20));
			float num3 = Mathf.Clamp(C.ThreatSpeed.Value, 0.1f, 5f);
			return Mathf.Min(30f, num * (1f - Mathf.Exp((0f - num3) * num2 / num)) + RunShape.ChapterThreatAt(cleared) + Season.EndlessThreatCap(cleared));
		}

		private static float M(float perPoint, float pct, float rating)
		{
			return 1f + perPoint / 100f * rating * Mathf.Clamp(pct, 0f, 200f) / 100f;
		}

		public static float Monsters(float r)
		{
			return M(4f, C.ThreatMonsters.Value, r);
		}

		public static float Health(float r)
		{
			return M(5f, C.ThreatHealth.Value, r);
		}

		public static float Damage(float r)
		{
			return M(3f, C.ThreatDamage.Value, r);
		}

		public static float Elites(float r)
		{
			return M(6f, C.ThreatElites.Value, r);
		}

		public static float Loot(float r)
		{
			return M(3f, C.ThreatLoot.Value, r);
		}

		public static int ExtraBossModifiers(float r)
		{
			if (C.ThreatBosses.Value)
			{
				if (!(r >= 8f))
				{
					return (r >= 5f) ? 1 : 0;
				}
				return 2;
			}
			return 0;
		}

		public static int BossEveryCut(float r)
		{
			if (C.ThreatBosses.Value)
			{
				return (r >= 7f) ? 1 : 0;
			}
			return 0;
		}

		public static float RewardMult(float r)
		{
			return M(4f, C.ThreatRewards.Value, r);
		}

		public static float HaulRewardMult(float r)
		{
			return Mathf.Max(1f, RewardMult(r) / Mathf.Max(1f, Loot(r)));
		}

		public static float LuckBonus(float r)
		{
			return r * Mathf.Clamp(C.ThreatRewards.Value, 0f, 200f) / 100f;
		}

		public static string Describe(float r)
		{
			return $"Threat {r:0.0}: monsters x{Monsters(r):0.##}, health x{Health(r):0.##}" + ((C.ThreatDamage.Value > 0f) ? $", damage x{Damage(r):0.##}" : "") + $", elites x{Elites(r):0.##}, loot and goal x{Loot(r):0.##}, rewards x{RewardMult(r):0.##}";
		}

		public static void Tick()
		{
			//IL_0086: Unknown result type (might be due to invalid IL or missing references)
			int levelsCleared = LevelsCleared;
			if (levelsCleared != _seenLevel)
			{
				float rating = Rating;
				bool num = _seenLevel >= 0 && levelsCleared == _seenLevel + 1 && rating > _seenRating + 0.05f;
				_seenLevel = levelsCleared;
				_seenRating = rating;
				if (num)
				{
					RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, string.Format("Threat rating up: {0:0.0} after {1} level{2} cleared - tougher monsters, better rewards", rating, levelsCleared, (levelsCleared == 1) ? "" : "s"), (Color?)new Color(1f, 0.55f, 0.3f), "threat");
				}
			}
		}

		public static string BannerText()
		{
			if (!C.ThreatEnabled.Value)
			{
				return "";
			}
			int levelsCleared = LevelsCleared;
			if (levelsCleared <= 0)
			{
				return "";
			}
			float rating = Rating;
			float num = Mathf.Clamp(C.ThreatCap.Value, 0f, 20f);
			float num2 = rating * 1000f + num;
			if (levelsCleared != _bannerLv || Mathf.Abs(num2 - _bannerKey) > 0.001f)
			{
				_bannerLv = levelsCleared;
				_bannerKey = num2;
				_banner = $"Levels cleared: {levelsCleared}  ·  Threat rating: {rating:0.0} / {num:0}";
			}
			return _banner;
		}
	}
	internal static class SalvageCalc
	{
		public static int Gross(GearItem g)
		{
			RarityDef rarityDef = Gear.Rarity(g.rarity);
			if (Starters.Is(g))
			{
				return 0;
			}
			if (Cursed.Is(g))
			{
				return Math.Max(0, Mathf.RoundToInt((float)Gear.Rarity(Gear.MaxRarity).salvageScrap * 1.5f) * ((!GearX.Has(g, "gear.salvager")) ? 1 : 2));
			}
			int num = Math.Max(0, g.effects.Length - rarityDef.affixes - GearX.BehaviorExtraLines(g));
			int num2 = rarityDef.salvageScrap + num * Math.Max(0, Plugin.Cfg.SalvageExtraLineScrap.Value) + ((!string.IsNullOrEmpty(g.unique)) ? Math.Max(0, Plugin.Cfg.SalvageUniqueScrap.Value) : 0);
			if (GearX.Has(g, "gear.salvager"))
			{
				num2 *= 2;
			}
			return Math.Max(0, num2);
		}

		public static int Value(GearItem g, float scrapBonusPct)
		{
			float num = 1f + Mathf.Clamp(scrapBonusPct, -50f, 50f) / 100f;
			int num2 = Mathf.RoundToInt((float)Gross(g) * num);
			int num3 = ((g.freeValue < 0) ? num2 : Mathf.Min(num2, Mathf.RoundToInt((float)g.freeValue * num)));
			int num4 = num2 - num3;
			int num5 = Mathf.FloorToInt((float)Mathf.Max(0, g.scrapIn) * Mathf.Clamp(Plugin.Cfg.SalvageMaxOfSpent.Value, 0f, 90f) / 100f);
			int num6 = GearUp.SalvageBonus(g);
			float num7 = Mathf.Clamp(Plugin.Cfg.SalvageMultiplier.Value, 0f, 300f) / 100f;
			return Mathf.Max(0, Mathf.RoundToInt((float)(num3 + Mathf.Min(num4, num5)) * num7 + (float)num6 * Mathf.Min(1f, num7)));
		}

		public static bool NeedsConfirm(GearItem g)
		{
			string text = Plugin.Cfg.SalvageConfirm.Value.Trim().ToLowerInvariant();
			if (!string.IsNullOrEmpty(g.set) && GearSets.Get(g.set) != null)
			{
				return true;
			}
			if (!string.IsNullOrEmpty(g.unique) || GearX.Tier(g) >= 1 || Cursed.Is(g))
			{
				return true;
			}
			if (text == "none")
			{
				return false;
			}
			if (text == "all")
			{
				return true;
			}
			return g.rarity >= 2;
		}
	}
	internal static class Scrap
	{
		public static readonly Color Color = new Color(0.55f, 0.95f, 0.75f);

		private static int _lastMoney = -1;

		private static string _lastKey = "";

		private static float _nextPoll;

		public static bool Suppress;

		private static float _extractedAt = -99f;

		private static float _levelDoneAt = -99f;

		public static string Name => Plugin.Cfg.CurrencyName.Value;

		public static string Short => Plugin.Cfg.CurrencyShort.Value;

		public static string Symbol => Plugin.Cfg.CurrencySymbol.Value;

		public static double Local { get; private set; }

		public static bool Known { get; private set; }

		public static double Mine
		{
			get
			{
				if (!Game.IsMaster() || RunStore.IsTempKey(RunInfo.Key))
				{
					return Local;
				}
				return HostBalance(LocalId());
			}
		}

		public static string Format(double v)
		{
			return Math.Floor(v + 1E-06).ToString("N0");
		}

		public static string Price(int amount)
		{
			return $"{amount:N0} {Short}";
		}

		public static void NoteExtraction()
		{
			_extractedAt = Time.unscaledTime;
		}

		public static void NoteLevelComplete()
		{
			_levelDoneAt = Time.unscaledTime;
		}

		public static void ResetBaseline()
		{
			_lastMoney = -1;
		}

		public static void HostMoneyChanged(int before, int after)
		{
			if (!Game.IsMaster())
			{
				return;
			}
			if (Suppress || before < 0 || RunInfo.Key != _lastKey)
			{
				_lastKey = RunInfo.Key;
				_lastMoney = after;
				return;
			}
			if (after > before)
			{
				Earn(after - before);
			}
			_lastMoney = after;
		}

		public static void HostPoll()
		{
			if (!Game.IsMaster() || Time.unscaledTime < _nextPoll)
			{
				return;
			}
			_nextPoll = Time.unscaledTime + 1f;
			if (RunInfo.Key != _lastKey)
			{
				_lastKey = RunInfo.Key;
				_lastMoney = -1;
			}
			int currency = Shop.GetCurrency();
			if (currency >= 0)
			{
				if (_lastMoney >= 0 && currency > _lastMoney && !Suppress && !RunStore.IsTempKey(RunInfo.Key))
				{
					Earn(currency - _lastMoney);
				}
				_lastMoney = currency;
			}
		}

		private static void Earn(int deltaK)
		{
			if (deltaK > 0 && !RunStore.IsTempKey(RunInfo.Key))
			{
				double num = (double)deltaK * 1000.0 * (double)Mathf.Clamp(Plugin.Cfg.ScrapPercent.Value, 0f, 100f) / 100.0 / 100.0 * (double)Difficulty.ScrapMult() * (double)PlayerScaling.Economy * (double)RunThreat.HaulRewardMult(RunThreat.Fixed) * (double)RunShape.HaulScrapMult * (double)RunDepth.ScrapMult * (double)Heat.ScrapMult;
				if (!(num <= 0.0))
				{
					float unscaledTime = Time.unscaledTime;
					string text = ((unscaledTime - _extractedAt < 8f) ? "Valuables extracted" : ((unscaledTime - _levelDoneAt < 15f) ? "Level haul" : "Team earnings"));
					Distribute(num, text);
					Plugin.Log.LogInfo((object)$"Team earned ${deltaK}K: {num:0.##} {Short} split between the players ({text}).");
				}
			}
		}

		private static void Distribute(double total, string reason)
		{
			List<(string, int, string)> list = new List<(string, int, string)>();
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					string text = Game.SteamId(item);
					if (string.IsNullOrEmpty(text))
					{
						text = (Game.IsMultiplayer() ? "" : "local");
					}
					if (!(text == ""))
					{
						list.Add((text, Game.ActorNumber(item), Game.Get(item, "playerName", "")));
					}
				}
			}
			if (list.Count == 0)
			{
				return;
			}
			Dictionary<string, double> dictionary = HostDirector.Instance?.Contributions();
			Dictionary<string, double> dictionary2 = null;
			if (dictionary != null)
			{
				dictionary2 = new Dictionary<string, double>(dictionary);
				foreach (var item2 in list)
				{
					if (dictionary2.TryGetValue(item2.Item1, out var value))
					{
						dictionary2[item2.Item1] = value * (1.0 + (double)Mathf.Clamp(GearOf(item2.Item2, "gear.courier"), 0f, 25f) / 100.0);
					}
				}
			}
			double num = 0.0;
			if (Plugin.Cfg.ScrapSplit.Value == ScrapSplitMode.ByContribution && dictionary2 != null)
			{
				foreach (var item3 in list)
				{
					num += (dictionary2.TryGetValue(item3.Item1, out var value2) ? value2 : 0.0);
				}
			}
			foreach (var item4 in list)
			{
				double num2 = total / (double)list.Count;
				double num3 = 1.0 + (double)Mathf.Clamp(BonusOf(item4.Item2), 0f, Plugin.Cfg.MaxScrapBonus.Value) / 100.0;
				if (num > 0.0 && dictionary2 != null)
				{
					num2 = total * 0.5 / (double)list.Count + total * 0.5 * (dictionary2.TryGetValue(item4.Item1, out var value3) ? value3 : 0.0) / num;
				}
				if (reason == "Valuables extracted" && WindfallRoll(item4.Item2))
				{
					num2 *= 2.0;
					HostNoticeTo(item4.Item2, "Windfall! Double Scrap from that extraction");
				}
				if (reason == "Valuables extracted")
				{
					num2 *= 1.0 + (double)Mathf.Clamp(GearOf(item4.Item2, "gear.tax"), 0f, 10f) / 100.0;
				}
				HostAdd(item4.Item1, item4.Item2, num2 * num3, reason, item4.Item3);
			}
		}

		private static float GearOf(int actor, string key)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					return ClassStats.Get(item, key);
				}
			}
			return 0f;
		}

		private static bool WindfallRoll(int actor)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					float num = Mathf.Clamp(ClassStats.Get(item, "attr.windfall"), 0f, 15f);
					return num > 0f && Random.value * 100f < num;
				}
			}
			return false;
		}

		private static void HostNoticeTo(int actor, string text)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					Net.SendNotice(item, Notice.Text, 0f, text);
					break;
				}
			}
		}

		internal static float BonusOf(int actor)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					return HostDirector.Instance?.CombatOf(item).ScrapBonus ?? 0f;
				}
			}
			return 0f;
		}

		public static double HostBalance(string steamId)
		{
			return SaveBook.GetScrap(RunInfo.Key, steamId);
		}

		private static void HostAdd(string steamId, int actor, double amount, string reason, string name = "")
		{
			if (amount != 0.0)
			{
				if (amount > 0.0 && !reason.StartsWith("Gift") && Game.InLevel())
				{
					TeamPlay.HostAdd(actor, TeamPlay.Ev.Scrap, (float)amount);
				}
				double balance = SaveBook.AddScrap(RunInfo.Key, steamId, amount, name);
				Tell(actor, steamId, balance, amount, reason);
			}
		}

		public static double FromDollars(float dollars)
		{
			return Math.Max(0.0, (double)(dollars * Mathf.Clamp(Plugin.Cfg.ScrapPercent.Value, 0f, 100f)) / 100.0 / 100.0);
		}

		private static string IdOf(PlayerAvatar p)
		{
			string text = Game.SteamId(p);
			if (string.IsNullOrEmpty(text))
			{
				text = (Game.IsMultiplayer() ? "" : "local");
			}
			return text;
		}

		public static void HostGrant(PlayerAvatar p, double amount, string reason)
		{
			if (Game.IsMaster() && !(amount <= 0.0) && !RunStore.IsTempKey(RunInfo.Key))
			{
				string text = IdOf(p);
				if (!(text == ""))
				{
					Ascension.NoteScrap(p, amount);
					HostAdd(text, Game.ActorNumber(p), amount, reason, Game.Get(p, "playerName", ""));
				}
			}
		}

		public static void HostTake(PlayerAvatar p, double amount, string reason)
		{
			if (!Game.IsMaster() || amount <= 0.0 || RunStore.IsTempKey(RunInfo.Key))
			{
				return;
			}
			string text = IdOf(p);
			if (!(text == ""))
			{
				double num = Math.Min(amount, HostBalance(text));
				if (num > 0.0)
				{
					HostAdd(text, Game.ActorNumber(p), 0.0 - num, reason);
				}
			}
		}

		public static void HostTakeId(string steamId, int actor, double amount, string reason)
		{
			if (Game.IsMaster() && !(amount <= 0.0) && !string.IsNullOrEmpty(steamId) && !RunStore.IsTempKey(RunInfo.Key))
			{
				double num = Math.Min(amount, HostBalance(steamId));
				if (num > 0.0)
				{
					HostAdd(steamId, actor, 0.0 - num, reason);
				}
			}
		}

		public static bool HostTrySpend(string steamId, int actor, int cost)
		{
			if (cost <= 0)
			{
				return true;
			}
			if (string.IsNullOrEmpty(steamId) || RunStore.IsTempKey(RunInfo.Key))
			{
				return false;
			}
			if (HostBalance(steamId) + 1E-06 < (double)cost)
			{
				return false;
			}
			HostAdd(steamId, actor, -cost, "");
			return true;
		}

		public static string HostGift(string fromId, int fromActor, int toActor, int amount)
		{
			if (!Plugin.Cfg.AllowGifting.Value)
			{
				return "gifting is turned off by the host";
			}
			if (amount <= 0 || amount > 100000)
			{
				return "invalid amount";
			}
			if (RunStore.IsTempKey(RunInfo.Key))
			{
				return "no save loaded";
			}
			if (string.IsNullOrEmpty(fromId))
			{
				return "not verified";
			}
			string text = "";
			string text2 = "";
			string text3 = ClassClaims.NameOf(fromActor);
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == toActor)
				{
					text = Game.SteamId(item);
					text2 = ClassClaims.NameOf(toActor);
				}
			}
			if (text == "" || text == fromId)
			{
				return "that player isn't here";
			}
			if (HostBalance(fromId) + 1E-06 < (double)amount)
			{
				return "not enough " + Short;
			}
			HostAdd(fromId, fromActor, -amount, "Gift to " + text2);
			HostAdd(text, toActor, amount, "Gift from " + text3);
			return "";
		}

		public static void Tell(int actor, string steamId, double balance, double delta, string reason)
		{
			if (!Game.IsMultiplayer() || actor == ClassClaims.LocalActor || (actor < 0 && steamId == LocalId()))
			{
				OnBalance(balance, delta, reason);
			}
			else
			{
				Net.SendBalance(actor, balance, delta, reason);
			}
		}

		public static void HostSendBalance(string steamId, int actor)
		{
			Tell(actor, steamId, HostBalance(steamId), 0.0, "");
		}

		private static string LocalId()
		{
			PlayerAvatar val = Game.LocalPlayer();
			string text = (((Object)(object)val == (Object)null) ? "" : Game.SteamId(val));
			if (!string.IsNullOrEmpty(text))
			{
				return text;
			}
			return "local";
		}

		public static void OnBalance(double balance, double delta, string reason)
		{
			//IL_00be: Unknown result type (might be due to invalid IL or missing references)
			if (delta > 0.0 && !reason.StartsWith("Gift"))
			{
				Account.Count("scrap", (int)Math.Round(delta));
			}
			Local = balance;
			Known = true;
			if (delta > 0.0001 && reason != "")
			{
				RpgRuntime.Instance?.PopupScrap(delta, reason);
			}
			else if (delta < -0.0001 && reason != "")
			{
				RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, "-" + Format(0.0 - delta) + " " + Short + " – " + reason, Color);
			}
		}

		public static void ForgetLocal()
		{
			Local = 0.0;
			Known = false;
		}
	}
	public enum ScrapSplitMode
	{
		Equal,
		ByContribution
	}
	[HarmonyPatch]
	internal static class TeamMoneyPatch
	{
		private static MethodBase? TargetMethod()
		{
			MethodInfo methodInfo = AccessTools.Method(typeof(SemiFunc), "StatSetRunCurrency", (Type[])null, (Type[])null);
			if (!(methodInfo != null) || methodInfo.GetParameters().Length != 1 || !(methodInfo.GetParameters()[0].ParameterType == typeof(int)))
			{
				return null;
			}
			return methodInfo;
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			return TargetMethod() != null;
		}

		[HarmonyPrefix]
		private static void Prefix(out int __state)
		{
			__state = (Game.IsMaster() ? Shop.GetCurrency() : (-1));
		}

		[HarmonyPostfix]
		private static void Postfix(int __0, int __state)
		{
			try
			{
				Scrap.HostMoneyChanged(__state, __0);
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Scrap payout skipped: " + ex.Message);
			}
		}
	}
