		private static int _boughtLevel = int.MinValue;

		private static ModConfig C => Plugin.Cfg;

		public static float Mult => Mathf.Clamp(C.ShopPriceMultiplier.Value, 0.25f, 4f) * RunShape.CrewShopMult * Heat.ShopPrices * Ascension.ShopMult;

		public static void Load()
		{
			ResearchEcon.AddConsumables(Consumables);
			foreach (ConsumableDef consumable in Consumables)
			{
				ClassDatabase.ResolveAll("consumable " + consumable.id, consumable.effects);
			}
		}

		public static ConsumableDef? Cons(string? id)
		{
			foreach (ConsumableDef consumable in Consumables)
			{
				if (consumable.id == id)
				{
					return consumable;
				}
			}
			return null;
		}

		private static int Scale(float v)
		{
			return Mathf.Max(1, Mathf.RoundToInt(v * Mult));
		}

		public static int Tier(int rep)
		{
			int result = 0;
			for (int i = 0; i < TierAt.Length; i++)
			{
				if (rep >= TierAt[i])
				{
					result = i;
				}
			}
			return result;
		}

		public static int GearSlots(int tier)
		{
			return Mathf.Clamp(((tier >= 4) ? 6 : ((tier >= 3) ? 5 : ((tier >= 1) ? 4 : 3))) + C.ShopRotationSize.Value, 1, 9);
		}

		public static string StockKey(GearItem g, bool discount, string mark = "")
		{
			return string.Format("stock:{0}:{1}:{2}:{3}:{4}", g.rarity, (g.unique != "") ? 1 : 0, (GearSets.Get(g.set) != null) ? 1 : 0, Mathf.Clamp(g.sockets, 0, 2), discount ? 1 : 0) + ((mark != "") ? (":" + mark) : "");
		}

		public static int BasePrice(string key)
		{
			if (key.StartsWith("stock:", StringComparison.Ordinal))
			{
				string[] array = key.Split(':');
				if (array.Length < 6 || !int.TryParse(array[1], out var result))
				{
					return -1;
				}
				result = Mathf.Clamp(result, 0, GearPrice.Length - 1);
				float num = ((array[2] == "1") ? 400 : GearPrice[result]);
				if (array[3] == "1")
				{
					num *= 1.2f;
				}
				if (int.TryParse(array[4], out var result2))
				{
					num += 10f * (float)Mathf.Clamp(result2, 0, 2);
				}
				if (array[5] == "1")
				{
					num *= 0.75f;
				}
				if (array.Length >= 7)
				{
					num *= ((array[6] == "bm") ? 1.6f : ((array[6] == "cb") ? 1.2f : 1f));
				}
				return Scale(num * Market.PriceMult(key));
			}
			if (key == "module")
			{
				return Scale(30f * Market.PriceMult(key));
			}
			if (key.StartsWith("cons:", StringComparison.Ordinal))
			{
				ConsumableDef consumableDef = Cons(key.Substring(5));
				if (consumableDef != null)
				{
					return Scale((float)consumableDef.price * Market.PriceMult(key));
				}
				return -1;
			}
			switch (key)
			{
			case "lock":
				return Mathf.Max(0, C.ShopLockFee.Value);
			case "svc:affix":
				return Scale(20f);
			case "svc:attune":
				return Scale(40f);
			case "svc:partsup":
				return Scale(50f);
			default:
				if (key.StartsWith("upg:", StringComparison.Ordinal))
				{
					float num2 = GearUp.ScrapFor(key);
					if (!(num2 < 0f))
					{
						return Scale(num2);
					}
					return -1;
				}
				return ResearchEcon.BasePrice(key);
			}
		}

		public static int CratePrice(bool premium)
		{
			return Scale((float)(premium ? C.PricePremiumCrate.Value : C.PriceGearCrate.Value) * Market.PriceMult(premium ? "premium" : "crate"));
		}

		public static void HostNoteSalvage(int actor, string uid, int scrap)
		{
			if (Game.InShopLevel())
			{
				if (_salvagedLevel != RunInfo.LevelIndex)
				{
					Salvaged.Clear();
					_salvagedLevel = RunInfo.LevelIndex;
				}
				if (!Salvaged.TryGetValue(actor, out Dictionary<string, int> value))
				{
					value = (Salvaged[actor] = new Dictionary<string, int>());
				}
				value[uid] = Mathf.Max(0, scrap);
			}
		}

		public static int HostBuybackPrice(int actor, string uid)
		{
			if (uid.StartsWith("pawn:", StringComparison.Ordinal))
			{
				return ResearchEcon.HostPawnPrice(actor, uid.Substring(5));
			}
			if (_salvagedLevel != RunInfo.LevelIndex)
			{
				return -1;
			}
			if (!Salvaged.TryGetValue(actor, out Dictionary<string, int> value) || !value.TryGetValue(uid, out var value2))
			{
				return -1;
			}
			return value2;
		}

		public static void HostForgetBuyback(int actor, string uid)
		{
			if (uid.StartsWith("pawn:", StringComparison.Ordinal))
			{
				ResearchEcon.HostForgetPawn(actor, uid.Substring(5));
			}
			if (Salvaged.TryGetValue(actor, out Dictionary<string, int> value))
			{
				value.Remove(uid);
			}
		}

		private static List<string> BoughtOf(int actor)
		{
			if (_boughtLevel != RunInfo.LevelIndex)
			{
				Bought.Clear();
				_boughtLevel = RunInfo.LevelIndex;
			}
			if (!Bought.TryGetValue(actor, out List<string> value))
			{
				value = (Bought[actor] = new List<string>());
			}
			return value;
		}

		public static string HostLimit(int actor, string key)
		{
			List<string> list = BoughtOf(actor);
			if (key.StartsWith("cons:", StringComparison.Ordinal))
			{
				if (list.Contains(key))
				{
					return "one of each consumable per visit";
				}
				int num = 0;
				foreach (string item in list)
				{
					if (item.StartsWith("cons:", StringComparison.Ordinal))
					{
						num++;
					}
				}
				if (num >= C.ShopConsumablesPerLevel.Value)
				{
					return "consumable limit reached";
				}
			}
			if (key == "lock")
			{
				int num2 = 0;
				foreach (string item2 in list)
				{
					if (item2 == "lock")
					{
						num2++;
					}
				}
				if (num2 >= 2)
				{
					return "2 locks at most";
				}
			}
			if (key.StartsWith("futures:", StringComparison.Ordinal) && list.Exists((string k) => k.StartsWith("futures:", StringComparison.Ordinal)))
			{
				return "one futures order per visit";
			}
			return "";
		}

		public static void HostNoteBought(int actor, string key)
		{
			if (key.StartsWith("cons:", StringComparison.Ordinal) || key == "lock" || key.StartsWith("futures:", StringComparison.Ordinal))
			{
				BoughtOf(actor).Add(key);
			}
		}

		public static float[] CrateOdds(int floor, float luck)
		{
			RarityDef[] rarities = Plugin.Rpg.rarities;
			double[] array = new double[rarities.Length];
			double num = 0.0;
			for (int i = floor; i < rarities.Length; i++)
			{
				array[i] = (double)Math.Max(0f, rarities[i].weight) * (1.0 + (double)Math.Max(0f, luck) * 0.08 * (double)i);
				num += array[i];
			}
			float[] array2 = new float[rarities.Length];
			for (int j = 0; j < rarities.Length; j++)
			{
				array2[j] = ((num > 0.0) ? ((float)(array[j] / num * 100.0)) : 0f);
			}
			return array2;
		}

		public static List<ShopEntry> Generate(Random rng, int tier, float luck, List<ShopEntry> old, string wishlist, out bool wished)
		{
			wished = false;
			List<ShopEntry> list = new List<ShopEntry>();
			foreach (ShopEntry item in old)
			{
				if (item.locked && !item.sold)
				{
					item.locked = false;
					list.Add(item);
				}
			}
			int num = 0;
			foreach (ShopEntry item2 in list)
			{
				if (item2.kind == "gear" && !item2.featured)
				{
					num++;
				}
			}
			int num2 = GearSlots(tier);
			int num3 = -1;
			if (wishlist != "" && tier >= 1 && rng.NextDouble() < 0.1)
			{
				num3 = rng.Next(Mathf.Max(1, num2 - num));
			}
			for (int i = 0; i < num2 - num - Ascension.ShopFewer; i++)
			{
				int num4 = Gear.RollRarity(rng, luck, 1);
				bool flag = tier >= 4 && rng.NextDouble() < 0.05;
				GearItem gearItem;
				if (i == num3 && TryWish(rng, wishlist, tier, featuredSlot: false, out GearItem g))
				{
					gearItem = g;
					wished = true;
				}
				else
				{
					gearItem = Gear.RollExact(rng, flag ? Gear.MaxRarity : num4, null, flag);
					if (gearItem.rarity >= 2 && rng.NextDouble() * 100.0 < (double)C.SetPieceChance.Value)
					{
						GearSets.MakeSetPiece(gearItem, rng);
					}
				}
				list.Add(GearEntry(gearItem, featured: false, discount: false));
			}
			int num5 = 1 + RunShape.CrewFeatured;
			for (int num6 = list.FindAll((ShopEntry e) => e.featured).Count; num6 < num5; num6++)
			{
				bool discount = false;
				float num7 = ((tier >= 4) ? 0.15f : 0.05f);
				GearItem g3;
				if (wishlist != "" && !wished && rng.NextDouble() < 0.1 && TryWish(rng, wishlist, tier, featuredSlot: true, out GearItem g2))
				{
					g3 = g2;
					wished = true;
				}
				else if (rng.NextDouble() < (double)num7)
				{
					g3 = Gear.RollExact(rng, Gear.MaxRarity, null);
				}
				else
				{
					int num8 = Gear.RollRarity(rng, luck, (tier < 3) ? 1 : 3);
					if (rng.NextDouble() < 0.5)
					{
						num8 = Mathf.Min(num8 + 1, Gear.MaxRarity);
					}
					else
					{
						discount = true;
					}
					g3 = Gear.RollExact(rng, num8, null, allowUnique: false);
				}
				list.Insert(0, GearEntry(g3, featured: true, discount));
			}
			if (tier >= 2)
			{
				List<GearModuleDef> list2 = new List<GearModuleDef>(GearX.AllModules);
				for (int num9 = 0; num9 < 2; num9++)
				{
					if (list2.Count <= 0)
					{
						break;
					}
					List<GearModuleDef> list3 = ((num9 == 0 && Elements.On) ? list2.FindAll((GearModuleDef x) => x.id.EndsWith("_mod", StringComparison.Ordinal)) : null);
					GearModuleDef gearModuleDef = ((list3 != null && list3.Count > 0) ? list3[rng.Next(list3.Count)] : list2[rng.Next(list2.Count)]);
					list2.Remove(gearModuleDef);
					list.Add(new ShopEntry
					{
						kind = "module",
						id = gearModuleDef.id,
						key = "module",
						price = BasePrice("module")
					});
				}
			}
			if (RunDepth.Unlocked("blackmarket"))
			{
				GearItem g4 = Gear.RollExact(rng, Gear.MaxRarity, null);
				list.Add(Marked(g4, "bm", "black"));
				GearItem gearItem2 = Gear.RollExact(rng, Mathf.Min(3, Gear.MaxRarity), null, allowUnique: false);
				GearSets.MakeSetPiece(gearItem2, rng);
				list.Add(Marked(gearItem2, "bm", "black"));
				List<GearModuleDef> list4 = new List<GearModuleDef>(GearX.AllModules);
				if (list4.Count > 0)
				{
					GearModuleDef gearModuleDef2 = list4[rng.Next(list4.Count)];
					list.Add(new ShopEntry
					{
						kind = "module",
						id = gearModuleDef2.id,
						key = "module",
						price = BasePrice("module"),
						section = "black"
					});
				}
			}
			if (RunDepth.Unlocked("contraband"))
			{
				for (int num10 = 0; num10 < 2; num10++)
				{
					list.Add(Marked(Cursed(rng), "cb", "contra"));
				}
			}
			List<ConsumableDef> list5 = new List<ConsumableDef>(Consumables);
			List<ConsumableDef> list6 = list5.FindAll((ConsumableDef c) => c.id.StartsWith("coat_", StringComparison.Ordinal));
			list5.RemoveAll((ConsumableDef c) => c.id.StartsWith("coat_", StringComparison.Ordinal));
			if (Elements.On)
			{
				foreach (ConsumableDef item3 in list6)
				{
					list.Add(new ShopEntry
					{
						kind = "cons",
						id = item3.id,
						key = "cons:" + item3.id,
						price = BasePrice("cons:" + item3.id)
					});
				}
			}
			list5.RemoveAll((ConsumableDef c) => !ResearchEcon.ConsOffered(c.id));
			int num11 = ((tier >= 3) ? 4 : 3) - Ascension.ShopFewer;
			for (int num12 = 0; num12 < num11; num12++)
			{
				if (list5.Count <= 0)
				{
					break;
				}
				ConsumableDef consumableDef = list5[rng.Next(list5.Count)];
				list5.Remove(consumableDef);
				list.Add(new ShopEntry
				{
					kind = "cons",
					id = consumableDef.id,
					key = "cons:" + consumableDef.id,
					price = BasePrice("cons:" + consumableDef.id)
				});
			}
			for (int num13 = 0; num13 < 3; num13++)
			{
				if (Market.Short(num13))
				{
					string kind = num13 switch
					{
						1 => "module", 
						0 => "gear", 
						_ => "cons", 
					};
					int n = 0;
					int keep = Mathf.Max(1, list.FindAll((ShopEntry e) => e.kind == kind && !e.featured).Count / 2);
					list.RemoveAll((ShopEntry e) => e.kind == kind && !e.featured && ++n > keep);
				}
			}
			return list;
		}

		private static ShopEntry Marked(GearItem g, string mark, string section)
		{
			g.freeValue = 0;
			string key = StockKey(g, discount: false, mark);
			return new ShopEntry
			{
				kind = "gear",
				item = g,
				key = key,
				price = BasePrice(key),
				section = section
			};
		}

		private static GearItem Cursed(Random rng)
		{
			GearItem gearItem = Gear.RollExact(rng, Gear.MaxRarity, null, allowUnique: false);
			GearItem gearItem2 = Gear.RollExact(rng, Gear.MaxRarity, gearItem.slot, allowUnique: false);
			List<EffectDef> list = new List<EffectDef>(gearItem.effects);
			for (int i = (gearItem2.hasBase ? 1 : 0); i < gearItem2.effects.Length; i++)
			{
				EffectDef e0 = gearItem2.effects[i];
				if (!list.Exists((EffectDef effectDef2) => effectDef2.stat == e0.stat))
				{
					list.Add(new EffectDef
					{
						stat = e0.stat,
						value = e0.value,
						StatIndex = e0.StatIndex
					});
					break;
				}
			}
			PerkDef[] curses = Plugin.Rpg.curses;
			if (curses != null && curses.Length != 0)
			{
				PerkDef perkDef = curses[rng.Next(curses.Length)];
				if (perkDef?.effects != null)
				{
					EffectDef[] effects = perkDef.effects;
					foreach (EffectDef effectDef in effects)
					{
						list.Add(new EffectDef
						{
							stat = effectDef.stat,
							value = effectDef.value,
							StatIndex = effectDef.StatIndex
						});
					}
				}
				gearItem.uniqueDesc = "Cursed: " + (perkDef?.desc ?? "a curse");
			}
			gearItem.effects = list.ToArray();
			gearItem.name = "Cursed " + gearItem.name;
			return gearItem;
		}

		private static ShopEntry GearEntry(GearItem g, bool featured, bool discount)
		{
			g.freeValue = 0;
			string key = StockKey(g, discount);
			return new ShopEntry
			{
				kind = "gear",
				item = g,
				key = key,
				price = BasePrice(key),
				featured = featured
			};
		}

		public static GearItem? MakeUnique(Random rng, string name)
		{
			UniqueDef uniqueDef = null;
			UniqueDef[] uniques = Plugin.Rpg.uniques;
			foreach (UniqueDef uniqueDef2 in uniques)
			{
				if (uniqueDef2.name == name)
				{
					uniqueDef = uniqueDef2;
					break;
				}
			}
			if (uniqueDef == null)
			{
				return null;
			}
			for (int j = 0; j < 30; j++)
			{
				GearItem gearItem = Gear.RollExact(rng, Gear.MaxRarity, uniqueDef.slot);
				if (gearItem.unique == name)
				{
					return gearItem;
				}
			}
			GearItem gearItem2 = Gear.RollExact(rng, Gear.MaxRarity, uniqueDef.slot, allowUnique: false);
			List<EffectDef> list = new List<EffectDef>(gearItem2.effects);
			EffectDef[] effects = uniqueDef.effects;
			foreach (EffectDef effectDef in effects)
			{
				list.Add(new EffectDef
				{
					stat = effectDef.stat,
					value = effectDef.value
				});
			}
			gearItem2.effects = list.ToArray();
			ClassDatabase.ResolveAll("gear " + uniqueDef.name, gearItem2.effects);
			gearItem2.unique = uniqueDef.name;
			gearItem2.uniqueDesc = uniqueDef.desc;
			gearItem2.flavor = uniqueDef.flavor ?? "";
			gearItem2.name = uniqueDef.name;
			if (gearItem2.sockets == 0)
			{
				gearItem2.sockets = 1;
				gearItem2.modules = new string[1] { "" };
			}
			return gearItem2;
		}

		private static bool TryWish(Random rng, string wish, int tier, bool featuredSlot, out GearItem g)
		{
			g = null;
			if (wish.StartsWith("u:", StringComparison.Ordinal))
			{
				if (tier < 4 && !featuredSlot)
				{
					return false;
				}
				GearItem gearItem = MakeUnique(rng, wish.Substring(2));
				if (gearItem == null)
				{
					return false;
				}
				g = gearItem;
				return true;
			}
			if (wish.StartsWith("s:", StringComparison.Ordinal))
			{
				SetDef setDef = GearSets.Get(wish.Substring(2));
				if (setDef == null)
				{
					return false;
				}
				g = Gear.RollExact(rng, Mathf.Max(2, Gear.RollRarity(rng, 0f, 2)), null, allowUnique: false);
				g.set = setDef.id;
				return true;
			}
			return false;
		}

		public static string WishName(string wish)
		{
			if (wish.StartsWith("u:", StringComparison.Ordinal))
			{
				return wish.Substring(2) + " (Unique)";
			}
			if (wish.StartsWith("s:", StringComparison.Ordinal))
			{
				SetDef setDef = GearSets.Get(wish.Substring(2));
				if (setDef == null)
				{
					return "?";
				}
				return setDef.name + " set";
			}
			return "nothing";
		}

		public static List<string> WishOptions()
		{
			List<string> list = new List<string> { "" };
			UniqueDef[] uniques = Plugin.Rpg.uniques;
			foreach (UniqueDef uniqueDef in uniques)
			{
				list.Add("u:" + uniqueDef.name);
			}
			foreach (SetDef item in GearSets.All)
			{
				list.Add("s:" + item.id);
			}
			return list;
		}
	}
	internal static class Starters
	{
		public const string Hex = "#8fd18f";

		private static readonly Dictionary<string, StarterDef> ByClass = new Dictionary<string, StarterDef>();

		private static readonly HashSet<string> ToolsGiven = new HashSet<string>();

		public static bool GearOn => Plugin.Cfg.StartersGear.Value;

		public static bool ToolsOn => Plugin.Cfg.StartersTools.Value;

		public static void Load(GearPack pack)
		{
			ByClass.Clear();
			StarterDef[] array = pack.starters ?? Array.Empty<StarterDef>();
			foreach (StarterDef starterDef in array)
			{
				if (starterDef != null && !(starterDef.cls == ""))
				{
					StarterDef starterDef2 = starterDef;
					if (starterDef2.effects == null)
					{
						starterDef2.effects = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("starter " + starterDef.cls, starterDef.effects);
					ByClass[starterDef.cls] = starterDef;
				}
			}
		}

		public static StarterDef? Def(string? cls)
		{
			if (string.IsNullOrEmpty(cls) || !ByClass.TryGetValue(cls, out StarterDef value))
			{
				return null;
			}
			return value;
		}

		public static bool Is(GearItem? g)
		{
			if (g != null)
			{
				return !string.IsNullOrEmpty(g.starter);
			}
			return false;
		}

		public static GearItem? Make(StarterDef d)
		{
			RpgData rpg = Plugin.Rpg;
			int num = rpg.SlotIndex(d.slot);
			if (num < 0)
			{
				Plugin.Log.LogWarning((object)("[starters] " + d.cls + ": unknown slot '" + d.slot + "'."));
				return null;
			}
			GearItem gearItem = GearX.RollItem(new Random(), 0, rpg.slots[num], allowUnique: false);
			List<EffectDef> list = new List<EffectDef>();
			if (gearItem.hasBase && gearItem.effects.Length != 0)
			{
				list.Add(gearItem.effects[0]);
			}
			EffectDef[] effects = d.effects;
			foreach (EffectDef effectDef in effects)
			{
				list.Add(new EffectDef
				{
					stat = effectDef.stat,
					value = effectDef.value
				});
			}
			gearItem.effects = list.ToArray();
			gearItem.behavior = "";
			gearItem.hidden = Array.Empty<EffectDef>();
			gearItem.set = "";
			gearItem.unique = "";
			gearItem.name = d.name;
			gearItem.starter = d.cls;
			gearItem.freeValue = 0;
			ClassDatabase.ResolveAll("starter " + d.cls, gearItem.effects);
			return gearItem;
		}

		public static string Describe(GearItem g)
		{
			StarterDef starterDef = Def(g.starter);
			ClassDef classDef = Plugin.Db.Get(g.starter);
			string text = ((classDef != null) ? ("<color=" + classDef.color + ">" + classDef.name + "</color>") : g.starter);
			bool flag = starterDef != null && Array.TrueForAll(starterDef.effects, (EffectDef e) => e.StatIndex >= 0);
			return ((starterDef != null && !flag) ? ("<color=#8fd18f><b>STARTER:</b> " + starterDef.desc + "</color>\n") : "") + "<color=#9a9ca0>" + text + " only. Salvages for 0 Scrap; can't be rerolled, upgraded or crafted. A class switch swaps it for the new class's.</color>\n";
		}

		public static void DebugResetTools()
		{
			ToolsGiven.Clear();
		}

		public static void HostTick(float sinceLevelStart)
		{
			//IL_00cf: Unknown result type (might be due to invalid IL or missing references)
			if (!ToolsOn || !Game.InLevel() || sinceLevelStart < 4f || RunStore.IsTempKey(RunInfo.Key))
			{
				return;
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item == (Object)null || !Game.IsAlive(item))
				{
					continue;
				}
				StarterDef starterDef = Def(ClassStats.ClassOf(item));
				if (starterDef == null || starterDef.tool == "" || starterDef.toolCount <= 0 || !ToolsGiven.Add(RunInfo.Key + "#" + Game.SteamId(item)))
				{
					continue;
				}
				int num = 0;
				Object val = FindItem(starterDef.tool);
				if (val != (Object)null)
				{
					for (int i = 0; i < starterDef.toolCount; i++)
					{
						if (Spawn(val, ((Component)item).transform.position, i))
						{
							num++;
						}
					}
				}
				string text = ((starterDef.toolName != "") ? starterDef.toolName : starterDef.tool);
				if (num > 0)
				{
					Plugin.Log.LogInfo((object)$"[starters] {Net.PlayerNameOf(Game.ActorNumber(item))} ({starterDef.cls}): {num}x {text} spawned.");
					Net.SendNotice(item, Notice.Popup, 0f, "Starter tool: " + ((num > 1) ? (num + "x ") : "") + text + " at your feet");
				}
				else
				{
					Plugin.Log.LogWarning((object)("[starters] " + starterDef.cls + ": item '" + starterDef.tool + "' " + ((val == (Object)null) ? "isn't in the game's item list" : "couldn't be spawned") + " - 25 Scrap instead."));
					Scrap.HostGrant(item, 25.0, "starter tool");
					Net.SendNotice(item, Notice.Popup, 0f, "Starter tool unavailable (" + text + "): +25 Scrap instead");
				}
			}
		}

		private static Object? FindItem(string key)
		{
			StatsManager instance = StatsManager.instance;
			if (!((Object)(object)instance == (Object)null))
			{
				IDictionary dictionary = Game.Get<IDictionary>(instance, "itemDictionary", null);
				if (dictionary != null)
				{
					Object val = null;
					{
						foreach (object value in dictionary.Values)
						{
							Object val2 = (Object)((value is Object) ? value : null);
							if (val2 != null && !(val2 == (Object)null))
							{
								string text = (val2.name.StartsWith("Item ", StringComparison.OrdinalIgnoreCase) ? val2.name.Substring(5) : val2.name);
								text = text.ToLowerInvariant();
								if (text == key)
								{
									return val2;
								}
								if (val == (Object)null && text.Contains(key))
								{
									val = val2;
								}
							}
						}
						return val;
					}
				}
			}
			return null;
		}

		private static bool Spawn(Object item, Vector3 near, int i)
		{
			//IL_0000: Unknown result type (might be due to invalid IL or missing references)
			//IL_0013: Unknown result type (might be due to invalid IL or missing references)
			//IL_0027: Unknown result type (might be due to invalid IL or missing references)
			//IL_002c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0031: Unknown result type (might be due to invalid IL or missing references)
			//IL_0036: Unknown result type (might be due to invalid IL or missing references)
			//IL_0037: Unknown result type (might be due to invalid IL or missing references)
			//IL_004f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0050: Unknown result type (might be due to invalid IL or missing references)
			//IL_005a: Unknown result type (might be due to invalid IL or missing references)
			//IL_005f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0064: Unknown result type (might be due to invalid IL or missing references)
			//IL_0049: Unknown result type (might be due to invalid IL or missing references)
			//IL_004e: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ea: Unknown result type (might be due to invalid IL or missing references)
			//IL_00eb: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c2: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c3: Unknown result type (might be due to invalid IL or missing references)
			Vector3 val = near + Quaternion.Euler(0f, 70f * (float)i, 0f) * new Vector3(0.7f, 0f, 0.4f);
			NavMeshHit val2 = default(NavMeshHit);
			if (NavMesh.SamplePosition(val, ref val2, 1.5f, -1))
			{
				val = ((NavMeshHit)(ref val2)).position;
			}
			val += Vector3.up * 0.8f;
			try
			{
				object obj = AccessTools.Field(((object)item).GetType(), "prefab")?.GetValue(item);
				if (obj == null)
				{
					return false;
				}
				GameObject val3 = null;
				if (Game.IsMultiplayer())
				{
					string text = (Prop(obj, "ResourcePath") as string) ?? "";
					if (text != "")
					{
						val3 = PhotonNetwork.InstantiateRoomObject(text, val, Quaternion.identity, (byte)0, (object[])null);
					}
				}
				else
				{
					object? obj2 = Prop(obj, "Prefab");
					GameObject val4 = (GameObject)((obj2 is GameObject) ? obj2 : null);
					if (val4 != null)
					{
						val3 = Object.Instantiate<GameObject>(val4, val, Quaternion.identity);
					}
				}
				return (Object)(object)val3 != (Object)null;
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Starter tool: couldn't spawn " + item.name + " (" + ex.GetBaseException().Message + ").");
				return false;
			}
		}

		private static object? Prop(object o, string name)
		{
			Type type = o.GetType();
			PropertyInfo property = type.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
			if (property != null)
			{
				return property.GetValue(o);
			}
			return AccessTools.Field(type, name)?.GetValue(o);
		}
	}
	[Serializable]
	public class SynergyDef
	{
		public string id = "";

		public string a = "";

		public string b = "";

		public string name = "";

		public string desc = "";

		public float value;

		public float value2;

		public string research = "";

		public string Text => desc.Replace("{v2}", value2.ToString("0.##")).Replace("{v}", value.ToString("0.##"));

		public string PartnerOf(string cls)
		{
			if (!(cls == a))
			{
				if (!(cls == b))
				{
					return "";
				}
				return a;
			}
			return b;
		}
	}
	[Serializable]
	public class SynergyFile
	{
		public int version = 1;

		public SynergyDef[] synergies = Array.Empty<SynergyDef>();
	}
	internal static class Synergies
	{
		public static readonly List<SynergyDef> All = new List<SynergyDef>();

		private static readonly Dictionary<string, SynergyDef> ById = new Dictionary<string, SynergyDef>();

		private static readonly Dictionary<string, List<SynergyDef>> ByClass = new Dictionary<string, List<SynergyDef>>();

		private static readonly Dictionary<int, Dictionary<string, float>> Seen = new Dictionary<int, Dictionary<string, float>>();

		private static readonly Dictionary<int, float> TimeOn = new Dictionary<int, float>();

		private static float _next;

		private const float Grace = 2f;

		private static readonly Dictionary<string, List<SynergyDef>> OpenFor = new Dictionary<string, List<SynergyDef>>();

		private static bool Enabled
		{
			get
			{
				if (Plugin.Cfg.Synergies.Value)
				{
					return !Difficulty.LoneWolves;
				}
				return false;
			}
		}

		public static void Load()
		{
			All.Clear();
			ById.Clear();
			ByClass.Clear();
			string text = ClassDatabase.ReadEmbedded("synergies");
			SynergyFile synergyFile = null;
			try
			{
				synergyFile = Json.Deserialize<SynergyFile>(ClassDatabase.ReadWithOverride("synergies", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("synergies data parse error: " + ex.Message));
			}
			if (synergyFile?.synergies == null || synergyFile.synergies.Length == 0)
			{
				try
				{
					synergyFile = Json.Deserialize<SynergyFile>(text);
				}
				catch
				{
					synergyFile = new SynergyFile();
				}
			}
			SynergyDef[] array = synergyFile.synergies ?? Array.Empty<SynergyDef>();
			foreach (SynergyDef synergyDef in array)
			{
				if (synergyDef != null && !(synergyDef.id == "") && !(synergyDef.a == synergyDef.b) && !ById.ContainsKey(synergyDef.id))
				{
					if (Plugin.Db.Get(synergyDef.a) == null || Plugin.Db.Get(synergyDef.b) == null)
					{
						Plugin.Log.LogWarning((object)("[synergies] '" + synergyDef.id + "' names a class that doesn't exist; skipped."));
						continue;
					}
					All.Add(synergyDef);
					ById[synergyDef.id] = synergyDef;
					Add(synergyDef.a, synergyDef);
					Add(synergyDef.b, synergyDef);
				}
			}
		}

		private static void Add(string cls, SynergyDef s)
		{
			if (!ByClass.TryGetValue(cls, out List<SynergyDef> value))
			{
				value = (ByClass[cls] = new List<SynergyDef>());
			}
			value.Add(s);
		}

		public static bool Locked(SynergyDef s)
		{
			if (s.research != "")
			{
				return !Research.Lobby(s.research);
			}
			return false;
		}

		public static IReadOnlyList<SynergyDef> For(string cls)
		{
			if (!ByClass.TryGetValue(cls, out List<SynergyDef> value))
			{
				return Array.Empty<SynergyDef>();
			}
			bool flag = false;
			foreach (SynergyDef item in value)
			{
				if (Locked(item))
				{
					flag = true;
					break;
				}
			}
			if (!flag)
			{
				return value;
			}
			if (!OpenFor.TryGetValue(cls, out List<SynergyDef> value2))
			{
				value2 = (OpenFor[cls] = new List<SynergyDef>());
			}
			value2.Clear();
			foreach (SynergyDef item2 in value)
			{
				if (!Locked(item2))
				{
					value2.Add(item2);
				}
			}
			return value2;
		}

		public static SynergyDef? Get(string id)
		{
			if (!ById.TryGetValue(id, out SynergyDef value))
			{
				return null;
			}
			return value;
		}

		public static float V(string id)
		{
			if (!ById.TryGetValue(id, out SynergyDef value))
			{
				return 0f;
			}
			return value.value;
		}

		public static float V2(string id)
		{
			if (!ById.TryGetValue(id, out SynergyDef value))
			{
				return 0f;
			}
			return value.value2;
		}

		public static void Tick()
		{
			//IL_0168: Unknown result type (might be due to invalid IL or missing references)
			//IL_0174: Unknown result type (might be due to invalid IL or missing references)
			//IL_0179: Unknown result type (might be due to invalid IL or missing references)
			//IL_017e: Unknown result type (might be due to invalid IL or missing references)
			float time = Time.time;
			if (time < _next)
			{
				return;
			}
			float num = ((_next <= 0f) ? 0.5f : Mathf.Min(1f, time - (_next - 0.5f)));
			_next = time + 0.5f;
			if (!Enabled || !Game.InLevel())
			{
				Seen.Clear();
				return;
			}
			float num2 = Mathf.Clamp(Plugin.Cfg.SynergyRange.Value, 3f, 60f);
			List<PlayerAvatar> list = Game.Players();
			foreach (PlayerAvatar item in list)
			{
				if ((Object)(object)item == (Object)null || !Game.IsAlive(item))
				{
					continue;
				}
				string text = ClassStats.ClassOf(item);
				if (text == "" || !ByClass.TryGetValue(text, out List<SynergyDef> value))
				{
					continue;
				}
				int num3 = Game.ActorNumber(item);
				bool flag = false;
				foreach (SynergyDef item2 in value)
				{
					if (Locked(item2))
					{
						continue;
					}
					string text2 = item2.PartnerOf(text);
					foreach (PlayerAvatar item3 in list)
					{
						if ((Object)(object)item3 == (Object)null || (Object)(object)item3 == (Object)(object)item || !Game.IsAlive(item3) || ClassStats.ClassOf(item3) != text2)
						{
							continue;
						}
						Vector3 val = ((Component)item3).transform.position - ((Component)item).transform.position;
						if (!(((Vector3)(ref val)).sqrMagnitude > num2 * num2))
						{
							if (!Seen.TryGetValue(num3, out Dictionary<string, float> value2))
							{
								value2 = (Seen[num3] = new Dictionary<string, float>());
							}
							value2[item2.id] = time;
							flag = true;
							break;
						}
					}
				}
				if (flag || HasAny(num3, time))
				{
					TimeOn.TryGetValue(num3, out var value3);
					TimeOn[num3] = value3 + num;
				}
			}
		}

		private static bool HasAny(int actor, float now)
		{
			if (!Seen.TryGetValue(actor, out Dictionary<string, float> value))
			{
				return false;
			}
			foreach (KeyValuePair<string, float> item in value)
			{
				if (now - item.Value <= 2f)
				{
					return true;
				}
			}
			return false;
		}

		public static bool Has(PlayerAvatar? p, string id)
		{
			if ((Object)(object)p == (Object)null || !Enabled)
			{
				return false;
			}
			if (Seen.TryGetValue(Game.ActorNumber(p), out Dictionary<string, float> value) && value.TryGetValue(id, out var value2))
			{
				return Time.time - value2 <= 2f;
			}
			return false;
		}

		public static bool AnyActive(string id)
		{
			if (!Enabled)
			{
				return false;
			}
			float time = Time.time;
			foreach (Dictionary<string, float> value2 in Seen.Values)
			{
				if (value2.TryGetValue(id, out var value) && time - value <= 2f)
				{
					return true;
				}
			}
			return false;
		}

		public static void ActiveFor(PlayerAvatar? p, List<SynergyDef> into)
		{
			into.Clear();
			if ((Object)(object)p == (Object)null || !Enabled || !Seen.TryGetValue(Game.ActorNumber(p), out Dictionary<string, float> value))
			{
				return;
			}
			float time = Time.time;
			foreach (KeyValuePair<string, float> item in value)
			{
				if (time - item.Value <= 2f && ById.TryGetValue(item.Key, out SynergyDef value2))
				{
					into.Add(value2);
				}
			}
		}

		public static float SecondsOn(int actor)
		{
			if (!TimeOn.TryGetValue(actor, out var value))
			{
				return 0f;
			}
			return value;
		}

		public static void NewLevel()
		{
			Seen.Clear();
			TimeOn.Clear();
			_next = 0f;
		}

		public static void PlayerLeft(int actor)
		{
			Seen.Remove(actor);
			TimeOn.Remove(actor);
		}
	}
	[Serializable]
	public class TeamContractDef
	{
		public string id = "";

		public string name = "";

		public string goal = "";

		public string curse = "";

		public int target = 1;

		public int scrap;

		public int gear = -1;

		public int attr;

		public int loss;

		public int[] parts = new int[4];

		public bool bossOnly;
	}
	[Serializable]
	public class CurseDef
	{
		public string id = "";

		public string desc = "";
	}
	[Serializable]
	public class TeamContractFile
	{
		public int version = 1;

		public TeamContractDef[] contracts = Array.Empty<TeamContractDef>();

		public CurseDef[] curses = Array.Empty<CurseDef>();
	}
	internal static class TeamContracts
	{
		public const int Voting = 0;

		public const int Accepted = 1;

		public const int Success = 2;

		public const int Failed = 3;

		public const int Declined = 4;

		public static TeamContractFile Data = new TeamContractFile();

		private static readonly Dictionary<string, TeamContractDef> ById = new Dictionary<string, TeamContractDef>();

		private static int _curseLevel = -1;

		private static TeamContractDef? _def;

		private static int _state = -1;

		private static int _target;

		private static int _level = -1;

		private static float _scale = 1f;

		private static float _voteEnd;

		private static float _liveAt = -1f;

		private static readonly Dictionary<int, bool> Votes = new Dictionary<int, bool>();

		private static readonly List<int> Participants = new List<int>();

		private static int _kills;

		private static int _elites;

		private static int _deaths;

		private static int _breaks;

		private static int _extracted;

		private static float _goalSum;

		private static int _goalCount;

		private static float _bestCarried;

		private static bool _offered;

		private static bool _curseSent;

		private static float _resendAt = -1f;

		private static bool _boardVote;

		public static string CurseNow { get; private set; } = "";

		private static string VoteRuleText => Plugin.Cfg.TeamVoteMode.Value.ToString().ToLowerInvariant();

		public static void Load()
		{
			ById.Clear();
			string text = ClassDatabase.ReadEmbedded("teamcontracts");
			TeamContractFile teamContractFile = null;
			try
			{
				teamContractFile = Json.Deserialize<TeamContractFile>(ClassDatabase.ReadWithOverride("teamcontracts", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("team contracts data parse error: " + ex.Message));
			}
			if (teamContractFile?.contracts == null || teamContractFile.contracts.Length == 0)
			{
				try
				{
					teamContractFile = Json.Deserialize<TeamContractFile>(text);
				}
				catch
				{
					teamContractFile = new TeamContractFile();
				}
			}
			Data = teamContractFile ?? new TeamContractFile();
			TeamContractFile data = Data;
			if (data.curses == null)
			{
				data.curses = Array.Empty<CurseDef>();
			}
			TeamContractDef[] array = Data.contracts ?? Array.Empty<TeamContractDef>();
			foreach (TeamContractDef teamContractDef in array)
			{
				if (teamContractDef == null || teamContractDef.id == "" || ById.ContainsKey(teamContractDef.id))
				{
					continue;
				}
				if (teamContractDef.parts == null || teamContractDef.parts.Length < 4)
				{
					int[] array2 = new int[4];
					if (teamContractDef.parts != null)
					{
						Array.Copy(teamContractDef.parts, array2, teamContractDef.parts.Length);
					}
					teamContractDef.parts = array2;
				}
				ById[teamContractDef.id] = teamContractDef;
			}
		}

		public static TeamContractDef? Get(string id)
		{
			if (!ById.TryGetValue(id ?? "", out TeamContractDef value))
			{
				return null;
			}
			return value;
		}

		public static string CurseDesc(string id)
		{
			CurseDef[] curses = Data.curses;
			foreach (CurseDef curseDef in curses)
			{
				if (curseDef != null && curseDef.id == id)
				{
					return curseDef.desc;
				}
			}
			return id;
		}

		public static float Scale(int levelIndex)
		{
			return (1f + 0.1f * (float)Mathf.Max(0, levelIndex)) * Mathf.Clamp(Plugin.Cfg.TeamStakeScale.Value, 0.25f, 4f);
		}

		public static int Target(TeamContractDef d, int players)
		{
			if (!(d.id == "elite_purge") || players > 2)
			{
				return d.target;
			}
			return Mathf.Max(1, d.target - 1);
		}

		public static string Goal(TeamContractDef d, int target)
		{
			return d.goal.Replace("{t}", (d.id == "heavy_lifting") ? target.ToString("N0") : target.ToString());
		}

		public static string RewardText(TeamContractDef d, float scale)
		{
			List<string> list = new List<string>();
			if (d.scrap > 0)
			{
				list.Add($"{Mathf.RoundToInt((float)d.scrap * scale)} {Scrap.Short}");
			}
			int[] array = ScaledParts(d, scale);
			if (array[0] + array[1] + array[2] + array[3] > 0)
			{
				list.Add(Crafting.Describe(array));
			}
			if (d.gear >= 0)
			{
				list.Add(Gear.Rarity(d.gear).name + " gear");
			}
			if (d.attr > 0)
			{
				list.Add(string.Format("{0} attribute point{1}", d.attr, (d.attr == 1) ? "" : "s"));
			}
			return string.Join(", ", list);
		}

		public static string LossText(TeamContractDef d, float scale)
		{
			List<string> list = new List<string>();
			if (d.loss > 0)
			{
				list.Add($"-{Mathf.RoundToInt((float)d.loss * scale)} {Scrap.Short}");
			}
			if (d.curse != "")
			{
				list.Add("curse next level: " + d.curse + " (" + CurseDesc(d.curse) + ")");
			}
			return string.Join(", ", list);
		}

		public static int[] ScaledParts(TeamContractDef d, float scale)
		{
			int[] array = new int[4];
			for (int i = 0; i < 4; i++)
			{
				array[i] = ((d.parts[i] > 0) ? Mathf.Max(1, Mathf.RoundToInt((float)d.parts[i] * scale)) : 0);
			}
			return array;
		}

		public static void SetCurse(string curse, int level)
		{
			CurseNow = ((level == RunInfo.LevelIndex) ? (curse ?? "") : "");
			_curseLevel = level;
		}

		public static void CheckCurseLevel()
		{
			if (_curseLevel != RunInfo.LevelIndex)
			{
				CurseNow = "";
			}
		}

		public static bool Voted(int actor)
		{
			return Votes.ContainsKey(actor);
		}

		public static void NewLevel()
		{
			bool num = _def != null && _level == RunInfo.LevelIndex;
			_offered = false;
			_curseSent = false;
			_liveAt = -1f;
			_resendAt = -1f;
			if (!num)
			{
				_def = null;
				_state = -1;
				Votes.Clear();
				Participants.Clear();
			}
			_kills = (_elites = (_deaths = (_breaks = (_extracted = 0))));
			_bestCarried = 0f;
			_goalSum = 0f;
			_goalCount = 0;
			CheckCurseLevel();
		}

		public static void HostTick()
		{
			if (!Game.IsMaster() || !Game.InLevel())
			{
				return;
			}
			if (_liveAt < 0f)
			{
				_liveAt = Time.time;
			}
			if (!_curseSent)
			{
				_curseSent = true;
				SendCurseIfAny();
			}
			if (!_offered)
			{
				_offered = true;
				if (_def != null && _level == RunInfo.LevelIndex)
				{
					if (_state == 0)
					{
						Decide();
					}
					Resend();
				}
				else if (Plugin.Cfg.TeamContracts.Value)
				{
					Offer(board: false);
				}
			}
			else
			{
				if (_def == null)
				{
					return;
				}
				float time = Time.time;
				if (_resendAt > 0f && time >= _resendAt)
				{
					_resendAt = -1f;
					Resend();
				}
				if (_state == 0 && (time >= _voteEnd || AllVoted()))
				{
					Decide();
				}
				if (_state != 1)
				{
					return;
				}
				string id = _def.id;
				if (!(id == "blitz"))
				{
					if (id == "boss_bounty" && Bosses.SpawnedAt > 0f && Bosses.KilledAt < 0f && time - Bosses.SpawnedAt > (float)_target * 60f)
					{
						Settle(won: false);
					}
				}
				else if (time - _liveAt > (float)_target * 60f)
				{
					Settle(won: false);
				}
			}
		}

		public static void HostBoardTick()
		{
			if (Game.IsMaster() && Plugin.Cfg.TeamContracts.Value && Game.ClassSelectionOpenForLobby() && (_def == null || _level != RunInfo.LevelIndex))
			{
				Offer(board: true);
			}
		}

		private static void Offer(bool board)
		{
			List<TeamContractDef> list = new List<TeamContractDef>();
			bool flag = Bosses.IsBossLevel(RunInfo.LevelIndex);
			foreach (TeamContractDef value in ById.Values)
			{
				if (!value.bossOnly || flag)
				{
					list.Add(value);
				}
			}
			if (list.Count != 0)
			{
				list.Sort((TeamContractDef a, TeamContractDef b) => string.CompareOrdinal(a.id, b.id));
				Random random = RunInfo.RngFor(RunInfo.LevelIndex * 4241 + 77);
				_def = list[random.Next(list.Count)];
				_level = RunInfo.LevelIndex;
				_scale = Scale(_level);
				_target = Target(_def, Game.Players().Count);
				_state = 0;
				_boardVote = board;
				_voteEnd = (board ? float.MaxValue : (Time.time + Mathf.Clamp(Plugin.Cfg.TeamVoteSeconds.Value, 10f, 180f)));
				Votes.Clear();
				Participants.Clear();
				Net.SendTeamOffer(new object[5]
				{
					_def.id,
					_target,
					_level,
					VoteLeft(),
					_scale
				});
				Broadcast("");
				_resendAt = Time.time + 5f;
			}
		}

		public static void Resend()
		{
			if (Game.IsMaster() && _def != null)
			{
				Net.SendTeamOffer(new object[5]
				{
					_def.id,
					_target,
					_level,
					VoteLeft(),
					_scale
				});
				Broadcast("");
				SendCurseIfAny();
			}
		}

		private static void SendCurseIfAny()
		{
			RunSave runSave = RpgRuntime.Instance?.HostRun;
			if (runSave != null)
			{
				Net.SendCurse((runSave.curseLevel == RunInfo.LevelIndex) ? runSave.curse : "", RunInfo.LevelIndex);
			}
		}

		private static float VoteLeft()
		{
			if (!_boardVote || _state != 0)
			{
				return Mathf.Max(0f, _voteEnd - Time.time);
			}
			return -1f;
		}

		private static bool AllVoted()
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && !Votes.ContainsKey(Game.ActorNumber(item)))
				{
					return false;
				}
			}
			return true;
		}

		public static void HostVote(int actor, bool accept)
		{
			if (!Game.IsMaster() || _state != 0 || _def == null)
			{
				return;
			}
			bool flag = false;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					flag = true;
					break;
				}
			}
			if (flag)
			{
				Votes[actor] = accept;
				Broadcast("");
				if (AllVoted())
				{
					Decide();
				}
			}
		}

		private static void Decide()
		{
			if (_def == null || _state != 0)
			{
				return;
			}
			int num = 0;
			int count = Votes.Count;
			foreach (bool value2 in Votes.Values)
			{
				if (value2)
				{
					num++;
				}
			}
			bool flag;
			switch (Plugin.Cfg.TeamVoteMode.Value)
			{
			case TeamVote.Host:
			{
				PlayerAvatar val = Game.LocalPlayer();
				bool value = default(bool);
				flag = (Object)(object)val != (Object)null && Votes.TryGetValue(Game.ActorNumber(val), out value) && value;
				break;
			}
			case TeamVote.Unanimous:
				flag = num > 0 && num >= Game.Players().Count && num == count;
				break;
			default:
				flag = count > 0 && num * 2 > count;
				break;
			}
			Participants.Clear();
			if (flag)
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item != (Object)null)
					{
						Participants.Add(Game.ActorNumber(item));
					}
				}
			}
			_state = (flag ? 1 : 4);
			Plugin.Log.LogInfo((object)string.Format("[team contract] {0}: {1} ({2} accept, {3} decline, {4} players, {5}).", _def.name, flag ? "accepted" : "declined - discarded, no reward and no stakes", num, count - num, Game.Players().Count, VoteRuleText));
			Broadcast(flag ? ("Team contract accepted: " + _def.name) : ("Team contract declined: " + _def.name + " - no reward, no stakes"));
			if (flag)
			{
				if ((_def.id == "deathless" && _deaths > 0) || (_def.id == "pacifist" && _kills > 0) || (_def.id == "clean_hands" && _breaks > 0))
				{
					Settle(won: false);
				}
				else
				{
					Check();
				}
			}
		}

		private static void Broadcast(string text)
		{
			if (_def == null)
			{
				return;
			}
			int num = 0;
			List<int> list = new List<int>();
			List<int> list2 = new List<int>();
			foreach (KeyValuePair<int, bool> vote in Votes)
			{
				if (vote.Value)
				{
					num++;
					list.Add(vote.Key);
				}
				else
				{
					list2.Add(vote.Key);
				}
			}
			var (num2, num3) = HaulProgress();
			Net.SendTeamState(new object[12]
			{
				_state,
				_def.id,
				num,
				Votes.Count,
				VoteLeft(),
				Participants.ToArray(),
				text ?? "",
				_level,
				list.ToArray(),
				list2.ToArray(),
				num2,
				num3
			});
		}

		private static void Check()
		{
			if (_state != 1 || _def == null)
			{
				return;
			}
			switch (_def.id)
			{
			case "clean_hands":
				if (_breaks > 0)
				{
					Settle(won: false);
				}
				else if (_extracted >= _target)
				{
					Settle(won: true);
				}
				break;
			case "deathless":
				if (_deaths > 0)
				{
					Settle(won: false);
				}
				break;
			case "pacifist":
				if (_kills > 0)
				{
					Settle(won: false);
				}
				break;
			case "elite_purge":
				if (_elites >= _target)
				{
					Settle(won: true);
				}
				break;
			case "heavy_lifting":
				if (_bestCarried >= (float)_target)
				{
					Settle(won: true);
				}
				break;
			case "boss_bounty":
				if (Bosses.KilledAt > 0f)
				{
					Settle(Bosses.SpawnedAt > 0f && Bosses.KilledAt - Bosses.SpawnedAt <= (float)_target * 60f);
				}
				break;
			}
		}

		public static void HostOnKill(EnemyHealth eh)
		{
			_kills++;
			if (Elites.TryGet(eh, out var _))
			{
				_elites++;
			}
			Check();
		}

		public static void HostOnBossKilled()
		{
			Check();
		}

		public static void HostOnDeath()
		{
			if (Game.InLevel())
			{
				_deaths++;
				Check();
			}
		}

		public static void HostOnBroken()
		{
			if (Game.InLevel())
			{
				_breaks++;
				Check();
			}
		}

		public static void HostOnExtracted(float value)
		{
			_extracted++;
			_bestCarried = Mathf.Max(_bestCarried, value);
			Check();
		}

		public static void HostOnLevelDone()
		{
			if (_state == 0)
			{
				Decide();
			}
			if (_state == 1 && _def != null)
			{
				switch (_def.id)
				{
				case "deathless":
				case "pacifist":
					Settle(won: true);
					break;
				case "blitz":
					Settle(Time.time - _liveAt <= (float)_target * 60f);
					break;
				case "big_haul":
				{
					RoundDirector instance = RoundDirector.instance;
					float num = (((Object)(object)instance != (Object)null) ? Num(instance, "totalHaul") : 0f);
					string how;
					float num2 = LevelGoal(instance, out how);
					float num3 = num2 * (float)_target / 100f;
					bool flag = num2 > 0f && num + 0.5f >= num3;
					Plugin.Log.LogInfo((object)($"[team contract] Big Haul judged: hauled ${num:N0} (the game's level total: every extraction, surplus included, with Drop Pad and Policy credit) " + string.Format("vs ${0:N0} needed = {1}% of ${2:N0} ({3}) -> {4}.", num3, _target, num2, how, flag ? "COMPLETE" : "FAILED")));
					Settle(flag);
					break;
				}
				default:
					Settle(won: false);
					break;
				}
			}
		}

		private static float LevelGoal(RoundDirector? rd, out string how)
		{
			float num = (((Object)(object)rd != (Object)null) ? Num(rd, "haulGoal") : 0f);
			int num2 = (((Object)(object)rd != (Object)null) ? Mathf.RoundToInt(Num(rd, "extractionPoints")) : 0);
			if (_goalCount > 0 && _goalCount >= num2 && _goalSum > 0f)
			{
				how = $"the sum of {_goalCount} extraction goals; the game's level goal is ${num:N0}";
				return _goalSum;
			}
			how = $"the game's level goal; {_goalCount}/{num2} extraction goals seen (${_goalSum:N0})";
			return Mathf.Max(num, _goalSum);
		}

		public static void HostExtractionStarting(RoundDirector rd)
		{
			float num = Num(rd, "extractionHaulGoal");
			if (num > 0f)
			{
				_goalSum += num;
				_goalCount++;
			}
		}

		public static void HostExtractionBanked(RoundDirector rd)
		{
			if (_def != null && !(_def.id != "big_haul"))
			{
				float num = Num(rd, "totalHaul");
				string how;
				float num2 = LevelGoal(rd, out how);
				Plugin.Log.LogInfo((object)(string.Format("[team contract] Big Haul ({0}): extraction {1}/{2} done, ", StateName(_state), Mathf.RoundToInt(Num(rd, "extractionPointsCompleted")), Mathf.RoundToInt(Num(rd, "extractionPoints"))) + string.Format("this extraction's goal ${0:N0}; hauled ${1:N0} of ${2:N0} needed ({3}% of ${4:N0}: {5}).", Num(rd, "extractionHaulGoal"), num, num2 * (float)_target / 100f, _target, num2, how)));
				Broadcast("");
			}
		}

		private static string StateName(int s)
		{
			return s switch
			{
				0 => "voting", 
				1 => "accepted", 
				4 => "declined", 
				2 => "complete", 
				3 => "failed", 
				_ => "-", 
			};
		}

		private static (float haul, float need) HaulProgress()
		{
			if (_def == null || _def.id != "big_haul")
			{
				return (haul: 0f, need: 0f);
			}
			RoundDirector instance = RoundDirector.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return (haul: 0f, need: 0f);
			}
			string how;
			return (haul: Num(instance, "totalHaul"), need: LevelGoal(instance, out how) * (float)_target / 100f);
		}

		private static float Num(object o, string field)
		{
			try
			{
				object obj = Game.Get<object>(o, field, null);
				return (obj == null) ? 0f : Convert.ToSingle(obj);
			}
			catch
			{
				return 0f;
			}
		}

		private static void Settle(bool won)
		{
			if (_state != 1 || _def == null)
			{
				return;
			}
			Plugin.Log.LogInfo((object)("[team contract] " + _def.name + ": " + (won ? "complete" : "failed") + "."));
			_state = (won ? 2 : 3);
			if (won)
			{
				PatchGuard.Run("run shape (team contract)", RunShape.HostTeamContractDone);
			}
			int num = Mathf.RoundToInt((float)(won ? _def.scrap : _def.loss) * _scale);
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && Participants.Contains(Game.ActorNumber(item)) && num > 0)
				{
					if (won)
					{
						Scrap.HostGrant(item, num, "Team contract");
					}
					else
					{
						Scrap.HostTake(item, num, "Team contract failed");
					}
				}
			}
			if (!won && _def.curse != "")
			{
				RunSave runSave = RpgRuntime.Instance?.HostRun;
				if (runSave != null)
				{
					runSave.curse = _def.curse;
					runSave.curseLevel = RunInfo.LevelIndex + 1;
					RpgRuntime.Instance?.MarkRunDirty();
				}
			}
			Broadcast(won ? ("Team contract complete: " + _def.name + "!") : ("Team contract failed: " + _def.name));
		}
	}
	internal static class TeamPlay
	{
		public enum Ev : byte
		{
			Carried,
			Clutch,
			Prevented,
			Taken,
			Healed,
			Kills,
			Elites,
			BetWon,
			Lures,
			CartValue,
			Restored,
			Scrap,
			Contracts,
			Rooms,
			Spotted,
			Broken,
			Revives,
			Dispatched,
			Fight,
			Count
		}

		public struct Entry
		{
			public string Title;

			public string Who;

			public string Detail;

			public string Cls;

			public int Actor;

			public int Level;

			public float Score;
		}

		private sealed class Candidate
		{
			public string Title = "";

			public string Detail = "";

			public int Actor;

			public float Score;

			public bool Joke;
		}

		private static readonly float[] Mine = new float[19];

		private static bool _dirty;

		private static float _nextSend;

		private static readonly Dictionary<int, float[]> HostStats = new Dictionary<int, float[]>();

		private static readonly Dictionary<int, float[]> Reported = new Dictionary<int, float[]>();

		private static readonly Dictionary<int, int> LastHolder = new Dictionary<int, int>();

		private static readonly Dictionary<int, int> CartOf = new Dictionary<int, int>();

		private static readonly HashSet<int> Credited = new HashSet<int>();

		private static float _nextHostTick;

		private static bool _cardSent;

		private static bool _finalHaul;

		private static float _allDoneAt = -1f;

		public static readonly (string title, string how)[] Pool = new(string, string)[20]
		{
			("Most valuable carried", "most value carried into an extraction ($2,000+)"),
			("Clutch revive", "the fastest revive after a death (under 30 s)"),
			("Untouchable", "no damage all level, $1,000+ carried"),
			("Most damage dodged", "most damage avoided by dodges, saves and reductions (50+)"),
			("Iron wall", "most damage taken and still standing (100+)"),
			("Field medic", "most health healed on teammates (60+)"),
			("Monster slayer", "most monsters finished off (3+)"),
			("Elite hunter", "took down an elite"),
			("Biggest bet won", "largest Double or Nothing payout"),
			("Pied piper", "most monsters lured by Echo or Decoy Beacon (5+)"),
			("Cart MVP", "most value moved by a cart you pushed ($2,000+)"),
			("Restoration", "most value restored or insured ($500+)"),
			("Scrap tycoon", "most Scrap earned (10+)"),
			("Contract closer", "most contracts completed"),
			("Explorer", "first into the most rooms (4+)"),
			("Team player", "longest time with a synergy on (1 min+)"),
			("Sharp eyes", "most monsters spotted by Watchposts (5+)"),
			("Express delivery", "most valuables sent by Dispatch (2+)"),
			("Fight promoter", "the biggest monster fight you started (100+ damage)"),
			("Butterfingers", "most value lost to breaks ($1,000+, only when few others qualify)")
		};

		private static List<Entry>? _shopCard;

		private static float _shopCardEnds = -1f;

		private static float _shopLiveAt = -1f;

		private static int _shopSentFor = -1;

		private static readonly Dictionary<int, float> DiedAt = new Dictionary<int, float>();

		public static void Add(Ev e, float amount)
		{
			if (!(amount <= 0f) && Game.InLevel())
			{
				Mine[(uint)e] += amount;
				_dirty = true;
			}
		}

		public static void Best(Ev e, float value)
		{
			if (Game.InLevel() && !(value <= Mine[(uint)e]))
			{
				Mine[(uint)e] = value;
				_dirty = true;
			}
		}

		public static void TickClient(float now)
		{
			if (!_dirty || now < _nextSend)
			{
				return;
			}
			_dirty = false;
			_nextSend = now + 5f;
			PlayerAvatar val = Game.LocalPlayer();
			if (!((Object)(object)val == (Object)null))
			{
				if (Game.IsMaster())
				{
					Report(Game.ActorNumber(val), (float[])Mine.Clone());
				}
				else
				{
					Net.SendHighlightStats((float[])Mine.Clone());
				}
			}
		}

		private static float[] HostRow(int actor)
		{
			if (!HostStats.TryGetValue(actor, out float[] value))
			{
				value = (HostStats[actor] = new float[19]);
			}
			return value;
		}

		public static void HostAdd(int actor, Ev e, float amount)
		{
			if ((actor > 0 || !Game.IsMultiplayer()) && !(amount <= 0f) && Game.IsMaster() && Game.InLevel())
			{
				HostRow(actor)[(uint)e] += amount;
				if (e == Ev.Lures)
				{
					Crafting.HostLures(actor, HostRow(actor)[(uint)e]);
				}
			}
		}

		public static void HostBest(int actor, Ev e, float value)
		{
			if ((actor > 0 || !Game.IsMultiplayer()) && Game.IsMaster() && Game.InLevel())
			{
				float[] array = HostRow(actor);
				if (value > array[(uint)e])
				{
					array[(uint)e] = value;
				}
			}
		}

		public static void Report(int actor, float[] values)
		{
			if (Game.IsMaster() && values != null)
			{
				float[] array = new float[19];
				for (int i = 0; i < array.Length && i < values.Length; i++)
				{
					array[i] = Mathf.Clamp(float.IsNaN(values[i]) ? 0f : values[i], 0f, 100000f);
				}
				Reported[actor] = array;
			}
		}

		public static void HostHeld(PhysGrabObject obj, int actor)
		{
			if (!((Object)(object)obj == (Object)null) && !((Object)(object)((Component)obj).GetComponent<ValuableObject>() == (Object)null))
			{
				LastHolder[((Object)obj).GetInstanceID()] = actor;
			}
		}

		public static void HostCartItem(PhysGrabObject obj, int actor)
		{
			if ((Object)(object)obj != (Object)null)
			{
				CartOf[((Object)obj).GetInstanceID()] = actor;
			}
		}

		public static void TickHost(float now)
		{
			if (!Game.IsMaster() || !Game.InLevel() || now < _nextHostTick)
			{
				return;
			}
			_nextHostTick = now + 1f;
			RoundDirector instance = RoundDirector.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return;
			}
			HostCreditHaul(instance);
			if (!_cardSent && Game.Get(instance, "allExtractionPointsCompleted", fallback: false))
			{
				if (_allDoneAt < 0f)
				{
					_allDoneAt = now;
				}
				if (_finalHaul)
				{
					HostSettleLevel("the last extraction's haul is in");
				}
				else if (now - _allDoneAt > 20f)
				{
					HostSettleLevel("fallback: the last extraction's haul wasn't seen within 20 s");
				}
			}
		}

		public static void HostFinalHaul()
		{
			_finalHaul = true;
			if (!_cardSent && Game.InLevel())
			{
				HostSettleLevel("the last extraction's haul is in");
			}
		}

		private static void HostSettleLevel(string why)
		{
			_cardSent = true;
			Plugin.Log.LogInfo((object)("[team contract] level done (" + why + "): settling the contracts."));
			PatchGuard.Run("team contract settle", TeamContracts.HostOnLevelDone);
			PatchGuard.Run("archivist level done", ResearchCrew.HostLevelDone);
			PatchGuard.Run("rival contracts", ContractHost.HostLevelDone);
			if (Plugin.Cfg.Highlights.Value)
			{
				PatchGuard.Run("highlights card", StoreLevel);
			}
		}

		public static void HostCreditHaul(RoundDirector rd)
		{
			List<GameObject> dollarHaulList = rd.dollarHaulList;
			if (dollarHaulList == null)
			{
				return;
			}
			foreach (GameObject item in dollarHaulList)
			{
				if ((Object)(object)item == (Object)null)
				{
					continue;
				}
				PhysGrabObject component = item.GetComponent<PhysGrabObject>();
				if ((Object)(object)component == (Object)null)
				{
					continue;
				}
				int instanceID = ((Object)component).GetInstanceID();
				if (Credited.Contains(instanceID))
				{
					continue;
				}
				ValuableObject component2 = item.GetComponent<ValuableObject>();
				float num = (((Object)(object)component2 != (Object)null) ? Game.Get(component2, "dollarValueCurrent", 0f) : 0f);
				if (num <= 0f)
				{
					continue;
				}
				Credited.Add(instanceID);
				TeamContracts.HostOnExtracted(num);
				if ((Object)(object)component2 != (Object)null)
				{
					Market.HostExtracted(component2, num);
				}
				if ((Object)(object)component2 != (Object)null)
				{
					ResearchSamples.HostExtracted(component2);
				}
				if ((Object)(object)component2 != (Object)null)
				{
					FieldResearch.HostExtracted(component2);
				}
				if ((Object)(object)component2 != (Object)null && ResearchSamples.IsSample(component2))
				{
					ResearchCrew.HostSampleOut(instanceID, LastHolder.TryGetValue(instanceID, out var value) ? value : int.MinValue);
				}
				RunShape.HostExtracted(num);
				if (LastHolder.TryGetValue(instanceID, out var value2))
				{
					HostRow(value2)[0] += num;
					int ca = value2;
					float cv = num;
					ValuableObject cvo = component2;
					PatchGuard.Run("contract carry", delegate
					{
						ContractHost.HostCarried(ca, cv, cvo);
					});
				}
				if (CartOf.TryGetValue(instanceID, out var value3))
				{
					HostRow(value3)[9] += num;
				}
			}
		}

		public static float HostValue(int actor, Ev e)
		{
			return Val(actor, e);
		}

		private static float Val(int actor, Ev e)
		{
			float num = 0f;
			if (HostStats.TryGetValue(actor, out float[] value))
			{
				num += value[(uint)e];
			}
			if (Reported.TryGetValue(actor, out float[] value2))
			{
				num += value2[(uint)e];
			}
			return num;
		}

		private static void StoreLevel()
		{
			RunSave runSave = RpgRuntime.Instance?.HostRun;
			if (runSave == null)
			{
				return;
			}
			int level = RunInfo.LevelIndex;
			runSave.highlights.RemoveAll((HighlightSave h) => h.level == level);
			foreach (Entry item in BuildCard(Mathf.Clamp(Plugin.Cfg.HighlightCount.Value, 1, 6)))
			{
				runSave.highlights.Add(new HighlightSave
				{
					title = item.Title,
					who = item.Who,
					detail = item.Detail,
					cls = item.Cls,
					actor = item.Actor,
					level = level,
					score = item.Score
				});
			}
			if (runSave.highlights.Count > 60)
			{
				runSave.highlights.RemoveRange(0, runSave.highlights.Count - 60);
			}
			RpgRuntime.Instance?.MarkRunDirty();
			Plugin.Log.LogInfo((object)$"[highlights] level {level + 1}: {runSave.highlights.FindAll((HighlightSave h) => h.level == level).Count} highlight(s) kept for the next shop.");
		}

		public static void HostShopTick()
		{
			if (!Game.IsMaster() || !Plugin.Cfg.Highlights.Value)
			{
				return;
			}
			if (!Game.InShopLevel() || Game.IsLoading())
			{
				_shopLiveAt = -1f;
				if (!Game.InShopLevel())
				{
					_shopCard = null;
					_shopSentFor = -1;
				}
				return;
			}
			float unscaledTime = Time.unscaledTime;
			if (_shopLiveAt < 0f)
			{
				_shopLiveAt = unscaledTime;
			}
			else
			{
				if (unscaledTime - _shopLiveAt < 2f || _shopSentFor == RunInfo.LevelIndex)
				{
					return;
				}
				_shopSentFor = RunInfo.LevelIndex;
				RunSave runSave = RpgRuntime.Instance?.HostRun;
				if (runSave != null && runSave.highlights.Count != 0)
				{
					List<Entry> list = Merge(runSave.highlights, Mathf.Clamp(Plugin.Cfg.HighlightCount.Value, 1, 6));
					runSave.highlights.Clear();
					RpgRuntime.Instance?.MarkRunDirty();
					if (list.Count != 0)
					{
						float num = Mathf.Clamp(Plugin.Cfg.HighlightSeconds.Value, 5f, 30f);
						_shopCard = list;
						_shopCardEnds = unscaledTime + num;
						Plugin.Log.LogInfo((object)$"[highlights] shop: card with {list.Count} highlight(s) for {num:0} s.");
						Net.SendHighlightCard(list, num);
					}
				}
			}
		}

		public static void OnPlayerEntered(int actor)
		{
			if (Game.IsMaster() && _shopCard != null)
			{
				float num = _shopCardEnds - Time.unscaledTime;
				if (num > 2f)
				{
					Net.SendHighlightCardTo(actor, _shopCard, num);
				}
			}
		}

		private static List<Entry> Merge(List<HighlightSave> all, int count)
		{
			List<HighlightSave> list = new List<HighlightSave>(all);
			list.Sort((HighlightSave a, HighlightSave b) => b.score.CompareTo(a.score));
			HashSet<int> hashSet = new HashSet<int>();
			HashSet<int> hashSet2 = new HashSet<int>();
			foreach (HighlightSave item in all)
			{
				hashSet.Add(item.level);
				hashSet2.Add(item.actor);
			}
			int num = ((hashSet2.Count >= count) ? 1 : 2);
			Dictionary<int, int> dictionary = new Dictionary<int, int>();
			HashSet<string> hashSet3 = new HashSet<string>();
			List<HighlightSave> list2 = new List<HighlightSave>();
			foreach (HighlightSave item2 in list)
			{
				if (list2.Count >= count)
				{
					break;
				}
				if (!hashSet3.Contains(item2.title))
				{
					dictionary.TryGetValue(item2.actor, out var value);
					if (value < num)
					{
						dictionary[item2.actor] = value + 1;
						hashSet3.Add(item2.title);
						list2.Add(item2);
					}
				}
			}
			foreach (HighlightSave item3 in list)
			{
				if (list2.Count >= count)
				{
					break;
				}
				if (!list2.Contains(item3) && !hashSet3.Contains(item3.title))
				{
					hashSet3.Add(item3.title);
					list2.Add(item3);
				}
			}
			List<Entry> list3 = new List<Entry>();
			foreach (HighlightSave item4 in list2)
			{
				list3.Add(new Entry
				{
					Title = item4.title,
					Who = item4.who,
					Detail = ((hashSet.Count > 1) ? $"{item4.detail} (level {item4.level + 1})" : item4.detail),
					Cls = item4.cls,
					Actor = item4.actor,
					Level = item4.level,
					Score = item4.score
				});
			}
			return list3;
		}

		internal static List<Entry> BuildCard(int count)
		{
			List<PlayerAvatar> players = Game.Players();
			List<Candidate> cands = new List<Candidate>();
			Top("Most valuable carried", Ev.Carried, 2000f, (float v) => $"${v:N0} carried to extraction");
			Top("Clutch revive", Ev.Clutch, 60f, (float v) => $"revived a teammate in {Mathf.Max(1f, 90f - v):0} s");
			Top("Most damage dodged", Ev.Prevented, 50f, (float v) => $"{v:0} damage avoided");
			Top("Field medic", Ev.Healed, 60f, (float v) => $"{v:0} HP healed on teammates");
			Top("Monster slayer", Ev.Kills, 3f, (float v) => $"{v:0} monsters finished off");
			Top("Elite hunter", Ev.Elites, 1f, (float v) => (!(v >= 2f)) ? "took down an elite" : $"{v:0} elites down");
			Top("Biggest bet won", Ev.BetWon, 1f, (float v) => $"Double or Nothing paid ${v:N0}");
			Top("Pied piper", Ev.Lures, 5f, (float v) => $"{v:0} monsters lured away");
			Top("Cart MVP", Ev.CartValue, 2000f, (float v) => $"${v:N0} moved by cart");
			Top("Restoration", Ev.Restored, 500f, (float v) => $"${v:N0} of value restored or insured");
			Top("Scrap tycoon", Ev.Scrap, 10f, (float v) => $"{v:0} Scrap earned");
			Top("Contract closer", Ev.Contracts, 1f, (float v) => string.Format("{0:0} contract{1} completed", v, (v >= 2f) ? "s" : ""));
			Top("Explorer", Ev.Rooms, 4f, (float v) => $"first into {v:0} rooms");
			Top("Sharp eyes", Ev.Spotted, 5f, (float v) => $"{v:0} monsters spotted");
			Top("Express delivery", Ev.Dispatched, 2f, (float v) => $"{v:0} valuables dispatched");
			Top("Fight promoter", Ev.Fight, 100f, (float v) => $"a monster fight worth {v:0} damage");
			Top("Butterfingers", Ev.Broken, 1000f, (float v) => $"${v:N0} lost to breaks", joke: true);
			int num = -1;
			int num2 = -1;
			int num3 = -1;
			float num4 = 0f;
			float num5 = 0f;
			float num6 = 0f;
			foreach (PlayerAvatar item in players)
			{
				if (!((Object)(object)item == (Object)null))
				{
					int num7 = Game.ActorNumber(item);
					float num8 = Val(num7, Ev.Taken);
					float num9 = Val(num7, Ev.Carried);
					float num10 = Synergies.SecondsOn(num7);
					if (Game.IsAlive(item) && num8 > num4)
					{
						num4 = num8;
						num = num7;
					}
					if (num10 > num5)
					{
						num5 = num10;
						num2 = num7;
					}
					if (num8 <= 0f && num9 > num6)
					{
						num6 = num9;
						num3 = num7;
					}
				}
			}
			if (num >= 0)
			{
				C("Iron wall", num, num4, 100f, $"took {num4:0} damage and walked out");
			}
			if (num2 >= 0)
			{
				C("Team player", num2, num5, 60f, $"{num5 / 60f:0.#} min with a synergy on");
			}
			if (num3 >= 0)
			{
				C("Untouchable", num3, num6, 1000f, $"not a scratch, ${num6:N0} carried");
			}
			cands.Sort((Candidate x, Candidate y) => y.Score.CompareTo(x.Score));
			int num11 = 0;
			foreach (PlayerAvatar item2 in players)
			{
				if ((Object)(object)item2 != (Object)null)
				{
					num11++;
				}
			}
			int num12 = ((num11 > 2) ? 1 : 2);
			if (num11 <= 1)
			{
				count = Mathf.Min(count, 3);
			}
			int num13 = 0;
			foreach (Candidate item3 in cands)
			{
				if (!item3.Joke)
				{
					num13++;
				}
			}
			Dictionary<int, int> dictionary = new Dictionary<int, int>();
			List<Candidate> list = new List<Candidate>();
			foreach (Candidate item4 in cands)
			{
				if (list.Count >= count)
				{
					break;
				}
				if (!item4.Joke || num13 < count)
				{
					dictionary.TryGetValue(item4.Actor, out var value);
					if (value < num12)
					{
						dictionary[item4.Actor] = value + 1;
						list.Add(item4);
					}
				}
			}
			if (list.Count < count)
			{
				foreach (Candidate item5 in cands)
				{
					if (list.Count >= count)
					{
						break;
					}
					if (!list.Contains(item5) && (!item5.Joke || num13 < count))
					{
						list.Add(item5);
					}
				}
			}
			List<Entry> list2 = new List<Entry>();
			foreach (Candidate item6 in list)
			{
				PlayerAvatar val = Find(item6.Actor, players);
				list2.Add(new Entry
				{
					Title = item6.Title,
					Detail = item6.Detail,
					Who = (((Object)(object)val != (Object)null) ? Account.Decorate(item6.Actor, Game.Get(val, "playerName", "?")) : "?"),
					Cls = (((Object)(object)val != (Object)null) ? ClassStats.ClassOf(val) : ""),
					Actor = item6.Actor,
					Level = RunInfo.LevelIndex,
					Score = item6.Score
				});
			}
			return list2;
			void C(string title, int actor, float num14, float min, string detail, bool joke = false)
			{
				if (num14 >= min && min > 0f)
				{
					cands.Add(new Candidate
					{
						Title = title,
						Actor = actor,
						Score = num14 / min,
						Detail = detail,
						Joke = joke
					});
				}
			}
			void Top(string title, Ev e, float min, Func<float, string> detail, bool joke = false)
			{
				int num14 = -1;
				float num15 = 0f;
				foreach (PlayerAvatar item7 in players)
				{
					if (!((Object)(object)item7 == (Object)null))
					{
						int num16 = Game.ActorNumber(item7);
						float num17 = Val(num16, e);
						if (num17 > num15)
						{
							num15 = num17;
							num14 = num16;
						}
					}
				}
				if (num14 >= 0)
				{
					C(title, num14, num15, min, detail(num15), joke);
				}
			}
		}

		private static PlayerAvatar? Find(int actor, List<PlayerAvatar> players)
		{
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player != (Object)null && Game.ActorNumber(player) == actor)
				{
					return player;
				}
			}
			return null;
		}

		public static void OnDied(PlayerAvatar? p)
		{
			if (!((Object)(object)p == (Object)null) && Game.InLevel())
			{
				DiedAt[Game.ActorNumber(p)] = Time.time;
				if ((Object)(object)p == (Object)(object)Game.LocalPlayer())
				{
					RpgRuntime.Instance?.OnLocalDiedTeam();
				}
			}
		}

		public static void OnRevived(PlayerAvatar? p)
		{
			if ((Object)(object)p != (Object)null)
			{
				DiedAt.Remove(Game.ActorNumber(p));
			}
		}

		public static float DownSeconds(PlayerAvatar? p)
		{
			if (!((Object)(object)p != (Object)null) || !DiedAt.TryGetValue(Game.ActorNumber(p), out var value))
			{
				return -1f;
			}
			return Time.time - value;
		}

		public static float ClutchBonus(float downFor)
		{
			if (downFor < 0f)
			{
				return 0f;
			}
			float num = Mathf.Clamp(Plugin.Cfg.ClutchReviveBonus.Value, 0f, 200f);
			float num2 = num / 3f;
			if (downFor <= 20f)
			{
				return num;
			}
			if (downFor <= 45f)
			{
				return Mathf.Lerp(num, num2, (downFor - 20f) / 25f);
			}
			if (downFor <= 90f)
			{
				return Mathf.Lerp(num2, 0f, (downFor - 45f) / 45f);
			}
			return 0f;
		}

		public static void NewLevel()
		{
