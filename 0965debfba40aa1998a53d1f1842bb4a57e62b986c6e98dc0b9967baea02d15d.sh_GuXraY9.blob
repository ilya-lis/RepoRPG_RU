		}

		public static void Update(string? classColorHex, bool instant = false)
		{
			//IL_004b: Unknown result type (might be due to invalid IL or missing references)
			string text = classColorHex + "|" + VanillaStyle.Version;
			if (text != _key)
			{
				_key = text;
				Color? classAccent = null;
				Color value = default(Color);
				if (!string.IsNullOrEmpty(classColorHex) && ColorUtility.TryParseHtmlString(classColorHex, ref value))
				{
					classAccent = value;
				}
				_from = Cur;
				Target = Build(classAccent);
				Version++;
				_fadeStart = Time.unscaledTime;
				_fading = !instant && !Plugin.Cfg.ReducedEffects.Value;
				if (!_fading)
				{
					Cur = Target;
					FrameVersion++;
				}
			}
			if (_fading)
			{
				float num = Mathf.Clamp01((Time.unscaledTime - _fadeStart) / 0.25f);
				num = num * num * (3f - 2f * num);
				Cur = Lerp(_from, Target, num);
				FrameVersion++;
				if (num >= 1f)
				{
					_fading = false;
				}
			}
		}

