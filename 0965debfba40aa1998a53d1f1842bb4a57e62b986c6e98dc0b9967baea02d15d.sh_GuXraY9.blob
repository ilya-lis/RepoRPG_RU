			}
			if (st != to)
			{
				CartLog(pl, $"{st} -> {to} ({why})");
			}
		}

		private static string HudText(Pilot pl)
		{
			return pl.St switch
			{
				CartSt.Idle => pl.AwaitOwner ? "parked - push it or walk up to it" : (((Object)(object)pl.Owner != (Object)null) ? "ready to follow" : "idle"), 
				CartSt.Following => (pl.GoalHud != "") ? pl.GoalHud : "following", 
				CartSt.Paused => "paused (held)", 
				CartSt.Overdrive => "overdrive", 
				CartSt.Stuck => "stuck", 
				_ => "", 
			};
		}

		private void EndOverdrive(Pilot pl, string why)
		{
			if (pl.St != CartSt.Overdrive)
			{
				return;
			}
			object outcome;
			switch (why)
			{
			default:
				outcome = "failed";
				break;
			case "arrived":
			case "grabbed":
			case "stopped":
				outcome = "interrupted";
				break;
			}
			ProbeAbort(pl, (string)outcome, "Overdrive ended: " + why);
			PlayerAvatar owner = pl.Owner;
			bool flag = why == "arrived";
			if (flag && pl.Cargo.Count > 0)
			{
				ContractHost.ClsEv(owner, "cartwright");
			}
			SetState(pl, CartSt.Idle, "Overdrive ended: " + why, flag ? "parked at extraction" : ("overdrive ended (" + why + ")"));
			PlayerAvatar val = FollowOwnerOf(pl.Cart);
			if ((Object)(object)val == (Object)null)
			{
				pl.Remove = true;
				return;
			}
			pl.Owner = val;
			pl.FollowOff = false;
			pl.AwaitOwner = flag;
			if ((Object)(object)val != (Object)(object)owner)
			{
				pl.SentState = "";
				SendCartState(pl, HudText(pl));
			}
			CartLog(pl, "handed back to the follow passive of " + Game.Get(val, "playerName", "?") + (flag ? ", waiting at the extraction" : ""));
		}

		private PlayerAvatar? FollowOwnerOf(PhysGrabCart cart)
		{
			foreach (KeyValuePair<int, PhysGrabCart> item in _lastCart)
			{
				if ((Object)(object)item.Value != (Object)(object)cart || _followOff.Contains(item.Key))
				{
					continue;
				}
				foreach (PlayerAvatar item2 in Game.Players())
				{
					if ((Object)(object)item2 != (Object)null && Game.ActorNumber(item2) == item.Key && ClassStats.ClassOf(item2) == "cartwright" && ClassStats.Get(item2, "cartwright.follow") > 0f)
					{
						return item2;
					}
				}
			}
			return null;
		}

