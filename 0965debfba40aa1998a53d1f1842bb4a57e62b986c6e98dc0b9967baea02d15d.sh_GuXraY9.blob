		private static readonly Lazy<Func<bool>> ChatOpen = new Lazy<Func<bool>>(delegate
		{
			Type type = AccessTools.TypeByName("ChatManager");
			FieldInfo inst = ((type == null) ? null : AccessTools.Field(type, "instance"));
			FieldInfo active = ((type == null) ? null : AccessTools.Field(type, "chatActive"));
			FieldInfo state = ((type == null) ? null : AccessTools.Field(type, "chatState"));
			return (inst == null || (active == null && state == null)) ? ((Func<bool>)(() => false)) : ((Func<bool>)delegate
			{
				try
				{
					object value = inst.GetValue(null);
					if (value == null)
					{
						return false;
					}
					if (state != null)
					{
						object value2 = state.GetValue(value);
						if (value2 != null)
						{
							string text = value2.ToString();
							return text == "Active" || text == "Send";
						}
					}
					bool flag = default(bool);
					int num;
					if (active != null)
					{
						object value3 = active.GetValue(value);
						if (value3 is bool)
						{
							flag = (bool)value3;
							num = 1;
						}
						else
						{
							num = 0;
						}
					}
					else
					{
						num = 0;
					}
					return (byte)((uint)num & (flag ? 1u : 0u)) != 0;
				}
				catch
				{
					return false;
				}
			});
		});

