		public static void SendLateJoinAnnounce(string name, int where, int exceptActor)
		{
			RpgRuntime.Instance?.OnLateJoinAnnounce(name, where);
			if (!Online)
			{
				return;
			}
			Player[] playerListOthers = PhotonNetwork.PlayerListOthers;
			foreach (Player val in playerListOthers)
			{
				if (val != null && val.ActorNumber != exceptActor)
				{
					SendTo(60, new object[3]
					{
						(byte)5,
						name ?? "",
						where
					}, val.ActorNumber);
				}
			}
		}

