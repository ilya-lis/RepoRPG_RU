	internal static class Complexity
	{
		public static readonly string[] Names = new string[4] { "Unrated", "Easy", "Medium", "Hard" };

		public static readonly string[] Filters = new string[4] { "All", "Easy", "Medium", "Hard" };

		public static int Of(ClassDef c)
		{
			return Mathf.Clamp((c.complexity <= 0) ? 2 : c.complexity, 1, 3);
		}

		public static string Name(ClassDef c)
		{
			return Names[Of(c)];
		}

		public static string TipLine(ClassDef c)
		{
			if (!string.IsNullOrEmpty(c.complexityTip))
			{
				return Name(c) + ": " + c.complexityTip;
			}
			return Name(c);
		}
	}
	internal static class EffectsPrefs
	{
		public static ConfigEntry<bool>? Open;

		public static void Bind(ConfigFile c)
		{
			Open = c.Bind<bool>("Internal", "EffectsOpen", false, "Class tab: the Total Effects view was open last time (reopened with the menu; managed by the mod).");
		}

		public static bool Get()
		{
			if (Open != null)
			{
				return Open.Value;
			}
			return false;
		}

		public static void Set(bool on)
		{
			if (Open == null || Open.Value == on)
			{
				return;
			}
			try
			{
				SettingsSync.SaveLocalChange(delegate
				{
					Open.Value = on;
				});
			}
			catch
			{
			}
		}
	}
