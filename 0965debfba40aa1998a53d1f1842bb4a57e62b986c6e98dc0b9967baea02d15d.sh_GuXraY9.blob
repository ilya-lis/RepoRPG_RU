		internal void OnBorrowListC(string[] list)
		{
			_borrowOpts.Clear();
			_borrowGot = true;
			HashSet<string> hashSet = new HashSet<string>();
			foreach (string text in list)
			{
				if (text == null)
				{
					continue;
				}
				int num = text.IndexOf('|');
				if (num < 0)
				{
					continue;
				}
				string text2 = text.Substring(0, num);
				string[] array = text.Substring(num + 1).Split(',');
				foreach (string text3 in array)
				{
					ResearchDef researchDef = Research.Def(text3);
					if (researchDef != null && !(researchDef.scope != "you") && researchDef.built && !Research.Done(text3) && !(text3 == "lab_network") && !(text3 == "parallel_lab") && hashSet.Add(text3) && _borrowOpts.Count < 12)
					{
						_borrowOpts.Add((text3, (text2.Length > 24) ? text2.Substring(0, 24) : text2));
					}
				}
			}
		}

