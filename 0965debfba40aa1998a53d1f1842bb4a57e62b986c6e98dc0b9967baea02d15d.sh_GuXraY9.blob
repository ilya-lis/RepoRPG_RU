			//IL_0132: Unknown result type (might be due to invalid IL or missing references)
			//IL_0141: Unknown result type (might be due to invalid IL or missing references)
			//IL_018f: Unknown result type (might be due to invalid IL or missing references)
			//IL_019e: Unknown result type (might be due to invalid IL or missing references)
			//IL_01a6: Unknown result type (might be due to invalid IL or missing references)
			//IL_01e4: Unknown result type (might be due to invalid IL or missing references)
			//IL_0200: Unknown result type (might be due to invalid IL or missing references)
			//IL_020f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0263: Unknown result type (might be due to invalid IL or missing references)
			//IL_0272: Unknown result type (might be due to invalid IL or missing references)
			//IL_023d: Unknown result type (might be due to invalid IL or missing references)
			//IL_024b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0293: Unknown result type (might be due to invalid IL or missing references)
			Event current = Event.current;
			if (!current.isKey)
			{
				return;
			}
			if ((int)current.type == 5)
			{
				_held.Remove(current.keyCode);
			}
			else
			{
				if (NumEditKey(current) || SearchKey(current) || (int)current.type != 4 || (int)current.keyCode == 0)
				{
					return;
				}
				float unscaledTime = Time.unscaledTime;
				float value;
				bool num = _held.Contains(current.keyCode) && _keyDownAt.TryGetValue(current.keyCode, out value) && unscaledTime - value < 1.1f;
				_keyDownAt[current.keyCode] = unscaledTime;
				if (num)
				{
					return;
				}
				_held.Add(current.keyCode);
				if (current.keyCode == Plugin.Cfg.AbilityKey.Value)
				{
					AbilityDiag($"key {current.keyCode} pressed (menu open {_menuOpen}, chat open {ChatOpen.Value()})");
				}
				if (_menuOpen && CaptureKey(current.keyCode))
				{
					current.Use();
				}
				else if (ChatOpen.Value())
				{
					if (current.keyCode == Plugin.Cfg.MenuKey.Value && !_toldChatBlocks)
					{
						_toldChatBlocks = true;
						Plugin.Log.LogInfo((object)"[menu] the menu key was ignored: the game's chat is open (typing).");
					}
				}
				else if (current.keyCode == Plugin.Cfg.MenuKey.Value)
				{
					SetMenuOpen(!_menuOpen);
				}
				else if (current.keyCode == Plugin.Cfg.NoticeCycleKey.Value && (int)current.keyCode != 0 && !_dialogOpen)
				{
					CycleNotice();
					if (_menuOpen)
					{
						current.Use();
					}
				}
				else if (SearchShortcutKey(current))
				{
					current.Use();
				}
				else if (_menuOpen && TabNumberKey(current.keyCode))
				{
					current.Use();
				}
				else if (_menuOpen && current.keyCode == Plugin.Cfg.MenuUndoKey.Value && !_dialogOpen && _rebind == Rebind.None)
				{
					UndoLast();
					current.Use();
				}
				else if (_menuOpen && IsMenuKey(current.keyCode))
				{
					OnMenuKey(current.keyCode, current.shift);
					current.Use();
				}
				else if (current.keyCode == Plugin.Cfg.AbilityKey.Value && !_menuOpen)
				{
					_abilityKeyQueued = true;
				}
				else if (!_menuOpen)
				{
					OnClassKey(current.keyCode);
				}
			}
		}

