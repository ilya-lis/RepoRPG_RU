				}
				else
				{
					HostBroadcast();
				}
			}
		}

		private static void Decide(TeamRunSave t)
		{
			if (t.voteFor == 0 || t.voteOptions.Count == 0)
			{
				return;
			}
			int[] array = new int[t.voteOptions.Count];
			foreach (int value in Votes.Values)
			{
				if (value >= 0 && value < array.Length)
				{
					array[value]++;
				}
			}
			int num = 0;
			for (int i = 1; i < array.Length; i++)
			{
				if (array[i] > array[num])
				{
					num = i;
				}
			}
			List<int> list = new List<int>();
			for (int j = 0; j < array.Length; j++)
			{
				if (array[j] == array[num])
				{
					list.Add(j);
				}
			}
			int num2 = ((list.Count == 1) ? num : list[new Random().Next(list.Count)]);
			if (Season.IsSeasonVote(t.voteFor))
			{
				bool flag = t.voteOptions[num2] == "season:ascend" && array[num2] > 0 && list.Count == 1 && !Game.InLevel();
				if (flag)
				{
					Ascension.Mine.nextPick = Mathf.Min(20, Ascension.Level + 1);
					Account.MarkDirty();
					Account.SaveNow();
				}
				bool flag2 = (t.voteOptions[num2] == "season:end" || flag) && array[num2] > 0 && list.Count == 1 && !Game.InLevel();
				t.endless = !flag2;
				t.complete = flag2;
				Plugin.Log.LogInfo((object)string.Format("[season] the team chose {0} ({1} of {2} vote(s)).", flag2 ? "End: the run is complete" : "Endless", array[num2], Votes.Count));
				t.voteFor = 0;
				t.voteOptions.Clear();
				t.voteFrom = "";
				Votes.Clear();
				_voteFor = 0;
				Dirty();
				HostBroadcast(flag2 ? "season|The run is complete. Back to the main menu in 15 s - well played!" : "season|Endless: the run goes on. Every chapter from here is a new record.");
				return;
			}
			string text = t.voteOptions[num2];
			while (t.boonFrom.Count < t.boons.Count)
			{
				t.boonFrom.Add("");
			}
			if (!t.boons.Contains(text))
			{
				t.boons.Add(text);
				t.boonFrom.Add(t.voteFrom);
			}
			Plugin.Log.LogInfo((object)string.Format("[run] boon vote ({0}): {1} ({2} of {3} vote(s){4}).", t.voteFrom, text, array[num2], Votes.Count, (list.Count > 1) ? ", tie broken at random" : ""));
			t.voteFor = 0;
			t.voteOptions.Clear();
			t.voteFrom = "";
			Votes.Clear();
			_voteFor = 0;
			Dirty();
			HostBroadcast("boon|Run boon: " + (Boon(text)?.name ?? text));
		}

		public static int HostTake(int actor, string steamId, int milestone, int choice)
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster() || steamId == "")
			{
				return -1;
			}
			string item = steamId + "|" + milestone;
			if (!team.owed.Remove(item))
			{
				return -1;
			}
			int num = 0;
			if (choice == 1)
			{
				PlayerAvatar val = ContractHost.PlayerOf(actor);
				num = PayoutFor(milestone);
				if ((Object)(object)val != (Object)null)
				{
					Scrap.HostGrant(val, num, $"Milestone {milestone} payout");
				}
				if ((Object)(object)val != (Object)null)
				{
					Totals(team, val).scrap += num;
				}
			}
			Plugin.Log.LogInfo((object)string.Format("[run] milestone {0} reward for {1}: {2}.", milestone, steamId, (choice == 1) ? $"{num} Scrap" : "a Unique"));
			Dirty();
			HostBroadcast();
			return num;
		}

