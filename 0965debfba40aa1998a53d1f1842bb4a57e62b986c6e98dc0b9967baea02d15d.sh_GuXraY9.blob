	internal static class Routes
	{
		public static RouteFile Data = new RouteFile();

		public const string Safe = "safe";

		private static readonly Dictionary<int, int> Votes = new Dictionary<int, int>();

		private static ModConfig C => Plugin.Cfg;

		public static bool On => C.RoutesOn.Value;

		public static float Luck
		{
			get
			{
				if (Game.InLevel())
				{
					RouteRewardDef routeRewardDef = RewardOn(RunInfo.LevelIndex);
					if (routeRewardDef != null && routeRewardDef.kind == "luck")
					{
						return Mathf.Clamp(routeRewardDef.value, 0f, 10f);
					}
				}
				return 0f;
			}
		}

		public static int VoteCount => Votes.Count;

		public static void Load()
		{
			try
			{
				Data = Json.Deserialize<RouteFile>(ClassDatabase.ReadWithOverride("routes", ClassDatabase.ReadEmbedded("routes"))) ?? new RouteFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("routes data parse error: " + ex.Message));
				Data = new RouteFile();
			}
			RouteFile data = Data;
			if (data.risks == null)
			{
				data.risks = Array.Empty<MapModifierDef>();
			}
			data = Data;
			if (data.rewards == null)
			{
				data.rewards = Array.Empty<RouteRewardDef>();
			}
			Plugin.Log.LogInfo((object)$"[routes] {Data.risks.Length} route risks, {Data.rewards.Length} route rewards.");
		}

		public static bool HasRoute(int levelIndex)
		{
			if (On && levelIndex > 0)
			{
				return !RunShape.IsMilestoneLevel(levelIndex);
			}
			return false;
		}

		public static MapModifierDef? Risk(string id)
		{
			MapModifierDef[] risks = Data.risks;
			foreach (MapModifierDef mapModifierDef in risks)
			{
				if (mapModifierDef != null && mapModifierDef.id == id)
				{
					return mapModifierDef;
				}
			}
			risks = RunDepth.Data.modifiers;
			foreach (MapModifierDef mapModifierDef2 in risks)
			{
				if (mapModifierDef2 != null && mapModifierDef2.id == id)
				{
					return mapModifierDef2;
				}
			}
			if (id == "expedition")
			{
				return FieldResearch.Expedition;
			}
			return null;
		}

		public static RouteRewardDef? Reward(string id)
		{
			RouteRewardDef[] rewards = Data.rewards;
			foreach (RouteRewardDef routeRewardDef in rewards)
			{
				if (routeRewardDef != null && routeRewardDef.id == id)
				{
					return routeRewardDef;
				}
			}
			return null;
		}

		public static (MapModifierDef? risk, RouteRewardDef? reward) Parse(string option)
		{
			if (option == "safe" || option == "")
			{
				return (risk: null, reward: null);
			}
			int num = option.IndexOf(':');
			if (num >= 0)
			{
				return (risk: Risk(option.Substring(0, num)), reward: Reward(option.Substring(num + 1)));
			}
			return (risk: Risk(option), reward: null);
		}

		public static string Name(string option)
		{
			if (option == "safe")
			{
				return "Safe Route";
			}
			if (option == "expedition")
			{
				return "Expedition";
			}
			var (mapModifierDef, routeRewardDef) = Parse(option);
			return (mapModifierDef?.name ?? "?") + " + " + (routeRewardDef?.name ?? "?");
		}

		public static string Text(string option)
		{
			if (option == "safe")
			{
				return "<b>Safe Route</b>\nNo risk, no extra reward: the level as usual.";
			}
			if (option == "expedition")
			{
				return "<b>Expedition</b>\n<color=#ff9a8a>Risk: monsters +20%, haul goal +10%</color>\n<color=#73ff66>Reward: 40% more valuables and twice the research samples</color>";
			}
			var (mapModifierDef, routeRewardDef) = Parse(option);
			return "<b>" + (mapModifierDef?.name ?? "?") + "</b>\n<color=#ff9a8a>Risk: " + (mapModifierDef?.risk ?? "?") + "</color>" + ((mapModifierDef != null && mapModifierDef.reward != "") ? ("\n<color=#9a9ca0>(" + mapModifierDef.reward + ")</color>") : "") + "\n<color=#73ff66>Reward: " + (routeRewardDef?.name ?? "?") + " - " + routeRewardDef?.desc + "</color>";
		}

		public static List<string> OffersFor(int levelIndex)
		{
			List<string> list = new List<string> { "safe" };
			List<MapModifierDef> list2 = new List<MapModifierDef>();
			MapModifierDef[] risks = Data.risks;
			foreach (MapModifierDef mapModifierDef in risks)
			{
				if (mapModifierDef != null && mapModifierDef.id != "")
				{
					list2.Add(mapModifierDef);
				}
			}
			risks = RunDepth.Data.modifiers;
			foreach (MapModifierDef mapModifierDef2 in risks)
			{
				if (mapModifierDef2 != null && mapModifierDef2.id != "" && RunDepth.UnlockedAt(mapModifierDef2.unlock, levelIndex) && FieldResearch.ModAllowed(mapModifierDef2))
				{
					list2.Add(mapModifierDef2);
				}
			}
			List<RouteRewardDef> list3 = new List<RouteRewardDef>();
			RouteRewardDef[] rewards = Data.rewards;
			foreach (RouteRewardDef routeRewardDef in rewards)
			{
				if (routeRewardDef != null && routeRewardDef.id != "")
				{
					list3.Add(routeRewardDef);
				}
			}
			if (list2.Count == 0 || list3.Count == 0)
			{
				return list;
			}
			Random random = RunInfo.RngFor(levelIndex * 9973 + 5);
			for (int j = 0; j < 2; j++)
			{
				if (list2.Count <= 0)
				{
					break;
				}
				if (list3.Count <= 0)
				{
					break;
				}
				MapModifierDef mapModifierDef3 = list2[random.Next(list2.Count)];
				list2.Remove(mapModifierDef3);
				float num = 0f;
				foreach (RouteRewardDef item in list3)
				{
					num += Mathf.Max(0.01f, item.weight);
				}
				double num2 = random.NextDouble() * (double)num;
				RouteRewardDef routeRewardDef2 = list3[list3.Count - 1];
				foreach (RouteRewardDef item2 in list3)
				{
					num2 -= (double)Mathf.Max(0.01f, item2.weight);
					if (num2 <= 0.0)
					{
						routeRewardDef2 = item2;
						break;
					}
				}
				list3.Remove(routeRewardDef2);
				list.Add(mapModifierDef3.id + ":" + routeRewardDef2.id);
			}
			if (FieldResearch.OfferExpedition() && list.Count >= 2)
			{
				list[list.Count - 1] = "expedition";
			}
			return list;
		}

		public static string ChosenFor(int levelIndex)
		{
			RunShape.State cur = RunShape.Cur;
			if (!On || cur.RouteFor != levelIndex || cur.RouteChosen < 0 || cur.RouteChosen >= cur.RouteOptions.Length)
			{
				return "";
			}
			return cur.RouteOptions[cur.RouteChosen];
		}

		public static bool ModsFromRoute(int levelIndex, List<MapModifierDef> into)
		{
			string text = ChosenFor(levelIndex);
			if (text == "")
			{
				return false;
			}
			MapModifierDef item = Parse(text).risk;
			if (item != null)
			{
				into.Add(item);
			}
			return true;
		}

		private static RouteRewardDef? RewardOn(int levelIndex)
		{
			string text = ChosenFor(levelIndex);
			if (!(text == ""))
			{
				return Parse(text).reward;
			}
			return null;
		}

		public static float ScrapMult(int playedLevel)
		{
			RouteRewardDef routeRewardDef = RewardOn(playedLevel);
			if (routeRewardDef == null || !(routeRewardDef.kind == "scrap"))
			{
				return 1f;
			}
			return Mathf.Clamp(routeRewardDef.value, 1f, 3f);
		}

		public static RouteRewardDef? ClearReward(int levelIndex)
		{
			RouteRewardDef routeRewardDef = RewardOn(levelIndex);
			if (routeRewardDef == null || (!(routeRewardDef.kind == "gear") && !(routeRewardDef.kind == "parts")))
			{
				return null;
			}
			return routeRewardDef;
		}

		public static bool Voted(int actor)
		{
			return Votes.ContainsKey(actor);
		}

		public static int[] Ballots()
		{
			return RunShape.Ballots(Votes);
		}

		public static void HostOpen(TeamRunSave t, int nextLevel)
		{
			Votes.Clear();
			if (!HasRoute(nextLevel))
			{
				t.routeFor = -1;
				t.routeOptions.Clear();
				t.routeChosen = -1;
			}
			else
			{
				t.routeFor = nextLevel;
				t.routeOptions.Clear();
				t.routeOptions.AddRange(OffersFor(nextLevel));
				t.routeChosen = ((t.routeOptions.Count > 1) ? (-1) : 0);
				Plugin.Log.LogInfo((object)string.Format("[routes] level {0}: route vote open - {1}.", nextLevel + 1, string.Join(", ", t.routeOptions.ConvertAll<string>(Name))));
			}
		}

		public static void HostVote(TeamRunSave t, int actor, int levelIndex, int option)
		{
			if (t.routeFor == levelIndex && t.routeChosen < 0 && option >= 0 && option < t.routeOptions.Count && !Game.InLevel())
			{
				Votes[actor] = option;
				if (Votes.Count >= Game.Players().Count)
				{
					HostDecide(t, "everyone voted");
				}
			}
		}

		public static bool HostDecide(TeamRunSave t, string why)
		{
			if (t.routeFor < 0 || t.routeChosen >= 0 || t.routeOptions.Count == 0)
			{
				return false;
			}
			int[] array = new int[t.routeOptions.Count];
			foreach (int value in Votes.Values)
			{
				if (value >= 0 && value < array.Length)
				{
					array[value]++;
				}
			}
			int num = 0;
			for (int i = 1; i < array.Length; i++)
			{
				if (array[i] > array[num])
				{
					num = i;
				}
			}
			t.routeChosen = num;
			Plugin.Log.LogInfo((object)$"[routes] level {t.routeFor + 1}: {Name(t.routeOptions[num])} ({array[num]} of {Votes.Count} vote(s), {why}).");
			Votes.Clear();
			return true;
		}

		public static void Reset()
		{
			Votes.Clear();
		}
	}
	[Serializable]
	public class DepthUnlockDef
	{
		public string id = "";

		public string kind = "";

		public string name = "";

		public string hint = "";

		public int level;
	}
	[Serializable]
	public class MapModifierDef
	{
		public string id = "";

		public string name = "";

		public string unlock = "";

		public string risk = "";

		public string reward = "";

		public float monsters = 1f;

		public float valuables = 1f;

		public float haul = 1f;

		public float elites = 1f;

		public float xp = 1f;

		public float scrap = 1f;

		public float contracts = 1f;

		public float valueDamage = 1f;

		public float stamina;

		public float eliteGear;

		public bool noExtractGear;

		public string research = "";
	}
	[Serializable]
	public class DepthFile
	{
		public int version = 1;

		public DepthUnlockDef[] unlocks = Array.Empty<DepthUnlockDef>();

		public MapModifierDef[] modifiers = Array.Empty<MapModifierDef>();
	}
	internal static class RunDepth
	{
		public static DepthFile Data = new DepthFile();

		private static readonly Dictionary<string, DepthUnlockDef> ById = new Dictionary<string, DepthUnlockDef>();

		private static int _modsFor = int.MinValue;

		private static int _modsSeed;

		private static readonly List<MapModifierDef> _mods = new List<MapModifierDef>();

		private static int _played = -1;

		private static string _modLine = "";

		private static int _modLineFor = int.MinValue;

		private static ModConfig C => Plugin.Cfg;

		public static bool Enabled => C.UnlocksOn.Value;

		public static List<MapModifierDef> LevelMods => ModsFor(RunInfo.LevelIndex);

		public static bool HasMods => LevelMods.Count > 0;

		public static float Monsters => Prod((MapModifierDef m) => m.monsters);

		public static float Valuables => Prod((MapModifierDef m) => m.valuables);

		public static float Haul => Prod((MapModifierDef m) => m.haul);

		public static float EliteChance => Prod((MapModifierDef m) => m.elites);

		public static float XpMult
		{
			get
			{
				if (!Game.InLevel())
				{
					return 1f;
				}
				return Prod((MapModifierDef m) => m.xp);
			}
		}

		public static float ScrapMult
		{
			get
			{
				List<MapModifierDef> list = ModsFor(_played);
				float num = 1f;
				foreach (MapModifierDef item in list)
				{
					num *= Mathf.Clamp(item.scrap, 0.1f, 4f);
				}
				ModsFor(RunInfo.LevelIndex);
				return num * Routes.ScrapMult(_played);
			}
		}

		public static float ContractMult => Prod((MapModifierDef m) => m.contracts);

		public static float ValueDamage
		{
			get
			{
				if (!Game.InLevel())
				{
					return 1f;
				}
				return Prod((MapModifierDef m) => m.valueDamage);
			}
		}

		public static float StaminaDrainPct
		{
			get
			{
				if (!Game.InLevel())
				{
					return 0f;
				}
				return Sum((MapModifierDef m) => m.stamina);
			}
		}

		public static float EliteGearChance
		{
			get
			{
				if (!Game.InLevel())
				{
					return 0f;
				}
				return Sum((MapModifierDef m) => m.eliteGear);
			}
		}

		public static bool NoExtractGear
		{
			get
			{
				if (!Game.InLevel())
				{
					return false;
				}
				foreach (MapModifierDef levelMod in LevelMods)
				{
					if (levelMod.noExtractGear)
					{
						return true;
					}
				}
				return false;
			}
		}

		public static void Load()
		{
			ById.Clear();
			try
			{
				Data = Json.Deserialize<DepthFile>(ClassDatabase.ReadWithOverride("unlocks", ClassDatabase.ReadEmbedded("unlocks"))) ?? new DepthFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("unlocks data parse error: " + ex.Message));
				Data = new DepthFile();
			}
			DepthFile data = Data;
			if (data.unlocks == null)
			{
				data.unlocks = Array.Empty<DepthUnlockDef>();
			}
			data = Data;
			if (data.modifiers == null)
			{
				data.modifiers = Array.Empty<MapModifierDef>();
			}
			DepthUnlockDef[] unlocks = Data.unlocks;
			foreach (DepthUnlockDef depthUnlockDef in unlocks)
			{
				if (depthUnlockDef != null && depthUnlockDef.id != "")
				{
					ById[depthUnlockDef.id] = depthUnlockDef;
				}
			}
			Plugin.Log.LogInfo((object)$"[depth] {ById.Count} deep-run unlocks, {Data.modifiers.Length} map modifiers.");
		}

		public static DepthUnlockDef? Def(string id)
		{
			if (!ById.TryGetValue(id ?? "", out DepthUnlockDef value))
			{
				return null;
			}
			return value;
		}

		public static int LevelOf(string id)
		{
			DepthUnlockDef depthUnlockDef = Def(id);
			if (depthUnlockDef == null || !Enabled)
			{
				return int.MaxValue;
			}
			return Mathf.Max(0, Mathf.RoundToInt((float)depthUnlockDef.level * Season.UnlockStretch) + Mathf.Clamp(C.UnlockShift.Value, -5, 10));
		}

		public static bool UnlockedAt(string id, int cleared)
		{
			if (!(id == ""))
			{
				return cleared >= LevelOf(id);
			}
			return true;
		}

		public static bool Unlocked(string id)
		{
			return UnlockedAt(id, RunInfo.LevelIndex);
		}

		public static List<DepthUnlockDef> OpeningAt(int cleared)
		{
			List<DepthUnlockDef> list = new List<DepthUnlockDef>();
			if (!Enabled)
			{
				return list;
			}
			DepthUnlockDef[] unlocks = Data.unlocks;
			foreach (DepthUnlockDef depthUnlockDef in unlocks)
			{
				if (depthUnlockDef != null && LevelOf(depthUnlockDef.id) == cleared)
				{
					list.Add(depthUnlockDef);
				}
			}
			return list;
		}

		public static List<MapModifierDef> ModsFor(int levelIndex)
		{
			int num = RunInfo.Seed * 7 + Mathf.RoundToInt(C.UnlockModChance.Value * 10f) + C.UnlockShift.Value * 131 + (Enabled ? 1 : 0) + Routes.ChosenFor(levelIndex).GetHashCode() * 17 + ((RunShape.Cur.RouteFor == levelIndex) ? (RunShape.Cur.RouteChosen * 7 + 3) : 0) + (Research.Lobby("new_hazards") ? 977 : 0);
			if (levelIndex == _modsFor && num == _modsSeed)
			{
				return _mods;
			}
			_modsFor = levelIndex;
			_modsSeed = num;
			_mods.Clear();
			if (Routes.ModsFromRoute(levelIndex, _mods))
			{
				return _mods;
			}
			if (Routes.On && RunShape.Cur.RouteFor == levelIndex && RunShape.Cur.RouteChosen < 0)
			{
				return _mods;
			}
			if (!Enabled || levelIndex < 0)
			{
				return _mods;
			}
			List<MapModifierDef> list = new List<MapModifierDef>();
			MapModifierDef[] modifiers = Data.modifiers;
			foreach (MapModifierDef mapModifierDef in modifiers)
			{
				if (mapModifierDef != null && UnlockedAt(mapModifierDef.unlock, levelIndex) && FieldResearch.ModAllowed(mapModifierDef))
				{
					list.Add(mapModifierDef);
				}
			}
			if (list.Count == 0)
			{
				return _mods;
			}
			Random random = RunInfo.RngFor(levelIndex * 7907 + 17);
			int num2 = (UnlockedAt("overtime", levelIndex) ? Mathf.Min(2, list.Count) : ((random.NextDouble() * 100.0 < (double)Mathf.Clamp(C.UnlockModChance.Value, 0f, 100f)) ? 1 : 0));
			for (int j = 0; j < num2; j++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = random.Next(list.Count);
				_mods.Add(list[index]);
				list.RemoveAt(index);
			}
			return _mods;
		}

		private static float Prod(Func<MapModifierDef, float> f)
		{
			float num = 1f;
			foreach (MapModifierDef levelMod in LevelMods)
			{
				num *= Mathf.Clamp(f(levelMod), 0.1f, 4f);
			}
			return num;
		}

		private static float Sum(Func<MapModifierDef, float> f)
		{
			float num = 0f;
			foreach (MapModifierDef levelMod in LevelMods)
			{
				num += f(levelMod);
			}
			return num;
		}

		public static void NoteLevelStart()
		{
			if (Game.InLevel())
			{
				_played = RunInfo.LevelIndex;
			}
		}

		public static string ModsLine()
		{
			int num = RunInfo.LevelIndex * 31 + _modsSeed;
			if (num == _modLineFor)
			{
				return _modLine;
			}
			_modLineFor = num;
			List<string> list = new List<string>();
			foreach (MapModifierDef levelMod in LevelMods)
			{
				list.Add(levelMod.name + " (" + levelMod.risk + "; " + levelMod.reward + ")");
			}
			_modLine = string.Join(" + ", list);
			return _modLine;
		}

		public static List<EliteMod> ElitePool()
		{
			List<EliteMod> list = new List<EliteMod>(Elites.ModList);
			if (Unlocked("brutish"))
			{
				list.Add(EliteMod.Brutish);
			}
			if (Unlocked("vampiric"))
			{
				list.Add(EliteMod.Vampiric);
			}
			if (Unlocked("juggernaut"))
			{
				list.Add(EliteMod.Juggernaut);
			}
			if (Unlocked("shielded"))
			{
				list.Add(EliteMod.Shielded);
			}
			return list;
		}

		public static List<EliteMod> BossPool()
		{
			List<EliteMod> list = new List<EliteMod>(Elites.BossModList);
			foreach (EliteMod item in ElitePool())
			{
				if (!list.Contains(item))
				{
					list.Add(item);
				}
			}
			if (Unlocked("warlord"))
			{
				list.Add(EliteMod.Warlord);
			}
			return list;
		}

		public static bool TwinBosses(int levelIndex)
		{
			if (RunShape.IsMilestoneLevel(levelIndex))
			{
				return UnlockedAt("twinbosses", levelIndex);
			}
			return false;
		}

		public static bool UniqueAllowed(UniqueDef u)
		{
			if (!(u.unlock == ""))
			{
				if (!u.unlock.StartsWith("asc", StringComparison.Ordinal))
				{
					return Unlocked(u.unlock);
				}
				return Ascension.UniqueAllowed(u.unlock);
			}
			return true;
		}
	}
	internal static class RunInfo
	{
		private static string _sessionKey = "session-" + Guid.NewGuid().ToString("N").Substring(0, 8);

		private static float _nextRequest;

		private static string _liveKey = "";

		private static int _liveLevel;

		private static int _hostFreshToken;

		private static string _room = "";

		public static string Key { get; private set; } = "";

		public static int Seed { get; private set; }

		public static int LevelIndex { get; private set; }

		public static bool FromHost { get; private set; }

		public static int FreshToken { get; private set; }

		public static int ContractCount { get; private set; } = 3;

		public static string RunId { get; private set; } = "";

		public static string NotedSave { get; private set; } = "";

		public static event Action? Changed;

		public static void RefreshAsHost()
		{
			string text = "";
			try
			{
				FieldInfo fieldInfo = Game.Field(typeof(StatsManager), "saveFileCurrent");
				if (fieldInfo != null && (Object)(object)StatsManager.instance != (Object)null)
				{
					text = (fieldInfo.GetValue(StatsManager.instance) as string) ?? "";
				}
			}
			catch
			{
			}
			if (string.IsNullOrEmpty(text))
			{
				text = NotedSave;
			}
			string text2 = (string.IsNullOrEmpty(text) ? _sessionKey : text);
			int num = LocalLevelsCompleted();
			if ((Game.InLevel() || Game.InLobby() || Game.InShopLevel()) && !RunStore.IsTempKey(text2))
			{
				bool num2 = text2 == _liveKey && num == 0 && _liveLevel > 0;
				int liveLevel = _liveLevel;
				_liveKey = text2;
				_liveLevel = num;
				if (num2)
				{
					RunReset.HostNewRun(text2, $"levels completed went from {liveLevel} back to 0 in the same save");
				}
			}
			Set(text2, num, fromHost: true, _hostFreshToken, Plugin.Cfg.ContractsPerLevel.Value);
			SetRunId(RunStore.IsTempKey(text2) ? "" : SaveBook.RunIdFor(text2));
		}

		public static void NoteNewRun(string key)
		{
			_liveKey = key;
			_liveLevel = 0;
		}

		public static void SetRunId(string id)
		{
			if (id == null)
			{
				id = "";
			}
			if (!(id == RunId))
			{
				Plugin.Log.LogInfo((object)("[run] run id '" + RunId + "' -> '" + id + "' (save '" + Key + "')."));
				RunId = id;
				RunInfo.Changed?.Invoke();
			}
		}

		public static void NoteSave(string? name)
		{
			if (!string.IsNullOrEmpty(name))
			{
				NotedSave = name;
				if (Game.IsMaster())
				{
					RefreshAsHost();
				}
			}
		}

		public static void ForgetSave(string? name)
		{
			if (!string.IsNullOrEmpty(name) && NotedSave == name)
			{
				NotedSave = "";
			}
		}

		public static void CheckRoom()
		{
			string text = "";
			try
			{
				if (PhotonNetwork.InRoom)
				{
					string name = PhotonNetwork.CurrentRoom.Name;
					Player masterClient = PhotonNetwork.MasterClient;
					text = name + "/" + ((masterClient != null) ? new int?(masterClient.ActorNumber) : ((int?)null));
				}
			}
			catch
			{
			}
			if (!(text == _room))
			{
				_room = text;
				RpgRuntime.Instance?.SaveRunNow();
				Elites.Clear();
				ClassClaims.Reset();
				RunShape.Reset();
				Net.AskPicks();
				RpgRuntime.Instance?.ResendState();
				Scrap.ForgetLocal();
				SettingsSync.RestoreLocal();
				RpgRuntime.Instance?.ClearPendingBuys();
				NetReliability.ForgetReplies();
				Set("", 0, fromHost: false, 0, Plugin.Cfg.ContractsPerLevel.Value);
				SetRunId("");
			}
		}

		public static void OnRunReset()
		{
			_sessionKey = "session-" + Guid.NewGuid().ToString("N").Substring(0, 8);
			_hostFreshToken = new Random().Next(1, int.MaxValue);
			NotedSave = "";
		}

		public static void Set(string key, int levelIndex, bool fromHost, int freshToken, int contractCount)
		{
			bool num = key != Key || levelIndex != LevelIndex || fromHost != FromHost || freshToken != FreshToken;
			FreshToken = freshToken;
			ContractCount = Math.Max(0, Math.Min(7, contractCount));
			Key = key;
			Seed = StableHash(key);
			LevelIndex = Math.Max(0, levelIndex);
			FromHost = fromHost;
			if (num)
			{
				RunInfo.Changed?.Invoke();
			}
		}

		public static void EnsureClient()
		{
			if (!FromHost || !(Key != ""))
			{
				if (Time.unscaledTime >= _nextRequest)
				{
					_nextRequest = Time.unscaledTime + 5f;
					Net.RequestRunInfo();
				}
				if (Key == "")
				{
					Set("nohost", LocalLevelsCompleted(), fromHost: false, 0, Plugin.Cfg.ContractsPerLevel.Value);
				}
				else if (!FromHost && LocalLevelsCompleted() != LevelIndex)
				{
					Set(Key, LocalLevelsCompleted(), fromHost: false, 0, ContractCount);
				}
			}
		}

		public static int LocalLevelsCompleted()
		{
			try
			{
				return ((Object)(object)RunManager.instance != (Object)null) ? RunManager.instance.levelsCompleted : 0;
			}
			catch
			{
				return 0;
			}
		}

		public static int StableHash(string s)
		{
			uint num = 2166136261u;
			foreach (char c in s)
			{
				num ^= c;
				num *= 16777619;
			}
			return (int)num;
		}

		public static Random RngFor(int salt)
		{
			return new Random(Seed * 31 + salt);
		}
	}
	internal static class RunReset
	{
		private static string _lastFor = "";

		private static float _lastAt = -10f;

		public static void HostNewRun(string saveId, string why)
		{
			if (!Game.IsMaster() || RunInfo.Key != saveId || (saveId == _lastFor && Time.unscaledTime - _lastAt < 30f))
			{
				return;
			}
			_lastFor = saveId;
			_lastAt = Time.unscaledTime;
			PatchGuard.Run("run recap", RunShape.HostRunEnded);
			string text = SaveBook.StartNewRun(saveId);
			if (text == "")
			{
				return;
			}
			RunInfo.NoteNewRun(saveId);
			Plugin.Log.LogInfo((object)("[run] NEW RUN in save '" + saveId + "' (" + why + "): run id '" + text + "'. Every player's run progress and Scrap reset; account progress kept."));
			RunInfo.SetRunId(text);
			PatchGuard.Run("new run (run info)", Net.BroadcastRunInfo);
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					string text2 = Game.SteamId(item);
					if (text2 != "")
					{
						Scrap.HostSendBalance(text2, Game.ActorNumber(item));
					}
				}
			}
		}
	}
	internal enum StreakFail
	{
		Reset,
		Halve
	}
