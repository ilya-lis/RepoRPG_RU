		private float DebtXpMult
		{
			get
			{
				if (_debtDeaths <= 0)
				{
					return 1f;
				}
				return 1f + (float)_debtDeaths * Mathf.Max(0f, _stats.Custom("gear.debt_xp")) / 100f;
			}
		}

		public float BehindXpMult
		{
			get
			{
				if (CurrentProgress == null || !Game.IsMultiplayer() || RunShape.TeamLevel <= 0f)
				{
					_behind = false;
					return 1f;
				}
				float num = RunShape.TeamLevel - (float)CurrentProgress.level;
				if (num > 2f)
				{
					_behind = true;
				}
				else if (num <= 1f)
				{
					_behind = false;
				}
				if (!_behind)
				{
					return 1f;
				}
				return 1f + Mathf.Clamp(Plugin.Cfg.BehindXpBonus.Value, 0f, 100f) / 100f;
			}
		}

