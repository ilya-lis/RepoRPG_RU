			if (list != null && list.Count > 0 && (Object)(object)list[0] != (Object)null && (Object)(object)list[0].material != (Object)null)
			{
				text = ((Object)list[0].material).name.Replace(" (Instance)", "");
			}
			float mass = pl.Rb.mass;
			Plugin.Log.LogInfo((object)($"[cart speed] {pl.Mode} {((Object)pl.Cart).name}: target {pl.BaseSpeed:0.00} (top {pl.Top:0.00}) x load {LoadFactor(pl):0.00} x limit {pl.SpeedLimit:0.00}" + string.Format("{0} = want {1:0.00}; ramped {2:0.00} + boost {3:0.00} = sent {4:0.00}; ", (pl.Slow != "") ? (" [" + pl.Slow + "]") : "", want, pl.CurSpeed, pl.Boost, commanded) + $"actual {pl.Actual:0.00} m/s; dv {pl.LastDv:0.0} m/s2 (force ~{mass * pl.LastDv:0} N); accel {Accel(pl):0.0}/decel {Decel(pl):0.0}; " + $"cart mass {mass:0.#} + load {pl.LoadMass:0.#} ({pl.Cargo.Count} items); drag {Drag(pl.Rb):0.##}; wheels {text}; brakes off {pl.BrakesOff}" + ((pl.Mode == PilotMode.Follow && (Object)(object)pl.Owner != (Object)null) ? $"; Cartwright {pl.OwnerDist:0.0}m away at {PlayerSpeed(pl.Owner):0.0} m/s, sprint {SprintRef(pl.Owner):0.0}" : $"; sprint ref {SprintRef(pl.Owner):0.0}") + $"; path {pl.Index}/{pl.Path.Length}"));
		}

