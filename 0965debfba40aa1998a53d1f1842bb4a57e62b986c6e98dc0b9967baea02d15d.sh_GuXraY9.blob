		private void AskGearUp(GearItem g, EffectDef? line)
		{
			//IL_0025: Unknown result type (might be due to invalid IL or missing references)
			if (!GearUp.CanUpgrade(g, out string why))
			{
				Toast(why, Color.gray);
				return;
			}
			string key = GearUp.PriceKey(g);
			int amount = Shop.Price(ShopX.BasePrice(key));
			int[] parts = GearUp.PartsFor(g);
			StringBuilder stringBuilder = new StringBuilder();
			int lvl = g.up + 1;
			bool flag = line != null && GearUp.AddsLine(g);
			GearItem gearItem = new GearItem
			{
				slot = g.slot,
				rarity = g.rarity,
				unique = g.unique,
				cursed = g.cursed,
				cursedLines = g.cursedLines,
				hasBase = g.hasBase,
				sockets = g.sockets,
				effects = g.effects,
				upFx = g.upFx,
				upFxAt = g.upFxAt,
				upSteps = g.upSteps,
				up = g.up,
				modules = g.modules
			};
			GearUp.Apply(gearItem, flag ? line : null, 0);
			stringBuilder.Append($"<b>+{g.up} → +{lvl}</b>\n");
			for (int i = 0; i < g.effects.Length; i++)
			{
				EffectDef effectDef = g.effects[i];
				if (effectDef.StatIndex >= 0)
				{
					float num = GearUp.Shown(effectDef.value * GearUp.LineMult(g, i));
					float num2 = GearUp.Shown(effectDef.value * GearUp.LineMult(gearItem, i));
					stringBuilder.Append(StatInfo.Describe((Stat)effectDef.StatIndex, num));
					if (Mathf.Abs(num2 - num) > 0.001f)
					{
						stringBuilder.Append("  →  <color=#73ff66>" + StatInfo.Describe((Stat)effectDef.StatIndex, num2) + "</color>");
					}
					stringBuilder.Append('\n');
				}
			}
			EffectDef[] upFx = g.upFx;
			foreach (EffectDef effectDef2 in upFx)
			{
				if (effectDef2.StatIndex >= 0)
				{
					float num3 = GearUp.Shown(effectDef2.value * GearUp.UpMult(g, effectDef2));
					float num4 = GearUp.Shown(effectDef2.value * GearUp.UpMult(gearItem, effectDef2));
					stringBuilder.Append(StatInfo.Describe((Stat)effectDef2.StatIndex, num3));
					if (Mathf.Abs(num4 - num3) > 0.001f)
					{
						stringBuilder.Append("  →  <color=#73ff66>" + StatInfo.Describe((Stat)effectDef2.StatIndex, num4) + "</color>");
					}
					stringBuilder.Append('\n');
				}
			}
			if (flag && line.StatIndex >= 0)
			{
				stringBuilder.Append("<color=#73ff66>New line: " + StatInfo.Describe((Stat)line.StatIndex, line.value) + "</color>\n");
			}
			else if (GearUp.IsLineLevel(lvl))
			{
				stringBuilder.Append("<color=#ffd75a>No room for another line: every line gets stronger instead.</color>\n");
			}
			if (gearItem.sockets > g.sockets)
			{
				stringBuilder.Append("<color=#73ff66>+1 socket</color>\n");
			}
			stringBuilder.Append("\nKeeps its set, sockets and modules, attunement, and any Unique or cursed effect.\nCost: " + Scrap.Price(amount) + " and " + Crafting.Describe(parts));
			string uid = g.uid;
			EffectDef pick = line;
			AskConfirm($"UPGRADE {g.name.ToUpperInvariant()} TO +{lvl}?", stringBuilder.ToString(), "Upgrade", delegate
			{
				Buy(key, $"upgrade +{lvl} on {g.name}", ShopX.BasePrice(key), delegate
				{
					//IL_005c: Unknown result type (might be due to invalid IL or missing references)
					//IL_0108: Unknown result type (might be due to invalid IL or missing references)
					GearItem gearItem2 = _store.Data.FindItem(uid);
					if (gearItem2 == null || gearItem2.up != lvl - 1 || !CanAfford(parts))
					{
						Toast("The upgrade couldn't finish (item or parts changed) - nothing was upgraded", new Color(1f, 0.5f, 0.4f), 4f);
					}
					else
					{
						int[] parts2 = Parts;
						for (int k = 0; k < 4; k++)
						{
							parts2[k] -= parts[k];
						}
						GearUp.Apply(gearItem2, pick, _lastCharged);
						_upPickUid = "";
						_statsDirty = true;
						_store.MarkDirty();
						_store.SaveNow();
						MenuSound(UiSound.Confirm);
						Notify(PopupKind.Loot, "Upgraded: " + GearUp.Title(gearItem2), RarityCol(gearItem2));
						Plugin.Log.LogInfo((object)string.Format("[gear] upgraded {0} to +{1} ({2}, {3} Scrap, {4}).", gearItem2.name, gearItem2.up, (pick != null && gearItem2.upFx.Length != 0) ? ("new line " + gearItem2.upFx[gearItem2.upFx.Length - 1].stat) : ("lines +" + GearUp_Step() + "%"), _lastCharged, Crafting.Describe(parts)));
					}
				});
			});
		}

		private static float GearUp_Step()
		{
			return (GearX.Pack.upgrades ?? new GearUpgradeDef()).step;
		}

