		private static object[] Pack(PlayerScaling.Values v)
		{
			return new object[4]
			{
				(byte)1,
				v.Players,
				new float[8] { v.Monsters, v.Health, v.Damage, v.Valuables, v.Haul, v.Elites, v.Economy, v.Threat },
				v.BossExtra
			};
		}

		private static void OnPlayersMsg(int sender, object data)
		{
			if (IsFromHost(sender) && data is object[] array && array.Length >= 4 && array[0] is byte b && b == 1 && array[1] is int num && array[2] is float[] array2 && array2.Length >= 7 && array[3] is bool bossExtra)
			{
				PlayerScaling.FromHost(new PlayerScaling.Values
				{
					Players = Mathf.Clamp(num, 1, 20),
					Monsters = Cl(array2[0], 4f),
					Health = Cl(array2[1], 4f),
					Damage = Cl(array2[2], 4f),
					Valuables = Cl(array2[3], 4f),
					Haul = Cl(array2[4], 4f),
					Elites = Cl(array2[5], 4f),
					Economy = Cl(array2[6], 6f),
					BossExtra = bossExtra,
					Threat = ((array2.Length >= 8 && !float.IsNaN(array2[7])) ? Mathf.Clamp(array2[7], 0f, 20f) : RunThreat.Rating)
				});
			}
			static float Cl(float x, float hi)
			{
				if (!float.IsNaN(x))
				{
					return Mathf.Clamp(x, 0.25f, hi);
				}
				return 1f;
			}
		}

