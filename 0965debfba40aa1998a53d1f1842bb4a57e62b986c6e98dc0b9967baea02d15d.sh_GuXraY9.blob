			if (list.Count != 0)
			{
				Random random = new Random();
				CursedDef cursedDef = list[random.Next(list.Count)];
				GearItem gearItem = Cursed.Make(random, cursedDef);
				gearItem.freeValue = SalvageCalc.Gross(gearItem);
				GiveGear(gearItem, "boss");
				Plugin.Log.LogInfo((object)("[cursed] dropped for you: " + cursedDef.name + " (" + Gear.SlotName(cursedDef.slot) + ")."));
				Notify(PopupKind.Loot, "CURSED DROP: " + cursedDef.name + " - " + cursedDef.benefit + " But: " + cursedDef.curse, Cursed.Text, "cursed");
				Banner("CURSED: " + cursedDef.name.ToUpperInvariant(), Cursed.Text, 5f);
				MenuSound(UiSound.Error);
				if (Cursed.TryParsePos(at, out var pos))
				{
					ClassFx.Beam(pos, 14f, Cursed.Frame);
				}
			}
		}

