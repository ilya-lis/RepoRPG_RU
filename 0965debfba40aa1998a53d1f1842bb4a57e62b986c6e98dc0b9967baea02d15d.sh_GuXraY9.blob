				{
					_esLooked = true;
					_esType = Type.GetType("UnityEngine.EventSystems.EventSystem, UnityEngine.UI");
				}
				if (_esType == null)
				{
					return;
				}
				Object[] array = Resources.FindObjectsOfTypeAll(_esType);
				foreach (Object obj in array)
				{
					Behaviour val = (Behaviour)(object)((obj is Behaviour) ? obj : null);
					if (val != null && val.enabled)
					{
						Scene scene = ((Component)val).gameObject.scene;
						if (((Scene)(ref scene)).IsValid())
						{
							val.enabled = false;
							_esDisabled.Add(val);
