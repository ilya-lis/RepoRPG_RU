			//IL_0285: Unknown result type (might be due to invalid IL or missing references)
			//IL_0521: Unknown result type (might be due to invalid IL or missing references)
			if (TrySpectatorPingC())
			{
				return;
			}
			if (Current == null)
			{
				AbilityDiag("refused: no class");
				if (Game.ClassPickOpen())
				{
					Toast("Choose your class - " + (Pad.Connected ? "" : "press ") + MenuPrompt, Color.white);
				}
				return;
			}
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val == (Object)null || !Game.IsAlive(val))
			{
				AbilityDiag("refused: " + (((Object)(object)val == (Object)null) ? "no local player" : "you're dead"));
				return;
			}
			if (!Game.InLevel())
			{
				AbilityDiag("refused: not in a level (truck / shop / lobby)");
				Toast("Abilities only work during levels", Color.gray);
				return;
			}
			if (CooldownRemaining > 0f)
			{
				AbilityDiag($"refused: cooldown {CooldownRemaining:0.0}s");
				Toast($"{ActiveName()}: {CooldownRemaining:0}s", Color.gray);
				return;
			}
			if (Curse("hourglass") > 0f && Game.IsHoldingSomething())
			{
				AbilityDiag("refused: Hourglass Heart (holding something)");
				Toast("Hourglass Heart: empty your hands first", Cursed.Text);
				MenuSound(UiSound.Error);
				return;
			}
			AbilityDiag($"checks passed: {Current.id}, charges {_charges}/{MaxCharges}");
			ClassDef classDef = Current;
			float num = 1f;
			bool flag = false;
			if (Current.id == "mimic")
			{
				ClassDef classDef2 = MimicCopy();
				if (classDef2 == null)
				{
					Toast("Nothing copied yet - stay near a teammate", Color.gray);
					MenuSound(UiSound.Error);
					return;
				}
				classDef = classDef2;
				bool flag2 = _inspireFromAllies.speed > 0f || _inspireFromAllies.grip > 0f;
				bool num2 = ClassStat("mimic.cap_mirror") > 0f && _mirrorLevel != RunInfo.LevelIndex;
				num = Mathf.Clamp(ClassStat("mimic.copy_power") + ((flag2 && Synergies.Has(val, "understudy")) ? Synergies.V("understudy") : 0f), 10f, 100f) / 100f;
				if (num2)
				{
					num = 1f;
					_mirrorLevel = RunInfo.LevelIndex;
					Toast("Perfect Mirror: full-strength copy", ParseColor(Current.color));
				}
				flag = true;
			}
			_refundAfterUse = false;
			_inActive = true;
			bool flag3;
			try
			{
				flag3 = ExecuteActive(val, classDef.active, num, flag);
			}
			finally
			{
				_inActive = false;
			}
			if (!flag3)
			{
				AbilityDiag("refused by the ability itself (see the message)");
				_refundAfterUse = false;
				_rallyRefund = 0f;
				return;
			}
			_charges--;
			if (Current.id == "herald" && ClassStat("herald.cap_crescendo") > 0f && _inspire >= 99.9f && _crescendoLevel != RunInfo.LevelIndex)
			{
				_crescendoLevel = RunInfo.LevelIndex;
				_charges++;
				Toast("Crescendo: Rally Cry was free", ParseColor(Current.color));
			}
			AbilityDiag(string.Format("ran {0}{1}: charge spent, {2}/{3} left", classDef.active.name, flag ? $" (copy at {num:P0})" : "", _charges, MaxCharges) + (_refundAfterUse ? " - nothing to use it on, refunding" : ((UsesHost(classDef.active) && Game.IsMultiplayer() && !Game.IsMaster()) ? " - waiting for the host" : "")));
			_freshUsed = false;
			if (_cooldownEnd <= Time.time)
			{
				_cooldownEnd = Time.time + CooldownSeconds();
			}
			if (_refundAfterUse)
			{
				_refundAfterUse = false;
				_rallyRefund = 0f;
				RefundCharge();
				return;
			}
			if (_rallyRefund > 0f)
			{
				_cooldownEnd -= CooldownSeconds() * Mathf.Clamp(_rallyRefund, 0f, 90f) / 100f;
				_rallyRefund = 0f;
			}
			PatchGuard.Run("perk ability", PerkOnAbilityUsed);
			PatchGuard.Run("attribute ability", AttrOnAbilityUsed);
			PatchGuard.Run("gear ability", GearOnAbilityUsed);
			Toast(classDef.active.name + (flag ? " (copy)" : "") + "!" + ((MaxCharges > 1) ? $" ({_charges} left)" : ""), ParseColor(classDef.color));
			if (Game.IsMultiplayer() && !Game.IsMaster() && UsesHost(classDef.active))
			{
				_specialistPending = true;
			}
			else
			{
				RewardContracts(Contracts.Progress(_store.Data.contracts, "Specialist"));
				CEv("ability");
			}
			if (flag)
			{
				MimicAfterUse();
				if (CurrentId == "mimic")
				{
					CEv("cls.mimic", 1f, RunInfo.StableHash(classDef.id) | 1);
				}
			}
		}

		private static bool UsesHost(ActiveDef a)
		{
			ActionDef[] actions = a.actions;
			foreach (ActionDef actionDef in actions)
			{
				if (HostActions.Contains(actionDef.type))
				{
					return true;
				}
			}
			return false;
		}

		public void OnActionAcked()
		{
			AbilityDiag("host acknowledged the ability action");
			if (_specialistPending)
			{
				_specialistPending = false;
				RewardContracts(Contracts.Progress(_store.Data.contracts, "Specialist"));
				CEv("ability");
			}
		}

		private string ActiveName()
		{
			if (Current == null)
			{
				return "";
			}
			if (Current.id == "mimic")
			{
				ClassDef classDef = MimicCopy();
				if (classDef == null)
				{
					return Current.active.name;
				}
				return classDef.active.name + " (copy)";
			}
			return Current.active.name;
		}

