		public static AscensionSave Mine
		{
			get
			{
				AccountFile data;
				AccountFile accountFile = (data = Account.Data);
				if (data.ascension == null)
				{
					data.ascension = new AscensionSave();
				}
				AscensionSave ascension = accountFile.ascension;
				if (ascension.classBest == null)
				{
					ascension.classBest = new List<NodeRank>();
				}
				ascension = accountFile.ascension;
				if (ascension.rewarded == null)
				{
					ascension.rewarded = new List<int>();
				}
				return accountFile.ascension;
			}
		}

