		private void RefreshTradeLists()
		{
			RunSave data = _store.Data;
			_tradeItems.Clear();
			foreach (GearItem item in data.inventory)
			{
				if (item != null && Tradable(data, item))
				{
					_tradeItems.Add(item);
				}
			}
			_tradeMates.Clear();
			PlayerAvatar val = Game.LocalPlayer();
			foreach (PlayerAvatar item2 in Game.Players())
			{
				if ((Object)(object)item2 != (Object)null && (Object)(object)item2 != (Object)(object)val && Game.ActorNumber(item2) > 0)
				{
					_tradeMates.Add(item2);
				}
			}
			if (_tradeItem >= _tradeItems.Count)
			{
				_tradeItem = 0;
			}
			if (_tradeMate >= _tradeMates.Count)
			{
				_tradeMate = 0;
			}
		}

