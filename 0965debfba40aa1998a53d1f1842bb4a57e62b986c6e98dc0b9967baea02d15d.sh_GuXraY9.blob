			BehindXpBonus = c.Bind<float>("LateJoin", "BehindXpBonus", 25f, new ConfigDescription("Bonus XP (%) for a player whose class level is more than 2 below the team's average (e.g. after being dead for levels), until they're within 1 level.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
