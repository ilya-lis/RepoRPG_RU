					if (!(text == ""))
					{
						val2.GetWorldCorners(_hudCorners);
						Rect val3 = Rect.MinMaxRect(_hudCorners[0].x, _hudCorners[0].y, _hudCorners[2].x, _hudCorners[2].y);
						if (((Rect)(ref val3)).Overlaps(_cDiagPanelScreen))
						{
							_overlapParts.Add($"{((Object)val).name} (order {val.sortingOrder}) / {((Object)val2).name}: \"{((text.Length > 40) ? text.Substring(0, 40) : text)}\" at {((Rect)(ref val3)).x:0},{((Rect)(ref val3)).y:0} {((Rect)(ref val3)).width:0}x{((Rect)(ref val3)).height:0}");
						}
					}
				}
			}
			string text2 = string.Join("\n    ", _overlapParts);
			if (!(text2 == _overlapLast))
			{
				_overlapLast = text2;
				Plugin.Log.LogInfo((object)((text2 == "") ? $"[hud contracts] frame {frame}: no other UI text overlaps the panel" : $"[hud contracts] frame {frame}: other UI text overlapping the panel:\n    {text2}"));
			}
		}

		private static string TextOf(RectTransform rt)
		{
			Component[] components = ((Component)rt).GetComponents<Component>();
			foreach (Component val in components)
			{
				if ((Object)(object)val == (Object)null)
				{
					continue;
				}
				Behaviour val2 = (Behaviour)(object)((val is Behaviour) ? val : null);
				if (val2 != null && !val2.isActiveAndEnabled)
				{
					continue;
				}
				Type type = ((object)val).GetType();
				if (!type.Name.Contains("Text"))
				{
					continue;
				}
				PropertyInfo property = type.GetProperty("text");
				if (property == null || property.PropertyType != typeof(string))
				{
					continue;
				}
				try
				{
					string text = property.GetValue(val) as string;
					if (!string.IsNullOrEmpty(text))
					{
						return text.Replace('\n', ' ');
					}
				}
				catch
				{
				}
			}
			return "";
		}

