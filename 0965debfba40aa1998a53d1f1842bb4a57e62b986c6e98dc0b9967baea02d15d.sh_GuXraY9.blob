			return "<color=" + Hex(Perks.ColorOf(p)) + "><b>" + Perks.LabelOf(p).ToUpperInvariant() + "</b></color>" + ((p.tags.Length != 0) ? ("<color=#9a9ca0>  ·  " + Perks.TagLine(p) + "</color>") : "");
		}

