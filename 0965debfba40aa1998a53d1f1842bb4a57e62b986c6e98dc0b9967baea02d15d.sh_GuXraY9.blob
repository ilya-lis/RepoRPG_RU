		public void OnAllyBuff(AllyBuff b)
		{
			//IL_01f7: Unknown result type (might be due to invalid IL or missing references)
			if (b.Speed > 0f || b.Grip > 0f || b.Guard > 0f)
			{
				_buffs.Add(new TimedBuff
				{
					Speed = b.Speed,
					Grip = b.Grip,
					Guard = b.Guard,
					Until = Time.time + Mathf.Max(0.5f, b.Duration),
					Source = (b.Source ?? "")
				});
			}
			if (b.Source == "Rally Cry" && CurrentId == "brute" && Synergies.Has(Game.LocalPlayer(), "war_cry"))
			{
				for (int i = 0; i < Mathf.Clamp(Mathf.RoundToInt(Synergies.V("war_cry")), 0, 3); i++)
				{
					AddFrenzy();
				}
			}
			if (b.HealthPct > 0f)
			{
				_pendingHealthPct = b.HealthPct;
				_pendingHealthAt = Time.time + 0.6f;
			}
			if (b.StaminaPct > 0f)
			{
				PlayerController instance = PlayerController.instance;
				if ((Object)(object)instance != (Object)null)
				{
					float num = Game.Get(instance, "EnergyStart", 0f);
					float num2 = Game.Get(instance, "EnergyCurrent", 0f);
					Game.Set(instance, "EnergyCurrent", Mathf.Min(num, num2 + num * b.StaminaPct / 100f));
				}
			}
			if (!string.IsNullOrEmpty(b.Source) && (b.Speed > 0f || b.Guard > 0f || b.Grip > 0f))
			{
				Notify(PopupKind.Other, b.Source + ": " + BuffText(b.Speed, b.Grip, b.Guard), ParseColor(Current?.color ?? "#FFFFFF"), "buff:" + b.Source);
			}
		}

		private static string BuffText(float speed, float grip, float guard)
		{
			List<string> list = new List<string>();
			if (speed > 0f)
			{
				list.Add($"+{speed:0}% speed");
			}
			if (grip > 0f)
			{
				list.Add($"+{grip:0}% grip");
			}
			if (guard > 0f)
			{
				list.Add($"-{guard:0}% damage");
			}
			return string.Join(", ", list);
		}

		private void AddSelfBuff(AllyBuff b)
		{
			OnAllyBuff(b);
		}

		private void AddSelfDyn(Stat s, float v, float seconds)
		{
			_selfDyn.Add((s, v, Time.time + seconds));
		}

		private void TickNewClasses(PlayerAvatar local)
		{
			//IL_01c6: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d1: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d6: Unknown result type (might be due to invalid IL or missing references)
			//IL_01db: Unknown result type (might be due to invalid IL or missing references)
			float time = Time.time;
			string currentId = CurrentId;
			TickCartCharger(local);
			for (int num = _buffs.Count - 1; num >= 0; num--)
			{
				if (time >= _buffs[num].Until)
				{
					_buffs.RemoveAt(num);
				}
			}
			for (int num2 = _selfDyn.Count - 1; num2 >= 0; num2--)
			{
				if (time >= _selfDyn[num2].until)
				{
					_selfDyn.RemoveAt(num2);
				}
			}
			float num3 = 0f;
			float num4 = 0f;
			foreach (TimedBuff buff in _buffs)
			{
				num3 = Mathf.Max(num3, buff.Speed);
				num4 = Mathf.Max(num4, buff.Grip);
			}
			if (num3 > 0f)
			{
				_stats.AddDyn(Stat.MoveSpeed, num3);
				_stats.AddDyn(Stat.SprintSpeed, num3);
			}
			if (num4 > 0f)
			{
				_stats.AddDyn(Stat.GrabStrength, num4);
			}
			foreach (var item in _selfDyn)
			{
				_stats.AddDyn(item.stat, item.value);
			}
			if (_pendingHealthPct > 0f && time >= _pendingHealthAt)
			{
				ApplyPendingHealth(local);
			}
			if (time >= _nextNearCheck)
			{
				_nextNearCheck = time + 0.5f;
				_monsterNear = false;
				Game.EnemyList.Enumerator enumerator3 = Game.LivingEnemies().GetEnumerator();
				while (enumerator3.MoveNext())
				{
					Vector3 val = ((Component)enumerator3.Current).transform.position - ((Component)local).transform.position;
					if (((Vector3)(ref val)).sqrMagnitude < 100f)
					{
						_monsterNear = true;
						break;
					}
				}
				float num5 = 0f;
				float num6 = 0f;
				foreach (var (aura, num7) in NearbyAuras(local))
				{
					if (!(aura.Inspire <= 0f) && !(num7 > aura.InspireRadius))
					{
						num5 = Mathf.Max(num5, aura.InspireSpeed * aura.Inspire / 100f);
						num6 = Mathf.Max(num6, aura.InspireGrip * aura.Inspire / 100f);
					}
				}
				_inspireFromAllies = (speed: num5, grip: num6);
			}
			if (_inspireFromAllies.speed > 0f)
			{
				_stats.AddDyn(Stat.MoveSpeed, _inspireFromAllies.speed);
				_stats.AddDyn(Stat.SprintSpeed, _inspireFromAllies.speed);
			}
			if (_inspireFromAllies.grip > 0f)
			{
				_stats.AddDyn(Stat.GrabStrength, _inspireFromAllies.grip);
			}
			if (currentId != "bloodbound")
			{
				TickPactDrain(local);
			}
			if (currentId == "gambler" && time >= _gambleCheckAt)
			{
				_gambleCheckAt = time + 2f;
				EnsureGambleRoll();
			}
			switch (currentId)
			{
			case "herald":
				TickHerald(local);
				break;
			case "mimic":
				TickMimic(local);
				break;
			case "undertaker":
				TickUndertaker(local);
				break;
			case "physicist":
				_stats.AddDyn(Stat.ThrowStrength, ClassStat("physicist.throw"));
				break;
			case "bloodbound":
				TickBloodbound(local);
				break;
			}
			TickThirdWave(local, currentId);
			TickThreats(local);
			TickAltPassives(local, currentId, time);
		}

		private float NewClassDamageMult()
		{
			//IL_01ab: Unknown result type (might be due to invalid IL or missing references)
			//IL_01b0: Unknown result type (might be due to invalid IL or missing references)
			float num = 0f;
