		private static ConfigEntryBase? Entry(string key)
		{
			if (_byKey == null)
			{
				_byKey = new Dictionary<string, ConfigEntryBase>(StringComparer.OrdinalIgnoreCase);
				foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in ((BaseUnityPlugin)Plugin.Instance).Config)
				{
					_byKey[item.Key.Section + "/" + item.Key.Key] = item.Value;
				}
			}
			if (!_byKey.TryGetValue(key, out ConfigEntryBase value))
			{
				return null;
			}
			return value;
		}

		private static List<(ConfigEntryBase e, object?[] values)> Parsed()
		{
			if (_parsed != null)
			{
				return _parsed;
			}
			List<(ConfigEntryBase, object[])> list = new List<(ConfigEntryBase, object[])>();
			(string, string[])[] table = Table;
			for (int i = 0; i < table.Length; i++)
			{
				(string, string[]) tuple = table[i];
				string item = tuple.Item1;
				string[] item2 = tuple.Item2;
				ConfigEntryBase val = Entry(item);
				if (val != null)
				{
					object[] array = new object[Count];
					for (int j = 0; j < Count && j < item2.Length; j++)
					{
						array[j] = HostSettings.Parse(val, item2[j]);
					}
					list.Add((val, array));
				}
			}
			_parsed = list;
			return list;
		}

		public static void Validate()
		{
			int num = 0;
			(string, string[])[] table = Table;
			for (int i = 0; i < table.Length; i++)
			{
				(string, string[]) tuple = table[i];
				string item = tuple.Item1;
				string[] item2 = tuple.Item2;
				ConfigEntryBase val = Entry(item);
				if (val == null)
				{
					Plugin.Log.LogWarning((object)("[difficulty] preset table: no setting " + item + "."));
					num++;
					continue;
				}
				if (!SettingsSync.IsSynced(val.Definition))
				{
					Plugin.Log.LogWarning((object)("[difficulty] preset table: " + item + " isn't a host setting (not synced)."));
				}
				for (int j = 0; j < Count; j++)
				{
					if (j >= item2.Length || HostSettings.Parse(val, item2[j]) == null)
					{
						Plugin.Log.LogWarning((object)("[difficulty] preset table: " + Names[j] + " " + item + " = '" + ((j < item2.Length) ? item2[j] : "") + "' isn't allowed."));
						num++;
					}
				}
				object obj = ((item2.Length > 2) ? HostSettings.Parse(val, item2[2]) : null);
				if (obj != null && !object.Equals(obj, val.DefaultValue))
				{
					Plugin.Log.LogWarning((object)("[difficulty] preset table: Normal " + item + " = " + item2[2] + ", but its default is " + HostSettings.TomlOf(val, val.DefaultValue) + "."));
				}
			}
			if (num == 0)
			{
				Plugin.Log.LogInfo((object)$"[difficulty] {Count} presets, {Table.Length} settings each.");
			}
		}

		public static int LoadInto(int preset, Dictionary<ConfigEntryBase, object> pending)
		{
			preset = Mathf.Clamp(preset, 0, Count - 1);
			int num = 0;
			foreach (var item2 in Parsed())
			{
				ConfigEntryBase item = item2.e;
				object obj = item2.values[preset];
				if (obj != null)
				{
					if (object.Equals(obj, Effective(item)))
					{
						pending.Remove(item);
						continue;
					}
					pending[item] = obj;
					num++;
				}
			}
			ConfigEntry<DifficultyPreset> preset2 = Plugin.Cfg.Preset;
			object obj2 = (DifficultyPreset)preset;
			if (object.Equals(obj2, Effective((ConfigEntryBase)(object)preset2)))
			{
				pending.Remove((ConfigEntryBase)(object)preset2);
			}
			else
			{
				pending[(ConfigEntryBase)(object)preset2] = obj2;
			}
			Plugin.Log.LogInfo((object)$"[difficulty] {Names[preset]} loaded: {num} setting(s) change (pending until Apply).");
			return num;
		}

		private static object Effective(ConfigEntryBase e)
		{
			if (!HostSettings.IsScheduled(e, out object v))
			{
				return e.BoxedValue;
			}
			return v;
		}

		private static void Hook()
		{
			if (_hooked)
			{
				return;
			}
			_hooked = true;
			try
			{
				((BaseUnityPlugin)Plugin.Instance).Config.SettingChanged += delegate
				{
					_cfgVersion++;
				};
			}
			catch
			{
			}
		}

		private static void Refresh()
		{
			Hook();
			float unscaledTime = Time.unscaledTime;
			int scheduled = HostSettings.Scheduled;
			if (_seenVersion == _cfgVersion && _seenSync == SettingsSync.Version && _seenScheduled == scheduled && unscaledTime - _checkedAt < 2f)
			{
				return;
			}
			_checkedAt = unscaledTime;
			_seenVersion = _cfgVersion;
			_seenSync = SettingsSync.Version;
			_seenScheduled = scheduled;
			if (_customLabels == null)
			{
				_customLabels = new string[Count];
				_banners = new string[Count];
				_customBanners = new string[Count];
				for (int i = 0; i < Count; i++)
				{
					_customLabels[i] = "Custom (based on " + Names[i] + ")";
					_banners[i] = "Difficulty: " + Names[i];
					_customBanners[i] = "Difficulty: " + _customLabels[i];
				}
			}
			int num = Mathf.Clamp((int)Plugin.Cfg.Preset.Value, 0, Count - 1);
			if (HostSettings.IsScheduled((ConfigEntryBase)(object)Plugin.Cfg.Preset, out object v) && v is DifficultyPreset difficultyPreset)
			{
				num = (int)difficultyPreset;
			}
			bool flag = false;
			foreach (var item2 in Parsed())
			{
				ConfigEntryBase item = item2.e;
				object obj = item2.values[num];
				if (obj != null && !object.Equals(obj, Effective(item)))
				{
					flag = true;
					break;
				}
			}
			_base = num;
			_custom = flag;
			_label = (flag ? _customLabels[num] : Names[num]);
			_banner = (flag ? _customBanners[num] : _banners[num]);
		}

		public static int PendingPreset(Dictionary<ConfigEntryBase, object> pending)
		{
			if (pending.TryGetValue((ConfigEntryBase)(object)Plugin.Cfg.Preset, out object value) && value is DifficultyPreset)
			{
				return (int)(DifficultyPreset)value;
			}
			return -1;
		}
	}
	internal static class Elements
	{
		public struct Shown
		{
			public int ViewId;

			public byte Bits;

			public byte Burn;

			public byte Chill;

			public byte Rot;

			public byte Weaken;

			public bool Frozen;
		}

		public const int None = 0;

		public const int Fire = 1;

		public const int Shock = 2;

		public const int Frost = 3;

		public const int Rot = 4;

		public const int Void = 5;

		public static readonly string[] Names = new string[6] { "", "Fire", "Shock", "Frost", "Corrosive", "Void" };

		public static readonly string[] Status = new string[6] { "", "Burn", "Static", "Chill", "Rot", "Weaken" };

		public static readonly string[] Keys = new string[6] { "", "fire", "shock", "frost", "rot", "void" };

		public static readonly Color[] Colors = (Color[])(object)new Color[6]
		{
			Color.white,
			new Color(1f, 0.55f, 0.15f),
			new Color(1f, 0.92f, 0.3f),
			new Color(0.55f, 0.85f, 1f),
			new Color(0.45f, 0.95f, 0.35f),
			new Color(0.72f, 0.45f, 1f)
		};

		public static readonly Dictionary<int, int> PlayerElem = new Dictionary<int, int>();

		public static readonly List<Shown> Live = new List<Shown>();

		public static int Version;

		private static ModConfig C => Plugin.Cfg;

		public static bool On => C.ElementsOn.Value;

		public static float Strength => Mathf.Clamp(C.ElementStrength.Value, 0f, 300f) / 100f;

		public static int Of(PlayerAvatar? p)
		{
			if (!On || (Object)(object)p == (Object)null)
			{
				return 0;
			}
			for (int i = 1; i <= 5; i++)
			{
				if (ClassStats.Get(p, "shop.coat_" + Keys[i]) > 0f)
				{
					return i;
				}
			}
			for (int j = 1; j <= 5; j++)
			{
				if (ClassStats.Get(p, "gear.elem_mod_" + Keys[j]) > 0f)
				{
					return j;
				}
			}
			for (int k = 1; k <= 5; k++)
			{
				if (ClassStats.Get(p, "gear.elem_" + Keys[k]) > 0f)
				{
					return k;
				}
			}
			return 0;
		}

		public static string SourceOf(PlayerAvatar? p, int e)
		{
			if ((Object)(object)p == (Object)null || e == 0)
			{
				return "";
			}
			if (ClassStats.Get(p, "shop.coat_" + Keys[e]) > 0f)
			{
				return "coating";
			}
			if (ClassStats.Get(p, "gear.elem_mod_" + Keys[e]) > 0f)
			{
				return "module";
			}
			return "affix";
		}

		public static void ApplyPlayers(int[] actors, byte[] elems)
		{
			PlayerElem.Clear();
			for (int i = 0; i < actors.Length && i < elems.Length && i < 32; i++)
			{
				if (elems[i] > 0 && elems[i] <= 5)
				{
					PlayerElem[actors[i]] = elems[i];
				}
			}
		}

		public static (int resist, int weak) Affinity(int viewId, int tier)
		{
			if (!On || tier <= 0 || viewId == 0)
			{
				return (resist: 0, weak: 0);
			}
			Random random = RunInfo.RngFor(viewId * 2654435 + RunInfo.LevelIndex * 97 + 13);
			int num = 0;
			int num2 = 0;
			if (tier >= 3)
			{
				num = 1 + random.Next(5);
				num2 = 1 + random.Next(4);
				if (num2 >= num)
				{
					num2++;
				}
				return (resist: num, weak: num2);
			}
			if (random.NextDouble() < 0.4)
			{
				num = 1 + random.Next(5);
			}
			if (random.NextDouble() < 0.25)
			{
				num2 = 1 + random.Next(5);
				if (num2 == num)
				{
					num2 = num2 % 5 + 1;
				}
			}
			return (resist: num, weak: num2);
		}

		public static string AffinityText(int viewId, int tier)
		{
			var (num, num2) = Affinity(viewId, tier);
			return ((num > 0) ? (" · resists " + Names[num]) : "") + ((num2 > 0) ? (" · weak to " + Names[num2]) : "");
		}

		public static void Apply(int[] ids, byte[] packed)
		{
			Live.Clear();
			for (int i = 0; i < ids.Length && i * 5 + 4 < packed.Length && i < 64; i++)
			{
				Live.Add(new Shown
				{
					ViewId = ids[i],
					Bits = packed[i * 5],
					Burn = packed[i * 5 + 1],
					Chill = packed[i * 5 + 2],
					Rot = packed[i * 5 + 3],
					Weaken = packed[i * 5 + 4],
					Frozen = ((packed[i * 5] & 0x40) != 0)
				});
			}
			Version++;
		}

		public static float WeakenMult(int viewId)
		{
			if (!On || viewId == 0)
			{
				return 1f;
			}
			foreach (Shown item in Live)
			{
				if (item.ViewId == viewId)
				{
					return 1f - (float)Mathf.Clamp((int)item.Weaken, 0, 3) * 0.08f * Mathf.Clamp(Strength, 0f, 1.25f);
				}
			}
			return 1f;
		}

		public static string CoatingDesc(int e)
		{
			return e switch
			{
				1 => "Your weapon burns monsters for the next level (Burn: damage over time; the first one panics them).", 
				2 => "Your weapon shocks monsters for the next level (Static: a short stun, sometimes jumping to a second monster).", 
				3 => "Your weapon chills monsters for the next level (slower; enough hits in a row freeze them).", 
				4 => "Your weapon corrodes monsters for the next level (Rot: they take more damage from everything).", 
				5 => "Your weapon weakens monsters for the next level (Weaken: they hit you softer).", 
				_ => "", 
			};
		}
	}
