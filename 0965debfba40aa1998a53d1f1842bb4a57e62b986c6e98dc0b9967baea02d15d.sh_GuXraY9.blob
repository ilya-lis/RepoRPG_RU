			}
			return true;
		}

		internal static void OnTransitionStart(string what)
		{
			try
			{
				LateJoinHost.OnTransition();
			}
			catch
			{
			}
			_transitioning = true;
			_transitionAt = Time.unscaledTime;
			_sceneLoadedSinceTransition = false;
			RpgRuntime instance = Instance;
			if ((Object)(object)instance == (Object)null)
			{
				return;
			}
			instance._card = null;
			try
			{
				instance.CloseForTransition(what);
			}
			catch (Exception e)
			{
				Guard.Fail("menu transition close", e);
			}
		}

		private void CloseForTransition(string what)
		{
			_blockedNoticeShown = false;
			if (_menuOpen || _esDisabled.Count != 0)
			{
				if (AnyPending)
				{
					_discardedNotice = true;
				}
				ForceCloseMenu("a level transition started (" + what + ")");
				_searching = false;
				CancelNumEdit();
				_comparePick = null;
				Plugin.Log.LogInfo((object)("[menu] closed for a transition (" + what + ")."));
			}
		}

		private static void NoteSceneLoaded()
		{
			_sceneLoadedSinceTransition = true;
		}

		private void TickTransition()
		{
			//IL_0060: Unknown result type (might be due to invalid IL or missing references)
			if (_transitioning && ((_sceneLoadedSinceTransition && (!Game.InLevel() || Game.LevelReady())) || !(Time.unscaledTime - _transitionAt < 45f)))
			{
				_transitioning = false;
				if (_discardedNotice)
				{
					_discardedNotice = false;
					Toast("Unconfirmed changes were discarded when the level changed", new Color(1f, 0.75f, 0.45f), 5f);
				}
			}
		}

		private void MenuBlocked(string why)
