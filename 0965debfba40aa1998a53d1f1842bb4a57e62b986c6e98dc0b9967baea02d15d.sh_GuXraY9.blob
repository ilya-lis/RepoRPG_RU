			{
				GameDirector instance2 = GameDirector.instance;
				flag2 = (Object)(object)instance2 != (Object)null && (int)instance2.currentState == 2;
			}
			catch
			{
			}
			if (flag && flag2 && (Object)(object)Game.LocalPlayer() != (Object)null)
			{
				_ljJoining = false;
				Net.SendLateJoinReady();
				Plugin.Log.LogInfo((object)$"[late join] step 1/4: scene built after {num:0.0} s.");
				StartJoinWatch();
				return;
			}
			if ((Object)(object)instance != (Object)null && !flag && num > 3f && _ljAsks < 8 && Time.unscaledTime >= _ljNextAsk && !LateJoinHost.OtherModInstalled)
			{
				_ljAsks++;
				_ljNextAsk = Time.unscaledTime + 4f;
				Net.SendLateJoinNeedModules();
			}
			if (num > (Plugin.Cfg.ForceWaitTimeouts.Value ? 2f : 40f) && !_ljToldSlow)
			{
				_ljToldSlow = true;
				int num3 = 0;
				try
				{
					num3 = Object.FindObjectsByType<Module>((FindObjectsSortMode)0).Length;
				}
				catch
				{
				}
				Plugin.Log.LogWarning((object)($"[late join] the level is taking long to build here ({num:0} s): {num3} level modules here, generated: {flag}, game state live: {flag2}" + (LateJoinHost.OtherModInstalled ? ("; joining is handled by " + LateJoinHost.OtherModName + ", which rebuilds the level from the room.") : ".")));
				Toast("Still building the level... if it doesn't load, leave and join again in the truck or shop.", Color.white, 8f);
			}
		}

		private void StartJoinWatch()
		{
			_ljWatchUntil = (_ljWatchStart = Time.unscaledTime) + 30f;
			_ljWatchNext = 0f;
			_ljSpawnAskAt = 0f;
			_ljSpawnAsks = 0;
			_ljSawSpawn = (_ljToldBlock = (_ljToldSettings = (_ljToldData = (_ljToldSnap = false))));
			StartUnstickWatch("a late join", 90f);
			ForceCloseMenu("late join: the player starts free to move");
			TrackedField[] allTracked = AllTracked;
			for (int i = 0; i < allTracked.Length; i++)
			{
				allTracked[i].Restore();
			}
			SprintDrain.RpgMult = 1f;
			SprintDrain.FloorExempt = false;
			_statsDirty = true;
		}

		private void TickJoinWatch()
		{
			//IL_0456: Unknown result type (might be due to invalid IL or missing references)
			//IL_045c: Invalid comparison between Unknown and I4
			//IL_0467: Unknown result type (might be due to invalid IL or missing references)
			//IL_026f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0274: Unknown result type (might be due to invalid IL or missing references)
			//IL_0288: Unknown result type (might be due to invalid IL or missing references)
