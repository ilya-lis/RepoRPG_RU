			}
			_rosterLines.Sort(delegate(RosterLine a, RosterLine b)
			{
				if (a.Picked == b.Picked)
				{
					return string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase);
				}
				return a.Picked ? 1 : (-1);
			});
			_rosterHeader = $"CLASSES   {num}/{Roster.Rows.Count} picked";
			int num2 = 0;
			foreach (SynergyDef item in Synergies.All)
			{
				if (list.Contains(item.a) && list.Contains(item.b) && !Synergies.Locked(item) && ++num2 <= 4)
				{
					_rosterSyn.Add("Synergy: " + ClassName(item.a) + " + " + ClassName(item.b));
				}
			}
			if (num2 > 4)
			{
				_rosterSyn.Add($"+{num2 - 4} more synergies");
			}
		}

