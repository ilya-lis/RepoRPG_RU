		private static bool FusableE(GearItem g, RunSave run)
		{
			if (string.IsNullOrEmpty(g.unique) && !Cursed.Is(g) && !Starters.Is(g) && !ResearchEcon.IsProto(g) && !run.IsEquipped(g))
			{
				return g.rarity < Gear.MaxRarity;
			}
			return false;
		}

		private float DrawFusionE(Rect area, float y, RunSave run, bool open)
		{
			//IL_0001: Unknown result type (might be due to invalid IL or missing references)
			//IL_0181: Unknown result type (might be due to invalid IL or missing references)
			//IL_01fe: Unknown result type (might be due to invalid IL or missing references)
			y = HeadE(area, y, "FUSION FORGE", "Fuse three unequipped items of one slot and rarity into one new item a rarity higher (not Uniques, cursed or starter items). The least attuned three are used.");
			if (Time.unscaledTime >= _resEFuseAt)
			{
				_resEFuseAt = Time.unscaledTime + 0.5f;
				_resEFuseGroups.Clear();
				Dictionary<string, int> dictionary = new Dictionary<string, int>();
				foreach (GearItem item4 in run.inventory)
				{
					if (FusableE(item4, run) && !SalvagePending(item4.uid))
					{
						string key = item4.slot + "|" + item4.rarity;
						dictionary.TryGetValue(key, out var value);
						dictionary[key] = value + 1;
					}
				}
				foreach (KeyValuePair<string, int> item5 in dictionary)
				{
					if (item5.Value >= 3)
					{
						int num = item5.Key.LastIndexOf('|');
						if (num > 0 && int.TryParse(item5.Key.Substring(num + 1), out var result))
						{
							_resEFuseGroups.Add((item5.Key.Substring(0, num), result, item5.Value));
						}
					}
				}
				_resEFuseGroups.Sort(((string slot, int rarity, int count) a, (string slot, int rarity, int count) b) => (a.rarity == b.rarity) ? string.CompareOrdinal(a.slot, b.slot) : a.rarity.CompareTo(b.rarity));
			}
			if (_resEFuseGroups.Count == 0)
			{
				return TextE(area, y, "<color=#9a9ca0>You need three unequipped items of the same slot and rarity.</color>");
			}
			foreach (var resEFuseGroup in _resEFuseGroups)
			{
				string item = resEFuseGroup.slot;
				int item2 = resEFuseGroup.rarity;
				int item3 = resEFuseGroup.count;
				string s = item;
				int r = item2;
				RarityDef rarityDef = Gear.Rarity(r);
				RarityDef rarityDef2 = Gear.Rarity(r + 1);
				y = ShopRow(area, y, "Fuse 3 " + rarityDef.name + " " + Gear.SlotName(item), $"You have {item3}. Makes one <color={rarityDef2.color}>{rarityDef2.name}</color> {Gear.SlotName(item)}.", 0, open, delegate
				{
					AskFuseE(s, r);
				});
			}
			return y + 8f;
		}

		private void AskFuseE(string slot, int rarity)
		{
			RunSave run = _store.Data;
			List<GearItem> list = run.inventory.FindAll((GearItem g) => g.slot == slot && g.rarity == rarity && FusableE(g, run) && !SalvagePending(g.uid));
			if (list.Count < 3)
			{
				return;
			}
			list.Sort((GearItem a, GearItem b) => a.attune.CompareTo(b.attune));
			List<GearItem> range = list.GetRange(0, 3);
			List<string> list2 = new List<string>();
			foreach (GearItem item in range)
			{
				list2.Add(item.name);
			}
			string[] uids = new string[3]
			{
				range[0].uid,
				range[1].uid,
				range[2].uid
			};
			AskConfirm("FUSE?", "Fuse " + string.Join(", ", list2) + " into one " + Gear.Rarity(rarity + 1).name + " " + Gear.SlotName(slot) + "? The three are used up (their modules go back to your bag). This can't be undone.", "Fuse", delegate
			{
				DoFuseE(uids);
			}, focusCancel: true);
		}

		private void DoFuseE(string[] uids)
		{
			//IL_0084: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			List<GearItem> list = new List<GearItem>();
			foreach (string uid in uids)
			{
				GearItem gearItem = data.FindItem(uid);
				if (gearItem == null || !FusableE(gearItem, data) || SalvagePending(uid) || (list.Count > 0 && (gearItem.slot != list[0].slot || gearItem.rarity != list[0].rarity)))
				{
					Toast("Fusion stopped: one of the items changed. Nothing was used.", Bad);
					return;
				}
				list.Add(gearItem);
			}
			if (list.Count != 3)
			{
				return;
			}
			int num = 0;
			int num2 = 0;
			foreach (GearItem item in list)
			{
				num += ((item.freeValue < 0) ? SalvageCalc.Gross(item) : item.freeValue);
				num2 += Mathf.Max(0, item.scrapIn);
			}
			foreach (GearItem item2 in list)
			{
				ModulesBackToBag(item2);
				data.inventory.Remove(item2);
				if (!data.salvaged.Contains(item2.uid))
				{
					data.salvaged.Add(item2.uid);
				}
			}
			GearItem gearItem2 = Gear.RollExact(new Random(), Mathf.Min(list[0].rarity + 1, Gear.MaxRarity), list[0].slot, allowUnique: false);
			gearItem2.freeValue = Mathf.Min(SalvageCalc.Gross(gearItem2), num);
			gearItem2.scrapIn = num2;
			_statsDirty = true;
			_gearSig = int.MinValue;
			GiveGear(gearItem2, "Fusion Forge");
			MenuSound(UiSound.Confirm);
		}

		private static int LevelKeyX()
		{
			LevelGenerator instance = LevelGenerator.Instance;
			if (!((Object)(object)instance != (Object)null))
			{
				return 0;
			}
			return ((Object)instance).GetInstanceID();
		}

		private void ResearchLevelStartClientX()
		{
			_rxLevelAt = Time.time;
			_rxVault = null;
			_rxVaultHold = 0f;
			_rxNextEps = 0f;
			_rxLit.Clear();
			if (!Game.IsMaster())
			{
				FieldResearch.ClientReset();
			}
		}

		private void TickResearchX(PlayerAvatar? local)
		{
			//IL_01be: Unknown result type (might be due to invalid IL or missing references)
			//IL_00fc: Unknown result type (might be due to invalid IL or missing references)
			//IL_0107: Unknown result type (might be due to invalid IL or missing references)
			if (Game.IsMaster() && (Object)(object)ClassHost.Instance != (Object)null)
			{
				ClassHost.Instance.TickHitchX();
				ClassHost.Instance.TickDumbwaiterX();
			}
			if (!Game.LevelReady())
			{
				_rxVault = null;
				return;
			}
			float time = Time.time;
			int num = LevelKeyX();
			if (num != _rxDimKey && time - _rxLevelAt > 4f && FieldResearch.LevelHas("blackout"))
			{
				_rxDimKey = num;
				DimLightsX();
			}
			if (time >= _rxNextMarks)
			{
				_rxNextMarks = time + 1f;
				MarksX(local);
			}
			if ((Object)(object)local == (Object)null || !Game.IsAlive(local) || !Research.Lobby("vault_cracking"))
			{
				_rxVault = null;
				_rxVaultHold = 0f;
				return;
			}
			if (time >= _rxNextLook)
			{
				_rxNextLook = time + 0.25f;
				_rxVault = null;
				Camera main = Camera.main;
				RaycastHit val = default(RaycastHit);
				if ((Object)(object)main != (Object)null && !Game.IsHoldingSomething() && Physics.Raycast(((Component)main).transform.position, ((Component)main).transform.forward, ref val, 3f, -1, (QueryTriggerInteraction)1))
				{
					ValuableObject val2 = (((Object)(object)((RaycastHit)(ref val)).collider != (Object)null) ? ((Component)((RaycastHit)(ref val)).collider).GetComponentInParent<ValuableObject>() : null);
					if ((Object)(object)val2 != (Object)null && FieldResearch.SeenAs((Component?)(object)val2, 2))
					{
						_rxVault = val2;
					}
				}
			}
			bool flag = false;
			try
			{
				flag = (Object)(object)_rxVault != (Object)null && !_menuOpen && SemiFunc.InputHold((InputKey)2);
			}
			catch
			{
			}
			if (!flag)
			{
				_rxVaultHold = 0f;
				return;
			}
			_rxVaultHold += Time.deltaTime;
			if (time - _rxVaultSent >= 0.25f)
