			{
				Toast("Hold a valuable to bet on it", Color.gray);
				MenuSound(UiSound.Error);
				return false;
			}
			if (!BetAllowedLocally())
			{
				return false;
			}
			int num = ClassHost.ViewId((Component?)(object)val);
			if (num == 0)
			{
				return false;
			}
			Net.SendClassAction(ClassHost.Act.Bet, ((Component)val).transform.position, Array.Empty<float>(), num);
			return true;
		}

		private void EnsureGambleRoll()
		{
			//IL_0280: Unknown result type (might be due to invalid IL or missing references)
			//IL_0285: Unknown result type (might be due to invalid IL or missing references)
			//IL_0295: Unknown result type (might be due to invalid IL or missing references)
			//IL_02e1: Unknown result type (might be due to invalid IL or missing references)
			if (CurrentId != "gambler" || !Game.InLevel())
			{
				return;
			}
			RunSave data = _store.Data;
			string text = RunInfo.Key + ":" + RunInfo.LevelIndex;
			if (data.gambleKey == text)
			{
				return;
			}
			RpgData rpg = Plugin.Rpg;
			if (rpg.blessings.Length == 0 || rpg.curses.Length == 0)
			{
				return;
			}
			Random random = new Random(StableHash(text + ":" + Game.SteamId(Game.LocalPlayer())));
			data.gambleKey = text;
			data.gambleBless.Clear();
			int num = random.Next(rpg.blessings.Length);
			data.gambleBless.Add(rpg.blessings[num].id);
			if (random.NextDouble() * 100.0 < (double)ClassStat("gambler.extra_bless") && rpg.blessings.Length > 1)
			{
				int num2 = (num + 1 + random.Next(rpg.blessings.Length - 1)) % rpg.blessings.Length;
				data.gambleBless.Add(rpg.blessings[num2].id);
			}
			data.gambleCurse = ((random.NextDouble() * 100.0 < (double)ClassStat("gambler.no_curse")) ? "" : rpg.curses[random.Next(rpg.curses.Length)].id);
			_store.MarkDirty();
			_statsDirty = true;
			List<string> list = new List<string>();
			foreach (string item in data.gambleBless)
			{
				PerkDef perkDef = Find(rpg.blessings, item);
				if (perkDef != null)
				{
					list.Add("Blessing: " + perkDef.name + " (" + perkDef.desc + ")");
				}
			}
			PerkDef perkDef2 = Find(rpg.curses, data.gambleCurse);
			list.Add((perkDef2 != null) ? ("Curse: " + perkDef2.name + " (" + perkDef2.desc + ")") : "No curse this level!");
			Color val = ParseColor(Current?.color ?? "#FFFFFF");
			Notify(PopupKind.Perk, string.Join("  |  ", list), val, "gamble");
			Toast("Fortune's Wheel: " + string.Join(", ", list.ConvertAll((string l) => l.Split('(')[0].Trim())), val, 5f);
		}

		private static int StableHash(string s)
		{
			int num = -2128831035;
			foreach (char c in s)
			{
				num = (num ^ c) * 16777619;
			}
			return num;
		}

		private static PerkDef? Find(PerkDef[] list, string id)
		{
			foreach (PerkDef perkDef in list)
			{
				if (perkDef.id == id)
				{
					return perkDef;
				}
			}
			return null;
		}

		private void ApplyClassExtras()
		{
			string currentId = CurrentId;
			if (currentId == "gambler")
			{
				RunSave data = _store.Data;
				if (data.gambleKey == RunInfo.Key + ":" + RunInfo.LevelIndex)
				{
					float mult = 1f + Mathf.Max(0f, ClassStat("gambler.bless_power")) / 100f;
					float mult2 = Mathf.Max(0f, 1f - Mathf.Max(0f, ClassStat("gambler.curse_soft")) / 100f);
					foreach (string item in data.gambleBless)
					{
						PerkDef perkDef = Find(Plugin.Rpg.blessings, item);
						if (perkDef != null)
						{
							_stats.AddPermEffects(perkDef.effects, mult);
						}
					}
					PerkDef perkDef2 = Find(Plugin.Rpg.curses, data.gambleCurse);
					if (perkDef2 != null)
					{
						_stats.AddPermEffects(perkDef2.effects, mult2);
					}
				}
				_stats.AddPerm(Stat.GearFind, ClassStat("gambler.gear_find"));
			}
			if (currentId == "quartermaster")
			{
				_stats.AddPerm(Stat.ScrapBonus, ClassStat("quartermaster.scrap"));
			}
			ApplyThirdWaveExtras(currentId);
		}

		private void OnLevelStartClasses()
		{
			ClearAbilityLimits();
			_buffs.Clear();
			_selfDyn.Clear();
			_inspire = 0f;
			_pactEnd = 0f;
			_copies[0] = (_copies[1] = "");
			_copyFrom[0] = (_copyFrom[1] = "");
			_copySlot = 0;
			_slotState[0] = (_slotState[1] = (charges: 1, cdEnd: 0f));
			_copyCandidate = -1;
			_copyTimer = 0f;
			_bloodAcc = 0f;
			_drainAcc = 0f;
			_refundAfterUse = false;
			ClassFx.HideAll();
			ThirdWaveReset();
			_gambleCheckAt = Time.time + 3f;
			if (!_cartFollowOn)
			{
				SendCartFollow();
			}
		}

		private void TickBloodbound(PlayerAvatar local)
		{
			PlayerHealth playerHealth = local.playerHealth;
			float num = ClassStat("bloodbound.hit_power");
			if ((Object)(object)playerHealth != (Object)null && (float)Game.Health(playerHealth) < (float)Game.MaxHealth(playerHealth) * 0.4f)
			{
				num += ClassStat("bloodbound.low_power");
			}
			_stats.AddDyn(Stat.WeaponDamage, num);
			_stats.AddDyn(Stat.ThrowStrength, ClassStat("bloodbound.throw_power"));
			float num2 = _stats.Dyn(Stat.WeaponDamage);
			if (Mathf.Abs(num2 - _lastBloodWeapon) > 0.5f)
			{
				_lastBloodWeapon = num2;
				_nextCombatSend = 0f;
			}
			TickPactDrain(local);
		}

		private void TickPactDrain(PlayerAvatar local)
		{
			if (_pactEnd <= 0f)
			{
				return;
			}
			PlayerHealth playerHealth = local.playerHealth;
			if (Time.time < _pactEnd && (Object)(object)playerHealth != (Object)null)
			{
				_drainAcc += _pactDrain * Time.deltaTime;
				if (_drainAcc >= 1f)
				{
					int num = Mathf.FloorToInt(_drainAcc);
					_drainAcc -= num;
					SpendHealth(num);
				}
			}
			else
			{
				_drainAcc = 0f;
				_pactEnd = 0f;
			}
		}

		private void SpendHealth(float amount)
		{
			PlayerAvatar val = Game.LocalPlayer();
			PlayerHealth val2 = (((Object)(object)val != (Object)null) ? val.playerHealth : null);
			if ((Object)(object)val2 == (Object)null || (Object)(object)val == (Object)null || !Game.IsAlive(val))
			{
				return;
			}
			int num = Game.Health(val2);
			_bloodAcc = Mathf.Clamp(_bloodAcc + amount, -50f, 50f);
			if (_bloodAcc <= -1f)
			{
				int num2 = Mathf.FloorToInt(0f - _bloodAcc);
				_bloodAcc += num2;
				val2.Heal(num2, false);
				if (CurrentId == "bloodbound")
				{
					CEv("cls.bloodbound", num2);
				}
			}
			else
			{
				if (_bloodAcc < 1f)
				{
					return;
				}
				int num3 = Mathf.FloorToInt(_bloodAcc);
				_bloodAcc -= num3;
				int num4 = Mathf.Min(num3, num - 1);
				if (num4 <= 0)
				{
					return;
				}
				int num5 = num - num4;
				try
				{
					Game.Set(val2, "health", num5);
					StatsManager instance = StatsManager.instance;
					if (instance != null)
					{
						instance.SetPlayerHealth(Game.SteamId(val), num5, false);
					}
					PhotonView val3 = Game.Get<PhotonView>(val2, "photonView", null);
					if (Game.IsMultiplayer() && (Object)(object)val3 != (Object)null)
					{
						val3.RPC("UpdateHealthRPC", (RpcTarget)1, new object[3]
						{
							num5,
							Game.MaxHealth(val2),
							false
						});
					}
				}
				catch (Exception ex)
				{
					Game.WarnOnce("Blood Price failed: " + ex.GetBaseException().Message);
				}
				_lastSeenHp = num5;
			}
		}

		private void OnKillNear(float dist)
		{
			if (!(CurrentId != "bloodbound") && !(dist > Plugin.Cfg.KillShareRadius.Value + Mathf.Max(0f, ClassStat("bloodbound.feed_range"))))
			{
				PlayerAvatar val = Game.LocalPlayer();
				PlayerHealth val2 = (((Object)(object)val != (Object)null) ? val.playerHealth : null);
				int num = Mathf.RoundToInt(Mathf.Clamp(ClassStat("bloodbound.feed"), 0f, 60f));
				if ((Object)(object)val2 != (Object)null && num > 0)
				{
					Game.HealSelf(val2, num);
					NoteHeal(num, HealKind.Instant, "Feed");
				}
				float num2 = ClassStat("bloodbound.feed_cd");
				if (num2 > 0f && _cooldownEnd > 0f)
				{
					_cooldownEnd -= num2;
				}
				float num3 = ClassStat("bloodbound.feast_speed");
				if (num3 > 0f)
				{
					AddSelfBuff(new AllyBuff
					{
						Speed = num3,
						Duration = 5f,
						Source = "Sanguine Feast"
					});
				}
			}
		}

		public void OnClassNotice(Notice kind, float value, string text)
		{
			//IL_0066: Unknown result type (might be due to invalid IL or missing references)
			//IL_010d: Unknown result type (might be due to invalid IL or missing references)
			switch (kind)
			{
			case Notice.Text:
				if (text != "")
				{
					Toast(text, ParseColor(Current?.color ?? "#FFFFFF"));
				}
				break;
			case Notice.BloodCost:
				if (CurrentId == "bloodbound")
				{
					SpendHealth(value);
				}
				break;
			case Notice.Slip:
				if (value > 0f)
				{
					AddSelfBuff(new AllyBuff
					{
						Speed = Mathf.Min(value, 40f),
						Duration = 3f,
						Source = ""
					});
				}
				break;
			case Notice.CurseHurt:
			case Notice.CurseState:
			case Notice.CursedDrop:
				OnCurseNotice(kind, value, text);
				break;
			case Notice.Popup:
				if (text != "")
				{
					Notify(PopupKind.Other, text, ParseColor(Current?.color ?? "#FFFFFF"));
				}
				break;
			case Notice.AbilityState:
				OnAbilityState(text);
				break;
			case Notice.RefundPart:
				RefundPart(value);
				break;
			case Notice.Courier:
				OnCourierNotice(value, text);
				break;
			case Notice.CartState:
				_cartState = text;
				_nextHudBuild = 0f;
				break;
			case Notice.RefundAbility:
				_specialistPending = false;
				if (_inActive)
				{
					_refundAfterUse = true;
				}
				else
				{
					RefundCharge();
				}
				break;
			}
		}

		private void RefundCharge()
		{
			_charges = Mathf.Min(MaxCharges, _charges + 1);
			if (_charges >= MaxCharges)
			{
				_cooldownEnd = 0f;
			}
		}

		public void ShowFx(ClassHost.Fx fx, Vector3 pos, float radius, float seconds)
