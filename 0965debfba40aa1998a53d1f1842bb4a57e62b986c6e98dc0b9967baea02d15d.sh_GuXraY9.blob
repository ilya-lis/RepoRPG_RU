		private bool ShopResearchAnyC()
		{
			if (Research.On)
			{
				if (!Research.Has("gear_exchange") && _tradeState != 1 && ResearchCrew.Cur.Drills.Length == 0)
				{
					return ResearchCrew.Cur.Sponsor != "";
				}
				return true;
			}
			return false;
		}

		private string ResCrewText()
		{
			ResearchCrew.State cur = ResearchCrew.Cur;
			if (_resCrewFor == cur)
			{
				return _resCrewText;
			}
			_resCrewFor = cur;
			StringBuilder stringBuilder = new StringBuilder();
			if (cur.Sponsor != "")
			{
				stringBuilder.Append("<b>SPONSOR:</b> <color=#ffd166>" + ResearchCrew.SponsorName(cur.Sponsor) + "</color>  " + cur.SponsorLine + "\n");
			}
			if (cur.Drills.Length != 0)
			{
				stringBuilder.Append("<b>CREW DRILLS</b>\n");
				string[] drills = cur.Drills;
				for (int i = 0; i < drills.Length; i++)
				{
					ResearchCrew.Drill drill = ResearchCrew.DrillDef(drills[i]);
					if (drill != null)
					{
						stringBuilder.Append("<color=#73d9ff>" + drill.Name + "</color>: " + drill.Desc + "\n");
					}
				}
			}
			_resCrewText = stringBuilder.ToString().TrimEnd('\n');
			return _resCrewText;
		}

