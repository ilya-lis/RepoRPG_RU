	internal static class RenameMigration
	{
		public const string OldName = "Semibot RPG";

		private const string OldFolder = "SemibotRPG";

		private const string Marker = "migrated-from-SemibotRPG.txt";

		public static void MigrateData()
		{
			try
			{
				string text = Path.Combine(Paths.ConfigPath, "SemibotRPG");
				string folder = ClassDatabase.Folder;
				if (!Directory.Exists(text) || string.Equals(Path.GetFullPath(text), Path.GetFullPath(folder), StringComparison.OrdinalIgnoreCase) || File.Exists(Path.Combine(folder, "migrated-from-SemibotRPG.txt")))
				{
					return;
				}
				Directory.CreateDirectory(folder);
				int num = 0;
				int num2 = 0;
				string[] files = Directory.GetFiles(text, "*", SearchOption.AllDirectories);
				foreach (string text2 in files)
				{
					string path = text2.Substring(text.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
					string text3 = Path.Combine(folder, path);
					if (File.Exists(text3))
					{
						num2++;
						continue;
					}
					Directory.CreateDirectory(Path.GetDirectoryName(text3));
					File.Copy(text2, text3, overwrite: false);
					num++;
				}
				File.WriteAllText(Path.Combine(folder, "migrated-from-SemibotRPG.txt"), string.Format("Copied from BepInEx/config/{0} on {1:yyyy-MM-dd HH:mm} when {2} became RepoRPG ({3} files). ", "SemibotRPG", DateTime.Now, "Semibot RPG", num) + "The old folder is kept as a backup and can be deleted once everything works.\n");
				Plugin.Log.LogInfo((object)(string.Format("[rename] {0} is now RepoRPG: copied {1} file(s) (account progress, saves, presets) from BepInEx/config/{2} ", "Semibot RPG", num, "SemibotRPG") + "to BepInEx/config/RepoRPG" + ((num2 > 0) ? $" ({num2} already there, kept)" : "") + ". The old folder stays as a backup."));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("[rename] couldn't copy your data from BepInEx/config/SemibotRPG to BepInEx/config/RepoRPG (" + ex.Message + "). Nothing was deleted: copy that folder's files over by hand, or start the game again to retry."));
			}
		}

		public static void CheckOldInstall()
		{
			try
			{
				string pluginPath = Paths.PluginPath;
				if (!string.IsNullOrEmpty(pluginPath) && Directory.Exists(pluginPath))
				{
					string[] files = Directory.GetFiles(pluginPath, "SemibotRPG.dll", SearchOption.AllDirectories);
					foreach (string text in files)
					{
						Plugin.Log.LogWarning((object)("[rename] The old Semibot RPG is still installed (" + text.Substring(pluginPath.Length).TrimStart('\\', '/') + "). It's the same mod under its old name: uninstall \"SemibotRPG\" in your mod manager and keep RepoRPG (BepInEx loads only one of the two)."));
					}
				}
			}
			catch
			{
			}
		}
	}
	internal static class SprintDrain
	{
		public static float RpgMult = 1f;

		public static bool FloorExempt;

		private static PlayerController? _pc;

		private static float _vanilla = -1f;

		private static float _saved;

		private static float _wrote;

		private static bool _swapped;

		private static float _logGame = -1f;

		private static float _logMult = -1f;

		public static float Vanilla => _vanilla;

		public static float LastGame { get; private set; } = -1f;

		public static float LastUsed { get; private set; } = -1f;

		public static bool LastFloored { get; private set; }

		public static float FloorPct => Mathf.Clamp(Plugin.Cfg.MinSprintDrain.Value, 0f, 100f);

		public static void Capture(PlayerController pc)
		{
			_pc = pc;
			_vanilla = Game.Get(pc, "EnergySprintDrain", 0f);
			LastGame = (LastUsed = -1f);
			_logGame = (_logMult = -1f);
		}

		public static float Combine(float game, out bool floored)
		{
			floored = false;
			float num = game * Mathf.Max(0f, RpgMult);
			if (!FloorExempt && _vanilla > 0f)
			{
				float num2 = _vanilla * FloorPct / 100f;
				if (num < num2)
				{
					num = num2;
					floored = true;
				}
			}
			return num;
		}

		public static void Before(PlayerController pc)
		{
			_swapped = false;
			if (!((Object)(object)pc == (Object)null) && !((Object)(object)pc != (Object)(object)PlayerController.instance))
			{
				if (pc != _pc || _vanilla <= 0f)
				{
					Capture(pc);
				}
				float num = Game.Get(pc, "EnergySprintDrain", 0f);
				bool floored;
				float num2 = Combine(num, out floored);
				LastGame = num;
				LastUsed = num2;
				LastFloored = floored;
				if (Mathf.Abs(num - _logGame) > 0.0001f || (Plugin.Cfg.StaminaDebug.Value && Mathf.Abs(RpgMult - _logMult) > 0.02f))
				{
					LogChange(num, num2, floored);
				}
				if (!(Mathf.Abs(num2 - num) < 1E-06f))
				{
					_saved = num;
					_wrote = num2;
					Game.Set(pc, "EnergySprintDrain", num2);
					_swapped = true;
				}
			}
		}

		public static void After(PlayerController pc)
		{
			if (_swapped)
			{
				_swapped = false;
				if (Mathf.Abs(Game.Get(pc, "EnergySprintDrain", 0f) - _wrote) < 1E-06f)
				{
					Game.Set(pc, "EnergySprintDrain", _saved);
				}
			}
		}

		private static void LogChange(float game, float used, bool floored)
		{
			_logGame = game;
			_logMult = RpgMult;
			if (!(_vanilla <= 0f))
			{
				string text = Upgrades.StaminaLevelsText(Game.SteamId(Game.LocalPlayer()));
				Plugin.Log.LogInfo((object)($"[stamina] sprint drain: vanilla {_vanilla:0.###}/s, after upgrade mods {game:0.###}/s (x{game / _vanilla:0.###}), " + string.Format("RepoRPG x{0:0.###}{1}, floor {2:0}% of vanilla = {3:0.###}/s ", RpgMult, FloorExempt ? " (Featherlight free)" : "", FloorPct, _vanilla * FloorPct / 100f) + string.Format("-> uses {0:0.###}/s (x{1:0.###}{2}). {3}", used, used / _vanilla, floored ? ", at the floor" : "", text)));
			}
		}
	}
	[HarmonyPatch]
	internal static class SprintDrainPatch
	{
		private static MethodBase? TargetMethod()
		{
			return AccessTools.DeclaredMethod(typeof(PlayerController), "FixedUpdate", (Type[])null, (Type[])null);
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			if (TargetMethod() != null)
			{
				return AccessTools.Field(typeof(PlayerController), "EnergySprintDrain") != null;
			}
			return false;
		}

		[HarmonyPrefix]
		[HarmonyPriority(0)]
		private static void Prefix(PlayerController __instance)
		{
			if (!Guard.On("SprintDrainPatch"))
			{
				return;
			}
			try
			{
				SprintDrain.Before(__instance);
			}
			catch (Exception e)
			{
				Guard.Fail("SprintDrainPatch", e);
			}
		}

		[HarmonyPostfix]
		[HarmonyPriority(800)]
		private static void Postfix(PlayerController __instance)
		{
			try
			{
				SprintDrain.After(__instance);
			}
			catch (Exception e)
			{
				Guard.Fail("SprintDrainPatch", e);
			}
		}
	}
	[HarmonyPatch]
	internal static class SprintDrainVanillaPatch
	{
		private static MethodBase? TargetMethod()
		{
			return AccessTools.DeclaredMethod(typeof(PlayerController), "Awake", (Type[])null, (Type[])null);
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			return TargetMethod() != null;
		}

		[HarmonyPostfix]
		private static void Postfix(PlayerController __instance)
		{
			try
			{
				if ((Object)(object)__instance == (Object)(object)PlayerController.instance)
				{
					SprintDrain.Capture(__instance);
				}
			}
			catch
			{
			}
		}
	}
