				Appraise = Mathf.Clamp(_stats[Stat.AppraiseValue], 0f, Plugin.Cfg.MaxAppraiseBonus.Value),
				AppraiseRare = Mathf.Clamp(_stats[Stat.AppraiseRareBonus], 0f, Plugin.Cfg.MaxAppraiseBonus.Value),
