			if (num)
			{
				if (_nDismissDownAt < 0f)
				{
					_nDismissDownAt = unscaledTime;
					_nDismissAllDone = false;
				}
				else if (!_nDismissAllDone && unscaledTime - _nDismissDownAt >= 0.6f)
				{
					_nDismissAllDone = true;
