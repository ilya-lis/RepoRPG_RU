		internal static void ClassTrace(string msg)
		{
			Plugin.Log.LogInfo((object)("[class confirm] " + msg));
		}

		private void RaiseClassChanged(ClassDef? before, ClassDef? now, string why)
		{
			ClassTrace("6 class set locally: " + (before?.id ?? "none") + " -> " + (now?.id ?? "none") + " (" + why + "); level " + (CurrentProgress?.level.ToString() ?? "-"));
			_hudForce = true;
			_hudBadSince = -1f;
			_hudHadClass = now != null;
			_nextHudBuild = 0f;
			_hudTraceClass = now?.id ?? "";
			if (now != null)
			{
				PatchGuard.Run("class starter", EnsureStarterGear);
			}
			try
			{
				RpgRuntime.ClassChanged?.Invoke(now);
			}
			catch (Exception e)
			{
				Guard.Fail("class changed listeners", e);
			}
		}

		private void TraceHud(List<(string, Color)> lines)
		{
			if (!(_hudTraceClass == "-"))
			{
				string hudTraceClass = _hudTraceClass;
				_hudTraceClass = "-";
				string text = ((lines.Count > 0) ? lines[0].Item1 : "(nothing)");
				bool flag = ((hudTraceClass == "") ? (Current == null) : (Current != null && text.StartsWith(Current.name.ToUpperInvariant())));
				ClassTrace("7 HUD rebuilt: '" + text + "'" + ((lines.Count > 1) ? (" / '" + lines[1].Item1 + "'") : "") + (flag ? "" : " - DOESN'T MATCH the class"));
			}
		}

