		private string HcSignature()
		{
			HcData hc = _hc;
			_hcSb.Clear();
			_hcSb.Append(hc.Message).Append('|').Append(hc.Name)
				.Append('|')
				.Append(hc.Level)
				.Append('|')
				.Append(hc.Scrap)
				.Append('|')
				.Append(hc.Key)
				.Append('|')
				.Append(hc.Ability)
				.Append('|')
				.Append(hc.Extra)
				.Append('|')
				.Append(hc.State)
				.Append('|')
				.Append(hc.MaxCh)
				.Append(hc.CopyInitial);
			foreach (var chip in hc.Chips)
			{
				_hcSb.Append('#').Append(chip.text);
			}
			foreach (var line in hc.Lines)
			{
				_hcSb.Append('~').Append(line.text);
			}
			foreach (HcKey key in hc.Keys)
			{
				_hcSb.Append('^').Append(key.Glyph).Append(key.Label)
					.Append(key.State)
					.Append(key.Usable ? '1' : '0');
			}
			_hcSb.Append('|').Append(_fontMul.ToString("0.00")).Append(HcCompact ? 'c' : 'n')
				.Append(HudVis.CardSig());
			return _hcSb.ToString();
		}

