		public static void HostLevelTotals()
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster())
			{
				return;
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null))
				{
					int actor = Game.ActorNumber(item);
					if (!Game.IsMultiplayer())
					{
						actor = ClassClaims.LocalActor;
					}
					RunPlayerTotals runPlayerTotals = Totals(team, item);
					float num = TeamPlay.HostValue(actor, TeamPlay.Ev.Carried);
					runPlayerTotals.carried += num;
					runPlayerTotals.bestCarryLevel = Mathf.Max(runPlayerTotals.bestCarryLevel, num);
					runPlayerTotals.kills += Mathf.RoundToInt(TeamPlay.HostValue(actor, TeamPlay.Ev.Kills));
					runPlayerTotals.revives += Mathf.RoundToInt(TeamPlay.HostValue(actor, TeamPlay.Ev.Revives));
					int num2 = Mathf.RoundToInt(TeamPlay.HostValue(actor, TeamPlay.Ev.Contracts));
					runPlayerTotals.contracts += num2;
					AddCrew(team, (float)num2 * 24f / (float)Mathf.Max(1, Game.Players().Count));
					runPlayerTotals.scrap += TeamPlay.HostValue(actor, TeamPlay.Ev.Scrap);
				}
			}
			Dirty();
		}

