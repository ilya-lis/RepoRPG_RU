		private int AttrPts(RunSave run, string id)
		{
			return run.AttributePoints(id);
		}

		private int AttrPtsAfter(RunSave run, string id)
		{
			return run.AttributePoints(id) + AttrPendingOf(id);
		}

		private void RefreshAttrCache(RunSave run)
		{
			int num = (Current?.id ?? "").GetHashCode() * 7 + (AttrBonus.MilestonesOn ? 1 : 0) + (AttrBonus.PairingsOn ? 2 : 0);
			AttributeDef[] attributes = Plugin.Rpg.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				num = num * 31 + AttrPts(run, attributeDef.id) * 37 + AttrPendingOf(attributeDef.id);
			}
			if (num == _attrCacheKey)
			{
				return;
			}
			_attrCacheKey = num;
			string classId = Current?.id;
			_attrActiveNow.Clear();
			_attrActiveAfter.Clear();
			_attrTotalLines.Clear();
			foreach (var item in AttrBonus.Active((string id) => AttrPts(run, id), classId))
			{
				_attrActiveNow.Add(item.key);
			}
			foreach (var item2 in AttrBonus.Active((string id) => AttrPtsAfter(run, id), classId))
			{
				_attrActiveAfter.Add(item2.key);
				bool flag = !_attrActiveNow.Contains(item2.key);
				string text = (item2.key.StartsWith("p:") ? "Pairing" : "Milestone");
				_attrTotalLines.Add(flag ? ("<color=#ffd75a><b>NEW</b> " + item2.name + "</color> <color=#9a9ca0>(" + text + ")</color>: " + item2.desc) : ("<color=#73ff66><b>" + item2.name + "</b></color> <color=#9a9ca0>(" + text + ")</color>: " + item2.desc));
			}
			_attrTitleNow = AttrBonus.Title((string id) => AttrPts(run, id));
			_attrTitleAfter = AttrBonus.Title((string id) => AttrPtsAfter(run, id));
			string text2 = Current?.id + "|" + RunInfo.Key;
			if (text2 != _attrKnownFor)
			{
				_attrKnownFor = text2;
				_attrKnownActive = null;
			}
			if (_attrKnownActive == null)
			{
				_attrKnownActive = new HashSet<string>(_attrActiveNow);
			}
		}

		public string BuildTitle()
		{
			RefreshAttrCache(_store.Data);
			return _attrTitleNow;
		}

