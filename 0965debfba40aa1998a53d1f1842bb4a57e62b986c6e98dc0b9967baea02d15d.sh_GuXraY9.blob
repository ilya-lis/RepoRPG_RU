		public void OnEvent(EventData e)
		{
			//IL_01fb: Unknown result type (might be due to invalid IL or missing references)
			if (e.Code != 150)
			{
				return;
			}
			if (!(e.CustomData is object[] array) || array.Length != 4 || !(array[0] is int num) || num != 1397903431 || !(array[2] is byte type))
			{
				Game.WarnOnce($"Network event {(byte)150} from player {e.Sender} isn't RepoRPG's - another mod uses the same event code. Its events are ignored.");
				return;
			}
			HeardFrom[e.Sender] = Time.unscaledTime;
			if (!(array[1] is int num2) || num2 != 4)
			{
				bool flag = array[1] is int num3 && num3 < 4;
				string text = (flag ? string.Format("an older version (protocol {0}; {1} is RepoRPG's old name)", array[1], "Semibot RPG") : $"a newer version (protocol {array[1]})");
				Game.WarnOnce(string.Format("Player {0} ({1}) runs {2}; this is RepoRPG {3} (protocol {4}): ", e.Sender, PlayerName(e.Sender), text, "1.0.100", 4) + "their mod's messages are ignored. Everyone should use the same version.");
				if (IsFromHost(e.Sender))
				{
					SettingsSync.BlockForVersion(text);
				}
				else if (PhotonNetwork.IsMasterClient && OldVersionTold.Add(e.Sender))
				{
					bool flag2 = Plugin.Cfg.VersionMismatch.Value == MismatchMode.Kick;
					RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, PlayerName(e.Sender) + " runs " + (flag ? "an older version (Semibot RPG?)" : "a newer version") + ": they need RepoRPG 1.0.100" + (flag2 ? " (removed)." : "."), (Color?)new Color(1f, 0.6f, 0.4f), "");
					if (flag2)
					{
						Kick(e.Sender);
					}
				}
			}
			else
			{
				if (NetMeter.Counting)
				{
					NetMeter.Received(type, array[3]);
				}
				NetDebug.Receive(e.Sender, type, array[3]);
			}
		}

