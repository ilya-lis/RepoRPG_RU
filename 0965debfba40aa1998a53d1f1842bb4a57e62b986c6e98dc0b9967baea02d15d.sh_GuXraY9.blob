			}
			return false;
		}

		private void AddTracked(ValuableObject obj, float value, float until, bool own = false, PhysGrabObject? pgo = null, Component? det = null)
		{
			//IL_0149: Unknown result type (might be due to invalid IL or missing references)
			//IL_014e: Unknown result type (might be due to invalid IL or missing references)
			foreach (Tracked item in _tracked)
			{
				if ((Object)(object)item.Obj == (Object)(object)obj)
				{
					item.Until = Mathf.Max(item.Until, until);
					item.Own |= own;
					return;
				}
			}
			Renderer[] componentsInChildren = ((Component)obj).GetComponentsInChildren<Renderer>(false);
			List<Renderer> list = new List<Renderer>();
			Renderer[] array = componentsInChildren;
			foreach (Renderer val in array)
			{
				if (val is MeshRenderer || val is SkinnedMeshRenderer)
				{
					list.Add(val);
					if (list.Count >= 8)
					{
						break;
					}
				}
			}
			if (pgo == null)
			{
				pgo = ((Component)obj).GetComponent<PhysGrabObject>();
			}
			Tracked tracked = new Tracked
			{
				Obj = obj,
				Rends = list.ToArray(),
				Value = value,
				Until = until,
				Own = own,
				Pgo = pgo,
				Det = (det ?? DetOf(pgo))
			};
			tracked.Filters = (MeshFilter?[])(object)new MeshFilter[tracked.Rends.Length];
			for (int j = 0; j < tracked.Rends.Length; j++)
			{
				tracked.Filters[j] = ((Component)tracked.Rends[j]).GetComponent<MeshFilter>();
			}
			tracked.Col = ScanColor(obj, value);
			tracked.Tag = ScanTag(obj, value);
			tracked.Mkt = (ResearchSamples.IsSample(obj) ? "RESEARCH SAMPLE" : Market.Tag(ValueScale.CleanName(((Object)((Component)obj).gameObject).name)));
			_tracked.Add(tracked);
		}

