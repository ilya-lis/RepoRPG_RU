	[Serializable]
	public class ClassDatabaseFile
	{
		public int version = 1;

		public int treeVersion = 1;

		public ClassDef[] classes = Array.Empty<ClassDef>();
	}
	[Serializable]
	public class NodeRank
	{
		public string id = "";

		public int rank;
	}
	[Serializable]
	public class ClassProgress
	{
		public string classId = "";

		public int level = 1;

		public int xp;

		public int bonusPoints;

		public List<NodeRank> ranks = new List<NodeRank>();

		public int RankOf(string nodeId)
		{
			foreach (NodeRank rank in ranks)
			{
				if (rank.id == nodeId)
				{
					return rank.rank;
				}
			}
			return 0;
		}

		public void SetRank(string nodeId, int rank)
		{
			foreach (NodeRank rank2 in ranks)
			{
				if (!(rank2.id != nodeId))
				{
					rank2.rank = rank;
					if (rank <= 0)
					{
						ranks.Remove(rank2);
					}
					return;
				}
			}
			if (rank > 0)
			{
				ranks.Add(new NodeRank
				{
					id = nodeId,
					rank = rank
				});
			}
		}

		public int SpentPoints()
		{
			int num = 0;
			foreach (NodeRank rank in ranks)
			{
				num += rank.rank;
			}
			return num;
		}
	}
	[Serializable]
	public class AttributeDef
	{
		public string id = "";

		public string name = "";

		public string desc = "";

		public int maxPoints = 20;

		public string category = "";

		public int softCap;

		public float falloff = 0.5f;

		public EffectDef[] effects = Array.Empty<EffectDef>();

		public float EffectivePoints(int points)
		{
			int num = Math.Max(0, Math.Min(points, maxPoints));
			if (softCap <= 0 || num <= softCap)
			{
				return num;
			}
			return (float)softCap + (float)(num - softCap) * Math.Max(0f, Math.Min(1f, falloff));
		}
	}
