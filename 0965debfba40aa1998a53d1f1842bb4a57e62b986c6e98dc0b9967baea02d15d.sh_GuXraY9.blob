			MenuKey = c.Bind<KeyCode>("Controls", "MenuKey", (KeyCode)107, "Open the class / skill tree menu.");
			AbilityKey = c.Bind<KeyCode>("Controls", "AbilityKey", (KeyCode)102, "Use your class's active ability.");
			ShowHud = c.Bind<bool>("Controls", "ShowHud", true, "Show class, level, XP and ability cooldown on screen.");
			ShowMenuHint = c.Bind<bool>("Interface", "ShowMenuHint", true, "In the lobby and the shop, show a small hint with the key that opens the RepoRPG menu.");
			MenuHintInLevels = c.Bind<bool>("Interface", "MenuHintInLevels", false, "Also show the menu key hint during levels.");
			SalvageConfirm = c.Bind<string>("Controls", "SalvageConfirm", "Rare+", new ConfigDescription("Ask before salvaging: Rare+ (Rare and above), All, or None.", (AcceptableValueBase)(object)new AcceptableValueList<string>(new string[3] { "Rare+", "All", "None" }), Array.Empty<object>()));
			SalvageKey = c.Bind<KeyCode>("Controls", "SalvageKey", (KeyCode)120, "Gear tab: salvage the selected item.");
			PadSalvageButton = c.Bind<string>("Controller", "SalvageButton", "rs", "Gear tab: salvage the selected item.");
			TriageBars = c.Bind<bool>("Controls", "TriageBars", true, "Medic: health bars over teammates' heads (through walls, within range).");
			TriageList = c.Bind<bool>("Controls", "TriageList", true, "Medic: the team health list (left side, lowest health first).");
			TriageListY = c.Bind<float>("Controls", "TriageListY", 150f, new ConfigDescription("Medic: how far down (px, 1080p layout) the team list starts - below the game's own health display.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(60f, 900f), Array.Empty<object>()));
			ContractsHudOffset = c.Bind<float>("Controls", "ContractsHudOffset", 0f, new ConfigDescription("Moves the contracts list (bottom right) up by this many pixels (1080p layout), e.g. if another mod's HUD sits there.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 600f), Array.Empty<object>()));
			UiFont = c.Bind<string>("Controls", "UiFont", "auto", "Menu font: 'auto' uses the game's font when possible, else Bahnschrift/Impact. Or type any installed font name.");
			UiSounds = c.Bind<bool>("Controls", "UiSounds", true, "Play the game's menu hover/click sounds in the mod menu.");
			HoverSoundMs = c.Bind<float>("Controls", "HoverSoundMs", 70f, new ConfigDescription("Mod menu: at most one hover / navigation sound every this many milliseconds (a new one replaces the last, never stacks).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(20f, 500f), Array.Empty<object>()));
			UiDiagnostics = c.Bind<bool>("Debug", "UiDiagnostics", false, "Logs a timed profile of the mod's UI every 10s as [ui]: frame time, memory and garbage collections, OnGUI passes, UI sounds played / rate-limited, AudioSource and GameObject counts.");
			UiTextSize = c.Bind<TextSize>("Controls", "TextSizePreset", TextSize.Medium, "Old setting, replaced by UiTextScale (kept so an older choice carries over).");
			UiTextScale = c.Bind<float>("Controls", "UiTextScale", 1f, new ConfigDescription("Text size of the mod's menus and HUD, on top of the automatic sizing to your screen (0.75 = 75%, 2 = 200%). Also in the Controls tab.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.75f, 2f), Array.Empty<object>()));
			ReducedEffects = c.Bind<bool>("Controls", "ReducedEffects", false, "For weaker PCs: no menu button animation, slower HUD refresh. Gameplay is unchanged.");
			HealFeedback = c.Bind<HealFeedbackLevel>("Notifications", "HealingFeedback", HealFeedbackLevel.Standard, "Off / Minimal (green glow on the health display) / Standard (glow + one \"+X HP\" number; pop-ups for teammate heals, big heals and revives) / Detailed (also a pop-up per healing source). Personal, never synced.");
			HealSounds = c.Bind<bool>("Notifications", "HealingSounds", true, "A short, quiet sound when a teammate heals or revives you. Small and over-time heals are always silent.");
			LargeHealThreshold = c.Bind<int>("Notifications", "LargeHealThreshold", 25, new ConfigDescription("An instant heal of at least this many HP gets a pop-up (Standard).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(5, 100), Array.Empty<object>()));
			PopupsEnabled = c.Bind<bool>("Notifications", "Enabled", true, "Show the small notifications above your class / XP meter.");
			PopupXp = c.Bind<bool>("Notifications", "XpGains", true, "XP gains, with their source.");
			PopupLevel = c.Bind<bool>("Notifications", "LevelUps", true, "Level ups and points earned.");
			PopupLoot = c.Bind<bool>("Notifications", "Loot", true, "Gear found, rarity upgrades, appraisals.");
			PopupContracts = c.Bind<bool>("Notifications", "Contracts", true, "New and completed contracts.");
			PopupPerks = c.Bind<bool>("Notifications", "Perks", true, "Perk picks and unlocks.");
			PopupOther = c.Bind<bool>("Notifications", "Other", true, "Mod shop purchases and other small notices.");
			PopupCurrency = c.Bind<bool>("Notifications", "Currency", true, "Currency earned (and gifts).");
			PopupDuration = c.Bind<float>("Notifications", "Duration", 2.5f, new ConfigDescription("Seconds each notification stays.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 8f), Array.Empty<object>()));
			PopupMaxStack = c.Bind<int>("Notifications", "MaxStack", 5, new ConfigDescription("Most notifications shown at once.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(1, 8), Array.Empty<object>()));
			if (UiTextSize.Value != TextSize.Medium && Mathf.Approximately(UiTextScale.Value, 1f))
			{
				UiTextScale.Value = TextSizes.Scale(UiTextSize.Value);
				UiTextSize.Value = TextSize.Medium;
			}
			FitTextToBoxes = c.Bind<bool>("Controls", "FitTextToBoxes", true, "Text inside boxes (class cards, perks, skill nodes, gear) grows to fill spare room and shrinks when space is tight. Off = fixed size, only shrinking when it wouldn't fit.");
			MaxTextGrow = c.Bind<float>("Controls", "MaxTextGrow", 1.35f, new ConfigDescription("How much text in boxes may grow when there's room (1.35 = up to 35% bigger).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 2f), Array.Empty<object>()));
			MenuConfirmKey = c.Bind<KeyCode>("Controls", "MenuConfirm", (KeyCode)13, "Menu: select / confirm.");
			MenuBackKey = c.Bind<KeyCode>("Controls", "MenuBack", (KeyCode)27, "Menu: back one level (cancel, then tab bar, then close).");
			MenuTabLeftKey = c.Bind<KeyCode>("Controls", "MenuTabLeft", (KeyCode)113, "Menu: previous sub-tab (inside Character, Loot, Run or Options). Tab / Shift+Tab and 1-4 switch the main tabs.");
