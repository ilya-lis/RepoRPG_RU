			RewardContracts(Contracts.Progress(_store.Data.contracts, "Rescue"));
			if ((Object)(object)revived == (Object)(object)val)
			{
				NoteHeal(0, HealKind.Revive, "");
				NotTodayOnRevived(val);
			}
			if ((Object)(object)revived == (Object)(object)val && Ascension.A(13))
			{
				_ascReviveAt = Time.time + 0.6f;
			}
			if ((Object)(object)revived == (Object)(object)val && RunShape.Has("rapid_response"))
			{
				_invulnUntil = Mathf.Max(_invulnUntil, Time.time + 5f);
				Toast("Rapid Response: 5 s of safety", new Color(1f, 0.56f, 0.82f));
			}
			float num = TeamPlay.DownSeconds(revived);
			TeamPlay.OnRevived(revived);
			if ((Object)(object)revived == (Object)(object)val)
			{
				AttrOnRevived(val, revived, near: false);
			}
			if ((Object)(object)revived == (Object)(object)val || !Game.IsAlive(val))
			{
				return;
			}
			float num2 = Vector3.Distance(((Component)val).transform.position, ((Component)revived).transform.position);
			AttrOnRevived(val, revived, num2 <= Plugin.Cfg.ReviveShareRadius.Value);
			if (num2 <= Plugin.Cfg.ReviveShareRadius.Value)
			{
				bool flag = num >= 0f && num <= 10f;
				CEv("revive", 1f, flag ? 1 : 0);
				if (flag && CurrentId == "medic")
				{
					CEv("cls.medic");
				}
				TeamPlay.Add(TeamPlay.Ev.Revives, 1f);
				float num3 = ((CurrentId == "medic" || CurrentId == "undertaker") ? TeamPlay.ClutchBonus(num) : 0f);
				int baseAmount = Mathf.RoundToInt((float)Plugin.Cfg.ReviveXp.Value * (1f + num3 / 100f));
				GiveXp(baseAmount, Stat.ReviveXp, (num3 > 0f) ? "clutch revive" : "revive");
				Account.Count("revives");
				if (num >= 0f)
				{
					TeamPlay.Best(TeamPlay.Ev.Clutch, Mathf.Max(0.5f, 90f - num));
				}
			}
			float num4 = Mathf.Max(0f, Plugin.Cfg.MaxReviveHeal.Value - (float)Compat.MoreReviveExtra);
			int num5 = ((!Difficulty.IronBodies) ? Mathf.RoundToInt(Mathf.Min(_stats[Stat.ReviveHeal] * HealMoreMult, num4)) : 0);
			if (num5 > 0 && num2 <= Mathf.Max(_stats[Stat.AuraRadius], 10f))
			{
				((MonoBehaviour)this).StartCoroutine(HealAfter(revived, num5, 0.75f));
			}
		}

		public void OnPlayerDied(PlayerAvatar who)
		{
			if (Game.InLevel())
			{
				Contracts.Fail(_store.Data.contracts, "NoCasualties");
				CEv("death");
			}
			TeamPlay.OnDied(who);
			if ((Object)(object)who != (Object)null && (Object)(object)who == (Object)(object)Game.LocalPlayer())
			{
				PatchGuard.Run("dead man's pulse", delegate
				{
					PerkOnOwnDeath(who);
				});
				ClearOnDeath();
				PatchGuard.Run("death log", delegate
				{
					LogDeathSequence(who);
				});
			}
			else if ((Object)(object)who != (Object)null)
			{
				PatchGuard.Run("shepherd's bell", delegate
				{
					GearOnTeammateDown(who);
				});
				OnTeammateDied();
			}
			if ((Object)(object)who != (Object)null && Game.IsMaster())
			{
				PatchGuard.Run("insurer's bond", delegate
				{
					ClassHost.Instance?.HostBond(who);
				});
			}
		}

		private void ClearOnDeath()
		{
			ResetAbilityState(keepCooldown: true);
			_pactEnd = 0f;
			_drainAcc = 0f;
			_buffs.Clear();
			_selfDyn.Clear();
			_specialistPending = false;
			_statsDirty = true;
			ClassFx.HideAll();
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val != (Object)null && ClassHost.Overclocked(val, out var _, out var _))
			{
				Net.SendGunState(Game.ActorNumber(val), 0f, 0f, 0f);
			}
			if (_pull != null)
			{
				EndPull("died");
			}
			_hookAim = HookAim.None;
			_reachTarget = false;
			_voiceThrown = false;
		}

		private IEnumerator After(float seconds, Action then)
		{
			yield return (object)new WaitForSeconds(seconds);
			if (!Game.InLevel() || Game.IsLoading())
			{
				yield break;
			}
			try
			{
				then();
			}
			catch (Exception e)
			{
				Guard.Fail("delayed effect", e);
			}
		}

		private IEnumerator HealAfter(PlayerAvatar p, int amount, float delay)
		{
			yield return (object)new WaitForSeconds(delay);
			if ((Object)(object)p != (Object)null && (Object)(object)p.playerHealth != (Object)null && Game.IsAlive(p))
			{
				Game.HealOther(p.playerHealth, amount);
				Net.SendHealNotice(p, amount, HealKind.Instant, "Revive");
			}
		}

		public void OnTeamXp(Net.TeamXp kind)
		{
			//IL_00da: Unknown result type (might be due to invalid IL or missing references)
			if (kind == Net.TeamXp.LevelComplete)
			{
				if (kind == _lastTeamXp && Time.time < _teamXpDedupeUntil)
				{
					return;
				}
				_teamXpDedupeUntil = Time.time + 2f;
			}
			_lastTeamXp = kind;
			if (kind == Net.TeamXp.Extraction)
			{
				float num = Mathf.Max(Mathf.Clamp01(Plugin.Cfg.ExtractionXpFloor.Value), Mathf.Pow(Mathf.Clamp01(Plugin.Cfg.ExtractionXpFalloff.Value), (float)_extractionsThisLevel));
				if (_extractionsThisLevel == 0 && RunShape.Has("head_start") && Current != null && _charges < MaxCharges)
				{
					_charges = MaxCharges;
					_cooldownEnd = 0f;
					Toast("Head Start: " + ActiveName() + " recharged", new Color(0.66f, 0.55f, 1f));
				}
				_extractionsThisLevel++;
				GiveXp(Mathf.Max(1, Mathf.RoundToInt((float)Plugin.Cfg.ExtractionXp.Value * num)), Stat.ExtractXp, "extraction");
				RewardContracts(Contracts.Progress(_store.Data.contracts, "Haul"));
				CEv("extract");
				AddParts(new int[4] { 1, 0, 0, 0 }, "extraction");
				if (!RunDepth.NoExtractGear && Random.value * 100f < Plugin.Cfg.GearChanceOnExtraction.Value + _stats[Stat.GearFind])
				{
					FindGear(0, "extraction", _stats.Custom("perk.scrapper") > 0f);
				}
				PerkOnExtraction();
				AttuneAdd(2);
				int num2 = ((!Difficulty.IronBodies) ? Mathf.RoundToInt(Mathf.Min(_stats[Stat.ExtractionHeal] + (RunShape.Has("salvage_line") ? 6f : 0f) + ResearchCrew.ExtractionHealBonus, Plugin.Cfg.MaxExtractionHeal.Value)) : 0);
				PlayerAvatar val = Game.LocalPlayer();
				if (num2 > 0 && (Object)(object)val != (Object)null && (Object)(object)val.playerHealth != (Object)null && Game.IsAlive(val))
				{
					Game.HealSelf(val.playerHealth, num2);
					NoteHeal(num2, HealKind.Instant, "Extraction");
				}
			}
			else
			{
				GiveXp(Plugin.Cfg.LevelCompleteXp.Value, Stat.LevelXp, "level complete");
				AttuneAdd(10);
				Account.Count("levels");
				if (Difficulty.Tier >= DifficultyTier.Brutal)
				{
					Account.Count("brutal");
				}
				RewardContracts(Contracts.LevelCompleted(_store.Data.contracts, Time.time - _levelStartTime));
				PatchGuard.Run("contracts level end", ContractsLevelEnd);
				PatchGuard.Run("research level end", ResearchLevelEndLine);
				FindGear(0, "level reward");
				RouteRewardDef routeRewardDef = Routes.ClearReward(RunInfo.LevelIndex);
				if (routeRewardDef != null && routeRewardDef.kind == "gear")
				{
					FindGear(Mathf.Clamp(Mathf.RoundToInt(routeRewardDef.value), 0, 3), "route: " + routeRewardDef.name);
				}
				else if (routeRewardDef != null && routeRewardDef.kind == "parts")
				{
					AddParts(new int[4]
					{
						Mathf.Clamp(Mathf.RoundToInt(routeRewardDef.value), 0, 20),
						0,
						0,
						0
					}, "route: " + routeRewardDef.name);
				}
			}
		}

		private void RewardContracts(List<ContractState> done)
		{
			if (done.Count > 0 && Game.InLevel())
			{
				TeamPlay.Add(TeamPlay.Ev.Contracts, done.Count);
			}
			if (done.Count > 0)
			{
				AddParts(new int[4]
				{
					2 * done.Count,
					0,
					0,
					0
				}, "contract");
			}
			if (done.Count > 0)
			{
				Account.Count("contracts", done.Count);
			}
			foreach (ContractState item in done)
			{
				Notify(PopupKind.Contract, "Contract complete: " + Contracts.Title(item));
				Research.OnContractDone(Contracts.Title(item));
				GiveXp(item.rewardXp, null, "contract");
				if (item.rewardGearFloor >= 0)
				{
					FindGear(item.rewardGearFloor, "contract");
				}
				if (item.rewardAttributePoints > 0)
				{
					_store.Data.bonusAttributePoints += item.rewardAttributePoints;
					Notify(PopupKind.Contract, $"+{item.rewardAttributePoints} attribute point (contract)");
				}
			}
			if (done.Count > 0)
			{
				_store.MarkDirty();
			}
		}

		private GearItem FindGear(int rarityFloor, string source, bool scrapper = false)
		{
			Random random = new Random();
			float luck = _stats[Stat.GearLuck] + Mathf.Max(0f, Difficulty.Payout() - 1f) * 10f + RunThreat.LuckBonus(RunThreat.Fixed) + RunShape.LuckBonus + Ascension.Luck;
			GearItem gearItem = Gear.Roll(random, luck, rarityFloor);
			if (scrapper && gearItem.rarity < Mathf.Min(3, Gear.MaxRarity))
			{
				gearItem = Gear.Roll(random, luck, gearItem.rarity + 1);
			}
			if (RunShape.Has("lucky_break") && gearItem.rarity < Gear.MaxRarity && random.NextDouble() < 0.1)
			{
				gearItem = Gear.RollExact(random, gearItem.rarity + 1, gearItem.slot);
			}
			if (gearItem.rarity >= 2 && random.NextDouble() * 100.0 < (double)Plugin.Cfg.SetPieceChance.Value)
			{
				GearSets.MakeSetPiece(gearItem, random);
			}
			gearItem.freeValue = SalvageCalc.Gross(gearItem);
			return GiveGear(gearItem, source);
		}

		private GearItem GiveGear(GearItem item, string source)
		{
			//IL_018e: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			data.inventory.Add(item);
			NoteUniqueFoundE(item);
			if (item.rarity >= 2)
			{
				PerkBump("rarefinds", 1);
			}
			while (data.inventory.Count > InventoryCap)
			{
				GearItem gearItem = null;
				foreach (GearItem item2 in data.inventory)
				{
					if (!data.IsEquipped(item2) && item2 != item && !GearX.Soulbound(item2) && !Cursed.Is(item2) && !Starters.Is(item2) && (gearItem == null || item2.rarity + ((item2.set != "") ? 10 : 0) < gearItem.rarity + ((gearItem.set != "") ? 10 : 0)))
					{
						gearItem = item2;
					}
				}
				if (gearItem == null)
				{
					break;
				}
				Salvage(gearItem, quiet: true);
			}
			RarityDef rarityDef = Gear.Rarity(item.rarity);
			SetDef setDef = GearSets.Get(item.set);
			if (!Cursed.Is(item))
			{
				Notify(PopupKind.Loot, "Found " + rarityDef.name + " " + item.name + ((setDef != null) ? (" [" + setDef.name + " set]") : "") + " (" + source + ")", ParseColor(rarityDef.color));
			}
			_store.MarkDirty();
			_store.SaveNow();
			return item;
		}

		public void Equip(GearItem g)
		{
			//IL_0078: Unknown result type (might be due to invalid IL or missing references)
			int num = Plugin.Rpg.SlotIndex(g.slot);
			if (num < 0)
			{
				return;
			}
			if (Starters.Is(g) && g.starter != CurrentId)
			{
				ClassDef classDef = Plugin.Db.Get(g.starter);
				Toast(g.name + ": " + ((classDef != null) ? classDef.name : g.starter) + " only", new Color(1f, 0.6f, 0.4f));
				return;
			}
			if (Cursed.Is(g))
			{
				GearItem gearItem = OtherCursedWorn(g);
				if (gearItem != null)
				{
					Unequip(gearItem);
				}
			}
			_store.Data.equipped[num] = g.uid;
			_store.MarkDirty();
			_statsDirty = true;
		}

		public void Unequip(GearItem g)
		{
			string[] equipped = _store.Data.equipped;
			for (int i = 0; i < equipped.Length; i++)
			{
				if (equipped[i] == g.uid)
				{
					equipped[i] = "";
				}
			}
			_store.MarkDirty();
			_statsDirty = true;
		}

		public void Salvage(GearItem g, bool quiet = false)
		{
			Unequip(g);
			ModulesBackToBag(g);
			_store.Data.inventory.Remove(g);
			int num = Gear.Rarity(g.rarity).salvageXp * ((!GearX.Has(g, "gear.studious")) ? 1 : 2);
			if (CurrentId == "quartermaster")
			{
				num = Mathf.RoundToInt((float)num * (1f + Mathf.Clamp(ClassStat("quartermaster.salvage"), 0f, 100f) / 100f));
			}
			if (quiet)
			{
				Notify(PopupKind.Loot, "Inventory full: salvaged " + g.name);
			}
			GiveXp(num, null, "salvage");
			_store.MarkDirty();
		}

