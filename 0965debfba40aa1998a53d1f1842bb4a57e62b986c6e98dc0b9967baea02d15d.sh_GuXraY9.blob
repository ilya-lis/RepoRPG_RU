		public void SendAccountSummarySoon()
		{
			_summaryAt = Time.unscaledTime + 1f;
		}

		private void TickAccountSummary()
		{
			if (Game.IsMultiplayer())
			{
				int count = Game.Players().Count;
				if (count != _summaryPlayers)
				{
					_summaryPlayers = count;
					_summaryAt = Mathf.Min(_summaryAt, Time.unscaledTime + 2f);
				}
				if (!(Time.unscaledTime < _summaryAt))
				{
					_summaryAt = Time.unscaledTime + 60f;
					Net.SendAccountSummary(_summarySent = Account.Summary());
				}
			}
		}

		private void GiveStarterUnlocks(RunSave run)
		{
			if (!run.starterGiven && Game.InLevel())
			{
				run.starterGiven = true;
				if (Account.Active("starter_kit"))
				{
					GearItem gearItem = Gear.RollExact(new Random(), 1, null);
					gearItem.freeValue = SalvageCalc.Gross(gearItem);
					GiveGear(gearItem, "Starter kit");
				}
				if (Account.Active("field_kit"))
				{
					AddParts(new int[4] { 3, 1, 0, 0 }, "Field kit");
				}
				if (Account.Active("seed_money"))
				{
					Net.SendStarterScrap(15);
				}
				_store.MarkDirty();
			}
		}

