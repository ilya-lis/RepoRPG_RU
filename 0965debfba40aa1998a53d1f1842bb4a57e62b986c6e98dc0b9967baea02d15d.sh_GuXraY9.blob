			PerkEvery = c.Bind<int>("Perks", "PerkEvery", 5, "Earn a perk pick every N levels of your best class this run (0 = perks off).");
			PerkChoices = c.Bind<int>("Perks", "PerkChoices", 3, "How many perks are offered per pick.");
			CursedPerks = c.Bind<bool>("Perks", "CursedPerks", true, "Cursed perks (a strong bonus with a real drawback) can turn up in perk offers. Off: never offered, and cursed perks already owned do nothing.");
			PerkEvolutions = c.Bind<bool>("Perks", "Evolutions", true, "Evolving perks: some perks grow into a stronger version after a challenge during the run.");
			PerkTagBonuses = c.Bind<bool>("Perks", "TagBonuses", true, "Tag bonuses: owning 3 or 5 perks with the same tag adds a bonus.");
			PerkRerollStep = c.Bind<int>("Perks", "RerollStep", 15, new ConfigDescription("Each perk reroll in the same level costs this much more Scrap (the first costs Shop > PerkRerollScrap).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 500), Array.Empty<object>()));
			AttrMilestones = c.Bind<bool>("Attributes", "Milestones", true, "Attribute milestones: 5, 10 and 15 points in an attribute add a bonus (a class's favored attributes reach them a point sooner).");
			AttrPairings = c.Bind<bool>("Attributes", "Pairings", true, "Attribute pairings: 8 points in both attributes of a pair adds a combo bonus.");
			AttrMilestoneStrength = c.Bind<float>("Attributes", "MilestoneStrength", 1f, new ConfigDescription("Multiplies every milestone and pairing number.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.25f, 2f), Array.Empty<object>()));
			PerkBanishes = c.Bind<int>("Perks", "Banishes", 1, new ConfigDescription("Perks each player can banish per run (a banished perk is never offered again). 0 = off.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 5), Array.Empty<object>()));
			UpgradeXp = c.Bind<int>("RPG", "UpgradeXp", 24, "Mod XP for using a shop upgrade (x1.5 per rarity tier, x2 for your class's favourite upgrades).");
			UpgradeRarity = c.Bind<bool>("RPG", "UpgradeRarity", true, "Shop upgrades roll a rarity: Rare+ also give an attribute point, Epic+ gear, Legendary a perk pick.");
			ShopAnywhere = c.Bind<bool>("Shop", "ShopAnywhere", false, "Allow mod shop purchases outside the game's shop.");
			ShowPurchases = c.Bind<bool>("Shop", "ShowPurchases", true, "Show everyone a message when someone buys something in the mod shop.");
			LogContrast = c.Bind<bool>("Debug", "LogContrast", false, "Logs (once each) any mod UI text whose colour fails the contrast minimum (4.5:1 text, 3:1 headings) against the theme's panels.");
			HudDiagnostics = c.Bind<bool>("Debug", "HudDiagnostics", false, "Logs what could make the HUD flicker: font texture rebuilds, the HUD hiding / showing, run data reloading, class / theme changes (with counts every 10s), and every change to what the contracts panel draws (frame number, what changed, stack trace), double draws, extra instances and other UI overlapping it. Logs a lot: testing only.");
			AbilityDiagnostics = c.Bind<bool>("Debug", "AbilityDiagnostics", false, "Logs every stage of using a class ability (key, checks, what the host was asked, what it did) - for tracking down an ability that does nothing.");
			NetDropPercent = c.Bind<float>("Debug", "NetDropPercent", 0f, new ConfigDescription("Testing only: drops this % of the RepoRPG messages your game receives, to check everything that waits on another player times out cleanly. 0 = off.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
			CartSprintSpeed = c.Bind<float>("Carts", "PlayerSprintSpeed", 5f, new ConfigDescription("A player's sprint speed in m/s, used until the host has measured real sprinting (the measured speed is used after that; see CartSpeedLog). Follow and Overdrive speeds are set relative to it.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(2f, 12f), Array.Empty<object>()));
			CartFollowDistance = c.Bind<float>("Carts", "FollowDistance", 2.6f, new ConfigDescription("Loyal Cart: how far behind you (m, from the cart's front) it settles. It slows smoothly as it gets there.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 8f), Array.Empty<object>()));
			CartFollowCatchUp = c.Bind<float>("Carts", "FollowCatchUp", 0.8f, new ConfigDescription("Loyal Cart: extra speed (m/s) for every meter it is behind the follow distance, on top of matching your speed - the farther behind, the faster.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 5f), Array.Empty<object>()));
			CartFollowMaxSpeed = c.Bind<float>("Carts", "FollowMaxSpeed", 1.15f, new ConfigDescription("Loyal Cart: top catch-up speed, as a multiple of sprint speed.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.5f, 2f), Array.Empty<object>()));
			CartOverdriveSpeed = c.Bind<float>("Carts", "OverdriveSpeed", 1.3f, new ConfigDescription("Cart Overdrive: base driving speed, as a multiple of sprint speed (before talents and ability power).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.5f, 3f), Array.Empty<object>()));
			CartAccelTime = c.Bind<float>("Carts", "AccelerationTime", 1f, new ConfigDescription("Seconds a self-driving cart takes to reach full speed (it brakes 1.5x as fast).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.2f, 5f), Array.Empty<object>()));
			CartLoadPenalty = c.Bind<float>("Carts", "LoadPenalty", 20f, new ConfigDescription("% speed lost with a full load (at most 25%, so a full cart keeps at least 75% of its speed). Scales with the load's mass.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 25f), Array.Empty<object>()));
			CartFullLoadMass = c.Bind<float>("Carts", "FullLoadMass", 60f, new ConfigDescription("Load mass (the game's mass units) that counts as a full load for LoadPenalty.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(5f, 500f), Array.Empty<object>()));
			CartCornerAngle = c.Bind<float>("Carts", "CornerAngle", 40f, new ConfigDescription("Turns sharper than this (degrees) slow the cart; smaller path adjustments don't.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(10f, 120f), Array.Empty<object>()));
			CartCornerMinSpeed = c.Bind<float>("Carts", "CornerMinSpeed", 45f, new ConfigDescription("% of its speed the cart keeps through the sharpest turns.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(15f, 100f), Array.Empty<object>()));
			CartMaxSpeed = c.Bind<float>("Carts", "MaxSpeed", 9f, new ConfigDescription("Safety cap (m/s) on any self-driving cart, whatever the talents and ability power, so loads stay in.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(3f, 20f), Array.Empty<object>()));
			CartSpeedBonusCap = c.Bind<float>("Carts", "SpeedBonusCap", 100f, new ConfigDescription("Cap (%) on the Cartwright's cart-speed talents (Teamster, Momentum Cart, Tight Turns...) added to both follow and Overdrive.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
			CartFollowTrail = c.Bind<bool>("Carts", "FollowTrail", true, "Loyal Cart drives along the path you actually walked (same doors, same corners) instead of heading straight for where you are.");
			CartParkBeside = c.Bind<bool>("Carts", "ParkBeside", true, "When you stop, Loyal Cart parks beside / behind you wherever there's room - never in a doorway or narrow spot, never next to a monster.");
			CartMakeWay = c.Bind<bool>("Carts", "MakeWay", true, "When you walk back toward Loyal Cart it pulls aside to let you past instead of blocking the corridor.");
			CartAvoidMonsters = c.Bind<bool>("Carts", "AvoidMonsters", true, "Loyal Cart waits while a monster is near the next stretch of its route (it keeps moving if the monster is already on top of it).");
			CartMonsterRadius = c.Bind<float>("Carts", "MonsterRadius", 4f, new ConfigDescription("How close (m) a monster must be to the cart's route to make it wait.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 12f), Array.Empty<object>()));
			CartMonsterWaitMax = c.Bind<float>("Carts", "MonsterWaitMax", 8f, new ConfigDescription("Longest it waits for a monster (s) before following anyway.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 60f), Array.Empty<object>()));
			CartLootAssist = c.Bind<bool>("Carts", "LootAssist", true, "When you hold a valuable and stand still, Loyal Cart comes round in front of you so you can drop it in.");
			CartWaitAtExtraction = c.Bind<bool>("Carts", "WaitAtExtraction", true, "A cart at an open extraction point stays there while you haul nearby (within ExtractionWaitRange), and follows again when you go farther.");
			CartExtractionWaitRange = c.Bind<float>("Carts", "ExtractionWaitRange", 12f, new ConfigDescription("How far (m) you can go from a cart waiting at an extraction point before it follows you again.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 30f), Array.Empty<object>()));
			CartDoorwaySpeed = c.Bind<float>("Carts", "DoorwaySpeed", 55f, new ConfigDescription("% of its speed a self-driving cart keeps while lining up for and driving through a doorway or narrow walkway.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(20f, 100f), Array.Empty<object>()));
			CartDebugDraw = c.Bind<bool>("Debug", "CartDebugDraw", false, "Host: draws each self-driving cart's footprint (cyan), route (green, opening centres yellow), ground probes (green floor, red drop, blue wall beside), side grazes (orange) and blocking hits (red), and logs every reason it stops as [cart stop].");
			CartDoorwayReport = c.Bind<bool>("Debug", "CartDoorwayReport", false, "Host: measures every doorway / narrow walkway a self-driving cart drives into (its width against the cart's, every stop and its reason, grazes, back-ups) and writes the totals to BepInEx/config/RepoRPG_cart_doorways.txt. Logged as [cart doorway].");
			CartLeadIn = c.Bind<float>("Carts", "DoorwayLeadIn", 1.2f, new ConfigDescription("How far (m) before a doorway / narrow walkway the route lines up with its centre line.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.3f, 3f), Array.Empty<object>()));
			CartLookTight = c.Bind<float>("Carts", "LookaheadTight", 0.7f, new ConfigDescription("Steering lookahead (m) while lining up for and driving through an opening: shorter follows the centre line more closely.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.2f, 2f), Array.Empty<object>()));
			CartLookMin = c.Bind<float>("Carts", "LookaheadMin", 1f, new ConfigDescription("Steering lookahead (m) at low speed in the open.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.3f, 3f), Array.Empty<object>()));
			CartLookMax = c.Bind<float>("Carts", "LookaheadMax", 2.5f, new ConfigDescription("Steering lookahead (m) at full speed in the open (longer = smoother curves).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.5f, 5f), Array.Empty<object>()));
			CartNudge = c.Bind<float>("Carts", "FrameNudge", 0.25f, new ConfigDescription("How hard a cart that grazes a door frame steers back toward the centre (each graze; it fades out).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.05f, 1f), Array.Empty<object>()));
			CartProbeMax = c.Bind<float>("Carts", "GroundProbeMax", 3f, new ConfigDescription("Farthest (m) ahead along its route a self-driving cart checks the floor for ledges and stairs (it looks farther the faster it goes, up to this).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 6f), Array.Empty<object>()));
			CartEdgeMemory = c.Bind<float>("Carts", "EdgeMemory", 20f, new ConfigDescription("Seconds a cart remembers a spot where it twice had to stop for stairs, a steep slope or a ledge, and won't route through it. 0 = off.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 120f), Array.Empty<object>()));
			CartStuckSeconds = c.Bind<float>("Carts", "StuckSeconds", 3f, new ConfigDescription("Seconds without real progress before a cart counts as stuck (backs up and re-routes, twice, then gives up).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 10f), Array.Empty<object>()));
			CartSpeedLog = c.Bind<bool>("Debug", "CartSpeedLog", false, "Logs self-driving carts twice a second: target and actual speed, applied velocity change, mass, load, drag, what is slowing it, and measured player speeds. Clients log the speed they see.");
			NetDelayMs = c.Bind<int>("Debug", "NetDelayMs", 0, new ConfigDescription("Testing only: delays every RepoRPG message your game receives by this many milliseconds. 0 = off.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 20000), Array.Empty<object>()));
			DebugTools = c.Bind<bool>("Debug", "DebugTools", false, "Host only: adds a Debug tab with test tools (XP, levels, gear, elites, money, skip level, class switch, set level, skill points, run any active, simulated deaths, stat breakdown) and logs each ability stage. Never synced to clients.");
			PriceGearCrate = c.Bind<int>("Shop", "GearCrateScrap", 40, "Price in Scrap: random gear, Uncommon or better.");
			SalvageExtraLineScrap = c.Bind<int>("Shop", "SalvageExtraLineScrap", 1, "Salvage: extra Scrap per stat line beyond the rarity's usual count (base Scrap per rarity is salvageScrap in rpg.json).");
			SalvageUniqueScrap = c.Bind<int>("Shop", "SalvageUniqueScrap", 3, "Salvage: extra Scrap for gear with a unique effect.");
			SalvageMaxOfSpent = c.Bind<float>("Shop", "SalvageMaxOfSpent", 50f, new ConfigDescription("Salvage: the part of an item's value bought with Scrap (crates, rerolls, upgrades) pays back at most this % of the Scrap spent - so buying to salvage always loses Scrap.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 90f), Array.Empty<object>()));
			SalvageGivesXp = c.Bind<bool>("Shop", "SalvageGivesXp", true, "Salvage also gives the rarity's salvage XP, as before.");
			PricePremiumCrate = c.Bind<int>("Shop", "PremiumCrateScrap", 100, "Price in Scrap: random gear, Rare or better.");
			PriceGearReroll = c.Bind<int>("Shop", "GearRerollScrap", 30, "Price in Scrap: reroll a gear item's stats (same rarity).");
			PriceGearUpgrade = c.Bind<int>("Shop", "GearUpgradeScrap", 80, "Price in Scrap: reroll a gear item one rarity higher.");
			PricePerkReroll = c.Bind<int>("Shop", "PerkRerollScrap", 30, "Price in Scrap: new perk choices.");
			ShopRotationSize = c.Bind<int>("Shop", "RotationSize", 0, new ConfigDescription("Gear slots added to (or taken from) each player's rotating stock.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(-2, 3), Array.Empty<object>()));
			ShopPriceMultiplier = c.Bind<float>("Shop", "PriceMultiplier", 1f, new ConfigDescription("Multiplies the prices of stock, modules, consumables, services and crates.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.25f, 4f), Array.Empty<object>()));
			ShopReputationSpeed = c.Bind<float>("Shop", "ReputationSpeed", 1f, new ConfigDescription("Reputation per Scrap spent in the mod shop.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 5f), Array.Empty<object>()));
			ShopCrates = c.Bind<bool>("Shop", "Crates", true, "Sell Mystery Crates.");
			ShopConsumablesPerLevel = c.Bind<int>("Shop", "ConsumablesPerLevel", 3, new ConfigDescription("Different consumables a player can buy per shop visit (1 of each).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 6), Array.Empty<object>()));
			ShopLockFee = c.Bind<int>("Shop", "LockFee", 10, new ConfigDescription("Scrap to lock a stock item so it stays for the next rotation.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 200), Array.Empty<object>()));
			PriceRespec = c.Bind<int>("Shop", "RespecScrap", 20, "Price in Scrap to refund skill or attribute points (0 = free, anywhere).");
			CurrencyName = c.Bind<string>("Currency", "Name", "RPG Scrap", "Full name of the mod's currency.");
			CurrencyShort = c.Bind<string>("Currency", "ShortName", "Scrap", "Short name shown next to amounts.");
			CurrencySymbol = c.Bind<string>("Currency", "Symbol", "S", "One or two characters shown in the currency badge.");
			ScrapPercent = c.Bind<float>("Currency", "Percent", 10f, new ConfigDescription("Bonus currency created when the team earns money, as a % of it ($100 of team money = 1 at 100%). Team money is never reduced.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
			ScrapSplit = c.Bind<ScrapSplitMode>("Currency", "SplitMode", ScrapSplitMode.Equal, "Equal: everyone in the game gets the same share. ByContribution: half is shared equally, half by the value of the valuables each player carried out this level.");
			StartingScrap = c.Bind<int>("Currency", "StartingAmount", 0, "Balance for players new to a save (including ones who join mid-run).");
			AllowGifting = c.Bind<bool>("Currency", "AllowGifting", false, "Let players give some of their currency to teammates (in the Shop tab).");
			GuideSeen = c.Bind<bool>("Internal", "GuideSeen", false, "The getting-started guide was shown (set to false to see it again on the next menu open; it's always in the Guide tab).");
			LastTab = c.Bind<string>("Internal", "LastTab", "Class", "The menu tab you had open last (reopened next time).");
			LastClassViewed = c.Bind<string>("Internal", "LastClassViewed", "", "The class you were looking at last in the menu.");
			MenuUndoKey = c.Bind<KeyCode>("Controls", "MenuUndo", (KeyCode)122, "Menu: undo the last pending point (Class and Attributes tabs).");
			ReducedMotion = c.Bind<bool>("Controls", "ReducedMotion", false, "Accessibility: no tab fades, colour fades or pulsing (Reduced effects also turns these off).");
			ColorblindMode = c.Bind<bool>("Controls", "ColorblindMode", false, "Accessibility: things shown by colour also get a letter or shape (rarity letters on markers, status symbols).");
			HudScale = c.Bind<float>("Controls", "HudScale", 1f, new ConfigDescription("Accessibility: size of the bottom-left HUD card (1 = normal), separate from the text size.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 1.6f), Array.Empty<object>()));
			HudBackgroundOpacity = c.Bind<float>("Interface", "HudBackgroundOpacity", 0.55f, new ConfigDescription("Bottom-left HUD card: how dark its background is (0 = none, 1 = solid).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 1f), Array.Empty<object>()));
			HudCompact = c.Bind<bool>("Interface", "HudCompact", false, "Bottom-left HUD card: compact mode - short status icons, no class status lines.");
			PerfPreset = c.Bind<PerfPreset>("Performance", "Preset", RepoRPG.PerfPreset.Medium, "Auto (picks Low, Medium or High from your frame time in the first minute of play), Low, Medium, High, or Custom (set by hand below / in HUD).");
			PerfBarRange = c.Bind<float>("Performance", "HealthBarRange", 120f, new ConfigDescription("Medic health bars over heads: the most metres they show at (never more than the Medic's own range).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(10f, 120f), Array.Empty<object>()));
			PerfFxRings = c.Bind<int>("Performance", "MaxEffectRings", 12, new ConfigDescription("Ability rings and markers on the floor shown at once (the oldest gives way).", (AcceptableValueBase)(object)new AcceptableValueRange<int>(4, 12), Array.Empty<object>()));
			PerfAutoPicked = c.Bind<string>("Performance", "AutoPicked", "", "What Auto picked last time (for your information).");
			HudConfigVersion = c.Bind<int>("HUD", "ConfigVersion", 1, "Version of these HUD settings (for future updates to move them over). Don't change it.");
			HudCardShow = c.Bind<HudShow>("HUD", "Card", HudShow.Always, "Bottom-left HUD card (master): Always, TruckAndShop, LevelsOnly or Never. Off hides the whole card; everything on it keeps working.");
			HudIdentity = c.Bind<bool>("HUD", "Identity", true, "HUD card: the class row (class icon, name and level).");
			HudScrap = c.Bind<bool>("HUD", "Scrap", true, "HUD card: your Scrap, on the class row.");
			HudXpBar = c.Bind<bool>("HUD", "XpBar", true, "HUD card: the XP bar.");
			HudAbility = c.Bind<bool>("HUD", "Ability", true, "HUD card: the ability row (cooldown circle, key, name, state). Your ability works either way.");
			HudAbilityName = c.Bind<bool>("HUD", "AbilityName", true, "HUD card: the ability's name on the ability row.");
			HudExtraKeys = c.Bind<bool>("HUD", "ExtraKeys", true, "HUD card: a row under the ability with your class's other keys (Cart follow, Hum, Hand off, Swap copy) and their state. Only for classes that have them.");
			HudClassLines = c.Bind<HudShow>("HUD", "ClassLines", HudShow.Always, "HUD card: your class's own lines (drop pad, cart state, Inspire, copied ability, Gambler status, enemies nearby...): Always, TruckAndShop, LevelsOnly or Never.");
			HudChipChapter = c.Bind<bool>("HUD", "ChipChapter", true, "HUD card, run status: the chapter and next milestone chips.");
			HudChipStreak = c.Bind<bool>("HUD", "ChipStreak", true, "HUD card, run status: the streak chip.");
			HudChipHeat = c.Bind<bool>("HUD", "ChipHeat", true, "HUD card, run status: the heat chip.");
			HudChipAscension = c.Bind<bool>("HUD", "ChipAscension", true, "HUD card, run status: the Ascension chip.");
			HudChipCrew = c.Bind<bool>("HUD", "ChipCrew", true, "HUD card, run status: the crew level chip.");
			HudChipPayout = c.Bind<bool>("HUD", "ChipPayout", true, "HUD card, run status: the payout tier chip.");
