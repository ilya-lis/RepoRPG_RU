		private void DebugDeath(string kind)
		{
			//IL_005c: Unknown result type (might be due to invalid IL or missing references)
			PlayerAvatar val = Game.LocalPlayer();
			PlayerHealth val2 = val?.playerHealth;
			if (!DebugAvailable || (Object)(object)val == (Object)null || (Object)(object)val2 == (Object)null || !Game.IsAlive(val) || !Game.InLevel())
			{
				return;
			}
			DebugLog("simulate death: " + kind);
			if (GameIgnoresHurt(val, val2))
			{
				Toast("The game is ignoring hits right now (invulnerable)", Color.gray);
				return;
			}
			int num = Game.Health(val2);
			try
			{
				if (!(kind == "fall"))
				{
					if (kind == "pit")
					{
						KillHit = true;
						try
						{
							val2.Hurt(num + 100, false, -1, false);
							return;
						}
						finally
						{
							KillHit = false;
						}
					}
					val2.Hurt(Mathf.Max(num * 3, 200), false, -1, false);
				}
				else
				{
					ResolveFall(val2);
				}
			}
			catch (Exception arg)
			{
				Plugin.Log.LogError((object)$"[debug] simulated {kind} threw: {arg}");
			}
		}

