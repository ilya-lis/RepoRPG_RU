			_dirty = false;
			_nextSend = 0f;
			HostStats.Clear();
			Reported.Clear();
			LastHolder.Clear();
			CartOf.Clear();
			Credited.Clear();
			DiedAt.Clear();
			_cardSent = false;
			_nextHostTick = 0f;
			_finalHaul = false;
			_allDoneAt = -1f;
		}

		public static void PlayerLeft(int actor)
		{
			Reported.Remove(actor);
			DiedAt.Remove(actor);
		}
	}
	internal static class Tuning
	{
		private static string Path => System.IO.Path.Combine(ClassDatabase.Folder, "tuning-log.txt");

		public static void Note(string topic, string line)
		{
			try
			{
				string path = Path;
				if (File.Exists(path) && new FileInfo(path).Length > 524288)
				{
					string text = File.ReadAllText(path);
					File.WriteAllText(path, text.Substring(text.Length / 2));
				}
				File.AppendAllText(path, $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} [{topic}] run {RunInfo.RunId} level {RunInfo.LevelIndex}: {line}\n");
			}
			catch
			{
			}
		}
	}
	internal static class Upgrades
	{
		public sealed class UseState
		{
			public string SteamId = "";

			public int Actor = -1;

			public int ViewId;

			public string GuessedKey = "";

			public Dictionary<string, int> Before = new Dictionary<string, int>();

			public Dictionary<string, Dictionary<string, int>> AllBefore = new Dictionary<string, Dictionary<string, int>>();

			public float At;
		}

		private static List<FieldInfo>? _dicts;

		private static readonly (string frag, string key)[] Aliases = new(string, string)[19]
		{
			("DeathHeadBattery", "DeathHeadBattery"),
			("MapPlayerCount", "MapPlayerCount"),
			("TumbleLaunch", "Launch"),
			("TumbleWings", "TumbleWings"),
			("TumbleClimb", "TumbleClimb"),
			("GrabStrength", "Strength"),
			("SprintSpeed", "Speed"),
			("CrouchRest", "CrouchRest"),
			("GrabThrow", "Throw"),
			("GrabRange", "Range"),
			("ExtraJump", "ExtraJump"),
			("Stamina", "Stamina"),
			("Energy", "Stamina"),
			("Health", "Health"),
			("Strength", "Strength"),
			("Throw", "Throw"),
			("Range", "Range"),
			("Speed", "Speed"),
			("Launch", "Launch")
		};

		private static readonly HashSet<int> PaidOut = new HashSet<int>();

		private static readonly HashSet<int> Rechecking = new HashSet<int>();

		private static readonly FieldInfo? DoneField = AccessTools.Field(typeof(ItemUpgrade), "upgradeDone");

		private static readonly FieldInfo? IsPlayerField = AccessTools.Field(typeof(ItemUpgrade), "isPlayerUpgrade");

		private static readonly FieldInfo? ToggleStateField = AccessTools.Field(typeof(ItemToggle), "toggleState");

		private static readonly FieldInfo? TogglePlayerField = AccessTools.Field(typeof(ItemToggle), "playerTogglePhotonID");

		private static readonly HashSet<int> DupChecking = new HashSet<int>();

		private static readonly List<float> Uses = new List<float>();

		private static int _usesSinceLevel;

		private static string? _sharingMods;

		private static readonly Dictionary<string, int> _lastStamina = new Dictionary<string, int>();

		private static List<FieldInfo> Dicts()
		{
			if (_dicts != null)
			{
				return _dicts;
			}
			_dicts = new List<FieldInfo>();
			FieldInfo[] fields = typeof(StatsManager).GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
			foreach (FieldInfo fieldInfo in fields)
			{
				if (fieldInfo.Name.StartsWith("playerUpgrade", StringComparison.Ordinal) && typeof(Dictionary<string, int>).IsAssignableFrom(fieldInfo.FieldType))
				{
					_dicts.Add(fieldInfo);
				}
			}
			if (_dicts.Count == 0)
			{
				Game.WarnOnce("No playerUpgrade* stats found; shop upgrade bonuses are off.");
			}
			return _dicts;
		}

		public static Dictionary<string, int> Snapshot(string steamId)
		{
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			StatsManager instance = StatsManager.instance;
			if ((Object)(object)instance == (Object)null || string.IsNullOrEmpty(steamId))
			{
				return dictionary;
			}
			foreach (FieldInfo item in Dicts())
			{
				try
				{
					if (item.GetValue(instance) is Dictionary<string, int> dictionary2 && dictionary2.TryGetValue(steamId, out var value))
					{
						dictionary[item.Name.Substring("playerUpgrade".Length)] = value;
					}
				}
				catch
				{
				}
			}
			return dictionary;
		}

		public static string Changed(Dictionary<string, int> before, Dictionary<string, int> after)
		{
			foreach (KeyValuePair<string, int> item in after)
			{
				before.TryGetValue(item.Key, out var value);
				if (item.Value > value)
				{
					return item.Key;
				}
			}
			return "";
		}

		public static int Rarity(int viewId)
		{
			RarityDef[] rarities = Plugin.Rpg.rarities;
			Random random = RunInfo.RngFor(viewId * 6151 + RunInfo.LevelIndex * 7907 + 3);
			double num = 0.0;
			RarityDef[] array = rarities;
			foreach (RarityDef rarityDef in array)
			{
				num += (double)Math.Max(0f, rarityDef.weight);
			}
			double num2 = random.NextDouble() * num;
			for (int j = 0; j < rarities.Length; j++)
			{
				num2 -= (double)Math.Max(0f, rarities[j].weight);
				if (num2 <= 0.0)
				{
					return j;
				}
			}
			return 0;
		}

		public static float XpMultiplier(int rarity)
		{
			return 1f + 0.5f * (float)rarity;
		}

		public static string GuessKey(Component item)
		{
			StringBuilder stringBuilder = new StringBuilder(((Object)item.gameObject).name);
			Component[] components = item.GetComponents<Component>();
			foreach (Component val in components)
			{
				if ((Object)(object)val != (Object)null)
				{
					stringBuilder.Append('|').Append(((object)val).GetType().Name);
				}
			}
			string text = stringBuilder.ToString().Replace(" ", "");
			(string, string)[] aliases = Aliases;
			for (int i = 0; i < aliases.Length; i++)
			{
				var (value, result) = aliases[i];
				if (text.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0)
				{
					return result;
				}
			}
			return "";
		}

		public static string Name(string key)
		{
			return Plugin.Rpg.Upgrade(key)?.name ?? key;
		}

		public static List<string> DescribeReward(string key, int rarity, ClassDef? cls)
		{
			List<string> list = new List<string>();
			bool flag = cls?.HasAffinity(key) ?? false;
			int num = Mathf.RoundToInt((float)Plugin.Cfg.UpgradeXp.Value * XpMultiplier(rarity) * (flag ? 2f : 1f));
			float num2 = (RpgRuntime.Instance?.XpBonusMult(null) ?? 1f) * Plugin.Cfg.XpMultiplier.Value;
			num = Mathf.RoundToInt((float)num * num2);
			list.Add($"+{num} XP" + (flag ? (" (x2 " + cls.name + " affinity)") : ""));
			UpgradeDef upgradeDef = Plugin.Rpg.Upgrade(key);
			if (upgradeDef != null)
			{
				List<string> list2 = new List<string>();
				EffectDef[] effects = upgradeDef.effects;
				foreach (EffectDef effectDef in effects)
				{
					if (effectDef.StatIndex >= 0)
					{
						list2.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value * (float)((!flag) ? 1 : 2)));
					}
				}
				if (list2.Count > 0)
				{
					list.Add(string.Join(", ", list2));
				}
			}
			if (rarity >= 2)
			{
				list.Add("+1 attribute point");
			}
			if (rarity >= 3)
			{
				list.Add("+ Rare-or-better gear");
			}
			if (rarity >= 4)
			{
				list.Add("+ a perk pick");
			}
			return list;
		}

		public static void ClearPaid()
		{
			PaidOut.Clear();
			Rechecking.Clear();
		}

		public static UseState? BeforeUse(ItemUpgrade item)
		{
			if (!Game.IsMaster())
			{
				return null;
			}
			object obj = IsPlayerField?.GetValue(item);
			if (obj is bool && !(bool)obj)
			{
				return null;
			}
			int num = Elites.ViewId((Component)(object)item);
			if (PaidOut.Contains(num))
			{
				return null;
			}
			ItemToggle component = ((Component)item).GetComponent<ItemToggle>();
			if ((Object)(object)component == (Object)null || !(TogglePlayerField?.GetValue(component) is int num2))
			{
				return null;
			}
			PlayerAvatar val = null;
			try
			{
				val = SemiFunc.PlayerAvatarGetFromPhotonID(num2);
			}
			catch
			{
			}
			if ((Object)(object)val == (Object)null)
			{
				return null;
			}
			string steamId = Game.SteamId(val);
			return new UseState
			{
				SteamId = steamId,
				Actor = Game.ActorNumber(val),
				ViewId = num,
				GuessedKey = GuessKey((Component)(object)item),
				Before = Snapshot(steamId),
				AllBefore = AllLevels(),
				At = Time.time
			};
		}

		public static void AfterUse(ItemUpgrade item, UseState? st)
		{
			if (st == null || !Game.IsMaster() || PaidOut.Contains(st.ViewId))
			{
				return;
			}
			Uses.Add(st.At);
			_usesSinceLevel++;
			if (DupChecking.Add(st.ViewId))
			{
				RpgRuntime? instance = RpgRuntime.Instance;
				if (instance != null)
				{
					((MonoBehaviour)instance).StartCoroutine(DupCheck(st));
				}
			}
			string text = Changed(st.Before, Snapshot(st.SteamId));
			if (text != "")
			{
				Pay(st, text);
			}
			else if (Rechecking.Add(st.ViewId))
			{
				RpgRuntime? instance2 = RpgRuntime.Instance;
				if (instance2 != null)
				{
					((MonoBehaviour)instance2).StartCoroutine(Recheck(st));
				}
			}
		}

		private static IEnumerator Recheck(UseState st)
		{
			float[] array = new float[2] { 0.5f, 1.5f };
			foreach (float num in array)
			{
				yield return (object)new WaitForSeconds(num);
				if (PaidOut.Contains(st.ViewId))
				{
					Rechecking.Remove(st.ViewId);
					yield break;
				}
				string text = Changed(st.Before, Snapshot(st.SteamId));
				if (text != "")
				{
					Pay(st, text);
					Rechecking.Remove(st.ViewId);
					yield break;
				}
			}
			if (st.GuessedKey != "" && !PaidOut.Contains(st.ViewId) && UsedUp(st.ViewId))
			{
				Pay(st, st.GuessedKey);
			}
			Rechecking.Remove(st.ViewId);
		}

		private static bool UsedUp(int viewId)
		{
			ItemUpgrade[] array = Object.FindObjectsByType<ItemUpgrade>((FindObjectsSortMode)0);
			foreach (ItemUpgrade val in array)
			{
				if ((Object)(object)val != (Object)null && Elites.ViewId((Component)(object)val) == viewId)
				{
					object obj = DoneField?.GetValue(val);
					if (obj is bool)
					{
						return (bool)obj;
					}
					return false;
				}
			}
			return true;
		}

		public static Dictionary<string, Dictionary<string, int>> AllLevels()
		{
			Dictionary<string, Dictionary<string, int>> dictionary = new Dictionary<string, Dictionary<string, int>>();
			StatsManager instance = StatsManager.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return dictionary;
			}
			Dictionary<string, Dictionary<string, int>> dictionary2 = Game.Get<Dictionary<string, Dictionary<string, int>>>(instance, "dictionaryOfDictionaries", null);
			if (dictionary2 == null)
			{
				return dictionary;
			}
			foreach (KeyValuePair<string, Dictionary<string, int>> item in dictionary2)
			{
				if (item.Key.StartsWith("playerUpgrade", StringComparison.Ordinal) && item.Value != null)
				{
					dictionary[item.Key.Substring("playerUpgrade".Length)] = new Dictionary<string, int>(item.Value);
				}
			}
			return dictionary;
		}

		private static IEnumerator DupCheck(UseState st)
		{
			yield return (object)new WaitForSeconds(2.5f);
			DupChecking.Remove(st.ViewId);
			float now = Time.time;
			Uses.RemoveAll((float t) => t < now - 30f);
			int num = 0;
			foreach (float use in Uses)
			{
				if (use >= st.At - 0.05f && use <= now)
				{
					num++;
				}
			}
			num = Mathf.Max(1, num);
			StatsManager instance = StatsManager.instance;
			Dictionary<string, Dictionary<string, int>> dictionary = (((Object)(object)instance != (Object)null) ? Game.Get<Dictionary<string, Dictionary<string, int>>>(instance, "dictionaryOfDictionaries", null) : null);
			if (dictionary == null)
			{
				yield break;
			}
			foreach (KeyValuePair<string, Dictionary<string, int>> item in AllLevels())
			{
				st.AllBefore.TryGetValue(item.Key, out Dictionary<string, int> value);
				foreach (KeyValuePair<string, int> item2 in item.Value)
				{
					int value2;
					int num2 = ((value != null && value.TryGetValue(item2.Key, out value2)) ? value2 : 0);
					if (item2.Value - num2 > num)
					{
						string text = PlayerName(item2.Key);
						Dictionary<string, int> value3 = null;
						bool flag = Plugin.Cfg.FixDoubleSharedUpgrades.Value && !Compat.UpgradeSharingMod && dictionary.TryGetValue("playerUpgrade" + item.Key, out value3) && value3 != null;
						Plugin.Log.LogWarning((object)($"[upgrades] {item.Key}: {text} went from level {num2} to {item2.Value} after {num} purchase(s) - the upgrade is shared by more than one system ({SharingMods()}). " + (flag ? $"Kept {num2 + num}." : (Compat.UpgradeSharingMod ? "Left to the sharing mod." : "Left as is (Rules/FixDoubleSharedUpgrades is off)."))));
						if (flag && value3 != null)
						{
							value3[item2.Key] = num2 + num;
						}
					}
				}
			}
		}

		private static string PlayerName(string steamId)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if (Game.SteamId(item) == steamId)
				{
					try
					{
						return SemiFunc.PlayerGetName(item);
					}
					catch
					{
					}
					break;
				}
			}
			return steamId;
		}

		public static string SharingMods()
		{
			if (_sharingMods != null)
			{
				return _sharingMods;
			}
			List<string> list = new List<string>();
			try
			{
				bool flag = default(bool);
				foreach (KeyValuePair<string, PluginInfo> pluginInfo in Chainloader.PluginInfos)
				{
					PluginInfo value = pluginInfo.Value;
					string key = pluginInfo.Key;
					object obj;
					if (value == null)
					{
						obj = null;
					}
					else
					{
						BepInPlugin metadata = value.Metadata;
						obj = ((metadata != null) ? metadata.Name : null);
					}
					string text = (key + " " + (string?)obj).ToLowerInvariant();
					if (text.Contains("sharedupgrade") || text.Contains("shared upgrade") || text.Contains("shared_upgrade") || text.Contains("teamupgrade") || text.Contains("team upgrade"))
					{
						object obj2;
						if (value == null)
						{
							obj2 = null;
						}
						else
						{
							BepInPlugin metadata2 = value.Metadata;
							obj2 = ((metadata2 != null) ? metadata2.Name : null);
						}
						if (obj2 == null)
						{
							obj2 = pluginInfo.Key;
						}
						list.Add((string)obj2);
					}
					if (!text.Contains("moreupgrades") || !((Object)(object)((value != null) ? value.Instance : null) != (Object)null))
					{
						continue;
					}
					ConfigFile config = value.Instance.Config;
					List<string> list2 = new List<string>();
					foreach (ConfigDefinition key2 in config.Keys)
					{
						int num;
						if (key2.Key == "Allow Team Upgrades" || key2.Key == "Sync Host Upgrades")
						{
							object boxedValue = config[key2].BoxedValue;
							if (boxedValue is bool)
							{
								flag = (bool)boxedValue;
								num = 1;
							}
							else
							{
								num = 0;
							}
						}
						else
						{
							num = 0;
						}
						if (((uint)num & (flag ? 1u : 0u)) != 0)
						{
							list2.Add(key2.Section + ": " + key2.Key);
						}
					}
					list.Add((list2.Count > 0) ? ("MoreUpgrades (" + string.Join(", ", list2) + ")") : "MoreUpgrades (no team sharing on)");
				}
			}
			catch (Exception ex)
			{
				list.Add("(couldn't read: " + ex.Message + ")");
			}
			_sharingMods = ((list.Count > 0) ? string.Join("; ", list) : "no upgrade-sharing mod found");
			return _sharingMods;
		}

		public static string StaminaLevelsText(string steamId)
		{
			if (string.IsNullOrEmpty(steamId))
			{
				return "";
			}
			StringBuilder stringBuilder = new StringBuilder();
			foreach (KeyValuePair<string, Dictionary<string, int>> item in AllLevels())
			{
				string text = item.Key.ToLowerInvariant();
				if (text.Contains("stamina") || text.Contains("sprint") || text.Contains("energy") || text.Contains("endurance"))
				{
					item.Value.TryGetValue(steamId, out var value);
					stringBuilder.Append((stringBuilder.Length == 0) ? "Upgrade levels: " : ", ").Append(item.Key).Append(' ')
						.Append(value);
				}
			}
			return stringBuilder.ToString();
		}

		public static void LogLevelStart()
		{
			if (!Game.IsMaster())
			{
				return;
			}
			List<string> list = new List<string>();
			foreach (KeyValuePair<string, Dictionary<string, int>> item in AllLevels())
			{
				string text = item.Key.ToLowerInvariant();
				if (!text.Contains("stamina") && !text.Contains("sprint") && !text.Contains("energy") && !text.Contains("endurance"))
				{
					continue;
				}
				foreach (KeyValuePair<string, int> item2 in item.Value)
				{
					string key = item.Key + "|" + item2.Key;
					if (_lastStamina.TryGetValue(key, out var value) && item2.Value > value && _usesSinceLevel == 0 && !Compat.UpgradeSharingMod)
					{
						Plugin.Log.LogWarning((object)$"[upgrades] {item.Key}: {PlayerName(item2.Key)} went from {value} to {item2.Value} without a purchase since the last level (re-added by a sync or reload?).");
					}
					_lastStamina[key] = item2.Value;
					if (item2.Value > 0)
					{
						list.Add($"{PlayerName(item2.Key)} {item.Key} {item2.Value}");
					}
				}
			}
			_usesSinceLevel = 0;
			if (list.Count > 0)
			{
				Plugin.Log.LogInfo((object)("[upgrades] level start: " + string.Join(", ", list) + ". Sharing: " + SharingMods() + "."));
			}
		}

		private static void Pay(UseState st, string key)
		{
			if (PaidOut.Add(st.ViewId))
			{
				Net.BroadcastUpgradeUsed(st.Actor, key, st.ViewId);
			}
		}
	}
	internal static class ValueScale
	{
		public sealed class Item
		{
			public string Name = "";

			public string Source = "vanilla";

			public int Size;

			public float Min;

			public float Max;

			public bool Vanilla => Source == "vanilla";
		}

		public static readonly string[] SizeNames = new string[7] { "Tiny", "Small", "Medium", "Big", "Wide", "Tall", "Very tall" };

		private static readonly Dictionary<string, Item> ByName = new Dictionary<string, Item>(StringComparer.OrdinalIgnoreCase);

		private static readonly float[] VanillaTop = new float[7];

		private static bool _built;

		private static bool _building;

		private static bool _fromIl;

		private static string _from = "";

		private static int _ilPriced = -1;

		private static HashSet<string>? _repoLib;

		private static string _leaveFor = "\u0001";

		private static string[] _leave = Array.Empty<string>();

		private static int _scaled;

		private static int _seen;

		private static int _levelKey = int.MinValue;

		private static double _before;

		private static double _after;

		private static string _reportFor = "";

		private static ModConfig C => Plugin.Cfg;

		public static bool Ready => _built;

		public static IEnumerable<Item> AllItems => ByName.Values;

		public static float LevelAverage
		{
			get
			{
				if (_seen <= 0)
				{
					return 0f;
				}
				return (float)(_after / (double)_seen);
			}
		}

		public static float Multiplier => Mathf.Clamp(C.ValueMultiplier.Value, 0.25f, 3f);

		public static Item? Find(string cleanName)
		{
			if (!ByName.TryGetValue(cleanName, out Item value))
			{
				return null;
			}
			return value;
		}

		public static float VanillaTopOf(int size)
		{
			if (size < 0 || size >= VanillaTop.Length)
			{
				return 0f;
			}
			return VanillaTop[size];
		}

		public static string CleanName(string raw)
		{
			return Clean(raw);
		}

		public static string ShortName(string name)
		{
			return (name ?? "").Replace("Valuable ", "").Trim();
		}

		public static IEnumerator BuildSlowly()
		{
			if (_built || _building)
			{
				yield break;
			}
			_building = true;
			bool flag = false;
			try
			{
				flag = FromInterestingLevels();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogInfo((object)("[valuables] InterestingLevels' catalog couldn't be read (" + ex.GetBaseException().Message + "); building our own."));
			}
			if (flag)
			{
				Finish();
				yield break;
			}
			List<(object pref, int size)> refs = new List<(object, int)>();
			bool flag2 = false;
			try
			{
				CollectRefs(refs);
				flag2 = true;
			}
			catch (Exception ex2)
			{
				Plugin.Log.LogWarning((object)("[valuables] the level list couldn't be read: " + ex2.GetBaseException().Message));
			}
			if (!flag2 || refs.Count == 0)
			{
				_building = false;
				yield break;
			}
			float t0 = Time.realtimeSinceStartup;
			for (int i = 0; i < refs.Count; i++)
			{
				try
				{
					AddRef(refs[i].pref, refs[i].size);
				}
				catch
				{
				}
				if (i % 8 == 7)
				{
					yield return null;
				}
			}
			_from = $"built from the levels' valuable lists ({refs.Count} entries, {Time.realtimeSinceStartup - t0:0.0} s)";
			Finish();
		}

		public static void EnsureNow()
		{
			if (_built)
			{
				return;
			}
			try
			{
				if (!FromInterestingLevels())
				{
					List<(object, int)> list = new List<(object, int)>();
					CollectRefs(list);
					foreach (var (pref, size) in list)
					{
						try
						{
							AddRef(pref, size);
						}
						catch
						{
						}
					}
					_from = $"built from the levels' valuable lists ({list.Count} entries, at level start)";
				}
				Finish();
			}
			catch (Exception ex)
			{
				_built = true;
				Plugin.Log.LogWarning((object)("[valuables] no valuable catalog (" + ex.GetBaseException().Message + "): values aren't normalized this session (ValueMultiplier still applies)."));
			}
		}

		public static void PreferInterestingLevels()
		{
			if (!_built || AccessTools.TypeByName("InterestingLevels.Catalog") == null)
			{
				return;
			}
			if (_fromIl)
			{
				RefreshFromInterestingLevels();
				return;
			}
			Dictionary<string, Item> dictionary = new Dictionary<string, Item>(ByName, StringComparer.OrdinalIgnoreCase);
			string text = _from;
			bool flag = false;
			try
			{
				flag = FromInterestingLevels();
			}
			catch
			{
				flag = false;
			}
			if (flag)
			{
				Plugin.Log.LogInfo((object)("[valuables] switching to InterestingLevels' catalog (was " + text + "); from the next valuables spawned."));
				Finish();
				return;
			}
			ByName.Clear();
			foreach (KeyValuePair<string, Item> item in dictionary)
			{
				ByName[item.Key] = item.Value;
			}
			_from = text;
		}

		private static void RefreshFromInterestingLevels()
		{
			bool flag;
			try
			{
				flag = FromInterestingLevels();
			}
			catch
			{
				flag = false;
			}
			if (!flag)
			{
				return;
			}
			int num = 0;
			foreach (Item value in ByName.Values)
			{
				if (value.Max > 0f)
				{
					num++;
				}
			}
			if (num != _ilPriced)
			{
				_ilPriced = num;
				Finish();
			}
		}

		private static void Finish()
		{
			_built = true;
			_building = false;
			Array.Clear(VanillaTop, 0, VanillaTop.Length);
			foreach (Item value in ByName.Values)
			{
				if (value.Vanilla && value.Size >= 0 && value.Size < VanillaTop.Length)
				{
					VanillaTop[value.Size] = Mathf.Max(VanillaTop[value.Size], value.Max);
				}
			}
			int num = 0;
			foreach (Item value2 in ByName.Values)
			{
				if (!value2.Vanilla)
				{
					num++;
				}
			}
			Plugin.Log.LogInfo((object)($"[valuables] catalog: {ByName.Count} valuables ({num} modded), {_from}. Vanilla top value per size: " + string.Join(", ", Sizes())));
			_reportFor = "";
			Report();
		}

		private static IEnumerable<string> Sizes()
		{
			for (int i = 0; i < SizeNames.Length; i++)
			{
				yield return $"{SizeNames[i]} ${VanillaTop[i]:N0}";
			}
		}

		private static void CollectRefs(List<(object pref, int size)> into)
		{
			RunManager instance = RunManager.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return;
			}
			IList list = Game.Get<IList>(instance, "levels", null);
			if (list == null)
			{
				return;
			}
			HashSet<object> hashSet = new HashSet<object>();
			HashSet<object> hashSet2 = new HashSet<object>();
			string[] array = new string[7] { "tiny", "small", "medium", "big", "wide", "tall", "veryTall" };
			foreach (object item in list)
			{
				if (item == null)
				{
					continue;
				}
				IList list2 = Game.Get<IList>(item, "ValuablePresets", null);
				if (list2 == null)
				{
					continue;
				}
				foreach (object item2 in list2)
				{
					if (item2 == null || !hashSet.Add(item2))
					{
						continue;
					}
					for (int i = 0; i < array.Length; i++)
					{
						IList list3 = Game.Get<IList>(item2, array[i], null);
						if (list3 == null)
						{
							continue;
						}
						foreach (object item3 in list3)
						{
							if (item3 != null && hashSet2.Add(item3))
							{
								into.Add((item3, i));
							}
						}
					}
				}
			}
		}

		private static void AddRef(object pref, int size)
		{
			GameObject val = Prop<GameObject>(pref, "Prefab");
			if ((Object)(object)val == (Object)null)
			{
				return;
			}
			ValuableObject component = val.GetComponent<ValuableObject>();
			if ((Object)(object)component == (Object)null || (Object)(object)component.valuePreset == (Object)null)
			{
				return;
			}
			string text = Clean(((Object)val).name);
			if (!ByName.ContainsKey(text))
			{
				string source = "vanilla";
				Object val2 = Prop<Object>(pref, "Bundle");
				if (val2 != (Object)null)
				{
					source = Clean(val2.name);
				}
				else if (RepoLibNames().Contains(text))
				{
					source = "REPOLib (mod unknown)";
				}
				int size2 = VolumeOf(component, size);
				ByName[text] = new Item
				{
					Name = text,
					Source = source,
					Size = size2,
					Min = component.valuePreset.valueMin,
					Max = component.valuePreset.valueMax
				};
			}
		}

		private static int VolumeOf(ValuableObject vo, int fallback)
		{
			try
			{
				object obj = AccessTools.Field(typeof(ValuableObject), "volumeType")?.GetValue(vo);
				return (obj != null) ? Mathf.Clamp(Convert.ToInt32(obj), 0, 6) : fallback;
			}
			catch
			{
				return fallback;
			}
		}

		private static T? Prop<T>(object o, string name) where T : class
		{
			try
			{
				PropertyInfo property = o.GetType().GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
				if (property != null && property.GetIndexParameters().Length == 0)
				{
					return property.GetValue(o) as T;
				}
				return o.GetType().GetField(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.GetValue(o) as T;
			}
			catch
			{
				return null;
			}
		}

		private static HashSet<string> RepoLibNames()
		{
			if (_repoLib != null)
			{
				return _repoLib;
			}
			_repoLib = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
			try
			{
				Type type = AccessTools.TypeByName("REPOLib.Modules.Valuables");
				if (type == null)
				{
					return _repoLib;
				}
				MemberInfo[] members = type.GetMembers(BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				foreach (MemberInfo memberInfo in members)
				{
					if ((!(memberInfo is PropertyInfo) && !(memberInfo is FieldInfo)) || memberInfo.Name.IndexOf("Registered", StringComparison.OrdinalIgnoreCase) < 0 || memberInfo.Name.IndexOf("Initial", StringComparison.OrdinalIgnoreCase) >= 0)
					{
						continue;
					}
					object obj = ((memberInfo is PropertyInfo propertyInfo && propertyInfo.GetIndexParameters().Length == 0) ? propertyInfo.GetValue(null) : ((memberInfo is FieldInfo fieldInfo) ? fieldInfo.GetValue(null) : null));
					if (!(obj is IEnumerable enumerable) || obj is string)
					{
						continue;
					}
					foreach (object item in enumerable)
					{
						GameObject val = (GameObject)((item is GameObject) ? item : null);
						if (val != null)
						{
							_repoLib.Add(Clean(((Object)val).name));
							continue;
						}
						Component val2 = (Component)((item is Component) ? item : null);
						if (val2 != null)
						{
							_repoLib.Add(Clean(((Object)val2.gameObject).name));
						}
						else if (item != null)
						{
							object obj2 = item;
							Type type2 = item.GetType();
							if (type2.IsGenericType && type2.GetGenericTypeDefinition() == typeof(KeyValuePair<, >))
							{
								obj2 = type2.GetProperty("Key")?.GetValue(item) ?? item;
							}
							object obj3 = ((obj2 is GameObject) ? obj2 : null);
							if (obj3 == null)
							{
								object obj4 = ((obj2 is Component) ? obj2 : null);
								obj3 = ((obj4 != null) ? ((Component)obj4).gameObject : null) ?? Prop<GameObject>(obj2, "Prefab");
							}
							GameObject val3 = (GameObject)obj3;
							if ((Object)(object)val3 != (Object)null)
							{
								_repoLib.Add(Clean(((Object)val3).name));
							}
						}
					}
				}
			}
			catch
			{
			}
			return _repoLib;
		}

		private static bool FromInterestingLevels()
		{
			Type type = AccessTools.TypeByName("InterestingLevels.Catalog");
			if (type == null)
			{
				return false;
			}
			object obj = AccessTools.Field(type, "Entries")?.GetValue(null);
			object obj2;
			if (!(obj is IDictionary dictionary))
			{
				obj2 = obj as IEnumerable;
			}
			else
			{
				IEnumerable values = dictionary.Values;
				obj2 = values;
			}
			IEnumerable enumerable = (IEnumerable)obj2;
			if (enumerable == null)
			{
				return false;
			}
			int num = 0;
			foreach (object item in enumerable)
			{
				if (item == null)
				{
					continue;
				}
				string text = Clean(Game.Get(item, "Name", "") ?? "");
				string text2 = Game.Get(item, "Key", "") ?? "";
				if (text == "" && text2 != "")
				{
					text = Clean(text2.Substring(text2.LastIndexOf('/') + 1));
				}
				if (text == "" || Game.Get(item, "Broken", fallback: false))
				{
					continue;
				}
				object obj3 = AccessTools.Field(item.GetType(), "Size")?.GetValue(item);
				string ss = obj3 as string;
				int num2 = ((ss != null) ? Array.FindIndex(SizeNames, (string x) => x.Replace(" ", "").Equals(ss.Replace(" ", ""), StringComparison.OrdinalIgnoreCase)) : ((obj3 != null) ? Convert.ToInt32(obj3) : (-1)));
				if (num2 >= 0 && num2 <= 6)
				{
					string text3 = Game.Get(item, "Source", "vanilla") ?? "vanilla";
					ByName[text] = new Item
					{
						Name = text,
						Source = ((text3 == "") ? "vanilla" : text3),
						Size = num2,
						Min = Num(item, "ValueMin"),
						Max = Num(item, "ValueMax")
					};
					if (text2 != "")
					{
						ByName[Clean(text2.Substring(text2.LastIndexOf('/') + 1))] = ByName[text];
					}
					num++;
				}
			}
			if (num == 0)
			{
				ByName.Clear();
				return false;
			}
			_from = $"from InterestingLevels' catalog ({num} entries)";
			_fromIl = true;
			return true;
		}

		private static float Num(object o, string field)
		{
			try
			{
				object obj = AccessTools.Field(o.GetType(), field)?.GetValue(o);
				return (obj == null) ? 0f : Convert.ToSingle(obj);
			}
			catch
			{
				return 0f;
			}
		}

		private static string Clean(string s)
		{
			s = (s ?? "").Trim();
			int num = s.IndexOf("(Clone)", StringComparison.Ordinal);
			if (num >= 0)
			{
				s = s.Substring(0, num).Trim();
			}
			return s;
		}

		public static float FactorFor(Item it, out string why)
		{
			why = "";
			if (!C.ValueNormalize.Value || it.Vanilla)
			{
				return 1f;
			}
			if (LeftAlone(it))
			{
				why = "LeaveAlone";
				return 1f;
			}
			float num = ((it.Size >= 0 && it.Size < VanillaTop.Length) ? VanillaTop[it.Size] : 0f);
			if (num <= 0f || it.Max <= 0f)
			{
				return 1f;
			}
			float num2 = num * Mathf.Clamp(C.ValueMaxAboveVanilla.Value, 1f, 10f);
			if (it.Max <= num2)
			{
				return 1f;
			}
			why = $"top ${it.Max:N0} > {C.ValueMaxAboveVanilla.Value:0.##}x vanilla {SizeNames[it.Size].ToLowerInvariant()} top ${num:N0}";
			return num2 / it.Max;
		}

		private static bool LeftAlone(Item it)
		{
			string text = C.ValueLeaveAlone.Value ?? "";
			string[] array;
			if ((object)text != _leaveFor)
			{
				_leaveFor = text;
				List<string> list = new List<string>();
				array = text.Split(',', ';');
				for (int i = 0; i < array.Length; i++)
				{
					string text2 = array[i].Trim();
					if (text2 != "")
					{
						list.Add(text2);
					}
				}
				_leave = list.ToArray();
			}
			array = _leave;
			foreach (string value in array)
			{
				if (it.Source.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0 || it.Name.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0)
				{
					return true;
				}
			}
			return false;
		}

		public static void OnRolled(ValuableObject v)
		{
			if ((Object)(object)v == (Object)null || !Game.IsMaster() || Game.Get(v, "dollarValueOverride", 0) != 0)
			{
				return;
			}
			float num = Game.Get(v, "dollarValueCurrent", 0f);
			if (num <= 0f)
			{
				return;
			}
			EnsureNow();
			NoteLevel();
			float num2 = 1f;
			string text = Clean(((Object)((Component)v).gameObject).name);
			if (ByName.TryGetValue(text, out Item value))
			{
				num2 = FactorFor(value, out string _);
			}
			float num3 = num2 * Multiplier * Market.ValueMult(text);
			_seen++;
			_before += num;
			if (Mathf.Abs(num3 - 1f) < 0.001f)
			{
				_after += num;
				return;
			}
			float num4 = Mathf.Max(100f, Mathf.Round(num * num3 / 100f) * 100f);
			Game.Set(v, "dollarValueOriginal", num4);
			Game.Set(v, "dollarValueCurrent", num4);
			_after += num4;
			if (num2 < 0.999f)
			{
				_scaled++;
			}
		}

		private static void NoteLevel()
		{
			int num = (((Object)(object)LevelGenerator.Instance != (Object)null) ? ((Object)LevelGenerator.Instance).GetInstanceID() : 0);
			if (num != _levelKey)
			{
				Market.HostEnsureCurrent();
				FlushLevel();
				_levelKey = num;
			}
		}

		public static void FlushLevel()
		{
			if (_seen > 0)
			{
				Plugin.Log.LogInfo((object)$"[valuables] {_seen} valuables rolled ${_before:N0} -> ${_after:N0} (x{((_before > 0.0) ? (_after / _before) : 1.0):0.00}; {_scaled} overpriced modded ones normalized, value multiplier x{Multiplier:0.##}).");
			}
			_seen = (_scaled = 0);
			_before = (_after = 0.0);
		}

		public static int Budget(int k)
		{
			try
			{
				return (k <= 0) ? k : Mathf.Max(1, Mathf.RoundToInt((float)k * Multiplier));
			}
			catch
			{
				return k;
			}
		}

		public static void Report()
		{
			if (!_built)
			{
				return;
			}
			string text = $"{C.ValueNormalize.Value}|{C.ValueMaxAboveVanilla.Value}|{C.ValueMultiplier.Value}|{C.ValueLeaveAlone.Value}|{ByName.Count}";
			if (text == _reportFor)
			{
				return;
			}
			_reportFor = text;
			List<(Item, float, string)> list = new List<(Item, float, string)>();
			HashSet<Item> hashSet = new HashSet<Item>();
			foreach (Item value in ByName.Values)
			{
				if (hashSet.Add(value))
				{
					string why;
					float item = FactorFor(value, out why);
					list.Add((value, item, why));
				}
			}
			list.Sort(((Item it, float f, string why) a, (Item it, float f, string why) b) => a.f.CompareTo(b.f));
			float multiplier = Multiplier;
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append(string.Format("RepoRPG valuable values ({0}). Normalize {1}, up to {2:0.##}x vanilla's top value per size, ", "1.0.100", C.ValueNormalize.Value ? "on" : "off", C.ValueMaxAboveVanilla.Value)).Append(string.Format("value multiplier x{0:0.##}, leave alone: '{1}'.\nCatalog {2}.\nVanilla top value per size: {3}.\n\n", multiplier, C.ValueLeaveAlone.Value, _from, string.Join(", ", Sizes())));
			stringBuilder.Append("Valuable | Source | Size | Value range | After | Factor | Why\n");
			int num = 0;
			foreach (var item6 in list)
			{
				Item item2 = item6.Item1;
				float item3 = item6.Item2;
				string item4 = item6.Item3;
				float num2 = item3 * multiplier;
				if (item3 < 0.999f)
				{
					num++;
				}
				stringBuilder.Append($"{item2.Name} | {item2.Source} | {SizeNames[Mathf.Clamp(item2.Size, 0, 6)]} | ${item2.Min:N0}-${item2.Max:N0} | ${item2.Min * num2:N0}-${item2.Max * num2:N0} | x{num2:0.###} | {item4}\n");
			}
			try
			{
				string text2 = Path.Combine(ClassDatabase.Folder, "valuable-report.txt");
				File.WriteAllText(text2, stringBuilder.ToString());
				Plugin.Log.LogInfo((object)$"[valuables] {num} of {list.Count} valuables are normalized (full list: {text2}). Biggest changes:");
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[valuables] couldn't write the report: " + ex.Message));
			}
			int num3 = 0;
			foreach (var (item5, num4, _) in list)
			{
				if (num4 >= 0.999f || num3++ >= 15)
				{
					break;
				}
				Plugin.Log.LogInfo((object)$"[valuables]   {item5.Name} ({item5.Source}, {SizeNames[Mathf.Clamp(item5.Size, 0, 6)].ToLowerInvariant()}): ${item5.Min:N0}-${item5.Max:N0} -> ${item5.Min * num4 * multiplier:N0}-${item5.Max * num4 * multiplier:N0} (x{num4 * multiplier:0.###})");
			}
		}
	}
	[HarmonyPatch]
	internal static class ValueScalePatch
	{
		private static MethodBase? TargetMethod()
		{
			return AccessTools.Method(typeof(ValuableObject), "DollarValueSetLogic", (Type[])null, (Type[])null);
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			if (TargetMethod() != null)
			{
				return AccessTools.Field(typeof(ValuableObject), "dollarValueOverride") != null;
			}
			return false;
		}

		[HarmonyPrefix]
		private static void Prefix(ValuableObject __instance, out bool __state)
		{
			__state = true;
			try
			{
				__state = Game.Get(__instance, "dollarValueSet", fallback: true);
			}
			catch
			{
			}
		}

		[HarmonyPostfix]
		private static void Postfix(ValuableObject __instance, bool __state)
		{
			if (__state || !Guard.On("ValueScalePatch"))
			{
				return;
			}
			try
			{
				ValueScale.OnRolled(__instance);
			}
			catch (Exception e)
			{
				Guard.Fail("ValueScalePatch", e);
			}
		}
	}
	internal static class AttributeAlloc
	{
		public const int MaxEntries = 64;

		public static AttributeDef? Find(string id)
		{
			AttributeDef[] attributes = Plugin.Rpg.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				if (attributeDef.id == id)
				{
					return attributeDef;
				}
			}
			return null;
		}

		public static string Encode(Dictionary<string, int> alloc)
		{
			StringBuilder stringBuilder = new StringBuilder();
			foreach (KeyValuePair<string, int> item in alloc)
			{
				if (stringBuilder.Length > 0)
				{
					stringBuilder.Append(';');
				}
				stringBuilder.Append(item.Key).Append('=').Append(item.Value);
			}
			return stringBuilder.ToString();
		}

		public static Dictionary<string, int>? Decode(string s)
		{
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			if (string.IsNullOrEmpty(s))
			{
				return dictionary;
			}
			string[] array = s.Split(';');
			if (array.Length > 64)
			{
				return null;
			}
			string[] array2 = array;
			foreach (string text in array2)
			{
				int num = text.IndexOf('=');
				if (num <= 0)
				{
					return null;
				}
				string key = text.Substring(0, num);
				if (!int.TryParse(text.Substring(num + 1), out var result) || dictionary.ContainsKey(key))
				{
					return null;
				}
				dictionary[key] = result;
			}
			return dictionary;
		}

		public static string Validate(RunSave run, Dictionary<string, int> alloc)
		{
			if (alloc.Count == 0)
			{
				return "nothing to apply";
			}
			int num = 0;
			foreach (KeyValuePair<string, int> item in alloc)
			{
				AttributeDef attributeDef = Find(item.Key);
				if (attributeDef == null)
				{
					return "unknown attribute (" + item.Key + ")";
				}
				if (item.Value <= 0 || item.Value > 1000)
				{
					return "invalid amount";
				}
				if (run.AttributePoints(attributeDef.id) + item.Value > attributeDef.maxPoints)
				{
					return $"{attributeDef.name} would go past its cap of {attributeDef.maxPoints}";
				}
				num += item.Value;
			}
			int num2 = Leveling.AvailableAttributePoints(null, run);
			if (num > num2)
			{
				if (num2 > 0)
				{
					return string.Format("only {0} attribute point{1} left", num2, (num2 == 1) ? "" : "s");
				}
				return "no attribute points left";
			}
			return "";
		}

		public static string Apply(RunSave run, Dictionary<string, int> alloc)
		{
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			foreach (KeyValuePair<string, int> item in alloc)
			{
				int value = run.AttributePoints(item.Key) + item.Value;
				run.SetAttribute(item.Key, value);
				dictionary[item.Key] = value;
			}
			return Encode(dictionary);
		}

		public static string HostHandle(string key, string steamId, string playerName, string payload, out string totals)
		{
			totals = "";
			if (key != RunInfo.Key || RunStore.IsTempKey(key))
			{
				return "the host is on a different save";
			}
			if (string.IsNullOrEmpty(steamId))
			{
				return "not verified";
			}
			Dictionary<string, int> dictionary = Decode(payload);
			if (dictionary == null)
			{
				return "invalid request";
			}
			RunSave runSave = SaveBook.Get(key, steamId);
			if (runSave == null)
			{
				return "the host doesn't have your progress yet - try again in a moment";
			}
			string text = Validate(runSave, dictionary);
			if (text != "")
			{
				return text;
			}
			totals = Apply(runSave, dictionary);
			SaveBook.Put(key, steamId, runSave, playerName);
			return "";
		}
	}
