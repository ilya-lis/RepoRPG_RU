		private void BuildTeamLines()
		{
			//IL_01cd: Unknown result type (might be due to invalid IL or missing references)
			//IL_01bf: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d2: Unknown result type (might be due to invalid IL or missing references)
			_teamFor = Roster.Version;
			_teamSort = Plugin.Cfg.TeamPanelSort.Value;
			_teamPanelLines.Clear();
			List<Roster.Row> list = new List<Roster.Row>(Roster.Rows);
			if (_teamSort == TeamSort.Level)
			{
				list.Sort((Roster.Row a, Roster.Row b) => (b.Level == a.Level) ? string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase) : b.Level.CompareTo(a.Level));
			}
			else
			{
				list.Sort((Roster.Row a, Roster.Row b) => a.Join.CompareTo(b.Join));
			}
			foreach (Roster.Row item in list)
			{
				bool flag = item.Actor == ClassClaims.LocalActor || !Game.IsMultiplayer();
				List<string> list2 = new List<string>();
				if (item.Mastered)
				{
					list2.Add("★");
				}
				if (item.Unspent > 0)
				{
					list2.Add($"+{item.Unspent} pts");
				}
				if (item.Down)
				{
					list2.Add("DOWN");
				}
				_teamPanelLines.Add(new TeamLine
				{
					Name = item.Name + (flag ? " (you)" : ""),
					Self = flag,
					Xp = item.Xp,
					Cls = ((item.Class != "") ? (ClassName(item.Class) + ((item.Level > 0) ? $"  Lv {item.Level}" : "")) : (item.Choosing ? "Choosing..." : "No class yet")),
					Col = ((item.Class != "") ? ClassReadable(item.Class) : Neutral),
					Badges = string.Join("  ", list2)
				});
			}
		}

