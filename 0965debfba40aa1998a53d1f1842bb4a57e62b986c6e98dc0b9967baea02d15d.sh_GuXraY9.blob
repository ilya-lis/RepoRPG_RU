		public RarityDef[] rarities = Array.Empty<RarityDef>();

		public SlotDef[] slots = Array.Empty<SlotDef>();

		public UniqueDef[] uniques = Array.Empty<UniqueDef>();

		public PerkDef[] perks = Array.Empty<PerkDef>();

		public UpgradeDef[] upgrades = Array.Empty<UpgradeDef>();

		public PerkDef[] blessings = Array.Empty<PerkDef>();

		public PerkDef[] curses = Array.Empty<PerkDef>();

		public ThreatTierDef[] threatTiers = Array.Empty<ThreatTierDef>();

		public ThreatTierDef? Threat(int difficulty)
		{
			ThreatTierDef threatTierDef = null;
			ThreatTierDef[] array = threatTiers;
			foreach (ThreatTierDef threatTierDef2 in array)
			{
				if (threatTierDef2.minDifficulty <= difficulty && (threatTierDef == null || threatTierDef2.minDifficulty > threatTierDef.minDifficulty))
				{
					threatTierDef = threatTierDef2;
				}
			}
			return threatTierDef;
		}

		public UpgradeDef? Upgrade(string key)
		{
			UpgradeDef[] array = upgrades;
			foreach (UpgradeDef upgradeDef in array)
			{
				if (upgradeDef.key == key)
				{
					return upgradeDef;
				}
			}
			return null;
		}

		public PerkDef? Perk(string id)
		{
			PerkDef[] array = perks;
			foreach (PerkDef perkDef in array)
			{
				if (perkDef.id == id)
				{
					return perkDef;
				}
			}
			return null;
		}

		public int SlotIndex(string id)
		{
			for (int i = 0; i < slots.Length; i++)
			{
				if (slots[i].id == id)
				{
					return i;
				}
			}
			return -1;
		}
	}
