		private void FillContractDetail(DetailInfo d, ContractState c, int kind = 0)
		{
			//IL_004e: Unknown result type (might be due to invalid IL or missing references)
			ContractGiverDef contractGiverDef = ContractBoard.Giver(c.giver);
			Color col;
			string text = CtTypeTier(c, out col);
			d.Type = text + ((contractGiverDef != null) ? (" · " + contractGiverDef.name) : "");
			d.Name = ContractBoard.Name(c);
			d.NameColor = ContractBoard.GiverColor(c.giver);
			string why;
			bool flag = CanAccept(c, out why);
			switch (kind)
			{
			case 2:
				d.Status.Add((UiStatus.Selected, "Taken for the next level"));
				break;
			case 0:
				if (why == "Accepted")
				{
					d.Status.Add((UiStatus.Selected, "Taken"));
				}
				break;
			}
			if (c.status == 1)
			{
				d.Status.Add((UiStatus.Maxed, "Done"));
			}
			else if (c.status == 2)
			{
				d.Status.Add((UiStatus.Locked, "Failed"));
			}
			else if (kind == 1)
			{
				d.Status.Add((UiStatus.Pending, StripRich(ProgressText(c))));
			}
			if (c.bonusState == 1)
			{
				d.Status.Add((UiStatus.Available, "Bonus met"));
			}
			else if (c.bonusState == 2)
			{
				d.Status.Add((UiStatus.Locked, "Bonus missed"));
			}
			d.NowHead = "OBJECTIVE";
			d.Now = CardBody(c, withReward: false, full: true);
			if (kind == 1 && c.status == 0)
			{
				d.Now = d.Now + "\n<color=#9a9ca0>Progress:</color> " + ProgressText(c);
			}
			d.NextHead = "REWARD";
			d.NextNote = ContractBoard.RewardText(c) + ((c.kind != 3 && c.kind != 2) ? "\n<color=#9a9ca0>A reward pick: gear, crafting parts, a module or shop reputation - you choose once it's paid.</color>" : "");
			d.NeedsHead = "STAKES";
			StringBuilder stringBuilder = new StringBuilder();
			if (c.kind == 3)
			{
				stringBuilder.Append("Failing a step once is allowed; a second failure ends the chain.");
			}
			else if (c.kind == 2)
			{
				stringBuilder.Append("Only the best score is paid. Needs 2 entrants; with fewer it's void (no loss).");
			}
			else
			{
				stringBuilder.Append("Failing costs only reputation with " + ((contractGiverDef != null) ? contractGiverDef.name : "the giver") + " (-1). Nothing else is lost.");
			}
			stringBuilder.Append("\nIt counts in the next level you play after taking it.");
			if (kind == 0 && !flag && why != "" && why != "Accepted")
			{
				stringBuilder.Append("\n<color=#ffb53d>Can't take it now:</color> " + why + ".");
			}
			if (c.kind == 1 && c.cls != "")
			{
				stringBuilder.Append("\nFor the " + (Plugin.Db.Get(c.cls)?.name ?? c.cls) + " only.");
			}
			if (contractGiverDef != null)
			{
				stringBuilder.Append("\n\n<i><color=#c8c8c8>" + contractGiverDef.name + ": \"" + ContractBoard.Line((kind == 0) ? contractGiverDef.offer : contractGiverDef.accept, c.uid.GetHashCode()) + "\"</color></i>");
			}
			d.Needs = stringBuilder.ToString();
			switch (kind)
			{
			case 0:
			{
				ContractState cc2 = c;
				d.Act((why == "Accepted") ? "Accepted" : "Accept", BtnKind.Primary, flag, delegate
				{
					AskAccept(cc2);
				}, why);
				break;
			}
			case 2:
			{
				ContractState cc = c;
				d.Act("Drop (back to the board)", BtnKind.Secondary, ContractBoardOpen, delegate
				{
					AskDrop(cc);
				}, "Contracts can be dropped in the lobby and the shop.");
				break;
			}
			}
		}

		private void FillTeamDetail(DetailInfo d)
		{
			//IL_0067: Unknown result type (might be due to invalid IL or missing references)
			if (_tcDef == null)
