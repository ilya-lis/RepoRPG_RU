		private static bool OnResearchMsg(int sender, object[] d, byte kind, bool master)
		{
			switch (kind)
			{
			case 21:
				if (master)
				{
					if (d.Length > 1 && d[1] is string { Length: <2000 } text3)
					{
						Research.HostOnReported(sender, text3);
					}
					return true;
				}
				break;
			case 22:
				if (IsFromHost(sender))
				{
					if (d.Length > 1 && d[1] is string { Length: <2000 } text)
					{
						Research.ApplyLobby(text);
					}
					return true;
				}
				break;
			case 23:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is float amount)
					{
						Research.Receive(amount, Cut(d[2], 60));
					}
					return true;
				}
				break;
			case 24:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is int level && d[2] is int[] array && array.Length <= 8)
					{
						ResearchSamples.Apply(level, array);
					}
					return true;
				}
				break;
			case 25:
				if (master)
				{
					if (d.Length < 2 || !(d[1] is string { Length: <=120 } text2))
					{
						return true;
					}
					float num = Haggle.HostRoll(sender, text2);
					SendTo(62, new object[3]
					{
						(byte)26,
						text2,
						num
					}, sender);
					return true;
				}
				break;
			case 26:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is string key && d[2] is float mult)
					{
						RpgRuntime.Instance?.OnHaggled(key, mult);
					}
					return true;
				}
				break;
			case 27:
				if (IsFromHost(sender))
				{
					if (d.Length > 1 && d[1] is int lvl2)
					{
						Ascension.Apply(lvl2);
					}
					return true;
				}
				break;
			case 28:
				if (IsFromHost(sender))
				{
					if (d.Length > 1 && d[1] is int lvl)
					{
						Ascension.OnWin(lvl, RpgRuntime.Instance?.CurrentId ?? "");
					}
					return true;
				}
				break;
			case 29:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is int[] array2 && d[2] is byte[] packed && array2.Length <= 64)
					{
						Elements.Apply(array2, packed);
					}
					return true;
				}
				break;
			case 30:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is int viewId)
					{
						RpgRuntime.Instance?.OnElementCombo(viewId, Cut(d[2], 20));
					}
					return true;
				}
				break;
			}
			if (kind >= 21)
			{
				return kind <= 30;
			}
			return false;
		}

