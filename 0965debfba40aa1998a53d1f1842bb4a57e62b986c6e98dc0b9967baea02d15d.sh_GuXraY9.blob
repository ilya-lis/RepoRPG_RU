		private string CfgValue(string key, out bool found)
		{
			found = false;
			if (_cfgCache == null)
			{
				_cfgCache = new Dictionary<string, ConfigEntryBase>(StringComparer.OrdinalIgnoreCase);
				try
				{
					foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in ((BaseUnityPlugin)Plugin.Instance).Config)
					{
						_cfgCache[item.Key.Section + "/" + item.Key.Key] = item.Value;
					}
				}
				catch
				{
				}
			}
			if (!_cfgCache.TryGetValue(key, out ConfigEntryBase value))
			{
				return "?";
			}
			found = true;
			object boxedValue = value.BoxedValue;
			if (!(boxedValue is bool))
			{
				if (!(boxedValue is float num))
				{
					if (!(boxedValue is double num2))
					{
						if (boxedValue == null)
						{
							return "";
						}
						return boxedValue.ToString();
					}
					return num2.ToString("0.##", CultureInfo.InvariantCulture);
				}
				return num.ToString("0.##", CultureInfo.InvariantCulture);
			}
			return ((bool)boxedValue) ? "on" : "off";
		}

		private bool CfgBool(string key)
		{
			bool flag = default(bool);
			int num;
			if (_cfgCache != null && _cfgCache.TryGetValue(key, out ConfigEntryBase value))
			{
				object boxedValue = value.BoxedValue;
				if (boxedValue is bool)
				{
					flag = (bool)boxedValue;
					num = 1;
				}
				else
				{
					num = 0;
				}
			}
			else
			{
				num = 0;
			}
			return (byte)((uint)num & (flag ? 1u : 0u)) != 0;
		}

		private string ResolveGuide(string text)
		{
			if (string.IsNullOrEmpty(text) || text.IndexOf('{') < 0)
			{
				return text ?? "";
			}
			return GuideToken.Replace(text, delegate(Match m)
			{
				string value = m.Groups[1].Value;
				string value2 = m.Groups[2].Value;
				switch (value)
				{
				case "cfg":
				{
					int num = value2.IndexOf('?');
					bool found;
					if (num < 0)
					{
						return CfgValue(value2, out found);
					}
					string key = value2.Substring(0, num);
					string text2 = value2.Substring(num + 1);
					int num2 = text2.IndexOf(':');
					string result = ((num2 >= 0) ? text2.Substring(0, num2) : text2);
					string result2 = ((num2 >= 0) ? text2.Substring(num2 + 1) : "");
					CfgValue(key, out found);
					if (!CfgBool(key))
					{
						return result2;
					}
					return result;
				}
				case "key":
					return KeyToken(value2);
				case "live":
					if (value2 == "difficulty")
					{
						return DifficultyPresets.Label;
					}
					return "?";
				case "count":
					return value2 switch
					{
						"classes" => Plugin.Db.Classes.Count.ToString(), 
						"synergies" => Synergies.All.Count.ToString(), 
						"perks" => Plugin.Rpg.perks.Length.ToString(), 
						"attributes" => Plugin.Rpg.attributes.Length.ToString(), 
						"rarities" => Plugin.Rpg.rarities.Length.ToString(), 
						_ => "?", 
					};
				case "list":
					if (value2 == "slots")
					{
						List<string> list = new List<string>();
						SlotDef[] slots = Plugin.Rpg.slots;
						foreach (SlotDef slotDef in slots)
						{
							list.Add(slotDef.name);
						}
						return string.Join(", ", list);
					}
					return "?";
				default:
					return m.Value;
				}
			});
		}

