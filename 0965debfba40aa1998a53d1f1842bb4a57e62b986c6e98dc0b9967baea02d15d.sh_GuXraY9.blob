					{
						num2 *= 1f - num4 / 100f;
					}
				}
				break;
			}
			case "cartwright":
			{
				float num3 = ClassStat("cartwright.cart_shelter");
				if (num3 > 0f && CartNear(4f))
				{
					num2 *= 1f - Mathf.Clamp(num3, 0f, 40f) / 100f;
				}
				break;
			}
			}
			PlayerAvatar val2 = Game.LocalPlayer();
			if ((Object)(object)val2 != (Object)null)
			{
				num2 *= SynergyDamageMult(val2);
			}
			return num2;
		}

