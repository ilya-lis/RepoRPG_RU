		public static PlayerDeathHead? DeathHead(PlayerAvatar? p)
		{
			if ((Object)(object)p == (Object)null)
			{
				return null;
			}
			EnsureDeathHeadRef();
			if (_deathHeadRef == null)
			{
				return null;
			}
			try
			{
				return _deathHeadRef.Invoke(p);
			}
			catch
			{
				return null;
			}
		}

		private static void EnsureDeathHeadRef()
		{
			if (_deathHeadTried)
			{
				return;
			}
			_deathHeadTried = true;
			try
			{
				_deathHeadRef = AccessTools.FieldRefAccess<PlayerAvatar, PlayerDeathHead>("playerDeathHead");
			}
			catch (Exception ex)
			{
				WarnOnce("[compat] PlayerAvatar.playerDeathHead can't be read (" + ex.GetBaseException().Message + "): death-head features (Undertaker, Medic list) are off.");
			}
		}

		public static List<(string member, string feature)> CheckAccessors()
		{
			List<(string, string)> list = new List<(string, string)>();
			EnsureDeathHeadRef();
			if (_deathHeadRef == null)
			{
				list.Add(("PlayerAvatar.playerDeathHead", "Undertaker Reboot / Head Sense, Medic positions of downed teammates"));
			}
			return list;
		}

		public static void WarnOnce(string msg)
		{
			if (Warned.Add(msg))
			{
				Plugin.Log.LogWarning((object)msg);
			}
		}

		public static FieldInfo? Field(Type t, string name)
		{
			if (!Fields.TryGetValue((t, name), out FieldInfo value))
			{
				value = AccessTools.Field(t, name);
				Fields[(t, name)] = value;
				if (value == null)
				{
					WarnOnce("Game field " + t.FullName + "." + name + " not found; related feature disabled.");
				}
			}
			return value;
		}

		public static MethodInfo? Method(Type t, string name, Type[]? args = null)
		{
			string text = t.FullName + "." + name + ((args == null) ? "" : ("(" + string.Join(",", Array.ConvertAll(args, (Type a) => a.Name)) + ")"));
			if (!Methods.TryGetValue(text, out MethodInfo value))
			{
				try
				{
					value = ((args == null) ? AccessTools.Method(t, name, (Type[])null, (Type[])null) : AccessTools.Method(t, name, args, (Type[])null));
				}
				catch (AmbiguousMatchException)
				{
					value = null;
					WarnOnce("Game method " + text + " is overloaded; pass argument types.");
				}
				Methods[text] = value;
				if (value == null)
				{
					WarnOnce("Game method " + text + " not found; related feature disabled.");
				}
			}
			return value;
		}

		private static FieldRef<object, T>? RefOf<T>(Type t, string name)
		{
			(Type, string, Type) key = (t, name, typeof(T));
			if (!Refs.TryGetValue(key, out Delegate value))
			{
				value = null;
				FieldInfo fieldInfo = Field(t, name);
				if (fieldInfo != null && !fieldInfo.IsStatic && fieldInfo.FieldType == typeof(T))
				{
					try
					{
						value = (Delegate)(object)AccessTools.FieldRefAccess<T>(t, name);
					}
					catch
					{
						value = null;
					}
				}
				Refs[key] = value;
			}
			return value as FieldRef<object, T>;
		}

		public static T Get<T>(object? obj, string name, T fallback)
		{
			if (obj == null)
			{
				return fallback;
			}
			Type type = obj.GetType();
			FieldRef<object, T> val = RefOf<T>(type, name);
			if (val != null)
			{
				try
				{
					return val.Invoke(obj);
				}
				catch
				{
					return fallback;
				}
			}
			FieldInfo fieldInfo = Field(type, name);
			if (fieldInfo == null)
			{
				return fallback;
			}
			try
			{
				return (T)((fieldInfo.GetValue(obj) is T val2) ? ((object)val2) : ((object)fallback));
			}
			catch
			{
				return fallback;
			}
		}

		public static void Set<T>(object? obj, string name, T value)
		{
			if (obj == null)
			{
				return;
