			Seen.Clear();
			foreach (Special item in Host)
			{
				if (!((Object)(object)item.Obj == (Object)null))
				{
					Seen.Add(new Shown
					{
						T = item.Obj.transform,
						Eh = (EnemyHealth?)/*isinst with value type is only supported in some contexts*/,
						Kind = item.Kind,
						Id = item.Id
					});
				}
			}
			SeenLevel = RunInfo.LevelIndex;
			_seenLocal = true;
			SeenPad = TwinPadOn;
			SeenPadPos = TwinPad;
			SeenAnomaly = AnomalyOn;
			SeenAnomalyPos = Anomaly;
		}

		public static void Apply(int level, int[] ids, byte[] kinds, float[] extra)
		{
			//IL_0079: Unknown result type (might be due to invalid IL or missing references)
			//IL_0069: Unknown result type (might be due to invalid IL or missing references)
			//IL_007e: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b1: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a1: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b6: Unknown result type (might be due to invalid IL or missing references)
			Seen.Clear();
			for (int i = 0; i < ids.Length && i < kinds.Length; i++)
			{
				Seen.Add(new Shown
				{
					Kind = kinds[i],
					Id = ids[i]
				});
			}
			SeenLevel = level;
			_seenLocal = false;
			SeenPad = extra.Length > 3 && extra[0] > 0.5f;
			SeenPadPos = (Vector3)((extra.Length > 3) ? new Vector3(extra[1], extra[2], extra[3]) : Vector3.zero);
			SeenAnomaly = extra.Length > 7 && extra[4] > 0.5f;
			SeenAnomalyPos = (Vector3)((extra.Length > 7) ? new Vector3(extra[5], extra[6], extra[7]) : Vector3.zero);
			Resolve();
		}

		public static void Resolve()
		{
			if (_seenLocal)
			{
				return;
			}
			bool flag = false;
			foreach (Shown item in Seen)
			{
				if (item.Kind == 8)
				{
					if ((Object)(object)item.Eh == (Object)null || Game.Get(item.Eh, "dead", fallback: false))
					{
						item.Eh = null;
						flag = true;
					}
				}
				else if (!((Object)(object)item.T != (Object)null) && item.Id != 0)
				{
					PhotonView val = PhotonView.Find(item.Id);
					if ((Object)(object)val != (Object)null)
					{
						item.T = ((Component)val).transform;
					}
				}
			}
			if (!flag)
			{
				return;
			}
			Game.EnemyList.Enumerator enumerator2 = Game.LivingEnemies().GetEnumerator();
			while (enumerator2.MoveNext())
			{
				EnemyHealth current2 = enumerator2.Current;
				int num = Elites.ViewId((Component)(object)current2);
				foreach (Shown item2 in Seen)
				{
					if (item2.Kind == 8 && (Object)(object)item2.Eh == (Object)null && item2.Id == num)
					{
						item2.Eh = current2;
					}
				}
			}
		}

		public static bool SeenAs(Component? c, byte kind)
		{
			if ((Object)(object)c == (Object)null || SeenLevel != RunInfo.LevelIndex)
			{
				return false;
			}
			Transform transform = c.transform;
			foreach (Shown item in Seen)
			{
				if (item.Kind == kind && (Object)(object)item.T == (Object)(object)transform)
				{
					return true;
				}
			}
			return false;
		}

		public static bool ChuteUsed(int epId)
		{
			foreach (Shown item in Seen)
			{
				if (item.Kind == 9 && item.Id == epId)
				{
					return true;
				}
			}
			return false;
		}

