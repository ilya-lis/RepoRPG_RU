			_ljToldSlow = false;
			StartUnstickWatch("a late join", 180f);
			Plugin.Log.LogInfo((object)("[late join] joined " + where switch
			{
				1 => "in the shop", 
				2 => "mid-level", 
				_ => "in the truck", 
