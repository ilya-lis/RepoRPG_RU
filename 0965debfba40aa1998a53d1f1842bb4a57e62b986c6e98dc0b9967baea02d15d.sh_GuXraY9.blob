		private static bool OnResearchMsgE(int sender, object[] d, byte kind, bool master)
		{
			switch (kind)
			{
			case 31:
				if (master)
				{
					if (d.Length < 3 || !(d[1] is int num) || !(d[2] is string { Length: <=64 } text))
					{
						return true;
					}
					string text2 = SenderSteamId(sender, "");
					bool flag;
					int num2;
					int num3;
					string text3;
					if (!(text2 == ""))
					{
						(flag, num2, num3, text3) = RpgRuntime.HostPawnE(sender, text2, text, isLocal: false);
					}
					else
					{
						flag = false;
						num2 = 0;
						num3 = 0;
						text3 = "not verified";
					}
					SendTo(62, new object[7]
					{
						(byte)32,
						num,
						flag,
						text,
						num2,
						num3,
						text3
					}, sender);
					return true;
				}
				break;
			case 32:
				if (IsFromHost(sender))
				{
					if (d.Length > 6 && d[1] is int id && d[2] is bool ok && d[4] is int pay && d[5] is int price)
					{
						RpgRuntime.Instance?.OnPawnResultE(id, ok, Cut(d[3], 64), pay, price, Cut(d[6], 40));
					}
					return true;
				}
				break;
			case 33:
				if (IsFromHost(sender))
				{
					if (d.Length > 2 && d[1] is int viewId && d[2] is float seconds)
					{
						RpgRuntime.Instance?.OnTracerE(viewId, seconds);
					}
					return true;
				}
				break;
			}
			if (kind >= 31)
			{
				return kind <= 38;
			}
			return false;
		}

