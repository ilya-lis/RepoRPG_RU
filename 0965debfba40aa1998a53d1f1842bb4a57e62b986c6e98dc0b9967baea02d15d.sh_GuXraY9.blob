		private bool SectionLocked(int s, out string why)
		{
			why = "";
			int shopTier = ShopTier;
			if (s == 2 && shopTier < 2)
			{
				why = "Unlocks at Regular reputation";
				return true;
			}
			if (s == 7 && shopTier < 1)
			{
				why = "Unlocks at Customer reputation";
				return true;
			}
			if (s == 5 && !Plugin.Cfg.ShopCrates.Value)
			{
				why = "Crates are turned off in this lobby";
				return true;
			}
			if (s == 9 && !RunDepth.Unlocked("blackmarket"))
			{
				why = (RunDepth.Enabled ? string.Format("Unlocks at level {0}", RunDepth.LevelOf("blackmarket")) : "Deep-run content is off in this lobby");
				return true;
			}
			if (s == 11 && !Market.On)
			{
				why = "The market is turned off in this lobby";
				return true;
			}
			if (s == 12 && !ShopResearchAnyE() && !ShopResearchAnyC())
			{
				why = (Research.On ? "Research unlocks (Pawn Counter, Futures, Gun Bench, Gear Exchange) show here" : "Research is turned off in this lobby");
				return true;
			}
			if (s == 10 && !RunDepth.Unlocked("contraband"))
			{
				why = (RunDepth.Enabled ? string.Format("Unlocks at level {0}", RunDepth.LevelOf("contraband")) : "Deep-run content is off in this lobby");
				return true;
			}
			return false;
		}

		private List<ShopEntry> SectionEntries(RunSave run, int s)
		{
			List<ShopEntry> list = new List<ShopEntry>();
			foreach (ShopEntry item in run.shopStock)
			{
				if (s == 0 && item.featured)
				{
					list.Add(item);
				}
				else if (s == 9 || s == 10)
				{
					if (item.section == ((s == 9) ? "black" : "contra"))
					{
						list.Add(item);
					}
				}
				else if (!(item.section != ""))
				{
					if (s == 1 && item.kind == "gear" && !item.featured)
					{
						list.Add(item);
					}
					else if (s == 2 && item.kind == "module")
					{
						list.Add(item);
					}
					else if (s == 3 && item.kind == "cons")
					{
						list.Add(item);
					}
				}
			}
			return list;
		}

