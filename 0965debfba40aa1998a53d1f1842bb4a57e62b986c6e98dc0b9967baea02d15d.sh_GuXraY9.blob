		private float PilotGuard(PhysGrabObject obj)
		{
			foreach (KeyValuePair<PhysGrabCart, Pilot> pilot in _pilots)
			{
				Pilot value = pilot.Value;
				if (value.Moving && value.Cargo.Contains(obj))
				{
					return Mathf.Clamp(Mathf.Max(((Object)(object)value.Owner != (Object)null) ? ClassStats.Get(value.Owner, "cartwright.cart_guard") : 0f, 50f), 0f, 90f);
				}
			}
			return 0f;
		}

		private static string LevelName()
		{
			try
			{
				object obj = Game.Get<object>(RunManager.instance, "levelCurrent", null);
				object obj2 = ((obj is Object) ? obj : null);
				return ((obj2 == null) ? null : ((Object)obj2).name?.Replace("Level - ", "")) ?? "?";
			}
			catch
			{
				return "?";
			}
		}

		private static string Category(string why)
		{
			if (why.StartsWith("no floor") || why.StartsWith("too steep") || why.StartsWith("step") || why.StartsWith("drop"))
			{
				return "edge check";
			}
			if (why.StartsWith("blocked by"))
			{
				return "obstacle";
			}
			if (why.StartsWith("waiting"))
			{
				return "waiting for someone";
			}
			if (why.Contains("too tight") || why.StartsWith("Load too big"))
			{
				return "clearance";
			}
			if (why.StartsWith("No safe route") || why.StartsWith("no route"))
			{
				return "route failure";
			}
			if (why.StartsWith("stuck") || why.StartsWith("no progress"))
			{
				return "stuck detection";
			}
			return "other";
		}

