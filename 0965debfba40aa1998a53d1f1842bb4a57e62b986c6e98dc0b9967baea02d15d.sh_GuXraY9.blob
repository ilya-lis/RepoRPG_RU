			//IL_028b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0290: Unknown result type (might be due to invalid IL or missing references)
			//IL_0295: Unknown result type (might be due to invalid IL or missing references)
			//IL_0299: Unknown result type (might be due to invalid IL or missing references)
			//IL_029b: Unknown result type (might be due to invalid IL or missing references)
			//IL_029f: Unknown result type (might be due to invalid IL or missing references)
			//IL_02a4: Unknown result type (might be due to invalid IL or missing references)
			//IL_02a9: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ab: Unknown result type (might be due to invalid IL or missing references)
			//IL_02af: Unknown result type (might be due to invalid IL or missing references)
			//IL_02b4: Unknown result type (might be due to invalid IL or missing references)
			//IL_02c8: Unknown result type (might be due to invalid IL or missing references)
			//IL_01f1: Unknown result type (might be due to invalid IL or missing references)
			//IL_01f2: Unknown result type (might be due to invalid IL or missing references)
			//IL_01fc: Unknown result type (might be due to invalid IL or missing references)
			//IL_0201: Unknown result type (might be due to invalid IL or missing references)
			//IL_0206: Unknown result type (might be due to invalid IL or missing references)
			//IL_0207: Unknown result type (might be due to invalid IL or missing references)
			//IL_0211: Unknown result type (might be due to invalid IL or missing references)
			//IL_0216: Unknown result type (might be due to invalid IL or missing references)
			//IL_021b: Unknown result type (might be due to invalid IL or missing references)
			//IL_021f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0224: Unknown result type (might be due to invalid IL or missing references)
			//IL_01e0: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ca: Unknown result type (might be due to invalid IL or missing references)
			//IL_0257: Unknown result type (might be due to invalid IL or missing references)
			//IL_0241: Unknown result type (might be due to invalid IL or missing references)
			if (!ProbeOn)
			{
				_passing.Remove(pl);
				return;
			}
			float num = 2.5f;
			float num2 = 2f * pl.HalfWidth;
			float num3 = num2 + 1.2f;
			Vector3 val = pos + dir * (pl.HalfLength + 0.2f);
			float l;
			float r;
			float num4 = Gap(pl, val, dir, num, out l, out r);
			float l2;
			float r2;
			float num5 = Gap(pl, pos, dir, num, out l2, out r2);
			bool flag = num4 < num3;
			bool flag2 = num5 < num3;
			float num6 = Mathf.Min(flag ? num4 : float.MaxValue, flag2 ? num5 : float.MaxValue);
			if (Plugin.Cfg.CartDebugDraw.Value)
			{
				Vector3 val2 = Vector3.up * 0.3f;
				VizMark(pl, pl.LookAt + Vector3.up * 0.05f, pl.LookAt + Vector3.up * 1.2f, Color.magenta);
				Vector3 val3 = dir;
				if (Mathf.Abs(pl.Nudge) > 0.01f)
				{
					Vector3 val4 = dir + Vector3.Cross(Vector3.up, dir) * pl.Nudge;
					val3 = ((Vector3)(ref val4)).normalized;
				}
				VizMark(pl, pos + val2, pos + val2 + val3 * 1.6f, Color.white);
				Vector3 val5 = Vector3.Cross(Vector3.up, dir);
				if (l < num)
				{
					VizMark(pl, val + Vector3.up * 0.35f, val + Vector3.up * 0.35f - val5 * l, flag ? new Color(0.3f, 0.5f, 1f) : new Color(0.3f, 0.5f, 1f, 0.35f));
				}
				if (r < num)
				{
					VizMark(pl, val + Vector3.up * 0.35f, val + Vector3.up * 0.35f + val5 * r, flag ? new Color(0.3f, 0.5f, 1f) : new Color(0.3f, 0.5f, 1f, 0.35f));
				}
				float num7 = pl.HalfWidth + 0.03f;
				Vector3 val6 = pos + dir * pl.HalfLength + Vector3.up * 0.15f;
				VizMark(pl, val6 - val5 * num7, val6 + val5 * num7, new Color(1f, 0.6f, 0f));
				if (now >= _debugLinesAt)
				{
					DebugText(pl, num6, num2);
				}
			}
			_passing.TryGetValue(pl, out Passage value);
			if (value != null && now - value.LastTick > 2f)
			{
				EndPassage(pl, "interrupted", "stopped driving");
				value = null;
			}
			if (value != null)
			{
				value.Seconds += Mathf.Min(0.2f, now - value.LastTick);
				value.LastTick = now;
			}
			if (flag || flag2)
			{
				_wideTicks[pl] = 0;
				if (value == null)
				{
					value = new Passage
					{
						Level = LevelName(),
						Mode = ((pl.St == CartSt.Overdrive) ? "overdrive" : "follow"),
						Loaded = (pl.Cargo.Count > 0),
						LoadMass = pl.LoadMass,
						CartW = num2,
						EmptyW = 2f * pl.EmptyHalfWidth,
						Start = now,
						LastTick = now,
						SpeedIn = pl.CurSpeed
					};
					_passing[pl] = value;
				}
				value.MinGap = Mathf.Min(value.MinGap, num6);
				value.CartW = Mathf.Max(value.CartW, num2);
				value.LastNarrow = now;
				if (value.Seconds > 20f)
				{
					EndPassage(pl, "failed", "20s of driving without getting through");
				}
			}
			else if (value != null)
			{
				int value2;
				int num8 = ((!_wideTicks.TryGetValue(pl, out value2)) ? 1 : (value2 + 1));
				_wideTicks[pl] = num8;
				if (num8 >= 3)
				{
					EndPassage(pl, (value.Stops > 0) ? "stopped" : ((value.Contacts > 0) ? "grazed" : "clean"), "");
				}
			}
		}

		private float Gap(Pilot pl, Vector3 at, Vector3 fwd, float cap, out float l, out float r)
		{
			//IL_0002: Unknown result type (might be due to invalid IL or missing references)
			//IL_0003: Unknown result type (might be due to invalid IL or missing references)
			SideWalls(pl, at, fwd, cap, out l, out r);
			if (!(l < cap) || !(r < cap))
			{
				return float.MaxValue;
			}
			return l + r;
		}

		private void DebugText(Pilot pl, float gap, float cartW)
		{
			_debugLinesAt = Time.time + 0.2f;
			DebugLinesAt = Time.time;
			DebugLines.Clear();
			DebugLines.Add($"CART {((Object)pl.Cart).name}  {pl.St}  {pl.CurSpeed:0.0} m/s (want {pl.BaseSpeed * pl.SpeedLimit:0.0})  route {pl.Index}/{pl.Path.Length}");
			DebugLines.Add($"width {cartW:0.00}m (empty {2f * pl.EmptyHalfWidth:0.00})  height {pl.Height:0.00}  load {pl.LoadMass:0}  nudge {pl.Nudge:+0.00;-0.00}  line-up {pl.LineUp}");
			DebugLines.Add((gap < float.MaxValue) ? $"OPENING {gap:0.00}m  clearance {gap - cartW:+0.00;-0.00}m" : "open ground");
			if (pl.Slow != "")
			{
				DebugLines.Add("slowed: " + pl.Slow);
			}
			if (pl.StopWhy != "")
			{
				DebugLines.Add("STOP: " + Category(pl.StopWhy) + " - " + pl.StopWhy);
			}
			if (_passing.TryGetValue(pl, out Passage value))
			{
				DebugLines.Add($"passage: {value.Seconds:0.0}s  stops {value.Stops}  grazes {value.Contacts}  back-ups {value.Backups}");
			}
		}

		private void ProbeStop(Pilot pl, string why)
		{
			if (!ProbeOn || why == "")
			{
				return;
			}
			string text = Category(why);
			_passing.TryGetValue(pl, out Passage value);
			if (value != null)
			{
				if (text == "waiting for someone")
				{
					value.Waits++;
				}
				else
				{
					value.Stops++;
					value.Reasons.Add(text);
				}
			}
			float num = 2f * pl.HalfWidth;
			string text2 = ((value != null && value.MinGap < float.MaxValue) ? $"opening {value.MinGap:0.00}m vs cart {num:0.00}m (clearance {value.MinGap - num:+0.00;-0.00}m)" : $"open ground, cart {num:0.00}m");
			Plugin.Log.LogInfo((object)("[cart doorway] stop (" + text + "): " + why + " | " + text2 + " | " + ((pl.St == CartSt.Overdrive) ? "overdrive" : "follow") + ", " + ((pl.Cargo.Count > 0) ? $"loaded ({pl.LoadMass:0})" : "empty") + ", " + LevelName()));
		}

		private void ProbeContact(Pilot pl)
		{
			if (_passing.TryGetValue(pl, out Passage value))
			{
				value.Contacts++;
			}
		}

		private void ProbeBackup(Pilot pl)
		{
			if (ProbeOn)
			{
				if (_passing.TryGetValue(pl, out Passage value))
				{
					value.Backups++;
					value.Stops++;
					value.Reasons.Add("stuck detection");
				}
				Plugin.Log.LogInfo((object)string.Format("[cart doorway] no progress: backing up and re-routing ({0}/2){1}", pl.Reroutes, (value != null) ? $" in an opening {value.MinGap:0.00}m wide (cart {2f * pl.HalfWidth:0.00}m)" : ""));
			}
		}

		private void ProbeAbort(Pilot pl, string outcome, string why)
		{
			if (_passing.ContainsKey(pl))
			{
				EndPassage(pl, outcome, why);
			}
		}

		private void ProbePlanRefused(Pilot pl, string err, float gap)
		{
			if (!ProbeOn)
			{
				return;
			}
			ProbeAbort(pl, "failed", "no route: " + err);
			if (!(Time.time - pl.RefusedAt < 10f) || !(err == pl.RefusedWhy))
			{
				pl.RefusedAt = Time.time;
				pl.RefusedWhy = err;
				if (gap < 0f)
				{
					Plugin.Log.LogInfo((object)$"[cart doorway] route refused ({Category(err)}): {err} | something solid across or over a leg of the route (box check), cart {2f * pl.HalfWidth:0.00}m wide, {pl.Height:0.00}m tall | {LevelName()}");
					return;
				}
				float num = 2f * pl.HalfWidth;
				float num2 = 2f * pl.EmptyHalfWidth;
				Plugin.Log.LogInfo((object)($"[cart doorway] route refused ({Category(err)}): {err} | opening {gap:0.00}m vs cart {num:0.00}m (empty {num2:0.00}m) | " + ((gap >= num) ? "it would fit: a FALSE refusal" : ((gap >= num2) ? "a real misfit with this load" : "too narrow even empty")) + " | " + LevelName()));
				Record(new Passage
				{
					Level = LevelName(),
					Mode = ((pl.St == CartSt.Overdrive) ? "overdrive" : "follow"),
					Loaded = (pl.Cargo.Count > 0),
					LoadMass = pl.LoadMass,
					CartW = num,
					EmptyW = num2,
					MinGap = gap,
					Start = Time.time,
					Outcome = ((gap >= num) ? "failed" : "refused"),
					Why = err,
					Reasons = { Category(err) }
				});
			}
		}

		private void EndPassage(Pilot pl, string outcome, string why)
		{
			if (!_passing.TryGetValue(pl, out Passage value))
			{
				return;
			}
			_passing.Remove(pl);
			_wideTicks.Remove(pl);
			value.Outcome = outcome;
			value.Why = why;
			if (value.MinGap != float.MaxValue)
			{
				Plugin.Log.LogInfo((object)(string.Format("[cart doorway] passage {0}{1}: opening {2:0.00}m, cart {3:0.00}m (clearance {4:+0.00;-0.00}m), ", outcome, (why != "") ? (" (" + why + ")") : "", value.MinGap, value.CartW, value.MinGap - value.CartW) + string.Format("{0:0.0}s, stops {1} [{2}], waits {3}, grazes {4}, back-ups {5}, {6}, {7}, {8}", value.Seconds, value.Stops, string.Join(", ", value.Reasons), value.Waits, value.Contacts, value.Backups, value.Mode, value.Loaded ? "loaded" : "empty", value.Level)));
				if (outcome != "interrupted")
				{
					Record(value);
				}
			}
		}

		private void ProbeForget(Pilot pl)
		{
			_passing.Remove(pl);
			_wideTicks.Remove(pl);
		}

		private static void Record(Passage ps)
		{
			Done.Add(ps);
			if (Done.Count > 400)
			{
				Done.RemoveAt(0);
			}
			if (!Plugin.Cfg.CartDoorwayReport.Value)
			{
				return;
			}
			try
			{
				WriteReport();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[cart doorway] couldn't write the report: " + ex.Message));
			}
		}

		private static string Pct(int n, int of)
		{
			if (of != 0)
			{
				return $"{100f * (float)n / (float)of:0}%";
			}
			return "-";
		}

		private static void Rates(StringBuilder sb, string title, List<Passage> list)
		{
			int num = 0;
			int num2 = 0;
			int num3 = 0;
			int num4 = 0;
			int num5 = 0;
			int num6 = 0;
			foreach (Passage item in list)
			{
				if (item.Outcome == "refused")
				{
					num6++;
					continue;
				}
				num++;
				if (item.Outcome == "clean")
				{
					num2++;
				}
				else if (item.Outcome == "grazed")
				{
					num3++;
				}
				else if (item.Outcome == "stopped")
				{
					num4++;
				}
				else if (item.Outcome == "failed")
				{
					num5++;
				}
			}
			sb.Append($"  {title,-28} {num,4} passages   clean {Pct(num2, num),5}   grazed {Pct(num3, num),5}   stopped then through {Pct(num4, num),5}   failed {Pct(num5, num),5}" + ((num6 > 0) ? $"   (+{num6} real misfits refused)" : "") + "\n");
		}

		private static void WriteReport()
		{
			string text = Path.Combine(Paths.ConfigPath, "RepoRPG_cart_doorways.txt");
			if (!_reportMoved)
			{
				_reportMoved = true;
				if (File.Exists(text))
				{
					string text2 = "";
					using (StreamReader streamReader = new StreamReader(text))
					{
						text2 = streamReader.ReadLine() ?? "";
					}
					int num = text2.IndexOf("RepoRPG ", StringComparison.Ordinal);
					string text3 = ((num >= 0) ? text2.Substring(num + 8).Split(' ')[0] : "");
					if (text3 != "" && text3 != "1.0.100")
					{
						File.Copy(text, Path.Combine(Paths.ConfigPath, "RepoRPG_cart_doorways_" + text3 + ".txt"), overwrite: true);
					}
				}
			}
			StringBuilder stringBuilder = new StringBuilder(8192);
			stringBuilder.Append(string.Format("Cart doorway report - RepoRPG {0} - {1:yyyy-MM-dd HH:mm}\n", "1.0.100", DateTime.Now));
			stringBuilder.Append("Every opening a self-driving cart drove into (walls both sides, under 0.6m spare each side). Clearance = opening width - cart width (with its load).\n\n");
			stringBuilder.Append("SUCCESS\n");
			Rates(stringBuilder, "all", Done);
			SortedDictionary<string, List<Passage>> groups = new SortedDictionary<string, List<Passage>>();
			foreach (Passage item in Done)
			{
				Add("mode: " + item.Mode, item);
				Add(item.Loaded ? "load: loaded" : "load: empty", item);
				Add("level: " + item.Level, item);
				float num2 = item.MinGap - item.CartW;
				Add((num2 < 0.1f) ? "clearance: under 0.10m" : ((num2 < 0.25f) ? "clearance: 0.10-0.25m" : ((num2 < 0.5f) ? "clearance: 0.25-0.50m" : "clearance: 0.50m+")), item);
			}
			foreach (KeyValuePair<string, List<Passage>> item2 in groups)
			{
				Rates(stringBuilder, item2.Key, item2.Value);
			}
			stringBuilder.Append("\nWHY IT STOPPED (passages with at least one stop)\n");
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			foreach (Passage item3 in Done)
			{
				foreach (string reason in item3.Reasons)
				{
					dictionary[reason] = ((!dictionary.TryGetValue(reason, out var value)) ? 1 : (value + 1));
				}
			}
			List<KeyValuePair<string, int>> list = new List<KeyValuePair<string, int>>(dictionary);
			list.Sort((KeyValuePair<string, int> a, KeyValuePair<string, int> b) => b.Value.CompareTo(a.Value));
			foreach (KeyValuePair<string, int> item4 in list)
			{
				stringBuilder.Append($"  {item4.Key,-22} {item4.Value}\n");
			}
			if (list.Count == 0)
			{
				stringBuilder.Append("  (no stops)\n");
			}
			stringBuilder.Append("\nNARROWEST GAPS\n");
			float num3 = float.MaxValue;
			float num4 = float.MaxValue;
			float num5 = float.MinValue;
			Passage passage = null;
			Passage passage2 = null;
			Passage passage3 = null;
			foreach (Passage item5 in Done)
			{
				float num6 = item5.MinGap - item5.CartW;
				if (item5.Outcome == "clean" || item5.Outcome == "grazed" || item5.Outcome == "stopped")
				{
					if (num6 < num3)
					{
						num3 = num6;
						passage = item5;
					}
				}
				else if (item5.Outcome == "failed")
				{
					if (num6 < num4)
					{
						num4 = num6;
						passage2 = item5;
					}
					if (num6 > num5)
					{
						num5 = num6;
						passage3 = item5;
					}
				}
			}
			stringBuilder.Append((passage != null) ? $"  narrowest handled: {passage.MinGap:0.00}m opening, cart {passage.CartW:0.00}m (clearance {num3:+0.00;-0.00}m) - {passage.Outcome}, {passage.Mode}, {passage.Level}\n" : "  narrowest handled: -\n");
			stringBuilder.Append((passage3 != null) ? $"  widest failed:     {passage3.MinGap:0.00}m opening, cart {passage3.CartW:0.00}m (clearance {num5:+0.00;-0.00}m) - {passage3.Why}, {passage3.Mode}, {passage3.Level}\n" : "  widest failed:     -\n");
			stringBuilder.Append((passage2 != null && passage2 != passage3) ? $"  narrowest failed:  {passage2.MinGap:0.00}m opening, cart {passage2.CartW:0.00}m (clearance {num4:+0.00;-0.00}m) - {passage2.Why}, {passage2.Mode}, {passage2.Level}\n" : "");
			stringBuilder.Append("\nEVERY PASSAGE (newest last)\n");
			stringBuilder.Append("  outcome     opening  cart   clear.   time  stops  grazes  back-ups  waits  mode       load    level / reasons\n");
			foreach (Passage item6 in Done)
			{
				stringBuilder.Append(string.Format("  {0,-10}  {1,6:0.00}  {2,5:0.00}  {3,6:+0.00;-0.00}  {4,5:0.0}  {5,5}  {6,6}  {7,8}  {8,5}  {9,-9}  {10,-6}  {11}", item6.Outcome, item6.MinGap, item6.CartW, item6.MinGap - item6.CartW, item6.Seconds, item6.Stops, item6.Contacts, item6.Backups, item6.Waits, item6.Mode, item6.Loaded ? "loaded" : "empty", item6.Level) + ((item6.Reasons.Count > 0) ? (" - " + string.Join(", ", item6.Reasons)) : "") + ((item6.Why != "") ? (" (" + item6.Why + ")") : "") + "\n");
			}
			File.WriteAllText(text, stringBuilder.ToString());
			void Add(string k, Passage p)
			{
				if (!groups.TryGetValue(k, out List<Passage> value2))
				{
					value2 = (groups[k] = new List<Passage>());
				}
				value2.Add(p);
			}
		}

		private void Awake()
		{
			Instance = this;
		}

		private void RefreshScene()
		{
			if (Time.time < _nextScene)
			{
				return;
			}
			_nextScene = Time.time + 2f;
			try
			{
				_carts = Object.FindObjectsByType<PhysGrabCart>((FindObjectsSortMode)0);
			}
			catch
			{
				_carts = Array.Empty<PhysGrabCart>();
			}
			try
			{
				_batteries = Object.FindObjectsByType<ItemBattery>((FindObjectsSortMode)0);
			}
			catch
			{
				_batteries = Array.Empty<ItemBattery>();
			}
			try
			{
				ExtractionPoint[] array = Object.FindObjectsByType<ExtractionPoint>((FindObjectsSortMode)0);
				_extractions = (Transform[])(object)new Transform[array.Length];
				for (int i = 0; i < array.Length; i++)
				{
					_extractions[i] = ((Component)array[i]).transform;
				}
			}
			catch
			{
				_extractions = Array.Empty<Transform>();
			}
		}

		public void OnLevelStart()
		{
			if (Host)
			{
				for (int num = _bets.Count - 1; num >= 0; num--)
				{
					SettleLost(_bets[num], "The level ended before your bet came in");
				}
			}
			_stateSent.Clear();
			ResetPilots();
			_fields.Clear();
			_beacons.Clear();
			_charges.Clear();
			_floats.Clear();
			_thrown.Clear();
			_bets.Clear();
			_zones.Clear();
			_held.Clear();
			_lastCart.Clear();
			_stepsAt.Clear();
			_lureAt.Clear();
			_ramAt.Clear();
			_rebootHealth.Clear();
			_lastCart.Clear();
			_nextScene = 0f;
			ThirdWaveLevelStart();
			PerkLevelStart();
			GearLevelStart();
			CursesLevelStart();
		}

		public void Handle(PlayerAvatar? from, Act act, Vector3 pos, float[] a, int viewId)
		{
			//IL_012c: Unknown result type (might be due to invalid IL or missing references)
			//IL_00d2: Unknown result type (might be due to invalid IL or missing references)
			//IL_00fb: Unknown result type (might be due to invalid IL or missing references)
			//IL_00e9: Unknown result type (might be due to invalid IL or missing references)
			//IL_0383: Unknown result type (might be due to invalid IL or missing references)
			//IL_0343: Unknown result type (might be due to invalid IL or missing references)
			//IL_0348: Unknown result type (might be due to invalid IL or missing references)
			//IL_0349: Unknown result type (might be due to invalid IL or missing references)
			//IL_034e: Unknown result type (might be due to invalid IL or missing references)
			//IL_05fb: Unknown result type (might be due to invalid IL or missing references)
			//IL_0660: Unknown result type (might be due to invalid IL or missing references)
			//IL_06bc: Unknown result type (might be due to invalid IL or missing references)
