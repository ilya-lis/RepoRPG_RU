		}

		private static void GiveStartScrap(Player p)
		{
			int num = Mathf.RoundToInt((float)Mathf.Clamp(Plugin.Cfg.StartScrapPerLevel.Value, 0, 100) * Ascension.StartScrapMult);
			int levelIndex = RunInfo.LevelIndex;
			TeamRunSave teamRunSave = RpgRuntime.Instance?.HostRun?.team;
			PlayerAvatar val = PlayerOf(p.ActorNumber);
			string text = (((Object)(object)val != (Object)null) ? Game.SteamId(val) : "");
			if (num > 0 && levelIndex > 0 && teamRunSave != null && !((Object)(object)val == (Object)null) && !string.IsNullOrEmpty(text) && !teamRunSave.catchUpGiven.Contains(text))
			{
				RunSave runSave = SaveBook.Get(RunInfo.Key, text);
				if (runSave == null || runSave.classes.Count <= 0)
				{
					teamRunSave.catchUpGiven.Add(text);
					int num2 = Mathf.Min(300, num * levelIndex);
					Scrap.HostGrant(val, num2, "Late-join starting Scrap");
					RpgRuntime.Instance?.MarkRunDirty();
					Plugin.Log.LogInfo((object)$"[late join] {p.NickName}: {num2} starting Scrap ({levelIndex} level(s) cleared).");
				}
			}
		}

		private static int CatchUpLevelFor(Player p)
		{
			float num = Mathf.Clamp(Plugin.Cfg.CatchUpShare.Value, 0f, 100f) / 100f;
			if (num <= 0f)
			{
				return 0;
			}
			PlayerAvatar val = PlayerOf(p.ActorNumber);
			string text = (((Object)(object)val != (Object)null) ? Game.SteamId(val) : "");
			if (string.IsNullOrEmpty(text))
			{
				return 0;
			}
			RunSave runSave = SaveBook.Get(RunInfo.Key, text);
			if (runSave != null && runSave.classes.Count > 0)
			{
				return 0;
			}
			float num2 = 0f;
			int num3 = 0;
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && !((Object)(object)item == (Object)(object)val))
				{
					string text2 = Game.SteamId(item);
					RunSave run = (string.IsNullOrEmpty(text2) ? null : SaveBook.Get(RunInfo.Key, text2));
					ClassProgress classProgress = run?.classes.Find((ClassProgress c) => c.classId == run.selectedClass);
					if (classProgress != null)
					{
						num2 += (float)classProgress.level;
						num3++;
					}
				}
			}
			if (num3 == 0)
			{
				return 0;
			}
			return Mathf.Max(1, Mathf.FloorToInt(num2 / (float)num3 * num));
		}

		public static void BeforePlayerSpawn()
		{
