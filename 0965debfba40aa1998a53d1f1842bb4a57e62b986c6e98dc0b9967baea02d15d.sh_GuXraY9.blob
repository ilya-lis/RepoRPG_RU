			}
			float num5 = Mathf.Clamp(_stats.Perm(Stat.DamageTaken), 0f - Plugin.Cfg.MaxDamageReduction.Value, 200f);
			float num6 = Mathf.Clamp(_stats.Temp(Stat.DamageTaken), 0f - Plugin.Cfg.MaxActiveDamageReduction.Value, 200f);
			float num7 = (1f + num5 / 100f) * (1f + num6 / 100f);
			num7 *= SignatureDamageMult(val, ph);
			num7 *= NewClassDamageMult();
			num7 *= AttrDamageMult(val);
			num7 = Mathf.Max(num7, 1f - Mathf.Clamp(Plugin.Cfg.MaxTotalDamageReduction.Value, 0f, 99f) / 100f);
			damage = Mathf.Max(1, Mathf.RoundToInt((float)damage * num7));
			damage = CurseMartyr(val, damage);
			int num8 = Game.Health(ph);
			bool flag = savingGrace && damage <= 25 && num8 > 5 && num8 <= 20;
			if (num8 - damage <= 0 && !flag && (TryDeathSave("hit") || TryGuardianAngel(val)))
			{
				damage = num8 - 1;
