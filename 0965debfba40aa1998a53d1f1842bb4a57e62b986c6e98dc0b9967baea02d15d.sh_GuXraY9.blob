							if (((Vector3)(ref val)).sqrMagnitude <= 225f)
							{
								_fightNear = true;
								break;
							}
						}
					}
				}
				if (_fightNear)
				{
					_stats.AddDyn(Stat.MoveSpeed, num2);
					_stats.AddDyn(Stat.SprintSpeed, num2);
				}
			}
		}

