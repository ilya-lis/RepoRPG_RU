		private bool HudHold(float now)
		{
			if (RunReady && (Current != null || !_hudHadClass))
			{
				_hudBadSince = -1f;
				_hudHadClass = Current != null;
				return false;
			}
			if (_hudBadSince < 0f)
			{
				_hudBadSince = now;
				_diagHolds++;
				if (HudDiag)
				{
					Plugin.Log.LogInfo((object)string.Format("[hud] holding the last HUD: run ready {0} (store '{1}' vs run '{2}'), class {3}", RunReady, _store.RunKey, RunInfo.Key, Current?.id ?? "none"));
				}
			}
			if (now - _hudBadSince < 1.5f)
			{
				return _hudLeft.Count > 0;
			}
			return false;
		}

