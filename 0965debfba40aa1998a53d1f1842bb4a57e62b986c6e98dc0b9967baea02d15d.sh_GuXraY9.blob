						continue;
					}
					foreach (ClassDef item in list4)
					{
						List<string> list5 = new List<string>();
						foreach (SynergyDef item2 in Synergies.For(item.id))
						{
							ClassDef classDef3 = Plugin.Db.Get(item2.PartnerOf(item.id));
							if (classDef3 != null)
							{
								list5.Add("<color=" + Hex(classDef3.color) + ">" + classDef3.name + "</color> (" + item2.name + ")");
							}
						}
						string text8 = "<b><color=" + Hex(item.color) + ">" + item.name.ToUpperInvariant() + "</color></b>   <color=#ffb21e>" + item.group.ToUpperInvariant() + " · " + item.role + "</color>   <color=#c8cacd>Complexity: " + Complexity.Name(item) + "</color>\n" + $"{ClassSummary(item)}\n<b>Active:</b> {item.active.name} ({item.active.cooldown:0}s cooldown)" + ((item.complexityTip != "") ? ("\n<b>Tip:</b> " + item.complexityTip) : "") + ((list5.Count > 0) ? ("\n<b>Synergy partners:</b> " + string.Join(", ", list5)) : "");
						float h = TextH(text8, _small, w - 24f) + 24f - 4f;
						_gItems.Add(new GItem
						{
							Kind = GKind.ClassRow,
							Text = text8,
							Arg = item.id,
							H = h
						});
					}
				}
				break;
			}
			case "depth":
				Add(GKind.Text, DepthGuideText(), w);
				break;
			case "boons":
			{
				string[] array3 = new string[3] { "common", "rare", "very rare" };
				BoonDef[] boons = RunShape.Data.boons;
				Color accent = default(Color);
				foreach (BoonDef boonDef in boons)
				{
					if (boonDef != null)
					{
						bool flag = Account.SawBoon(boonDef.id) || RunShape.Has(boonDef.id);
						if (!ColorUtility.TryParseHtmlString(boonDef.color, ref accent))
						{
							accent = Accent;
						}
						AddTerm("[" + boonDef.code + "] " + boonDef.name, "<color=#9a9ca0>" + array3[Mathf.Clamp(boonDef.rarity, 0, 2)] + "</color>  " + (flag ? boonDef.desc : "<color=#9a9ca0>Win it once to see what it does.</color>"), w, accent);
					}
				}
				break;
			}
			case "synergies":
				Add(GKind.Head, $"ALL {Synergies.All.Count} SYNERGIES", w);
				foreach (SynergyDef item3 in Synergies.All)
				{
					ClassDef classDef = Plugin.Db.Get(item3.a);
					ClassDef classDef2 = Plugin.Db.Get(item3.b);
					if (classDef != null && classDef2 != null)
					{
						string text6 = (Synergies.Locked(item3) ? ("  <color=#9a9ca0>(Requires research: " + (Research.Def(item3.research)?.name ?? item3.research) + ")</color>") : "");
						AddTerm(item3.name, "<color=" + Hex(classDef.color) + ">" + classDef.name + "</color> + <color=" + Hex(classDef2.color) + ">" + classDef2.name + "</color>: " + item3.Text + text6, w, Accent);
					}
				}
				break;
			case "unlocks":
				Add(GKind.Head, $"ALL {Account.Unlocks.Count} UNLOCKS", w);
				foreach (UnlockDef unlock in Account.Unlocks)
				{
					AddTerm((Account.Has(unlock.id) ? "★ " : "") + unlock.name, unlock.gives + "  <color=#9a9ca0>(" + unlock.how + ")</color>", w, (Color)(Account.Has(unlock.id) ? new Color(1f, 0.82f, 0.35f) : TextMain));
				}
				break;
			case "alts":
				Add(GKind.Head, "ALTERNATE PASSIVES", w);
				foreach (ClassDef class2 in Plugin.Db.Classes)
				{
					AltPassiveDef altPassiveDef = Account.AltDef(class2.id);
					if (altPassiveDef != null)
					{
						AddTerm(class2.name, "<b>" + altPassiveDef.name + "</b> (replaces " + altPassiveDef.replaces + "): " + altPassiveDef.desc, w, ParseColor(class2.color));
					}
				}
				break;
			case "sets":
				Add(GKind.Head, $"ALL {GearSets.All.Count} SETS", w);
				foreach (SetDef item4 in GearSets.All)
				{
					AddTerm(item4.name, "<b>2 pieces:</b> " + item4.twoDesc + "\n<b>4 pieces:</b> " + item4.fourDesc, w, ParseColor(item4.color));
				}
				break;
			case "teamcontracts":
			{
				float scale = TeamContracts.Scale(Mathf.Max(0, RunInfo.LevelIndex));
				Add(GKind.Head, "EVERY TEAM CONTRACT (STAKES FOR THIS LEVEL)", w);
				TeamContractDef[] contracts = TeamContracts.Data.contracts;
				foreach (TeamContractDef teamContractDef in contracts)
				{
					if (teamContractDef != null)
					{
						AddTerm(teamContractDef.name, TeamContracts.Goal(teamContractDef, teamContractDef.target) + (teamContractDef.bossOnly ? " (boss levels)" : "") + "\n<color=#ffb21e>Reward</color> " + TeamContracts.RewardText(teamContractDef, scale) + "  ·  <color=#ff7a6b>Fail</color> " + TeamContracts.LossText(teamContractDef, scale), w, Accent);
					}
				}
				break;
			}
			case "highlights":
			{
				(string, string)[] pool = TeamPlay.Pool;
				for (int i = 0; i < pool.Length; i++)
				{
					var (term, meaning2) = pool[i];
					AddTerm(term, meaning2, w, AccentSoft);
				}
				break;
			}
			case "threat":
			{
				Add(GKind.Head, "RUN PROGRESS", w);
				if (!Plugin.Cfg.ThreatEnabled.Value)
				{
					AddTerm("This host", "The threat rating is off.", w, TextMain);
					break;
				}
				float rating = RunThreat.Rating;
				AddTerm("This run", RunThreat.BannerText(), w, Accent);
				AddTerm("Next level", (rating > 0.001f) ? RunThreat.Describe(rating) : "No extra threat yet.", w, AccentSoft);
				StringBuilder stringBuilder = new StringBuilder();
				int[] array = new int[7] { 2, 4, 6, 10, 15, 20, 30 };
				foreach (int num in array)
				{
					stringBuilder.Append((stringBuilder.Length > 0) ? "  ·  " : "").Append($"{num} cleared: {RunThreat.RatingAt(num):0.0}");
				}
				AddTerm("The curve", stringBuilder.ToString(), w, TextMain);
				break;
			}
			case "rarities":
			{
				Add(GKind.Head, "RARITIES", w);
				RarityDef[] rarities = Plugin.Rpg.rarities;
				foreach (RarityDef rarityDef in rarities)
				{
					AddTerm(rarityDef.name, string.Format("stats x{0:0.##}, {1} stat line{2}, salvages for {3} Scrap", rarityDef.mult, rarityDef.affixes, (rarityDef.affixes == 1) ? "" : "s", rarityDef.salvageScrap), w, ParseColor(rarityDef.color));
				}
				break;
			}
			case "contracts":
			{
				int level = Mathf.Max(0, RunInfo.LevelIndex);
				string[] array2 = new string[3] { "personal", "rival", "class" };
				foreach (string text in array2)
				{
					Add(GKind.Head, (text == "personal") ? "PERSONAL CONTRACTS (EASY / HARD / BRUTAL)" : ((text == "rival") ? "RIVAL CONTRACTS" : "CLASS CONTRACTS (EASY / HARD / BRUTAL)"), w);
					List<ContractDef> list = new List<ContractDef>();
					foreach (ContractDef item5 in ContractBoard.All)
					{
						if (item5.kind == text)
						{
							list.Add(item5);
						}
					}
					if (text == "class")
					{
						list.Sort((ContractDef contractDef, ContractDef b) => string.CompareOrdinal(contractDef.cls, b.cls));
					}
					foreach (ContractDef item6 in list)
					{
						string text2 = ((text == "rival") ? ContractBoard.Objective(ContractBoard.Make(item6, 1, withBonus: false, level)) : (ContractBoard.Objective(ContractBoard.Make(item6, 0, withBonus: false, level)) + ((item6.targets[0] != item6.targets[2]) ? $"  ({item6.targets[1]:N0} / {item6.targets[2]:N0} at Hard / Brutal)" : "")));
						string text3 = ContractBoard.Giver(item6.giver)?.name ?? "";
						string text4 = ((item6.cls != "") ? ((Plugin.Db.Get(item6.cls)?.name ?? item6.cls) + ": ") : "");
						string text5 = ((item6.bonusDesc != "") ? ("\n<color=#ffd75a>Bonus</color> " + item6.bonusDesc) : "") + (item6.mp ? "  (needs teammates)" : "");
						AddTerm(text4 + item6.name, text2 + "  -  " + text3 + text5, w, ContractBoard.GiverColor(item6.giver));
					}
				}
				Add(GKind.Head, "CHAINS", w);
				ChainDef[] chains = ContractBoard.Data.chains;
				foreach (ChainDef chainDef in chains)
				{
					List<string> list2 = new List<string>();
					for (int num2 = 0; num2 < chainDef.steps.Length; num2++)
					{
						list2.Add($"{num2 + 1}. {chainDef.steps[num2].desc}");
					}
					AddTerm(chainDef.name, string.Format("{0} (reputation {1}+)\n{2}\n<color=#ffb21e>Final reward</color> {3}", ContractBoard.Giver(chainDef.giver)?.name, 6, string.Join("\n", list2), chainDef.rewardDesc), w, ContractBoard.GiverColor(chainDef.giver));
				}
				break;
			}
			case "hostsettings":
			{
				Add(GKind.Head, SettingsSync.Overridden ? "THIS LOBBY'S SETTINGS (FROM THE HOST)" : (Game.IsMultiplayer() ? "YOUR SETTINGS (YOU'RE THE HOST)" : "YOUR SETTINGS"), w);
				GuideSetting[] hostSettings = Guide.Data.hostSettings;
				foreach (GuideSetting guideSetting in hostSettings)
				{
					if (guideSetting != null)
					{
						bool found;
						string meaning = CfgValue(guideSetting.key, out found);
						if (found)
						{
							AddTerm(guideSetting.label, meaning, w, Accent);
						}
					}
				}
				break;
			}
			case "controls":
				AddControls(w);
				break;
			case "mystats":
				foreach (string item7 in StatSheetLines())
				{
					Add(GKind.Row, item7, w);
				}
				break;
			}
			Add(GKind.Space, "", w, 4f);
		}

