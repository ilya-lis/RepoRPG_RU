		private SearchDoc DocOf(ConfigEntryBase e, string group, string groupDesc)
		{
			if (_hsDocs.TryGetValue(e, out SearchDoc value))
			{
				return value;
			}
			string[] obj = new string[11]
			{
				Spaced(e.Definition.Key),
				" ",
				e.Definition.Key,
				" ",
				e.Definition.Section,
				" ",
				group,
				" ",
				groupDesc,
				" ",
				null
			};
			ConfigDescription description = e.Description;
			obj[10] = ((description != null) ? description.Description : null);
			value = TextSearch.Doc(string.Concat(obj));
			_hsDocs[e] = value;
			return value;
		}

