				PlayerAvatar val = Game.LocalPlayer();
				PlayerController instance = PlayerController.instance;
				if ((Object)(object)val == (Object)null || (Object)(object)instance == (Object)null)
				{
					return;
				}
				if (!_ljToldSettings && SettingsSync.Overridden)
				{
					_ljToldSettings = true;
					Plugin.Log.LogInfo((object)$"[late join] step 3/4: host settings in ({num:0.0} s).");
				}
				if (!_ljToldData && RunReady)
				{
					_ljToldData = true;
					Plugin.Log.LogInfo((object)string.Format("[late join] step 4/4: RepoRPG data in ({0:0.0} s, class {1}).", num, (Current != null) ? Current.name : "none"));
				}
				bool flag = Game.Get(val, "spawned", fallback: false);
				if (num > 5f && !_ljToldSnap)
				{
					_ljToldSnap = true;
					Plugin.Log.LogInfo((object)(string.Format("[late join] 5 s check: spawned {0}, disabled {1}, input lock {2:0.0} s, ", flag, Game.Get(val, "isDisabled", fallback: false), Game.Get(instance, "InputDisableTimer", 0f)) + string.Format("move speed {0:0.0}, chat open {1}, menu open {2}, menu can open: {3}, ", Game.Get(instance, "MoveSpeed", 0f), ChatIsOpen(), MenuOpen, CanOpenMenu(out string why) ? "yes" : why) + string.Format("level state {0}, spectating {1}; the game: {2}.", ((Object)(object)GameDirector.instance != (Object)null) ? ((object)Unsafe.As<gameState, gameState>(ref GameDirector.instance.currentState)/*cast due to .constrained prefix*/).ToString() : "?", (Object)(object)SpectateCamera.instance != (Object)null, VanillaStateLine())));
				}
				if (!flag)
				{
					if (num > 6f && _ljSpawnAsks < 3 && unscaledTime >= _ljSpawnAskAt)
					{
						_ljSpawnAsks++;
						_ljSpawnAskAt = unscaledTime + 5f;
						Plugin.Log.LogWarning((object)$"[late join] not spawned {num:0} s after the scene was built: asking the host to spawn us (try {_ljSpawnAsks}).");
						Net.SendLateJoinSpawnAsk(stuck: false);
					}
					return;
				}
				Vector3 position = ((Component)val).transform.position;
				if (!_ljSawSpawn)
				{
					_ljSawSpawn = true;
					RaycastHit val2 = default(RaycastHit);
					bool flag2 = Physics.Raycast(position + Vector3.up * 0.5f, Vector3.down, ref val2, 3f, -5, (QueryTriggerInteraction)1);
					bool flag3 = BigLobby.Blocked(position);
					Plugin.Log.LogInfo((object)string.Format("[late join] step 2/4: spawned at {0} after {1:0.0} s; ground below: {2}, inside something: {3}.", position, num, flag2 ? $"yes ({((RaycastHit)(ref val2)).distance - 0.5f:0.0} m)" : "NO", flag3 ? "YES" : "no"));
					if ((!flag2 || flag3 || position.y < -40f) && _ljSpawnAsks < 3)
					{
						_ljSpawnAsks++;
						_ljSpawnAskAt = unscaledTime + 5f;
						_ljSawSpawn = false;
						Plugin.Log.LogWarning((object)"[late join] the spawn spot isn't safe: asking the host for another one.");
						Net.SendLateJoinSpawnAsk(stuck: true);
					}
				}
				else
				{
					if (!(num > 5f) || _ljToldBlock)
					{
						return;
					}
					List<string> list = new List<string>();
					if (Game.Get(val, "isDisabled", fallback: false))
					{
						list.Add("the game has the avatar disabled (dead / spectating)");
					}
					if (Game.Get(instance, "InputDisableTimer", 0f) > 0f)
					{
						list.Add("the game's player input lock is on (a vanilla menu page counts as open, or something holds it)");
					}
					if (Game.Get(instance, "kinematicTimer", 0f) > 0.5f)
					{
						list.Add("the game's kinematic lock is on");
					}
					if (MenuBlocksGame)
					{
						list.Add("the RepoRPG menu is open");
					}
					if (ChatIsOpen())
					{
						list.Add("the game's chat is open (typing)");
					}
					try
					{
						if ((Object)(object)SpectateCamera.instance != (Object)null)
						{
							list.Add("the game has us spectating (as if dead)");
						}
					}
					catch
					{
					}
					try
					{
						GameDirector instance2 = GameDirector.instance;
						if ((Object)(object)instance2 != (Object)null && (int)instance2.currentState != 2)
						{
							list.Add($"the game's level state is {instance2.currentState}");
						}
					}
					catch
					{
					}
					if (!CanOpenMenu(out string why2))
					{
						list.Add("the RepoRPG menu can't open (" + why2 + ")");
					}
					float num2 = Game.Get(instance, "MoveSpeed", 0f);
					if (!(num2 > 0f))
					{
						list.Add($"move speed is {num2}");
					}
					if (list.Count <= 0)
					{
						return;
					}
					_ljToldBlock = true;
					Plugin.Log.LogWarning((object)string.Format("[late join] {0:0} s in, movement may be blocked: {1}. The game: {2}.", num, string.Join("; ", list), VanillaStateLine()));
					if (MenuBlocksGame)
					{
						ForceCloseMenu("late join: unblock movement");
					}
					if (!(num2 > 0f))
					{
						TrackedField[] allTracked = AllTracked;
						for (int i = 0; i < allTracked.Length; i++)
						{
							allTracked[i].Restore();
						}
					}
				}
			}
		}

		public void OnLateJoinDestroyed(int[] objects, int[] hinges)
