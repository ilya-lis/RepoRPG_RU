		private string VoteLine(int voteFor, string id)
		{
			if (!Season.IsSeasonVote(voteFor))
			{
				return BoonLine(id);
			}
			return Season.OptionText(id);
		}

		private string BoonLine(string id)
		{
			if (_boonLines.TryGetValue(id, out string value))
			{
				return value;
			}
			BoonDef boonDef = RunShape.Boon(id);
			value = ((boonDef == null) ? id : ("<b>" + boonDef.name + "</b>\n" + boonDef.desc));
			_boonLines[id] = value;
			return value;
		}

		private void TakeMilestone(int milestone, int choice)
		{
			_shopVote = "";
			_rsAsked.Add(milestone);
			_rsAskedAt = Time.unscaledTime;
			Net.SendMilestoneTake(milestone, choice);
			if (!Game.IsMaster())
			{
				((MonoBehaviour)this).StartCoroutine(RetryTake(milestone, choice));
			}
		}

		private IEnumerator RetryTake(int milestone, int choice)
		{
			yield return (object)new WaitForSecondsRealtime(5f);
			if (_rsAsked.Contains(milestone))
			{
				Net.SendMilestoneTake(milestone, choice);
				yield return (object)new WaitForSecondsRealtime(5f);
				if (_rsAsked.Contains(milestone))
				{
					_rsAsked.Remove(milestone);
					Toast("The host didn't answer: the milestone reward is still waiting, try again", Bad, 4f);
				}
			}
		}

