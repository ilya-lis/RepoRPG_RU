	internal static class OverclockState
	{
		private static readonly HashSet<int> Logged = new HashSet<int>();

		public static float FireMult(Component gun)
		{
			PlayerAvatar val = Holder(gun);
			if ((Object)(object)val == (Object)null || !ClassHost.Overclocked(val, out var fire, out var _))
			{
				return 1f;
			}
			return 1f + Mathf.Clamp(fire, 0f, 100f) / 100f;
		}

		public static bool HolderOverclocked(Component item)
		{
			PlayerAvatar val = Holder(item);
			float fire;
			float dmg;
			if ((Object)(object)val != (Object)null)
			{
				return ClassHost.Overclocked(val, out fire, out dmg);
			}
			return false;
		}

		public static PlayerAvatar? Holder(Component c)
		{
			PhysGrabObject val = c.GetComponent<PhysGrabObject>() ?? c.GetComponentInParent<PhysGrabObject>();
			if ((Object)(object)val == (Object)null || val.playerGrabbing == null)
			{
				return null;
			}
			foreach (PhysGrabber item in val.playerGrabbing)
			{
				if ((Object)(object)item != (Object)null && (Object)(object)item.playerAvatar != (Object)null)
				{
					return item.playerAvatar;
				}
			}
			return null;
		}

		public static void Note(Component gun, string state, float before, float after)
		{
			int item = ((Object)gun).GetInstanceID() ^ (state.GetHashCode() * 31) ^ Mathf.FloorToInt(Time.time / 10f);
			if (Logged.Add(item))
			{
				if (Logged.Count > 256)
				{
					Logged.Clear();
				}
				Plugin.Log.LogInfo((object)$"[overclock] {((Object)gun).name} ({((object)gun).GetType().Name}): {state} {before:0.###}s -> {after:0.###}s.");
			}
		}
	}
