		private void PerfStep(Rect r, string label, ConfigEntry<float> e, float min, float max, float step, string unit)
		{
			//IL_0048: Unknown result type (might be due to invalid IL or missing references)
			float v = Mathf.Clamp(e.Value, min, max);
			ValueGroup(r, label, $"{v:0}{unit}", (v > min + 0.01f) ? ((Action)delegate
			{
				SettingsSync.SaveLocalChange(delegate
				{
					e.Value = Mathf.Max(min, v - step);
				});
			}) : null, (v < max - 0.01f) ? ((Action)delegate
			{
				SettingsSync.SaveLocalChange(delegate
				{
					e.Value = Mathf.Min(max, v + step);
				});
			}) : null);
		}

