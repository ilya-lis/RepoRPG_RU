		private static bool IsKeyRebind(Rebind w)
		{
			if (w >= Rebind.KeyMenu)
			{
				return w <= Rebind.KeyNoticeDismiss;
			}
			return false;
		}

		private static bool IsPadRebind(Rebind w)
		{
			if (w >= Rebind.PadMenu)
			{
				return w <= Rebind.PadMainR;
			}
			return false;
		}

