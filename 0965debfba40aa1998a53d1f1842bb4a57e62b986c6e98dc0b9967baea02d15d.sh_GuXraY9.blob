	[Flags]
	internal enum EliteMod
	{
		None = 0,
		Armored = 1,
		Regenerating = 2,
		Swift = 4,
		Unstoppable = 8,
		Enraged = 0x10,
		Relentless = 0x20,
		Stalwart = 0x40,
		Brutish = 0x80,
		Vampiric = 0x100,
		Juggernaut = 0x200,
		Shielded = 0x400,
		Warlord = 0x800
	}
	internal static class Elites
	{
		public struct Info
		{
			public EliteMod Mods;

			public int Tier;
		}

		private static readonly Dictionary<int, Info> Table = new Dictionary<int, Info>();

		public static readonly EliteMod[] ModList = new EliteMod[5]
		{
			EliteMod.Armored,
			EliteMod.Regenerating,
			EliteMod.Swift,
			EliteMod.Unstoppable,
			EliteMod.Enraged
		};

		public static readonly EliteMod[] BossModList = new EliteMod[7]
		{
			EliteMod.Armored,
			EliteMod.Regenerating,
			EliteMod.Swift,
			EliteMod.Unstoppable,
			EliteMod.Enraged,
			EliteMod.Relentless,
			EliteMod.Stalwart
		};

		public static readonly EliteMod[] AllMods = new EliteMod[12]
		{
			EliteMod.Armored,
			EliteMod.Regenerating,
			EliteMod.Swift,
			EliteMod.Unstoppable,
			EliteMod.Enraged,
			EliteMod.Relentless,
			EliteMod.Stalwart,
			EliteMod.Brutish,
			EliteMod.Vampiric,
			EliteMod.Juggernaut,
			EliteMod.Shielded,
			EliteMod.Warlord
		};

		public static IEnumerable<KeyValuePair<int, Info>> All => Table;

		public static void Clear()
		{
			Table.Clear();
		}

		public static void Set(int viewId, EliteMod mods, int tier)
		{
			Info value;
			bool num = tier >= 3 && (!Table.TryGetValue(viewId, out value) || value.Tier < 3);
			Table[viewId] = new Info
			{
				Mods = mods,
				Tier = tier
			};
			if (num)
			{
				try
				{
					RpgRuntime.Instance?.OnBossSpawned(viewId, mods);
				}
				catch (Exception e)
				{
					Guard.Fail("boss banner", e);
				}
			}
		}

		public static bool TryGet(int viewId, out Info info)
		{
			return Table.TryGetValue(viewId, out info);
		}

		public static bool Contains(int viewId)
		{
			return Table.ContainsKey(viewId);
		}

		public static void Remove(int viewId)
		{
			Table.Remove(viewId);
		}

		public static bool TryGet(EnemyHealth eh, out Info info)
		{
			info = default(Info);
			if ((Object)(object)eh != (Object)null)
			{
				return Table.TryGetValue(ViewId((Component)(object)eh), out info);
			}
			return false;
		}

		public static int ViewId(Component c)
		{
			if ((Object)(object)c == (Object)null)
			{
				return 0;
			}
			PhotonView componentInParent = c.GetComponentInParent<PhotonView>();
			if (!((Object)(object)componentInParent != (Object)null) || componentInParent.ViewID == 0)
			{
				return ((Object)c).GetInstanceID();
			}
			return componentInParent.ViewID;
		}

		public static string TierName(int tier)
		{
			if (tier < 3)
			{
				if (tier < 2)
				{
					return "Champion";
				}
				return "Overlord";
			}
			return "Boss";
		}

		public static string Describe(EliteMod mods)
		{
			List<string> list = new List<string>();
			EliteMod[] allMods = AllMods;
			for (int i = 0; i < allMods.Length; i++)
			{
				EliteMod eliteMod = allMods[i];
				if ((mods & eliteMod) != EliteMod.None)
				{
					list.Add(eliteMod.ToString());
				}
			}
			return string.Join(" ", list);
		}

		public static bool Roll(Random rng, int levelIndex, out EliteMod mods, out int tier)
		{
			mods = EliteMod.None;
			tier = 0;
			float num = ((TeamContracts.CurseNow == "Marked") ? 15f : 0f) + Difficulty.EliteBonus();
			float num2 = Mathf.Min(Plugin.Cfg.EliteMaxChance.Value + Mathf.Max(0f, num), Plugin.Cfg.EliteBaseChance.Value + Plugin.Cfg.EliteChancePerLevel.Value * (float)levelIndex + num) / 100f;
			num2 = Mathf.Clamp01(num2 * Difficulty.EliteMult());
			float num3 = num2 * PlayerScaling.EliteChance;
			num2 = ((!(num3 > num2)) ? num3 : Mathf.Min(num3, Mathf.Max(num2, (Plugin.Cfg.EliteMaxChance.Value + Mathf.Max(0f, num)) / 100f * Difficulty.EliteMult())));
			num2 = Mathf.Clamp01(num2);
			bool flag = RunShape.Has("crowd_control");
			if (flag)
			{
				num2 *= 0.8f;
			}
			num2 = Mathf.Clamp01(num2 * RunDepth.EliteChance);
			if (rng.NextDouble() >= (double)num2)
			{
				return false;
			}
			tier = ((levelIndex < 3 || !(rng.NextDouble() < 0.25)) ? 1 : 2);
			int num4 = Mathf.Min(3, ((tier != 2 || flag) ? 1 : 2) + Ascension.EliteExtraMods);
			List<EliteMod> list = RunDepth.ElitePool();
			for (int i = 0; i < num4; i++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = rng.Next(list.Count);
				mods |= list[index];
				list.RemoveAt(index);
			}
			return true;
		}
	}
	internal static class Gear
	{
		public static int MaxRarity => Plugin.Rpg.rarities.Length - 1;

		public static RarityDef Rarity(int i)
		{
			RarityDef[] rarities = Plugin.Rpg.rarities;
			return rarities[Mathf.Clamp(i, 0, rarities.Length - 1)];
		}

		public static int RollRarity(Random rng, float luck, int floor)
		{
			RarityDef[] rarities = Plugin.Rpg.rarities;
			floor = Mathf.Clamp(floor, 0, rarities.Length - 1);
			double num = 0.0;
			double x = (double)Mathf.Clamp(Plugin.Cfg.RareOdds.Value, 25f, 300f) / 100.0;
			double[] array = new double[rarities.Length];
			for (int i = floor; i < rarities.Length; i++)
			{
				array[i] = (double)Math.Max(0f, rarities[i].weight) * (1.0 + (double)Math.Max(0f, luck) * 0.08 * (double)i) * Math.Pow(x, i);
				num += array[i];
			}
			if (num <= 0.0)
			{
				return floor;
			}
			double num2 = rng.NextDouble() * num;
			for (int j = floor; j < rarities.Length; j++)
			{
				num2 -= array[j];
				if (num2 <= 0.0)
				{
					return j;
				}
			}
			return rarities.Length - 1;
		}

		public static GearItem Roll(Random rng, float luck, int rarityFloor, string? forcedSlot = null)
		{
			return RollExact(rng, RollRarity(rng, luck, rarityFloor), forcedSlot);
		}

		public static GearItem RollUnique(Random rng, ICollection<string> owned)
		{
			RpgData rpg = Plugin.Rpg;
			List<int> list = new List<int>();
			for (int i = 0; i < rpg.slots.Length; i++)
			{
				UniqueDef[] uniques = rpg.uniques;
				foreach (UniqueDef uniqueDef in uniques)
				{
					if (uniqueDef.slot == rpg.slots[i].id && RunDepth.UniqueAllowed(uniqueDef) && !owned.Contains(uniqueDef.name))
					{
						list.Add(i);
						break;
					}
				}
			}
			if (list.Count == 0)
			{
				return RollExact(rng, MaxRarity, null, allowUnique: false);
			}
			return GearX.RollItem(rng, MaxRarity, rpg.slots[list[rng.Next(list.Count)]], allowUnique: true, forceUnique: true, owned);
		}

		public static GearItem RollExact(Random rng, int rarity, string? forcedSlot, bool allowUnique = true)
		{
			RpgData rpg = Plugin.Rpg;
			rarity = Mathf.Clamp(rarity, 0, MaxRarity);
			int num = ((forcedSlot != null) ? Math.Max(0, rpg.SlotIndex(forcedSlot)) : rng.Next(rpg.slots.Length));
			return GearX.RollItem(rng, rarity, rpg.slots[num], allowUnique);
		}

		public static string Describe(GearItem g)
		{
			List<string> list = new List<string>();
			EffectDef[] effects = g.effects;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex >= 0)
				{
					list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
				}
			}
			return string.Join(", ", list);
		}

		public static string SlotName(string id)
		{
			SlotDef[] slots = Plugin.Rpg.slots;
			foreach (SlotDef slotDef in slots)
			{
				if (slotDef.id == id)
				{
					return slotDef.name;
				}
			}
			return id;
		}

		public static int ValuableRarity(int viewId)
		{
			RarityDef[] rarities = Plugin.Rpg.rarities;
			Random random = RunInfo.RngFor(viewId * 7919 + RunInfo.LevelIndex * 104729);
			double num = 0.0;
			RarityDef[] array = rarities;
			foreach (RarityDef rarityDef in array)
			{
				num += (double)Math.Max(0f, rarityDef.valueWeight);
			}
			double num2 = random.NextDouble() * num;
			for (int j = 0; j < rarities.Length; j++)
			{
				num2 -= (double)Math.Max(0f, rarities[j].valueWeight);
				if (num2 <= 0.0)
				{
					return j;
				}
			}
			return 0;
		}
	}
	[Serializable]
	public class SetDef
	{
		public string id = "";

		public string name = "";

		public string color = "#FFFFFF";

		public string twoDesc = "";

		public string fourDesc = "";

		public EffectDef[] two = Array.Empty<EffectDef>();

		public EffectDef[] four = Array.Empty<EffectDef>();
	}
	[Serializable]
	public class SetFile
	{
		public int version = 1;

		public SetDef[] sets = Array.Empty<SetDef>();
	}
	internal static class GearSets
	{
		public static readonly List<SetDef> All = new List<SetDef>();

		private static readonly Dictionary<string, SetDef> ById = new Dictionary<string, SetDef>();

		public static void Load()
		{
			All.Clear();
			ById.Clear();
			string text = ClassDatabase.ReadEmbedded("sets");
			SetFile setFile = null;
			try
			{
				setFile = Json.Deserialize<SetFile>(ClassDatabase.ReadWithOverride("sets", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("sets data parse error: " + ex.Message));
			}
			if (setFile?.sets == null || setFile.sets.Length == 0)
			{
				try
				{
					setFile = Json.Deserialize<SetFile>(text);
				}
				catch
				{
					setFile = new SetFile();
				}
			}
			SetDef[] array = setFile?.sets ?? Array.Empty<SetDef>();
			foreach (SetDef setDef in array)
			{
				if (setDef != null && !(setDef.id == "") && !ById.ContainsKey(setDef.id))
				{
					SetDef setDef2 = setDef;
					if (setDef2.two == null)
					{
						setDef2.two = Array.Empty<EffectDef>();
					}
					setDef2 = setDef;
					if (setDef2.four == null)
					{
						setDef2.four = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("set " + setDef.id, setDef.two);
					ClassDatabase.ResolveAll("set " + setDef.id, setDef.four);
					All.Add(setDef);
					ById[setDef.id] = setDef;
				}
			}
		}

		public static SetDef? Get(string? id)
		{
			if (string.IsNullOrEmpty(id) || !ById.TryGetValue(id, out SetDef value))
			{
				return null;
			}
			return value;
		}

		public static void MakeSetPiece(GearItem item, Random rng)
		{
			if (All.Count != 0 && item != null)
			{
				item.set = All[rng.Next(All.Count)].id;
			}
		}

		public static Dictionary<string, int> Worn(IEnumerable<GearItem> equipped)
		{
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			foreach (GearItem item in equipped)
			{
				if (item != null && Get(item.set) != null)
				{
					dictionary.TryGetValue(item.set, out var value);
					dictionary[item.set] = value + 1;
				}
			}
			return dictionary;
		}

		public static IEnumerable<(SetDef set, int pieces, EffectDef[] effects)> Active(IEnumerable<GearItem> equipped)
		{
			foreach (KeyValuePair<string, int> kv in Worn(equipped))
			{
				SetDef s = Get(kv.Key);
				if (s != null)
				{
					if (kv.Value >= 2)
					{
						yield return (set: s, pieces: 2, effects: s.two);
					}
					if (kv.Value >= 4)
					{
						yield return (set: s, pieces: 4, effects: s.four);
					}
				}
			}
		}

		public static string Progress(SetDef s, int worn)
		{
			string text = "#8cf2bf";
			string text2 = "#80838a";
			return $"<color={s.color}><b>{s.name} set {Mathf.Min(worn, 4)}/4</b></color>\n" + "<color=" + ((worn >= 2) ? text : text2) + ">2 pieces: " + s.twoDesc + "</color>\n<color=" + ((worn >= 4) ? text : text2) + ">4 pieces: " + s.fourDesc + "</color>";
		}

		public static List<(string text, bool gained)> CompareChange(RunSave run, GearItem candidate)
		{
			List<GearItem> list = new List<GearItem>(run.EquippedItems());
			List<GearItem> list2 = new List<GearItem>();
			foreach (GearItem item in list)
			{
				if (item.slot != candidate.slot)
				{
					list2.Add(item);
				}
			}
			list2.Add(candidate);
			Dictionary<string, int> dictionary = Worn(list);
			Dictionary<string, int> dictionary2 = Worn(list2);
			List<(string, bool)> list3 = new List<(string, bool)>();
			HashSet<string> hashSet = new HashSet<string>(dictionary.Keys);
			hashSet.UnionWith(dictionary2.Keys);
			foreach (string item2 in hashSet)
			{
				SetDef setDef = Get(item2);
				if (setDef == null)
				{
					continue;
				}
				dictionary.TryGetValue(item2, out var value);
				dictionary2.TryGetValue(item2, out var value2);
				int[] array = new int[2] { 2, 4 };
				foreach (int num in array)
				{
					if (value < num && value2 >= num)
					{
						list3.Add(($"+ {setDef.name} {num}-piece: {((num == 2) ? setDef.twoDesc : setDef.fourDesc)}", true));
					}
					if (value >= num && value2 < num)
					{
						list3.Add(($"- {setDef.name} {num}-piece: {((num == 2) ? setDef.twoDesc : setDef.fourDesc)}", false));
					}
				}
			}
			return list3;
		}
	}
	internal static class GearUp
	{
		private static GearUpgradeDef D => GearX.Pack.upgrades ?? new GearUpgradeDef();

		public static int Max => Mathf.Clamp(D.max, 1, 10);

		public static string Title(GearItem g)
		{
			if (g.up <= 0)
			{
				return g.name;
			}
			return $"{g.name} +{g.up}";
		}

		public static float Shown(float v)
		{
			if (!(Mathf.Abs(v) >= 1.5f))
			{
				return (float)Math.Round(v, 2);
			}
			return Mathf.Round(v);
		}

		public static string Pips(GearItem g)
		{
			StringBuilder stringBuilder = new StringBuilder();
			for (int i = 1; i <= Max; i++)
			{
				stringBuilder.Append((i <= g.up) ? "■" : "□");
			}
			return stringBuilder.ToString();
		}

		public static bool CanUpgrade(GearItem g, out string why)
		{
			why = "";
			if (Starters.Is(g))
			{
				why = "Starter items can't be upgraded";
				return false;
			}
			if (g.up >= Max)
			{
				why = "Fully upgraded";
				return false;
			}
			return true;
		}

		private static int Rar(GearItem g)
		{
			return Mathf.Clamp(g.rarity, 0, Gear.MaxRarity);
		}

		private static int At(int[] a, int i, int fallback)
		{
			if (a == null || i < 0 || i >= a.Length)
			{
				return fallback;
			}
			return a[i];
		}

		private static float At(float[] a, int i, float fallback)
		{
			if (a == null || i < 0 || i >= a.Length)
			{
				return fallback;
			}
			return a[i];
		}

		public static int LineRoom(GearItem g)
		{
			return Mathf.Max(0, At(D.extraLines, Rar(g), 1) - g.upFx.Length);
		}

		public static bool IsLineLevel(int level)
		{
			return Array.IndexOf(D.lineLevels ?? Array.Empty<int>(), level) >= 0;
		}

		public static bool AddsLine(GearItem g)
		{
			if (IsLineLevel(g.up + 1))
			{
				return LineRoom(g) > 0;
			}
			return false;
		}

		public static bool AddsSocket(GearItem g)
		{
			if (g.up + 1 == D.socketAt)
			{
				return g.sockets < Mathf.Clamp(At(D.socketMax, Rar(g), 1), 0, 2);
			}
			return false;
		}

		public static string NextText(GearItem g)
		{
			if (g.up >= Max)
			{
				return "fully upgraded";
			}
			int num = g.up + 1;
			string text = (AddsLine(g) ? "a new line (pick 1 of 3)" : (IsLineLevel(num) ? $"all lines +{D.step:0}% (no room for a new line)" : $"all lines +{D.step:0}%"));
			if (AddsSocket(g))
			{
				text += " and a socket";
			}
			return $"+{num}: {text}";
		}

		public static string PriceKey(GearItem g)
		{
			return $"upg:{Rar(g)}:{g.up + 1}";
		}

		public static float ScrapFor(string key)
		{
			string[] array = key.Split(':');
			if (array.Length < 3 || !int.TryParse(array[1], out var result) || !int.TryParse(array[2], out var result2) || result2 < 1 || result2 > Max)
			{
				return -1f;
			}
			return At(D.scrap, result2 - 1, 0f) * At(D.rarityFactor, Mathf.Clamp(result, 0, Gear.MaxRarity), 1f);
		}

		public static int[] PartsFor(GearItem g)
		{
			int num = g.up + 1;
			int[] array = new int[4];
			if (num == Max && Rar(g) >= Gear.MaxRarity && D.legendaryLastParts != null && D.legendaryLastParts.Length >= 4)
			{
				for (int i = 0; i < 4; i++)
				{
					array[i] = Mathf.Max(0, D.legendaryLastParts[i]);
				}
				return array;
			}
			for (int j = 0; j < 4; j++)
			{
				array[j] = Mathf.Max(0, At(D.parts, (num - 1) * 4 + j, 0));
			}
			return array;
		}

		private static AffixDef? Affix(GearItem g, string stat)
		{
			int num = Plugin.Rpg.SlotIndex(g.slot);
			if (num < 0)
			{
				return null;
			}
			AffixDef[] affixes = Plugin.Rpg.slots[num].affixes;
			foreach (AffixDef affixDef in affixes)
			{
				if (string.Equals(affixDef.stat, stat, StringComparison.OrdinalIgnoreCase))
				{
					return affixDef;
				}
			}
			return null;
		}

		private static float Roll(AffixDef af, float mult, Random rng)
		{
			double num = ((double)af.min + (double)(af.max - af.min) * rng.NextDouble()) * (double)mult;
			float num2 = ((Math.Abs(af.max) >= 1.5f) ? ((float)Math.Round(num)) : ((float)Math.Round(num, 2)));
			if (num2 != 0f)
			{
				return num2;
			}
			if (!(af.max >= 0f))
			{
				return -1f;
			}
			return 1f;
		}

		private static bool Has(GearItem g, string stat)
		{
			EffectDef[] effects = g.effects;
			for (int i = 0; i < effects.Length; i++)
			{
				if (string.Equals(effects[i].stat, stat, StringComparison.OrdinalIgnoreCase))
				{
					return true;
				}
			}
			effects = g.upFx;
			for (int i = 0; i < effects.Length; i++)
			{
				if (string.Equals(effects[i].stat, stat, StringComparison.OrdinalIgnoreCase))
				{
					return true;
				}
			}
			return false;
		}

		public static EffectDef[] Offers(GearItem g)
		{
			int num = g.up + 1;
			if (g.upOfferFor == num && g.upOffer.Length != 0)
			{
				return g.upOffer;
			}
			int num2 = Plugin.Rpg.SlotIndex(g.slot);
			List<AffixDef> list = ((num2 >= 0) ? new List<AffixDef>(Plugin.Rpg.slots[num2].affixes) : new List<AffixDef>());
			list.RemoveAll((AffixDef a) => Has(g, a.stat));
			Random random = new Random();
			List<EffectDef> list2 = new List<EffectDef>();
			float mult = Gear.Rarity(g.rarity).mult;
			for (int num3 = 0; num3 < Mathf.Clamp(D.choices, 1, 5); num3++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = random.Next(list.Count);
				list2.Add(new EffectDef
				{
					stat = list[index].stat,
					value = Roll(list[index], mult, random)
				});
				list.RemoveAt(index);
			}
			g.upOffer = list2.ToArray();
			g.upOfferFor = num;
			ClassDatabase.ResolveAll("upgrade offer", g.upOffer);
			return g.upOffer;
		}

		public static void Apply(GearItem g, EffectDef? line, int scrapPaid)
		{
			int num = g.up + 1;
			if (line != null && AddsLine(g))
			{
				List<EffectDef> list = new List<EffectDef>(g.upFx)
				{
					new EffectDef
					{
						stat = line.stat,
						value = line.value
					}
				};
				List<int> list2 = new List<int>(g.upFxAt) { num };
				g.upFx = list.ToArray();
				g.upFxAt = list2.ToArray();
				ClassDatabase.ResolveAll("gear upgrade " + g.name, g.upFx);
			}
			else
			{
				g.upSteps++;
			}
			if (AddsSocket(g))
			{
				g.sockets++;
				string[] array = new string[g.sockets];
				for (int i = 0; i < array.Length; i++)
				{
					array[i] = ((i < g.modules.Length) ? g.modules[i] : "");
				}
				g.modules = array;
			}
			g.up = num;
			g.upScrap += Mathf.Max(0, scrapPaid);
			g.upOffer = Array.Empty<EffectDef>();
			g.upOfferFor = 0;
		}

		private static int FixedTail(GearItem g)
		{
			if (Cursed.Is(g))
			{
				return Mathf.Clamp(g.cursedLines, 0, g.effects.Length);
			}
			if (g.unique == "")
			{
				return 0;
			}
			UniqueDef[] uniques = Plugin.Rpg.uniques;
			foreach (UniqueDef uniqueDef in uniques)
			{
				if (uniqueDef.name == g.unique)
				{
					return Mathf.Clamp(uniqueDef.effects.Length, 0, g.effects.Length);
				}
			}
			return 0;
		}

		public static float LineMult(GearItem g, int i)
		{
			if (g.upSteps <= 0 || i < 0 || i >= g.effects.Length)
			{
				return 1f;
			}
			if (g.hasBase && i == 0)
			{
				return 1f;
			}
			if (i >= g.effects.Length - FixedTail(g))
			{
				return 1f;
			}
			return StepMult(g, g.effects[i]);
		}

		public static float UpMult(GearItem g, EffectDef e)
		{
			if (g.upSteps > 0)
			{
				return StepMult(g, e);
			}
			return 1f;
		}

		private static float StepMult(GearItem g, EffectDef e)
		{
			AffixDef affixDef = Affix(g, e.stat);
			if (affixDef == null || Mathf.Abs(e.value) < 0.0001f)
			{
				return 1f;
			}
			float num = 1f + Mathf.Clamp(D.step, 0f, 100f) / 100f * (float)g.upSteps;
			float num2 = Mathf.Abs(Mathf.Max(Mathf.Abs(affixDef.max), Mathf.Abs(affixDef.min)) * Gear.Rarity(g.rarity).mult);
			if (num2 > 0f && Mathf.Abs(e.value) * num > num2)
			{
				num = Mathf.Max(1f, num2 / Mathf.Abs(e.value));
			}
			return num;
		}

		public static void RerollLines(GearItem g, Random rng)
		{
			if (g.upFx.Length == 0)
			{
				return;
			}
			int num = Plugin.Rpg.SlotIndex(g.slot);
			if (num < 0)
			{
				return;
			}
			int[] upFxAt = g.upFxAt;
			int num2 = g.upFx.Length;
			g.upFx = Array.Empty<EffectDef>();
			List<AffixDef> list = new List<AffixDef>(Plugin.Rpg.slots[num].affixes);
			list.RemoveAll((AffixDef a) => Has(g, a.stat));
			List<EffectDef> list2 = new List<EffectDef>();
			float mult = Gear.Rarity(g.rarity).mult;
			for (int num3 = 0; num3 < num2; num3++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = rng.Next(list.Count);
				list2.Add(new EffectDef
				{
					stat = list[index].stat,
					value = Roll(list[index], mult, rng)
				});
				list.RemoveAt(index);
			}
			g.upFx = list2.ToArray();
			int[] array = new int[g.upFx.Length];
			for (int num4 = 0; num4 < array.Length; num4++)
			{
				array[num4] = ((num4 >= upFxAt.Length) ? 1 : upFxAt[num4]);
			}
			g.upFxAt = array;
			g.upOffer = Array.Empty<EffectDef>();
			g.upOfferFor = 0;
			ClassDatabase.ResolveAll("gear upgrade " + g.name, g.upFx);
		}

		public static void CopyTo(GearItem from, GearItem to)
		{
			to.up = from.up;
			to.upSteps = from.upSteps;
			to.upScrap = from.upScrap;
			to.upFx = new EffectDef[from.upFx.Length];
			for (int i = 0; i < from.upFx.Length; i++)
			{
				to.upFx[i] = new EffectDef
				{
					stat = from.upFx[i].stat,
					value = from.upFx[i].value
				};
			}
			to.upFxAt = (int[])from.upFxAt.Clone();
			ClassDatabase.ResolveAll("gear upgrade " + to.name, to.upFx);
			if (from.sockets > to.sockets)
			{
				to.sockets = from.sockets;
				string[] array = new string[to.sockets];
				for (int j = 0; j < array.Length; j++)
				{
					array[j] = ((j < from.modules.Length) ? from.modules[j] : "");
				}
				to.modules = array;
			}
		}

		public static int SalvageBonus(GearItem g)
		{
			return Mathf.FloorToInt((float)Mathf.Max(0, g.upScrap) * Mathf.Clamp(D.salvageBack, 0f, 90f) / 100f);
		}

		public static void Resolve(GearItem g)
		{
			if (g.upFx.Length != 0)
			{
				ClassDatabase.ResolveAll("gear upgrade " + g.name, g.upFx);
			}
			if (g.upOffer.Length != 0)
			{
				ClassDatabase.ResolveAll("upgrade offer", g.upOffer);
			}
		}
	}
	internal static class GearX
	{
		public static GearPack Pack = new GearPack();

		private static readonly Dictionary<string, GearBehaviorDef> Behaviors = new Dictionary<string, GearBehaviorDef>();

		private static readonly Dictionary<string, GearModuleDef> Modules = new Dictionary<string, GearModuleDef>();

		private static readonly Dictionary<string, string> Prefix = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

		private static readonly Dictionary<string, string> Suffix = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

		public const int BagSize = 10;

		public static readonly int[] TierAt = new int[3] { 25, 75, 150 };

		public static readonly string[] TierNames = new string[3] { "Bonded", "Tempered", "Soulbound" };

		private static readonly List<(EffectDef, float)> Buf = new List<(EffectDef, float)>();

		private static ModConfig C => Plugin.Cfg;

		public static IEnumerable<GearModuleDef> AllModules
		{
			get
			{
				foreach (GearModuleDef value in Modules.Values)
				{
					if (string.IsNullOrEmpty(value.research) || Research.Has(value.research))
					{
						yield return value;
					}
				}
			}
		}

		public static void Load()
		{
			Behaviors.Clear();
			Modules.Clear();
			Prefix.Clear();
			Suffix.Clear();
			string text = ClassDatabase.ReadEmbedded("gear");
			GearPack gearPack = null;
			try
			{
				gearPack = Json.Deserialize<GearPack>(ClassDatabase.ReadWithOverride("gear", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("gear data parse error: " + ex.Message));
			}
			if (gearPack != null)
			{
				GearBaseDef[] bases = gearPack.bases;
				if (bases != null && bases.Length != 0)
				{
					goto IL_008c;
				}
			}
			try
			{
				gearPack = Json.Deserialize<GearPack>(text);
			}
			catch
			{
				gearPack = new GearPack();
			}
			goto IL_008c;
			IL_008c:
			Pack = gearPack ?? new GearPack();
			GearPack pack = Pack;
			if (pack.bases == null)
			{
				pack.bases = Array.Empty<GearBaseDef>();
			}
			pack = Pack;
			if (pack.behaviors == null)
			{
				pack.behaviors = Array.Empty<GearBehaviorDef>();
			}
			pack = Pack;
			if (pack.modules == null)
			{
				pack.modules = Array.Empty<GearModuleDef>();
			}
			pack = Pack;
			if (pack.uniques == null)
			{
				pack.uniques = Array.Empty<UniqueDef>();
			}
			pack = Pack;
			if (pack.behaviorChance == null)
			{
				pack.behaviorChance = Array.Empty<float>();
			}
			pack = Pack;
			if (pack.attunement == null)
			{
				pack.attunement = Array.Empty<GearMilestoneDef>();
			}
			GearBehaviorDef[] behaviors = Pack.behaviors;
			foreach (GearBehaviorDef gearBehaviorDef in behaviors)
			{
				if (gearBehaviorDef != null && !(gearBehaviorDef.id == ""))
				{
					GearBehaviorDef gearBehaviorDef2 = gearBehaviorDef;
					if (gearBehaviorDef2.effects == null)
					{
						gearBehaviorDef2.effects = Array.Empty<EffectDef>();
					}
					gearBehaviorDef2 = gearBehaviorDef;
					if (gearBehaviorDef2.slots == null)
					{
						gearBehaviorDef2.slots = Array.Empty<string>();
					}
					ClassDatabase.ResolveAll("behavior " + gearBehaviorDef.id, gearBehaviorDef.effects);
					Behaviors[gearBehaviorDef.id] = gearBehaviorDef;
				}
			}
			GearModuleDef[] modules = Pack.modules;
			foreach (GearModuleDef gearModuleDef in modules)
			{
				if (gearModuleDef != null && !(gearModuleDef.id == ""))
				{
					GearModuleDef gearModuleDef2 = gearModuleDef;
					if (gearModuleDef2.effects == null)
					{
						gearModuleDef2.effects = Array.Empty<EffectDef>();
					}
					ClassDatabase.ResolveAll("module " + gearModuleDef.id, gearModuleDef.effects);
					Modules[gearModuleDef.id] = gearModuleDef;
				}
			}
			GearWordDef[] array = Pack.prefixes ?? Array.Empty<GearWordDef>();
			foreach (GearWordDef gearWordDef in array)
			{
				if (gearWordDef != null)
				{
					Prefix[gearWordDef.stat] = gearWordDef.word;
				}
			}
			array = Pack.suffixes ?? Array.Empty<GearWordDef>();
			foreach (GearWordDef gearWordDef2 in array)
			{
				if (gearWordDef2 != null)
				{
					Suffix[gearWordDef2.stat] = gearWordDef2.word;
				}
			}
			if (Pack.uniques.Length != 0)
			{
				UniqueDef[] uniques = Pack.uniques;
				foreach (UniqueDef uniqueDef in uniques)
				{
					UniqueDef uniqueDef2 = uniqueDef;
					if (uniqueDef2.effects == null)
					{
						uniqueDef2.effects = Array.Empty<EffectDef>();
					}
					uniqueDef2 = uniqueDef;
					if (uniqueDef2.role == null)
					{
						uniqueDef2.role = "";
					}
					uniqueDef2 = uniqueDef;
					if (uniqueDef2.flavor == null)
					{
						uniqueDef2.flavor = "";
					}
					uniqueDef2 = uniqueDef;
					if (uniqueDef2.unlock == null)
					{
						uniqueDef2.unlock = "";
					}
					ClassDatabase.ResolveAll("unique " + uniqueDef.name, uniqueDef.effects);
				}
				Plugin.Rpg.uniques = Pack.uniques;
			}
			pack = Pack;
			if (pack.cursed == null)
			{
				pack.cursed = Array.Empty<CursedDef>();
			}
			Cursed.Load(Pack);
			Starters.Load(Pack);
		}

		public static GearBehaviorDef? Behavior(string? id)
		{
			if (string.IsNullOrEmpty(id) || !Behaviors.TryGetValue(id, out GearBehaviorDef value))
			{
				return null;
			}
			return value;
		}

		public static GearModuleDef? Module(string? id)
		{
			if (string.IsNullOrEmpty(id) || !Modules.TryGetValue(id, out GearModuleDef value))
			{
				return null;
			}
			return value;
		}

		public static UniqueDef? UniqueOf(GearItem g)
		{
			if (string.IsNullOrEmpty(g.unique))
			{
				return null;
			}
			UniqueDef[] uniques = Plugin.Rpg.uniques;
			foreach (UniqueDef uniqueDef in uniques)
			{
				if (uniqueDef.name == g.unique)
				{
					return uniqueDef;
				}
			}
			return null;
		}

		public static int Tier(GearItem g)
		{
			if (g.attune < TierAt[2])
			{
				if (g.attune < TierAt[1])
				{
					return (g.attune >= TierAt[0]) ? 1 : 0;
				}
				return 2;
			}
			return 3;
		}

		public static (int have, int need) NextTier(GearItem g)
		{
			int num = Tier(g);
			if (num >= 3)
			{
				return (have: 0, need: 0);
			}
			int num2 = ((num != 0) ? TierAt[num - 1] : 0);
			return (have: g.attune - num2, need: TierAt[num] - num2);
		}

		public static bool Soulbound(GearItem g)
		{
			return Tier(g) >= 3;
		}

		public static int StrongestLine(GearItem g)
		{
			int num = Plugin.Rpg.SlotIndex(g.slot);
			if (num < 0)
			{
				return -1;
			}
			RarityDef rarityDef = Gear.Rarity(g.rarity);
			int num2 = -1;
			float num3 = -1f;
			int num4 = g.effects.Length - Mathf.Clamp(g.cursedLines, 0, g.effects.Length);
			for (int i = (g.hasBase ? 1 : 0); i < num4; i++)
			{
				EffectDef effectDef = g.effects[i];
				if (effectDef.StatIndex < 0)
				{
					continue;
				}
				AffixDef affixDef = null;
				AffixDef[] affixes = Plugin.Rpg.slots[num].affixes;
				foreach (AffixDef affixDef2 in affixes)
				{
					if (string.Equals(affixDef2.stat, effectDef.stat, StringComparison.OrdinalIgnoreCase))
					{
						affixDef = affixDef2;
						break;
					}
				}
				float num5 = ((affixDef != null) ? Mathf.Abs(affixDef.max * rarityDef.mult) : Mathf.Abs(effectDef.value));
				float num6 = ((num5 > 0.0001f) ? (Mathf.Abs(effectDef.value) / num5) : 0f);
				if (num6 > num3)
				{
					num3 = num6;
					num2 = i;
				}
			}
			if (num2 < 0 && g.effects.Length != 0 && g.effects[0].StatIndex >= 0)
			{
				num2 = 0;
			}
			return num2;
		}

		public static void Effective(GearItem g, List<(EffectDef e, float mult)> into)
		{
			int num = Tier(g);
			int num2 = ((num >= 2) ? StrongestLine(g) : (-1));
			float num3 = (Cursed.Is(g) ? Cursed.Strength(g) : 1f);
			for (int i = 0; i < g.effects.Length; i++)
			{
				float num4 = 1f;
				if (num3 < 1f && Cursed.IsMarker(g.effects[i]))
				{
					num4 *= num3;
				}
				if (i == num2)
				{
					num4 *= 1.25f;
				}
				if (num >= 3 && i == 0 && g.effects[0].StatIndex >= 0)
				{
					num4 *= 1.25f;
				}
				num4 *= GearUp.LineMult(g, i);
				into.Add((g.effects[i], num4));
			}
			EffectDef[] upFx = g.upFx;
			foreach (EffectDef effectDef in upFx)
			{
				into.Add((effectDef, GearUp.UpMult(g, effectDef)));
			}
			if (num >= 1)
			{
				upFx = g.hidden;
				foreach (EffectDef item in upFx)
				{
					into.Add((item, 1f));
				}
			}
			string[] modules = g.modules;
			for (int j = 0; j < modules.Length; j++)
			{
				GearModuleDef gearModuleDef = Module(modules[j]);
				if (gearModuleDef != null)
				{
					upFx = gearModuleDef.effects;
					foreach (EffectDef item2 in upFx)
					{
						into.Add((item2, 1f));
					}
				}
			}
		}

		public static void AddStats(GearItem g, float[] into, float scale = 1f)
		{
			Buf.Clear();
			Effective(g, Buf);
			foreach (var (effectDef, num) in Buf)
			{
				if (effectDef.StatIndex >= 0 && effectDef.StatIndex < into.Length)
				{
					into[effectDef.StatIndex] += effectDef.value * num * scale;
				}
			}
		}

		public static bool Has(GearItem g, string key)
		{
			EffectDef[] effects = g.effects;
			for (int i = 0; i < effects.Length; i++)
			{
				if (string.Equals(effects[i].stat, key, StringComparison.OrdinalIgnoreCase))
				{
					return true;
				}
			}
			return false;
		}

		public static GearBaseDef? BaseOf(string slot)
		{
			GearBaseDef[] bases = Pack.bases;
			foreach (GearBaseDef gearBaseDef in bases)
			{
				if (gearBaseDef.slot == slot)
				{
					return gearBaseDef;
				}
			}
			return null;
		}

		private static float Roll(float min, float max, float mult, Random rng)
		{
			double num = ((double)min + (double)(max - min) * rng.NextDouble()) * (double)mult;
			float num2 = ((Math.Abs(max) >= 1.5f) ? ((float)Math.Round(num)) : ((float)Math.Round(num, 2)));
			if (num2 != 0f)
			{
				return num2;
			}
			if (!(max >= 0f))
			{
				return -1f;
			}
			return 1f;
		}

		public static int SocketsFor(int rarity, bool unique, Random rng)
		{
			int num = ((rarity < 4) ? (rarity switch
			{
				2 => (rng.NextDouble() < 0.4) ? 1 : 0, 
				3 => 1, 
				_ => 0, 
			}) : ((!(rng.NextDouble() < 0.5)) ? 1 : 2));
			if (unique)
			{
				num = Mathf.Max(num, 1);
			}
			return num;
		}

		public static GearItem RollItem(Random rng, int rarity, SlotDef slot, bool allowUnique, bool forceUnique = false, ICollection<string>? exclude = null)
		{
			RarityDef rarityDef = Gear.Rarity(rarity);
			GearItem gearItem = new GearItem
			{
				uid = Guid.NewGuid().ToString("N").Substring(0, 12),
				slot = slot.id,
				rarity = rarity
			};
			string baseName = ((slot.bases.Length != 0) ? slot.bases[rng.Next(slot.bases.Length)] : slot.name);
			List<EffectDef> list = new List<EffectDef>();
			List<AffixDef> list2 = new List<AffixDef>(slot.affixes);
			GearBaseDef bd = BaseOf(slot.id);
			if (bd != null)
			{
				list.Add(new EffectDef
				{
					stat = bd.stat,
					value = Roll(bd.min, bd.max, rarityDef.mult, rng)
				});
				list2.RemoveAll((AffixDef a) => string.Equals(a.stat, bd.stat, StringComparison.OrdinalIgnoreCase));
				gearItem.hasBase = true;
			}
			int num = Math.Min(Math.Max(0, rarityDef.affixes - ((bd != null) ? 1 : 0)), list2.Count);
			float num2 = ((rarity < Pack.behaviorChance.Length) ? Pack.behaviorChance[rarity] : 0f);
			num2 *= Mathf.Clamp(C.BehaviorAffixChance.Value, 0f, 3f);
			GearBehaviorDef gearBehaviorDef = null;
			if (num >= 1 && rng.NextDouble() * 100.0 < (double)num2)
			{
				List<GearBehaviorDef> list3 = new List<GearBehaviorDef>();
				foreach (GearBehaviorDef value in Behaviors.Values)
				{
					if ((value.slots.Length == 0 || Array.IndexOf(value.slots, slot.id) >= 0) && (string.IsNullOrEmpty(value.research) || Research.Has(value.research)))
					{
						list3.Add(value);
					}
				}
				if (list3.Count > 0)
				{
					gearBehaviorDef = list3[rng.Next(list3.Count)];
					num--;
				}
			}
			List<string> list4 = new List<string>();
			for (int num3 = 0; num3 < num; num3++)
			{
				int index = rng.Next(list2.Count);
				AffixDef affixDef = list2[index];
				list2.RemoveAt(index);
				list.Add(new EffectDef
				{
					stat = affixDef.stat,
					value = Roll(affixDef.min, affixDef.max, rarityDef.mult, rng)
				});
				list4.Add(affixDef.stat);
			}
			if (gearBehaviorDef != null)
			{
				gearItem.behavior = gearBehaviorDef.id;
				EffectDef[] effects = gearBehaviorDef.effects;
				foreach (EffectDef effectDef in effects)
				{
					list.Add(new EffectDef
					{
						stat = effectDef.stat,
						value = effectDef.value
					});
				}
			}
			if (list2.Count > 0)
			{
				AffixDef affixDef2 = list2[rng.Next(list2.Count)];
				gearItem.hidden = new EffectDef[1]
				{
					new EffectDef
					{
						stat = affixDef2.stat,
						value = Roll(affixDef2.min, affixDef2.max, rarityDef.mult * 0.5f, rng)
					}
				};
			}
			gearItem.name = Name(baseName, gearBehaviorDef, list4);
			gearItem.sockets = SocketsFor(rarity, unique: false, rng);
			if (rarity == Gear.MaxRarity && allowUnique && (forceUnique || rng.NextDouble() * 100.0 < (double)Mathf.Clamp(C.UniqueChance.Value, 0f, 100f)))
			{
				List<UniqueDef> list5 = new List<UniqueDef>();
				UniqueDef[] uniques = Plugin.Rpg.uniques;
				foreach (UniqueDef uniqueDef in uniques)
				{
					if (uniqueDef.slot == slot.id && RunDepth.UniqueAllowed(uniqueDef) && (exclude == null || !exclude.Contains(uniqueDef.name)))
					{
						list5.Add(uniqueDef);
					}
				}
				if (list5.Count > 0)
				{
					UniqueDef uniqueDef2 = list5[rng.Next(list5.Count)];
					gearItem.unique = uniqueDef2.name;
					gearItem.uniqueDesc = uniqueDef2.desc;
					gearItem.flavor = uniqueDef2.flavor ?? "";
					gearItem.name = uniqueDef2.name;
					EffectDef[] effects = uniqueDef2.effects;
					foreach (EffectDef effectDef2 in effects)
					{
						list.Add(new EffectDef
						{
							stat = effectDef2.stat,
							value = effectDef2.value
						});
					}
					gearItem.sockets = Mathf.Max(gearItem.sockets, 1);
				}
			}
			gearItem.modules = new string[gearItem.sockets];
			for (int num5 = 0; num5 < gearItem.modules.Length; num5++)
			{
				gearItem.modules[num5] = "";
			}
			gearItem.effects = list.ToArray();
			ClassDatabase.ResolveAll("gear " + gearItem.name, gearItem.effects);
			ClassDatabase.ResolveAll("gear " + gearItem.name, gearItem.hidden);
			return gearItem;
		}

		public static string Name(string baseName, GearBehaviorDef? beh, List<string> statAffixes)
		{
			string value;
			string text = ((beh != null) ? beh.name : ((statAffixes.Count > 0 && Prefix.TryGetValue(statAffixes[0], out value)) ? value : ""));
			string text2 = ((beh == null) ? ((statAffixes.Count > 1) ? statAffixes[1] : "") : ((statAffixes.Count > 0) ? statAffixes[0] : ""));
			string value2;
			string text3 = ((text2 != "" && Suffix.TryGetValue(text2, out value2)) ? value2 : "");
			string text4 = ((text != "") ? (text + " ") : "") + baseName;
			if (!(text3 != ""))
			{
				return text4;
			}
			return text4 + " of the " + text3;
		}

		public static GearItem Reroll(GearItem cur, Random rng, int rarity)
		{
			RpgData rpg = Plugin.Rpg;
			int num = Math.Max(0, rpg.SlotIndex(cur.slot));
			SlotDef slot = rpg.slots[num];
			rarity = Mathf.Clamp(rarity, cur.rarity, Gear.MaxRarity);
			GearItem gearItem = RollItem(rng, rarity, slot, allowUnique: false);
			float num2 = Gear.Rarity(rarity).mult / Mathf.Max(0.01f, Gear.Rarity(cur.rarity).mult);
			List<EffectDef> list = new List<EffectDef>();
			string text = "";
			if (cur.hasBase && cur.effects.Length != 0)
			{
				EffectDef effectDef = cur.effects[0];
				text = effectDef.stat;
				list.Add(new EffectDef
				{
					stat = effectDef.stat,
					value = ((num2 == 1f) ? effectDef.value : ((Mathf.Abs(effectDef.value) >= 1.5f) ? Mathf.Round(effectDef.value * num2) : ((float)Math.Round(effectDef.value * num2, 2))))
				});
			}
			GearBehaviorDef gearBehaviorDef = Behavior(gearItem.behavior);
			int num3 = ((gearBehaviorDef != null) ? gearBehaviorDef.effects.Length : 0);
			bool num4 = gearItem.hasBase;
			int num5 = gearItem.effects.Length - num3;
			List<string> list2 = new List<string>();
			for (int i = (num4 ? 1 : 0); i < gearItem.effects.Length; i++)
			{
				EffectDef effectDef2 = gearItem.effects[i];
				if (i < num5)
				{
					if (text != "" && string.Equals(effectDef2.stat, text, StringComparison.OrdinalIgnoreCase))
					{
						continue;
					}
					list2.Add(effectDef2.stat);
				}
				list.Add(new EffectDef
				{
					stat = effectDef2.stat,
					value = effectDef2.value
				});
			}
			UniqueDef uniqueDef = null;
			if (cur.unique != "")
			{
				UniqueDef[] uniques = rpg.uniques;
				foreach (UniqueDef uniqueDef2 in uniques)
				{
					if (uniqueDef2.name == cur.unique)
					{
						uniqueDef = uniqueDef2;
						break;
					}
				}
			}
			if (uniqueDef != null)
			{
				EffectDef[] effects = uniqueDef.effects;
				foreach (EffectDef effectDef3 in effects)
				{
					list.Add(new EffectDef
					{
						stat = effectDef3.stat,
						value = effectDef3.value
					});
				}
			}
			else if (Cursed.Is(cur))
			{
				Cursed.AppendLines(cur, list);
			}
			else if (cur.unique != "")
			{
				GearBehaviorDef gearBehaviorDef2 = Behavior(cur.behavior);
				for (int k = (cur.hasBase ? 1 : 0) + Math.Max(0, Gear.Rarity(cur.rarity).affixes - (cur.hasBase ? 1 : 0) - ((gearBehaviorDef2 != null) ? 1 : 0)) + ((gearBehaviorDef2 != null) ? gearBehaviorDef2.effects.Length : 0); k < cur.effects.Length; k++)
				{
					list.Add(new EffectDef
					{
						stat = cur.effects[k].stat,
						value = cur.effects[k].value
					});
				}
			}
			GearItem obj = new GearItem
			{
				uid = cur.uid,
				slot = cur.slot,
				rarity = rarity,
				unique = cur.unique,
				uniqueDesc = cur.uniqueDesc,
				flavor = cur.flavor,
				set = cur.set,
				crafts = cur.crafts,
				rarityUps = cur.rarityUps,
				hasBase = cur.hasBase,
				behavior = gearItem.behavior,
				attune = cur.attune,
				sockets = cur.sockets,
				modules = (string[])cur.modules.Clone(),
				hidden = ((cur.hidden != null && cur.hidden.Length != 0) ? cur.hidden : gearItem.hidden),
				freeValue = cur.freeValue,
				scrapIn = cur.scrapIn,
				effects = list.ToArray(),
				cursed = cur.cursed
			};
			int cursedLines;
			if (!Cursed.Is(cur))
			{
				cursedLines = 0;
			}
			else
			{
				CursedDef? cursedDef = Cursed.Def(cur.cursed);
				cursedLines = ((cursedDef != null) ? cursedDef.effects.Length : cur.cursedLines);
			}
			obj.cursedLines = cursedLines;
			GearItem gearItem2 = obj;
			if (rarity >= 3 && gearItem2.sockets == 0)
			{
				gearItem2.sockets = 1;
				gearItem2.modules = new string[1] { "" };
			}
			if (gearItem2.modules.Length != gearItem2.sockets)
			{
				string[] array = new string[gearItem2.sockets];
				for (int l = 0; l < array.Length; l++)
				{
					array[l] = ((l < gearItem2.modules.Length) ? gearItem2.modules[l] : "");
				}
				gearItem2.modules = array;
			}
			gearItem2.name = ((cur.unique != "" || Cursed.Is(cur)) ? cur.name : Name(BaseNameOf(cur, slot), gearBehaviorDef, list2));
			ClassDatabase.ResolveAll("gear " + gearItem2.name, gearItem2.effects);
			gearItem2.starter = cur.starter;
			GearUp.CopyTo(cur, gearItem2);
			if (rarity == cur.rarity)
			{
				GearUp.RerollLines(gearItem2, rng);
			}
			return gearItem2;
		}

		private static string BaseNameOf(GearItem g, SlotDef slot)
		{
			string text = "";
			string[] bases = slot.bases;
			foreach (string text2 in bases)
			{
				if (text2.Length > text.Length && g.name.IndexOf(text2, StringComparison.OrdinalIgnoreCase) >= 0)
				{
					text = text2;
				}
			}
			if (!(text != ""))
			{
				if (slot.bases.Length == 0)
				{
					return slot.name;
				}
				return slot.bases[0];
			}
			return text;
		}

		public static int RandomAffixCount(GearItem g)
		{
			GearBehaviorDef gearBehaviorDef = Behavior(g.behavior);
			return Math.Max(0, Gear.Rarity(g.rarity).affixes - (g.hasBase ? 1 : 0) - ((gearBehaviorDef != null) ? 1 : 0)) + ((gearBehaviorDef != null) ? 1 : 0);
		}

		public static void CarryOver(GearItem from, GearItem to)
		{
			to.attune = from.attune;
			List<string> list = new List<string>();
			string[] modules = from.modules;
			foreach (string text in modules)
			{
				if (!string.IsNullOrEmpty(text))
				{
					list.Add(text);
				}
			}
			to.sockets = Mathf.Clamp(Mathf.Max(to.sockets, list.Count), 0, 2);
			string[] array = new string[to.sockets];
			for (int j = 0; j < array.Length; j++)
			{
				array[j] = ((j < list.Count) ? list[j] : "");
			}
			to.modules = array;
		}

		public static int BehaviorExtraLines(GearItem g)
		{
			GearBehaviorDef gearBehaviorDef = Behavior(g.behavior);
			if (gearBehaviorDef == null)
			{
				return 0;
			}
			int num = 0;
			EffectDef[] effects = gearBehaviorDef.effects;
			for (int i = 0; i < effects.Length; i++)
			{
				_ = effects[i];
				num++;
			}
			return Mathf.Max(0, num - 1);
		}
	}
	[Serializable]
	public class HeatCardDef
	{
		public string id = "";

		public string name = "";

		public string desc = "";

		public int heat = 1;
	}
	[Serializable]
	public class HeatFile
	{
		public int version = 1;

		public int offered = 3;

		public int maxRewardHeat = 10;

		public float scrapPerHeat = 4f;

		public float luckPerHeat = 1f;

		public HeatCardDef[] cards = Array.Empty<HeatCardDef>();
	}
	internal static class Heat
	{
		public static HeatFile Data = new HeatFile();

		public const string Skip = "skip";

		private static readonly Dictionary<int, int> Votes = new Dictionary<int, int>();

		public static bool On => Plugin.Cfg.HeatOn.Value;

		public static int Total
		{
			get
			{
				if (!On)
				{
					return 0;
				}
				return RunShape.Cur.Heat;
			}
		}

		private static int RewardHeat => Mathf.Clamp(Total, 0, Mathf.Clamp(Data.maxRewardHeat, 0, 50));

		public static float ScrapMult => 1f + (float)RewardHeat * Mathf.Clamp(Data.scrapPerHeat, 0f, 20f) / 100f;

		public static float Luck => (float)RewardHeat * Mathf.Clamp(Data.luckPerHeat, 0f, 5f);

		public static float Monsters
		{
			get
			{
				if (!Has("monster_surge"))
				{
					return 1f;
				}
				return 1.2f;
			}
		}

		public static float ShopPrices
		{
			get
			{
				if (!Has("lean_shop"))
				{
					return 1f;
				}
				return 1.15f;
			}
		}

		public static int BossMods => Has("hardened_bosses") ? 1 : 0;

		public static float BossHealth
		{
			get
			{
				if (!Has("hardened_bosses"))
				{
					return 1f;
				}
				return 1.25f;
			}
		}

		public static int VoteCount => Votes.Count;

		public static void Load()
		{
			try
			{
				Data = Json.Deserialize<HeatFile>(ClassDatabase.ReadWithOverride("heat", ClassDatabase.ReadEmbedded("heat"))) ?? new HeatFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("heat data parse error: " + ex.Message));
				Data = new HeatFile();
			}
			HeatFile data = Data;
			if (data.cards == null)
			{
				data.cards = Array.Empty<HeatCardDef>();
			}
		}

		public static HeatCardDef? Card(string id)
		{
			HeatCardDef[] cards = Data.cards;
			foreach (HeatCardDef heatCardDef in cards)
			{
				if (heatCardDef != null && heatCardDef.id == id)
				{
					return heatCardDef;
				}
			}
			return null;
		}

		public static bool Has(string id)
		{
			if (On)
			{
				return Array.IndexOf(RunShape.Cur.HeatCards, id) >= 0;
			}
			return false;
		}

		public static string Name(string option)
		{
			object obj;
			if (!(option == "skip"))
			{
				obj = Card(option)?.name;
				if (obj == null)
				{
					return option;
				}
			}
			else
			{
				obj = "Skip";
			}
			return (string)obj;
		}

		public static string Text(string option)
		{
			if (option == "skip")
			{
				return $"<b>Skip</b>\nNo heat added this chapter. Heat stays at {Total}.";
			}
			HeatCardDef heatCardDef = Card(option);
			if (heatCardDef == null)
			{
				return option;
			}
			return $"<b>{heatCardDef.name}</b>  <color=#ff8a5c>+{heatCardDef.heat} heat</color>\n<color=#ff9a8a>{heatCardDef.desc}</color>\n<color=#73ff66>Heat {Total} -> {Total + heatCardDef.heat}: haul Scrap +{(float)Mathf.Min(Total + heatCardDef.heat, Data.maxRewardHeat) * Data.scrapPerHeat:0}%, luck +{(float)Mathf.Min(Total + heatCardDef.heat, Data.maxRewardHeat) * Data.luckPerHeat:0}</color>";
		}

		public static bool Voted(int actor)
		{
			return Votes.ContainsKey(actor);
		}

		public static int[] Ballots()
		{
			return RunShape.Ballots(Votes);
		}

		public static void HostOpen(TeamRunSave t, int milestone)
		{
			Votes.Clear();
			t.heatOffer.Clear();
			t.heatFor = 0;
			if (!On)
			{
				return;
			}
			List<HeatCardDef> list = new List<HeatCardDef>();
			HeatCardDef[] cards = Data.cards;
			foreach (HeatCardDef heatCardDef in cards)
			{
				if (heatCardDef != null && heatCardDef.id != "" && !t.heatCards.Contains(heatCardDef.id))
				{
					list.Add(heatCardDef);
				}
			}
			if (list.Count == 0)
			{
				return;
			}
			Random random = RunInfo.RngFor(milestone * 6151 + 29);
			t.heatOffer.Add("skip");
			for (int j = 0; j < Mathf.Clamp(Data.offered, 1, 4); j++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = random.Next(list.Count);
				t.heatOffer.Add(list[index].id);
				list.RemoveAt(index);
			}
			t.heatFor = milestone;
			Plugin.Log.LogInfo((object)string.Format("[heat] milestone {0}: heat vote open (heat {1}) - {2}.", milestone, t.heat, string.Join(", ", t.heatOffer.ConvertAll<string>(Name))));
		}

		public static void HostVote(TeamRunSave t, int actor, int milestone, int option)
		{
			if (t.heatFor != 0 && t.heatFor == milestone && option >= 0 && option < t.heatOffer.Count && !Game.InLevel())
			{
				Votes[actor] = option;
				if (Votes.Count >= Game.Players().Count)
				{
					HostDecide(t, "everyone voted");
				}
			}
		}

		private static int CrownWeight(int actor)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && Game.ActorNumber(item) == actor)
				{
					return (!(ClassStats.Get(item, "gear.crown") > 0f)) ? 1 : 2;
				}
			}
			return 1;
		}

		public static string HostDecide(TeamRunSave t, string why)
		{
			if (t.heatFor == 0 || t.heatOffer.Count == 0)
			{
				return "";
			}
			int[] array = new int[t.heatOffer.Count];
			foreach (KeyValuePair<int, int> vote in Votes)
			{
				if (vote.Value >= 0 && vote.Value < array.Length)
				{
					array[vote.Value] += CrownWeight(vote.Key);
				}
			}
			int num = 0;
			for (int i = 1; i < array.Length; i++)
			{
				if (array[i] > array[num])
				{
					num = i;
				}
			}
			if (Ascension.A(9) && num == 0 && array.Length > 1 && array[0] * 2 <= Votes.Count)
			{
				num = 1;
				for (int j = 2; j < array.Length; j++)
				{
					if (array[j] > array[num])
					{
						num = j;
					}
				}
			}
			string text = t.heatOffer[num];
			int count = Votes.Count;
			t.heatOffer.Clear();
			t.heatFor = 0;
			Votes.Clear();
			HeatCardDef heatCardDef = Card(text);
			if (text == "skip" || heatCardDef == null)
			{
				Plugin.Log.LogInfo((object)$"[heat] skipped ({array[num]} of {count} vote(s), {why}): heat stays {t.heat}.");
				return $"heat|Heat stays at {t.heat}: the team skipped";
			}
			t.heatCards.Add(heatCardDef.id);
			t.heat += Mathf.Max(0, heatCardDef.heat);
			Plugin.Log.LogInfo((object)$"[heat] {heatCardDef.name} +{heatCardDef.heat} ({array[num]} of {count} vote(s), {why}): heat {t.heat}.");
			return $"heat|Heat {t.heat}: {heatCardDef.name} ({heatCardDef.desc})";
		}

		public static void Reset()
		{
			Votes.Clear();
		}
	}
	internal static class HostSettings
	{
