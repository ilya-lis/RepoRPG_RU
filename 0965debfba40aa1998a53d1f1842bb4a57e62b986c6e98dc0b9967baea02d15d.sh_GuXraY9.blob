	internal sealed class TrackedField
	{
		public enum Mode
		{
			Additive,
			Rebase
		}

		private readonly Type _type;

		private readonly string _name;

		private readonly Mode _mode;

		private readonly Func<object, bool>? _ready;

		private readonly Func<object, bool>? _paused;

		private readonly Func<object, double>? _original;

		private object? _target;

		private double _base;

		private double _lastWritten = double.NaN;

		public double Base => _base;

		public TrackedField(Type type, string name, Mode mode = Mode.Additive, Func<object, bool>? ready = null, Func<object, bool>? paused = null, Func<object, double>? original = null)
		{
			_type = type;
			_name = name;
			_mode = mode;
			_ready = ready;
			_paused = paused;
			_original = original;
		}

		public static void OpenRebaseWindow(float seconds = 6f)
		{
		}

		public void Reset()
		{
			_target = null;
			_lastWritten = double.NaN;
		}

		public void Apply(object? target, double mult, double add = 0.0)
		{
			if (target == null)
			{
				return;
			}
			FieldInfo fieldInfo = Game.Field(_type, _name);
			if (fieldInfo == null)
			{
				return;
			}
			try
			{
				if ((_ready != null && !_ready(target)) || (_paused != null && _paused(target)))
				{
					return;
				}
				bool flag = fieldInfo.FieldType == typeof(int);
				double num = (flag ? ((float)Game.Get(target, _name, 0)) : Game.Get(target, _name, 0f));
				if (target != _target || double.IsNaN(_lastWritten))
				{
					_target = target;
					_base = num;
				}
				else if (Math.Abs(num - _lastWritten) > 0.0001)
				{
					double num2 = ((_original != null) ? _original(target) : double.NaN);
					if (_mode == Mode.Rebase)
					{
						_base = num;
					}
					else if (!double.IsNaN(num2) && num2 > 0.0 && Math.Abs(num - num2) < 0.0001)
					{
						_base = num;
					}
					else if (Math.Abs(num - _base) < 0.0001)
					{
						_base = num;
					}
					else
					{
						_base += num - _lastWritten;
					}
					if (_base <= 0.0)
					{
						_base = num;
					}
				}
				if (double.IsNaN(_base) || double.IsInfinity(_base) || (_base <= 0.0 && num > 0.0 && add == 0.0))
				{
					_base = num;
				}
				double num3 = _base * mult + add;
				if (double.IsNaN(num3) || double.IsInfinity(num3) || (num3 <= 0.0 && num > 0.0 && _base > 0.0 && mult > 0.0))
				{
					_lastWritten = double.NaN;
				}
				else if (flag)
				{
					int num4 = (int)Math.Round(num3);
					if (num4 != (int)num)
					{
						Game.Set(target, _name, num4);
					}
					_lastWritten = num4;
				}
				else
				{
					float num5 = (float)num3;
					if (Math.Abs((double)num5 - num) > 1E-05)
					{
						Game.Set(target, _name, num5);
					}
					_lastWritten = num5;
				}
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Apply " + _type.Name + "." + _name + " failed: " + ex.Message);
			}
		}

		public void Restore()
		{
			if (_target == null || double.IsNaN(_lastWritten))
			{
				Reset();
				return;
			}
			Apply(_target, 1.0);
			Reset();
		}
	}
