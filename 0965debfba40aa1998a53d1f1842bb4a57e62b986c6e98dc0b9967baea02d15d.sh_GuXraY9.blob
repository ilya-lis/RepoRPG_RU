			if (Research.Has("recall_beacon") && Game.InLevel())
			{
				if (Btn(new Rect(((Rect)(ref area)).x, y, Mathf.Min(((Rect)(ref area)).width, 420f * _fontMul), BtnH), "Recall Beacon: call an empty cart"))
				{
					PlayerAvatar val = Game.LocalPlayer();
					if ((Object)(object)val != (Object)null)
					{
						Net.SendClassAction(ClassHost.Act.RecallCart, ((Component)val).transform.position, Array.Empty<float>(), 0, usesCharge: false);
					}
				}
				y += BtnH + 4f;
			}
			y = DrawResearchToolsX(area, y);
			y = DrawResearchTabC(area, y);
			y += 4f;
			DrawResearchTree(new Rect(((Rect)(ref area)).x, y, ((Rect)(ref area)).width, ((Rect)(ref area)).yMax - y));
			ShowDetail(ResearchDetail());
			ResearchDef sel = Research.Def(_resSel);
			if (sel != null)
			{
				switch (Research.StateOf(sel))
				{
				case Research.St.Active:
					BarAct("Cancel (half back)", BtnKind.Danger, enabled: true, delegate
					{
						AskCancelResearch(sel);
					});
					break;
				default:
				{
					string why;
					bool enabled = Research.CanStart(sel, out why);
					BarAct("Start research", BtnKind.Primary, enabled, delegate
					{
						AskStartResearch(sel);
					}, right: false, why);
					break;
				}
				case Research.St.Done:
				case Research.St.InDev:
					break;
				}
			}
			BarNote(string.Format("{0} lab slot{1}", Research.Slots, (Research.Slots == 1) ? "" : "s") + ((Research.Slots == 1) ? " · Parallel Lab adds a second" : ""));
		}

		private List<ResearchDef> ResColumn(string branch)
		{
			if (_resCols.TryGetValue(branch, out List<ResearchDef> value))
			{
				return value;
			}
			value = new List<ResearchDef>();
			ResearchDef[] projects = Research.File.projects;
			foreach (ResearchDef researchDef in projects)
			{
				if (researchDef.branch == branch)
				{
					value.Add(researchDef);
				}
			}
			value.Sort((ResearchDef a, ResearchDef c) => (a.tier == c.tier) ? Array.IndexOf(Research.File.projects, a).CompareTo(Array.IndexOf(Research.File.projects, c)) : a.tier.CompareTo(c.tier));
			_resCols[branch] = value;
			return value;
		}

		private ResLayout LayoutResearch(Rect r, int rows)
		{
			string text = $"{((Rect)(ref r)).width:0}|{((Rect)(ref r)).height:0}|{rows}|{_fontMul:0.00}|{_builtStyle}";
			if (_resL.Key == text)
			{
				return _resL;
			}
			float num = LineH(_smallLine);
			float num2 = LineH(_bodyB) + 4f + 2f;
			float num3 = ((Rect)(ref r)).height - num2;
			ResLayout resLayout = new ResLayout
			{
				Key = text
			};
			(float, float)[] array = new(float, float)[6]
			{
				(9f, 10f),
				(7f, 8f),
				(6f, 6f),
				(5f, 4f),
				(4f, 3f),
				(3f, 2f)
			};
			for (int i = 0; i < array.Length; i++)
			{
				(float, float) tuple = array[i];
				float item = tuple.Item1;
				float item2 = tuple.Item2;
				float num4 = num + 2f * item;
				if ((float)rows * num4 + (float)(rows - 1) * item2 <= num3)
				{
					float gap = ((rows > 1) ? Mathf.Min(item2 + (num3 - (float)rows * num4 - (float)(rows - 1) * item2) / (float)(rows - 1), 22f) : item2);
					resLayout.RowH = num4;
					resLayout.Gap = gap;
					resLayout.Pad = item;
					resLayout.Scroll = false;
					resLayout.ContentH = ((Rect)(ref r)).height;
					_resL = resLayout;
					return resLayout;
				}
			}
			resLayout.Pad = 4f;
			resLayout.RowH = num + 8f;
			resLayout.Gap = 4f;
			resLayout.Scroll = true;
			resLayout.ContentH = num2 + (float)rows * resLayout.RowH + (float)(rows - 1) * resLayout.Gap + 8f;
			_resL = resLayout;
			return resLayout;
		}

