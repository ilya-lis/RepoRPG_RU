			bool flag = Game.ClassPickOpen();
			if (_classWindowOpen && !flag && _dialogOpen && _dialogKind == DialogKind.PlayAs)
			{
				CloseDialog(DialogChoice.Cancel);
				_classPickDropped = true;
			}
			if (!_classWindowOpen && flag && Current == null && RunReady && (!Game.InShopLevel() || Plugin.Cfg.ShopClassReminder.Value))
			{
				Notify(PopupKind.Other, Pad.Connected ? ("Choose your class - " + MenuPrompt) : ("Choose your class - press " + MenuPrompt), Accent, "chooseclass");
			}
			_classWindowOpen = flag;
			if (Game.LevelReady())
			{
				if (_classPickDropped)
				{
					_classPickDropped = false;
					Toast("Your class pick wasn't confirmed before the shop closed - pick again in the next shop.", Color.white, 5f);
				}
				if (Current == null && RunReady && !_classlessToldThisLevel && !Game.ClassPickOpen())
				{
					_classlessToldThisLevel = true;
					Toast("You can pick a class in the next shop.", new Color(0.8f, 0.8f, 0.8f), 4f);
				}
			}
		}

		private int PendingAccepts()
		{
			int num = 0;
			foreach (CtRequest value in _ctRequests.Values)
			{
				if (value.What == 1)
				{
					num++;
				}
			}
			return num;
		}

		private void TickContracts(PlayerAvatar local)
		{
			//IL_0192: Unknown result type (might be due to invalid IL or missing references)
			//IL_0197: Unknown result type (might be due to invalid IL or missing references)
			//IL_01c8: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ca: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ae: Unknown result type (might be due to invalid IL or missing references)
			//IL_01b1: Unknown result type (might be due to invalid IL or missing references)
			//IL_0269: Unknown result type (might be due to invalid IL or missing references)
			//IL_0274: Unknown result type (might be due to invalid IL or missing references)
			//IL_0279: Unknown result type (might be due to invalid IL or missing references)
			//IL_027e: Unknown result type (might be due to invalid IL or missing references)
			if (Time.unscaledTime < _ctNextTick)
			{
				return;
			}
			_ctNextTick = Time.unscaledTime + 1f;
			RunSave ctRun = CtRun;
			if (Game.IsMaster())
			{
				TeamContracts.HostBoardTick();
			}
			if (ContractBoardOpen)
			{
				if (Game.IsMaster())
				{
					ContractHost.HostNoteBoard();
				}
				if (ctRun.boardLevel != RunInfo.LevelIndex)
				{
					NewBoard(reroll: false);
				}
				else if (ctRun.boardClass != CurrentId)
				{
					RefreshClassOffer();
				}
			}
			if (!Game.InLevel() || ctRun.contractLevel != RunInfo.LevelIndex)
			{
				_ctHavePos = false;
				return;
			}
			float levelElapsed = LevelElapsed;
			for (int i = 0; i < ctRun.contracts.Count; i++)
			{
				ContractState contractState = ctRun.contracts[i];
				if (!(contractState.type != "Board"))
				{
					if (contractState.status == 1 && !contractState.claimed && contractState.kind != 2)
					{
						RetryClaim(contractState);
					}
					if (contractState.status == 0 && (contractState.obj == "speed" || contractState.obj == "speedall") && levelElapsed > (float)contractState.target * 60f)
					{
						FailContract(contractState, "out of time");
					}
				}
			}
			if (!Game.IsAlive(local))
			{
				_ctHavePos = false;
				return;
			}
			if (CurrentId == "scout" && HasActive("cls.scout"))
			{
				PlayerController instance = PlayerController.instance;
				bool num = (Object)(object)instance != (Object)null && Game.Get(instance, "sprinting", fallback: false);
				Vector3 position = ((Component)local).transform.position;
				if (num && _ctHavePos)
				{
					CEv("cls.scout", Mathf.Min(15f, Vector3.Distance(position, _ctLastPos)));
				}
				_ctLastPos = position;
				_ctHavePos = true;
			}
			if (!(CurrentId == "engineer") || !HasActive("cls.engineer") || !(_stats[Stat.LinkStamina] > 0f))
			{
				return;
			}
			float num2 = Mathf.Max(1f, _stats[Stat.LinkRadius]);
			int num3 = 0;
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null && (Object)(object)item != (Object)(object)local && Game.IsAlive(item))
				{
					Vector3 val = ((Component)item).transform.position - ((Component)local).transform.position;
					if (((Vector3)(ref val)).sqrMagnitude <= num2 * num2)
					{
						num3++;
					}
				}
			}
			if (num3 > 0)
			{
				CEv("cls.engineer", num3);
			}
		}

		private void RetryClaim(ContractState c)
		{
			if (_ctRefused.Contains(c.uid))
			{
				return;
			}
			foreach (CtRequest value2 in _ctRequests.Values)
			{
				if (value2.Uid == c.uid)
				{
					return;
				}
			}
			if (!_ctClaimRetry.TryGetValue(c.uid, out var value) || !(Time.unscaledTime < value))
			{
				_ctClaimRetry[c.uid] = Time.unscaledTime + 10f;
				SendClaim(c);
			}
		}

		private void SendClaim(ContractState c)
		{
			string uid = c.uid;
			bool bonus = c.bonusState == 1;
			int tier = c.tier;
			int kind = c.kind;
			int req = 0;
			req = CtSend(4, uid, delegate
			{
				Net.SendContractClaim(req, uid, bonus, tier, kind);
			});
			Net.SendContractClaim(req, uid, bonus, tier, kind);
		}

		private bool HasActive(string obj)
		{
			foreach (ContractState contract in CtRun.contracts)
			{
				if (contract.type == "Board" && contract.status == 0 && contract.obj == obj)
				{
					return true;
				}
			}
			return false;
		}

		private void NewBoard(bool reroll)
		{
			//IL_00eb: Unknown result type (might be due to invalid IL or missing references)
			RunSave ctRun = CtRun;
			if (!reroll)
			{
				ctRun.boardRerolls = 0;
			}
			ctRun.boardLevel = RunInfo.LevelIndex;
			ctRun.boardClass = CurrentId;
			HashSet<string> keep = new HashSet<string>();
			foreach (ContractState item in ctRun.accepted)
			{
				keep.Add(item.id);
			}
			List<ContractState> list = ContractBoard.Generate(new Random(), ctRun, CurrentId, RunInfo.LevelIndex, Mathf.Max(1, Game.Players().Count));
			list.RemoveAll((ContractState c) => keep.Contains(c.id));
			ctRun.board = list;
			_store.MarkDirty();
			if (!reroll && list.Count > 0)
			{
				Notify(PopupKind.Contract, "New contracts on the board (" + MenuPrompt + ")", CtGold, "board");
			}
		}

		private void RefreshClassOffer()
		{
			RunSave ctRun = CtRun;
			ctRun.boardClass = CurrentId;
			ctRun.board.RemoveAll((ContractState c) => c.kind == 1);
			if (CurrentId != "")
			{
				foreach (ContractDef d in ContractBoard.All)
				{
					if (d.kind == "class" && d.cls == CurrentId && (Game.Players().Count >= 2 || !d.mp))
					{
						if (!ctRun.accepted.Exists((ContractState a) => a.id == d.id))
						{
							ctRun.board.Insert(0, ContractBoard.Roll(new Random(), d, ctRun, RunInfo.LevelIndex));
						}
						break;
					}
				}
			}
			_store.MarkDirty();
		}

		private int CtSend(byte what, string uid, Action resend)
		{
			int num = ++_ctNextReq;
			_ctRequests[num] = new CtRequest
			{
				What = what,
				Uid = uid,
				SentAt = Time.unscaledTime,
				Resend = resend
			};
			return num;
		}

		private void TickContractRequests()
		{
			//IL_00f0: Unknown result type (might be due to invalid IL or missing references)
			if (_ctRequests.Count == 0)
			{
				return;
			}
			List<int> list = null;
			float unscaledTime = Time.unscaledTime;
			foreach (KeyValuePair<int, CtRequest> ctRequest2 in _ctRequests)
			{
				CtRequest value = ctRequest2.Value;
				if (!(unscaledTime - value.SentAt < 5f))
				{
					if (value.Tries < 1)
					{
						value.Tries++;
						value.SentAt = unscaledTime;
						value.Resend();
					}
					else
					{
						(list ?? (list = new List<int>())).Add(ctRequest2.Key);
					}
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (int item in list)
			{
				CtRequest ctRequest = _ctRequests[item];
				_ctRequests.Remove(item);
				Toast((ctRequest.What == 4) ? "Couldn't reach the host - contract not paid" : "Couldn't reach the host - try again", Color.gray);
			}
		}

		public bool CanAccept(ContractState c, out string why)
		{
			why = "";
			if (!ContractBoardOpen)
			{
				why = "The board is open in the lobby and shop";
				return false;
			}
			if (CtRun.accepted.Exists((ContractState a) => a.uid == c.uid))
			{
				why = "Accepted";
				return false;
			}
			if (CtUsedSlots >= ContractBoard.Slots)
			{
				why = $"All {ContractBoard.Slots} slots used";
				return false;
			}
			if (c.kind == 1 && c.cls != CurrentId)
			{
				why = "For another class";
				return false;
			}
			if (c.kind == 2 && Game.Players().Count < 2)
			{
				why = "Needs 2+ players";
				return false;
			}
			foreach (CtRequest value in _ctRequests.Values)
			{
				if (value.Uid == c.uid)
				{
					why = "Waiting for the host";
					return false;
				}
			}
			return true;
		}

		public void AcceptOffer(ContractState c)
		{
			//IL_0013: Unknown result type (might be due to invalid IL or missing references)
			if (!CanAccept(c, out string why))
			{
				Toast(why, Color.gray);
				MenuSound(UiSound.Error);
				return;
			}
			string uid = c.uid;
			string id = c.id;
			int tier = c.tier;
			int level = RunInfo.LevelIndex;
			int slots = ContractBoard.Slots;
			int req = 0;
			req = CtSend(1, uid, delegate
			{
				Net.SendContractAccept(req, uid, id, tier, level, slots);
			});
			Net.SendContractAccept(req, uid, id, tier, level, slots);
		}

		public void DropAccepted(ContractState c)
		{
			if (!ContractBoardOpen)
			{
				return;
			}
			RunSave ctRun = CtRun;
			if (ctRun.accepted.Remove(c))
			{
				Net.SendContractDrop(c.uid);
				if (ctRun.board.Count < ContractBoard.BoardSize + 2)
				{
					ctRun.board.Add(c);
				}
				_store.MarkDirty();
				MenuSound(UiSound.Back);
			}
		}

		public void RerollBoard()
		{
			//IL_0042: Unknown result type (might be due to invalid IL or missing references)
			if (!ContractBoardOpen)
			{
				return;
			}
			foreach (CtRequest value in _ctRequests.Values)
			{
				if (value.What == 3 || value.What == 1)
				{
					Toast("Waiting for the host - try again in a moment", Color.gray);
					return;
				}
			}
			int req = 0;
			req = CtSend(3, "", delegate
			{
				Net.SendContractReroll(req);
			});
			Net.SendContractReroll(req);
		}

		public void OnContractReply(int req, byte what, bool ok, int value, string reason)
		{
			//IL_02d0: Unknown result type (might be due to invalid IL or missing references)
			//IL_0103: Unknown result type (might be due to invalid IL or missing references)
			//IL_0282: Unknown result type (might be due to invalid IL or missing references)
			//IL_0379: Unknown result type (might be due to invalid IL or missing references)
			//IL_0228: Unknown result type (might be due to invalid IL or missing references)
			if (!_ctRequests.TryGetValue(req, out CtRequest r))
			{
				return;
			}
			_ctRequests.Remove(req);
			RunSave ctRun = CtRun;
			switch (what)
			{
			case 1:
			{
				ContractState contractState2 = ctRun.board.Find((ContractState x) => x.uid == r.Uid);
				if (!ok)
				{
					Toast("Contract not accepted: " + reason switch
					{
						"closed" => "the board is closed", 
						"full" => "no free slot", 
						"stale" => "the board changed", 
						"rivals off" => "rivals are off in this lobby", 
						"solo" => "needs 2+ players", 
						"dup" => "already taken", 
						_ => reason, 
					}, Color.gray);
					MenuSound(UiSound.Error);
					break;
				}
				if (contractState2 == null)
				{
					Net.SendContractDrop(r.Uid);
					break;
				}
				ctRun.board.Remove(contractState2);
				contractState2.status = 0;
				contractState2.progress = 0;
				contractState2.level = RunInfo.LevelIndex;
				ctRun.accepted.Add(contractState2);
				if (contractState2.kind == 3 && ctRun.chain == "")
				{
					ctRun.chain = contractState2.chain;
					ctRun.chainStep = 0;
					ctRun.chainRetried = false;
					ctRun.chainStory.Clear();
				}
				_ctFlash[contractState2.uid] = Time.unscaledTime;
				ContractGiverDef contractGiverDef = ContractBoard.Giver(contractState2.giver);
				Notify(PopupKind.Contract, "Accepted: " + ContractBoard.Name(contractState2) + ((contractGiverDef != null) ? (" - " + contractGiverDef.name + ": \"" + ContractBoard.Line(contractGiverDef.accept, RunInfo.StableHash(contractState2.uid)) + "\"") : ""), ContractBoard.GiverColor(contractState2.giver));
				MenuSound(UiSound.Confirm);
				_store.MarkDirty();
				break;
			}
			case 3:
				if (!ok)
				{
					Toast((reason == "not enough") ? ("Not enough " + Scrap.Short + " to reroll") : ("Couldn't reroll: " + reason), Color.gray);
					MenuSound(UiSound.Error);
					break;
				}
				ctRun.boardRerolls++;
				NewBoard(reroll: true);
				MenuSound(UiSound.Confirm);
				if (value > 0)
				{
					Notify(PopupKind.Currency, "Board rerolled (-" + Scrap.Price(value) + ")", CtGold);
				}
				break;
			case 4:
			{
				ContractState contractState = ctRun.contracts.Find((ContractState x) => x.uid == r.Uid);
				if (contractState == null || contractState.claimed)
				{
					break;
				}
				if (!ok)
				{
					if (reason == "paid")
					{
						contractState.claimed = true;
						Paid(contractState, 0);
						break;
					}
					_ctRefused.Add(contractState.uid);
					Notify(PopupKind.Contract, "The host didn't pay " + ContractBoard.Name(contractState) + " (" + reason + ")", Color.gray);
					AddHistory(contractState, "Not paid", reason);
				}
				else
				{
					contractState.claimed = true;
					Paid(contractState, value);
				}
				break;
			}
			case 2:
				break;
			}
		}

		private void ContractsLevelStart(RunSave run)
		{
			//IL_0215: Unknown result type (might be due to invalid IL or missing references)
			//IL_0264: Unknown result type (might be due to invalid IL or missing references)
			foreach (ContractState contract in run.contracts)
			{
				if (contract.type == "Board" && contract.status == 0)
				{
					if (contract.kind == 2)
					{
						contract.status = 2;
						AddHistory(contract, "Void", "no result");
					}
					else
					{
						FailContract(contract, "the level ended");
					}
				}
			}
			List<ContractState> list = new List<ContractState>();
			int num = 0;
			foreach (ContractState item in run.accepted)
			{
				if (item.level != RunInfo.LevelIndex)
				{
					num++;
					continue;
				}
				if (item.kind == 1 && item.cls != CurrentId)
				{
					num++;
					continue;
				}
				item.status = 0;
				item.progress = 0;
				item.bonusState = 0;
				item.claimed = false;
				item.doneAt = -1f;
				list.Add(item);
			}
			run.accepted.Clear();
			int num2 = ExtractionPointCount();
			foreach (ContractState item2 in list)
			{
				if (item2.obj == "extract" && num2 > 0 && item2.target > num2)
				{
					item2.target = num2;
				}
			}
			run.contracts = list;
			_ctKillTimes.Clear();
			_ctCopied.Clear();
			_ctHavePos = false;
			_ctScanned.Clear();
			_ctClaimRetry.Clear();
			_ctPaid.Clear();
			_ctEvQueue.Clear();
			_ctRefused.Clear();
			_ctJugAcc = 0f;
			if (num > 0)
			{
				Notify(PopupKind.Contract, string.Format("{0} accepted contract{1} expired (for another level or class)", num, (num == 1) ? "" : "s"), Color.gray);
			}
			if (list.Count > 0)
			{
				Notify(PopupKind.Contract, string.Format("{0} contract{1} active ({2})", list.Count, (list.Count == 1) ? "" : "s", MenuPrompt), CtGold);
			}
		}

		private static int ExtractionPointCount()
		{
			try
			{
				RoundDirector instance = RoundDirector.instance;
				if ((Object)(object)instance == (Object)null)
				{
					return 0;
				}
				object obj = Game.Get<object>(instance, "extractionPoints", null);
				return (obj != null) ? Convert.ToInt32(obj) : 0;
			}
			catch
			{
				return 0;
			}
		}

		private void ContractsLevelEnd()
		{
			RunSave ctRun = CtRun;
			if (ctRun.contractLevel != RunInfo.LevelIndex)
			{
				return;
			}
			float levelElapsed = LevelElapsed;
			ContractState[] array = ctRun.contracts.ToArray();
			foreach (ContractState contractState in array)
			{
				if (contractState.type != "Board" || contractState.status != 0)
				{
					continue;
				}
				switch (contractState.obj)
				{
				case "speed":
				case "speedall":
					if (levelElapsed <= (float)contractState.target * 60f)
					{
						CompleteContract(contractState);
					}
					else
					{
						FailContract(contractState, "out of time");
					}
					continue;
				case "unscathed":
					if (contractState.progress < contractState.target)
					{
						CompleteContract(contractState);
					}
					else
					{
						FailContract(contractState, "too much damage");
					}
					continue;
				case "nodeath":
					CompleteContract(contractState);
					continue;
				case "cls.survivor":
					if (contractState.progress >= contractState.target)
					{
						CompleteContract(contractState);
					}
					else
					{
						FailContract(contractState, "not enough death saves");
					}
					continue;
				}
				if (contractState.kind != 2)
				{
					if (contractState.bonus == "double" && contractState.progress >= contractState.target)
					{
						CompleteContract(contractState);
					}
					else
					{
						FailContract(contractState, "not finished");
					}
				}
			}
		}

		public void OnContractEvent(string key, float amount, int a, int b)
		{
			if (!Guard.On("contracts"))
			{
				return;
			}
			try
			{
				if (key == "leveldone")
				{
					ContractsLevelEnd();
					return;
				}
				if (key == "cls.juggernaut")
				{
					_ctJugAcc += amount;
					int num = Mathf.FloorToInt(_ctJugAcc);
					if (num < 1)
					{
						return;
					}
					_ctJugAcc -= num;
					amount = num;
				}
				CEv(key, amount, a, b);
			}
			catch (Exception e)
			{
				Guard.Fail("contracts", e);
			}
		}

		private static bool EndType(string obj)
		{
			switch (obj)
			{
			default:
				return obj.StartsWith("rival.", StringComparison.Ordinal);
			case "speed":
			case "speedall":
			case "unscathed":
			case "nodeath":
			case "cls.survivor":
				return true;
			}
		}

		private void CEv(string key, float amount = 1f, int a = 0, int b = 0)
		{
			if (_ctInEv)
			{
				if (_ctEvQueue.Count < 64)
				{
					_ctEvQueue.Enqueue((key, amount, a, b));
				}
				else
				{
					Game.WarnOnce("[contracts] too many contract events at once: the extra ones were dropped.");
				}
				return;
			}
			_ctInEv = true;
			try
			{
				CEvOne(key, amount, a, b);
				int num = 0;
				while (_ctEvQueue.Count > 0 && num++ < 64)
				{
					(string, float, int, int) tuple = _ctEvQueue.Dequeue();
					CEvOne(tuple.Item1, tuple.Item2, tuple.Item3, tuple.Item4);
				}
				_ctEvQueue.Clear();
			}
			catch (Exception e)
			{
				Guard.Fail("contracts", e);
				_ctEvQueue.Clear();
			}
			finally
			{
				_ctInEv = false;
			}
		}

		private void CEvOne(string key, float amount, int a, int b)
		{
			RunSave ctRun = CtRun;
			if (!Game.InLevel() || ctRun.contractLevel != RunInfo.LevelIndex || ctRun.contracts.Count == 0)
			{
				return;
			}
			if (key == "kill")
			{
				float now = Time.time;
				_ctKillTimes.Add(now);
				_ctKillTimes.RemoveAll((float t) => now - t > 30f);
			}
			if (key == "cls.mimic")
			{
				if (a == 0 || !_ctCopied.Add(a.ToString()))
				{
					return;
				}
				amount = 1f;
			}
			bool flag = false;
			ContractState[] array = ctRun.contracts.ToArray();
			foreach (ContractState contractState in array)
			{
				if (contractState.type != "Board" || contractState.status != 0)
				{
					continue;
				}
				int progress = contractState.progress;
				int bonusState = contractState.bonusState;
				switch (key)
				{
				case "kill":
					if (contractState.obj == "kill")
					{
						Step(contractState, 1);
					}
					else if (contractState.obj == "killburst")
					{
						contractState.progress = Mathf.Max(contractState.progress, Mathf.Min(contractState.target, _ctKillTimes.Count));
					}
					break;
				case "elite":
					if (contractState.obj == "elite" || contractState.obj == "trophy")
					{
						Step(contractState, 1);
					}
					break;
				case "boss":
					if (contractState.obj == "trophy")
					{
						Step(contractState, 2);
					}
					break;
				case "valuable":
				{
					int n = Mathf.RoundToInt(amount);
					bool flag2 = a == 1;
					if (contractState.obj == "value" || contractState.obj == "strictvalue")
					{
						Step(contractState, n);
					}
					else if (contractState.obj == "carry")
					{
						Step(contractState, 1);
					}
					else if (contractState.obj == "cleancarry" && flag2)
					{
						Step(contractState, 1);
					}
					else if (contractState.obj == "rarecarry" && b >= 2)
					{
						Step(contractState, 1);
					}
					else if (contractState.obj == "bigclean" && flag2 && amount >= 10000f)
					{
						Step(contractState, 1);
					}
					else if (contractState.obj == "cls.hauler" && amount >= 3000f)
					{
						Step(contractState, 1);
					}
					break;
				}
				case "broke":
					if (contractState.bonus == "nobreak")
					{
						contractState.bonusState = 2;
					}
					if (contractState.obj == "strictvalue")
					{
						FailContract(contractState, "a valuable broke");
						flag = true;
						continue;
					}
					break;
				case "damage":
					if (contractState.bonus == "nodamage")
					{
						contractState.bonusState = 2;
					}
					if (contractState.obj == "unscathed")
					{
						contractState.progress += Mathf.Max(1, Mathf.RoundToInt(amount));
						if (contractState.progress >= contractState.target)
						{
							FailContract(contractState, "too much damage");
							flag = true;
							continue;
						}
					}
					break;
				case "deathsave":
					if (contractState.bonus == "nosave")
					{
						contractState.bonusState = 2;
					}
					if (contractState.obj == "cls.survivor")
					{
						contractState.progress = Mathf.Min(contractState.target, contractState.progress + 1);
					}
					break;
				case "death":
					if (contractState.bonus == "nodeath")
					{
						contractState.bonusState = 2;
					}
					if (contractState.obj == "nodeath" || contractState.obj == "speedall")
					{
						FailContract(contractState, "someone died");
						flag = true;
						continue;
					}
					break;
				case "revive":
					if (contractState.obj == "revive")
					{
						if (a == 1 && contractState.bonus == "fastrevive")
						{
							contractState.bonusState = 1;
						}
						Step(contractState, 1);
					}
					break;
				default:
					if (contractState.obj == key)
					{
						Step(contractState, Mathf.Max(1, Mathf.RoundToInt(amount)));
					}
					break;
				}
				if (contractState.progress != progress || contractState.bonusState != bonusState)
				{
					flag = true;
				}
				if (contractState.status == 0 && !EndType(contractState.obj) && contractState.progress >= Goal(contractState))
				{
					CompleteContract(contractState);
				}
			}
			if (flag)
			{
				_store.MarkDirty();
			}
		}

		private static int Goal(ContractState c)
		{
			if (!(c.bonus == "double"))
			{
				return c.target;
			}
			return c.target * 2;
		}

		private static void Step(ContractState c, int n)
		{
			c.progress = Mathf.Min(Goal(c), c.progress + Mathf.Max(0, n));
		}

		private bool BonusMet(ContractState c)
		{
			string bonus = c.bonus;
			if (bonus == null || bonus.Length != 0)
			{
				switch (bonus)
				{
				case "within":
					if (c.doneAt >= 0f)
					{
						return c.doneAt <= (float)c.bonusArg * 60f;
					}
					return false;
				case "fastrevive":
					return c.bonusState == 1;
				case "double":
					return c.progress >= c.target * 2;
				default:
					return c.bonusState != 2;
				}
			}
			return false;
		}

		private void CtTrace(string what)
		{
			if (Plugin.Cfg.ContractDebug.Value)
			{
				Plugin.Log.LogInfo((object)$"[contracts] t={Time.realtimeSinceStartup * 1000f:0} ms (frame {Time.frameCount}): {what}");
			}
		}

		private void CompleteContract(ContractState c)
		{
			if (c.status != 0)
			{
				return;
			}
			try
			{
				CompleteContractCore(c);
			}
			catch (Exception e)
			{
				Guard.Fail("contracts", e);
			}
		}

		private void CompleteContractCore(ContractState c)
		{
			//IL_00eb: Unknown result type (might be due to invalid IL or missing references)
			CtTrace("complete " + c.id + " (" + c.uid + "): start");
			c.status = 1;
			c.doneAt = LevelElapsed;
			if (c.bonus != "")
			{
				c.bonusState = (BonusMet(c) ? 1 : 2);
			}
			_ctFlash[c.uid] = Time.unscaledTime;
			ContractGiverDef contractGiverDef = ContractBoard.Giver(c.giver);
			Notify(PopupKind.Contract, "Contract complete: " + ContractBoard.Name(c) + ((c.bonusState == 1) ? " + bonus!" : "") + ((contractGiverDef != null) ? (" - \"" + ContractBoard.Line(contractGiverDef.done, RunInfo.StableHash(c.uid)) + "\"") : ""), CtGood);
			MenuSound(UiSound.Confirm);
			if (Game.InLevel())
			{
				TeamPlay.Add(TeamPlay.Ev.Contracts, 1f);
			}
			_store.MarkDirty();
			_ctClaimRetry[c.uid] = Time.unscaledTime + 10f;
			CtTrace("complete " + c.id + ": marked done, pop-up shown, claim sent");
			SendClaim(c);
		}

		private void Paid(ContractState c, int scrap)
		{
			if (!_ctPaid.Add(c.uid))
			{
				CtTrace("paid " + c.id + ": already paid, ignored");
				return;
			}
			try
			{
				PaidCore(c, scrap);
			}
			catch (Exception e)
			{
				Guard.Fail("contracts", e);
			}
		}

		private void PaidCore(ContractState c, int scrap)
		{
			//IL_017d: Unknown result type (might be due to invalid IL or missing references)
			RunSave ctRun = CtRun;
			CtTrace($"paid {c.id}: {scrap} Scrap, {c.rewardXp} XP");
			GiveXp(c.rewardXp, null, "contract");
			Account.Count("contracts");
			CtTrace("paid " + c.id + ": XP given");
			ChangeRep(c.giver, ContractBoard.TierRep[(c.kind == 3 || c.kind == 2) ? 1 : Mathf.Clamp(c.tier, 0, 2)], ContractBoard.Name(c));
			CtTrace("paid " + c.id + ": reputation done");
			string text = ((scrap > 0) ? (Scrap.Price(scrap) + " + ") : "") + $"{c.rewardXp} XP";
			if (c.kind == 3)
			{
				AddHistory(c, "Complete", text, scrap);
				AdvanceChain(c);
				CtTrace("paid " + c.id + ": chain advanced");
			}
			else
			{
				if (!ctRun.rewardQueue.Contains(c))
				{
					ctRun.rewardQueue.Add(c);
				}
				AddHistory(c, "Complete", text + " + pick waiting", scrap);
				Notify(PopupKind.Contract, "Reward waiting: choose it on the Contracts tab (" + MenuPrompt + ")", CtGold, "ctreward");
			}
			if (Game.InLevel())
			{
				_store.MarkDirty();
			}
			else
			{
				_store.SaveNow();
			}
			CtTrace("paid " + c.id + ": done");
		}

		public void ChangeRep(string giver, int delta, string why)
		{
			//IL_0106: Unknown result type (might be due to invalid IL or missing references)
			//IL_00fe: Unknown result type (might be due to invalid IL or missing references)
			//IL_0155: Unknown result type (might be due to invalid IL or missing references)
			//IL_017d: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d6: Unknown result type (might be due to invalid IL or missing references)
			if (delta == 0 || !RunReady)
			{
				return;
			}
			RunSave ctRun = CtRun;
			int num = ContractBoard.Rep(ctRun, giver);
			if (!ContractBoard.AddRep(ctRun, giver, delta))
			{
				return;
			}
			int num2 = ContractBoard.Rep(ctRun, giver);
			string text = ContractBoard.Giver(giver)?.name ?? giver;
			Plugin.Log.LogInfo((object)$"[rep] {text}: {num} -> {num2} ({delta:+0;-0}, {why}).");
			_store.MarkDirty();
			if (num2 != num)
			{
				int num3 = ContractBoard.NextTierAt(num2);
				Notify(PopupKind.Contract, string.Format("{0}{1} reputation with {2} ({3}", (delta > 0) ? "+" : "", num2 - num, text, num2) + ((num3 > 0) ? $"/{num3})" : ", max)"), (delta > 0) ? ContractBoard.GiverColor(giver) : CtBad, "rep:" + giver);
				int num4 = ContractBoard.RepTier(num);
				int num5 = ContractBoard.RepTier(num2);
				if (num5 > num4)
				{
					Banner(text.ToUpperInvariant() + ": " + ContractBoard.RepTierNames[num5].ToUpperInvariant(), ContractBoard.GiverColor(giver), 4f);
					Notify(PopupKind.Contract, text + " now offers " + ContractBoard.TierUnlock(num5) + " (from the next board)", CtGold);
				}
				else if (num5 < num4)
				{
					Notify(PopupKind.Contract, text + ": back to " + ContractBoard.RepTierNames[num5] + " - " + ContractBoard.TierUnlock(num4) + " locked again", CtBad);
				}
			}
		}

		private void FailContract(ContractState c, string why)
		{
			//IL_008c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0110: Unknown result type (might be due to invalid IL or missing references)
			//IL_0170: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ca: Unknown result type (might be due to invalid IL or missing references)
			if (c.status != 0)
			{
				return;
			}
			RunSave ctRun = CtRun;
			c.status = 2;
			_ctFlash[c.uid] = Time.unscaledTime;
			ChangeRep(c.giver, -1, ContractBoard.Name(c));
			if (c.giver == "auditor" && c.rewardScrap > 0)
			{
				int num = Mathf.Max(1, Mathf.RoundToInt((float)c.rewardScrap * 0.15f));
				Net.SendContractFine(num);
				Notify(PopupKind.Contract, "The Auditor fines you " + Scrap.Price(num), CtBad, "auditor-fine");
			}
			ContractGiverDef contractGiverDef = ContractBoard.Giver(c.giver);
			Notify(PopupKind.Contract, "Contract failed: " + ContractBoard.Name(c) + " (" + why + ")" + ((contractGiverDef != null) ? (" - \"" + ContractBoard.Line(contractGiverDef.fail, RunInfo.StableHash(c.uid)) + "\"") : ""), CtBad);
			MenuSound(UiSound.Error);
			AddHistory(c, "Failed", why);
			if (c.kind == 3 && ctRun.chain == c.chain)
			{
				if (!ctRun.chainRetried)
				{
					ctRun.chainRetried = true;
					Notify(PopupKind.Contract, "Chain step failed - it can be retried once on a later board", CtGold);
				}
				else
				{
					ctRun.chainsDone.Add(ctRun.chain);
					ctRun.chainStory.Add("(The chain ended after a second failure.)");
					Notify(PopupKind.Contract, "Chain ended: " + ContractBoard.Chain(ctRun.chain)?.name, CtBad);
					ctRun.chain = "";
					ctRun.chainStep = 0;
					ctRun.chainRetried = false;
				}
			}
			_store.MarkDirty();
		}

		public void OnRivalResult(string id, int result, int scrap, string standing)
		{
			//IL_0050: Unknown result type (might be due to invalid IL or missing references)
			//IL_00e3: Unknown result type (might be due to invalid IL or missing references)
			ContractState contractState = CtRun.contracts.Find((ContractState x) => x.type == "Board" && x.kind == 2 && x.id == id && x.status == 0);
			if (contractState != null)
			{
				if (standing != "")
				{
					Notify(PopupKind.Contract, ContractBoard.Name(contractState) + ": " + standing, CtGold);
				}
				switch (result)
				{
				case 0:
					contractState.status = 2;
					AddHistory(contractState, "Void", "no rivals");
					_store.MarkDirty();
					return;
				case 2:
					FailContract(contractState, "a rival won");
					return;
				}
				contractState.status = 1;
				contractState.claimed = true;
				contractState.doneAt = LevelElapsed;
				_ctFlash[contractState.uid] = Time.unscaledTime;
				Banner("RIVAL CONTRACT WON: " + ContractBoard.Name(contractState).ToUpperInvariant(), CtGood, 4f);
				MenuSound(UiSound.Confirm);
				Paid(contractState, scrap);
			}
		}

		private void AddHistory(ContractState c, string result, string reward, int scrap = 0)
		{
			List<ContractHistory> contractHistory = CtRun.contractHistory;
			ContractHistory contractHistory2 = contractHistory.Find((ContractHistory x) => x.uid == c.uid);
			if (contractHistory2 == null)
			{
				contractHistory2 = new ContractHistory
				{
					uid = c.uid
				};
				contractHistory.Add(contractHistory2);
			}
			contractHistory2.name = ContractBoard.Name(c);
			contractHistory2.giver = c.giver;
			contractHistory2.kind = c.kind;
			contractHistory2.tier = c.tier;
			contractHistory2.level = c.level;
			contractHistory2.result = result;
			contractHistory2.reward = reward;
			contractHistory2.scrap = scrap;
			if (contractHistory.Count > 60)
			{
				contractHistory.RemoveAt(0);
			}
		}

		private void AdvanceChain(ContractState c)
		{
			//IL_00f8: Unknown result type (might be due to invalid IL or missing references)
			//IL_00aa: Unknown result type (might be due to invalid IL or missing references)
			RunSave ctRun = CtRun;
			ChainDef chainDef = ContractBoard.Chain(c.chain);
			if (chainDef != null)
			{
				if (ctRun.chain == "")
				{
					ctRun.chain = chainDef.id;
				}
				string text = ContractBoard.ChainLine(c);
				if (text != "")
				{
					ctRun.chainStory.Add(text);
				}
				ctRun.chainStep = c.chainStep + 1;
				ctRun.chainRetried = false;
				if (ctRun.chainStep < chainDef.steps.Length)
				{
					Notify(PopupKind.Contract, $"{chainDef.name}: step {ctRun.chainStep}/{chainDef.steps.Length} done - the next one is on the next board", ContractBoard.GiverColor(chainDef.giver));
					return;
				}
				ctRun.chainsDone.Add(chainDef.id);
				ctRun.chain = "";
				ctRun.chainStep = 0;
				Banner("CHAIN COMPLETE: " + chainDef.name.ToUpperInvariant(), CtGold);
				MenuSound(UiSound.Confirm);
				GiveChainReward(chainDef);
				AddHistory(c, "Chain complete", chainDef.rewardDesc);
				Account.Count("chains");
			}
		}

		private void GiveChainReward(ChainDef ch)
		{
			RunSave ctRun = CtRun;
			Random random = new Random();
			GearItem gearItem = null;
			switch (ch.reward)
			{
			case "setpiece":
			{
				string text = ((ctRun.wishlist.StartsWith("s:", StringComparison.Ordinal) && GearSets.Get(ctRun.wishlist.Substring(2)) != null) ? ctRun.wishlist.Substring(2) : "");
				gearItem = Gear.RollExact(random, Mathf.Min(3, Gear.MaxRarity), null, allowUnique: false);
				if (text != "")
				{
					gearItem.set = text;
				}
				else
				{
					GearSets.MakeSetPiece(gearItem, random);
				}
				break;
			}
			case "weaponunique":
			{
				List<string> list = new List<string>();
				UniqueDef[] uniques = Plugin.Rpg.uniques;
				foreach (UniqueDef uniqueDef in uniques)
				{
					if (uniqueDef.slot == "weapon")
					{
						list.Add(uniqueDef.name);
					}
				}
				gearItem = ((list.Count > 0) ? ShopX.MakeUnique(random, list[random.Next(list.Count)]) : null);
				if (gearItem == null)
				{
					gearItem = Gear.RollExact(random, Gear.MaxRarity, "weapon");
				}
				break;
			}
			case "bond":
				gearItem = ShopX.MakeUnique(random, "Insurer's Bond") ?? Gear.RollExact(random, Gear.MaxRarity, "plating");
				break;
			case "servos":
				gearItem = Gear.RollExact(random, Mathf.Min(3, Gear.MaxRarity), "servos", allowUnique: false);
				AddShopRep(60);
				break;
			}
			if (gearItem != null)
			{
				gearItem.freeValue = SalvageCalc.Gross(gearItem);
				GiveGear(gearItem, ch.name);
			}
		}

		private void AddShopRep(int amount)
		{
			//IL_0048: Unknown result type (might be due to invalid IL or missing references)
			//IL_008e: Unknown result type (might be due to invalid IL or missing references)
			int shopTier = ShopTier;
			CtRun.shopRep += Mathf.Max(0, amount);
			int shopTier2 = ShopTier;
			Notify(PopupKind.Other, $"+{amount} shop reputation", (Color?)new Color(1f, 0.74f, 0.22f), "");
			if (shopTier2 > shopTier)
			{
				Notify(PopupKind.Other, "Shop reputation: " + ShopX.TierNames[shopTier2] + "! Unlocked " + ShopX.TierUnlocks[shopTier2], (Color?)new Color(1f, 0.85f, 0.35f), "");
			}
		}

		public List<string> RewardChoices(ContractState c)
		{
			return ContractBoard.RewardOptions(c, ContractBoard.Rep(CtRun, c.giver));
		}

		public static int RewardTier(ContractState c)
		{
			if (c.kind != 2)
			{
				return Mathf.Clamp(c.tier, 0, 2);
			}
			return 1;
		}

		public void TakeReward(ContractState c, string opt, string moduleId)
		{
			RunSave ctRun = CtRun;
			if (!ctRun.rewardQueue.Contains(c))
			{
				return;
			}
			int num = RewardTier(c);
			switch (opt)
			{
			default:
				return;
			case "gear":
				FindGear(Mathf.Min(Gear.MaxRarity, num + 1), "contract reward");
				break;
			case "parts":
				AddParts(ContractBoard.PartsFor(num), "contract reward");
				break;
			case "module":
				if (num >= 2 && GearX.Module(moduleId) != null)
				{
					AddModule(moduleId, "contract reward");
				}
				else
				{
					RollModuleDrop(100f, "contract reward");
				}
				break;
			case "rep":
				AddShopRep(ContractBoard.RepFor(num));
				break;
			}
			ctRun.rewardQueue.Remove(c);
			ContractHistory contractHistory = ctRun.contractHistory.Find((ContractHistory x) => x.uid == c.uid);
			if (contractHistory != null)
			{
				contractHistory.reward = contractHistory.reward.Replace("pick waiting", ContractBoard.OptionText(opt, num));
			}
			_ctModulePick = "";
			MenuSound(UiSound.Confirm);
			_statsDirty = true;
			_store.SaveNow();
		}

		private static string CurseKey(string id)
		{
			if (!CurseKeys.TryGetValue(id, out string value))
			{
				value = (CurseKeys[id] = "gear.cursed." + id);
			}
			return value;
		}

		public float Curse(string id)
		{
			return _stats.Custom(CurseKey(id));
		}

		public static bool CurseBlocksKey(InputKey k)
		{
			//IL_0009: Unknown result type (might be due to invalid IL or missing references)
			//IL_000b: Invalid comparison between Unknown and I4
			//IL_000d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0010: Invalid comparison between Unknown and I4
			if (CurseInputBypass)
			{
				return false;
			}
			if ((int)k != 1)
			{
				if ((int)k == 12)
				{
					return _curseNoCrouch;
				}
				return false;
			}
			return _curseNoJump;
		}

