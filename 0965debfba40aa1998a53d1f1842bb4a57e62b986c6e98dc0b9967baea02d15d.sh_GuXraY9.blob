				GameObject val = (GameObject)((obj2 is GameObject) ? obj2 : null);
				AudioSource val2 = (((Object)(object)val != (Object)null) ? val.GetComponent<AudioSource>() : null);
				if ((Object)(object)val2 != (Object)null && (Object)(object)val2.outputAudioMixerGroup != (Object)null)
				{
