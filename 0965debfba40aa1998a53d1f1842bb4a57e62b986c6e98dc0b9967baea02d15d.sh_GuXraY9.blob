		public bool SalvagePending(string uid)
		{
			foreach (PendingSalvage value in _pendingSalvage.Values)
			{
				if (value.Uid == uid)
				{
					return true;
				}
			}
			return false;
		}

		public int SalvagePreview(GearItem g)
		{
			return SalvageCalc.Value(g, _stats[Stat.ScrapBonus] + ((CurrentId == "scavenger") ? ClassStat("scavenger.salvage") : 0f));
		}

		public void AskSalvage(GearItem g)
		{
			if (!SalvagePending(g.uid))
			{
				if (SalvageCalc.NeedsConfirm(g))
				{
					_salvageAsk = g;
					_salvageAskBulk = null;
					OpenSalvageDialog();
				}
				else
				{
					RequestSalvage(g, bulk: false);
				}
			}
		}

		public void AskSalvageBulk()
		{
			//IL_007e: Unknown result type (might be due to invalid IL or missing references)
			List<GearItem> list = new List<GearItem>();
			foreach (GearItem item in _store.Data.inventory)
			{
				if (item.rarity <= 1 && !_store.Data.IsEquipped(item) && !SalvagePending(item.uid))
				{
					list.Add(item);
				}
			}
			if (list.Count == 0)
			{
				Toast("No unequipped Common or Uncommon gear", Color.gray);
				return;
			}
			_salvageAsk = null;
			_salvageAskBulk = list;
			if (Plugin.Cfg.SalvageConfirm.Value.Trim().ToLowerInvariant() == "none")
			{
				DoSalvageAsk();
			}
			else
			{
				OpenSalvageDialog();
			}
		}

		private string SalvageDialogText(out string title)
		{
			if (_salvageAskBulk != null)
			{
				int num = 0;
				foreach (GearItem item in _salvageAskBulk)
				{
					num += SalvagePreview(item);
				}
				title = "SALVAGE ALL COMMON / UNCOMMON?";
				return string.Format("Salvage {0} item{1} for +{2} {3}", _salvageAskBulk.Count, (_salvageAskBulk.Count == 1) ? "" : "s", num, Scrap.Short) + (Plugin.Cfg.SalvageGivesXp.Value ? " (and their salvage XP)" : "") + "? Equipped gear is kept.";
			}
			GearItem salvageAsk = _salvageAsk;
			title = "SALVAGE?";
			if (salvageAsk == null)
			{
				return "";
			}
			string text = "";
			SetDef setDef = GearSets.Get(salvageAsk.set);
			if (setDef != null)
			{
				GearSets.Worn(_store.Data.EquippedItems()).TryGetValue(setDef.id, out var value);
				text = $" <color=#ffcc66>This is part of the {setDef.name} set (you wear {value}/4).</color>";
				if (_store.Data.IsEquipped(salvageAsk) && (value == 2 || value == 4))
				{
					text += $" <color=#ff9999>You'll lose the {setDef.name} {value}-piece bonus.</color>";
				}
			}
			if (!string.IsNullOrEmpty(salvageAsk.unique))
			{
				text += " <color=#ffcc66>This is a Unique - you may not find another.</color>";
			}
			int num2 = GearX.Tier(salvageAsk);
			if (num2 >= 1)
			{
				text += $" <color=#ffcc66>It's {GearX.TierNames[num2 - 1]} ({salvageAsk.attune} attunement) - that progress is lost.</color>";
			}
			int num3 = 0;
			string[] modules = salvageAsk.modules;
			for (int i = 0; i < modules.Length; i++)
			{
				if (!string.IsNullOrEmpty(modules[i]))
				{
					num3++;
				}
			}
			if (num3 > 0)
			{
				text += string.Format(" Its {0} module{1} go back to your bag.", num3, (num3 == 1) ? "" : "s");
			}
			return $"Salvage {Cursed.RarityName(salvageAsk)} {salvageAsk.name} for +{SalvagePreview(salvageAsk)} {Scrap.Short}?" + text + (_store.Data.IsEquipped(salvageAsk) ? " It's equipped: it will be unequipped first." : "") + " This can't be undone.";
		}

		private void DoSalvageAsk()
		{
			if (_salvageAskBulk != null)
			{
				foreach (GearItem item in _salvageAskBulk)
				{
					RequestSalvage(item, bulk: true);
				}
			}
			else if (_salvageAsk != null)
			{
				RequestSalvage(_salvageAsk, bulk: false);
			}
			_salvageAsk = null;
			_salvageAskBulk = null;
		}

		private void RequestSalvage(GearItem g, bool bulk)
		{
			RunSave data = _store.Data;
			if (data.FindItem(g.uid) != null && !SalvagePending(g.uid))
			{
				if (data.IsEquipped(g))
				{
					Unequip(g);
				}
				_store.MarkDirty();
				_store.SaveNow();
				int num = ++_salvageSeq;
				_pendingSalvage[num] = new PendingSalvage
				{
					Uid = g.uid,
					Name = g.name,
					Rarity = g.rarity,
					SentAt = Time.unscaledTime,
					Bulk = bulk
				};
				_rowLabels.Remove(g.uid);
				Net.Salvage(num, g.uid, bulk);
			}
		}

