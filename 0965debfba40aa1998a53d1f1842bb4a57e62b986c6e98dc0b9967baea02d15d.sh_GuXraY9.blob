		private static string PadLabel(string chord, string kind)
		{
			if (string.IsNullOrWhiteSpace(chord))
			{
				return "?";
			}
			string[] array = chord.Split('+');
			for (int i = 0; i < array.Length; i++)
			{
				string text = array[i].Trim().ToLowerInvariant();
				bool flag = kind == "PlayStation";
				bool flag2 = kind == "Steam Deck";
				string[] array2 = array;
				int num = i;
				array2[num] = text switch
				{
					"a" => flag ? "CROSS" : "A", 
					"b" => flag ? "CIRCLE" : "B", 
					"x" => flag ? "SQUARE" : "X", 
					"y" => flag ? "TRIANGLE" : "Y", 
					"lb" => (flag || flag2) ? "L1" : "LB", 
					"rb" => (flag || flag2) ? "R1" : "RB", 
					"lt" => (flag || flag2) ? "L2" : "LT", 
					"rt" => (flag || flag2) ? "R2" : "RT", 
					"select" => flag ? "SHARE" : "VIEW", 
					"start" => flag ? "OPTIONS" : "MENU", 
					"ls" => flag ? "L3" : "L-STICK", 
					"rs" => flag ? "R3 / R-STICK" : "R-STICK", 
					"up" => "D-PAD", 
					"down" => "D-PAD", 
					"left" => "D-PAD", 
					"right" => "D-PAD", 
					_ => text.ToUpperInvariant(), 
				};
			}
			return string.Join("+", array);
		}

		private unsafe static string KeyLabel(KeyCode k)
		{
			//IL_0000: Unknown result type (might be due to invalid IL or missing references)
			//IL_0003: Invalid comparison between Unknown and I4
			//IL_0015: Unknown result type (might be due to invalid IL or missing references)
			//IL_0018: Invalid comparison between Unknown and I4
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			//IL_0007: Invalid comparison between Unknown and I4
			//IL_0026: Unknown result type (might be due to invalid IL or missing references)
			//IL_002c: Invalid comparison between Unknown and I4
			//IL_001a: Unknown result type (might be due to invalid IL or missing references)
			//IL_001d: Invalid comparison between Unknown and I4
			//IL_0009: Unknown result type (might be due to invalid IL or missing references)
			//IL_000c: Invalid comparison between Unknown and I4
			//IL_002e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0034: Invalid comparison between Unknown and I4
			//IL_001f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0022: Invalid comparison between Unknown and I4
			//IL_000e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0011: Invalid comparison between Unknown and I4
			if ((int)k <= 13)
			{
				if ((int)k == 8)
				{
					return "BKSP";
				}
				if ((int)k == 9)
				{
					return "TAB";
				}
				if ((int)k == 13)
				{
					return "ENTER";
				}
			}
			else if ((int)k <= 32)
			{
				if ((int)k == 27)
				{
					return "ESC";
				}
				if ((int)k == 32)
				{
					return "SPACE";
				}
			}
			else
			{
				if ((int)k == 303)
				{
					return "SHIFT";
				}
				if ((int)k == 304)
				{
					return "SHIFT";
				}
			}
			return ((object)(*(KeyCode*)(&k))/*cast due to .constrained prefix*/).ToString().ToUpperInvariant();
		}

		private int TalentPendingTotal()
		{
			int num = 0;
			foreach (int value in _talentPending.Values)
			{
				num += value;
			}
			return num;
		}

		private bool TabHasPending(string tab)
		{
			return tab switch
			{
				"Class" => TalentsHavePending, 
				"Attributes" => AttrHasPending, 
				"Perks" => PerksHavePending, 
				"Host" => HostHasPending, 
				_ => false, 
			};
		}

		private void ConfirmTab(string tab)
		{
			switch (tab)
			{
			case "Class":
				ConfirmTalents();
				break;
			case "Attributes":
				ConfirmAttributes();
				break;
			case "Perks":
				ConfirmPerks();
				break;
			case "Host":
				if (HostHasPending && CanEditHost)
				{
					OpenDialog(DialogKind.HostApply, null);
				}
				break;
			}
		}

		private void ResetTab(string tab)
		{
			switch (tab)
			{
			case "Class":
				ResetTalents();
				break;
			case "Attributes":
				ResetAttributes();
				break;
			case "Perks":
				ResetPerks();
				break;
			case "Host":
				_hostPending.Clear();
				break;
			}
		}

		private int Send(byte type, string payload, string classId = "")
		{
			int num = ++_commitSeq;
			_commits[type] = new InFlight
			{
				Id = num,
				SentAt = Time.unscaledTime,
				Payload = payload,
				ClassId = classId
			};
			Net.SendCommit(num, type, RunInfo.Key, payload);
			return num;
		}

		private ClassProgress? TalentPreview(out Dictionary<string, int> applied)
		{
			applied = _talentPending;
			if (Current == null || CurrentProgress == null)
			{
				return null;
			}
			if (_talentPendingClass != Current.id)
			{
				_talentPending.Clear();
				_talentPendingClass = Current.id;
			}
			if (_talentPending.Count == 0)
			{
				return CurrentProgress;
			}
			applied = TalentAlloc.Simulate(Current, CurrentProgress, _talentPending, out ClassProgress sim, out string _);
			return sim;
		}

		private void TalentAdd(BranchDef b, NodeDef n)
		{
			if (TalentsBusy || Current == null || CurrentProgress == null)
			{
				MenuSound(UiSound.Error);
				return;
			}
			Dictionary<string, int> applied;
			ClassProgress classProgress = TalentPreview(out applied);
			if (classProgress == null || ClassDatabase.CanRankUp(Current, b, n, classProgress) != ClassDatabase.RankBlock.None)
			{
				MenuSound(UiSound.Error);
				return;
			}
			_talentPendingClass = Current.id;
			_talentPending.TryGetValue(n.id, out var value);
			_talentPending[n.id] = value + 1;
			PushUndo(UndoKind.Talent, n.id);
		}

		private void TalentRemove(NodeDef n)
		{
			if (TalentsBusy || Current == null || CurrentProgress == null || !_talentPending.TryGetValue(n.id, out var value))
			{
				MenuSound(UiSound.Error);
				return;
			}
			if (value <= 1)
			{
				_talentPending.Remove(n.id);
			}
			else
			{
				_talentPending[n.id] = value - 1;
			}
			ClassProgress sim;
			string error;
			Dictionary<string, int> dictionary = TalentAlloc.Simulate(Current, CurrentProgress, _talentPending, out sim, out error);
			_talentPending.Clear();
			foreach (KeyValuePair<string, int> item in dictionary)
			{
				_talentPending[item.Key] = item.Value;
			}
		}

		private void ResetTalents()
		{
			if (TalentsBusy || !TalentsHavePending)
			{
				MenuSound(UiSound.Error);
				return;
			}
			_talentPending.Clear();
			MenuSound(UiSound.Back);
		}

		private void ConfirmTalents()
		{
			if (TalentsBusy || !TalentsHavePending || Current == null || CurrentProgress == null)
			{
				MenuSound(UiSound.Error);
				return;
			}
			ClassProgress sim;
			string error;
			Dictionary<string, int> dictionary = TalentAlloc.Simulate(Current, CurrentProgress, _talentPending, out sim, out error);
			if (error != "")
			{
				TalentsRejected(error);
			}
			else if (DecideLocally)
			{
				foreach (KeyValuePair<string, int> item in dictionary)
				{
					CurrentProgress.SetRank(item.Key, sim.RankOf(item.Key));
				}
				_talentPending.Clear();
				TalentsApplied();
			}
			else
			{
				_store.SaveNow();
				Send(1, Current.id + "|" + AttributeAlloc.Encode(dictionary), Current.id);
				_talentPending.Clear();
			}
		}

		private void TalentsApplied()
		{
			//IL_0064: Unknown result type (might be due to invalid IL or missing references)
			LoopTrace.Note(string.Format("skill points spent (applied): {0}, {1} left", Current?.id ?? "?", (CurrentProgress != null) ? Leveling.AvailablePoints(CurrentProgress) : 0));
			_store.MarkDirty();
			_statsDirty = true;
			MenuSound(UiSound.Confirm);
			Notify(PopupKind.Other, "Talents updated", Accent);
		}

		private void TalentsRejected(string reason)
		{
			//IL_001d: Unknown result type (might be due to invalid IL or missing references)
			_talentPending.Clear();
			MenuSound(UiSound.Error);
			Toast("Talents not applied: " + reason, Bad, 4f);
			Plugin.Log.LogInfo((object)("Talents refused: " + reason + "."));
		}

		private void PerkSelect(int pick, string perkId)
		{
			if (PerksBusy)
			{
				MenuSound(UiSound.Error);
				return;
			}
			foreach (KeyValuePair<int, string> item in new List<KeyValuePair<int, string>>(_perkPending))
			{
				if (item.Key != pick && item.Value == perkId)
				{
					_perkPending.Remove(item.Key);
				}
			}
			if (_perkPending.TryGetValue(pick, out string value) && value == perkId)
			{
				_perkPending.Remove(pick);
			}
			else
			{
				_perkPending[pick] = perkId;
			}
		}

		private void ResetPerks()
		{
			if (PerksBusy || !PerksHavePending)
			{
				MenuSound(UiSound.Error);
				return;
			}
			_perkPending.Clear();
			MenuSound(UiSound.Back);
		}

		private void ConfirmPerks()
		{
			if (PerksBusy || !PerksHavePending)
			{
				MenuSound(UiSound.Error);
				return;
			}
			Dictionary<int, string> dictionary = new Dictionary<int, string>(_perkPending);
			RunSave data = _store.Data;
			string text = PerkAlloc.Validate(data, dictionary);
			if (text != "")
			{
				PerksRejected(text);
			}
			else if (DecideLocally)
			{
				PerkAlloc.Apply(data, dictionary);
				_perkPending.Clear();
				PerksApplied(dictionary.Values);
			}
			else
			{
				_store.SaveNow();
				Send(2, PerkAlloc.Encode(dictionary));
				_perkPending.Clear();
			}
		}

		private void PerksApplied(IEnumerable<string> ids)
		{
			//IL_0082: Unknown result type (might be due to invalid IL or missing references)
			//IL_0188: Unknown result type (might be due to invalid IL or missing references)
			_nextPerkReport = 0f;
			_statsDirty = true;
			MenuSound(UiSound.Confirm);
			List<string> list = new List<string>(ids);
			Account.SeePerks(list);
			foreach (string item in list)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(item);
				if (perkDef != null)
				{
					Notify(PopupKind.Perk, (perkDef.cursed ? "Cursed perk" : (Perks.RarityName(perkDef.rarity) + " perk")) + ": " + perkDef.name, Perks.ColorOf(perkDef));
					_perkFlash[item] = Time.unscaledTime;
				}
			}
			RunSave data = _store.Data;
			List<string> list2 = new List<string>(data.perks);
			list2.RemoveAll(list.Contains);
			List<(PerkTagDef, int, EffectDef[], string)> list3 = Perks.ActiveTags(list2);
			foreach (var item2 in Perks.ActiveTags(data.perks))
			{
				var (tag, tier, _, arg) = item2;
				if (!list3.Exists(((PerkTagDef tag, int tier, EffectDef[] effects, string desc) x) => x.tag == tag && x.tier == tier))
				{
					Notify(PopupKind.Perk, $"Tag bonus: {tag.tag} x{tier} – {arg}", (Color?)new Color(1f, 0.85f, 0.35f), "");
					_tagFlash[tag.tag] = Time.unscaledTime;
				}
			}
			EnsurePerkChoices();
			_store.SaveNow();
		}

		private void PerksRejected(string reason)
		{
			//IL_001d: Unknown result type (might be due to invalid IL or missing references)
			_perkPending.Clear();
			MenuSound(UiSound.Error);
			Toast("Perks not applied: " + reason, Bad, 4f);
			Plugin.Log.LogInfo((object)("Perk pick refused: " + reason + "."));
		}

		private void AskPlayAs(ClassDef def)
		{
			//IL_001b: Unknown result type (might be due to invalid IL or missing references)
			//IL_003d: Unknown result type (might be due to invalid IL or missing references)
			string reason;
			if (ClassClaims.TakenByOther(def.id, out string ownerName))
			{
				Toast("Taken by " + ownerName, Bad);
				MenuSound(UiSound.Error);
			}
			else if (!CanSwitchClass(out reason))
			{
				Toast(reason, Bad);
				MenuSound(UiSound.Error);
			}
			else
			{
				_playAsTarget = def;
				OpenDialog(DialogKind.PlayAs, null);
			}
		}

		public void RequestClass(ClassDef def)
		{
			//IL_0098: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ca: Unknown result type (might be due to invalid IL or missing references)
			//IL_0145: Unknown result type (might be due to invalid IL or missing references)
			ClassTrace(string.Format("1 confirm pressed: {0} (we are {1}, claims {2}, actor {3}, run '{4}')", def.id, Game.IsMaster() ? "the host" : (Game.IsMultiplayer() ? "a client" : "singleplayer"), ClassClaims.Active ? "on" : "off", ClassClaims.LocalActor, RunInfo.Key));
			string reason;
			if (ClassClaims.TakenByOther(def.id, out string ownerName))
			{
				ClassTrace("1 refused here: taken by " + ownerName);
				Toast("Taken by " + ownerName, Bad);
				MenuSound(UiSound.Error);
			}
			else if (!CanSwitchClass(out reason))
			{
				ClassTrace("1 refused here: " + reason);
				Toast(reason, Bad);
			}
			else if (ClaimBusy)
			{
				ClassTrace("1 ignored: a pick is already waiting for the host");
			}
			else if (!ClassClaims.Active || Game.IsMaster() || _hostChecks == HostChecks.No)
			{
				if (Game.IsMaster() && ClassClaims.Active && !ClassClaims.HostTryClaim(ClassClaims.LocalActor, def.id, out ownerName))
				{
					ClassTrace("4 host (us): refused - taken by " + ownerName);
					Toast("Taken by " + ownerName, Bad);
					MenuSound(UiSound.Error);
				}
				else
				{
					ClassTrace("2-5 decided here (" + (Game.IsMaster() ? "we are the host" : ((!ClassClaims.Active) ? "no lobby claims" : "the host's mod can't check")) + "): ok");
					TakeClass(def);
				}
			}
			else
			{
				int num = Send(3, def.id, def.id);
				ClassTrace($"2 sent to host: request #{num}, Photon event {(byte)150} (message {(byte)27}), class {def.id}");
			}
		}

		private void TakeClass(ClassDef def)
		{
			_talentPending.Clear();
			int msLevel;
			int msNum;
			bool num = MilestoneSwitch(def, out msLevel, out msNum);
			string fromName = Current?.name ?? "";
			SelectClass(def.id);
			if (num && Current == def)
			{
				PatchGuard.Run("milestone class switch", delegate
				{
					ApplyMilestoneSwitch(msLevel, msNum, fromName);
				});
			}
			_viewClass = def;
			if (Current != def)
			{
				ClassTrace("6 FAILED: asked for " + def.id + ", playing " + (Current?.id ?? "none") + " after setting it");
			}
			else
			{
				MenuSound(UiSound.Confirm);
			}
		}

		public void OnCommitResult(int id, byte type, bool ok, string reason, string result)
		{
			//IL_01b9: Unknown result type (might be due to invalid IL or missing references)
			if (!ok)
			{
				LoopTrace.Note($"a change was REFUSED by the host (type {type}): {reason}");
			}
			_hostChecks = HostChecks.Yes;
			if (!_commits.TryGetValue(type, out InFlight value) && ok && type != 3 && _lateCommits.TryGetValue(id, out (byte, InFlight) value2) && value2.Item1 == type)
			{
				_lateCommits.Remove(id);
				_commits[type] = value2.Item2;
				value = value2.Item2;
				Plugin.Log.LogInfo((object)("[net] a late confirm from the host was applied (" + ((type == 1) ? "talents" : "perks") + ")."));
			}
			if (type == 3)
			{
				ClassTrace(string.Format("5 answer from host for #{0}: {1} (waiting for #{2})", id, ok ? "ok" : ("refused - " + reason), _commits.TryGetValue(type, out InFlight value3) ? value3.Id.ToString() : "none"));
			}
			if (!_commits.TryGetValue(type, out value) || value.Id != id)
			{
				if (type == 3)
				{
					ClassTrace("5 ignored: an old or given-up request");
				}
				if (type == 3 && ok)
				{
					ClassClaims.AnnounceLocal(Current?.id);
				}
				return;
			}
			_commits.Remove(type);
			if (type == 3)
			{
				ClassDef classDef = Plugin.Db.Get(value.ClassId);
				if (!ok || classDef == null)
				{
					MenuSound(UiSound.Error);
					if (classDef != null)
					{
						_viewClass = classDef;
					}
					Toast((reason.StartsWith("taken by") ? ("Taken by " + reason.Substring(9)) : ("Couldn't take that class: " + ((classDef == null) ? "unknown class" : reason))) + " - you're still on No class", Bad, 4f);
				}
				else
				{
					TakeClass(classDef);
				}
			}
			else if (!ok)
			{
				if (type == 1)
				{
					TalentsRejected(reason);
				}
				else
				{
					PerksRejected(reason);
				}
			}
			else if (type == 1)
			{
				ApplyTalentResult(result);
			}
			else
			{
				Dictionary<int, string> dictionary = PerkAlloc.Decode(result);
				if (dictionary != null && PerkAlloc.Validate(_store.Data, dictionary) == "")
				{
					PerkAlloc.Apply(_store.Data, dictionary);
					PerksApplied(dictionary.Values);
				}
				else
				{
					Plugin.Log.LogWarning((object)("The host applied perk picks (" + result + ") that don't match this game's choices; ignored."));
				}
			}
		}

		private void ApplyTalentResult(string result)
		{
			int num = result.IndexOf('|');
			ClassDef classDef = ((num > 0) ? Plugin.Db.Get(result.Substring(0, num)) : null);
			ClassProgress classProgress = ((classDef != null) ? _store.ProgressFor(classDef.id) : null);
			Dictionary<string, int> dictionary = ((num > 0) ? AttributeAlloc.Decode(result.Substring(num + 1)) : null);
			if (classDef == null || classProgress == null || dictionary == null)
			{
				return;
			}
			foreach (KeyValuePair<string, int> item2 in dictionary)
			{
				NodeDef item = TalentAlloc.Find(classDef, item2.Key).n;
				if (item != null)
				{
					classProgress.SetRank(item.id, Mathf.Clamp(item2.Value, 0, item.maxRank));
				}
			}
			TalentsApplied();
		}

		private void TickCommits()
		{
			//IL_01e6: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ad: Unknown result type (might be due to invalid IL or missing references)
			if (_commits.Count == 0)
			{
				return;
			}
			float unscaledTime = Time.unscaledTime;
			List<byte> list = null;
			foreach (KeyValuePair<byte, InFlight> commit in _commits)
			{
				InFlight value = commit.Value;
				float num = ((commit.Key == 3) ? 3f : 5f);
				if (!(unscaledTime - value.SentAt < num))
				{
					if (!value.Retried)
					{
						value.Retried = true;
						value.SentAt = unscaledTime;
						Net.SendCommit(value.Id, commit.Key, RunInfo.Key, value.Payload);
					}
					else
					{
						(list ?? (list = new List<byte>())).Add(commit.Key);
					}
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (byte item in list)
			{
				InFlight inFlight = _commits[item];
				_lateCommits[inFlight.Id] = (item, inFlight);
				_commits.Remove(item);
				if (item == 1)
				{
					_talentPending.Clear();
				}
				if (item == 2)
				{
					_perkPending.Clear();
				}
				MenuSound(UiSound.Error);
				if (item == 3)
				{
					ClassTrace(string.Format("5 timed out: no answer to claim #{0} ({1}) after a retry - still {2}", inFlight.Id, inFlight.ClassId, Current?.id ?? "no class"));
					ClassDef classDef = Plugin.Db.Get(inFlight.ClassId);
					if (classDef != null)
					{
						_viewClass = classDef;
					}
					Toast("Couldn't reach the host - class not changed. Press Play as to try again.", Bad, 5f);
					Plugin.Log.LogWarning((object)"[net] the host never answered a class pick: class not changed.");
				}
				else
				{
					string text = "Changes not saved";
					Toast("Couldn't reach the host - " + text.ToLowerInvariant(), Bad, 4f);
					Plugin.Log.LogWarning((object)("[net] the host never answered a confirm (" + ((item == 1) ? "talents" : "perks") + "): " + text + "."));
				}
			}
		}

		public void OnActionLost(string msg)
		{
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			RefundCharge();
			if (!(msg == ""))
			{
				Toast(msg, Color.gray);
				MenuSound(UiSound.Error);
			}
		}

		public void CancelPendingRequests(string why)
		{
			//IL_0136: Unknown result type (might be due to invalid IL or missing references)
			bool flag = false;
			if (_attrInFlight != null)
			{
				_attrInFlight = null;
				_attrLateOk = true;
				flag = true;
			}
			if (_commits.Count > 0)
			{
				if (_commits.ContainsKey(1))
				{
					_talentPending.Clear();
				}
				if (_commits.ContainsKey(2))
				{
					_perkPending.Clear();
				}
				foreach (KeyValuePair<byte, InFlight> commit in _commits)
				{
					_lateCommits[commit.Value.Id] = (commit.Key, commit.Value);
				}
				if (_lateCommits.Count > 20)
				{
					_lateCommits.Clear();
				}
				_commits.Clear();
				flag = true;
			}
			foreach (int item in new List<int>(_pendingBuys.Keys))
			{
				GiveUpBuy(item, "");
				flag = true;
			}
			if (flag)
			{
				Toast(why + " - changes not saved", Bad, 4f);
				Plugin.Log.LogWarning((object)("[net] " + why + ": cancelled what was waiting on the host."));
			}
		}

		private void DropAllPending()
		{
			_talentPending.Clear();
			_perkPending.Clear();
			_commits.Clear();
			_hostChecks = HostChecks.Unknown;
			_playAsTarget = null;
		}

