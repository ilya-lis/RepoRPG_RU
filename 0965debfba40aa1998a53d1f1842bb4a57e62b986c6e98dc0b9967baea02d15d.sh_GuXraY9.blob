		private void ResetPilots()
		{
			foreach (Pilot value in _pilots.Values)
			{
				if ((Object)(object)value.Cart != (Object)null && (Object)(object)value.Rb != (Object)null)
				{
					if (value.St == CartSt.Overdrive)
					{
						EndOverdrive(value, "level changed");
					}
					RestorePhysics(value);
				}
			}
			_pilots.Clear();
			VizClearAll();
		}

		private void StopPilot(PhysGrabCart cart, string finalState)
		{
			if (_pilots.TryGetValue(cart, out Pilot value))
			{
				if (value.St == CartSt.Overdrive)
				{
					EndOverdrive(value, "stopped");
				}
				SetState(value, CartSt.Idle, "no longer driven");
				RestorePhysics(value);
				SendCartState(value, finalState);
				CartLog(value, "dropped: a normal cart again");
				VizClear(value);
				_pilots.Remove(cart);
			}
		}

