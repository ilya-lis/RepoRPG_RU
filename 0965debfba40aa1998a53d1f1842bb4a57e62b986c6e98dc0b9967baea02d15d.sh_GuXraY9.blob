	internal static class StatInfo
	{
		public static readonly int Count = Enum.GetValues(typeof(Stat)).Length;

		public static int Parse(string name)
		{
			if (!Enum.TryParse<Stat>(name, ignoreCase: true, out var result) || !Enum.IsDefined(typeof(Stat), result))
			{
				return -1;
			}
			return (int)result;
		}

		public static string Describe(Stat s, float v)
		{
			string obj = ((v >= 0f) ? "+" : "");
			string text = v.ToString((Math.Abs(v % 1f) > 0.001f) ? "0.##" : "0", CultureInfo.InvariantCulture);
			string text2 = obj + text;
			return s switch
			{
				Stat.MaxHealth => text2 + "% max health", 
				Stat.DamageTaken => text2 + "% damage taken", 
				Stat.MoveSpeed => text2 + "% walk speed", 
				Stat.SprintSpeed => text2 + "% sprint speed", 
				Stat.CrouchSpeed => text2 + "% crouch speed", 
				Stat.JumpForce => text2 + "% jump force", 
				Stat.ExtraJumps => text2 + " extra jump" + ((Math.Abs(v) == 1f) ? "" : "s"), 
				Stat.MaxStamina => text2 + "% max stamina", 
				Stat.StaminaDrain => text2 + "% sprint stamina drain", 
				Stat.StaminaRegen => text2 + " stamina/s", 
				Stat.GrabStrength => text2 + "% grab strength", 
				Stat.GrabRange => text2 + "% grab range", 
				Stat.ThrowStrength => text2 + "% throw strength", 
				Stat.HealthRegen => text2 + " HP/s regen", 
				Stat.DodgeChance => text2 + "% dodge chance", 
				Stat.LowHealthSpeed => text2 + "% speed below 35% HP", 
				Stat.HoldingStaminaDrain => text2 + "% stamina drain while carrying", 
				Stat.DeathSaves => text2 + " death save per level", 
				Stat.AllyRegen => text2 + " HP to nearby allies every 3s", 
				Stat.AuraRadius => text2 + "m aura radius", 
				Stat.ReviveHeal => text2 + " HP to allies revived near you", 
				Stat.HealOnKill => text2 + " HP when an enemy dies near you", 
				Stat.EnemySense => text2 + "m enemy sense range", 
				Stat.CooldownReduction => text2 + "% ability cooldown reduction", 
				Stat.ActiveDuration => text2 + "% ability duration", 
				Stat.ActivePower => text2 + "% ability power", 
				Stat.ActiveArea => text2 + "% ability radius", 
				Stat.XpGain => text2 + "% all XP", 
				Stat.KillXp => text2 + "% kill XP", 
				Stat.ExtractXp => text2 + "% extraction XP", 
				Stat.ReviveXp => text2 + "% revive XP", 
				Stat.LevelXp => text2 + "% level-complete XP", 
				Stat.WeaponDamage => text2 + "% weapon damage", 
				Stat.BleedOnHit => text2 + "% bleed chance on hit", 
				Stat.StunOnHit => text2 + "% stun chance on hit", 
				Stat.Lifesteal => text2 + " HP per weapon hit", 
				Stat.GearLuck => text2 + " gear luck", 
				Stat.AbilityCharges => text2 + " ability charge" + ((Math.Abs(v) == 1f) ? "" : "s"), 
				Stat.KillCooldownRefund => text2 + "s ability cooldown per nearby kill", 
				Stat.GearFind => text2 + "% gear find on extraction", 
				Stat.EliteExtraDrop => text2 + "% extra elite gear drop", 
				Stat.ExtractionHeal => text2 + " HP when an extraction completes", 
				Stat.ShopDiscount => text2 + "% mod shop discount", 
				Stat.HeldItemProtection => text2 + "% less damage to items you hold", 
				Stat.AppraiseValue => text2 + "% value to valuables you appraise", 
				Stat.AppraiseRadius => text2 + "m appraisal radius", 
				Stat.GuardAura => text2 + "% less damage for allies near you", 
				Stat.GuardRadius => text2 + "m Shield Wall radius", 
				Stat.StabilizeAura => text2 + "% less damage for low-HP allies in your aura", 
				Stat.MomentumPower => text2 + "% sprint speed per Momentum stack", 
				Stat.MomentumMax => text2 + " max Momentum stack" + ((Math.Abs(v) == 1f) ? "" : "s"), 
				Stat.MomentumGrace => text2 + "s Momentum hold after you stop", 
				Stat.FrenzyPower => text2 + "% throw & weapon damage per Frenzy stack", 
				Stat.FrenzyMax => text2 + " max Frenzy stack" + ((Math.Abs(v) == 1f) ? "" : "s"), 
				Stat.LinkStamina => text2 + " stamina/s for allies near you", 
				Stat.LinkRadius => text2 + "m Power Link radius", 
				Stat.ShadowstepSpeed => text2 + "% speed for 3s after a dodge", 
				Stat.DodgeRefund => text2 + "s ability cooldown per dodge", 
				Stat.ScarTissue => text2 + "% Scar Tissue per hit taken", 
				Stat.ScarTissueMax => text2 + "% max Scar Tissue", 
				Stat.MarkDamage => text2 + "% damage to Marked enemies", 
				Stat.MarkDuration => text2 + "s Mark duration", 
				Stat.NoiseReduction => ((v > 0f) ? "-" : ((v < 0f) ? "+" : "")) + text.TrimStart('-') + "% noise you make", 
				Stat.ScrapBonus => text2 + "% bonus currency share", 
				Stat.AppraiseRareBonus => text2 + "% more for Rare+ valuables you appraise", 
				_ => $"{text2} {s}", 
			};
		}
	}
	internal sealed class StatSheet
	{
		private readonly float[] _perm = new float[StatInfo.Count];

		private readonly float[] _temp = new float[StatInfo.Count];

		private readonly float[] _dyn = new float[StatInfo.Count];

		private readonly Dictionary<string, float> _custom = new Dictionary<string, float>();

		public float this[Stat s] => _perm[(int)s] + _temp[(int)s] + _dyn[(int)s];

		public float Custom(string? name)
		{
			if (string.IsNullOrEmpty(name) || !_custom.TryGetValue(name, out var value))
			{
				return 0f;
			}
			return value;
		}

		public void AddTemp(int statIndex, float v)
		{
			if (statIndex >= 0)
			{
				_temp[statIndex] += v;
			}
		}

		public float Perm(Stat s)
		{
			return _perm[(int)s];
		}

		public float Temp(Stat s)
		{
			return _temp[(int)s];
		}

		public float Dyn(Stat s)
		{
			return _dyn[(int)s];
		}

		public void ClearDyn()
		{
			Array.Clear(_dyn, 0, _dyn.Length);
		}

		public void AddDyn(Stat s, float v)
		{
			_dyn[(int)s] += v;
		}

		public void Rebuild(ClassDef? cls, ClassProgress? prog, RunSave? run, RpgData? data)
		{
			Array.Clear(_perm, 0, _perm.Length);
			_custom.Clear();
			if (cls != null)
			{
				AltPassiveDef altPassiveDef = (Account.AltInRun(run, cls.id) ? Account.AltDef(cls.id) : null);
				PassiveDef[] passives = cls.passives;
				foreach (PassiveDef passiveDef in passives)
				{
					EffectDef[] array = ((altPassiveDef != null && altPassiveDef.replaces == passiveDef.name) ? altPassiveDef.effects : passiveDef.effects);
					foreach (EffectDef e in array)
					{
						Add(_perm, e, 1f);
					}
				}
				if (prog != null)
				{
					for (int k = 0; k < cls.branches.Length; k++)
					{
						if (k >= 3 && !Account.PrestigeUsable(cls.id))
						{
							continue;
						}
						NodeDef[] nodes = cls.branches[k].nodes;
						foreach (NodeDef nodeDef in nodes)
						{
							int num = prog.RankOf(nodeDef.id);
							if (num > 0)
							{
								EffectDef[] array = nodeDef.effects;
								foreach (EffectDef e2 in array)
								{
									Add(_perm, e2, num);
								}
							}
						}
					}
				}
			}
			if (run == null || data == null)
			{
				return;
			}
			AttributeDef[] attributes = data.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				int num2 = run.AttributePoints(attributeDef.id);
				if (num2 > 0)
				{
					float mult = attributeDef.EffectivePoints(num2);
					EffectDef[] array = attributeDef.effects;
					foreach (EffectDef e3 in array)
					{
						Add(_perm, e3, mult);
					}
				}
			}
			float strength = AttrBonus.Strength;
			foreach (var item in AttrBonus.Active(run, cls?.id))
			{
				EffectDef[] array = item.effects;
				foreach (EffectDef e4 in array)
				{
					Add(_perm, e4, strength);
				}
			}
			List<(EffectDef, float)> list = new List<(EffectDef, float)>();
			foreach (GearItem item2 in run.EquippedItems())
			{
				GearX.Effective(item2, list);
			}
			foreach (var (e5, mult2) in list)
			{
				Add(_perm, e5, mult2);
			}
			DieEffects(run);
			foreach (string item3 in run.consActive)
			{
				ConsumableDef consumableDef = ShopX.Cons(item3);
				if (consumableDef != null)
				{
					EffectDef[] array = consumableDef.effects;
					foreach (EffectDef e6 in array)
					{
						Add(_perm, e6, 1f);
					}
				}
			}
			foreach (var item4 in GearSets.Active(run.EquippedItems()))
			{
				EffectDef[] array = item4.effects;
				foreach (EffectDef e7 in array)
				{
					Add(_perm, e7, 1f);
				}
			}
			foreach (NodeRank upgradeBonu in run.upgradeBonus)
			{
				UpgradeDef upgradeDef = data.Upgrade(upgradeBonu.id);
				if (upgradeDef != null && upgradeBonu.rank > 0)
				{
					EffectDef[] array = upgradeDef.effects;
					foreach (EffectDef e8 in array)
					{
						Add(_perm, e8, upgradeBonu.rank);
					}
				}
			}
			foreach (string perk in run.perks)
			{
				PerkDef perkDef = data.Perk(perk);
				if (!Perks.Counts(perkDef))
				{
					continue;
				}
				EffectDef[] array = perkDef.effects;
				foreach (EffectDef e9 in array)
				{
					Add(_perm, e9, 1f);
				}
				if (Perks.IsEvolved(run, perk))
				{
					array = perkDef.evolveEffects;
					foreach (EffectDef e10 in array)
					{
						Add(_perm, e10, 1f);
					}
				}
			}
			foreach (var item5 in Perks.ActiveTags(run.perks))
			{
				EffectDef[] array = item5.effects;
				foreach (EffectDef e11 in array)
				{
					Add(_perm, e11, 1f);
				}
			}
		}

		public static List<(string source, float value)> Explain(string stat, ClassDef? cls, ClassProgress? prog, RunSave? run, RpgData? data)
		{
			List<(string, float)> list = new List<(string, float)>();
			if (cls != null)
			{
				AltPassiveDef altPassiveDef = (Account.AltInRun(run, cls.id) ? Account.AltDef(cls.id) : null);
				PassiveDef[] passives = cls.passives;
				foreach (PassiveDef passiveDef in passives)
				{
					if (altPassiveDef != null && altPassiveDef.replaces == passiveDef.name)
					{
						Each("Alternate passive: " + altPassiveDef.name, altPassiveDef.effects, 1f);
					}
					else
					{
						Each("Passive: " + passiveDef.name, passiveDef.effects, 1f);
					}
				}
				if (prog != null)
				{
					BranchDef[] branches = cls.branches;
					for (int i = 0; i < branches.Length; i++)
					{
						NodeDef[] nodes = branches[i].nodes;
						foreach (NodeDef nodeDef in nodes)
						{
							int num = prog.RankOf(nodeDef.id);
							if (num > 0)
							{
								Each($"Talent: {nodeDef.name} (rank {num})", nodeDef.effects, num);
							}
						}
					}
				}
			}
			if (run == null || data == null)
			{
				return list;
			}
			AttributeDef[] attributes = data.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				int num2 = run.AttributePoints(attributeDef.id);
				if (num2 > 0)
				{
					Each($"Attribute: {attributeDef.name} ({num2} pts)", attributeDef.effects, attributeDef.EffectivePoints(num2));
				}
			}
			foreach (var (text, text2, _, effects) in AttrBonus.Active(run, cls?.id))
			{
				Each((text.StartsWith("p:") ? "Pairing: " : "Milestone: ") + text2, effects, AttrBonus.Strength);
			}
			foreach (GearItem item in run.EquippedItems())
			{
				List<(EffectDef, float)> list2 = new List<(EffectDef, float)>();
				GearX.Effective(item, list2);
				float num3 = 0f;
				foreach (var (effectDef, num4) in list2)
				{
					if (string.Equals(effectDef.stat, stat, StringComparison.OrdinalIgnoreCase))
					{
						num3 += effectDef.value * num4;
					}
				}
				if (Math.Abs(num3) > 0.0001f)
				{
					list.Add(("Gear: " + item.name, num3));
				}
			}
			foreach (var (setDef, num5, effects2) in GearSets.Active(run.EquippedItems()))
			{
				Each($"Set: {setDef.name} {num5}-piece", effects2, 1f);
			}
			foreach (NodeRank upgradeBonu in run.upgradeBonus)
			{
				UpgradeDef upgradeDef = data.Upgrade(upgradeBonu.id);
				if (upgradeDef != null && upgradeBonu.rank > 0)
				{
					Each($"Upgrade: {upgradeDef.name} x{upgradeBonu.rank}", upgradeDef.effects, upgradeBonu.rank);
				}
			}
			foreach (string perk in run.perks)
			{
				PerkDef perkDef = data.Perk(perk);
				if (Perks.Counts(perkDef))
				{
					Each("Perk: " + perkDef.name, perkDef.effects, 1f);
					if (Perks.IsEvolved(run, perk))
					{
						Each("Evolved: " + perkDef.evolveName, perkDef.evolveEffects, 1f);
					}
				}
			}
			foreach (var (perkTagDef, num6, effects3, _) in Perks.ActiveTags(run.perks))
			{
				Each($"Tag bonus: {perkTagDef.tag} x{num6}", effects3, 1f);
			}
			return list;
			void Each(string src, IEnumerable<EffectDef>? enumerable, float mult)
			{
				float num7 = 0f;
				if (enumerable != null)
				{
					foreach (EffectDef item2 in enumerable)
					{
						if (item2 != null && string.Equals(item2.stat, stat, StringComparison.OrdinalIgnoreCase))
						{
							num7 += item2.value * mult;
						}
					}
				}
				if (Math.Abs(num7) > 0.0001f)
				{
					list.Add((src, num7));
				}
			}
		}

		private void DieEffects(RunSave run)
		{
			if (run.dieLevel != RunInfo.LevelIndex || run.dieLevel < 0)
			{
				return;
			}
			bool flag = false;
			foreach (GearItem item in run.EquippedItems())
			{
				if (GearX.Has(item, "gear.die"))
				{
					flag = true;
				}
			}
			if (flag)
			{
				Apply(run.dieUp, 1f);
				Apply(run.dieDown, -0.5f);
			}
			void Apply(string key, float mult)
			{
				int num = key.IndexOf('#');
				if (num > 0 && int.TryParse(key.Substring(num + 1), out var result))
				{
					GearItem gearItem = run.FindItem(key.Substring(0, num));
					if (gearItem != null && run.IsEquipped(gearItem) && result >= 0 && result < gearItem.effects.Length && gearItem.effects[result].StatIndex >= 0)
					{
						Add(_perm, gearItem.effects[result], mult);
					}
				}
			}
		}

		public void AddPermEffects(EffectDef[] effects, float mult)
		{
			foreach (EffectDef e in effects)
			{
				Add(_perm, e, mult);
			}
		}

		public void AddPerm(Stat s, float v)
		{
			_perm[(int)s] += v;
		}

		public void CustomWithPrefix(string prefix, Dictionary<string, float> into)
		{
			into.Clear();
			foreach (KeyValuePair<string, float> item in _custom)
			{
				if (item.Key.StartsWith(prefix, StringComparison.Ordinal))
				{
					into[item.Key] = item.Value;
				}
			}
		}

		public void SetTemp(EffectDef[]? buffs, float scale)
		{
			Array.Clear(_temp, 0, _temp.Length);
			if (buffs != null)
			{
				foreach (EffectDef e in buffs)
				{
					Add(_temp, e, scale);
				}
			}
		}

		private void Add(float[] arr, EffectDef e, float mult)
		{
			if (e.StatIndex >= 0)
			{
				arr[e.StatIndex] += e.value * mult;
			}
			else if (arr == _perm && !string.IsNullOrEmpty(e.stat) && e.stat.IndexOf('.') >= 0)
			{
				_custom.TryGetValue(e.stat, out var value);
				_custom[e.stat] = value + e.value * mult;
			}
		}
	}
	internal sealed class ClassDatabase
	{
		public enum RankBlock
		{
			None,
			Maxed,
			NoPoints,
			LevelTooLow,
			NeedsPrevious
		}

		public const int Tiers = 5;

		public readonly List<ClassDef> Classes = new List<ClassDef>();

		private readonly Dictionary<string, ClassDef> _byId = new Dictionary<string, ClassDef>();

		private static readonly HashSet<string> CodeStats = new HashSet<string> { "survivor.save_window", "survivor.save_heal", "survivor.save_speed" };

		private static readonly HashSet<string> SharedStats = new HashSet<string> { "ActivePower", "ActiveDuration", "ActiveArea", "CooldownReduction", "AbilityCharges" };

		private static readonly HashSet<string> SignatureStats = new HashSet<string>
		{
			"GuardAura", "GuardRadius", "StabilizeAura", "AllyRegen", "AuraRadius", "ReviveHeal", "MomentumPower", "MomentumMax", "MomentumGrace", "ExtraJumps",
			"HeldItemProtection", "FrenzyPower", "FrenzyMax", "HealOnKill", "LinkStamina", "LinkRadius", "ShadowstepSpeed", "DodgeRefund", "DodgeChance", "ScarTissue",
			"ScarTissueMax", "DeathSaves", "AppraiseValue", "AppraiseRareBonus", "AppraiseRadius", "EnemySense", "MarkDamage", "MarkDuration"
		};

		public static string Folder => Path.Combine(Paths.ConfigPath, "RepoRPG");

		public int TreeVersion { get; private set; } = 1;

		public ClassDef? Get(string? id)
		{
			if (id == null || !_byId.TryGetValue(id, out ClassDef value))
			{
				return null;
			}
			return value;
		}

		public static ClassDatabase Load()
		{
			string text = ReadEmbedded("classes");
			string text2 = ReadWithOverride("classes", text);
			ClassDatabase classDatabase = new ClassDatabase();
			ClassDatabaseFile classDatabaseFile = null;
			try
			{
				classDatabaseFile = Json.Deserialize<ClassDatabaseFile>(text2);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("Class data parse error: " + ex.Message));
			}
			if (classDatabaseFile != null && text2 != text)
			{
				int num = 1;
				try
				{
					num = Json.Deserialize<ClassDatabaseFile>(text).treeVersion;
				}
				catch
				{
				}
				if (classDatabaseFile.treeVersion < num)
				{
					Plugin.Log.LogWarning((object)($"classes.override.json is for an older skill tree layout (v{classDatabaseFile.treeVersion}, now v{num}); " + "ignoring it. Copy classes.default.json again and re-apply your changes."));
					classDatabaseFile = null;
					text2 = text;
				}
			}
			if (classDatabaseFile?.classes == null || classDatabaseFile.classes.Length == 0)
			{
				if (text2 != text)
				{
					Plugin.Log.LogError((object)"classes.override.json has no usable classes, falling back to built-in classes.");
				}
				classDatabaseFile = Json.Deserialize<ClassDatabaseFile>(text);
			}
			if (classDatabaseFile.classes == null || classDatabaseFile.classes.Length == 0)
			{
				Plugin.Log.LogError((object)"Built-in class data could not be read; no classes available.");
				classDatabaseFile.classes = Array.Empty<ClassDef>();
			}
			ClassDef[] classes;
			if (text2 != text && Array.Exists(classDatabaseFile.classes, (ClassDef classDef3) => classDef3 != null && classDef3.complexity <= 0))
			{
				try
				{
					ClassDatabaseFile classDatabaseFile2 = Json.Deserialize<ClassDatabaseFile>(text);
					classes = classDatabaseFile.classes;
					foreach (ClassDef c in classes)
					{
						if (c == null || c.complexity > 0)
						{
							continue;
						}
						ClassDef classDef = Array.Find(classDatabaseFile2.classes ?? Array.Empty<ClassDef>(), (ClassDef x) => x.id == c.id);
						if (classDef != null)
						{
							c.complexity = classDef.complexity;
							if (string.IsNullOrEmpty(c.complexityTip))
							{
								c.complexityTip = classDef.complexityTip;
							}
							c.recommended |= classDef.recommended;
						}
					}
				}
				catch
				{
				}
			}
			classDatabase.TreeVersion = Math.Max(1, classDatabaseFile.treeVersion);
			classes = classDatabaseFile.classes;
			foreach (ClassDef classDef2 in classes)
			{
				if (string.IsNullOrEmpty(classDef2.id) || classDatabase._byId.ContainsKey(classDef2.id))
				{
					Plugin.Log.LogWarning((object)("Skipping class with missing/duplicate id '" + classDef2.id + "'."));
					continue;
				}
				classDatabase.Prepare(classDef2);
				classDatabase.Classes.Add(classDef2);
				classDatabase._byId[classDef2.id] = classDef2;
			}
			foreach (string item in ValidateExclusive(classDatabase.Classes))
			{
				Plugin.Log.LogError((object)("[skill trees] " + item));
			}
			return classDatabase;
		}

		private void Prepare(ClassDef c)
		{
			ClassDef classDef = c;
			if (classDef.passives == null)
			{
				classDef.passives = Array.Empty<PassiveDef>();
			}
			classDef = c;
			if (classDef.branches == null)
			{
				classDef.branches = Array.Empty<BranchDef>();
			}
			classDef = c;
			if (classDef.active == null)
			{
				classDef.active = new ActiveDef();
			}
			ActiveDef active = c.active;
			if (active.actions == null)
			{
				active.actions = Array.Empty<ActionDef>();
			}
			active = c.active;
			if (active.buffs == null)
			{
				active.buffs = Array.Empty<EffectDef>();
			}
			active = c.active;
			if (active.mods == null)
			{
				active.mods = new ActiveMods();
			}
			active = c.active;
			if (active.riders == null)
			{
				active.riders = Array.Empty<RiderDef>();
			}
			RiderDef[] riders = c.active.riders;
			foreach (RiderDef riderDef in riders)
			{
				RiderDef riderDef2 = riderDef;
				if (riderDef2.stat == null)
				{
					riderDef2.stat = "";
				}
				riderDef2 = riderDef;
				if (riderDef2.action == null)
				{
					riderDef2.action = "";
				}
				riderDef2 = riderDef;
				if (riderDef2.buff == null)
				{
					riderDef2.buff = "";
				}
				riderDef.BuffIndex = ((riderDef.buff == "") ? (-1) : StatInfo.Parse(riderDef.buff));
				if (riderDef.buff != "" && riderDef.BuffIndex < 0)
				{
					Plugin.Log.LogWarning((object)("[" + c.id + "] Rider buff '" + riderDef.buff + "' is not a stat."));
				}
			}
			classDef = c;
			if (classDef.affinities == null)
			{
				classDef.affinities = Array.Empty<string>();
			}
			classDef = c;
			if (classDef.group == null)
			{
				classDef.group = "";
			}
			classDef = c;
			if (classDef.mechanics == null)
			{
				classDef.mechanics = Array.Empty<string>();
			}
			PassiveDef[] passives = c.passives;
			foreach (PassiveDef passiveDef in passives)
			{
				string id = c.id;
				PassiveDef passiveDef2 = passiveDef;
				ResolveAll(id, passiveDef2.effects ?? (passiveDef2.effects = Array.Empty<EffectDef>()));
			}
			ResolveAll(c.id, c.active.buffs);
			for (int j = 0; j < c.branches.Length; j++)
			{
				BranchDef branchDef2;
				BranchDef branchDef = (branchDef2 = c.branches[j]);
				if (branchDef2.nodes == null)
				{
					branchDef2.nodes = Array.Empty<NodeDef>();
				}
				Array.Sort(branchDef.nodes, (NodeDef x, NodeDef y) => x.tier.CompareTo(y.tier));
				NodeDef[] nodes = branchDef.nodes;
				foreach (NodeDef nodeDef in nodes)
				{
					if (string.IsNullOrEmpty(nodeDef.id))
					{
						nodeDef.id = $"{c.id}.b{j + 1}.t{nodeDef.tier}";
					}
					if (nodeDef.maxRank < 1)
					{
						nodeDef.maxRank = 1;
					}
					NodeDef nodeDef2 = nodeDef;
					if (nodeDef2.desc == null)
					{
						nodeDef2.desc = "";
					}
					nodeDef2 = nodeDef;
					if (nodeDef2.requires == null)
					{
						nodeDef2.requires = "";
					}
					string id2 = c.id;
					nodeDef2 = nodeDef;
					ResolveAll(id2, nodeDef2.effects ?? (nodeDef2.effects = Array.Empty<EffectDef>()));
				}
			}
		}

		public static string ReadWithOverride(string stem, string embedded)
		{
			Directory.CreateDirectory(Folder);
			try
			{
				File.WriteAllText(Path.Combine(Folder, stem + ".default.json"), embedded);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("Could not write " + stem + ".default.json: " + ex.Message));
			}
			string path = Path.Combine(Folder, stem + ".override.json");
			if (!File.Exists(path))
			{
				return embedded;
			}
			try
			{
				Plugin.Log.LogInfo((object)("Using " + stem + ".override.json"));
				return File.ReadAllText(path);
			}
			catch (Exception ex2)
			{
				Plugin.Log.LogError((object)(stem + ".override.json unreadable, using built-in data: " + ex2.Message));
				return embedded;
			}
		}

		public static RpgData LoadRpgData()
		{
			string text = ReadEmbedded("rpg");
			RpgData rpgData = null;
			try
			{
				rpgData = Json.Deserialize<RpgData>(ReadWithOverride("rpg", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("rpg data parse error: " + ex.Message));
			}
			if (rpgData?.rarities == null || rpgData.rarities.Length == 0 || rpgData.slots == null || rpgData.slots.Length == 0)
			{
				Plugin.Log.LogError((object)"rpg.override.json is invalid, falling back to built-in RPG data.");
				rpgData = Json.Deserialize<RpgData>(text);
			}
			else
			{
				RpgData rpgData2 = Json.Deserialize<RpgData>(text);
				if (rpgData.attributeVersion < rpgData2.attributeVersion)
				{
					Plugin.Log.LogWarning((object)($"rpg.override.json is for the old attributes (v{rpgData.attributeVersion}, now v{rpgData2.attributeVersion}); " + "ignoring it. Copy rpg.default.json again and re-apply your changes."));
					rpgData = rpgData2;
				}
			}
			RpgData rpgData3 = rpgData;
			if (rpgData3.attributes == null)
			{
				rpgData3.attributes = Array.Empty<AttributeDef>();
			}
			rpgData3 = rpgData;
			if (rpgData3.uniques == null)
			{
				rpgData3.uniques = Array.Empty<UniqueDef>();
			}
			AttributeDef[] attributes = rpgData.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				string classId = "attribute " + attributeDef.id;
				AttributeDef attributeDef2 = attributeDef;
				ResolveAll(classId, attributeDef2.effects ?? (attributeDef2.effects = Array.Empty<EffectDef>()));
				attributeDef2 = attributeDef;
				if (attributeDef2.category == null)
				{
					attributeDef2.category = "";
				}
			}
			foreach (string item in ValidateAttributes(rpgData))
			{
				Plugin.Log.LogError((object)("[attributes] " + item));
			}
			UniqueDef[] uniques = rpgData.uniques;
			foreach (UniqueDef uniqueDef in uniques)
			{
				string classId2 = "unique " + uniqueDef.name;
				UniqueDef uniqueDef2 = uniqueDef;
				ResolveAll(classId2, uniqueDef2.effects ?? (uniqueDef2.effects = Array.Empty<EffectDef>()));
			}
			rpgData3 = rpgData;
			if (rpgData3.perks == null)
			{
				rpgData3.perks = Array.Empty<PerkDef>();
			}
			rpgData3 = rpgData;
			if (rpgData3.upgrades == null)
			{
				rpgData3.upgrades = Array.Empty<UpgradeDef>();
			}
			UpgradeDef[] upgrades = rpgData.upgrades;
			foreach (UpgradeDef upgradeDef in upgrades)
			{
				string classId3 = "upgrade " + upgradeDef.key;
				UpgradeDef upgradeDef2 = upgradeDef;
				ResolveAll(classId3, upgradeDef2.effects ?? (upgradeDef2.effects = Array.Empty<EffectDef>()));
			}
			PerkDef[] perks = rpgData.perks;
			foreach (PerkDef perkDef in perks)
			{
				string classId4 = "perk " + perkDef.id;
				PerkDef perkDef2 = perkDef;
				ResolveAll(classId4, perkDef2.effects ?? (perkDef2.effects = Array.Empty<EffectDef>()));
			}
			if (rpgData.blessings == null || rpgData.blessings.Length == 0 || rpgData.curses == null || rpgData.curses.Length == 0)
			{
				RpgData rpgData4 = Json.Deserialize<RpgData>(text);
				RpgData rpgData5 = rpgData;
				perks = rpgData.blessings;
				rpgData5.blessings = ((perks != null && perks.Length > 0) ? rpgData.blessings : (rpgData4.blessings ?? Array.Empty<PerkDef>()));
				RpgData rpgData6 = rpgData;
				perks = rpgData.curses;
				rpgData6.curses = ((perks != null && perks.Length > 0) ? rpgData.curses : (rpgData4.curses ?? Array.Empty<PerkDef>()));
			}
			perks = rpgData.blessings;
			foreach (PerkDef perkDef3 in perks)
			{
				string classId5 = "blessing " + perkDef3.id;
				PerkDef perkDef2 = perkDef3;
				ResolveAll(classId5, perkDef2.effects ?? (perkDef2.effects = Array.Empty<EffectDef>()));
			}
			perks = rpgData.curses;
			foreach (PerkDef perkDef4 in perks)
			{
				string classId6 = "curse " + perkDef4.id;
				PerkDef perkDef2 = perkDef4;
				ResolveAll(classId6, perkDef2.effects ?? (perkDef2.effects = Array.Empty<EffectDef>()));
			}
			SlotDef[] slots = rpgData.slots;
			foreach (SlotDef slotDef in slots)
			{
				SlotDef slotDef2 = slotDef;
				if (slotDef2.bases == null)
				{
					slotDef2.bases = new string[1] { slotDef.name };
				}
				slotDef2 = slotDef;
				if (slotDef2.desc == null)
				{
					slotDef2.desc = "";
				}
				slotDef2 = slotDef;
				if (slotDef2.affixes == null)
				{
					slotDef2.affixes = Array.Empty<AffixDef>();
				}
				AffixDef[] affixes = slotDef.affixes;
				foreach (AffixDef affixDef in affixes)
				{
					if (StatInfo.Parse(affixDef.stat) < 0)
					{
						Plugin.Log.LogWarning((object)("[slot " + slotDef.id + "] Unknown affix stat '" + affixDef.stat + "'."));
					}
				}
			}
			return rpgData;
		}

		public static void ResolveAll(string classId, EffectDef[] effects)
		{
			foreach (EffectDef effectDef in effects)
			{
				effectDef.StatIndex = StatInfo.Parse(effectDef.stat ?? "");
				if (effectDef.StatIndex < 0 && (effectDef.stat ?? "").IndexOf('.') < 0)
				{
					Plugin.Log.LogWarning((object)("[" + classId + "] Unknown stat '" + effectDef.stat + "' ignored."));
				}
			}
		}

		internal static string ReadEmbedded(string stem)
		{
			using Stream stream = typeof(ClassDatabase).Assembly.GetManifestResourceStream("RepoRPG." + stem + ".json") ?? throw new InvalidOperationException("Embedded " + stem + ".json missing from build.");
			using StreamReader streamReader = new StreamReader(stream);
			return streamReader.ReadToEnd();
		}

		public static int TierUnlockLevel(int tier)
		{
			int value = Plugin.Cfg.MaxLevel.Value;
			int num = Math.Max(1, (value - 5) / 4);
			return 1 + (tier - 1) * num;
		}

		public static NodeDef? RequiredNode(ClassDef c, BranchDef b, NodeDef n)
		{
			if (!string.IsNullOrEmpty(n.requires))
			{
				BranchDef[] branches = c.branches;
				for (int i = 0; i < branches.Length; i++)
				{
					NodeDef[] nodes = branches[i].nodes;
					foreach (NodeDef nodeDef in nodes)
					{
						if (nodeDef.id == n.requires)
						{
							return nodeDef;
						}
					}
				}
			}
			return PreviousNode(b, n);
		}

		public static int UnlockLevel(NodeDef n)
		{
			if (n.unlockLevel <= 0)
			{
				return TierUnlockLevel(n.tier);
			}
			return Math.Min(n.unlockLevel, Plugin.Cfg.MaxLevel.Value);
		}

		private static string Underlying(ClassDef c, string stat)
		{
			if (stat.IndexOf('.') < 0)
			{
				return stat;
			}
			ActiveMods mods = c.active.mods;
			if (stat == mods.power)
			{
				return c.id + ":ability power";
			}
			if (stat == mods.duration)
			{
				return c.id + ":ability duration";
			}
			if (stat == mods.area)
			{
				return c.id + ":ability area";
			}
			if (stat == mods.cooldown)
			{
				return c.id + ":ability cooldown";
			}
			if (stat == mods.charges)
			{
				return c.id + ":ability charges";
			}
			RiderDef[] riders = c.active.riders;
			foreach (RiderDef riderDef in riders)
			{
				if (riderDef.stat == stat)
				{
					if (!(riderDef.action != ""))
					{
						return "stat " + riderDef.buff;
					}
					return "action " + riderDef.action;
				}
			}
			return stat;
		}

		public static List<string> ValidateAttributes(RpgData data)
		{
			List<string> list = new List<string>();
			AttributeDef[] attributes = data.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				EffectDef[] effects = attributeDef.effects;
				foreach (EffectDef effectDef in effects)
				{
					string text = effectDef.stat ?? "";
					if (SignatureStats.Contains(text))
					{
						list.Add("attribute " + attributeDef.name + " gives class signature stat " + text);
					}
					else if (text.IndexOf('.') >= 0)
					{
						list.Add("attribute " + attributeDef.name + " gives class-only stat " + text);
					}
					else if (effectDef.StatIndex < 0)
					{
						list.Add("attribute " + attributeDef.name + ": unknown stat " + text);
					}
				}
			}
			return list;
		}

		public static List<string> ValidateExclusive(IEnumerable<ClassDef> classes)
		{
			List<string> problems = new List<string>();
			Dictionary<string, (string cls, string node)> owner = new Dictionary<string, (string, string)>();
			foreach (ClassDef @class in classes)
			{
				if (@class.branches.Length != 3)
				{
					problems.Add($"{@class.id} has {@class.branches.Length} trees (needs 3)");
				}
				BranchDef[] branches = @class.branches;
				for (int i = 0; i < branches.Length; i++)
				{
					NodeDef[] nodes = branches[i].nodes;
					foreach (NodeDef nodeDef in nodes)
					{
						EffectDef[] effects = nodeDef.effects;
						foreach (EffectDef effectDef in effects)
						{
							string text = effectDef.stat ?? "";
							if (SharedStats.Contains(text))
							{
								problems.Add(@class.id + " '" + nodeDef.name + "' uses shared stat " + text);
							}
							else if (text.IndexOf('.') >= 0)
							{
								if (!text.StartsWith(@class.id + "."))
								{
									problems.Add(@class.id + " '" + nodeDef.name + "' uses another class's stat " + text);
								}
								string text2 = Underlying(@class, text);
								if (text2 == text && !CodeStats.Contains(text) && Array.IndexOf(@class.mechanics, text) < 0)
								{
									problems.Add(@class.id + " '" + nodeDef.name + "': " + text + " does nothing (not an ability stat, rider or known mechanic)");
								}
								Claim(text2, @class, nodeDef.name);
							}
							else if (effectDef.StatIndex < 0)
							{
								problems.Add(@class.id + " '" + nodeDef.name + "': unknown stat " + text);
							}
							else
							{
								Claim(text, @class, nodeDef.name);
							}
						}
					}
				}
				RiderDef[] riders = @class.active.riders;
				foreach (RiderDef riderDef in riders)
				{
					Claim((riderDef.action != "") ? ("action " + riderDef.action) : ("stat " + riderDef.buff), @class, @class.active.name + " rider");
				}
			}
			return problems;
			void Claim(string effect, ClassDef c, string where)
			{
				if (owner.TryGetValue(effect, out (string, string) value) && value.Item1 != c.id)
				{
					problems.Add("'" + effect + "' is in " + value.Item1 + " (" + value.Item2 + ") and " + c.id + " (" + where + ")");
				}
				else if (!owner.ContainsKey(effect))
				{
					owner[effect] = (c.id, where);
				}
			}
		}

		public static NodeDef? PreviousNode(BranchDef b, NodeDef n)
		{
			NodeDef result = null;
			NodeDef[] nodes = b.nodes;
			foreach (NodeDef nodeDef in nodes)
			{
				if (nodeDef == n)
				{
					return result;
				}
				result = nodeDef;
			}
			return null;
		}

		public static RankBlock CanRankUp(ClassDef c, BranchDef b, NodeDef n, ClassProgress p)
		{
			if (p.RankOf(n.id) >= n.maxRank)
			{
				return RankBlock.Maxed;
			}
			if (Leveling.AvailablePoints(p) <= 0)
			{
				return RankBlock.NoPoints;
			}
			if (p.level < UnlockLevel(n))
			{
				return RankBlock.LevelTooLow;
			}
			NodeDef nodeDef = RequiredNode(c, b, n);
			if (nodeDef != null && p.RankOf(nodeDef.id) <= 0)
			{
				return RankBlock.NeedsPrevious;
			}
			return RankBlock.None;
		}
	}
