			{
				Net.SendClassAction(ClassHost.Act.CurseNoise, ((Component)val).transform.position, new float[1] { 14f * num }, 0, usesCharge: false);
			}
			if (GearStat("gear.charged") > 0f && _chargedLevel != RunInfo.LevelIndex && _cooldownEnd > Time.time)
			{
				_chargedLevel = RunInfo.LevelIndex;
				_cooldownEnd -= CooldownSeconds() * 0.3f;
			}
			if (GearStat("gear.free_first") > 0f && _freeFirstLevel != RunInfo.LevelIndex)
			{
				_freeFirstLevel = RunInfo.LevelIndex;
				RefundCharge();
				Toast("Chrono Core: that one was free", new Color(1f, 0.74f, 0.22f));
			}
		}

