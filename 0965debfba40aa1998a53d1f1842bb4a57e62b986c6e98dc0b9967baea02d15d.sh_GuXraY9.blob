		public static string[] HostBorrowList(int asker)
		{
			List<string> list = new List<string>();
			if ((asker != ClassClaims.LocalActor || !Game.IsMultiplayer()) && Game.IsMultiplayer())
			{
				list.Add(Game.Get(Game.LocalPlayer(), "playerName", "Host") + "|" + string.Join(",", Research.Mine.done));
			}
			foreach (KeyValuePair<int, List<string>> item in Research.AllReported)
			{
				if (item.Key != asker && list.Count < 24)
				{
					list.Add(ClassClaims.NameOf(item.Key) + "|" + string.Join(",", item.Value));
				}
			}
			return list.ToArray();
		}

