		private void RebuildOwned(RunSave run)
		{
			(int, int, int, int, int) tuple = (run.perks.Count, run.evolved.Count, _perkSort, Perks.CursedOn ? 1 : 0, (run.perks.Count > 0) ? run.perks[run.perks.Count - 1].GetHashCode() : 0);
			(int, int, int, int, int) tuple2 = tuple;
			(int, int, int, int, int) ownedKey = _ownedKey;
			if (tuple2.Item1 == ownedKey.Item1 && tuple2.Item2 == ownedKey.Item2 && tuple2.Item3 == ownedKey.Item3 && tuple2.Item4 == ownedKey.Item4 && tuple2.Item5 == ownedKey.Item5)
			{
				return;
			}
			_ownedKey = tuple;
			Account.SeePerks(run.perks);
			_ownedList.Clear();
			foreach (string perk in run.perks)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(perk);
				if (perkDef != null)
				{
					_ownedList.Add(perkDef);
				}
			}
			if (_perkSort == 0)
			{
				_ownedList.Sort((PerkDef a, PerkDef b) => (a.rarity == b.rarity) ? string.CompareOrdinal(a.name, b.name) : b.rarity.CompareTo(a.rarity));
			}
			else if (_perkSort == 1)
			{
				_ownedList.Sort(delegate(PerkDef a, PerkDef b)
				{
					string strA = ((a.tags.Length != 0) ? a.tags[0] : "~");
					string strB = ((b.tags.Length != 0) ? b.tags[0] : "~");
					int num = string.CompareOrdinal(strA, strB);
					return (num == 0) ? string.CompareOrdinal(a.name, b.name) : num;
				});
			}
		}

