		private void PendingActs(string summary, bool has, bool busy, Action confirm, Action reset)
		{
			bool flag = has && !busy;
			BarAct("Undo", BtnKind.Secondary, flag && CanUndo, UndoLast, right: true, "Nothing to undo.");
			BarAct("Reset", BtnKind.Secondary, flag, reset, right: true, "Nothing to reset.");
			BarAct(busy ? "Applying..." : "Confirm", BtnKind.Primary, flag, confirm, right: true, "Nothing to confirm yet.");
			BarNote(summary);
		}

		private void BarAct(string label, BtnKind kind, bool enabled, Action run, bool right = false, string why = "")
		{
