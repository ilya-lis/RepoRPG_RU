				("Ascension", cfg.HudChipAscension, item),
				("Crew level", cfg.HudChipCrew, item),
				("Payout tier", cfg.HudChipPayout, item),
				("Map modifier", cfg.HudChipMapMod, item),
				("Route", cfg.HudChipRoute, flag),
				("Points to spend", cfg.HudChipPoints, flag),
