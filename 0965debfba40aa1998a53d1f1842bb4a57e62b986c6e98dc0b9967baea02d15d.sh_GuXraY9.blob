				{
					SwitchTabTo(num2);
				}
				FocusNotice(actionNotice);
			}
			else
			{
				Toast(actionNotice.Title + " → " + TabPath(actionNotice.Tab) + "  ([" + MenuPrompt + "] to open)", NoticeColor(actionNotice), 2.5f);
			}
		}

