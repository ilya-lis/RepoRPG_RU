				foreach (string buttonName in Pad.ButtonNames)
				{
					if (Pad.Held(buttonName))
					{
						flag = true;
						break;
					}
				}
				if (!flag)
				{
					_padCaptureArmed = true;
				}
				else if (Time.unscaledTime - _rebindStarted > 6f)
				{
					_rebind = Rebind.None;
				}
