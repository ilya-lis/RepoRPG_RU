		private void TickThirdWave(List<PlayerAvatar> players, float now)
		{
			RefreshScene3();
			TickEnteredRooms(players, now);
			TickEchoes(now);
			TickRestorers(players, now);
			TickScavengers(players, now);
			TickPolicies(now);
			TickSensors(now);
			TickPacified(now);
			TickCourier(players, now);
			TickFights(players, now);
			TickSynergiesHost(players, now);
			TeamPlay.TickHost(now);
		}

		private void ThirdWaveLevelStart()
		{
			foreach (Pacified item in _pacified)
			{
				EndCalm(item, woke: true);
			}
			_pacified.Clear();
			_calmSeen.Clear();
			CourierLevelStart();
			FightsLevelStart();
			_books.Clear();
			_scavenged.Clear();
			_searchedHinges.Clear();
			_rummaged.Clear();
			_finds.Clear();
			_hingeClosed.Clear();
			_pendingFinds.Clear();
			_policies.Clear();
			_haulCredit = 0f;
			_sensors.Clear();
			_echoes.Clear();
			_entered.Clear();
			_enteredAt.Clear();
			_throwAt.Clear();
			_hinges = Array.Empty<PhysGrabHinge>();
			_nextScene3 = 0f;
			Overclocks.Clear();
			GunTuner.Reset();
			OverclockWeapons.Reset();
			_pingedAt.Clear();
			_stunnedAt.Clear();
			_sheepUntil.Clear();
			_nextWagon = 0f;
			_nextCartScan = 0f;
			Synergies.NewLevel();
			TeamPlay.NewLevel();
			Bosses.NewLevel();
			Crafting.NewLevel();
			TeamContracts.NewLevel();
			ContractHost.NewLevel();
		}

		public string StateCounts()
		{
			return $"ledger {_books.Count}, finds {_scavenged.Count}/{_pendingFinds.Count}, hinges {_hingeClosed.Count}, dispatches {_dispatches.Count}, pad {_padItems.Count}, policies {_policies.Count}, " + $"sensors {_sensors.Count}, echoes {_echoes.Count}, fights {_fights.Count}, pacified {_pacified.Count}, sightings {_calmSeen.Count}, rooms {_entered.Count}, " + $"bets {_bets.Count}, fields {_fields.Count}, floats {_floats.Count}, thrown {_thrown.Count}, overclocks {Overclocks.Count}";
		}

		public void OnSceneChanged()
		{
			ThirdWaveLevelStart();
		}

		private void ThirdWavePlayerLeft(int actor)
		{
			_dispatches.RemoveAll((Dispatched d) => d.Owner == actor);
			_sensors.RemoveAll((Sensor s) => s.Owner == actor);
			_policies.RemoveAll((Policy p) => p.Owner == actor);
			Overclocks.Remove(actor);
			_throwAt.Remove(actor);
			Synergies.PlayerLeft(actor);
		}

