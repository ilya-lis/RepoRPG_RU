			ClassTabStart = c.Bind<ClassTabStartView>("Interface", "ClassTabOpensOn", ClassTabStartView.Talents, "Class tab: what the right side opens on - Talents (the trees), TalentsWhenPoints (the trees when you have skill points, else as you left it), or Overview (Total Effects). The class column is always shown.");
			MenuClassViewKey = c.Bind<KeyCode>("Controls", "MenuClassView", (KeyCode)118, "Class tab: switch between the talent trees and Total Effects.");
