		private int DeathSavesUsedThisLevel
		{
			get
			{
				RunSave data = _store.Data;
				int levelIndex = RunInfo.LevelIndex;
				if (data.deathSavesLevel != levelIndex)
				{
					bool flag = _deathSavesTagged == data && levelIndex > data.deathSavesLevel;
					if (data.deathSavesLevel != -1 && !flag)
					{
						data.deathSavesUsed = 0;
					}
					data.deathSavesLevel = levelIndex;
				}
				_deathSavesTagged = data;
				return data.deathSavesUsed;
			}
		}

		private int DeathSavesLeft
		{
			get
			{
				int num = Mathf.Max(0, Mathf.FloorToInt(_stats[Stat.DeathSaves]) + _notTodaySaves - DeathSavesUsedThisLevel - (Bosses.IsBossLevel(RunInfo.LevelIndex) ? Ascension.BossLevelSaves : 0));
				if (Difficulty.Hardcore)
				{
					num = Mathf.Min(num, Mathf.Max(0, Difficulty.SaveCost - DeathSavesUsedThisLevel));
				}
				return num / Difficulty.SaveCost;
			}
		}

