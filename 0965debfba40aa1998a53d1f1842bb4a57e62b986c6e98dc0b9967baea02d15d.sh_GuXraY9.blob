			string text = ResCrewText();
			if (text != "")
			{
				float num = ((Rect)(ref area)).width - 24f;
				float num2 = TextH(text, _small, num);
				Rect r = default(Rect);
				((Rect)(ref r))..ctor(((Rect)(ref area)).x, y, ((Rect)(ref area)).width, num2 + 24f);
				Box(r);
				Label(new Rect(((Rect)(ref r)).x + 12f, ((Rect)(ref r)).y + 12f, num, num2 + 2f), text, _small);
				y = ((Rect)(ref r)).yMax + 8f;
			}
			if (Research.Has("gear_exchange") || _tradeState == 1)
			{
				y = DrawGearExchange(area, y);
			}
			return y;
		}

		private void ClearTrade()
		{
			_tradeState = 0;
			_tradeId = 0;
			_tradeOtherName = "";
			_tradeItemText = "";
		}

		private string TradeItemText(GearItem g)
		{
			if (_tradeText.TryGetValue(g.uid, out string value))
			{
				return value;
			}
			RarityDef rarityDef = Gear.Rarity(g.rarity);
			value = "<color=" + rarityDef.color + "><b>" + rarityDef.name + " " + g.name + "</b></color> <color=#9a9ca0>(" + Gear.SlotName(g.slot) + ")</color>  " + Gear.Describe(g);
			if (g.unique != "")
			{
				value += "  <b>UNIQUE</b>";
			}
			if (g.modules != null && g.modules.Length != 0)
			{
				int num = 0;
				string[] modules = g.modules;
				for (int i = 0; i < modules.Length; i++)
				{
					if (!string.IsNullOrEmpty(modules[i]))
					{
						num++;
					}
				}
				if (num > 0)
				{
					value += string.Format("  <color=#9a9ca0>+{0} module{1} (they go with it)</color>", num, (num == 1) ? "" : "s");
				}
			}
			if (_tradeText.Count > 64)
			{
				_tradeText.Clear();
			}
			_tradeText[g.uid] = value;
			return value;
		}

		private static bool Tradable(RunSave run, GearItem g)
		{
			if (!run.IsEquipped(g) && !Starters.Is(g))
			{
				return !GearX.Soulbound(g);
			}
			return false;
		}

