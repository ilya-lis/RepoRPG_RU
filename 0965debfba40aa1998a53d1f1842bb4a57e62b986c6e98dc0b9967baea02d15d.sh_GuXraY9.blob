		private void RefreshHostStatus(bool locked)
		{
			bool flag = _presetNote != "" && Time.unscaledTime < _presetNoteUntil;
			int count = _hostPending.Count;
			int scheduled = HostSettings.Scheduled;
			int presetCount = HostSettings.PresetCount;
			StringBuilder sb;
			if (count != _stCount || scheduled != _stSched || (object)_loadedPreset != _stName || _presetApplied != _stApplied || locked != _stLocked || flag != _stNote || presetCount != _stPresets || _presetsOpen != _stOpen)
			{
				_stCount = count;
				_stSched = scheduled;
				_stName = _loadedPreset;
				_stApplied = _presetApplied;
				_stLocked = locked;
				_stNote = flag;
				_stPresets = presetCount;
				_stOpen = _presetsOpen;
				_applyLabel = ((count > 0) ? $"Apply ({count})" : "Apply");
				_presetsLabel = (_presetsOpen ? "Hide presets" : $"Presets ({presetCount}) ▾");
				sb = new StringBuilder();
				if (flag)
				{
					Part(_presetNoteGood ? ("<color=#8cf2bf>" + _presetNote + "</color>") : ("<color=#ff9999>" + _presetNote + "</color>"));
				}
				string text = ((count == 1) ? "1 change" : $"{count} changes");
				if (_loadedPreset != "" && count > 0)
				{
					Part("<color=#ffcc66>Preset '" + _loadedPreset + "': " + text + " pending - press Apply</color>");
				}
				else if (_loadedPreset != "")
				{
					Part("<color=#8cf2bf>Preset '" + _loadedPreset + "' loaded</color>");
				}
				else if (count > 0)
				{
					Part("<color=#ffcc66>" + text + " pending - press Apply</color>");
				}
				if (locked)
				{
					Part("<color=#ffcc66>Can't apply while a level is loading or changing</color>");
				}
				else if (scheduled > 0)
				{
					Part($"<color=#ffcc66>{scheduled} waiting for the next level / run</color>");
				}
				_hostStatus = sb.ToString();
			}
			void Part(string s)
			{
				if (sb.Length > 0)
				{
					sb.Append("  ·  ");
				}
				sb.Append(s);
			}
		}

		public void PresetNote(string text, bool good, float seconds = 4f)
		{
			_presetNote = text;
			_presetNoteGood = good;
			_presetNoteUntil = Time.unscaledTime + seconds;
			_stCount = -1;
		}

		public void OnDefaultPresetApplied(string name, int changes)
		{
			//IL_006d: Unknown result type (might be due to invalid IL or missing references)
			_loadedPreset = name;
			_presetApplied = true;
			PresetNote(string.Format("Default preset '{0}' applied ({1} change{2})", name, changes, (changes == 1) ? "" : "s"), good: true, 8f);
			Notify(PopupKind.Other, string.Format("Default preset '{0}' applied to your lobby ({1} change{2})", name, changes, (changes == 1) ? "" : "s"), (Color?)new Color(0.55f, 0.95f, 0.75f), "defaultpreset");
		}

