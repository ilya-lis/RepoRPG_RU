		private void HostCommit(ConfigEntryBase e, double d)
		{
			NumSpec spec = ActsOf(e).Spec;
			object obj = HostShown(e);
			if (obj is int || obj is float)
			{
				RangeNow(spec, Convert.ToDouble(obj, CultureInfo.InvariantCulture), out var lo, out var hi);
