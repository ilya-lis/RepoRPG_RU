					added++;
					flag = true;
					int num3 = ClassHost.ViewId((Component?)(object)poolItem.Obj);
					float num4 = Game.Get(poolItem.Obj, "dollarValueCurrent", poolItem.Value);
					if ((num3 == 0 || _ctScanned.Add(num3)) && !_scanCopied && CurrentId == "appraiser" && num4 > 0f)
