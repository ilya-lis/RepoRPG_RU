		private void TickEconSlowE()
		{
			RunSave data = _store.Data;
			ResearchEconSave researchEconSave = Econ(data);
			if (researchEconSave.futures.Count > 0 && RunShape.Cur.Seq > 0 && !Game.IsLoading())
			{
				for (int num = researchEconSave.futures.Count - 1; num >= 0; num--)
				{
					FuturesOrder futuresOrder = researchEconSave.futures[num];
					if (RunShape.Cur.Milestones > futuresOrder.at)
					{
						researchEconSave.futures.RemoveAt(num);
						GearItem gearItem = Gear.RollExact(new Random(), Mathf.Clamp(futuresOrder.rarity, 0, Gear.MaxRarity), null, allowUnique: false);
						gearItem.freeValue = 0;
						gearItem.scrapIn = Mathf.Max(0, futuresOrder.paid);
						GiveGear(gearItem, "Futures crate");
						_store.MarkDirty();
					}
				}
			}
			if (!researchEconSave.protoBought && researchEconSave.proto != null && (data.inventory.Exists((GearItem g) => ResearchEcon.IsProto(g)) || data.shopStock.Exists((ShopEntry e) => e.sold && ResearchEcon.IsProto(e.item))))
			{
				researchEconSave.protoBought = true;
				_store.MarkDirty();
			}
		}

