				{
					lines.Add((_tcVoted ? "VOTE SENT" : ("HOLD [" + KeyLabel(Plugin.Cfg.CallOutKey.Value) + "] TO ACCEPT, OR CONTRACTS TAB"), val));
				}
			}
		}

		private string TeamBoxBody()
		{
			TeamContractDef tcDef = _tcDef;
			string text = _tcState switch
			{
				0 => "VOTING: " + TeamVoteCount() + "  ·  " + (_tcBoardVote ? "closes when the level starts" : $"{Mathf.Max(0f, _tcVoteEnd - Time.time):0}s left") + "  ·  " + VoteRuleText(), 
				1 => IsTeamParticipant() ? "ACCEPTED - you're in" : "ACCEPTED - you joined after the vote: no reward, no loss", 
				2 => "<color=#73ff66>COMPLETE</color>", 
				3 => "<color=#ff6152>FAILED</color>", 
				_ => "<color=#9a9ca0>DECLINED - discarded: no reward, no stakes</color>", 
			};
			string text2 = TeamHaulLine();
			if (text2 != "" && (_tcState == 1 || _tcState == 0 || _tcState == 2 || _tcState == 3))
