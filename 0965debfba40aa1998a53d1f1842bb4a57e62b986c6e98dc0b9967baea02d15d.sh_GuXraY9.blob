		private void NavBack()
		{
			if (_osk)
			{
				_osk = false;
				_searchFocusReq = true;
				MenuSound(UiSound.Back);
				return;
			}
			if (_rebind != Rebind.None)
			{
				_rebind = Rebind.None;
				MenuSound(UiSound.Back);
				return;
			}
			if (_shopVote != "" && _tab < TabNames.Length && TabNames[_tab] == "Shop")
			{
				_shopVote = "";
				MenuSound(UiSound.Back);
				return;
			}
			int tabKey = ((_tab < _tabKeys.Length) ? _tabKeys[_tab] : 0);
			if (_padMode && tabKey != 0 && _focusKey != tabKey)
			{
				int num = _focusItems.FindIndex((FocusItem f) => f.Key == tabKey);
				if (num >= 0)
				{
					SetFocus(_focusItems[num]);
					MenuSound(UiSound.Back);
					return;
				}
			}
			SetMenuOpen(open: false);
		}

		private void SwitchTabTo(int t)
		{
			if (t != _tab && !_dialogOpen)
			{
				_tabFocus[_tab] = _focusKey;
				if (_tab < TabNames.Length && TabNames[_tab] == "Gear")
				{
					_newThisView.Clear();
				}
				_tab = t;
				NoteNavTab(t);
				if (TabNames[t] == "Class")
				{
					ResetClassView();
				}
				_tabSwitchedAt = Time.unscaledTime;
				_searching = false;
				CancelNumEdit();
				_osk = false;
				if (TabNames[t] == "Contracts" && RunReady)
				{
					_seenContractLevel = _store.Data.contractLevel;
					_seenBoardLevel = _store.Data.boardLevel;
				}
				_focusKey = (_tabFocus.TryGetValue(t, out var value) ? value : 0);
				_hasLastFocus = false;
				_adjustKey = 0;
				_adjDec = (_adjInc = (_adjConfirm = null));
				_secondaryKey = 0;
				_secondaryAction = null;
				MenuSound(UiSound.Tick);
			}
		}

