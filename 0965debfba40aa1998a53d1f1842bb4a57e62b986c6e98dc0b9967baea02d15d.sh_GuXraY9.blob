		public static string DebugNearest(Vector3 pos)
		{
			//IL_00ae: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b3: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b4: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b9: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.IsMaster())
			{
				return "host only";
			}
			if (!Research.On)
			{
				return "Research is off";
			}
			if (!Game.InLevel())
			{
				return "only in a level";
			}
			if (_level != RunInfo.LevelIndex)
			{
				_level = RunInfo.LevelIndex;
				Ids.Clear();
				Objs.Clear();
				Credited.Clear();
			}
			ValuableObject val = null;
			float num = float.MaxValue;
			Game.ValuableList.Enumerator enumerator = Game.Valuables().GetEnumerator();
			while (enumerator.MoveNext())
			{
				ValuableObject item = enumerator.Current.obj;
				if (!((Object)(object)item == (Object)null) && Pv((Component)(object)item) != 0 && !Ids.Contains(Pv((Component)(object)item)))
				{
					Vector3 val2 = ((Component)item).transform.position - pos;
					float sqrMagnitude = ((Vector3)(ref val2)).sqrMagnitude;
					if (sqrMagnitude < num)
					{
						num = sqrMagnitude;
						val = item;
					}
				}
			}
			if ((Object)(object)val == (Object)null)
			{
				return "no valuable found";
			}
			Net.SendSamples(RunInfo.LevelIndex, new int[1] { Pv((Component)(object)val) });
			Plugin.Log.LogInfo((object)$"[research] debug: {((Object)val).name} is a research sample ({Mathf.Sqrt(num):0.0} m away).");
			return "Research sample: " + ((Object)val).name.Replace("(Clone)", "").Replace("Valuable ", "") + $" ({Mathf.Sqrt(num):0} m)";
		}

		public static void HostAdd(GameObject go)
		{
			if (Game.IsMaster() && Research.On && !((Object)(object)go == (Object)null) && _level == RunInfo.LevelIndex)
			{
				int num = Pv((Component)(object)go.transform);
				if (num != 0 && !Ids.Contains(num))
				{
					Net.SendSamples(RunInfo.LevelIndex, new int[1] { num });
					Plugin.Log.LogInfo((object)"[research] a Scavenger's find is a research sample.");
				}
			}
		}
	}
	internal static class Haggle
	{
		private static readonly Dictionary<int, (string key, float mult, int level)> Done = new Dictionary<int, (string, float, int)>();

		public static float HostRoll(int actor, string key)
		{
			if (Done.TryGetValue(actor, out (string, float, int) value) && value.Item3 == RunInfo.LevelIndex)
			{
				if (!(value.Item1 == key))
				{
					return 0f;
				}
				return value.Item2;
			}
			float num = ((Random.value < 0.5f) ? 0.75f : 1.1f);
			Done[actor] = (key, num, RunInfo.LevelIndex);
			Plugin.Log.LogInfo((object)$"[research] haggle by actor {actor} on {key}: x{num:0.00}.");
			return num;
		}

		public static float HostMult(int actor, string key)
		{
			if (!Done.TryGetValue(actor, out (string, float, int) value) || value.Item3 != RunInfo.LevelIndex || !(value.Item1 == key))
			{
				return 1f;
			}
			return value.Item2;
		}
	}
