		public GuideSetting[] hostSettings = Array.Empty<GuideSetting>();

		public GuideStep[] walkthrough = Array.Empty<GuideStep>();

		public GuideTopic[] topics = Array.Empty<GuideTopic>();
	}
	internal static class Guide
	{
		public static GuideFile Data = new GuideFile();

		private static readonly Dictionary<string, GuideTopic> ById = new Dictionary<string, GuideTopic>();

		public static IReadOnlyList<GuideTopic> Topics => Data.topics;

		public static void Load()
		{
			ById.Clear();
			string text = ClassDatabase.ReadEmbedded("guide");
			GuideFile guideFile = null;
			try
			{
				guideFile = Json.Deserialize<GuideFile>(ClassDatabase.ReadWithOverride("guide", text));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("guide data parse error: " + ex.Message));
			}
			if (guideFile?.topics == null || guideFile.topics.Length == 0)
			{
				try
				{
					guideFile = Json.Deserialize<GuideFile>(text);
				}
				catch
				{
					guideFile = new GuideFile();
				}
			}
			Data = guideFile ?? new GuideFile();
			List<GuideTopic> list = new List<GuideTopic>();
			GuideTopic[] array = Data.topics ?? Array.Empty<GuideTopic>();
			foreach (GuideTopic guideTopic in array)
			{
				if (guideTopic == null || guideTopic.id == "" || ById.ContainsKey(guideTopic.id))
				{
					continue;
				}
				GuideTopic guideTopic2 = guideTopic;
				if (guideTopic2.blocks == null)
				{
					guideTopic2.blocks = Array.Empty<GuideBlock>();
				}
				StringBuilder stringBuilder = new StringBuilder();
				stringBuilder.Append(guideTopic.title).Append(' ').Append(guideTopic.keywords)
					.Append(' ')
					.Append(guideTopic.summary);
				GuideBlock[] blocks = guideTopic.blocks;
				foreach (GuideBlock guideBlock in blocks)
				{
					if (guideBlock == null)
					{
						continue;
					}
					GuideBlock guideBlock2 = guideBlock;
					if (guideBlock2.items == null)
					{
						guideBlock2.items = Array.Empty<string>();
					}
					guideBlock2 = guideBlock;
					if (guideBlock2.terms == null)
					{
						guideBlock2.terms = Array.Empty<GuideTerm>();
					}
					stringBuilder.Append(' ').Append(guideBlock.title).Append(' ')
						.Append(guideBlock.text);
					string[] items = guideBlock.items;
					foreach (string value in items)
					{
						stringBuilder.Append(' ').Append(value);
					}
					GuideTerm[] terms = guideBlock.terms;
					foreach (GuideTerm guideTerm in terms)
					{
						if (guideTerm != null)
						{
							stringBuilder.Append(' ').Append(guideTerm.term).Append(' ')
								.Append(guideTerm.meaning);
						}
					}
				}
				guideTopic.Haystack = stringBuilder.ToString().ToLowerInvariant();
				ById[guideTopic.id] = guideTopic;
				list.Add(guideTopic);
			}
			Data.topics = list.ToArray();
			GuideFile data = Data;
			if (data.walkthrough == null)
			{
				data.walkthrough = Array.Empty<GuideStep>();
			}
			data = Data;
			if (data.screens == null)
			{
				data.screens = Array.Empty<GuideScreen>();
			}
			data = Data;
			if (data.hostSettings == null)
			{
				data.hostSettings = Array.Empty<GuideSetting>();
			}
		}

		public static GuideTopic? Get(string id)
		{
			if (!ById.TryGetValue(id ?? "", out GuideTopic value))
			{
				return null;
			}
			return value;
		}

		public static string TopicForTab(string tab)
		{
			GuideScreen[] screens = Data.screens;
			foreach (GuideScreen guideScreen in screens)
			{
				if (guideScreen != null && string.Equals(guideScreen.tab, tab, StringComparison.OrdinalIgnoreCase))
				{
					return guideScreen.topic;
				}
			}
			if (Data.topics.Length == 0)
			{
				return "";
			}
			return Data.topics[0].id;
		}
	}
	internal static class Json
	{
		private sealed class Parser
		{
			private readonly string _s;

			private int _i;

			public Parser(string s)
			{
				_s = s ?? "";
				if (_s.Length > 0 && _s[0] == '\ufeff')
				{
					_i = 1;
				}
			}

			public object? ParseRoot()
			{
				object? result = Value();
				Ws();
				if (_i < _s.Length)
				{
					throw Err("Unexpected text after JSON");
				}
				return result;
			}

			private FormatException Err(string msg)
			{
				int num = 1;
				for (int i = 0; i < _i && i < _s.Length; i++)
				{
					if (_s[i] == '\n')
					{
						num++;
					}
				}
				return new FormatException($"{msg} (line {num})");
			}

			private void Ws()
			{
				while (_i < _s.Length && char.IsWhiteSpace(_s[_i]))
				{
					_i++;
				}
			}

			private object? Value()
			{
				Ws();
				if (_i >= _s.Length)
				{
					throw Err("Unexpected end of JSON");
				}
				char c = _s[_i];
				switch (c)
				{
				case '{':
					return Obj();
				case '[':
					return Arr();
				case '"':
					return Str();
				case 't':
					if (Match("true"))
					{
						return true;
					}
					break;
				}
				if (c == 'f' && Match("false"))
				{
					return false;
				}
				if (c == 'n' && Match("null"))
				{
					return null;
				}
				return Num();
			}

			private bool Match(string word)
			{
				if (string.CompareOrdinal(_s, _i, word, 0, word.Length) != 0)
				{
					return false;
				}
				_i += word.Length;
				return true;
			}

			private Dictionary<string, object?> Obj()
			{
				Dictionary<string, object> dictionary = new Dictionary<string, object>();
				_i++;
				Ws();
				if (_i < _s.Length && _s[_i] == '}')
				{
					_i++;
					return dictionary;
				}
				while (true)
				{
					Ws();
					if (_i >= _s.Length || _s[_i] != '"')
					{
						throw Err("Expected a property name");
					}
					string key = Str();
					Ws();
					if (_i >= _s.Length || _s[_i] != ':')
					{
						throw Err("Expected ':'");
					}
					_i++;
					dictionary[key] = Value();
					Ws();
					if (_i >= _s.Length)
					{
						throw Err("Unterminated object");
					}
					if (_s[_i] != ',')
					{
						break;
					}
					_i++;
				}
				if (_s[_i] == '}')
				{
					_i++;
					return dictionary;
				}
				throw Err("Expected ',' or '}'");
			}

			private List<object?> Arr()
			{
				List<object> list = new List<object>();
				_i++;
				Ws();
				if (_i < _s.Length && _s[_i] == ']')
				{
					_i++;
					return list;
				}
				while (true)
				{
					list.Add(Value());
					Ws();
					if (_i >= _s.Length)
					{
						throw Err("Unterminated array");
					}
					if (_s[_i] != ',')
					{
						break;
					}
					_i++;
				}
				if (_s[_i] == ']')
				{
					_i++;
					return list;
				}
				throw Err("Expected ',' or ']'");
			}

			private string Str()
			{
				StringBuilder stringBuilder = new StringBuilder();
				_i++;
				while (_i < _s.Length)
				{
					char c = _s[_i++];
					switch (c)
					{
					case '"':
						return stringBuilder.ToString();
					default:
						stringBuilder.Append(c);
						continue;
					case '\\':
						break;
					}
					if (_i >= _s.Length)
					{
						break;
					}
					char c2 = _s[_i++];
					switch (c2)
					{
					case '"':
						stringBuilder.Append('"');
						break;
					case '\\':
						stringBuilder.Append('\\');
						break;
					case '/':
						stringBuilder.Append('/');
						break;
					case 'b':
						stringBuilder.Append('\b');
						break;
					case 'f':
						stringBuilder.Append('\f');
						break;
					case 'n':
						stringBuilder.Append('\n');
						break;
					case 'r':
						stringBuilder.Append('\r');
						break;
					case 't':
						stringBuilder.Append('\t');
						break;
					case 'u':
						if (_i + 4 > _s.Length)
						{
							throw Err("Bad unicode escape");
						}
						stringBuilder.Append((char)int.Parse(_s.Substring(_i, 4), NumberStyles.HexNumber, CultureInfo.InvariantCulture));
						_i += 4;
						break;
					default:
						throw Err($"Bad escape '\\{c2}'");
					}
				}
				throw Err("Unterminated string");
			}

			private double Num()
			{
				int i = _i;
				while (_i < _s.Length && "+-0123456789.eE".IndexOf(_s[_i]) >= 0)
				{
					_i++;
				}
				if (i == _i)
				{
					throw Err($"Unexpected character '{_s[_i]}'");
				}
				if (!double.TryParse(_s.Substring(i, _i - i), NumberStyles.Float, CultureInfo.InvariantCulture, out var result))
				{
					throw Err("Bad number");
				}
				return result;
			}
		}

		public static T Deserialize<T>(string json) where T : new()
		{
			return (T)Convert(new Parser(json).ParseRoot(), typeof(T));
		}

		public static string Serialize(object? value, bool pretty = true)
		{
			StringBuilder stringBuilder = new StringBuilder();
			Write(stringBuilder, value, pretty, 0);
			return stringBuilder.ToString();
		}

		private static IEnumerable<FieldInfo> Fields(Type t)
		{
			FieldInfo[] fields = t.GetFields(BindingFlags.Instance | BindingFlags.Public);
			foreach (FieldInfo fieldInfo in fields)
			{
				if (!fieldInfo.IsNotSerialized && !fieldInfo.IsInitOnly)
				{
					yield return fieldInfo;
				}
			}
		}

		private static object? Convert(object? v, Type t)
		{
			if (v == null)
			{
				if (!t.IsValueType)
				{
					return null;
				}
				return Activator.CreateInstance(t);
			}
			if (t == typeof(string))
			{
				return (v as string) ?? System.Convert.ToString(v, CultureInfo.InvariantCulture);
			}
			if (t == typeof(object))
			{
				return v;
			}
			if (t.IsEnum)
			{
				if (v is string value)
				{
					return Enum.Parse(t, value, ignoreCase: true);
				}
				return Enum.ToObject(t, System.Convert.ToInt64(v, CultureInfo.InvariantCulture));
			}
			if (t == typeof(bool))
			{
				return (v is bool flag) ? flag : System.Convert.ToBoolean(v, CultureInfo.InvariantCulture);
			}
			if (t.IsPrimitive || t == typeof(decimal))
			{
				return System.Convert.ChangeType((v is bool flag2) ? ((object)(flag2 ? 1 : 0)) : v, t, CultureInfo.InvariantCulture);
			}
			if (t.IsArray)
			{
				Type elementType = t.GetElementType();
				List<object> list = (v as List<object>) ?? new List<object>();
				Array array = Array.CreateInstance(elementType, list.Count);
				for (int i = 0; i < list.Count; i++)
				{
					array.SetValue(Convert(list[i], elementType), i);
				}
				return array;
			}
			if (t.IsGenericType && t.GetGenericTypeDefinition() == typeof(List<>))
			{
				Type t2 = t.GetGenericArguments()[0];
				IList list2 = (IList)Activator.CreateInstance(t);
				if (v is List<object> list3)
				{
					foreach (object item in list3)
					{
						list2.Add(Convert(item, t2));
					}
				}
				return list2;
			}
			if (!(v is Dictionary<string, object> dictionary))
			{
				return Activator.CreateInstance(t);
			}
			object obj = Activator.CreateInstance(t);
			foreach (FieldInfo item2 in Fields(t))
			{
				if (dictionary.TryGetValue(item2.Name, out var value2))
				{
					try
					{
						item2.SetValue(obj, Convert(value2, item2.FieldType));
					}
					catch (Exception ex)
					{
						throw new FormatException("Field '" + t.Name + "." + item2.Name + "': " + ex.Message);
					}
				}
			}
			return obj;
		}

		private static void Write(StringBuilder sb, object? v, bool pretty, int depth)
		{
			if (v != null)
			{
				if (!(v is string s))
				{
					if (!(v is bool flag))
					{
						if (!(v is float num))
						{
							if (!(v is double num2))
							{
								if (v is Enum value)
								{
									sb.Append(System.Convert.ToInt64(value, CultureInfo.InvariantCulture));
									return;
								}
								Type type = v.GetType();
								if (type.IsPrimitive || type == typeof(decimal))
								{
									sb.Append(System.Convert.ToString(v, CultureInfo.InvariantCulture));
									return;
								}
								if (v is IEnumerable enumerable)
								{
									sb.Append('[');
									bool flag2 = true;
									foreach (object item in enumerable)
									{
										if (!flag2)
										{
											sb.Append(',');
										}
										flag2 = false;
										Newline(sb, pretty, depth + 1);
										Write(sb, item, pretty, depth + 1);
									}
									if (!flag2)
									{
										Newline(sb, pretty, depth);
									}
									sb.Append(']');
									return;
								}
								sb.Append('{');
								bool flag3 = true;
								foreach (FieldInfo item2 in Fields(type))
								{
									if (!flag3)
									{
										sb.Append(',');
									}
									flag3 = false;
									Newline(sb, pretty, depth + 1);
									WriteString(sb, item2.Name);
									sb.Append(pretty ? ": " : ":");
									Write(sb, item2.GetValue(v), pretty, depth + 1);
								}
								if (!flag3)
								{
									Newline(sb, pretty, depth);
								}
								sb.Append('}');
							}
							else
							{
								sb.Append(num2.ToString("R", CultureInfo.InvariantCulture));
							}
						}
						else
						{
							sb.Append(num.ToString("R", CultureInfo.InvariantCulture));
						}
					}
					else
					{
						sb.Append(flag ? "true" : "false");
					}
				}
				else
				{
					WriteString(sb, s);
				}
			}
			else
			{
				sb.Append("null");
			}
		}

		private static void Newline(StringBuilder sb, bool pretty, int depth)
		{
			if (pretty)
			{
				sb.Append('\n').Append(' ', depth * 2);
			}
		}

		private static void WriteString(StringBuilder sb, string s)
		{
			sb.Append('"');
			foreach (char c in s)
			{
				switch (c)
				{
				case '"':
					sb.Append("\\\"");
					continue;
				case '\\':
					sb.Append("\\\\");
					continue;
				case '\n':
					sb.Append("\\n");
					continue;
				case '\r':
					sb.Append("\\r");
					continue;
				case '\t':
					sb.Append("\\t");
					continue;
				}
				if (c < ' ')
				{
					StringBuilder stringBuilder = sb.Append("\\u");
					int num = c;
					stringBuilder.Append(num.ToString("x4"));
				}
				else
				{
					sb.Append(c);
				}
			}
			sb.Append('"');
		}
	}
