				(string, KeyCode)[] array = new(string, KeyCode)[9]
				{
					("open the menu", cfg.MenuKey.Value),
					("use your ability", cfg.AbilityKey.Value),
					("Herald hum", cfg.HumKey.Value),
					("Quartermaster hand-off", cfg.HandOffKey.Value),
					("Mimic swap", cfg.MimicSwapKey.Value),
					("Cartwright cart follow", cfg.CartFollowKey.Value),
					("call out (death head)", cfg.CallOutKey.Value),
					("highlights card", cfg.HighlightsKey.Value),
					("next action-needed notice", cfg.NoticeCycleKey.Value)
				};
				Dictionary<string, string> dictionary = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
				foreach (var item3 in GameBindings(obj))
				{
					string item = item3.action;
					string item2 = item3.path;
					string text = (item2.StartsWith("<Keyboard>/", StringComparison.OrdinalIgnoreCase) ? item2.Substring(11) : "");
					if (text != "" && !dictionary.ContainsKey(text))
					{
						dictionary[text] = "the game's '" + item + "'";
					}
				}
				foreach (KeyValuePair<string, PluginInfo> pluginInfo in Chainloader.PluginInfos)
				{
					PluginInfo value = pluginInfo.Value;
					object obj2;
					if (value == null)
					{
						obj2 = null;
					}
					else
					{
						BaseUnityPlugin instance = value.Instance;
						obj2 = ((instance != null) ? instance.Config : null);
					}
					ConfigFile val = (ConfigFile)obj2;
					if (val == null || pluginInfo.Key == "rpgmod.semibotrpg")
					{
						continue;
					}
					PluginInfo value2 = pluginInfo.Value;
					object obj3;
					if (value2 == null)
					{
						obj3 = null;
					}
					else
					{
						BepInPlugin metadata = value2.Metadata;
						obj3 = ((metadata != null) ? metadata.Name : null);
					}
					if (obj3 == null)
					{
						obj3 = pluginInfo.Key;
					}
					string text2 = (string)obj3;
					foreach (ConfigDefinition key in val.Keys)
					{
						ConfigEntryBase val2 = val[key];
						string text3 = ((val2.BoxedValue is KeyCode k) ? KeyName(k) : ((!(val2.BoxedValue is KeyboardShortcut val3)) ? "" : ((((KeyboardShortcut)(ref val3)).Modifiers == null || !((KeyboardShortcut)(ref val3)).Modifiers.GetEnumerator().MoveNext()) ? KeyName(((KeyboardShortcut)(ref val3)).MainKey) : "")));
						if (text3 != "" && !dictionary.ContainsKey(text3))
						{
							dictionary[text3] = text2 + "'s '" + key.Key + "'";
						}
					}
				}
				List<string> list = new List<string>();
				(string, KeyCode)[] array2 = array;
				for (int i = 0; i < array2.Length; i++)
				{
					var (arg, val4) = array2[i];
					if (dictionary.TryGetValue(KeyName(val4), out var value3))
					{
						list.Add($"{val4} ({arg}) is also {value3}");
					}
				}
				if (list.Count == 0)
				{
					Plugin.Log.LogInfo((object)"[compat] keys: no RepoRPG key clashes with the game or another mod.");
				}
				else
				{
					Plugin.Log.LogWarning((object)("[compat] keys: " + string.Join("; ", list) + ". Change RepoRPG's on the Settings tab (Controls) if they get in the way."));
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogInfo((object)("[compat] keys: couldn't check (" + ex.Message + ")."));
			}
		}

		private static object? InputManagerInstance()
		{
			Type type = AccessTools.TypeByName("InputManager");
			if (!(type == null))
			{
				return AccessTools.Field(type, "instance")?.GetValue(null);
			}
			return null;
		}

		private static IEnumerable<(string action, string path)> GameBindings(object im)
		{
			FieldInfo[] fields = im.GetType().GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
			foreach (FieldInfo fieldInfo in fields)
			{
				object value;
				try
				{
					value = fieldInfo.GetValue(im);
				}
				catch
				{
					continue;
				}
				if (!(value is IDictionary dictionary))
				{
					continue;
				}
				foreach (object value2 in dictionary.Values)
				{
					InputAction a = (InputAction)((value2 is InputAction) ? value2 : null);
					if (a == null)
					{
						continue;
					}
					Enumerator<InputBinding> enumerator2 = a.bindings.GetEnumerator();
					try
					{
						while (enumerator2.MoveNext())
						{
							InputBinding current2 = enumerator2.Current;
							if (!((InputBinding)(ref current2)).isComposite && !string.IsNullOrEmpty(((InputBinding)(ref current2)).effectivePath))
							{
								yield return (action: a.name, path: ((InputBinding)(ref current2)).effectivePath);
							}
						}
					}
					finally
					{
						((IDisposable)enumerator2/*cast due to .constrained prefix*/).Dispose();
					}
				}
			}
		}

		private unsafe static string KeyName(KeyCode k)
		{
			//IL_0000: Unknown result type (might be due to invalid IL or missing references)
