		private void TickMigration()
		{
			//IL_005b: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f0: Unknown result type (might be due to invalid IL or missing references)
			//IL_0111: Unknown result type (might be due to invalid IL or missing references)
			if (Time.unscaledTime < _migrateTickAt)
			{
				return;
			}
			_migrateTickAt = Time.unscaledTime + 0.5f;
			if (ClassMigration.AccountNote != "" && (Game.InLobby() || Game.InShopLevel() || Game.InLevel()))
			{
				Notify(PopupKind.Other, ClassMigration.AccountNote, (Color?)new Color(1f, 0.82f, 0.35f), "migrate-account");
				ClassMigration.AccountNote = "";
			}
			if (RunReady)
			{
				RunSave data = _store.Data;
				if (data.migrationNote != "" && (Game.InLobby() || Game.InShopLevel()))
				{
					string text = data.migrationNote + $" You can keep it, or pick any other class once for free here: it starts at Lv {data.repickLevel} ({MenuPrompt}).";
					Banner("CLASS REPLACED - FREE RE-PICK", new Color(1f, 0.82f, 0.35f), 7f);
					Notify(PopupKind.Level, text, (Color?)new Color(1f, 0.82f, 0.35f), "migrate-run");
					MenuSound(UiSound.Confirm);
					data.migrationNote = "";
					data.repickSeen = true;
					_store.MarkDirty();
				}
				if (data.repickLevel > 0 && data.repickSeen && Game.InLevel())
				{
					data.repickLevel = 0;
					data.repickSeen = false;
					_store.MarkDirty();
					Plugin.Log.LogInfo((object)"[migrate] the free re-pick was not used (the next level started).");
				}
			}
		}

		private bool RepickSwitch(ClassDef target, out int toLevel)
		{
			toLevel = 0;
			RunSave data = _store.Data;
			if (data.repickLevel <= 0 || target == Current || (!Game.InLobby() && !Game.InShopLevel()))
			{
				return false;
			}
			ClassProgress classProgress = data.classes.Find((ClassProgress x) => x.classId == target.id);
			int num = Mathf.Clamp(data.repickLevel, 1, Leveling.MaxLevel);
			if (classProgress != null && classProgress.level >= num)
			{
				return false;
			}
			toLevel = num;
			return true;
		}

		public string PartsShort()
		{
			int[] parts = Parts;
			return $"{Crafting.Short[0]}{parts[0]} {Crafting.Short[1]}{parts[1]} {Crafting.Short[2]}{parts[2]} {Crafting.Short[3]}{parts[3]}";
		}

		public void OnPartDrop(int id, Vector3 pos, int[] counts, float seconds)
		{
			//IL_0038: Unknown result type (might be due to invalid IL or missing references)
			//IL_0039: Unknown result type (might be due to invalid IL or missing references)
			//IL_008f: Unknown result type (might be due to invalid IL or missing references)
			//IL_00c0: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.InLevel() || counts == null || counts.Length < 4)
			{
				return;
			}
			if (_partDrops.Count >= 60)
			{
				_partDrops.Clear();
			}
			_partDrops[id] = new PartDrop
			{
				Pos = pos,
				Counts = counts,
				Until = Time.time + Mathf.Clamp(seconds, 5f, 600f)
			};
			int num = 0;
			for (int i = 0; i < 4; i++)
			{
				if (counts[i] > 0)
				{
					num = i;
				}
			}
			AddWorldMark("part:" + id, pos, Crafting.Names[num] + ((counts[0] + counts[1] + counts[2] + counts[3] > 1) ? " +" : ""), Crafting.Colors[num], seconds);
		}

		private void TickParts(PlayerAvatar local)
		{
			//IL_00a9: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b0: Unknown result type (might be due to invalid IL or missing references)
			//IL_00b5: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ba: Unknown result type (might be due to invalid IL or missing references)
			if (_partDrops.Count == 0 || Time.time < _nextPartCheck)
			{
				return;
			}
			_nextPartCheck = Time.time + 0.25f;
			if (!Game.IsAlive(local) || !Game.InLevel() || Game.IsLoading())
			{
				return;
			}
			float time = Time.time;
			List<int> list = new List<int>();
			foreach (KeyValuePair<int, PartDrop> partDrop in _partDrops)
			{
				PartDrop value = partDrop.Value;
				if (time >= value.Until || value.Taken)
				{
					list.Add(partDrop.Key);
				}
				else
				{
					if (time - value.AskedAt < 5f)
					{
						continue;
					}
					Vector3 val = ((Component)local).transform.position - value.Pos;
					if (!(((Vector3)(ref val)).sqrMagnitude > 2.25f))
					{
						value.AskedAt = time;
						if (Game.IsMaster())
						{
							Crafting.HostTake(Game.ActorNumber(local), partDrop.Key);
						}
						else
						{
							Net.SendPartTake(partDrop.Key);
						}
					}
				}
			}
			foreach (int item in list)
			{
				_partDrops.Remove(item);
				RemoveWorldMark("part:" + item);
			}
		}

		public void OnPartGrant(int id, int[] counts, string reason)
		{
			if (id >= 0 && _partDrops.TryGetValue(id, out PartDrop value))
			{
				if (reason == "far")
				{
					value.AskedAt = Time.time - 4f;
					return;
				}
				value.Taken = true;
				RemoveWorldMark("part:" + id);
			}
			if (!(reason == "gone") && !(reason == "taken"))
			{
				AddParts(counts, reason);
			}
		}

		private void AddParts(int[] counts, string reason)
		{
			//IL_00a1: Unknown result type (might be due to invalid IL or missing references)
			if (!Plugin.Cfg.CraftingParts.Value || counts == null)
			{
				return;
			}
			int[] parts = Parts;
			bool flag = false;
			for (int i = 0; i < 4 && i < counts.Length; i++)
			{
				int num = Mathf.Clamp(counts[i], 0, 50);
				if (num > 0)
				{
					parts[i] = Mathf.Min(9999, parts[i] + num);
					flag = true;
				}
			}
			if (flag)
			{
				Notify(PopupKind.Loot, "+" + Crafting.Describe(counts) + ((reason != "" && reason != "pickup") ? (" (" + reason + ")") : ""), Crafting.Colors[1], "parts");
				_store.MarkDirty();
			}
		}

		private void PartLevelCheck()
		{
			RunSave data = _store.Data;
			if (data.partBonusLevel != RunInfo.LevelIndex)
			{
				data.partBonusLevel = RunInfo.LevelIndex;
				data.dodgesThisLevel = 0;
				data.dodgePartGiven = false;
				data.lurePartGiven = false;
			}
		}

		private void PartsOnDodge()
		{
			if (Game.InLevel())
			{
				PartLevelCheck();
				RunSave data = _store.Data;
				data.dodgesThisLevel++;
				if (data.dodgesThisLevel >= 5 && !data.dodgePartGiven)
				{
					data.dodgePartGiven = true;
					AddParts(new int[4] { 0, 1, 0, 0 }, "5 dodges");
				}
			}
		}

		private void PartsOnSalvage(int rarity)
		{
			if (rarity == 2)
			{
				AddParts(new int[4] { 1, 0, 0, 0 }, "salvage");
			}
			else if (rarity == 3)
			{
				AddParts(new int[4] { 2, 0, 0, 0 }, "salvage");
			}
			else if (rarity >= 4)
			{
				AddParts(new int[4] { 0, 1, 0, 0 }, "salvage");
			}
		}

		private void ClearPartDrops()
		{
			foreach (int key in _partDrops.Keys)
			{
				RemoveWorldMark("part:" + key);
			}
			_partDrops.Clear();
		}

		private static int[] Cost(Recipe r)
		{
			int[] array = r switch
			{
				Recipe.Reroll => new int[4] { 3, 1, 0, 0 }, 
				Recipe.Raise => new int[4] { 0, 2, 0, 0 }, 
				Recipe.Upgrade => new int[4] { 0, 2, 1, 0 }, 
				_ => new int[4] { 0, 0, 2, 1 }, 
			};
			if (RunShape.Has("spare_parts"))
			{
				for (int i = 0; i < array.Length; i++)
				{
					if (array[i] > 1)
					{
						array[i]--;
					}
				}
			}
			return array;
		}

		private static string RecipeName(Recipe r)
		{
			return r switch
			{
				Recipe.Reroll => "Reroll a stat line", 
				Recipe.Raise => "Raise a stat", 
				Recipe.Upgrade => "Upgrade rarity", 
				_ => "Upgrade to Legendary", 
			};
		}

		private bool CanAfford(int[] cost)
		{
			int[] parts = Parts;
			for (int i = 0; i < 4; i++)
			{
				if (parts[i] < cost[i])
				{
					return false;
				}
			}
			return true;
		}

		private static AffixDef? AffixFor(GearItem g, string stat)
		{
			int num = Plugin.Rpg.SlotIndex(g.slot);
			if (num < 0)
			{
				return null;
			}
			AffixDef[] affixes = Plugin.Rpg.slots[num].affixes;
			foreach (AffixDef affixDef in affixes)
			{
				if (string.Equals(affixDef.stat, stat, StringComparison.OrdinalIgnoreCase))
				{
					return affixDef;
				}
			}
			return null;
		}

		private List<int> CraftLines(GearItem g)
		{
			List<int> list = new List<int>();
			for (int i = 0; i < g.effects.Length; i++)
			{
				if (AffixFor(g, g.effects[i].stat) != null)
				{
					list.Add(i);
				}
			}
			return list;
		}

		private string CraftBlock(GearItem g, Recipe r, int line)
		{
			if (!Plugin.Cfg.CraftingParts.Value)
			{
				return "crafting is off on this host";
			}
			if (g.crafts >= Mathf.Max(1, Plugin.Cfg.MaxCraftsPerItem.Value))
			{
				return $"this item has had its {Plugin.Cfg.MaxCraftsPerItem.Value} crafts";
			}
			if (!CanAfford(Cost(r)))
			{
				return "not enough parts";
			}
			List<int> list = CraftLines(g);
			switch (r)
			{
			case Recipe.Reroll:
			case Recipe.Raise:
				if (list.Count == 0 || !list.Contains(line))
				{
					return "no stat line to change";
				}
				if (r == Recipe.Raise)
				{
					EffectDef effectDef = g.effects[line];
					float num = AffixFor(g, effectDef.stat).max * Gear.Rarity(g.rarity).mult;
					if (Mathf.Abs(effectDef.value) >= Mathf.Abs(num) - 0.001f)
					{
						return "that stat is already at its maximum";
					}
				}
				return "";
			case Recipe.Upgrade:
				if (!string.IsNullOrEmpty(g.unique))
				{
					return "uniques can't be upgraded";
				}
				if (g.rarityUps >= Mathf.Max(0, Plugin.Cfg.MaxRarityUpgrades.Value))
				{
					return "this item's rarity upgrade is used";
				}
				if (g.rarity >= Gear.MaxRarity - 1)
				{
					if (g.rarity < Gear.MaxRarity)
					{
						return "Epic to Legendary needs the Legendary recipe";
					}
					return "already Legendary";
				}
				return "";
			default:
				if (!string.IsNullOrEmpty(g.unique))
				{
					return "uniques can't be upgraded";
				}
				if (g.rarityUps >= Mathf.Max(0, Plugin.Cfg.MaxRarityUpgrades.Value))
				{
					return "this item's rarity upgrade is used";
				}
				if (g.rarity != Gear.MaxRarity - 1)
				{
					return "only Epic items";
				}
				return "";
			}
		}

		private void DoCraft(string uid, Recipe r, int line)
		{
			//IL_0042: Unknown result type (might be due to invalid IL or missing references)
			//IL_008a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0127: Unknown result type (might be due to invalid IL or missing references)
			//IL_057e: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			int num = data.inventory.FindIndex((GearItem x) => x.uid == uid);
			if (num < 0)
			{
				Toast("That item is gone", Color.gray);
				return;
			}
			GearItem g = data.inventory[num];
			string text = CraftBlock(g, r, line);
			if (text != "")
			{
				Toast("Can't craft: " + text, Color.gray);
				MenuSound(UiSound.Error);
				return;
			}
			Random random = new Random();
			GearItem copy = Clone(g);
			RarityDef rarityDef = Gear.Rarity(copy.rarity);
			switch (r)
			{
			case Recipe.Reroll:
			{
				int num9 = Plugin.Rpg.SlotIndex(copy.slot);
				List<AffixDef> list3 = new List<AffixDef>(Plugin.Rpg.slots[num9].affixes);
				list3.RemoveAll((AffixDef a) => Array.Exists(copy.effects, (EffectDef e) => e != copy.effects[line] && string.Equals(e.stat, a.stat, StringComparison.OrdinalIgnoreCase)));
				if (list3.Count == 0)
				{
					Toast("Nothing else to roll for that slot", Color.gray);
					return;
				}
				AffixDef affixDef2 = list3[random.Next(list3.Count)];
				copy.effects[line] = new EffectDef
				{
					stat = affixDef2.stat,
					value = RollValue(affixDef2, rarityDef.mult, random)
				};
				break;
			}
			case Recipe.Raise:
			{
				EffectDef effectDef2 = copy.effects[line];
				AffixDef affixDef = AffixFor(copy, effectDef2.stat);
				float num6 = (affixDef.max - affixDef.min) * rarityDef.mult / 4f;
				float num7 = affixDef.max * rarityDef.mult;
				float num8 = effectDef2.value + num6;
				num8 = ((num7 >= 0f) ? Mathf.Min(num8, num7) : Mathf.Max(num8, num7));
				copy.effects[line] = new EffectDef
				{
					stat = effectDef2.stat,
					value = ((Mathf.Abs(affixDef.max) >= 1.5f) ? Mathf.Round(num8) : ((float)Math.Round(num8, 2)))
				};
				break;
			}
			default:
			{
				int num2 = Mathf.Min(copy.rarity + 1, Gear.MaxRarity);
				float num3 = Gear.Rarity(num2).mult / Mathf.Max(0.01f, rarityDef.mult);
				List<EffectDef> list = new List<EffectDef>();
				EffectDef[] effects = copy.effects;
				foreach (EffectDef effectDef in effects)
				{
					list.Add(new EffectDef
					{
						stat = effectDef.stat,
						value = ((Mathf.Abs(effectDef.value) >= 1.5f) ? Mathf.Round(effectDef.value * num3) : ((float)Math.Round(effectDef.value * num3, 2)))
					});
				}
				int num5 = Plugin.Rpg.SlotIndex(copy.slot);
				List<AffixDef> list2 = new List<AffixDef>(Plugin.Rpg.slots[num5].affixes);
				list2.RemoveAll((AffixDef a) => list.Exists((EffectDef e) => string.Equals(e.stat, a.stat, StringComparison.OrdinalIgnoreCase)));
				while (list.Count < Gear.Rarity(num2).affixes && list2.Count > 0)
				{
					int index = random.Next(list2.Count);
					list.Add(new EffectDef
					{
						stat = list2[index].stat,
						value = RollValue(list2[index], Gear.Rarity(num2).mult, random)
					});
					list2.RemoveAt(index);
				}
				copy.effects = list.ToArray();
				copy.rarity = num2;
				copy.rarityUps++;
				if (num2 >= 3 && copy.sockets == 0)
				{
					copy.sockets = 1;
					copy.modules = new string[1] { "" };
				}
				break;
			}
			}
			ClassDatabase.ResolveAll("gear " + copy.name, copy.effects);
			int[] array = Cost(r);
			int[] parts = Parts;
			for (int num10 = 0; num10 < 4; num10++)
			{
				parts[num10] -= array[num10];
			}
			copy.crafts++;
			Account.Count("crafts");
			data.inventory[num] = copy;
			_statsDirty = true;
			_store.MarkDirty();
			_store.SaveNow();
			RarityDef rarityDef2 = Gear.Rarity(copy.rarity);
			Notify(PopupKind.Loot, $"Crafted: {RecipeName(r)} on {copy.name} ({copy.crafts}/{Plugin.Cfg.MaxCraftsPerItem.Value})", ParseColor(rarityDef2.color));
			MenuSound(UiSound.Confirm);
		}

		private static float RollValue(AffixDef af, float mult, Random rng)
		{
			double num = ((double)af.min + (double)(af.max - af.min) * rng.NextDouble()) * (double)mult;
			float num2 = ((Math.Abs(af.max) >= 1.5f) ? ((float)Math.Round(num)) : ((float)Math.Round(num, 2)));
			if (num2 != 0f)
			{
				return num2;
			}
			if (!(af.max >= 0f))
			{
				return -1f;
			}
			return 1f;
		}

		private static GearItem Clone(GearItem g)
		{
			GearItem gearItem = Json.Deserialize<GearItem>(Json.Serialize(g, pretty: false));
			string classId = "gear " + gearItem.name;
			GearItem gearItem2 = gearItem;
			ClassDatabase.ResolveAll(classId, gearItem2.effects ?? (gearItem2.effects = Array.Empty<EffectDef>()));
			string classId2 = "gear " + gearItem.name;
			gearItem2 = gearItem;
			ClassDatabase.ResolveAll(classId2, gearItem2.hidden ?? (gearItem2.hidden = Array.Empty<EffectDef>()));
			gearItem2 = gearItem;
			if (gearItem2.modules == null)
			{
				gearItem2.modules = Array.Empty<string>();
			}
			gearItem2 = gearItem;
			if (gearItem2.upFx == null)
			{
				gearItem2.upFx = Array.Empty<EffectDef>();
			}
			gearItem2 = gearItem;
			if (gearItem2.upFxAt == null)
			{
				gearItem2.upFxAt = Array.Empty<int>();
			}
			gearItem2 = gearItem;
			if (gearItem2.upOffer == null)
			{
				gearItem2.upOffer = Array.Empty<EffectDef>();
			}
			GearUp.Resolve(gearItem);
			return gearItem;
		}

		private void OpenCraft(GearItem g)
		{
			//IL_0017: Unknown result type (might be due to invalid IL or missing references)
			//IL_0035: Unknown result type (might be due to invalid IL or missing references)
			if (!Plugin.Cfg.CraftingParts.Value)
			{
				Toast("Crafting is off on this host", Color.gray);
				return;
			}
			if (Starters.Is(g))
			{
				Toast("Starter items can't be crafted", Color.gray);
				return;
			}
			_craftUid = g.uid;
			List<int> list = CraftLines(g);
			_craftLine = ((list.Count > 0) ? list[0] : 0);
			_craftPick = null;
			OpenDialog(DialogKind.Craft, null);
		}

