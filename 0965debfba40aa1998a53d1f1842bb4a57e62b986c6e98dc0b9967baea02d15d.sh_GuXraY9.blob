				if ((Object)(object)instance == (Object)null || __0 <= 0)
				{
					return true;
				}
				int num = 0;
				if (__2 >= 0)
				{
					int num2 = AttackerId(__2);
					if (num2 != 0 && Elites.TryGet(num2, out var info))
					{
