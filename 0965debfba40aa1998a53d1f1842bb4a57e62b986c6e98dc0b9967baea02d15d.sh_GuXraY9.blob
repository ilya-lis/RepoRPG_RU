			}
			return true;
		}
	}
	internal static class BatteryRule
	{
		private static readonly Dictionary<int, float> BarAcc = new Dictionary<int, float>();

		private static readonly Dictionary<int, int> Logged = new Dictionary<int, int>();

		public static float CostMult(Component battery, out string why)
		{
			why = "";
			PlayerAvatar val = OverclockState.Holder(battery);
			if ((Object)(object)val == (Object)null)
			{
				return 1f;
			}
			PhysGrabObject val2 = battery.GetComponent<PhysGrabObject>() ?? battery.GetComponentInParent<PhysGrabObject>();
			if ((Object)(object)val2 == (Object)null || !OverclockWeapons.Supported(val2, out string _))
			{
				return 1f;
			}
			if (ClassHost.Overclocked(val, out var _, out var _))
			{
				why = "Overclock";
				return Mathf.Clamp01(Plugin.Cfg.OverclockBatteryCost.Value / 100f);
			}
			float num = GunTuner.BatterySave(battery);
			if (num > 0f)
			{
				why = "Efficient Rounds";
				return 1f - num / 100f;
			}
			return 1f;
		}

		public static bool SkipBar(Component battery, float mult)
		{
			if (mult <= 0.001f)
			{
				return true;
			}
			if (mult >= 0.999f)
			{
				return false;
			}
			int instanceID = ((Object)battery).GetInstanceID();
			BarAcc.TryGetValue(instanceID, out var value);
			value += (1f - mult) * 100f;
			bool num = value >= 100f;
			if (num)
			{
				value -= 100f;
			}
			BarAcc[instanceID] = value;
			if (BarAcc.Count > 256)
			{
				BarAcc.Clear();
			}
			return num;
		}

		public static void Note(Component gun, string path, float before, float after, float mult, string why)
		{
			if (why != "Overclock")
			{
				return;
			}
			int key = ((Object)gun).GetInstanceID() ^ Mathf.FloorToInt(Time.time / 10f);
			Logged.TryGetValue(key, out var value);
			if (value < 5)
			{
				Logged[key] = value + 1;
				if (Logged.Count > 256)
				{
					Logged.Clear();
				}
				Plugin.Log.LogInfo((object)$"[overclock] battery {((Object)gun).name}: {before:0.##} -> {after:0.##} ({path}, cost x{mult:0.##}).");
			}
		}

		public static void Reset()
		{
			BarAcc.Clear();
			Logged.Clear();
		}

		public static bool IsCartBattery(PhysGrabObject? o, out ItemBattery? bat)
		{
			bat = null;
			if ((Object)(object)o == (Object)null || (Object)(object)((Component)o).GetComponent<ItemGun>() != (Object)null || (Object)(object)((Component)o).GetComponent<PhysGrabCart>() != (Object)null)
			{
				return false;
			}
			bat = ((Component)o).GetComponent<ItemBattery>() ?? ((Component)o).GetComponentInChildren<ItemBattery>();
			if ((Object)(object)bat == (Object)null || Life(bat) <= 0.5f)
			{
				bat = null;
				return false;
			}
			if (OverclockWeapons.Supported(o, out string _))
			{
				bat = null;
				return false;
			}
			return true;
		}

		public static float Life(ItemBattery b)
		{
			return Game.Get(b, "batteryLife", 0f);
		}

		public static float CartBatteries(PhysGrabCart cart, List<ItemBattery> into)
		{
			into.Clear();
			float num = 0f;
			if ((Object)(object)cart == (Object)null || !(Game.Get<object>(cart, "itemsInCart", null) is IList list))
			{
				return 0f;
			}
			foreach (object item in list)
			{
				PhysGrabObject val = (PhysGrabObject)((item is PhysGrabObject) ? item : null);
				if (val != null && IsCartBattery(val, out ItemBattery bat) && (Object)(object)bat != (Object)null && !into.Contains(bat))
				{
					into.Add(bat);
					num += Life(bat);
				}
			}
			return num;
		}

		public static float MoveInto(ItemBattery gun, List<ItemBattery> from, float want)
		{
			float num = Life(gun);
			want = Mathf.Min(want, 100f - num);
			float num2 = 0f;
			foreach (ItemBattery item in from)
			{
				if (want - num2 < 0.5f)
				{
					break;
				}
				if (!((Object)(object)item == (Object)null) && !((Object)(object)item == (Object)(object)gun))
				{
					float num3 = Life(item);
					float num4 = Mathf.Min(num3, want - num2);
					if (!(num4 < 0.5f))
					{
						int num5 = Mathf.Clamp(Mathf.RoundToInt(num3 - num4), 0, 100);
						item.SetBatteryLife(num5);
						num2 += num3 - (float)num5;
					}
				}
			}
			if (num2 > 0f)
			{
				gun.SetBatteryLife(Mathf.Clamp(Mathf.RoundToInt(num + num2), 0, 100));
			}
			return num2;
		}
	}
