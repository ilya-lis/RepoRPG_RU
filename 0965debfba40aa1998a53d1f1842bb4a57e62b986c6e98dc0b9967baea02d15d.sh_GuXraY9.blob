		private static string BuildBoonsText()
		{
			RunShape.State cur = RunShape.Cur;
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append($"<b>RUN BOONS</b>  <color=#9a9ca0>{cur.Boons.Length} of {RunShape.Data.boons.Length}. They work for the whole team until the run ends. The codes are the ones on the HUD.</color>\n\n");
			if (cur.Boons.Length == 0)
			{
				stringBuilder.Append("<color=#9a9ca0>None yet. The team votes on one after each milestone, and sometimes after a boss kill.</color>\n");
			}
			for (int i = 0; i < cur.Boons.Length; i++)
			{
				BoonDef boonDef = RunShape.Boon(cur.Boons[i]);
				if (boonDef != null)
				{
					string text = ((i < cur.BoonFrom.Length && cur.BoonFrom[i] != "") ? ("  <color=#9a9ca0>· " + cur.BoonFrom[i] + "</color>") : "");
					stringBuilder.Append("<color=" + boonDef.color + "><b>[" + boonDef.code + "] " + boonDef.name + "</b></color>  <color=#9a9ca0>" + BoonRarityNames[Mathf.Clamp(boonDef.rarity, 0, 2)] + "</color>" + text + "\n" + boonDef.desc + "\n\n");
				}
			}
			if (cur.VoteFor != 0)
			{
				stringBuilder.Append("<color=#99e6ff>A boon vote is open: see the top of the Shop tab.</color>\n");
			}
			return stringBuilder.ToString();
		}

