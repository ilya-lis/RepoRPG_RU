		public void BuyPerkReroll()
		{
			//IL_0046: Unknown result type (might be due to invalid IL or missing references)
			if (Account.Active("second_opinion") && !_store.Data.freeRerollUsed)
			{
				_store.Data.freeRerollUsed = true;
				RollPerkChoices();
				_store.MarkDirty();
				Toast("Second opinion: free perk reroll", Accent);
				return;
			}
			Buy("perkreroll", "perk reroll", Perks.RerollBase(_store.Data), delegate
			{
