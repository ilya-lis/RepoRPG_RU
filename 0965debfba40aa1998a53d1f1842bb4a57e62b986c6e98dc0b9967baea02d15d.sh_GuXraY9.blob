							val3.transform.rotation = val2.rotation;
							val3.AddComponent(_spawnType);
							list2.Add(feet);
							num2++;
						}
					}
				}
			}
			_madeCount += num2;
			int num7 = list.Count + num2;
			if (num2 > 0)
