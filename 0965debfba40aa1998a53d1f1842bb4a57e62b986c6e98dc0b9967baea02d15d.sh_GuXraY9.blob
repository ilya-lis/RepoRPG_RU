		private static AudioMixerGroup? GroupFor(string type)
		{
			Type type2 = AccessTools.TypeByName("AudioManager");
			object obj = ((type2 == null) ? null : AccessTools.Field(type2, "instance")?.GetValue(null));
			if (obj == null)
			{
				return null;
			}
			string[] array = new string[3]
			{
				"Audio" + type,
				"AudioGlobal",
				"AudioDefault"
