				n = num;
				if (num % 40 == 0)
				{
					yield return null;
				}
			}
			if (Plugin.Cfg.HudDiagnostics.Value)
			{
				Plugin.Log.LogInfo((object)$"[late join] {insts.Count} cached objects of the old level removed.");
			}
		}

