			float num3 = 0f;
			foreach (Zone zone in _zones)
			{
				Vector3 val3 = zone.Pos - position;
				if (((Vector3)(ref val3)).sqrMagnitude <= zone.Radius * zone.Radius)
				{
					num3 = Mathf.Max(num3, zone.Loot);
				}
