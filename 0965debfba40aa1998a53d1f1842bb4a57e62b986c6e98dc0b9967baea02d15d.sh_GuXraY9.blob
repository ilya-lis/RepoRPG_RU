		private void EnsureGuideView(GuideTopic t, float w)
		{
			//IL_03d4: Unknown result type (might be due to invalid IL or missing references)
			bool flag = t.id == "mystats" && Time.unscaledTime >= _gNextStats;
			string text = string.Format("{0}|{1}|{2}|{3}|{4}|{5}|{6}|{7}", t.id, Mathf.RoundToInt(w), _layoutVersion, _cfgVersion, (_promptDevice == NavDevice.Pad && Pad.Connected) ? Pad.Kind : "kb", _guideRole, Plugin.Db.Classes.Count, (t.id == "difficulty" || t.id == "teamcontracts" || t.id == "contracts") ? RunInfo.LevelIndex : 0);
			if (text == _gKey && !flag)
			{
				return;
			}
			_gKey = text;
			if (t.id == "mystats")
			{
				_gNextStats = Time.unscaledTime + 0.5f;
			}
			_gItems.Clear();
			_cfgCache = null;
			GuideBlock[] blocks = t.blocks;
			foreach (GuideBlock guideBlock in blocks)
			{
				if (guideBlock == null)
				{
					continue;
				}
				switch (guideBlock.type)
				{
				case "bullets":
				{
					if (guideBlock.title != "")
					{
						Add(GKind.Head, ResolveGuide(guideBlock.title).ToUpperInvariant(), w);
					}
					string[] items = guideBlock.items;
					foreach (string text2 in items)
					{
						Add(GKind.Bullet, ResolveGuide(text2), w - 26f);
					}
					Add(GKind.Space, "", w, 4f);
					break;
				}
				case "text":
					Add(GKind.Text, ResolveGuide(guideBlock.text), w);
					break;
				case "tip":
					AddBox(GKind.Tip, ResolveGuide(guideBlock.text), w);
					break;
				case "note":
					AddBox(GKind.Note, ResolveGuide(guideBlock.text), w);
					break;
				case "terms":
				{
					if (guideBlock.title != "")
					{
						Add(GKind.Head, ResolveGuide(guideBlock.title).ToUpperInvariant(), w);
					}
					GuideTerm[] terms = guideBlock.terms;
					foreach (GuideTerm guideTerm in terms)
					{
						if (guideTerm != null)
						{
							AddTerm(ResolveGuide(guideTerm.term), ResolveGuide(guideTerm.meaning), w, Accent);
						}
					}
					Add(GKind.Space, "", w, 4f);
					break;
				}
				case "goto":
					_gItems.Add(new GItem
					{
						Kind = GKind.Goto,
						Text = ((guideBlock.label != "") ? guideBlock.label : ("Go to " + guideBlock.tab)),
						Arg = guideBlock.tab,
						H = BtnH + 8f
					});
					break;
				case "walkthrough":
					_gItems.Add(new GItem
					{
						Kind = GKind.Walk,
						Text = ((guideBlock.label != "") ? guideBlock.label : "Show the walkthrough"),
						H = BtnH + 8f
					});
					break;
				case "dynamic":
					AddDynamic(guideBlock.name, w);
					break;
				}
			}
			_gTotalH = 0f;
			foreach (GItem gItem in _gItems)
			{
				_gTotalH += gItem.H + 8f;
			}
			_gTotalH += 16f;
		}

		private void Add(GKind k, string text, float w, float h = -1f)
		{
			if (h < 0f)
			{
				h = ((k == GKind.Head) ? (LineH(_bodyB) + 8f) : TextH(text, (k == GKind.Row) ? _small : _body, w));
			}
			_gItems.Add(new GItem
			{
				Kind = k,
				Text = text,
				H = h
			});
		}

		private void AddBox(GKind k, string text, float w)
		{
			float num = Mathf.Max(64f, TextW("NOTE", _bodyB) + 16f);
			float h = Mathf.Max(LineH(_bodyB), TextH(text, _body, w - 24f - num)) + 24f - 4f;
			_gItems.Add(new GItem
			{
				Kind = k,
				Text = text,
				H = h
			});
		}

		private void AddTerm(string term, string meaning, float w, Color c)
		{
			//IL_0060: Unknown result type (might be due to invalid IL or missing references)
			//IL_0062: Unknown result type (might be due to invalid IL or missing references)
			float num = Mathf.Min(220f, w * 0.3f);
			float h = Mathf.Max(LineH(_bodyB), TextH(meaning, _body, w - num - 10f));
			_gItems.Add(new GItem
			{
				Kind = GKind.Term,
				Text = term.ToUpperInvariant(),
				Text2 = meaning,
				Color = c,
				H = h
			});
		}

		private static string Hex(Color c)
		{
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			return "#" + ColorUtility.ToHtmlStringRGB(c);
		}

		private static string Hex(string hex)
		{
			if (!hex.StartsWith("#"))
			{
				return "#" + hex;
			}
			return hex;
		}

