		private List<(string name, List<ClassDef> list)> ClassGroups()
		{
			List<ClassDef> classes = Plugin.Db.Classes;
			if (_classGroups != null && _classGroupsCount == classes.Count)
			{
				return _classGroups;
			}
			List<(string, List<ClassDef>)> list = new List<(string, List<ClassDef>)>();
			string[] groupOrder = GroupOrder;
			foreach (string gname in groupOrder)
			{
				List<ClassDef> list2 = classes.FindAll((ClassDef c) => string.Equals(c.group, gname, StringComparison.OrdinalIgnoreCase));
				if (list2.Count > 0)
				{
					list.Add((gname, list2));
				}
			}
			List<ClassDef> list3 = classes.FindAll((ClassDef c) => Array.FindIndex(GroupOrder, (string g) => string.Equals(g, c.group, StringComparison.OrdinalIgnoreCase)) < 0);
			if (list3.Count > 0)
			{
				list.Add(((list.Count > 0) ? "Other" : "", list3));
			}
			_classGroups = list;
			_classGroupsCount = classes.Count;
			return list;
		}

		private string NodeText(NodeDef n)
		{
			if (_nodeText.TryGetValue(n, out string value))
			{
				return value;
			}
			string text;
			if (!string.IsNullOrEmpty(n.desc))
			{
				text = n.desc.Replace("CAPSTONE: ", "");
			}
			else
			{
				List<string> list = new List<string>();
				EffectDef[] effects = n.effects;
				foreach (EffectDef effectDef in effects)
				{
					if (effectDef.StatIndex >= 0)
					{
						list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value));
					}
				}
				text = string.Join(", ", list);
			}
			if (n.maxRank > 1)
			{
				text += " (per rank)";
			}
			_nodeText[n] = text;
			return text;
		}

