		private void ProvideResearchNotices(List<ActionNotice> into)
		{
			if (!Research.On)
			{
				return;
			}
			ResearchSave mine = Research.Mine;
			if (mine.unseen.Count > 0)
			{
				ResearchDef researchDef = Research.Def(mine.unseen[0]);
				into.Add(new ActionNotice
				{
					Id = "research.done." + mine.unseen[0],
					Title = ((mine.unseen.Count > 1) ? $"{mine.unseen.Count} research projects finished" : ("Research finished: " + researchDef?.name)),
					Tab = "Research",
					Anchor = "research",
					Kind = NoticeKind.Minor,
					Short = "RESEARCH"
				});
			}
			if (mine.active.Count >= Research.Slots)
			{
				return;
			}
			ResearchDef[] projects = Research.File.projects;
			for (int i = 0; i < projects.Length; i++)
			{
				if (Research.CanStart(projects[i], out string _))
				{
					into.Add(new ActionNotice
					{
						Id = "research.start",
						Title = "Enough Data to start research",
						Short = "DATA",
						Tab = "Research",
						Anchor = "research",
						Kind = NoticeKind.Minor
					});
					break;
				}
			}
		}

