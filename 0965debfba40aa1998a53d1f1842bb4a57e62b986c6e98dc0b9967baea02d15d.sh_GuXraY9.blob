		public static void HostLevelFailed()
		{
			TeamRunSave teamRunSave = HostTeam();
			if (teamRunSave == null || !Game.IsMaster())
			{
				return;
			}
			int levelIndex = RunInfo.LevelIndex;
			if (teamRunSave.countedLevel != levelIndex)
			{
				teamRunSave.countedLevel = levelIndex;
				HostLevelTotals();
				teamRunSave.levelsFailed++;
				string note = "";
				if (C.StreaksOn.Value && teamRunSave.streak > 0)
				{
					int streak = teamRunSave.streak;
					teamRunSave.streak = ((C.StreakFailMode.Value == StreakFail.Halve) ? (teamRunSave.streak / 2) : 0);
					teamRunSave.streak = Mathf.Min(streak, Mathf.Max(teamRunSave.streak, StreakFloor(teamRunSave)));
					note = "streak-|Streak " + ((teamRunSave.streak == 0) ? "broken" : $"{streak} -> {teamRunSave.streak}") + ": the level was lost";
				}
				Dirty();
				HostBroadcast(note);
			}
		}

		public static void HostPlayerDied(PlayerAvatar p)
		{
			TeamRunSave teamRunSave = HostTeam();
			if (teamRunSave == null || !Game.IsMaster() || !Game.InLevel())
			{
				return;
			}
			Totals(teamRunSave, p).deaths++;
			int num = Mathf.Clamp(C.StreakDeath.Value, 0, 10);
			if (teamRunSave.boons.Contains("hold_the_line"))
			{
				num /= 2;
			}
			string note = "";
			if (C.StreaksOn.Value && num > 0 && teamRunSave.streak > 0)
			{
				int streak = teamRunSave.streak;
				teamRunSave.streak = Mathf.Max(0, teamRunSave.streak - num);
				teamRunSave.streak = Mathf.Min(streak, Mathf.Max(teamRunSave.streak, StreakFloor(teamRunSave)));
				if (teamRunSave.streak < streak)
				{
					note = string.Format("streak-|Streak -{0}: {1} died", streak - teamRunSave.streak, Game.Get(p, "playerName", "a player"));
				}
			}
			Dirty();
			HostBroadcast(note);
		}

		private static void StartVote(TeamRunSave t, int milestone, string from)
		{
			if (t.voteFor != 0)
			{
				Decide(t);
			}
			t.voteOptions.Clear();
			t.voteFrom = from;
			List<BoonDef> list = new List<BoonDef>();
			BoonDef[] boons = Data.boons;
			foreach (BoonDef boonDef in boons)
			{
				if (boonDef != null && !t.boons.Contains(boonDef.id) && (boonDef.research == "" || Research.Lobby(boonDef.research)))
				{
					list.Add(boonDef);
				}
			}
			Random random = RunInfo.RngFor(milestone * 7919 + 31);
			for (int j = 0; j < Ascension.BoonOptions; j++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				float num = 0f;
				foreach (BoonDef item in list)
				{
					num += Mathf.Max(0.01f, item.weight);
				}
				double num2 = random.NextDouble() * (double)num;
				int k;
				for (k = 0; k < list.Count - 1; k++)
				{
					num2 -= (double)Mathf.Max(0.01f, list[k].weight);
					if (num2 <= 0.0)
					{
						break;
					}
				}
				t.voteOptions.Add(list[k].id);
				list.RemoveAt(k);
			}
			t.voteFor = ((t.voteOptions.Count > 0) ? milestone : 0);
			Votes.Clear();
			_voteFor = t.voteFor;
		}

		public static void HostVote(int actor, int milestone, int option)
		{
			TeamRunSave team = Team;
			if (team != null && Game.IsMaster() && team.voteFor != 0 && milestone == team.voteFor && option >= 0 && option < team.voteOptions.Count && !Game.InLevel())
			{
				Votes[actor] = option;
				if (Votes.Count >= Game.Players().Count)
				{
					Decide(team);
				}
				else
				{
					HostBroadcast();
				}
			}
		}

