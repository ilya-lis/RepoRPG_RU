		private static float Accel(Pilot pl)
		{
			return Mathf.Clamp(Mathf.Max(pl.Top, 1.5f) / Mathf.Max(0.2f, Plugin.Cfg.CartAccelTime.Value), 1.5f, 9f);
		}

		private static float Decel(Pilot pl)
		{
			return Mathf.Min(Accel(pl) * 1.5f, 10f);
		}

		private static float LoadFactor(Pilot pl)
		{
			return 1f - Mathf.Clamp(Plugin.Cfg.CartLoadPenalty.Value, 0f, 25f) / 100f * Mathf.Clamp01(pl.LoadMass / Mathf.Max(1f, Plugin.Cfg.CartFullLoadMass.Value));
		}

		private static float CartTalentMult(PlayerAvatar? p, bool follow)
		{
			if ((Object)(object)p == (Object)null)
			{
				return 1f;
			}
			float num = Mathf.Clamp(ClassStats.Get(p, "cartwright.cart_speed"), 0f, 200f) + Mathf.Clamp(ClassStats.Get(p, "cartwright.follow_speed"), 0f, 200f);
			if (follow)
			{
				num += Mathf.Clamp(ClassStats.Get(p, "cartwright.drive_power"), 0f, 200f);
			}
			return 1f + Mathf.Clamp(num, 0f, Plugin.Cfg.CartSpeedBonusCap.Value) / 100f;
		}

