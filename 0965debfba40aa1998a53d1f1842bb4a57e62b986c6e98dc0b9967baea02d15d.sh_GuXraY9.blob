		private List<(string name, List<ClassDef> list)> VisibleGroups()
		{
			string text = _roleFilter + "|" + _cxFilter + "|" + (_cxSort ? "s" : "r") + "|" + _classQuery + "|" + Plugin.Db.Classes.Count;
