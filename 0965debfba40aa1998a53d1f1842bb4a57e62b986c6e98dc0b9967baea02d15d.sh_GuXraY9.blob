		public static void BroadcastSettings(int toActor = -1)
		{
			if (Online && PhotonNetwork.IsMasterClient)
			{
				SettingsSync.Snapshot(out string[] keys, out string[] values);
				object[] payload = new object[4]
				{
					keys,
					values,
					SettingsSync.Version,
					"1.0.100"
				};
				if (toActor > 0)
				{
					SendTo(9, payload, toActor);
				}
				else
				{
					Send(9, payload, (ReceiverGroup)0);
				}
			}
		}

		public static void SendSettingsAck(int version, string modVersion)
		{
			if (Online && !PhotonNetwork.IsMasterClient)
			{
				Send(54, new object[2]
				{
