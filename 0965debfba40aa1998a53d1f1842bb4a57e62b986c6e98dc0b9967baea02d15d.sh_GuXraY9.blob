			if (array.Length >= 6)
			{
				int.TryParse(array[0], out _supplyLeft);
				int.TryParse(array[1], out _supplyCharges);
				int.TryParse(array[2], out _supplyPrice);
				int.TryParse(array[3], out _betLeft);
				int.TryParse(array[4], out _betUses);
				int.TryParse(array[5], out _limitsLevel);
				_nextHudBuild = 0f;
			}
		}

		private void ClearAbilityLimits()
