		public static bool On(HudShow s)
		{
			return s switch
			{
				HudShow.Never => false, 
				HudShow.Always => true, 
				HudShow.LevelsOnly => Game.InLevel(), 
				_ => !Game.InLevel(), 
			};
		}

		public static int CardSig()
		{
			ModConfig cfg = Plugin.Cfg;
			int num = 0;
			int num2 = 1;
			ConfigEntry<bool>[] array = new ConfigEntry<bool>[7] { cfg.HudIdentity, cfg.HudScrap, cfg.HudXpBar, cfg.HudAbility, cfg.HudAbilityName, cfg.AbilityRingSeconds, cfg.HudExtraKeys };
			for (int i = 0; i < array.Length; i++)
			{
				if (array[i].Value)
				{
					num |= num2;
				}
				num2 <<= 1;
			}
			return num | (int)((ClassLines ? 1u : 0u) << 10);
		}

		private static object? PresetValue(HudPreset p, ConfigEntryBase e)
		{
			ModConfig cfg = Plugin.Cfg;
			if (p == HudPreset.Full)
			{
				if ((object)e == cfg.MenuHintInLevels)
				{
					return false;
				}
				if (e.SettingType == typeof(bool))
				{
					return true;
				}
				if (e.SettingType == typeof(HudShow))
				{
					return HudShow.Always;
				}
				if ((object)e == cfg.RunLineMode)
				{
					return RunLineShow.Always;
				}
				if ((object)e == cfg.HealFeedback)
				{
					return HealFeedbackLevel.Standard;
				}
				return null;
			}
			bool flag = p == HudPreset.Clean;
			if ((object)e == cfg.HudCardShow)
			{
				return HudShow.Always;
			}
			if ((object)e == cfg.HudIdentity)
			{
				return !flag;
			}
			if ((object)e == cfg.HudAbility || (object)e == cfg.AbilityRingSeconds || (object)e == cfg.HudAlerts)
			{
				return true;
			}
			if ((object)e == cfg.HudAbilityName || (object)e == cfg.HudExtraKeys)
			{
				return !flag;
			}
			if ((object)e == cfg.HudScrap || (object)e == cfg.HudXpBar)
			{
				return false;
			}
			if ((object)e == cfg.HudClassLines)
			{
				return HudShow.Never;
			}
			if ((object)e == cfg.RunLineMode)
			{
				return RunLineShow.Never;
			}
			if ((object)e == cfg.HudChipPoints)
			{
				return !flag;
			}
			if ((object)e == cfg.HudChipChapter || (object)e == cfg.HudChipStreak || (object)e == cfg.ShowBoons || (object)e == cfg.HudChipHeat || (object)e == cfg.HudChipAscension || (object)e == cfg.HudChipCrew || (object)e == cfg.HudChipPayout || (object)e == cfg.HudChipMapMod || (object)e == cfg.HudChipRoute || (object)e == cfg.SynergyHud || (object)e == cfg.HudChipCatchUp)
			{
				return false;
			}
			if ((object)e == cfg.PopupsEnabled)
			{
				return !flag;
			}
			if ((object)e == cfg.PopupLevel || (object)e == cfg.PopupLoot || (object)e == cfg.PopupContracts || (object)e == cfg.PopupPerks)
			{
				return true;
			}
			if ((object)e == cfg.PopupXp || (object)e == cfg.PopupCurrency || (object)e == cfg.PopupOther || (object)e == cfg.PopupResearch)
			{
				return false;
			}
			if ((object)e == cfg.HealFeedback)
			{
				return (!flag) ? HealFeedbackLevel.Minimal : HealFeedbackLevel.Off;
			}
			if ((object)e == cfg.TriageBars || (object)e == cfg.TriageList || (object)e == cfg.HudScanMarkers || (object)e == cfg.HudThreatLabels || (object)e == cfg.BossMarker)
			{
				return true;
			}
			if ((object)e == cfg.HudContracts)
			{
				return flag ? HudShow.Never : HudShow.LevelsOnly;
			}
			if ((object)e == cfg.Nameplates || (object)e == cfg.HudElementIcons || (object)e == cfg.HudEliteLines)
			{
				return !flag;
			}
			if ((object)e == cfg.HudScanOutlines || (object)e == cfg.HudBeams)
			{
				return !flag;
			}
			if ((object)e == cfg.LobbyRoster)
			{
				return true;
			}
			if ((object)e == cfg.ShowMenuHint)
			{
				return !flag;
			}
			if ((object)e == cfg.MenuHintInLevels || (object)e == cfg.HudHighlights || (object)e == cfg.RunSummaryCard)
			{
				return false;
			}
			return null;
		}

		public static void Apply(HudPreset p)
		{
			if (p == HudPreset.Custom)
			{
				return;
			}
			SettingsSync.SaveLocalChange(delegate
			{
				ConfigEntryBase[] all = All;
				foreach (ConfigEntryBase val in all)
				{
					object obj = PresetValue(p, val);
					if (obj != null && !object.Equals(val.BoxedValue, obj))
					{
						val.BoxedValue = obj;
					}
				}
			});
		}

		public static HudPreset Current()
		{
			HudPreset[] array = new HudPreset[3]
			{
				HudPreset.Full,
				HudPreset.Minimal,
				HudPreset.Clean
			};
			foreach (HudPreset hudPreset in array)
			{
				bool flag = true;
				ConfigEntryBase[] all = All;
				foreach (ConfigEntryBase val in all)
				{
					object obj = PresetValue(hudPreset, val);
					if (obj != null && !object.Equals(val.BoxedValue, obj))
					{
						flag = false;
						break;
					}
				}
				if (flag)
				{
					return hudPreset;
				}
			}
			return HudPreset.Custom;
		}

		public static void ResetAll()
		{
			ConfigEntryBase[] all = All;
			foreach (ConfigEntryBase obj in all)
			{
				obj.BoxedValue = obj.DefaultValue;
			}
		}

		public static string Name(HudShow s)
		{
			return s switch
			{
				HudShow.Always => "Always", 
				HudShow.TruckAndShop => "Truck & shop", 
				HudShow.LevelsOnly => "Levels only", 
				_ => "Never", 
			};
		}
	}
	[HarmonyPatch]
	internal static class TransitionStartPatch
	{
		private static readonly (string type, string method)[] Targets = new(string, string)[9]
		{
			("RunManager", "ChangeLevel"),
			("RunManager", "RestartScene"),
			("RunManager", "LeaveToMainMenu"),
			("RunManager", "SceneHandoffBegin"),
			("RunManager", "SceneHandoffStart"),
			("RunManager", "LeavePhotonRoom"),
			("NetworkManager", "LeavePhotonRoom"),
			("LoadingUI", "StartLoading"),
			("GameDirector", "OutroStart")
		};

		private static IEnumerable<MethodBase> TargetMethods()
		{
			(string type, string method)[] targets = Targets;
			for (int i = 0; i < targets.Length; i++)
			{
				(string, string) tuple = targets[i];
				string item = tuple.Item1;
				string method = tuple.Item2;
				Type type = AccessTools.TypeByName(item);
				if (type == null)
				{
					continue;
				}
				foreach (MethodInfo declaredMethod in AccessTools.GetDeclaredMethods(type))
				{
					if (declaredMethod.Name == method && !declaredMethod.IsAbstract && !declaredMethod.ContainsGenericParameters)
					{
						yield return declaredMethod;
					}
				}
			}
		}

		[HarmonyPrepare]
		private static bool Prepare()
		{
			return TargetMethods().GetEnumerator().MoveNext();
		}

		[HarmonyPrefix]
		[HarmonyPriority(800)]
		private static void Prefix(MethodBase __originalMethod)
		{
			try
			{
				RpgRuntime.OnTransitionStart(__originalMethod.DeclaringType?.Name + "." + __originalMethod.Name);
			}
			catch
			{
			}
		}
	}
