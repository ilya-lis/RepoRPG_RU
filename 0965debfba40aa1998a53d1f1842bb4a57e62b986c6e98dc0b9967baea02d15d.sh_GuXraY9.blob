				float num6 = LineH(_h2);
				ShadowLabel(new Rect(((Rect)(ref area2)).x, ((Rect)(ref area2)).y, ((Rect)(ref area2)).width, num6 + 2f), guideTopic.title.ToUpperInvariant(), _h2, Accent);
				string text = "<b>" + ResolveGuide(guideTopic.summary) + "</b>";
				float num7 = TextH(text, _body, ((Rect)(ref area2)).width);
				Label(new Rect(((Rect)(ref area2)).x, ((Rect)(ref area2)).y + num6 + 4f, ((Rect)(ref area2)).width, num7 + 2f), text, _body);
				float num8 = ((Rect)(ref area2)).y + num6 + 4f + num7 + 8f;
				Fill(new Rect(((Rect)(ref area2)).x, num8 - 3f, ((Rect)(ref area2)).width, 1f), ClassTheme.Cur.Line);
