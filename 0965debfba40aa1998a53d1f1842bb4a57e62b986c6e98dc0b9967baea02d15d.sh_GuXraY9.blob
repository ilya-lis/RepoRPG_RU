		public void OnTeamHealth(int[] actors, int[] hp, int[] max, int[] down)
		{
			_matesAt = Time.unscaledTime;
			int localActor = ClassClaims.LocalActor;
			HashSet<int> hashSet = new HashSet<int>();
			for (int i = 0; i < actors.Length && i < hp.Length && i < max.Length && i < down.Length; i++)
			{
				int num = actors[i];
				if (num != localActor)
				{
					hashSet.Add(num);
					if (!_mates.TryGetValue(num, out Mate value))
					{
						value = new Mate
						{
							Actor = num
						};
						_mates[num] = value;
						_mateOrderDirty = true;
					}
					int num2 = Mathf.Max(0, hp[i]);
					int num3 = Mathf.Max(1, max[i]);
					bool flag = down[i] != 0;
					if (num2 != value.Hp || num3 != value.Max || flag != value.Down || !(value.BarText != ""))
					{
						value.Hp = num2;
						value.Max = num3;
						value.Down = flag;
						value.BarText = (value.Down ? "X DOWN" : $"{value.Hp}/{value.Max}");
						value.ListText = "";
						_mateOrderDirty = true;
						CheckCritical(value);
					}
				}
			}
			foreach (int item in new List<int>(_mates.Keys))
			{
				if (!hashSet.Contains(item))
				{
					_mates.Remove(item);
					_mateOrderDirty = true;
				}
			}
		}

		private static float Frac(Mate m)
		{
			if (!m.Down)
			{
				return Mathf.Clamp01((float)m.Hp / (float)m.Max);
			}
			return 0f;
		}

		private static bool Critical(Mate m)
		{
			if (!m.Down)
			{
				return Frac(m) < 0.25f;
			}
			return false;
		}

		private void CheckCritical(Mate m)
		{
			//IL_00a0: Unknown result type (might be due to invalid IL or missing references)
			float unscaledTime = Time.unscaledTime;
			if (!Critical(m))
			{
				m.CriticalSince = -1f;
			}
			else
			{
				if (m.CriticalSince >= 0f)
				{
					return;
				}
				m.CriticalSince = unscaledTime;
				if (SeesTeamHealth && Game.InLevel() && unscaledTime - m.LastCriticalPop > 20f)
				{
					m.LastCriticalPop = unscaledTime;
					if (m.Name == "")
					{
						RefreshMateAvatars(force: true);
					}
					Notify(PopupKind.Other, ((m.Name == "") ? "A teammate" : m.Name) + " is critical", HealthColor(m), "critical:" + m.Actor);
				}
			}
		}

		private void RefreshMateAvatars(bool force = false)
		{
			if (!force && Time.unscaledTime < _mateAvatarsAt)
			{
				return;
			}
			_mateAvatarsAt = Time.unscaledTime + 1f;
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && _mates.TryGetValue(Game.ActorNumber(item), out Mate value))
				{
					value.Avatar = item;
					string text = Game.Get(item, "playerName", "?");
					if (text != value.Name)
					{
						value.Name = text;
						value.ListText = "";
						_mateOrderDirty = true;
					}
				}
			}
		}

		private Color HealthColor(Mate m)
		{
			//IL_0017: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a3: Unknown result type (might be due to invalid IL or missing references)
			//IL_008e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0071: Unknown result type (might be due to invalid IL or missing references)
			if (m.Down)
			{
				return new Color(0.6f, 0.6f, 0.62f);
			}
			float num = Frac(m);
			if (num < 0.25f)
			{
				float num2 = (Plugin.Cfg.ReducedEffects.Value ? 1f : (0.8f + 0.2f * Mathf.Sin(Time.unscaledTime * 6f)));
				return new Color(1f, 0.3f, 0.3f, num2);
			}
			if (num < 0.5f)
			{
				return new Color(1f, 0.72f, 0.2f);
			}
			return new Color(0.35f, 0.8f, 1f);
		}

		private static string Mark(Mate m)
		{
			if (!m.Down)
			{
				if (!(Frac(m) < 0.25f))
				{
					if (!(Frac(m) < 0.5f))
					{
						return "";
					}
					return "! ";
				}
				return "!! ";
			}
			return "X ";
		}

		private void DrawTeamHealth(float vw, float vh)
		{
			//IL_0001: Unknown result type (might be due to invalid IL or missing references)
			//IL_0006: Unknown result type (might be due to invalid IL or missing references)
			//IL_0023: Unknown result type (might be due to invalid IL or missing references)
			//IL_0029: Invalid comparison between Unknown and I4
			_triageRect = Rect.zero;
			bool diag = Plugin.Cfg.TriageDebug.Value && (int)Event.current.type == 7 && Time.unscaledTime >= _triageDiagAt;
			if (diag)
			{
				_triageDiagAt = Time.unscaledTime + 3f;
				_triageDiag.Clear();
			}
			if (!SeesTeamHealth)
			{
				Why(string.Format("1 activation: off - class '{0}' (Medic, or Mimic with mimic.triage {1:0.#})", CurrentId, ClassStat("mimic.triage")));
				return;
			}
			if (!Game.InLevel())
			{
				Why("1 activation: not in a level");
				return;
			}
			if (_mates.Count == 0)
			{
				Why($"3 health data: nothing from the host yet (last message {Time.unscaledTime - _matesAt:0.0}s ago; solo = no teammates)");
				return;
			}
			if (Time.unscaledTime - _matesAt > 6f)
			{
				Why($"3 health data: stale ({Time.unscaledTime - _matesAt:0.0}s since the host's last update)");
				return;
			}
			RefreshMateAvatars();
			Camera main = Camera.main;
			PlayerAvatar val = Game.LocalPlayer();
			if ((Object)(object)val == (Object)null)
			{
				Why("2 creation: no local player");
				return;
			}
			if (diag)
			{
				int num = 0;
				foreach (Mate value in _mates.Values)
				{
					if ((Object)(object)value.Avatar != (Object)null)
					{
						num++;
					}
				}
				Why(string.Format("ok: {0} teammate(s) from the host, {1} avatar(s) found, bars {2}, list {3}, ", _mates.Count, num, Plugin.Cfg.TriageBars.Value ? "on" : "OFF in Controls", Plugin.Cfg.TriageList.Value ? "on" : "off") + string.Format("camera {0}, range {1:0}m", ((Object)(object)main == (Object)null) ? "MISSING" : (((Object)main).name + (((Object)(object)main.targetTexture != (Object)null) ? $" (renders {((Texture)main.targetTexture).width}x{((Texture)main.targetTexture).height}, screen {Screen.width}x{Screen.height})" : "")), Mathf.Clamp(Plugin.Cfg.TriageRange.Value + ClassStat("medic.triage_range"), 5f, 120f)));
			}
			_triageDiagOn = diag;
			if (_mateOrderDirty)
			{
				_mateOrderDirty = false;
				_mateOrder.Clear();
				_mateOrder.AddRange(_mates.Values);
				_mateOrder.Sort(delegate(Mate a, Mate b)
				{
					if (a.Down == b.Down)
					{
						return Frac(a).CompareTo(Frac(b));
					}
					return (!a.Down) ? 1 : (-1);
				});
			}
			EnsureScanTextures();
			if (Plugin.Cfg.TriageBars.Value && (Object)(object)main != (Object)null)
			{
				DrawMateBars(main, val, vw, vh);
			}
			if (Plugin.Cfg.TriageList.Value)
			{
				DrawMateList(val, vw, vh);
			}
			void Why(string s)
			{
				if (diag)
				{
					Plugin.Log.LogInfo((object)("[triage] " + s));
				}
			}
		}

		private Vector3 MatePos(Mate m)
		{
			//IL_0010: Unknown result type (might be due to invalid IL or missing references)
			//IL_0043: Unknown result type (might be due to invalid IL or missing references)
			//IL_0037: Unknown result type (might be due to invalid IL or missing references)
			PlayerAvatar avatar = m.Avatar;
			if ((Object)(object)avatar == (Object)null)
			{
				return Vector3.zero;
			}
			PlayerDeathHead val = (m.Down ? Game.DeathHead(avatar) : null);
			if ((Object)(object)val != (Object)null)
			{
				return ((Component)val).transform.position;
			}
			return ((Component)avatar).transform.position;
		}

