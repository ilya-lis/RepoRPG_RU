				if (type != null && propertyInfo != null)
				{
					Font val = null;
					string fontName = VanillaStyle.FontName;
					Object[] array;
					if (fontName != "")
					{
						array = Resources.FindObjectsOfTypeAll(type);
						foreach (Object val2 in array)
						{
							if (val2 != (Object)null && val2.name == fontName)
							{
								object? value = propertyInfo.GetValue(val2);
								Font val3 = (Font)((value is Font) ? value : null);
								if (val3 != null && (Object)(object)val3 != (Object)null)
								{
									Plugin.Log.LogInfo((object)("UI font: using the game's menu font '" + fontName + "' (" + ((Object)val3).name + ")."));
									return val3;
								}
							}
						}
					}
					array = Resources.FindObjectsOfTypeAll(type);
					foreach (Object val4 in array)
					{
						if (val4 == (Object)null)
						{
							continue;
						}
						string text2 = val4.name ?? "";
						if (text2.IndexOf("Liberation", StringComparison.OrdinalIgnoreCase) < 0 && text2.IndexOf("Fallback", StringComparison.OrdinalIgnoreCase) < 0 && text2.IndexOf("Emoji", StringComparison.OrdinalIgnoreCase) < 0)
						{
							object? value2 = propertyInfo.GetValue(val4);
							Font val5 = (Font)((value2 is Font) ? value2 : null);
							if (val5 != null && (Object)(object)val5 != (Object)null)
							{
								val = val5;
								Plugin.Log.LogInfo((object)("UI font: using the game's '" + text2 + "' (" + ((Object)val5).name + ")."));
								break;
							}
						}
					}
					if ((Object)(object)val != (Object)null)
					{
						return val;
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogDebug((object)("Game font lookup failed: " + ex.Message));
			}
			try
			{
				Font val6 = Font.CreateDynamicFontFromOSFont(new string[4] { "Bahnschrift", "Impact", "Arial Black", "Arial" }, 32);
				if ((Object)(object)val6 != (Object)null)
				{
					Plugin.Log.LogInfo((object)"UI font: using a system font (game font not available to the mod).");
					return val6;
				}
			}
			catch
			{
			}
			return null;
		}

