		public static void HostLevelDone()
		{
			if (!Game.IsMaster() || !Research.On || !Research.Lobby("archivist") || !Game.InLevel())
			{
				return;
			}
			int count = ResearchSamples.Live.Count;
			if (((_samplesLevel == RunInfo.LevelIndex) ? SamplesOut.Count : 0) < count)
			{
				return;
			}
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null)
				{
					ContractHost.Ev(item, "res.allsamples");
				}
			}
		}

		private static CrewResearchSave Res(TeamRunSave t)
		{
			if (t.resC == null)
			{
				t.resC = new CrewResearchSave();
			}
			CrewResearchSave resC = t.resC;
			if (resC.drills == null)
			{
				resC.drills = new List<string>();
			}
			resC = t.resC;
			if (resC.drillOffer == null)
			{
				resC.drillOffer = new List<string>();
			}
			resC = t.resC;
			if (resC.sponsorOffer == null)
			{
				resC.sponsorOffer = new List<string>();
			}
			resC = t.resC;
			if (resC.sponsor == null)
			{
				resC.sponsor = "";
			}
			return t.resC;
		}

		private static int Metric(TeamRunSave t, string id)
		{
			int num = 0;
			switch (id)
			{
			case "brass":
			{
				foreach (RunPlayerTotals player in t.players)
				{
					num += player.contracts;
				}
				return num;
			}
			case "kaboom":
				return t.elites + 3 * t.bosses;
			case "hollis":
			{
				foreach (RunPlayerTotals player2 in t.players)
				{
					num += player2.deaths;
				}
				return num;
			}
			case "auditor":
				return t.milestones;
			default:
				return 0;
			}
		}

		private static int Progress(TeamRunSave t, CrewResearchSave r)
		{
			if (!(r.sponsor == "dispatch"))
			{
				return Mathf.Max(0, Metric(t, r.sponsor) - r.sponsorBase);
			}
			return r.sponsorBest;
		}

		private static int Grade(TeamRunSave t, CrewResearchSave r)
		{
			int num = Progress(t, r);
			int num2 = Mathf.Max(1, r.sponsorTarget);
			if (r.sponsor == "hollis")
			{
				int num3 = ((num <= num2) ? 2 : ((num <= num2 * 2) ? 1 : 0));
				if (t.levelsCleared - r.sponsorLevels >= 5)
				{
					return num3;
				}
				return Mathf.Min(num3, 1);
			}
			if (num < num2)
			{
				return (num * 2 >= num2) ? 1 : 0;
			}
			return 2;
		}

		private static string SponsorLine(TeamRunSave t, CrewResearchSave r)
		{
			if (r.sponsor == "")
			{
				return "";
			}
			int num = Progress(t, r);
			string text = (r.sponsorPaid ? "paid out" : ((r.sponsor == "hollis") ? $"{num} lost so far" : $"{Mathf.Min(num, r.sponsorTarget)}/{r.sponsorTarget}"));
			return SponsorGoal(r.sponsor, r.sponsorTarget) + ": " + text;
		}

		public static void HostCheck()
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster())
			{
				return;
			}
			CrewResearchSave crewResearchSave = Res(team);
			bool flag = false;
			if (Research.On && Research.Lobby("crew_drills") && Plugin.Cfg.CrewOn.Value)
			{
				int num = RunShape.CrewLevelFor(team.crewXp);
				if (crewResearchSave.drillDone == 0)
				{
					crewResearchSave.drillDone = Mathf.Max(1, num - 1);
					flag = true;
				}
				if (crewResearchSave.drillFor == 0 && num > crewResearchSave.drillDone)
				{
					int num2 = crewResearchSave.drillDone + 1;
					List<string> list = new List<string>();
					Drill[] drills = Drills;
					foreach (Drill drill in drills)
					{
						if (!crewResearchSave.drills.Contains(drill.Id))
						{
							list.Add(drill.Id);
						}
					}
					Random random = RunInfo.RngFor(num2 * 4111 + 7);
					crewResearchSave.drillOffer.Clear();
					while (crewResearchSave.drillOffer.Count < 3 && list.Count > 0)
					{
						int index = random.Next(list.Count);
						crewResearchSave.drillOffer.Add(list[index]);
						list.RemoveAt(index);
					}
					if (crewResearchSave.drillOffer.Count == 0)
					{
						crewResearchSave.drillDone = num;
					}
					else
					{
						crewResearchSave.drillFor = num2;
						DrillVotes.Clear();
						Plugin.Log.LogInfo((object)string.Format("[research] crew drill vote (crew level {0}): {1}.", num2, string.Join(", ", crewResearchSave.drillOffer)));
					}
					flag = true;
				}
			}
			if (Research.On && Research.Lobby("sponsors") && crewResearchSave.sponsor == "" && crewResearchSave.sponsorOffer.Count == 0 && !team.recapped && !team.complete)
			{
				List<string> list2 = new List<string>();
				string[] sponsorIds = SponsorIds;
				foreach (string text in sponsorIds)
				{
					if (ContractBoard.Giver(text) != null)
					{
						list2.Add(text);
					}
				}
				Random random2 = RunInfo.RngFor(9173);
				while (crewResearchSave.sponsorOffer.Count < 3 && list2.Count > 0)
				{
					int index2 = random2.Next(list2.Count);
					crewResearchSave.sponsorOffer.Add(list2[index2]);
					list2.RemoveAt(index2);
				}
				if (crewResearchSave.sponsorOffer.Count > 0)
				{
					SponsorVotes.Clear();
					flag = true;
					Plugin.Log.LogInfo((object)("[research] sponsor vote: " + string.Join(", ", crewResearchSave.sponsorOffer) + "."));
				}
			}
			if (crewResearchSave.sponsor == "dispatch" && !crewResearchSave.sponsorPaid && team.streak > crewResearchSave.sponsorBest)
			{
				crewResearchSave.sponsorBest = team.streak;
				flag = true;
			}
			if (flag)
			{
				RpgRuntime.Instance?.MarkRunDirty();
			}
			HostSync(team, crewResearchSave, -1);
		}

		private static void HostSync(TeamRunSave t, CrewResearchSave r, int actor)
		{
			State state = new State
			{
				Drills = r.drills.ToArray(),
				DrillFor = r.drillFor,
				DrillOffer = ((r.drillFor != 0) ? r.drillOffer.ToArray() : Array.Empty<string>()),
				DrillVotes = DrillVotes.Count,
				Sponsor = r.sponsor,
				SponsorOffer = ((r.sponsor == "") ? r.sponsorOffer.ToArray() : Array.Empty<string>()),
				SponsorVotes = SponsorVotes.Count,
				Voters = Mathf.Max(1, Game.Players().Count),
				SponsorLine = SponsorLine(t, r),
				DrillBy = ((r.drillFor != 0) ? RunShape.Ballots(DrillVotes) : Array.Empty<int>()),
				SponsorBy = ((r.sponsor == "") ? RunShape.Ballots(SponsorVotes) : Array.Empty<int>())
			};
			if (actor > 0)
			{
				Net.SendCrewState(state, actor);
				return;
			}
			string text = string.Join(",", state.Drills) + "|" + state.DrillFor + "|" + string.Join(",", state.DrillOffer) + "|" + state.DrillVotes + "|" + state.Sponsor + "|" + string.Join(",", state.SponsorOffer) + "|" + state.SponsorVotes + "|" + state.Voters + "|" + state.SponsorLine + "|" + string.Join(",", state.DrillBy) + "|" + string.Join(",", state.SponsorBy);
			if (!(text == _sentSig))
			{
				_sentSig = text;
				Net.SendCrewState(state, -1);
			}
		}

		public static void HostSendTo(int actor)
		{
			TeamRunSave team = Team;
			if (team != null && Game.IsMaster() && actor > 0)
			{
				HostSync(team, Res(team), actor);
			}
		}

		public static void HostVote(int actor, int which, int forId, int option)
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster() || Game.InLevel())
			{
				return;
			}
			CrewResearchSave crewResearchSave = Res(team);
			int num = Mathf.Max(1, Game.Players().Count);
			if (which == 0)
			{
				if (crewResearchSave.drillFor == 0 || forId != crewResearchSave.drillFor || option < 0 || option >= crewResearchSave.drillOffer.Count)
				{
					return;
				}
				DrillVotes[actor] = option;
				if (DrillVotes.Count >= num)
				{
					DecideDrill(crewResearchSave);
				}
			}
			else
			{
				if (crewResearchSave.sponsor != "" || option < 0 || option >= crewResearchSave.sponsorOffer.Count)
				{
					return;
				}
				SponsorVotes[actor] = option;
				if (SponsorVotes.Count >= num)
				{
					DecideSponsor(team, crewResearchSave);
				}
			}
			RpgRuntime.Instance?.MarkRunDirty();
			HostSync(team, crewResearchSave, -1);
		}

		public static void HostLevelStart()
		{
			TeamRunSave team = Team;
			if (team != null && Game.IsMaster())
			{
				CrewResearchSave crewResearchSave = Res(team);
				bool flag = false;
				if (crewResearchSave.drillFor != 0)
				{
					DecideDrill(crewResearchSave);
					flag = true;
				}
				if (crewResearchSave.sponsor == "" && crewResearchSave.sponsorOffer.Count > 0)
				{
					DecideSponsor(team, crewResearchSave);
					flag = true;
				}
				if (flag)
				{
					RpgRuntime.Instance?.MarkRunDirty();
					HostSync(team, crewResearchSave, -1);
				}
			}
		}

		private static int Pick(Dictionary<int, int> votes, int n)
		{
			int[] array = new int[n];
			foreach (int value in votes.Values)
			{
				if (value >= 0 && value < n)
				{
					array[value]++;
				}
			}
			int num = 0;
			for (int i = 1; i < n; i++)
			{
				if (array[i] > array[num])
				{
					num = i;
				}
			}
			List<int> list = new List<int>();
			for (int j = 0; j < n; j++)
			{
				if (array[j] == array[num])
				{
					list.Add(j);
				}
			}
			if (list.Count != 1)
			{
				return list[new Random().Next(list.Count)];
			}
			return num;
		}

		private static void DecideDrill(CrewResearchSave r)
		{
			if (r.drillFor == 0 || r.drillOffer.Count == 0)
			{
				r.drillFor = 0;
				return;
			}
			string text = r.drillOffer[Pick(DrillVotes, r.drillOffer.Count)];
			if (!r.drills.Contains(text))
			{
				r.drills.Add(text);
			}
			Plugin.Log.LogInfo((object)$"[research] crew drill (crew level {r.drillFor}): {text} ({DrillVotes.Count} vote(s)).");
			r.drillDone = r.drillFor;
			r.drillFor = 0;
			r.drillOffer.Clear();
			DrillVotes.Clear();
			RunShape.HostNote("crew|Crew drill: " + DrillName(text) + " - " + DrillDef(text)?.Desc);
		}

		private static void DecideSponsor(TeamRunSave t, CrewResearchSave r)
		{
			if (!(r.sponsor != "") && r.sponsorOffer.Count != 0)
			{
				string text = (r.sponsor = r.sponsorOffer[Pick(SponsorVotes, r.sponsorOffer.Count)]);
				r.sponsorTarget = TargetFor(text, Game.Players().Count);
				r.sponsorBase = Metric(t, text);
				r.sponsorBest = t.streak;
				r.sponsorLevels = t.levelsCleared;
				r.sponsorOffer.Clear();
				SponsorVotes.Clear();
				Plugin.Log.LogInfo((object)$"[research] sponsor: {text} (target {r.sponsorTarget}, from {r.sponsorBase}).");
				RunShape.HostNote("crew|Sponsor: " + SponsorName(text) + " - " + SponsorGoal(text, r.sponsorTarget));
			}
		}

		public static void HostRunEnd(TeamRunSave t)
		{
			try
			{
				if (!Game.IsMaster() || !Research.On)
				{
					return;
				}
				CrewResearchSave crewResearchSave = Res(t);
				if (crewResearchSave.sponsor == "" || crewResearchSave.sponsorPaid)
				{
					return;
				}
				crewResearchSave.sponsorPaid = true;
				int num = Grade(t, crewResearchSave);
				string text = SponsorName(crewResearchSave.sponsor);
				float num2 = SponsorMult(crewResearchSave.sponsor);
				int num3 = Mathf.RoundToInt((float)(num switch
				{
					1 => 75, 
					2 => 150, 
					_ => 0, 
				}) * num2);
				float num4 = (float)(num switch
				{
					1 => 30, 
					2 => 60, 
					_ => 0, 
				}) * num2;
				string text2 = num switch
				{
					1 => $"Sponsor {text}: half way there. +{num3} Scrap and some Research Data", 
					2 => $"Sponsor {text}: goal met! +{num3} Scrap and Research Data", 
					_ => "Sponsor " + text + ": the goal wasn't reached. No payout", 
				};
				foreach (PlayerAvatar item in Game.Players())
				{
					if (!((Object)(object)item == (Object)null))
					{
						if (num3 > 0)
						{
							Scrap.HostGrant(item, num3, "Sponsor: " + text);
						}
						Net.SendNotice(item, Notice.Popup, 0f, text2);
					}
				}
				if (num4 > 0f)
				{
					Research.HostGrantAll(num4, "Sponsor: " + text);
				}
				Plugin.Log.LogInfo((object)$"[research] sponsor {crewResearchSave.sponsor} paid at the run's end: grade {num}, {num3} Scrap, {num4:0} base Data each ({Progress(t, crewResearchSave)}/{crewResearchSave.sponsorTarget}).");
				RpgRuntime.Instance?.MarkRunDirty();
				HostSync(t, crewResearchSave, -1);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[research] sponsor payout failed: " + ex.Message));
			}
		}
	}
