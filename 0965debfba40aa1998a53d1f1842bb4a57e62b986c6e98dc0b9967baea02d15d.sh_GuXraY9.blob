			}
			float num = (copied ? 0f : Mathf.Clamp(Plugin.Cfg.ScanLingerSeconds.Value + ClassStat("appraiser.scan_linger"), 0f, 10f));
			float num2 = Time.time + Mathf.Max(duration, 1f) + num;
