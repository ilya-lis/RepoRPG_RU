		private void ScanBosses(float now)
		{
			if (now < _bossScanAt)
			{
				return;
			}
			_bossScanAt = now + 0.5f;
			_bossMarks.RemoveAll((BossMark b) => (Object)(object)b.Eh == (Object)null || !((Component)b.Eh).gameObject.activeInHierarchy || Game.Get(b.Eh, "dead", fallback: false));
			bool flag = false;
			foreach (KeyValuePair<int, Elites.Info> item in Elites.All)
			{
				if (item.Value.Tier >= 3)
				{
					flag = true;
					break;
				}
			}
			if (!flag)
			{
				_bossMarks.Clear();
				return;
			}
			Game.EnemyList.Enumerator enumerator2 = Game.LivingEnemies().GetEnumerator();
			while (enumerator2.MoveNext())
			{
				EnemyHealth current = enumerator2.Current;
				if (Elites.TryGet(current, out var info) && info.Tier >= 3)
				{
					int id = Elites.ViewId((Component)(object)current);
					if (!_bossMarks.Exists((BossMark b) => b.ViewId == id))
					{
						_bossMarks.Add(new BossMark
						{
							Eh = current,
							ViewId = id,
							Name = Bosses.NameFor(id)
						});
					}
				}
			}
		}

