				if (a >= 0 && a < _voteResults.Count)
				{
					VResult vResult = _voteResults[a];
					d.Type = "Decided";
					int num = vResult.Text.IndexOf(':');
					d.Name = ((num > 0) ? vResult.Text.Substring(num + 1).Trim() : vResult.Text);
					d.Status.Add((UiStatus.Maxed, (num > 0) ? vResult.Text.Substring(0, num) : "Result"));
					d.NowHead = "WHAT IT DOES";
					d.Now = vResult.Detail;
				}
			}
			else
			{
				if (a < 0 || a >= _vCards.Count)
				{
					return;
				}
				VCard vCard = _vCards[a];
