		private float SynergyDamageMult(PlayerAvatar me)
		{
			float num = 1f;
			string currentId = CurrentId;
			if ((currentId == "juggernaut" || currentId == "brute") && Synergies.Has(me, "shoulder"))
			{
				num *= 1f - Mathf.Clamp(Synergies.V("shoulder"), 0f, 20f) / 100f;
			}
			if ((currentId == "bloodbound" || currentId == "survivor") && Synergies.Has(me, "scar_bond") && (Object)(object)me.playerHealth != (Object)null)
			{
