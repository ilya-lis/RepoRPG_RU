						{
						case "Fill":
						case "Border":
						case "ShadowLabel":
						case "Label":
						case "DrawIcon":
						case "Note":
							continue;
						}
						creator = methodBase.DeclaringType?.Name + "." + name;
						break;
					}
				}
			}
			catch
			{
			}
			Items.Add(new Item
			{
				N = Items.Count + 1,
				Section = ((Section == "") ? "(none)" : Section),
				Kind = kind,
				Creator = creator,
				Text = (text ?? ""),
				R = r,
				C = c * GUI.color
			});
		}

