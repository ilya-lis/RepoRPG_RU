		private void HandleInput()
		{
			if (_abilityKeyQueued)
			{
				_abilityKeyQueued = false;
				AbilityDiag("ability key: trying the ability");
				TryUseActive();
			}
			RunQueuedClassKey();
			HandlePad();
			if (_menuOpen && !_transitioning)
			{
				ForceCursor();
				HideMapWhileMenu();
			}
		}

