			("Research", new string[1] { "Research" }, "Research: whether it's on, whose research decides the lobby-wide unlocks, how much Data runs give, costs and sample chance."),
			("Market", new string[1] { "Market" }, "The living economy: valuable prices by category that move with what the team extracts, shop demand, market requests and market events."),
			("Late Join", new string[1] { "LateJoin" }, "Players joining after the run started: where, spawn, class window, catch-up."),
			("Players & Scaling", new string[2] { "Players", "Scaling" }, "Lobby size (up to 20) and difficulty scaling by player count: strength and each category."),
			("Season, Routes & Heat", new string[3] { "Season", "Routes", "Heat" }, "How long a run is (chapters x levels), with a finale boss at the end and an End / Endless vote after the win; the route vote between levels; and the heat vote after each milestone."),
			("Milestones & Streaks", new string[2] { "Milestones", "Streaks" }, "Milestones every few levels (a milestone boss, rewards, a boon vote, a new chapter) and the team streak."),
			("Boons, Crew & Unlocks", new string[3] { "Boons", "Crew", "Unlocks" }, "Run boons from boss kills, the crew level (a shared team level with small bonuses), and what unlocks deeper into a run."),
			("Run Progress", new string[1] { "Threat" }, "The threat rating that rises with every level cleared: speed, cap, grace levels and each category."),
			("Account & Players", new string[1] { "Account" }, "What players' account progress (unlocks, mastery, prestige) may do in this lobby.")
		};

		private static readonly HashSet<string> NextLevelKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
		{
			"Bosses/Bosses", "Bosses/BossEvery", "Bosses/FirstBossLevel", "Bosses/BossModifiers", "RPG/EliteEnemies", "RPG/EliteBaseChance", "RPG/EliteChancePerLevel", "RPG/EliteMaxChance", "RPG/ContractsPerLevel", "TeamContracts/TeamContracts",
			"TeamContracts/VoteSeconds", "TeamContracts/StakeScale", "Contracts/BoardSize", "Leveling/XpMultiplier", "Leveling/XpCurveBase", "Leveling/XpCurvePerLevel", "Leveling/XpCurveSquare", "Leveling/MaxXpBonus"
		};

		private static readonly HashSet<string> NextRunKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
		{
			"Leveling/MaxLevel", "Currency/StartingAmount", "Currency/Name", "Currency/ShortName", "Currency/Symbol", "RPG/InventorySize", "RPG/AttributePointsPerLevel", "Leveling/PointsPerLevel", "Leveling/BonusPointEvery", "Difficulty/Tier",
			"Difficulty/Hardcore", "Difficulty/GlassCannon", "Difficulty/NoShop", "Difficulty/FragileGoods", "Difficulty/EliteSwarm", "Difficulty/LoneWolves", "Difficulty/ThinWallets", "Difficulty/IronBodies", "Difficulty/ShortFuse", "Difficulty/Blackout",
			"Account/StartingUnlocks", "Account/PrestigeTrees", "Account/AlternatePassives", "Perks/PerkEvery", "Season/Enabled", "Season/Length", "Season/Chapters"
		};

		private static List<(string, string, List<ConfigEntryBase>)>? _entries;

		private static float _entriesAt = -99f;

		private static readonly Dictionary<ConfigEntryBase, object> NextLevel = new Dictionary<ConfigEntryBase, object>();

		private static readonly Dictionary<ConfigEntryBase, object> NextRun = new Dictionary<ConfigEntryBase, object>();

		private static readonly Dictionary<int, (int version, string mod)> Acks = new Dictionary<int, (int, string)>();

		private static readonly HashSet<int> Warned = new HashSet<int>();

		private const string Header = "# RepoRPG host settings preset";

		private static List<PresetInfo>? _presets;

		private static float _presetsAt = -99f;

		private static readonly Dictionary<string, PresetInfo> Checked = new Dictionary<string, PresetInfo>(StringComparer.OrdinalIgnoreCase);

		private static string? _default;

		private static string _defaultRoom = "";

		public static bool RunNotStarted
		{
			get
			{
				if (Game.InLobbyMenu() || Game.InMenuLevel())
				{
					return RunInfo.LevelIndex <= 0;
				}
				return false;
			}
		}

		public static int Scheduled => NextLevel.Count + NextRun.Count;

		private static string PresetDir => Path.Combine(ClassDatabase.Folder, "presets");

		private static string DefaultFile => Path.Combine(PresetDir, "default.txt");

		public static int PresetCount => PresetList().Count;

		public static string DefaultName
		{
			get
			{
				if (_default != null)
				{
					return _default;
				}
				try
				{
					_default = (File.Exists(DefaultFile) ? File.ReadAllText(DefaultFile).Trim() : "");
				}
				catch
				{
					_default = "";
				}
				return _default;
			}
		}

		public static string KeyOf(ConfigEntryBase e)
		{
			return e.Definition.Section + "/" + e.Definition.Key;
		}

		public static IEnumerable<ConfigEntryBase> EntriesAndPreset()
		{
			foreach (var item2 in Entries())
			{
				List<ConfigEntryBase> item = item2.entries;
				foreach (ConfigEntryBase item3 in item)
				{
					yield return item3;
				}
			}
			yield return (ConfigEntryBase)(object)Plugin.Cfg.Preset;
		}

		private static bool Hidden(ConfigDefinition d)
		{
			if (d.Section == "Difficulty")
			{
				return d.Key == "Preset";
			}
			return false;
		}

		public static When TimingOf(ConfigEntryBase e)
		{
			string item = KeyOf(e);
			if (!NextRunKeys.Contains(item))
			{
				if (!NextLevelKeys.Contains(item))
				{
					return When.Now;
				}
				return When.NextLevel;
			}
			return When.NextRun;
		}

		public static When EffectiveTiming(ConfigEntryBase e)
		{
			if (!RunNotStarted)
			{
				return TimingOf(e);
			}
			return When.Now;
		}

		public static string TimingLabel(When w)
		{
			return w switch
			{
				When.NextLevel => "applies next level", 
				When.Now => "applies now", 
				_ => "applies next run", 
			};
		}

		public static List<(string group, string desc, List<ConfigEntryBase> entries)> Entries()
		{
			if (_entries != null && Time.unscaledTime - _entriesAt < 5f)
			{
				return _entries;
			}
			_entriesAt = Time.unscaledTime;
			_entries = BuildEntries();
			return _entries;
		}

		private static List<(string group, string desc, List<ConfigEntryBase> entries)> BuildEntries()
		{
			List<(string, string, List<ConfigEntryBase>)> list = new List<(string, string, List<ConfigEntryBase>)>();
			ConfigFile config = ((BaseUnityPlugin)Plugin.Instance).Config;
			(string, string[], string)[] groups = Groups;
			for (int i = 0; i < groups.Length; i++)
			{
				(string, string[], string) tuple = groups[i];
				string item = tuple.Item1;
				string[] item2 = tuple.Item2;
				string item3 = tuple.Item3;
				List<ConfigEntryBase> list2 = new List<ConfigEntryBase>();
				foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item4 in config)
				{
					if (Array.IndexOf(item2, item4.Key.Section) >= 0 && SettingsSync.IsSynced(item4.Key) && !Hidden(item4.Key))
					{
						list2.Add(item4.Value);
					}
				}
				if (list2.Count > 0)
				{
					list.Add((item, item3, list2));
				}
			}
			return list;
		}

		public static bool IsScheduled(ConfigEntryBase e, out object v)
		{
			if (NextLevel.TryGetValue(e, out object value))
			{
				v = value;
				return true;
			}
			if (NextRun.TryGetValue(e, out object value2))
			{
				v = value2;
				return true;
			}
			v = null;
			return false;
		}

		public static void Apply(Dictionary<ConfigEntryBase, object> pending)
		{
			Dictionary<ConfigEntryBase, object> dictionary = new Dictionary<ConfigEntryBase, object>();
			foreach (KeyValuePair<ConfigEntryBase, object> item in pending)
			{
				switch (EffectiveTiming(item.Key))
				{
				case When.NextLevel:
					NextLevel[item.Key] = item.Value;
					break;
				case When.NextRun:
					NextRun[item.Key] = item.Value;
					break;
				default:
					dictionary[item.Key] = item.Value;
					break;
				}
			}
			if (dictionary.Count > 0)
			{
				SettingsSync.HostApply(dictionary);
			}
			if (NextLevel.Count + NextRun.Count > 0)
			{
				Plugin.Log.LogInfo((object)$"[settings] {NextLevel.Count} change(s) wait for the next level, {NextRun.Count} for the next run.");
			}
		}

		public static void OnLevelStart()
		{
			if (NextLevel.Count != 0 && (Game.IsMaster() || !Game.IsMultiplayer()))
			{
				Dictionary<ConfigEntryBase, object> changes = new Dictionary<ConfigEntryBase, object>(NextLevel);
				NextLevel.Clear();
				SettingsSync.HostApply(changes);
			}
		}

		public static void OnRunReset()
		{
			if (NextRun.Count + NextLevel.Count == 0 || (!Game.IsMaster() && Game.IsMultiplayer()))
			{
				return;
			}
			Dictionary<ConfigEntryBase, object> dictionary = new Dictionary<ConfigEntryBase, object>(NextRun);
			foreach (KeyValuePair<ConfigEntryBase, object> item in NextLevel)
			{
				dictionary[item.Key] = item.Value;
			}
			NextRun.Clear();
			NextLevel.Clear();
			SettingsSync.HostApply(dictionary);
		}

		public static void OnAck(int actor, int version, string mod)
		{
			//IL_00af: Unknown result type (might be due to invalid IL or missing references)
			Acks[actor] = (version, mod);
			if (!(mod == "") && !(mod == "1.0.100") && Warned.Add(actor))
			{
				string text = Net.PlayerNameOf(actor);
				bool flag = Plugin.Cfg.VersionMismatch.Value == MismatchMode.Kick;
				RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, (SettingsSync.IsOlder(mod) ? (text + " has an older version (" + mod + "; Semibot RPG is RepoRPG's old name) and needs RepoRPG 1.0.100: ") : (text + " has RepoRPG " + mod + " (you have 1.0.100): ")) + (flag ? "removed from the room." : "their mod is paused in your lobby."), (Color?)new Color(1f, 0.6f, 0.4f), "");
				Plugin.Log.LogWarning((object)string.Format("[settings] player {0} ({1}) runs RepoRPG {2}, host {3}: {4}.", actor, text, mod, "1.0.100", flag ? "kicked" : "their mod pauses"));
				if (flag)
				{
					Net.Kick(actor);
				}
			}
		}

		public static bool HasAck(int actor)
		{
			return Acks.ContainsKey(actor);
		}

		public static int AckedCount(int version)
		{
			int num = 0;
			foreach (var value in Acks.Values)
			{
				if (value.version >= version)
				{
					num++;
				}
			}
			return num;
		}

		public static void Forget(int actor)
		{
			Acks.Remove(actor);
			Warned.Remove(actor);
		}

		public static List<PresetInfo> PresetList()
		{
			if (_presets != null && Time.unscaledTime - _presetsAt < 3f)
			{
				return _presets;
			}
			_presetsAt = Time.unscaledTime;
			_presets = ReadPresets();
			return _presets;
		}

		private static void Changed()
		{
			_presets = null;
			_default = null;
		}

		private static List<PresetInfo> ReadPresets()
		{
			List<PresetInfo> list = new List<PresetInfo>();
			try
			{
				if (!Directory.Exists(PresetDir))
				{
					return list;
				}
				string[] files = Directory.GetFiles(PresetDir, "*.preset");
				for (int i = 0; i < files.Length; i++)
				{
					FileInfo fileInfo = new FileInfo(files[i]);
					if (Checked.TryGetValue(fileInfo.FullName, out PresetInfo value) && value.Stamp == fileInfo.LastWriteTimeUtc && value.Size == fileInfo.Length)
					{
						list.Add(value);
						continue;
					}
					PresetInfo presetInfo = Check(fileInfo);
					Checked[fileInfo.FullName] = presetInfo;
					list.Add(presetInfo);
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] the preset folder can't be read: " + ex.Message));
			}
			list.Sort((PresetInfo a, PresetInfo b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
			return list;
		}

		private static PresetInfo Check(FileInfo fi)
		{
			PresetInfo presetInfo = new PresetInfo
			{
				Name = Path.GetFileNameWithoutExtension(fi.Name),
				Path = fi.FullName,
				Stamp = fi.LastWriteTimeUtc,
				Size = fi.Length,
				Saved = fi.LastWriteTime.ToString("yyyy-MM-dd HH:mm")
			};
			try
			{
				Dictionary<string, ConfigEntryBase> dictionary = new Dictionary<string, ConfigEntryBase>(StringComparer.OrdinalIgnoreCase);
				foreach (ConfigEntryBase item in EntriesAndPreset())
				{
					dictionary[KeyOf(item)] = item;
				}
				int num = 0;
				int num2 = 0;
				int num3 = 0;
				int num4 = 0;
				string text = "";
				string[] array = File.ReadAllLines(fi.FullName);
				foreach (string obj in array)
				{
					num4++;
					string text2 = obj.Trim();
					if (text2 == "")
					{
						continue;
					}
					if (text2.StartsWith("#"))
					{
						if (num4 == 1 && text2.StartsWith("# RepoRPG host settings preset") && text2.EndsWith(")"))
						{
							int num5 = text2.LastIndexOf('(');
							if (num5 > 0)
							{
								text = text2.Substring(num5 + 1, text2.Length - num5 - 2);
							}
						}
						continue;
					}
					int num6 = text2.IndexOf('=');
					ConfigEntryBase value;
					if (num6 <= 0 || text2.IndexOf('/') <= 0 || text2.IndexOf('/') > num6)
					{
						num3++;
					}
					else if (dictionary.TryGetValue(text2.Substring(0, num6).Trim(), out value))
					{
						if (Parse(value, text2.Substring(num6 + 1).Trim()) == null)
						{
							num2++;
						}
						else
						{
							num++;
						}
					}
				}
				if (num3 > 0)
				{
					return Invalid(presetInfo, $"{num3} damaged line(s)");
				}
				if (num == 0)
				{
					return Invalid(presetInfo, "no settings in it");
				}
				presetInfo.Valid = true;
				presetInfo.Detail = $"{num} settings" + ((text != "") ? (" · RepoRPG " + text) : "") + ((num2 > 0) ? $" · {num2} out-of-range value(s) skipped" : "");
				if (num2 > 0)
				{
					Plugin.Log.LogWarning((object)$"[presets] '{presetInfo.Name}': {num2} value(s) are out of range for this version and will be skipped.");
				}
			}
			catch (Exception ex)
			{
				return Invalid(presetInfo, "can't be read: " + ex.Message);
			}
			return presetInfo;
		}

		private static PresetInfo Invalid(PresetInfo p, string why)
		{
			p.Valid = false;
			p.Detail = "Invalid: " + why;
			Plugin.Log.LogWarning((object)("[presets] '" + p.Name + "' (" + p.Path + ") is not a usable preset (" + why + "): skipped. It can be deleted on the Host tab."));
			return p;
		}

		public static PresetInfo? Find(string name)
		{
			foreach (PresetInfo item in PresetList())
			{
				if (string.Equals(item.Name, name, StringComparison.OrdinalIgnoreCase))
				{
					return item;
				}
			}
			return null;
		}

		public static string CleanName(string n)
		{
			StringBuilder stringBuilder = new StringBuilder();
			string text = n ?? "";
			foreach (char c in text)
			{
				if (char.IsLetterOrDigit(c) || c == ' ' || c == '-' || c == '_')
				{
					stringBuilder.Append(c);
				}
			}
			string text2 = stringBuilder.ToString().Trim();
			while (text2.Contains("  "))
			{
				text2 = text2.Replace("  ", " ");
			}
			if (text2.Length <= 24)
			{
				return text2;
			}
			return text2.Substring(0, 24).TrimEnd();
		}

		private static void WriteAtomic(string path, string text)
		{
			string text2 = path + ".tmp";
			File.WriteAllText(text2, text);
			if (File.Exists(path))
			{
				try
				{
					File.Replace(text2, path, null);
					return;
				}
				catch (Exception)
				{
					File.Delete(path);
				}
			}
			File.Move(text2, path);
		}

		private static object Shown(ConfigEntryBase e, Dictionary<ConfigEntryBase, object> pending)
		{
			if (!pending.TryGetValue(e, out object value))
			{
				if (!IsScheduled(e, out object v))
				{
					return e.BoxedValue;
				}
				return v;
			}
			return value;
		}

		public static bool Save(string name, Dictionary<ConfigEntryBase, object> pending)
		{
			name = CleanName(name);
			if (name == "")
			{
				return false;
			}
			try
			{
				Directory.CreateDirectory(PresetDir);
				StringBuilder stringBuilder = new StringBuilder();
				stringBuilder.Append("# RepoRPG host settings preset").Append(" (").Append("1.0.100")
					.Append(")\n");
				foreach (var item in Entries())
				{
					foreach (ConfigEntryBase item2 in item.entries)
					{
						stringBuilder.Append(KeyOf(item2)).Append('=').Append(TomlOf(item2, Shown(item2, pending)).Replace("\n", " "))
							.Append('\n');
					}
				}
				ConfigEntry<DifficultyPreset> preset = Plugin.Cfg.Preset;
				stringBuilder.Append(KeyOf((ConfigEntryBase)(object)preset)).Append('=').Append(TomlOf((ConfigEntryBase)(object)preset, Shown((ConfigEntryBase)(object)preset, pending)))
					.Append('\n');
				PresetInfo presetInfo = Find(name);
				string text = ((presetInfo != null) ? presetInfo.Path : Path.Combine(PresetDir, name + ".preset"));
				WriteAtomic(text, stringBuilder.ToString());
				if (presetInfo != null && presetInfo.Name != name)
				{
					MoveFile(text, Path.Combine(PresetDir, name + ".preset"));
				}
				Changed();
				Plugin.Log.LogInfo((object)("[presets] saved '" + name + "'" + ((presetInfo != null) ? " (replaced the old one)" : "") + "."));
				return true;
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] couldn't save '" + name + "': " + ex.Message));
				return false;
			}
		}

		public static int Load(string name, Dictionary<ConfigEntryBase, object> pending)
		{
			PresetInfo presetInfo = Find(name);
			if (presetInfo == null || !presetInfo.Valid)
			{
				Plugin.Log.LogWarning((object)("[presets] '" + name + "' " + ((presetInfo == null) ? "doesn't exist" : "is invalid") + ": not loaded."));
				return -1;
			}
			int num = 0;
			try
			{
				Dictionary<string, string> dictionary = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
				string[] array = File.ReadAllLines(presetInfo.Path);
				foreach (string text in array)
				{
					if (!text.StartsWith("#"))
					{
						int num2 = text.IndexOf('=');
						if (num2 > 0)
						{
							dictionary[text.Substring(0, num2).Trim()] = text.Substring(num2 + 1).Trim();
						}
					}
				}
				foreach (ConfigEntryBase item in EntriesAndPreset())
				{
					if (dictionary.TryGetValue(KeyOf(item), out var value))
					{
						object obj = Parse(item, value);
						if (obj == null)
						{
							Plugin.Log.LogWarning((object)("[presets] '" + name + "': " + KeyOf(item) + " = '" + value + "' is invalid, skipped."));
						}
						else if (object.Equals(obj, item.BoxedValue))
						{
							pending.Remove(item);
						}
						else
						{
							pending[item] = obj;
							num++;
						}
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] couldn't load '" + name + "': " + ex.Message));
				return -1;
			}
			Plugin.Log.LogInfo((object)$"[presets] loaded '{name}': {num} value(s) differ (pending until Apply).");
			return num;
		}

		public static bool Rename(string from, string to, bool replace)
		{
			to = CleanName(to);
			PresetInfo presetInfo = Find(from);
			if (presetInfo == null || to == "")
			{
				return false;
			}
			try
			{
				string dst = Path.Combine(PresetDir, to + ".preset");
				PresetInfo presetInfo2 = Find(to);
				if (presetInfo2 != null && presetInfo2 != presetInfo)
				{
					if (!replace)
					{
						return false;
					}
					File.Delete(presetInfo2.Path);
				}
				MoveFile(presetInfo.Path, dst);
				if (string.Equals(DefaultName, presetInfo.Name, StringComparison.OrdinalIgnoreCase))
				{
					SetDefault(to);
				}
				else if (presetInfo2 != null && string.Equals(DefaultName, presetInfo2.Name, StringComparison.OrdinalIgnoreCase))
				{
					SetDefault("");
				}
				Changed();
				Plugin.Log.LogInfo((object)("[presets] renamed '" + presetInfo.Name + "' to '" + to + "'."));
				return true;
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] couldn't rename '" + from + "' to '" + to + "': " + ex.Message));
				Changed();
				return false;
			}
		}

		private static void MoveFile(string src, string dst)
		{
			if (!string.Equals(src, dst, StringComparison.Ordinal))
			{
				if (string.Equals(src, dst, StringComparison.OrdinalIgnoreCase))
				{
					string text = src + ".rename";
					File.Move(src, text);
					File.Move(text, dst);
				}
				else
				{
					File.Move(src, dst);
				}
			}
		}

		public static bool Delete(string name)
		{
			PresetInfo presetInfo = Find(name);
			if (presetInfo == null)
			{
				return false;
			}
			try
			{
				File.Delete(presetInfo.Path);
				Checked.Remove(presetInfo.Path);
				if (string.Equals(DefaultName, presetInfo.Name, StringComparison.OrdinalIgnoreCase))
				{
					SetDefault("");
				}
				Changed();
				Plugin.Log.LogInfo((object)("[presets] deleted '" + presetInfo.Name + "' (" + presetInfo.Path + ")."));
				return true;
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] couldn't delete '" + name + "': " + ex.Message));
				Changed();
				return false;
			}
		}

		public static bool IsDefault(PresetInfo p)
		{
			return string.Equals(DefaultName, p.Name, StringComparison.OrdinalIgnoreCase);
		}

		public static void SetDefault(string name)
		{
			try
			{
				if (name == "")
				{
					if (File.Exists(DefaultFile))
					{
						File.Delete(DefaultFile);
					}
				}
				else
				{
					Directory.CreateDirectory(PresetDir);
					WriteAtomic(DefaultFile, name);
				}
				Plugin.Log.LogInfo((object)((name == "") ? "[presets] no default preset." : ("[presets] default preset: '" + name + "' (loaded when you host).")));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[presets] couldn't set the default preset: " + ex.Message));
			}
			_default = null;
		}

		public static void TickDefault()
		{
			if (Time.frameCount % 30 != 0)
			{
				return;
			}
			string text = null;
			try
			{
				if (PhotonNetwork.InRoom && !PhotonNetwork.OfflineMode)
				{
					Room currentRoom = PhotonNetwork.CurrentRoom;
					text = ((currentRoom != null) ? currentRoom.Name : null);
				}
			}
			catch
			{
			}
			if (text == null || text == _defaultRoom)
			{
				return;
			}
			if (!PhotonNetwork.IsMasterClient)
			{
				_defaultRoom = text;
			}
			else
			{
				if (!Game.InLobbyMenu())
				{
					return;
				}
				_defaultRoom = text;
				string defaultName = DefaultName;
				if (defaultName == "")
				{
					return;
				}
				Dictionary<ConfigEntryBase, object> pending = new Dictionary<ConfigEntryBase, object>();
				int num = Load(defaultName, pending);
				if (num < 0)
				{
					RpgRuntime.Instance?.PresetNote("Default preset '" + defaultName + "' couldn't be loaded", good: false);
					return;
				}
				if (num > 0)
				{
					Apply(pending);
				}
				Plugin.Log.LogInfo((object)$"[presets] default preset '{defaultName}' applied for this lobby ({num} change(s)).");
				RpgRuntime.Instance?.OnDefaultPresetApplied(defaultName, num);
			}
		}

		public static string TomlOf(ConfigEntryBase e, object v)
		{
			try
			{
				return TomlTypeConverter.ConvertToString(v, e.SettingType);
			}
			catch
			{
				return v?.ToString() ?? "";
			}
		}

		public static object? Parse(ConfigEntryBase e, string s)
		{
			try
			{
				object obj = TomlTypeConverter.ConvertToValue(s, e.SettingType);
				ConfigDescription description = e.Description;
				AcceptableValueBase val = ((description != null) ? description.AcceptableValues : null);
				return (val == null || val.IsValid(obj)) ? obj : null;
			}
			catch
			{
				return null;
			}
		}
	}
	internal static class LateJoinHost
	{
		private sealed class FieldInfoCache
		{
			public FieldInfo? RemoveFilter;

			public FieldInfo? KeyByteSeven;

			public FieldInfo? CleanOptions;

			public MethodInfo? RaiseInternal;
		}

		private sealed class Joiner
		{
			public int Actor;

			public string Name = "";

			public float Since;

			public bool Synced;

			public int Where;
		}

		public const int WhereTruck = 0;

		public const int WhereShop = 1;

		public const int WhereLevel = 2;

		public const float PickSeconds = 60f;

		private static int _otherMod = -1;

		private static float _nextTick;

		private static int _appliedOpen = -1;

		private static bool _publicLobby;

		private static bool _publicKnown;

		private static bool _closing;

		private static bool _toldOtherMod;

		private static Object? _closingDirector;

		private static FieldInfoCache? _cache;

		private static readonly FieldInfo? PersistField = typeof(PhotonView).GetField("PersistAcrossSceneReset", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);

		private static List<int>? _oldViews;

		private static bool _sceneHooked;

		private static readonly HashSet<int> _destroyed = new HashSet<int>();

		private static readonly HashSet<int> _hinges = new HashSet<int>();

		private static readonly Dictionary<int, Joiner> _pending = new Dictionary<int, Joiner>();

		private static readonly Dictionary<int, float> _pickUntil = new Dictionary<int, float>();

		private static float _syncBusyUntil;

		private static readonly Dictionary<int, HashSet<int>> _visionChecked = new Dictionary<int, HashSet<int>>();

		private static List<PlayerAvatar>? _held;

		private static readonly Dictionary<int, float> _spawnAsked = new Dictionary<int, float>();

		public static string OtherModName { get; private set; } = "";

		public static bool OtherModInstalled
		{
			get
			{
				if (_otherMod >= 0)
				{
					return _otherMod == 1;
				}
				_otherMod = 0;
				try
				{
					foreach (KeyValuePair<string, PluginInfo> pluginInfo in Chainloader.PluginInfos)
					{
						string text = (pluginInfo.Key ?? "").ToLowerInvariant();
						PluginInfo value = pluginInfo.Value;
						object obj;
						if (value == null)
						{
							obj = null;
						}
						else
						{
							BepInPlugin metadata = value.Metadata;
							obj = ((metadata != null) ? metadata.Name : null);
						}
						if (obj == null)
						{
							obj = "";
						}
						string text2 = ((string)obj).ToLowerInvariant();
						if (text.Contains("latejoin") || text2.Contains("latejoin") || text2.Contains("late join") || text == "nilaier.late" || text2 == "l.a.t.e")
						{
							_otherMod = 1;
							PluginInfo value2 = pluginInfo.Value;
							object obj2;
							if (value2 == null)
							{
								obj2 = null;
							}
							else
							{
								BepInPlugin metadata2 = value2.Metadata;
								obj2 = ((metadata2 != null) ? metadata2.Name : null);
							}
							if (obj2 == null)
							{
								obj2 = pluginInfo.Key ?? "";
							}
							OtherModName = (string)obj2;
							Plugin.Log.LogInfo((object)("[late join] '" + OtherModName + "' is installed: RepoRPG's own late join stands down (its catch-up still works)."));
							break;
						}
					}
				}
				catch
				{
				}
				return _otherMod == 1;
			}
		}

		public static bool Active
		{
			get
			{
				if (CatchUpActive)
				{
					return !OtherModInstalled;
				}
				return false;
			}
		}

		public static bool CatchUpActive
		{
			get
			{
				if (Plugin.Cfg.LateJoin.Value && Game.IsMultiplayer() && PhotonNetwork.InRoom)
				{
					return PhotonNetwork.IsMasterClient;
				}
				return false;
			}
		}

		public static bool SkipPlayerSpawn
		{
			get
			{
				if (_held != null)
				{
					return _held.Count == 0;
				}
				return false;
			}
		}

		public static int WhereNow()
		{
			if (!Game.InLevel())
			{
				return Game.InShopLevel() ? 1 : 0;
			}
			return 2;
		}

		private static bool SceneAllowed()
		{
			ModConfig cfg = Plugin.Cfg;
			if (Game.InLevel())
			{
				return cfg.LateJoinLevels.Value;
			}
			if (Game.InShopLevel())
			{
				return cfg.LateJoinShop.Value;
			}
			if (Game.InLobby())
			{
				return cfg.LateJoinTruck.Value;
			}
			return false;
		}

		public static void Tick()
		{
			//IL_00c7: Unknown result type (might be due to invalid IL or missing references)
			if (Time.unscaledTime < _nextTick)
			{
				return;
			}
			_nextTick = Time.unscaledTime + 1f;
			if (!Game.IsMultiplayer() || !PhotonNetwork.InRoom)
			{
				_appliedOpen = -1;
				_pending.Clear();
			}
			else
			{
				if (!PhotonNetwork.IsMasterClient)
				{
					return;
				}
				if (Game.InLobbyMenu())
				{
					_publicLobby = Game.Get(GameManagerInstance(), "connectRandom", fallback: false);
					_publicKnown = true;
					_appliedOpen = 0;
					_closing = false;
					return;
				}
				if (OtherModInstalled && !_toldOtherMod && Plugin.Cfg.LateJoin.Value)
				{
					_toldOtherMod = true;
					RpgRuntime.Instance?.Notify(RpgRuntime.PopupKind.Other, "Late join: " + OtherModName + " handles joining; RepoRPG catches joiners up", (Color?)new Color(0.6f, 0.9f, 1f), "");
				}
				TickPending();
				if (!Plugin.Cfg.LateJoin.Value || OtherModInstalled)
				{
					if (_appliedOpen == 1)
					{
						SetOpen(open: false, "late join turned off");
					}
					return;
				}
				bool flag = !Game.IsLoading() && LevelLive() && !RunGameOver();
				if (_closing && flag && (object)GameDirector.instance != _closingDirector)
				{
					_closing = false;
				}
				bool flag2 = flag && !_closing && SceneAllowed();
				if ((flag2 ? 1 : 0) != _appliedOpen)
				{
					SetOpen(flag2, flag2 ? "scene live" : "scene not live or not allowed");
				}
			}
		}

		private static bool LevelLive()
		{
			//IL_0010: Unknown result type (might be due to invalid IL or missing references)
			//IL_0016: Invalid comparison between Unknown and I4
			try
			{
				GameDirector instance = GameDirector.instance;
				return (Object)(object)instance != (Object)null && (int)instance.currentState == 2;
			}
			catch
			{
				return false;
			}
		}

		private static bool RunGameOver()
		{
			return Game.Get(RunManager.instance, "gameOver", fallback: false);
		}

		private static object? GameManagerInstance()
		{
			Type type = AccessTools.TypeByName("GameManager");
			FieldInfo fieldInfo = ((type == null) ? null : AccessTools.Field(type, "instance"));
			try
			{
				return fieldInfo?.GetValue(null);
			}
			catch
			{
				return null;
			}
		}

		public static void OnTransition()
		{
			if (Game.IsMultiplayer() && PhotonNetwork.InRoom && PhotonNetwork.IsMasterClient && !Game.InLobbyMenu())
			{
				if (!_closing)
				{
					_closingDirector = (Object?)(object)GameDirector.instance;
				}
				_closing = true;
				if (_appliedOpen == 1)
				{
					SetOpen(open: false, "level change");
				}
			}
		}

		private static void SetOpen(bool open, string why)
		{
			_appliedOpen = (open ? 1 : 0);
			try
			{
				MethodInfo methodInfo = AccessTools.Method(typeof(PhotonNetwork), "SetRoomOpen", new Type[1] { typeof(bool) }, (Type[])null);
				if (methodInfo != null)
				{
					methodInfo.Invoke(null, new object[1] { open });
				}
				else if (PhotonNetwork.CurrentRoom != null)
				{
					PhotonNetwork.CurrentRoom.IsOpen = open;
				}
				if (_publicKnown && _publicLobby && PhotonNetwork.CurrentRoom != null)
				{
					PhotonNetwork.CurrentRoom.IsVisible = open;
				}
			}
			catch (Exception ex)
			{
				Game.WarnOnce("[late join] couldn't " + (open ? "open" : "close") + " the room: " + ex.Message);
			}
			try
			{
				Type type = AccessTools.TypeByName("SteamLobbyManager");
				object obj = ((type == null) ? null : AccessTools.Field(type, "instance")?.GetValue(null));
				if (obj != null && (!_publicKnown || !_publicLobby))
				{
					if (open)
					{
						AccessTools.Method(type, "UnlockLobby", new Type[1] { typeof(bool) }, (Type[])null)?.Invoke(obj, new object[1] { false });
					}
					else
					{
						AccessTools.Method(type, "LockLobby", Type.EmptyTypes, (Type[])null)?.Invoke(obj, null);
					}
				}
			}
			catch (Exception ex2)
			{
				Game.WarnOnce("[late join] couldn't " + (open ? "unlock" : "lock") + " the Steam lobby: " + ex2.Message);
			}
			Plugin.Log.LogInfo((object)("[late join] lobby " + (open ? "open" : "closed") + " (" + why + ")."));
		}

		public static void BeforeLevelChange()
