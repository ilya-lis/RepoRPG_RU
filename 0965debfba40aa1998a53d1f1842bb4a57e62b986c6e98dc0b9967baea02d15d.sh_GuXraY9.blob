		private static float TalentSum(ClassDef c, ClassProgress prog, string stat, int nb)
		{
			float num = 0f;
			for (int i = 0; i < nb; i++)
			{
				NodeDef[] nodes = c.branches[i].nodes;
				foreach (NodeDef nodeDef in nodes)
				{
					int num2 = prog.RankOf(nodeDef.id);
					if (num2 <= 0)
					{
						continue;
					}
					EffectDef[] effects = nodeDef.effects;
					foreach (EffectDef effectDef in effects)
					{
						if (string.Equals(effectDef.stat, stat, StringComparison.OrdinalIgnoreCase))
						{
							num += effectDef.value * (float)num2;
						}
					}
				}
			}
			return num;
		}

		private static string StatName(Stat s)
		{
			return Regex.Replace(StatInfo.Describe(s, 1f), "^\\+1(m|s|%)?\\s*", "");
		}

		private static string StatUnit(Stat s)
		{
			Match match = Regex.Match(StatInfo.Describe(s, 1f), "^\\+1(m|s|%)");
			if (!match.Success)
			{
				return "";
			}
			return match.Groups[1].Value;
		}

