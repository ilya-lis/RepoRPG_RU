			{
				return _visibleGroups;
			}
			List<(string, List<ClassDef>)> list = new List<(string, List<ClassDef>)>();
			string q = _classQuery.Trim().ToLowerInvariant();
			List<ClassDef>[] array = new List<ClassDef>[4];
			foreach (var (text2, list2) in ClassGroups())
			{
				if (_roleFilter > 0 && !string.Equals(text2, RoleFilters[_roleFilter], StringComparison.OrdinalIgnoreCase))
				{
					continue;
				}
				List<ClassDef> list3 = ((q == "") ? list2 : list2.FindAll((ClassDef c) => c.name.ToLowerInvariant().Contains(q) || c.role.ToLowerInvariant().Contains(q) || Complexity.Name(c).ToLowerInvariant().Contains(q)));
				if (_cxFilter > 0)
				{
					list3 = list3.FindAll((ClassDef c) => Complexity.Of(c) == _cxFilter);
				}
				if (list3.Count == 0)
				{
					continue;
				}
				if (!_cxSort)
				{
					list.Add((text2, list3));
					continue;
				}
				foreach (ClassDef item in list3)
				{
					List<ClassDef>[] array2 = array;
					int num = Complexity.Of(item);
					(array2[num] ?? (array2[num] = new List<ClassDef>())).Add(item);
				}
			}
			if (_cxSort)
			{
				for (int num2 = 1; num2 <= 3; num2++)
				{
					if (array[num2] != null)
					{
						list.Add(("Complexity: " + Complexity.Names[num2], array[num2]));
					}
				}
			}
			_visibleGroups = list;
			_visibleKey = text;
			return list;
		}

		private string ClassSummary(ClassDef c)
		{
			if (_classSummary.TryGetValue(c.id, out string value))
			{
				return value;
			}
			string text = c.desc ?? "";
			int num = text.IndexOfAny(new char[3] { '.', ';', ':' });
			if (num > 0)
			{
				text = text.Substring(0, num);
			}
			if (text.Length > 46)
			{
				text = text.Substring(0, 44).TrimEnd() + "…";
			}
			value = ((text == "") ? c.role : text);
			_classSummary[c.id] = value;
			return value;
		}

