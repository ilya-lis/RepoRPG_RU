		internal void OnTradeC(int id, int state, int other, string otherName, string itemJson, string removeUid, string text)
		{
			//IL_00ac: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ec: Unknown result type (might be due to invalid IL or missing references)
			//IL_028d: Unknown result type (might be due to invalid IL or missing references)
			GearItem gearItem = null;
			if (itemJson != "")
			{
				try
				{
					gearItem = Json.Deserialize<GearItem>(itemJson);
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("[trade] unreadable item: " + ex.Message));
				}
			}
			switch (state)
			{
			case 1:
			case 2:
				_tradeId = id;
				_tradeState = (byte)state;
				_tradeOtherName = otherName;
				_tradeItemText = ((gearItem != null) ? TradeItemText(gearItem) : "?");
				_tradeUntil = Time.unscaledTime + 60f;
				if (state == 1)
				{
					Notify(PopupKind.Other, otherName + " offers you a gear trade (Shop tab, Research)", (Color?)new Color(0.55f, 0.9f, 0.75f), "geartrade");
					MenuSound(UiSound.Tick);
				}
				break;
			case 3:
			{
				RunSave data = _store.Data;
				GearItem gearItem2 = ((removeUid != "") ? data.FindItem(removeUid) : null);
				string text2 = gearItem2?.name ?? "";
				if (gearItem2 != null)
				{
					Unequip(gearItem2);
					data.inventory.Remove(gearItem2);
				}
				_gearRowText.Remove(removeUid);
				if (removeUid != "" && !data.salvaged.Contains(removeUid))
				{
					data.salvaged.Add(removeUid);
				}
				if (gearItem != null && gearItem.uid != "" && data.FindItem(gearItem.uid) == null)
				{
					GearItem gearItem3 = gearItem;
					if (gearItem3.effects == null)
					{
						gearItem3.effects = Array.Empty<EffectDef>();
					}
					gearItem3 = gearItem;
					if (gearItem3.modules == null)
					{
						gearItem3.modules = Array.Empty<string>();
					}
					gearItem3 = gearItem;
					if (gearItem3.hidden == null)
					{
						gearItem3.hidden = Array.Empty<EffectDef>();
					}
					data.inventory.Add(gearItem);
				}
				_statsDirty = true;
				_store.MarkDirty();
				_store.SaveNow();
				ClearTrade();
				Plugin.Log.LogInfo((object)("[trade] done with " + otherName + ": gave " + ((text2 != "") ? text2 : removeUid) + ", got " + (gearItem?.name ?? "?") + "."));
				Notify(PopupKind.Loot, "Trade done: you got " + (gearItem?.name ?? "an item") + " from " + otherName, (Color?)new Color(0.55f, 0.9f, 0.75f), "");
				MenuSound(UiSound.Confirm);
				break;
			}
			default:
				if (id == 0 || id == _tradeId || _tradeState == 0)
				{
					ClearTrade();
				}
				if (text != "")
				{
					Toast("Gear trade: " + text, new Color(1f, 0.6f, 0.45f));
				}
				break;
			}
		}

		private static bool TradeLocked(string uid)
		{
			if (_trade != null && Time.unscaledTime < _trade.Until + 2f)
			{
				return _trade.FromUid == uid;
			}
			return false;
		}

		private static bool IsLocalActor(int actor)
		{
			if (Game.IsMultiplayer())
			{
				return actor == ClassClaims.LocalActor;
			}
			return true;
		}

		private static RunSave? HostRunOf(int actor)
		{
			if (IsLocalActor(actor))
			{
				return Instance?._store.Data;
			}
			PlayerAvatar val = ContractHost.PlayerOf(actor);
			string text = (((Object)(object)val != (Object)null) ? Game.SteamId(val) : "");
			if (text == "" || RunStore.IsTempKey(RunInfo.Key))
			{
				return null;
			}
			return SaveBook.Get(RunInfo.Key, text);
		}

		private static string TradeBlock(RunSave run, GearItem? g)
		{
			if (g == null)
			{
				return "the host doesn't have that item (try again in a moment)";
			}
			if (run.salvaged.Contains(g.uid))
			{
				return "that item was salvaged";
			}
			if (run.IsEquipped(g))
			{
				return "unequip it first";
			}
			if (Starters.Is(g))
			{
				return "class starter items can't be traded";
			}
			if (GearX.Soulbound(g))
			{
				return "soulbound items can't be traded";
			}
			return "";
		}

		private static void TellTrade(int actor, int id, int state, int other, string otherName, string itemJson, string removeUid, string text)
		{
			if (IsLocalActor(actor))
			{
				Instance?.OnTradeC(id, state, other, otherName, itemJson, removeUid, text);
			}
			else
			{
				Net.SendTradeState(actor, id, state, other, otherName, itemJson, removeUid, text);
			}
		}

		private static void CancelTrade(GearTrade t, string why)
		{
			if (_trade == t)
			{
				_trade = null;
			}
			TellTrade(t.From, t.Id, 4, t.To, t.ToName, "", "", why);
			TellTrade(t.To, t.Id, 4, t.From, t.FromName, "", "", why);
			Plugin.Log.LogInfo((object)("[trade] " + t.FromName + " -> " + t.ToName + " cancelled: " + why + "."));
		}

		private static void HostTradeTick()
		{
			GearTrade trade = _trade;
			if (trade != null)
			{
				if (Time.unscaledTime >= trade.Until)
				{
					CancelTrade(trade, "no answer in time");
				}
				else if (Game.InLevel())
				{
					CancelTrade(trade, "a level started");
				}
				else if ((Object)(object)ContractHost.PlayerOf(trade.From) == (Object)null || (Object)(object)ContractHost.PlayerOf(trade.To) == (Object)null)
				{
					CancelTrade(trade, "a player left");
				}
			}
		}

		private static GearItem CloneTradeGear(GearItem g)
		{
			GearItem gearItem = Json.Deserialize<GearItem>(Json.Serialize(g, pretty: false));
			gearItem.uid = Guid.NewGuid().ToString("N").Substring(0, 12);
			return gearItem;
		}

		internal static void HostTradeRequest(int actor, int op, int a, string s)
		{
			if (!Game.IsMaster())
			{
				return;
			}
			HostTradeTick();
			string text = ClassClaims.NameOf(actor);
			switch (op)
			{
			case 0:
			{
				string text2 = ((!Research.On) ? "research is off in this lobby" : (Game.InLevel() ? "trades happen in the shop" : ((_trade != null) ? "another trade is open right now (try again in a moment)" : ((a == actor || (Object)(object)ContractHost.PlayerOf(a) == (Object)null) ? "that teammate isn't here" : ""))));
				RunSave runSave = ((text2 == "") ? HostRunOf(actor) : null);
				RunSave runSave2 = ((text2 == "") ? HostRunOf(a) : null);
				if (text2 == "" && (runSave == null || runSave2 == null))
				{
					text2 = "the host can't see the gear yet (try again in a moment)";
				}
				GearItem gearItem = runSave?.FindItem(s);
				if (text2 == "" && runSave != null)
				{
					text2 = TradeBlock(runSave, gearItem);
				}
				if (text2 != "" || gearItem == null)
				{
					TellTrade(actor, 0, 4, a, "", "", "", (text2 != "") ? text2 : "that item can't be traded");
					break;
				}
				GearTrade gearTrade = (_trade = new GearTrade
				{
					Id = ++_tradeSeq,
					From = actor,
					To = a,
					FromUid = gearItem.uid,
					FromName = text,
					ToName = ClassClaims.NameOf(a),
					Until = Time.unscaledTime + 60f
				});
				string itemJson = Json.Serialize(gearItem, pretty: false);
				TellTrade(a, gearTrade.Id, 1, actor, gearTrade.FromName, itemJson, "", "");
				TellTrade(actor, gearTrade.Id, 2, a, gearTrade.ToName, itemJson, "", "");
				Plugin.Log.LogInfo((object)$"[trade] {gearTrade.FromName} offers {gearItem.name} to {gearTrade.ToName} (trade {gearTrade.Id}).");
				break;
			}
			case 1:
			{
				GearTrade trade2 = _trade;
				if (trade2 == null || trade2.Id != a || actor != trade2.To)
				{
					TellTrade(actor, a, 4, 0, "", "", "", "that trade is no longer open");
					break;
				}
				if (Game.InLevel())
				{
					CancelTrade(trade2, "a level started");
					break;
				}
				RunSave runSave3 = HostRunOf(trade2.From);
				RunSave runSave4 = HostRunOf(trade2.To);
				if (runSave3 == null || runSave4 == null)
				{
					CancelTrade(trade2, "the host can't see the gear");
					break;
				}
				GearItem gearItem2 = runSave3.FindItem(trade2.FromUid);
				GearItem gearItem3 = runSave4.FindItem(s);
				string text3 = TradeBlock(runSave3, gearItem2);
				if (text3 != "")
				{
					text3 = "the offered item: " + text3;
				}
				else
				{
					text3 = TradeBlock(runSave4, gearItem3);
					if (text3 != "")
					{
						text3 = "your item: " + text3;
					}
				}
				if (text3 != "" || gearItem2 == null || gearItem3 == null)
				{
					CancelTrade(trade2, (text3 != "") ? text3 : "an item is missing");
					break;
				}
				GearItem gearItem4 = CloneTradeGear(gearItem2);
				GearItem gearItem5 = CloneTradeGear(gearItem3);
				runSave3.inventory.Remove(gearItem2);
				if (!runSave3.salvaged.Contains(gearItem2.uid))
				{
					runSave3.salvaged.Add(gearItem2.uid);
				}
				runSave3.inventory.Add(gearItem5);
				runSave4.inventory.Remove(gearItem3);
				if (!runSave4.salvaged.Contains(gearItem3.uid))
				{
					runSave4.salvaged.Add(gearItem3.uid);
				}
				runSave4.inventory.Add(gearItem4);
				_trade = null;
				if (!IsLocalActor(trade2.From) || !IsLocalActor(trade2.To))
				{
					SaveBook.MarkDirty();
				}
				Plugin.Log.LogInfo((object)$"[trade] {trade2.FromName} gave {gearItem2.name}, {trade2.ToName} gave {gearItem3.name} (trade {trade2.Id}).");
				TellTrade(trade2.From, trade2.Id, 3, trade2.To, trade2.ToName, Json.Serialize(gearItem5, pretty: false), gearItem2.uid, "");
				TellTrade(trade2.To, trade2.Id, 3, trade2.From, trade2.FromName, Json.Serialize(gearItem4, pretty: false), gearItem3.uid, "");
				break;
			}
			default:
			{
				GearTrade trade = _trade;
				if (trade != null && trade.Id == a && (actor == trade.From || actor == trade.To))
				{
					CancelTrade(trade, (actor == trade.From) ? (text + " cancelled the offer") : (text + " declined"));
				}
				break;
			}
			}
		}

		private ResearchEconSave Econ(RunSave run)
		{
			ResearchEconSave researchEconSave = run.econ ?? (run.econ = new ResearchEconSave());
			if (_resEEconFor != run)
			{
				_resEEconFor = run;
				ResearchEconSave researchEconSave2 = researchEconSave;
				if (researchEconSave2.pawned == null)
				{
					researchEconSave2.pawned = new List<PawnTicket>();
				}
				researchEconSave.pawned.RemoveAll((PawnTicket t) => t == null || t.item == null);
				researchEconSave2 = researchEconSave;
				if (researchEconSave2.futures == null)
				{
					researchEconSave2.futures = new List<FuturesOrder>();
				}
				researchEconSave.futures.RemoveAll((FuturesOrder f) => f == null);
				foreach (PawnTicket item in researchEconSave.pawned)
				{
					PawnTicket current;
					PawnTicket pawnTicket = (current = item);
					if (current.uid == null)
					{
						current.uid = "";
					}
					ResolveE(pawnTicket.item);
				}
				if (researchEconSave.nextFeatured != null)
				{
					ResolveE(researchEconSave.nextFeatured);
				}
				if (researchEconSave.proto != null)
				{
					ResolveE(researchEconSave.proto);
				}
			}
			return researchEconSave;
		}

		private static void ResolveE(GearItem g)
		{
			GearItem gearItem = g;
			if (gearItem.modules == null)
			{
				gearItem.modules = Array.Empty<string>();
			}
			gearItem = g;
			if (gearItem.behavior == null)
			{
				gearItem.behavior = "";
			}
			gearItem = g;
			if (gearItem.unique == null)
			{
				gearItem.unique = "";
			}
			gearItem = g;
			if (gearItem.set == null)
			{
				gearItem.set = "";
			}
			gearItem = g;
			if (gearItem.name == null)
			{
				gearItem.name = "";
			}
			gearItem = g;
			if (gearItem.slot == null)
			{
				gearItem.slot = "";
			}
			gearItem = g;
			if (gearItem.cursed == null)
			{
				gearItem.cursed = "";
			}
			gearItem = g;
			if (gearItem.starter == null)
			{
				gearItem.starter = "";
			}
			string classId = "gear " + g.name;
			gearItem = g;
			ClassDatabase.ResolveAll(classId, gearItem.effects ?? (gearItem.effects = Array.Empty<EffectDef>()));
			string classId2 = "gear " + g.name;
			gearItem = g;
			ClassDatabase.ResolveAll(classId2, gearItem.hidden ?? (gearItem.hidden = Array.Empty<EffectDef>()));
		}

		private static GearItem CopyE(GearItem g)
		{
			GearItem gearItem = CloneGear(g);
			gearItem.cursed = g.cursed;
			gearItem.cursedLines = g.cursedLines;
			gearItem.starter = g.starter;
			return gearItem;
		}

