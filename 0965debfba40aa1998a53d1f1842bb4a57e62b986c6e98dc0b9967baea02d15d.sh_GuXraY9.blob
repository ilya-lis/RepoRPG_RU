					d.Name = vOpt.Name;
					if (vOpt.Mine)
					{
						d.Status.Add((UiStatus.Selected, "Your vote"));
					}
					else if (!vOpt.Enabled && vOpt.Why != "")
					{
						d.Status.Add((UiStatus.Locked, vOpt.Why.TrimEnd('.')));
					}
					d.NowHead = "WHAT IT DOES";
					d.Now = vOpt.Full;
					d.NextHead = "RULES";
					d.NextNote = ((vCard.Deadline == "countdown") ? "The vote closes when its timer runs out." : (vCard.Deadline + ".")) + " " + vCard.Rules + (vCard.Personal ? "" : " You can change your vote until it closes.");
					if (!vCard.Personal)
					{
						d.NeedsHead = "WHO VOTED FOR IT";
						d.Needs = WhoText(vCard, b);
					}
					int oi = b;
					VCard cc = vCard;
					d.Act(vOpt.Mine ? "Your vote" : (vCard.Personal ? "Take it" : (vCard.Opts.Exists((VOpt x) => x.Mine) ? "Change vote to this" : "Vote for this")), BtnKind.Primary, vOpt.Enabled && !vOpt.Mine, delegate
					{
						CastVote(cc, oi);
					}, vOpt.Mine ? "You voted for this." : vOpt.Why);
					return;
				}
				d.Type = vCard.Kind;
				d.Name = vCard.Title;
				d.Status.Add(vCard.Mine ? (UiStatus.Pending, vCard.Personal ? "Waiting for you" : "Waiting for your vote") : (UiStatus.Selected, vCard.Personal ? "Chosen" : "You've voted"));
				if (!vCard.Personal)
				{
					d.Status.Add((UiStatus.Available, $"{vCard.Votes}/{vCard.Voters} voted"));
				}
				d.NowHead = "OPTIONS";
				StringBuilder stringBuilder = new StringBuilder();
				foreach (VOpt opt in vCard.Opts)
				{
					if (stringBuilder.Length > 0)
					{
						stringBuilder.Append("\n\n");
					}
					stringBuilder.Append(opt.Full).Append(opt.Mine ? "  <color=#7fb8ff>(your vote)</color>" : "");
				}
				d.Now = stringBuilder.ToString();
				d.NextHead = "RULES";
				d.NextNote = ((vCard.Deadline == "countdown") ? "The vote closes when its timer runs out." : (vCard.Deadline + ".")) + " " + vCard.Rules + (vCard.Personal ? "" : " You can change your vote until it closes.");
				if (!vCard.Personal)
				{
					d.NeedsHead = "WHO VOTED";
					d.Needs = WhoText(vCard, -1);
				}
				for (int num2 = 0; num2 < vCard.Opts.Count; num2++)
				{
					VOpt vOpt2 = vCard.Opts[num2];
					int oi2 = num2;
					VCard cc2 = vCard;
					d.Act(vOpt2.Mine ? (vOpt2.Name + " (your vote)") : vOpt2.Name, (!vOpt2.Mine) ? BtnKind.Primary : BtnKind.Secondary, vOpt2.Enabled && !vOpt2.Mine, delegate
					{
						CastVote(cc2, oi2);
					}, vOpt2.Mine ? "Your vote." : vOpt2.Why);
				}
			}
		}

		private string WhoText(VCard c, int oi)
		{
			StringBuilder stringBuilder = new StringBuilder();
			if (c.Public && OptsShowVoters(c))
			{
				for (int i = 0; i < c.Opts.Count; i++)
				{
					if (oi >= 0 && i != oi)
					{
						continue;
					}
					List<string> list = new List<string>();
					for (int j = 0; j + 1 < c.By.Length; j += 2)
					{
						if (c.By[j + 1] == i)
						{
							list.Add(ClassClaims.NameOf(c.By[j]));
						}
					}
					if (oi < 0)
					{
						stringBuilder.Append("<b>" + c.Opts[i].Name + "</b>: ");
					}
					stringBuilder.Append((list.Count > 0) ? string.Format("{0} - {1}", list.Count, string.Join(", ", list)) : "nobody yet").Append('\n');
				}
			}
			else
			{
				List<string> list2 = new List<string>();
				for (int k = 0; k + 1 < c.By.Length; k += 2)
				{
					list2.Add(ClassClaims.NameOf(c.By[k]));
				}
				stringBuilder.Append((list2.Count > 0) ? ("Voted: " + string.Join(", ", list2) + "\n") : "Nobody has voted yet.\n");
				if (c.By.Length != 0 && !c.Public)
				{
					stringBuilder.Append("<color=#9a9ca0>The host keeps votes private (Team/VotesShowWho): who voted, not for what.</color>\n");
				}
			}
			List<string> list3 = new List<string>();
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item == (Object)null)
				{
					continue;
				}
				int num = Game.ActorNumber(item);
				bool flag = false;
				for (int l = 0; l + 1 < c.By.Length; l += 2)
				{
					if (c.By[l] == num)
					{
						flag = true;
						break;
					}
				}
				if (!flag)
				{
					list3.Add(ClassClaims.NameOf(num));
				}
			}
			if (list3.Count > 0)
			{
				stringBuilder.Append("<color=#ffd75a>Waiting for:</color> " + string.Join(", ", list3));
			}
			else if (c.Votes > 0 && c.By.Length == 0)
			{
				stringBuilder.Append($"{c.Votes} vote(s) cast.");
			}
			return stringBuilder.ToString().TrimEnd('\n');
		}
	}
