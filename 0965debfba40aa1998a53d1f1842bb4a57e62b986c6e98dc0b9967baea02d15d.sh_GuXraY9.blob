	internal static class OverclockStateTime
	{
		public static void Scale(ItemGun gun, string state)
		{
			float num = OverclockState.FireMult((Component)(object)gun);
			if (!(num <= 1.001f))
			{
				float num2 = Game.Get(gun, "stateTimeMax", 0f);
				if (!(num2 <= 0f))
				{
					Game.Set(gun, "stateTimeMax", num2 / num);
					OverclockState.Note((Component)(object)gun, state, num2, num2 / num);
				}
			}
		}
	}
	internal static class OverclockWeapons
	{
		private sealed class Adapter
		{
			public readonly List<(FieldInfo f, bool lowerIsFaster)> Fields = new List<(FieldInfo, bool)>();
		}

		private sealed class Tuned
		{
			public Component C;

			public readonly List<(FieldInfo f, float orig)> Orig = new List<(FieldInfo, float)>();
		}

		private static readonly Dictionary<Type, Adapter?> ByType = new Dictionary<Type, Adapter>();

		private static readonly Dictionary<int, Tuned> Active = new Dictionary<int, Tuned>();

		private static readonly List<int> Gone = new List<int>();

		private static readonly HashSet<int> Seen = new HashSet<int>();

		private static float _next;

		private static float _nextGlow;

		private static readonly Color GlowCol = new Color(0.55f, 0.98f, 1f, 0.9f);

		private static readonly string[] Slower = new string[11]
		{
			"firecooldown", "shootcooldown", "firedelay", "shotdelay", "timebetweenshots", "timebetweenshot", "fireinterval", "shotinterval", "shootinterval", "attackcooldown",
			"cooldowntime"
		};

		private static readonly string[] Faster = new string[6] { "firerate", "rateoffire", "roundsperminute", "rpm", "shotspersecond", "firespeed" };

		private static readonly Dictionary<int, float> Floors = new Dictionary<int, float>();

		private static readonly HashSet<int> FloorSeen = new HashSet<int>();

		private static readonly HashSet<int> FloorLogged = new HashSet<int>();

		private static readonly List<int> FloorGone = new List<int>();

		private static Adapter? AdapterFor(Type t)
		{
			if (ByType.TryGetValue(t, out Adapter value))
			{
				return value;
			}
			value = null;
			string text = t.Assembly.GetName().Name ?? "";
			if (text != "Assembly-CSharp" && !text.StartsWith("Unity", StringComparison.Ordinal) && !text.StartsWith("Photon", StringComparison.Ordinal) && text != "RepoRPG")
			{
				FieldInfo[] fields = t.GetFields(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
				foreach (FieldInfo fieldInfo in fields)
				{
					if (fieldInfo.FieldType != typeof(float) || fieldInfo.IsInitOnly)
					{
						continue;
					}
					string n = fieldInfo.Name.ToLowerInvariant().Replace("_", "");
					if (n.Contains("timer") || n.Contains("current") || n.Contains("last"))
					{
						continue;
					}
					bool flag = Array.Exists(Slower, (string s) => n.Contains(s));
					bool flag2 = Array.Exists(Faster, (string s) => n.Contains(s));
					if (flag || flag2)
					{
						if (value == null)
						{
							value = new Adapter();
						}
						value.Fields.Add((fieldInfo, flag));
					}
				}
				if (value != null)
				{
					List<string> list = new List<string>();
					foreach (var (fieldInfo2, flag3) in value.Fields)
					{
						list.Add(fieldInfo2.Name + (flag3 ? " (lower = faster)" : " (higher = faster)"));
					}
					Plugin.Log.LogInfo((object)("[overclock] modded weapon " + t.FullName + " (" + text + "): fire rate through " + string.Join(", ", list) + "."));
				}
			}
			ByType[t] = value;
			return value;
		}

		public static bool Supported(PhysGrabObject held, out string what)
		{
			what = "";
			ItemGun val = ((Component)held).GetComponent<ItemGun>() ?? ((Component)held).GetComponentInChildren<ItemGun>();
			if ((Object)(object)val != (Object)null)
			{
				what = string.Format("{0} (game gun: shoot {1:0.###}s, reload {2:0.###}s)", ((object)val).GetType().Name, Game.Get(val, "shootTime", 0f), Game.Get(val, "shootCooldown", 0f));
				return true;
			}
			MonoBehaviour[] componentsInChildren = ((Component)held).GetComponentsInChildren<MonoBehaviour>(true);
			foreach (MonoBehaviour val2 in componentsInChildren)
			{
				if ((Object)(object)val2 != (Object)null && AdapterFor(((object)val2).GetType()) != null)
				{
					what = ((object)val2).GetType().Name + " (modded weapon)";
					return true;
				}
			}
			return false;
		}

		public static void Tick()
		{
			//IL_00be: Unknown result type (might be due to invalid IL or missing references)
			//IL_00cd: Unknown result type (might be due to invalid IL or missing references)
			if (Time.time < _next)
			{
				return;
			}
			_next = Time.time + 0.25f;
			Seen.Clear();
			if (Game.InLevel())
			{
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item == (Object)null || !ClassHost.Overclocked(item, out var fire, out var _) || fire <= 0f)
					{
						continue;
					}
					PhysGrabber physGrabber = item.physGrabber;
					PhysGrabObject val = (((Object)(object)physGrabber != (Object)null && Game.Get(physGrabber, "grabbed", fallback: false)) ? Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null) : null);
					if ((Object)(object)val == (Object)null)
					{
						continue;
					}
					if (Time.time >= _nextGlow)
					{
						ClassFx.Show(((Component)val).transform.position, 0.35f, 0.55f, GlowCol, 2f);
					}
					if ((Object)(object)((Component)val).GetComponent<ItemGun>() != (Object)null)
					{
						continue;
					}
					HoldBattery(val);
					float num = 1f + Mathf.Clamp(fire, 0f, 100f) / 100f;
					MonoBehaviour[] componentsInChildren = ((Component)val).GetComponentsInChildren<MonoBehaviour>(true);
					foreach (MonoBehaviour val2 in componentsInChildren)
					{
						if ((Object)(object)val2 == (Object)null)
						{
							continue;
						}
						Adapter adapter = AdapterFor(((object)val2).GetType());
						if (adapter == null)
						{
							continue;
						}
						int instanceID = ((Object)val2).GetInstanceID();
						Seen.Add(instanceID);
						if (Active.ContainsKey(instanceID))
						{
							continue;
						}
						Tuned tuned = new Tuned
						{
							C = (Component)(object)val2
						};
						foreach (var (fieldInfo, flag) in adapter.Fields)
						{
							try
							{
								float num2 = (float)fieldInfo.GetValue(val2);
								tuned.Orig.Add((fieldInfo, num2));
								fieldInfo.SetValue(val2, flag ? (num2 / num) : (num2 * num));
							}
							catch
							{
							}
						}
						Active[instanceID] = tuned;
					}
				}
			}
			if (Time.time >= _nextGlow)
			{
				_nextGlow = Time.time + 0.5f;
			}
			if (Floors.Count > 0)
			{
				FloorGone.Clear();
				foreach (int key in Floors.Keys)
				{
					if (!FloorSeen.Contains(key))
					{
						FloorGone.Add(key);
					}
				}
				foreach (int item2 in FloorGone)
				{
					Floors.Remove(item2);
				}
				FloorSeen.Clear();
			}
			if (Active.Count == 0)
			{
				return;
			}
			Gone.Clear();
			foreach (KeyValuePair<int, Tuned> item3 in Active)
			{
				if (!Seen.Contains(item3.Key))
				{
					Gone.Add(item3.Key);
				}
			}
			foreach (int item4 in Gone)
			{
				Restore(Active[item4]);
				Active.Remove(item4);
			}
		}

		private static void HoldBattery(PhysGrabObject held)
		{
			if (Plugin.Cfg.OverclockBatteryCost.Value > 0.01f)
			{
				return;
			}
			ItemBattery componentInChildren = ((Component)held).GetComponentInChildren<ItemBattery>();
			if ((Object)(object)componentInChildren == (Object)null)
			{
				return;
			}
			int instanceID = ((Object)componentInChildren).GetInstanceID();
			FloorSeen.Add(instanceID);
			float num = Game.Get(componentInChildren, "batteryLife", -1f);
			if (num < 0f)
			{
				return;
			}
			if (!Floors.TryGetValue(instanceID, out var value) || num > value)
			{
				Floors[instanceID] = num;
			}
			else if (!(num >= value - 0.01f))
			{
				Game.Set(componentInChildren, "batteryLife", value);
				if (FloorLogged.Add(instanceID))
				{
					Plugin.Log.LogInfo((object)$"[overclock] battery {((Object)held).name}: its own code spent {value - num:0.##} during Overclock - given back (fallback).");
				}
				if (FloorLogged.Count > 128)
				{
					FloorLogged.Clear();
				}
			}
		}

		private static void Restore(Tuned t)
		{
			if ((Object)(object)t.C == (Object)null)
			{
				return;
			}
			foreach (var (fieldInfo, num) in t.Orig)
			{
				try
				{
					fieldInfo.SetValue(t.C, num);
				}
				catch
				{
				}
			}
		}

		public static void Reset()
		{
			foreach (Tuned value in Active.Values)
			{
				Restore(value);
			}
			Active.Clear();
			Floors.Clear();
			FloorSeen.Clear();
			BatteryRule.Reset();
		}
	}
	[HarmonyPatch(typeof(PlayerHealth), "Hurt")]
	internal static class PlayerHurtPatch
	{
		private static readonly MethodInfo? EnemyFromIndex = AccessTools.Method(typeof(SemiFunc), "EnemyGetFromIndex", (Type[])null, (Type[])null);

		private static readonly object[] IndexArg = new object[1];

		[HarmonyPrefix]
		private static bool Prefix(PlayerHealth __instance, ref int __0, bool __1, int __2)
