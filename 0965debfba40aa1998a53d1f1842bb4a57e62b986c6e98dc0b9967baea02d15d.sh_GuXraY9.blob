				{
					obj.rb.linearVelocity = Vector3.zero;
				}
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Hand-off failed: " + ex.GetBaseException().Message);
			}
		}

		private void PlaceBet(PlayerAvatar by, int viewId)
		{
			ModConfig cfg = Plugin.Cfg;
			PhysGrabObject val = HeldBy(by);
			if ((Object)(object)val == (Object)null || ViewId((Component?)(object)val) != viewId)
			{
				Refuse(by, "");
				return;
			}
			ValuableObject component = ((Component)val).GetComponent<ValuableObject>();
			if ((Object)(object)component == (Object)null)
			{
				Refuse(by, "Hold a valuable to bet on it");
				return;
			}
			string id;
			AbilityLedger abilityLedger = LedgerFor(by, out id);
			foreach (Bet bet2 in _bets)
			{
				if ((Object)(object)bet2.Obj == (Object)(object)val)
				{
					Refuse(by, "Already marked");
					return;
				}
				if (bet2.Id == id)
				{
					Refuse(by, "You already have a bet running");
					return;
				}
			}
			if (abilityLedger.betsUsed >= BetUses(by))
			{
				Refuse(by, "Double or Nothing: already used this level");
				SendAbilityState(by, abilityLedger);
				return;
			}
			bool mimic = ClassStats.ClassOf(by) == "mimic";
			float num = (mimic ? CopyScale(by) : 1f);
			float num2 = Game.Get(component, "dollarValueCurrent", 0f);
			float value = cfg.BetMinMultiplier.Value;
			float num3 = Mathf.Max(value, Mathf.Min(cfg.BetMaxMultiplier.Value + Mathf.Clamp(G("bet_maxmult"), 0f, 1.5f), Plugin.Cfg.MaxBetMultiplier.Value));
			value = 1f + (value - 1f) * num;
			num3 = 1f + (num3 - 1f) * num;
			if (Synergies.Has(by, "insider_tip"))
			{
				num3 = Mathf.Min(num3 + Synergies.V("insider_tip"), Plugin.Cfg.MaxBetMultiplier.Value);
			}
			float num4 = Mathf.Clamp(G("bet_insure"), 0f, 90f);
			if (Synergies.Has(by, "hedged_bet"))
			{
				num4 = Mathf.Min(90f, 100f - (100f - num4) * (1f - Mathf.Clamp(Synergies.V("hedged_bet"), 0f, 90f) / 100f));
			}
			double val2 = Scrap.FromDollars(num2) * (double)cfg.BetLossPercent.Value / 100.0 * (1.0 - (double)num4 / 100.0);
			val2 = Math.Min(val2, Scrap.HostBalance(id) * (double)cfg.BetLossCapPercent.Value / 100.0);
			val2 = Math.Max(0.0, Math.Floor(val2));
			Bet bet = new Bet
			{
				Obj = val,
				Val = component,
				By = by,
				Id = id,
				Actor = Game.ActorNumber(by),
				ViewId = viewId,
				Name = Game.Get(by, "playerName", "The Gambler"),
				Value = num2,
				Start = Time.time,
				Timer = Mathf.Clamp(cfg.BetTimerSeconds.Value * (1f + Mathf.Clamp(G("bet_timer"), -60f, 100f) / 100f), 20f, 900f),
				Arm = cfg.BetArmSeconds.Value,
				MinMult = value,
				MaxMult = num3,
				LureRadius = cfg.BetLureRadius.Value * (1f + Mathf.Clamp(G("bet_lure"), -50f, 200f) / 100f),
				Insure = num4,
				ScrapPct = Mathf.Clamp(G("bet_scrap"), 0f, 50f),
				Guard = Mathf.Clamp(G("bet_guard"), 0f, 90f),
				Stake = val2,
				LastHp = (((Object)(object)by.playerHealth != (Object)null) ? Game.Health(by.playerHealth) : (-1)),
				RunKey = RunInfo.Key
			};
			bet.NextLure = Time.time + 1f;
			_bets.Add(bet);
			abilityLedger.betsUsed++;
			abilityLedger.betStake = val2;
			SaveBook.MarkDirty();
			Net.SendNotice(by, Notice.Text, 0f, $"Bet placed on ${num2:N0} - {Scrap.Price((int)val2)} at stake. Get it out in {bet.Timer:0}s!");
			Net.SendBetState(bet.ViewId, bet.Actor, bet.Mult, bet.Timer, 0f, "");
			SendAbilityState(by, abilityLedger);
			float G(string stat)
			{
				if (!mimic)
				{
					return ClassStats.Get(by, "gambler." + stat);
				}
				return 0f;
			}
		}

		private void TickBets(float now)
		{
			//IL_00da: Unknown result type (might be due to invalid IL or missing references)
			//IL_00df: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d7: Unknown result type (might be due to invalid IL or missing references)
			//IL_01e5: Unknown result type (might be due to invalid IL or missing references)
			//IL_0118: Unknown result type (might be due to invalid IL or missing references)
			//IL_011d: Unknown result type (might be due to invalid IL or missing references)
			//IL_011f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0124: Unknown result type (might be due to invalid IL or missing references)
			ModConfig cfg = Plugin.Cfg;
			for (int num = _bets.Count - 1; num >= 0; num--)
			{
				Bet bet = _bets[num];
				if ((Object)(object)bet.Obj == (Object)null || (Object)(object)bet.Val == (Object)null)
				{
					SettleLost(bet, "Your marked valuable is gone");
				}
				else if ((Object)(object)bet.By == (Object)null || !Game.Players().Contains(bet.By))
				{
					SettleLost(bet, "");
				}
				else
				{
					float num2 = now - bet.Start;
					object obj = Game.Get<object>(bet.Val, "roomVolumeCheck", null);
					bet.InZone = obj != null && Game.Get(obj, "inExtractionPoint", fallback: false);
					if (num2 >= bet.Timer)
					{
						SettleExpired(bet);
					}
					else
					{
						Vector3 position = ((Component)bet.Obj).transform.position;
						if (now >= bet.NextSample)
						{
							bet.NextSample = now + 1f;
							Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
							while (enumerator.MoveNext())
							{
								Vector3 val = ((Component)enumerator.Current).transform.position - position;
								if (((Vector3)(ref val)).sqrMagnitude <= 100f)
								{
									bet.Danger += 1f;
									break;
								}
							}
							if ((Object)(object)bet.By.playerHealth != (Object)null)
							{
								int num3 = Game.Health(bet.By.playerHealth);
								if (bet.LastHp >= 0 && num3 < bet.LastHp)
								{
									bet.Danger += (float)(bet.LastHp - num3) / 5f;
								}
								bet.LastHp = num3;
							}
						}
						if (now >= bet.NextLure && bet.LureRadius > 0f)
						{
							bet.NextLure = now + cfg.BetLureEvery.Value;
							Investigate(position, bet.LureRadius);
							Net.SendFx(Fx.Bet, position, 0.8f, 1f);
						}
						bet.Risk = Mathf.Clamp01(0.5f * Mathf.Min(num2, bet.Timer) / bet.Timer + bet.Danger / Mathf.Max(1f, cfg.BetDangerForMax.Value));
						bool flag = num2 >= bet.Arm;
						bet.Live = bet.InZone && flag;
						float num4 = (bet.Live ? bet.Mult : 1f);
						if (Mathf.Abs(num4 - bet.Applied) > 0.01f)
						{
							float num5 = Game.Get(bet.Val, "dollarValueCurrent", 0f);
							Game.SetValuableValue(bet.Val, num5 / bet.Applied * num4);
							bet.Applied = num4;
						}
						if (now >= bet.NextState)
						{
							bet.NextState = now + 1f;
							Net.SendBetState(bet.ViewId, bet.Actor, bet.Mult, Mathf.Max(0f, bet.Timer - num2), flag ? 1f : (num2 / Mathf.Max(0.1f, bet.Arm)), "");
							Plugin.Log.LogInfo((object)($"[bet] {bet.Name}: active, {Mathf.Max(0f, bet.Timer - num2):0}s left of {bet.Timer:0}, x{bet.Mult:0.00} (cap x{bet.MaxMult:0.00}, risk {bet.Risk:0.00}), " + (bet.InZone ? "in an extraction zone" : "out of the zone") + (bet.Live ? ", live on the haul" : "") + "."));
						}
					}
				}
			}
		}

		public void OnExtracting()
		{
			if (!Host)
			{
				return;
			}
			for (int num = _bets.Count - 1; num >= 0; num--)
			{
				Bet bet = _bets[num];
				if (!((Object)(object)bet.Obj == (Object)null) && !((Object)(object)bet.Val == (Object)null) && bet.InZone)
				{
					List<GameObject> list = (((Object)(object)RoundDirector.instance != (Object)null) ? RoundDirector.instance.dollarHaulList : null);
					if (list != null && (list.Contains(((Component)bet.Val).gameObject) || list.Contains(((Component)bet.Obj).gameObject)))
					{
						_bets.RemoveAt(num);
						ClearStake(bet);
						if (!bet.Live)
						{
							Net.SendBetState(bet.ViewId, bet.Actor, 1f, 0f, 0f, bet.Name + "'s bet was void - extracted before it was live");
						}
						else
						{
							float num2 = Game.Get(bet.Val, "dollarValueCurrent", 0f);
							if (bet.ScrapPct > 0f && (Object)(object)bet.By != (Object)null)
							{
								Scrap.HostGrant(bet.By, Scrap.FromDollars(bet.Value * bet.ScrapPct / 100f), "Side Bet");
							}
							Net.SendBetState(bet.ViewId, bet.Actor, bet.Applied, 0f, 1f, $"{bet.Name} won the bet! x{bet.Applied:0.0} - ${num2:N0}");
							TeamPlay.HostBest(bet.Actor, TeamPlay.Ev.BetWon, num2);
							ContractHost.ClsEv(bet.Actor, "gambler");
						}
					}
				}
			}
		}

		private void SettleExpired(Bet b)
		{
			_bets.Remove(b);
			if (b.RunKey == RunInfo.Key)
			{
				ClearStake(b);
			}
			if ((Object)(object)b.Val != (Object)null && b.Applied > 1.001f)
			{
				float num = Game.Get(b.Val, "dollarValueCurrent", 0f);
				Game.SetValuableValue(b.Val, num / b.Applied);
			}
			b.Applied = 1f;
			Plugin.Log.LogInfo((object)string.Format("[bet] {0}: EXPIRED at 0s (x{1:0.00} reached, {2} the zone) - bonus lost, no Scrap taken.", b.Name, b.Mult, b.InZone ? "in" : "out of"));
			Net.SendBetState(b.ViewId, b.Actor, 1f, 0f, 0f, b.Name + "'s Double or Nothing expired - the bonus is lost");
		}

		private void ClearStake(Bet b)
		{
			if (!(b.Id == "") && !(b.RunKey != RunInfo.Key))
			{
				AbilityLedger value = (RunStore.IsTempKey(RunInfo.Key) ? null : SaveBook.Ledger(RunInfo.Key, b.Id));
				if (value == null)
				{
					_memLedgers.TryGetValue(RunInfo.Key + "|" + b.Id, out value);
				}
				if (value != null)
				{
					value.betStake = 0.0;
					SaveBook.MarkDirty();
				}
			}
		}

		private void SettleLost(Bet b, string why)
		{
			_bets.Remove(b);
			if (b.RunKey != RunInfo.Key)
			{
				Net.SendBetState(b.ViewId, b.Actor, 0f, 0f, 0f, b.Name + "'s bet was lost");
				return;
			}
			ClearStake(b);
			if ((Object)(object)b.Val != (Object)null && b.Applied > 1.001f)
			{
				float num = Game.Get(b.Val, "dollarValueCurrent", 0f);
				Game.SetValuableValue(b.Val, num / b.Applied);
			}
			if (b.Stake > 0.0)
			{
				TakeScrap(b.Id, b.Actor, b.Stake, "Lost bet");
			}
			string message = ((why != "") ? (why + ". ") : "") + b.Name + " lost the bet" + ((b.Stake > 0.0) ? (" (-" + Scrap.Price((int)b.Stake) + ")") : "");
			Net.SendBetState(b.ViewId, b.Actor, 0f, 0f, 0f, message);
		}

