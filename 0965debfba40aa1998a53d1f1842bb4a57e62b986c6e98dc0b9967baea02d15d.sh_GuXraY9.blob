		private DetailInfo AttrDetail(RunSave run, int avail, bool busy)
		{
			DetailInfo attrDetailInfo = _attrDetailInfo;
			AttributeDef attrFocus = _attrFocus;
			if (attrFocus == null)
			{
				if (attrDetailInfo.EmptyTitle == "")
				{
					attrDetailInfo.Begin("");
					attrDetailInfo.EmptyTitle = "Select an attribute";
					attrDetailInfo.EmptyText = "What it gives, its milestones and pairings show here.";
				}
				return attrDetailInfo;
			}
			int num = attrFocus.id.GetHashCode() * 31 + _attrCacheKey;
			if (num != _attrSideKey)
			{
				_attrSideKey = num;
				BuildAttrSideTexts(run, attrFocus);
			}
			int num2 = num * 397 + avail * 7 + (busy ? 1 : 0) + _layoutVersion * 7919;
			if (num2 == _attrDetailSig && attrDetailInfo.Name != "")
			{
				return attrDetailInfo;
			}
