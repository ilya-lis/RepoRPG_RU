	internal static class UiDiag
	{
		private static float _windowStart = -1f;

		private static float _worst;

		private static float _sum;

		private static int _frames;

		private static int _guiPasses;

		private static int _gcAtStart;

		private static long _memAtStart;

		private static readonly Dictionary<string, int> Errors = new Dictionary<string, int>();

		public static void OnGuiPass()
		{
			if (Plugin.Cfg.UiDiagnostics.Value)
			{
				_guiPasses++;
			}
		}

		public static void Error(Exception e)
		{
			string text = e.GetType().Name + ": " + e.Message;
			Errors.TryGetValue(text, out var value);
			Errors[text] = value + 1;
			switch (value)
			{
			case 0:
				Plugin.Log.LogError((object)$"[ui] error in the mod menu (logged once; the menu keeps working): {e}");
				break;
			case 100:
			case 1000:
				Plugin.Log.LogWarning((object)$"[ui] the same menu error has happened {value} times: {text}");
				break;
			}
			if (Errors.Count > 200)
			{
				Errors.Clear();
			}
		}

		public static void Tick()
		{
			if (!Plugin.Cfg.UiDiagnostics.Value)
			{
				_windowStart = -1f;
				return;
			}
			float unscaledTime = Time.unscaledTime;
			float unscaledDeltaTime = Time.unscaledDeltaTime;
			if (_windowStart < 0f)
			{
				Reset(unscaledTime);
				return;
			}
			_frames++;
			_sum += unscaledDeltaTime;
			_worst = Mathf.Max(_worst, unscaledDeltaTime);
			if (!(unscaledTime - _windowStart < 10f))
			{
				long totalMemory = GC.GetTotalMemory(forceFullCollection: false);
				int num = GC.CollectionCount(0) - _gcAtStart;
				int num2 = Object.FindObjectsByType<AudioSource>((FindObjectsSortMode)0).Length;
				int num3 = Object.FindObjectsByType<GameObject>((FindObjectsSortMode)0).Length;
				Plugin.Log.LogInfo((object)($"[ui] last {unscaledTime - _windowStart:0}s: {_frames} frames, avg {_sum / (float)Mathf.Max(1, _frames) * 1000f:0.0} ms, worst {_worst * 1000f:0.0} ms; " + $"OnGUI passes/frame {(float)_guiPasses / (float)Mathf.Max(1, _frames):0.0}; managed memory {(double)totalMemory / 1048576.0:0.0} MB ({(double)(totalMemory - _memAtStart) / 1048576.0:+0.0;-0.0} MB), " + $"gen-0 GCs {num}; UI sounds played {UiAudio.Played}, rate-limited {UiAudio.Throttled}, via the game's call {UiAudio.Fallback}; " + $"AudioSources in scene {num2}, GameObjects {num3}; menu open {RpgRuntime.MenuOpen}"));
				Plugin.Log.LogInfo((object)string.Format("[soak] up {0:0} min; class state: {1}; errors: {2}", Time.realtimeSinceStartup / 60f, ClassHost.Instance?.StateCounts() ?? "-", Guard.Summary()));
				UiAudio.Played = (UiAudio.Throttled = (UiAudio.Fallback = 0));
				Reset(unscaledTime);
			}
		}

		private static void Reset(float now)
		{
			_windowStart = now;
			_frames = 0;
			_sum = 0f;
			_worst = 0f;
			_guiPasses = 0;
			_gcAtStart = GC.CollectionCount(0);
			_memAtStart = GC.GetTotalMemory(forceFullCollection: false);
		}
	}
