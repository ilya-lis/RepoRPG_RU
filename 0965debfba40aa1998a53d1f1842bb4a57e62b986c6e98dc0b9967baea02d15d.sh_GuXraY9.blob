		private static void MenuSound(UiSound kind)
		{
			if (_probeOn)
			{
				return;
			}
			if (kind == UiSound.Confirm)
			{
				NoteConfirm();
			}
			if (!Plugin.Cfg.UiSounds.Value)
			{
				return;
