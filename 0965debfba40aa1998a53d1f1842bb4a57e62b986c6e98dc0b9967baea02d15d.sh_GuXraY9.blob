			}
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				Vector3 val3 = ((Component)enumerator.Current).transform.position - ((Component)local).transform.position;
				if (((Vector3)(ref val3)).sqrMagnitude <= 64f)
				{
					_vigilLevel = RunInfo.LevelIndex;
					float v2 = Mathf.Clamp(num5, 0f, 30f);
					AddSelfDyn(Stat.MoveSpeed, v2, 3f);
					AddSelfDyn(Stat.SprintSpeed, v2, 3f);
					Toast("Vigilant!", new Color(0.6f, 0.9f, 1f));
					break;
				}
			}
		}

