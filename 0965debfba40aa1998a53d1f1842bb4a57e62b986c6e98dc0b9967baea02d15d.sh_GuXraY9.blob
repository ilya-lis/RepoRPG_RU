				Scene scene = ((Component)list[0]).gameObject.scene;
				obj2[2] = ((Scene)(ref scene)).name;
				obj2[3] = num2;
				obj2[4] = _madeCount;
				log.LogInfo((object)string.Format("[players] {0} players, {1} spawn points in '{2}': made {3} more ({4} this scene).", obj2));
			}
			if (num7 < num)
			{
				Plugin.Log.LogInfo((object)$"[players] only room for {num7} spawn points here: some players share one.");
			}
		}

