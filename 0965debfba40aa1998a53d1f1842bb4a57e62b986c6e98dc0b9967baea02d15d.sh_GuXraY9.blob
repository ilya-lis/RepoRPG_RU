			ThreatGraceLevels = c.Bind<int>("Threat", "GraceLevels", 2, new ConfigDescription("Levels cleared before the rating starts rising.", (AcceptableValueBase)(object)new AcceptableValueRange<int>(0, 20), Array.Empty<object>()));
			ThreatMonsters = c.Bind<float>("Threat", "Monsters", 100f, new ConfigDescription("Monster count and respawn rate per threat point (% of +4%).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 200f), Array.Empty<object>()));
