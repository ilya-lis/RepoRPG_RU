				"<b>",
				TeamContracts.Goal(tcDef, _tcTarget),
				"</b>",
				(text3 != "") ? ("  <color=#9a9ca0>(" + text3 + ")</color>") : "",
				"\n<color=#ffb21e>REWARD</color>  ",
				TeamContracts.RewardText(tcDef, _tcScale),
				" (everyone in it)\n<color=#ff7a6b>STAKES</color>  ",
				TeamContracts.LossText(tcDef, _tcScale),
				"\n",
				text,
				(TeamVoters() != "") ? ("\n" + TeamVoters()) : "",
				null
			};
			object obj2;
			if (_tcState == 0)
			{
				string text4 = WaitingFor("team", _tcVotes, TeamContracts.Voted);
				if (text4 != null && text4 != "")
				{
					obj2 = "\n" + text4;
					goto IL_0250;
				}
			}
