					}
				}
				if (flag)
				{
					AccessTools.Method(typeof(EnemyVision), "PlayerAdded", new Type[1] { typeof(int) }, (Type[])null)?.Invoke(vision, new object[1] { viewId });
				}
			}
			catch
			{
			}
		}

		private static void SyncDestroyed(Player p)
		{
			PhysGrabHinge[] array = Object.FindObjectsByType<PhysGrabHinge>((FindObjectsSortMode)0);
			foreach (PhysGrabHinge val in array)
			{
				if (!((Object)(object)val == (Object)null))
				{
					if (Game.Get(val, "broken", fallback: false))
					{
						RpcTo((Component?)(object)val, "HingeBreakRPC", p);
					}
					else if (!Game.Get(val, "closed", fallback: true))
					{
						RpcTo((Component?)(object)val, "OpenImpulseRPC", p);
					}
				}
			}
			if (_destroyed.Count > 0 || _hinges.Count > 0)
			{
				Net.SendLateJoinDestroyed(p.ActorNumber, _destroyed.ToArray(), _hinges.ToArray());
			}
		}

		private static void SyncDeaths(Player p)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item == (Object)null) && !((Object)(object)item.photonView == (Object)null) && item.photonView.Owner != p && (Game.Get(item, "deadSet", fallback: false) || Game.Get(item, "isDisabled", fallback: false)))
				{
					try
					{
						item.photonView.RPC("PlayerDeathRPC", p, new object[1] { -1 });
					}
					catch (Exception ex)
					{
						Game.WarnOnce("[late join] death state: " + ex.Message);
					}
				}
			}
		}

		private static PlayerAvatar? PlayerOf(int actor)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
