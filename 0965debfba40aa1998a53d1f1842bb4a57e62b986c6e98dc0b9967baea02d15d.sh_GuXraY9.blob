				}
				foreach (string item in data.gambleBless)
				{
					PerkDef perkDef = Find(Plugin.Rpg.blessings, item);
					if (perkDef != null)
					{
						lines.Add(("+ " + perkDef.name + ": " + perkDef.desc, new Color(0.55f, 0.95f, 0.6f)));
					}
				}
				PerkDef perkDef2 = Find(Plugin.Rpg.curses, data.gambleCurse);
				if (perkDef2 != null)
				{
					lines.Add(("- " + perkDef2.name + ": " + perkDef2.desc, new Color(1f, 0.55f, 0.5f)));
				}
				break;
			}
			case "bloodbound":
			{
				float num = Mathf.Clamp(ClassStat("bloodbound.cost"), 0f, 20f);
				float num2 = Mathf.Max(0f, num - ClassStat("bloodbound.leech"));
				if (Time.time < _pactEnd)
