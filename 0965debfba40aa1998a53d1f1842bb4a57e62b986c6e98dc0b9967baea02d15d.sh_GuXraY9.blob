		private void RollDie()
		{
			//IL_0130: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			if (data.dieLevel == RunInfo.LevelIndex)
			{
				return;
			}
			bool flag = false;
			List<string> list = new List<string>();
			foreach (GearItem item in data.EquippedItems())
			{
				if (GearX.Has(item, "gear.die"))
				{
					flag = true;
				}
				for (int i = 0; i < item.effects.Length; i++)
				{
					if (item.effects[i].StatIndex >= 0)
					{
						list.Add(item.uid + "#" + i);
					}
				}
			}
			if (flag && list.Count >= 2)
			{
				Random random = new Random();
				data.dieLevel = RunInfo.LevelIndex;
				int num = random.Next(list.Count);
				int num2 = random.Next(list.Count - 1);
				if (num2 >= num)
				{
					num2++;
				}
				data.dieUp = list[num];
				data.dieDown = list[num2];
				_statsDirty = true;
				_store.MarkDirty();
				Notify(PopupKind.Loot, "Gambler's Die rolled: one gear line doubled, one halved this level", (Color?)new Color(1f, 0.74f, 0.22f), "");
			}
		}

