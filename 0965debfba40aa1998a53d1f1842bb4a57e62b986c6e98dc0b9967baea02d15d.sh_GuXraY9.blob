				num += GlyphW(g) + 4f;
			}
			return num + 4f + LabelW(p.label);
		}

		private int PromptRows(float width, out float gap)
		{
			float num = 0f;
			foreach (var prompt in _prompts)
			{
				num += PromptW(prompt);
			}
			int count = _prompts.Count;
			gap = 22f;
			if (num + gap * (float)(count - 1) <= width)
			{
				return 1;
			}
			gap = 10f;
			if (num + gap * (float)(count - 1) <= width)
			{
				return 1;
			}
			int num2 = 1;
			float num3 = 0f;
			foreach (var prompt2 in _prompts)
			{
				float num4 = PromptW(prompt2);
				if (num3 > 0f && num3 + num4 > width)
				{
					num2++;
					num3 = 0f;
				}
				num3 += num4 + gap;
			}
			return num2;
		}

		private float PromptStripHeight(Rect win)
		{
			BuildPrompts(maximal: true);
			float gap;
			int num = PromptRows(((Rect)(ref win)).width - 44f, out gap);
			_promptStripH = (float)num * PromptRowH + (float)(num - 1) * 6f + 18f;
			return _promptStripH;
		}

