		private bool WaitingForHostSettings()
		{
			if (!Game.IsMultiplayer() || Game.IsMaster())
			{
				_settingsWaitSince = -1f;
				_settingsTimeoutSaid = false;
				return false;
			}
			if (SettingsSync.VersionBlocked)
			{
				return true;
			}
			if (SettingsSync.Overridden)
			{
				_settingsWaitSince = -1f;
				return false;
			}
			float unscaledTime = Time.unscaledTime;
			if (_settingsWaitSince < 0f)
			{
				_settingsWaitSince = unscaledTime;
				_nextSettingsAsk = unscaledTime + 3f;
			}
			if (unscaledTime - _settingsWaitSince > 20f)
			{
				if (!_settingsTimeoutSaid)
				{
					_settingsTimeoutSaid = true;
					Plugin.Log.LogWarning((object)"[settings] no host settings after 20 s (the host may not have RepoRPG): using your own values.");
				}
				return false;
			}
			if (unscaledTime >= _nextSettingsAsk)
			{
				_nextSettingsAsk = unscaledTime + 3f;
				Net.AskSettings();
				Net.RequestRunInfo();
			}
			return true;
		}

		private void DrawHostTab(Rect area)
		{
			//IL_00bd: Unknown result type (might be due to invalid IL or missing references)
