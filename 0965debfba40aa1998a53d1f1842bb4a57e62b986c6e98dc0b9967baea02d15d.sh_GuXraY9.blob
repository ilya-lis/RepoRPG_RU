			NoticeListPos = c.Bind<NoticeListPosition>("Notices", "ListPosition", NoticeListPosition.AboveHud, "Action needed: where the compact list sits - AboveHud (just above the HUD card), LeftMiddle, or BottomCentre.");
			NoticeSound = c.Bind<bool>("Notices", "Sound", true, "Action needed: a short alert sound when a vote or choice arrives (not for reminders).");
			NoticeFinalReminder = c.Bind<bool>("Notices", "FinalReminder", true, "Action needed: a vote you dismissed comes back once, with a short reminder, when about 10 seconds are left.");
			NoticeAutoHide = c.Bind<float>("Notices", "AutoHideSeconds", 0f, new ConfigDescription("Action needed: alerts leave the on-screen list after this many seconds (0 = off) and only show as the count on the menu hint and the tab badges. Deadline reminders still come back.", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 120f), Array.Empty<object>()));
			NoticeHideVotes = c.Bind<bool>("Notices", "HideVotes", false, "Action needed: don't show team votes in the on-screen list (they stay in the menu, with the tab badge).");
