				foreach (string item in list)
				{
					Plugin.Log.LogWarning((object)("[contrast] " + item));
				}
				Plugin.Log.LogInfo((object)("[contrast] palette check: " + ((list.Count == 0) ? "every class theme passes" : (list.Count + " failure(s)"))));
			}
			if (!open && _dialogOpen && (_dialogKind == DialogKind.PlayAs || _dialogKind == DialogKind.Salvage || _dialogKind == DialogKind.Compare || _dialogKind == DialogKind.Craft || _dialogKind == DialogKind.HostApply))
			{
