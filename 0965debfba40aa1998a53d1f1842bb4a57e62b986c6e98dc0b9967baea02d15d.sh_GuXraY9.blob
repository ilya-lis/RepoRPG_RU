	[Serializable]
	public class BossFile
	{
		public int version = 1;

		public string[] first = Array.Empty<string>();

		public string[] epithet = Array.Empty<string>();
	}
	internal static class Bosses
	{
		private static BossFile _names = new BossFile();

		private static float _liveAt = -1f;

		private static bool _picked;

		public static int BossId { get; private set; }

		public static float SpawnedAt { get; private set; } = -1f;

		public static float KilledAt { get; private set; } = -1f;

		public static bool Twin => RunDepth.TwinBosses(RunInfo.LevelIndex);

		public static void Load()
		{
			string text = ClassDatabase.ReadEmbedded("bosses");
			try
			{
				_names = Json.Deserialize<BossFile>(ClassDatabase.ReadWithOverride("bosses", text)) ?? new BossFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("bosses data parse error: " + ex.Message));
			}
			if (_names.first == null || _names.first.Length == 0 || _names.epithet == null || _names.epithet.Length == 0)
			{
				try
				{
					_names = Json.Deserialize<BossFile>(text) ?? new BossFile();
				}
				catch
				{
					_names = new BossFile();
				}
			}
		}

		public static bool IsBossLevel(int levelIndex)
		{
			ModConfig cfg = Plugin.Cfg;
			if (!cfg.Bosses.Value || !cfg.EliteEnemies.Value)
			{
				return false;
			}
			if (RunShape.IsMilestoneLevel(levelIndex))
			{
				return true;
			}
			int num = levelIndex + 1;
			int num2 = Mathf.Max(1, cfg.FirstBossLevel.Value);
			int num3 = Mathf.Max(1, Difficulty.BossEvery(Mathf.Max(1, cfg.BossEvery.Value)) - RunThreat.BossEveryCut((levelIndex == RunInfo.LevelIndex && Game.InLevel()) ? RunThreat.Fixed : RunThreat.RatingAt(levelIndex)));
			if (num >= num2)
			{
				return (num - num2) % num3 == 0;
			}
			return false;
		}

		public static string NameFor(int viewId)
		{
			if (Season.IsFinaleLevel(RunInfo.LevelIndex) && !Season.Won && (BossId == 0 || BossId == viewId))
			{
				return "The Liquidator";
			}
			string[] first = _names.first;
			string[] epithet = _names.epithet;
			if (first == null || first.Length == 0 || epithet == null || epithet.Length == 0)
			{
				return "The Boss";
			}
			Random random = RunInfo.RngFor(viewId * 7349 + RunInfo.LevelIndex * 613 + 17);
			return first[random.Next(first.Length)] + " the " + epithet[random.Next(epithet.Length)];
		}

		public static float HealthScale(int players)
		{
			ModConfig cfg = Plugin.Cfg;
			return Mathf.Clamp((players <= 1) ? cfg.BossHealth1.Value : ((players <= 3) ? cfg.BossHealth3.Value : ((players <= 6) ? cfg.BossHealth6.Value : ((players <= 10) ? cfg.BossHealth10.Value : ((players <= 15) ? cfg.BossHealth15.Value : cfg.BossHealth20.Value)))), 1f, 10f);
		}

		public static void NewLevel()
		{
			BossGraveyard.NewLevel();
			BossId = 0;
			SpawnedAt = -1f;
			KilledAt = -1f;
			_liveAt = -1f;
			_picked = false;
			Season.NewLevel();
		}

		public static void HostTick(Random rng)
		{
			Season.HostTick();
			if (_picked || !Game.IsMaster() || !IsBossLevel(RunInfo.LevelIndex))
			{
				return;
			}
			if (_liveAt < 0f)
			{
				_liveAt = Time.time;
			}
			else
			{
				if (Time.time - _liveAt < 20f)
				{
					return;
				}
				EnemyHealth val = null;
				EnemyHealth val2 = null;
				int num = -1;
				int num2 = -1;
				Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
				while (enumerator.MoveNext())
				{
					EnemyHealth current = enumerator.Current;
					if (!((Object)(object)current == (Object)null) && !Elites.TryGet(current, out var _) && !BossGraveyard.IsRetired(current))
					{
						int num3 = Game.EnemyTier(current);
						if (num3 > num)
						{
							val2 = val;
							num2 = num;
							num = num3;
							val = current;
						}
						else if (num3 > num2)
						{
							num2 = num3;
							val2 = current;
						}
					}
				}
				_picked = true;
				if ((Object)(object)val == (Object)null)
				{
					Plugin.Log.LogInfo((object)"[boss] no eligible monster this level.");
					return;
				}
				Promote(rng, val);
				if (Twin && (Object)(object)val2 != (Object)null)
				{
					Promote(rng, val2);
				}
			}
		}

		private static void Promote(Random rng, EnemyHealth best)
		{
			int num = Mathf.Clamp(Difficulty.BossMods(Plugin.Cfg.BossModifiers.Value), 1, 5) + (PlayerScaling.BossExtraModifier ? 1 : 0) + RunThreat.ExtraBossModifiers(RunThreat.Fixed) + (RunShape.IsMilestoneLevel(RunInfo.LevelIndex) ? Mathf.Clamp(Plugin.Cfg.MilestoneBossMods.Value, 0, 4) : 0) + (Season.IsFinaleLevel(RunInfo.LevelIndex) ? Season.FinaleMods : 0) + Season.EndlessBossMods(RunInfo.LevelIndex) + Heat.BossMods + Ascension.BossExtraMods;
			EliteMod mods = RollMods(rng, Mathf.Clamp(num, 1, (Season.IsFinaleLevel(RunInfo.LevelIndex) || Season.Won) ? 7 : (RunShape.IsMilestoneLevel(RunInfo.LevelIndex) ? 5 : 6)));
			if (Season.IsFinaleLevel(RunInfo.LevelIndex) && !Season.Won)
			{
				mods = Ascension.FinaleMods | ((Ascension.BossExtraMods > 0) ? RollMods(rng, 1) : EliteMod.None);
			}
			int num2 = Elites.ViewId((Component)(object)best);
			if (BossId == 0)
			{
				BossId = num2;
			}
			SpawnedAt = Time.time;
			Elites.Set(num2, mods, 3);
			Net.BroadcastElite(num2, mods, 3);
			HostDirector.Instance?.TrackElite(best, num2);
			Plugin.Log.LogInfo((object)("[boss] " + (RunShape.IsMilestoneLevel(RunInfo.LevelIndex) ? "milestone boss " : "") + NameFor(num2) + " (" + Elites.Describe(mods) + ") on " + ((Object)best).name + "."));
		}

		public static string DebugPromoteNearest(Vector3 pos)
		{
			//IL_0060: Unknown result type (might be due to invalid IL or missing references)
			//IL_0065: Unknown result type (might be due to invalid IL or missing references)
			//IL_0066: Unknown result type (might be due to invalid IL or missing references)
			//IL_006b: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.IsMaster())
			{
				return "host only";
			}
			if (!Game.InLevel())
			{
				return "only in a level";
			}
			EnemyHealth val = null;
			float num = float.MaxValue;
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				EnemyHealth current = enumerator.Current;
				if (!((Object)(object)current == (Object)null) && !Elites.TryGet(current, out var _) && !BossGraveyard.IsRetired(current))
				{
					Vector3 val2 = ((Component)current).transform.position - pos;
					float sqrMagnitude = ((Vector3)(ref val2)).sqrMagnitude;
					if (sqrMagnitude < num)
					{
						num = sqrMagnitude;
						val = current;
					}
				}
			}
			if ((Object)(object)val == (Object)null)
			{
				return "no monster found (elites and killed bosses don't count)";
			}
			_picked = true;
			Promote(new Random(), val);
			return "Boss: " + NameFor(Elites.ViewId((Component)(object)val));
		}

		private static EliteMod RollMods(Random rng, int count)
		{
			List<EliteMod> list = RunDepth.BossPool();
			EliteMod eliteMod = EliteMod.None;
			for (int i = 0; i < count; i++)
			{
				if (list.Count <= 0)
				{
					break;
				}
				int index = rng.Next(list.Count);
				EliteMod eliteMod2 = list[index];
				list.RemoveAt(index);
				eliteMod |= eliteMod2;
				if (eliteMod2 == EliteMod.Armored)
				{
					list.Remove(EliteMod.Stalwart);
				}
				if (eliteMod2 == EliteMod.Stalwart)
				{
					list.Remove(EliteMod.Armored);
				}
			}
			return eliteMod;
		}

		public static void HostOnKilled(EnemyHealth eh)
		{
			if (!Game.IsMaster() || !Elites.TryGet(eh, out var info) || info.Tier < 3)
			{
				return;
			}
			if (!BossGraveyard.FirstReward(Elites.ViewId((Component)(object)eh)))
			{
				Plugin.Log.LogInfo((object)("[boss] " + NameFor(Elites.ViewId((Component)(object)eh)) + ": a second death call - its rewards were already paid."));
				return;
			}
			KilledAt = Time.time;
			bool flag = RunShape.Has("bounty_board");
			foreach (PlayerAvatar item in Game.Players())
			{
				if ((Object)(object)item != (Object)null)
				{
					Scrap.HostGrant(item, 30 + (flag ? 30 : 0), flag ? "Boss kill (Bounty Board)" : "Boss kill");
				}
			}
			RunShape.HostBossKilled(RunShape.IsMilestoneLevel(RunInfo.LevelIndex), NameFor(Elites.ViewId((Component)(object)eh)));
			TeamContracts.HostOnBossKilled();
			PatchGuard.Run("cursed drops", delegate
			{
				Cursed.HostRollDrops(eh);
			});
			bool flag2 = RunShape.IsMilestoneLevel(RunInfo.LevelIndex);
			Research.HostGrantAll(Season.IsFinaleLevel(RunInfo.LevelIndex) ? 150f : (flag2 ? 80f : 60f), "Boss core");
		}

		public static bool IsBoss(EnemyHealth? eh)
		{
			if ((Object)(object)eh != (Object)null && Elites.TryGet(eh, out var info))
			{
				return info.Tier >= 3;
			}
			return false;
		}
	}
	internal enum KilledBossRespawn
	{
		StayDead,
		AsNormalMonster
	}
	internal static class BossGraveyard
	{
		private static readonly HashSet<int> Killed = new HashSet<int>();

		private static readonly HashSet<int> Rewarded = new HashSet<int>();

		private static readonly Dictionary<int, int> ParentToId = new Dictionary<int, int>();

		private static int _blockLogged;

		private static bool DebugOn => Plugin.Cfg.BossDebug.Value;

		public static void NewLevel()
		{
			Killed.Clear();
			Rewarded.Clear();
			ParentToId.Clear();
			_blockLogged = 0;
		}

		public static void HostOnDied(EnemyHealth eh)
		{
			if (!Game.IsMaster() || (Object)(object)eh == (Object)null || !Elites.TryGet(eh, out var info))
			{
				return;
			}
			bool flag = info.Tier >= 3;
			if (flag || Plugin.Cfg.ElitesStayDead.Value)
			{
				int num = Elites.ViewId((Component)(object)eh);
				if (Killed.Add(num))
				{
					Plugin.Log.LogInfo((object)(string.Format("[boss] {0} killed ({1}, id {2}): ", flag ? ("boss " + Bosses.NameFor(num)) : (Elites.TierName(info.Tier) + " elite"), ((Object)eh).name, num) + ((Plugin.Cfg.BossRespawnRule.Value == KilledBossRespawn.StayDead) ? "it stays dead this level." : "it can come back only as a normal monster.")));
				}
			}
		}

		public static bool IsRetired(int viewId)
		{
			return Killed.Contains(viewId);
		}

		public static bool IsRetired(EnemyHealth? eh)
		{
			if ((Object)(object)eh != (Object)null)
			{
				return Killed.Contains(Elites.ViewId((Component)(object)eh));
			}
			return false;
		}

		public static bool FirstReward(int viewId)
		{
			return Rewarded.Add(viewId);
		}

		internal static bool AllowSpawn(EnemyParent parent)
		{
			if (Killed.Count == 0 || (Object)(object)parent == (Object)null || !Game.IsMaster())
			{
				return true;
			}
			int instanceID = ((Object)parent).GetInstanceID();
			if (!ParentToId.TryGetValue(instanceID, out var value))
			{
				EnemyHealth componentInChildren = ((Component)parent).GetComponentInChildren<EnemyHealth>(true);
				value = (((Object)(object)componentInChildren != (Object)null) ? Elites.ViewId((Component)(object)componentInChildren) : 0);
				ParentToId[instanceID] = value;
			}
			if (value == 0 || !Killed.Contains(value))
			{
				return true;
			}
			if (Plugin.Cfg.BossRespawnRule.Value == KilledBossRespawn.AsNormalMonster)
			{
				Elites.Remove(value);
				if (DebugOn)
				{
					Plugin.Log.LogInfo((object)$"[boss] {((Object)parent).name} (id {value}) respawns as a normal monster.");
				}
				return true;
			}
			Game.Set(parent, "DespawnedTimer", 100000f);
			if (DebugOn || _blockLogged++ < 3)
			{
				Plugin.Log.LogInfo((object)$"[boss] respawn of killed {((Object)parent).name} (id {value}) blocked: it stays dead this level.");
			}
			return false;
		}
	}
	[HarmonyPatch(typeof(EnemyParent), "Spawn")]
	internal static class KilledBossSpawnPatch
	{
		[HarmonyPrefix]
		private static bool Prefix(EnemyParent __instance)
		{
			if (!Guard.On("KilledBossSpawnPatch"))
			{
				return true;
			}
			try
			{
				return BossGraveyard.AllowSpawn(__instance);
			}
			catch (Exception e)
			{
				Guard.Fail("KilledBossSpawnPatch", e);
				return true;
			}
		}
	}
	internal static class ClassClaims
	{
		private static readonly Dictionary<int, string> Picks = new Dictionary<int, string>();

		private static float _nextAnnounce;

		private static float _nextPrune;

		private static readonly List<int> Gone = new List<int>();

		public static int LocalActor
		{
			get
			{
				try
				{
					Player localPlayer = PhotonNetwork.LocalPlayer;
					return (localPlayer != null) ? localPlayer.ActorNumber : (-1);
				}
				catch
				{
					return -1;
				}
			}
		}

		public static bool Active
		{
			get
			{
				if (Game.IsMultiplayer())
				{
					return PhotonNetwork.InRoom;
				}
				return false;
			}
		}

		public static int OtherOwner(string classId)
		{
			int num = -1;
			int localActor = LocalActor;
			foreach (KeyValuePair<int, string> pick in Picks)
			{
				if (pick.Key != localActor && pick.Value == classId && InRoom(pick.Key) && (num < 0 || pick.Key < num))
				{
					num = pick.Key;
				}
			}
			return num;
		}

		public static bool TakenByOther(string classId, out string ownerName)
		{
			ownerName = "";
			if (!Active || string.IsNullOrEmpty(classId) || Plugin.Cfg.AllowDuplicates.Value)
			{
				return false;
			}
			int num = OtherOwner(classId);
			if (num < 0)
			{
				return false;
			}
			ownerName = NameOf(num);
			return true;
		}

		public static bool HostTryClaim(int actor, string classId, out string ownerName)
		{
			ownerName = "";
			if (!Active || Plugin.Cfg.AllowDuplicates.Value)
			{
				return true;
			}
			foreach (KeyValuePair<int, string> pick in Picks)
			{
				if (pick.Key != actor && pick.Value == classId && InRoom(pick.Key))
				{
					ownerName = NameOf(pick.Key);
					return false;
				}
			}
			Picks[actor] = classId;
			return true;
		}

		public static bool LostTieFor(string classId, out string ownerName)
		{
			ownerName = "";
			if (!Active || string.IsNullOrEmpty(classId) || Plugin.Cfg.AllowDuplicates.Value)
			{
				return false;
			}
			int num = OtherOwner(classId);
			if (num < 0 || num > LocalActor)
			{
				return false;
			}
			ownerName = NameOf(num);
			return true;
		}

		public static string NameOf(int actor)
		{
			try
			{
				Room currentRoom = PhotonNetwork.CurrentRoom;
				Player val = ((currentRoom != null) ? currentRoom.GetPlayer(actor, false) : null);
				if (val != null && !string.IsNullOrEmpty(val.NickName))
				{
					return val.NickName;
				}
			}
			catch
			{
			}
			return "another player";
		}

		public static void Reset()
		{
			Picks.Clear();
			_nextAnnounce = 0f;
			Roster.Clear();
		}

		public static string ClassOf(int actor)
		{
			if (!Active || actor == LocalActor)
			{
				return RpgRuntime.Instance?.CurrentId ?? "";
			}
			if (!Picks.TryGetValue(actor, out string value))
			{
				return "";
			}
			return value;
		}

		public static void OnRemotePick(int actor, string classId)
		{
			if (actor != LocalActor)
			{
				if (string.IsNullOrEmpty(classId))
				{
					Picks.Remove(actor);
				}
				else
				{
					Picks[actor] = classId;
				}
				RpgRuntime.Instance?.OnClaimsUpdated();
			}
		}

		public static void AnnounceLocal(string? classId)
		{
			int localActor = LocalActor;
			if (localActor >= 0)
			{
				if (string.IsNullOrEmpty(classId))
				{
					Picks.Remove(localActor);
				}
				else
				{
					Picks[localActor] = classId;
				}
			}
			_nextAnnounce = Time.unscaledTime + 30f;
			Net.SendPick(classId ?? "");
		}

		public static void Tick(string? currentClassId)
		{
			if (!Active)
			{
				return;
			}
			if (Time.unscaledTime >= _nextAnnounce)
			{
				AnnounceLocal(currentClassId);
			}
			if (!(Time.unscaledTime >= _nextPrune))
			{
				return;
			}
			_nextPrune = Time.unscaledTime + 2f;
			Gone.Clear();
			foreach (int key in Picks.Keys)
			{
				if (key != LocalActor && !InRoom(key))
				{
					Gone.Add(key);
				}
			}
			foreach (int item in Gone)
			{
				Picks.Remove(item);
				Shop.HostForget(item);
				ClassStats.Forget(item);
				ClassHost.Instance?.OnPlayerLeft(item);
				TeamPlay.PlayerLeft(item);
				ContractHost.PlayerLeft(item);
				HostSettings.Forget(item);
				Account.Forget(item);
				Roster.PlayerLeft(item);
			}
			if (Gone.Count > 0)
			{
				RpgRuntime.Instance?.OnClaimsUpdated();
			}
		}

		private static bool InRoom(int actor)
		{
			try
			{
				Room currentRoom = PhotonNetwork.CurrentRoom;
				return ((currentRoom != null) ? currentRoom.GetPlayer(actor, false) : null) != null;
			}
			catch
			{
				return true;
			}
		}
	}
	internal static class ClassMigration
	{
		public static readonly (string from, string to, string oldName)[] Renamed = new(string, string, string)[2]
		{
			("lamplighter", "courier", "Lamplighter"),
			("locksmith", "instigator", "Locksmith")
		};

		public static string AccountNote = "";

		private static string NewName(string id)
		{
			return Plugin.Db.Get(id)?.name ?? id;
		}

		public static bool MigrateRun(RunSave run)
		{
			if (run == null)
			{
				return false;
			}
			bool result = false;
			List<string> list = new List<string>();
			int num = 0;
			(string, string, string)[] renamed = Renamed;
			for (int i = 0; i < renamed.Length; i++)
			{
				(string, string, string) tuple = renamed[i];
				string from = tuple.Item1;
				string to = tuple.Item2;
				string item = tuple.Item3;
				ClassProgress classProgress = run.classes.Find((ClassProgress c) => c.classId == from);
				if (classProgress != null)
				{
					int num2 = classProgress.SpentPoints();
					ClassProgress classProgress2 = run.classes.Find((ClassProgress c) => c.classId == to);
					if (classProgress2 == null)
					{
						classProgress.classId = to;
						classProgress.ranks.Clear();
						classProgress2 = classProgress;
					}
					else
					{
						if (classProgress.level > classProgress2.level || (classProgress.level == classProgress2.level && classProgress.xp > classProgress2.xp))
						{
							classProgress2.level = classProgress.level;
							classProgress2.xp = classProgress.xp;
							classProgress2.ranks.Clear();
						}
						run.classes.Remove(classProgress);
					}
					num = Mathf.Max(num, classProgress2.level);
					list.Add($"The {item} was replaced by the {NewName(to)}: your Lv {classProgress2.level} carries over" + ((num2 > 0) ? string.Format(" and your {0} skill point{1} are back to spend.", num2, (num2 == 1) ? "" : "s") : "."));
					result = true;
				}
				if (run.selectedClass == from)
				{
					run.selectedClass = to;
					result = true;
				}
				if (run.altClasses.Remove(from) && !run.altClasses.Contains(to))
				{
					run.altClasses.Add(to);
					result = true;
				}
				if (run.contracts.RemoveAll((ContractState c) => c.cls == from || c.obj == "cls." + from) > 0)
				{
					result = true;
				}
			}
			if (list.Count > 0)
			{
				run.repickLevel = Mathf.Max(run.repickLevel, num);
				run.migrationNote = string.Join(" ", list);
				run.repickSeen = false;
				Plugin.Log.LogInfo((object)$"[migrate] run save converted: {run.migrationNote} Free re-pick at Lv {run.repickLevel}.");
			}
			return result;
		}

		public static void MigrateAccount(AccountFile data)
		{
			List<string> list = new List<string>();
			(string, string, string)[] renamed = Renamed;
			for (int i = 0; i < renamed.Length; i++)
			{
				(string, string, string) tuple = renamed[i];
				string from = tuple.Item1;
				string to = tuple.Item2;
				string item = tuple.Item3;
				AccountClass accountClass = data.classes.Find((AccountClass c) => c.id == from);
				if (accountClass == null)
				{
					continue;
				}
				AccountClass accountClass2 = data.classes.Find((AccountClass c) => c.id == to);
				if (accountClass2 == null)
				{
					accountClass.id = to;
				}
				else
				{
					accountClass2.masteryXp = (int)Mathf.Min(2.1474836E+09f, (float)((long)accountClass2.masteryXp + (long)accountClass.masteryXp));
					accountClass2.bestLevel = Mathf.Max(accountClass2.bestLevel, accountClass.bestLevel);
					if (accountClass2.masteredAt == "" || (accountClass.masteredAt != "" && string.CompareOrdinal(accountClass.masteredAt, accountClass2.masteredAt) < 0))
					{
						accountClass2.masteredAt = accountClass.masteredAt;
					}
					accountClass2.alt |= accountClass.alt;
					data.classes.Remove(accountClass);
				}
				AccountClass accountClass3 = accountClass2 ?? accountClass;
				list.Add(item + " -> " + NewName(to) + ((accountClass3.masteredAt != "") ? " (mastered, alternate passive included)" : $" (best Lv {accountClass3.bestLevel})"));
			}
			if (list.Count != 0)
			{
				AccountNote = "Account: your class records moved with the replaced classes: " + string.Join(", ", list) + ". Titles are unchanged.";
				Account.MarkDirty();
				Plugin.Log.LogInfo((object)("[migrate] " + AccountNote));
			}
		}
	}
