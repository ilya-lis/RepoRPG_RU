		private void UndoLast()
		{
			string text = ((_tab < TabNames.Length) ? TabNames[_tab] : "");
			if (text != "Class" && text != "Attributes")
			{
				return;
			}
			for (int num = _undo.Count - 1; num >= 0; num--)
			{
				var (undoKind, text2) = _undo[num];
				if ((!(text == "Class") || undoKind == UndoKind.Talent) && (!(text == "Attributes") || undoKind == UndoKind.Attribute))
				{
					_undo.RemoveAt(num);
					if (undoKind == UndoKind.Talent && Current != null && _talentPending.ContainsKey(text2))
					{
						NodeDef item = TalentAlloc.Find(Current, text2).n;
						if (item != null)
						{
							TalentRemove(item);
							MenuSound(UiSound.Back);
							return;
						}
					}
					if (undoKind == UndoKind.Attribute && _attrPending.ContainsKey(text2))
					{
						AttributeDef attributeDef = AttributeAlloc.Find(text2);
						if (attributeDef != null)
						{
							AttrRemovePending(attributeDef);
							MenuSound(UiSound.Back);
							return;
						}
					}
				}
			}
			MenuSound(UiSound.Error);
		}

		private void SeedSeen()
		{
			if (_seenRunKey == _store.RunKey)
			{
				return;
			}
			_seenRunKey = _store.RunKey;
			_seenGear.Clear();
			foreach (GearItem item in _store.Data.inventory)
			{
				_seenGear.Add(item.uid);
			}
			_seenContractLevel = _store.Data.contractLevel;
		}

		private bool GearHasNew()
		{
			if (!RunReady)
			{
				return false;
			}
			SeedSeen();
			foreach (GearItem item in _store.Data.inventory)
			{
				if (!_seenGear.Contains(item.uid))
				{
					return true;
				}
			}
			return false;
		}

		private bool ContractsNew()
		{
			if (RunReady)
			{
				if ((_store.Data.contracts.Count <= 0 || _store.Data.contractLevel == _seenContractLevel) && _store.Data.rewardQueue.Count <= 0)
				{
					if (_store.Data.board.Count > 0 && _store.Data.boardLevel != _seenBoardLevel)
					{
						return ContractBoardOpen;
					}
					return false;
				}
				return true;
			}
			return false;
		}

		private void MarkGearSeen()
		{
			SeedSeen();
			foreach (GearItem item in _store.Data.inventory)
			{
				if (_seenGear.Add(item.uid))
				{
					_newThisView.Add(item.uid);
				}
			}
		}

		private string UnspentText()
		{
			if (!RunReady || Current == null || CurrentProgress == null)
			{
				return "";
			}
			int num = Leveling.AvailablePoints(CurrentProgress);
			int num2 = Leveling.AvailableAttributePoints(CurrentProgress, _store.Data);
			int perkPicksPending = _store.Data.perkPicksPending;
			if (num <= 0 && num2 <= 0 && perkPicksPending <= 0)
			{
				return "";
			}
			List<string> list = new List<string>();
			if (num > 0)
			{
				list.Add(string.Format("{0} skill point{1}", num, (num == 1) ? "" : "s"));
			}
			if (num2 > 0)
			{
				list.Add(string.Format("{0} attribute point{1}", num2, (num2 == 1) ? "" : "s"));
			}
			if (perkPicksPending > 0)
			{
				list.Add(string.Format("{0} perk pick{1}", perkPicksPending, (perkPicksPending == 1) ? "" : "s"));
			}
			return "Unspent: " + string.Join(" · ", list) + "  (" + MenuPrompt + ")";
		}

		private string ShopReason(int price, bool open, string otherReason)
		{
			if (!open)
			{
				return "Shop closed - it opens between levels";
			}
			if (otherReason != "")
			{
				return otherReason;
			}
			if (price > 0 && Scrap.Mine + 1E-06 < (double)price)
			{
				return "Not enough " + Scrap.Short + " - " + Scrap.Format(Math.Ceiling((double)price - Scrap.Mine)) + " more needed";
			}
			return "";
		}

