		public void StartHeadCheck()
		{
			if (Game.InLevel())
			{
				((MonoBehaviour)this).StartCoroutine(HeadCheck());
			}
		}

		private IEnumerator HeadCheck()
		{
			yield return (object)new WaitForSeconds(8f);
			if (!Game.InLevel())
			{
				yield break;
			}
			int level = RunInfo.LevelIndex;
			if (!Game.IsMaster())
			{
				float waited = 8f;
				while (waited < 30f && MissingHeads() > 0)
				{
					yield return (object)new WaitForSeconds(1f);
					waited += 1f;
					if (!Game.InLevel() || RunInfo.LevelIndex != level)
					{
						yield break;
					}
				}
				if (MissingHeads() == 0)
				{
					Plugin.Log.LogInfo((object)$"[death] every death head here {waited:0}s after the level started (client).");
					yield break;
				}
			}
			if (HeadReport(Game.IsMaster() ? "8s in" : "30s in") == 0)
			{
				yield break;
			}
			try
			{
				DescribeHeads();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[death] head list failed: " + ex.GetBaseException().Message));
			}
			try
			{
				RepairHeads();
			}
			catch (Exception ex2)
			{
				Plugin.Log.LogWarning((object)("[death] head repair failed: " + ex2.GetBaseException().Message));
			}
			yield return (object)new WaitForSeconds(4f);
			if (Game.InLevel() && RunInfo.LevelIndex == level)
			{
				try
				{
					RelinkHeads();
				}
				catch
				{
				}
				HeadReport("after the repair");
			}
		}

