		private string CardBody(ContractState c, bool withReward, bool full = false)
		{
			string text = ContractBoard.Objective(c);
			string text2 = ContractBoard.BonusText(c);
			if (text2 != "")
			{
				string text3 = ((c.bonusState == 1) ? " <color=#73ff66>(met)</color>" : ((c.bonusState == 2) ? " <color=#ff7a6b>(missed)</color>" : ""));
				text = text + "\n<color=#ffd75a>BONUS</color> " + text2 + " (+50% " + Scrap.Short + ")" + text3;
			}
			if (full && c.kind == 3)
			{
				string text4 = ContractBoard.ChainLine(c);
				if (text4 != "")
				{
					text = text + "\n<i><color=#c8c8c8>\"" + text4 + "\"</color></i>";
				}
			}
			if (full && c.kind == 2)
			{
				text += "\n<color=#9a9ca0>Everyone who takes it competes; best score wins (ties split, top 2 paid with 5+). Needs 2 entrants.</color>";
			}
			if (withReward)
			{
				text = text + "\n<color=#ffb21e>REWARD</color> " + ContractBoard.RewardText(c);
			}
			return text;
		}

		private bool CtFlashing(string uid, out float k)
		{
			k = 0f;
			if (!_ctFlash.TryGetValue(uid, out var value))
			{
				return false;
			}
			float num = Time.unscaledTime - value;
			if (num > 1.5f)
			{
				return false;
			}
			k = 1f - num / 1.5f;
			return true;
		}

		private string ProgressText(ContractState c)
		{
			if (c.type != "Board")
			{
				return $"{c.progress}/{c.target}";
			}
			float levelElapsed = LevelElapsed;
			switch (c.obj)
			{
			case "speed":
			case "speedall":
			{
				float num = Mathf.Max(0f, (float)c.target * 60f - levelElapsed);
				return $"{Mathf.FloorToInt(num / 60f)}:{Mathf.FloorToInt(num % 60f):00} left";
			}
			case "unscathed":
				return $"{c.progress}/{c.target} damage";
			case "nodeath":
				return "nobody died";
			case "value":
			case "strictvalue":
			case "cls.appraiser":
			case "cls.restorer":
				return $"${c.progress:N0} / ${c.target:N0}";
			default:
				if (c.kind == 2)
				{
					return "judged at the end";
				}
				if (!(c.bonus == "double"))
				{
					return $"{c.progress}/{c.target}";
				}
				return $"{c.progress}/{c.target} (bonus {c.target * 2})";
			}
		}

