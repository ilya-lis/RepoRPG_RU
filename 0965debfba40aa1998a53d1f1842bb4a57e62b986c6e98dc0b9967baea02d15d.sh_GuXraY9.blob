		private void NotePerkOffer(List<List<string>> sets, int picks)
		{
			int num = 17;
			for (int i = 0; i < picks && i < sets.Count; i++)
			{
				foreach (string item in sets[i])
				{
					num = num * 31 + item.GetHashCode();
				}
			}
			if (num != _perkRevealKey)
			{
				_perkRevealKey = num;
				_perkRevealAt = Time.unscaledTime;
				for (int j = 0; j < picks && j < sets.Count; j++)
				{
					Account.SeePerks(sets[j]);
				}
			}
		}

