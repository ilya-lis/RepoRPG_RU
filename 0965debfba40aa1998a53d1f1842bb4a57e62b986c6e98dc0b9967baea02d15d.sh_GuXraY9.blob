		public void Buy(string itemKey, string label, int baseCostK, Action onPaid)
		{
			//IL_0027: Unknown result type (might be due to invalid IL or missing references)
			int num = Shop.Price(baseCostK);
			if (num <= 0)
			{
				_lastCharged = 0;
				onPaid();
				return;
			}
			if (!Shop.OpenNow)
			{
				Toast("The mod shop is open while you're in the shop between levels", Color.gray);
				return;
			}
			foreach (PendingBuy value in _pendingBuys.Values)
			{
				if (value.Label == label)
				{
					return;
				}
			}
			int num2 = ++_nextBuyId;
			_pendingBuys[num2] = new PendingBuy
			{
				Label = label,
				OnPaid = onPaid,
				SentAt = Time.unscaledTime,
				Item = itemKey,
				Cost = num
			};
			Net.Buy(num2, itemKey, num);
		}

		private void TickPendingBuys()
		{
			if (_pendingBuys.Count == 0)
			{
				return;
			}
			List<int> list = null;
			List<int> list2 = null;
			float unscaledTime = Time.unscaledTime;
			foreach (KeyValuePair<int, PendingBuy> pendingBuy2 in _pendingBuys)
			{
				PendingBuy value = pendingBuy2.Value;
				if (!(unscaledTime - value.SentAt < 5f))
				{
					if (!value.Retried)
					{
						value.Retried = true;
						value.SentAt = unscaledTime;
						(list2 ?? (list2 = new List<int>())).Add(pendingBuy2.Key);
					}
					else
					{
						(list ?? (list = new List<int>())).Add(pendingBuy2.Key);
					}
				}
			}
			if (list2 != null)
			{
				foreach (int item in list2)
				{
					PendingBuy pendingBuy = _pendingBuys[item];
					Net.ResendBuy(item, pendingBuy.Item, pendingBuy.Cost);
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (int item2 in list)
			{
				GiveUpBuy(item2, "Couldn't reach the host");
			}
		}

		private void GiveUpBuy(int id, string why)
		{
			//IL_0069: Unknown result type (might be due to invalid IL or missing references)
			if (_pendingBuys.TryGetValue(id, out PendingBuy value))
			{
				_pendingBuys.Remove(id);
				_lateBuys[id] = value;
				if (_lateBuys.Count > 20)
				{
					_lateBuys.Clear();
				}
				if (why != "")
				{
					Toast(why + " - " + value.Label + " not bought", Color.gray);
				}
				Plugin.Log.LogWarning((object)$"[net] purchase '{value.Label}' (#{id}) got no answer from the host ({why}).");
			}
		}

		public void ClearPendingBuys()
		{
			foreach (int item in new List<int>(_pendingBuys.Keys))
			{
				GiveUpBuy(item, "");
			}
		}

		public void OnBuyResult(int id, bool ok, int charged, string reason)
		{
			//IL_0188: Unknown result type (might be due to invalid IL or missing references)
			//IL_0089: Unknown result type (might be due to invalid IL or missing references)
			//IL_021b: Unknown result type (might be due to invalid IL or missing references)
			if (!_pendingBuys.TryGetValue(id, out PendingBuy value))
			{
				if (ok && _lateBuys.TryGetValue(id, out PendingBuy value2))
				{
					_lateBuys.Remove(id);
					_lastCharged = charged;
					value2.OnPaid();
					Notify(PopupKind.Other, "Bought after all: " + value2.Label + ((charged > 0) ? (" (-" + Scrap.Price(charged) + ")") : ""), (Color?)new Color(1f, 0.7f, 0.12f), "");
					_store.SaveNow();
				}
				return;
			}
			_pendingBuys.Remove(id);
			if (!ok)
			{
				string text = reason switch
				{
					"shop closed" => "the shop is closed", 
					"too fast" => "slow down a moment", 
					"unknown item" => "the host's mod version doesn't sell that", 
					"not verified" => "the host couldn't confirm who you are yet - try again in a moment", 
					_ => (charged > 0) ? ("not enough " + Scrap.Short + " (" + Scrap.Price(charged) + ")") : ("not enough " + Scrap.Short), 
				};
				Toast("Couldn't buy " + value.Label + ": " + text, new Color(1f, 0.4f, 0.35f));
				MenuSound(UiSound.Error);
				return;
			}
			_lastCharged = ((charged > 0) ? charged : value.Cost);
			value.OnPaid();
			if (!value.Item.StartsWith("buyback:"))
			{
				AddReputation(_lastCharged);
			}
			Notify(PopupKind.Other, "Bought: " + value.Label + ((charged > 0) ? (" (-" + Scrap.Price(charged) + ")") : ""), (Color?)new Color(1f, 0.7f, 0.12f), "");
			MenuSound(UiSound.Confirm);
			_store.SaveNow();
		}

		public void OnPurchaseNotice(string who, string item, int charged)
		{
			string text = item switch
			{
				"crate" => "a gear crate", 
				"premium" => "a premium crate", 
				"reroll" => "a gear reroll", 
				"upgrade" => "a gear upgrade", 
				"perkreroll" => "a perk reroll", 
				"respec" => "a respec", 
				"moduleremove" => "a module removal", 
				"module" => "a module", 
				"lock" => "a stock lock", 
				"svc:affix" => "an affix reroll", 
				"svc:attune" => "an attunement boost", 
				"svc:partsup" => "a parts upgrade", 
				_ => item.StartsWith("stock:") ? "gear from Rivet" : ((!item.StartsWith("cons:")) ? (item.StartsWith("buyback:") ? "back salvaged gear" : item) : (ShopX.Cons(item.Substring(5))?.name ?? "a consumable")), 
			};
			Notify(PopupKind.Other, who + " bought " + text + " (" + Scrap.Price(charged) + ")");
		}

