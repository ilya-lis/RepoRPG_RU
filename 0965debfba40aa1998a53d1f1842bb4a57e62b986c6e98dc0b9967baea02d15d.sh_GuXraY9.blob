		private static bool IsFromHost(int sender)
		{
			try
			{
				return PhotonNetwork.MasterClient != null && sender == PhotonNetwork.MasterClient.ActorNumber;
			}
			catch
			{
				return false;
			}
		}

		private static void ApplyEnemyEffect(Vector3 origin, float radius, int damage, float stun, float markPct = 0f, float markSeconds = 0f)
		{
			//IL_0087: Unknown result type (might be due to invalid IL or missing references)
			//IL_008c: Unknown result type (might be due to invalid IL or missing references)
			//IL_008d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0092: Unknown result type (might be due to invalid IL or missing references)
			//IL_0111: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f1: Unknown result type (might be due to invalid IL or missing references)
			//IL_00e8: Unknown result type (might be due to invalid IL or missing references)
			radius = Mathf.Clamp(radius, 0f, 30f);
			damage = Mathf.Clamp(damage, 0, 200);
			stun = Mathf.Clamp(stun, 0f, 15f);
			markPct = Mathf.Clamp(markPct, 0f, Plugin.Cfg.MaxMarkDamage.Value);
			markSeconds = Mathf.Clamp(markSeconds, 0f, 30f);
			float num = radius * radius;
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				EnemyHealth current = enumerator.Current;
				Vector3 val = ((Component)current).transform.position - origin;
				if (!(((Vector3)(ref val)).sqrMagnitude > num))
				{
					if (markPct > 0f && markSeconds > 0f)
					{
						HostDirector.Instance?.Mark(current, markPct, markSeconds);
					}
					if (stun > 0f)
					{
						Game.StunEnemy(current, stun);
					}
					if (damage > 0)
					{
						Game.HurtEnemy(current, damage, (((Vector3)(ref val)).sqrMagnitude > 0.01f) ? ((Vector3)(ref val)).normalized : Vector3.up);
					}
				}
			}
			ClassHost.Instance?.OnAreaHit(origin, radius, damage, stun);
		}

		public static void SendContractAccept(int reqId, string uid, string id, int tier, int level, int slots)
		{
