				}
				break;
			case 9:
				if (text == "Contracts")
				{
					DrawContractsTab(rContent);
				}
				break;
			case 7:
				if (text == "Account")
				{
					DrawAccountTab(rContent);
				}
				break;
			case 6:
				break;
			}
		}

		private static string AttrEffects(AttributeDef a, float points)
		{
			List<string> list = new List<string>();
			EffectDef[] effects = a.effects;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex >= 0)
				{
					list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value * points));
				}
			}
			return string.Join(", ", list);
		}

		private string AttrDetail(string part, Func<string> build)
		{
			if (!_attrDetail.TryGetValue(part, out string value))
			{
				value = build();
				_attrDetail[part] = value;
			}
			return value;
		}

		private string AttributeSummary(int pendingTotal, bool busy)
		{
			if (pendingTotal == 0)
			{
				return "<color=#9a9ca0>Choose points with + / - (or left / right), then confirm.</color>";
			}
			List<string> list = new List<string>();
			AttributeDef[] attributes = Plugin.Rpg.attributes;
			foreach (AttributeDef attributeDef in attributes)
			{
				int num = AttrPendingOf(attributeDef.id);
				if (num > 0)
				{
					list.Add($"{attributeDef.name} +{num}");
				}
			}
			return (busy ? "<color=#73ff66><b>Applying...</b></color>  " : $"<color=#73ff66><b>{pendingTotal} pending:</b></color>  ") + string.Join(", ", list);
		}

