			string[] item = NavGroups[g].subs;
			foreach (string value in item)
			{
				int num = Array.IndexOf(TabNames, value);
				if (num >= 0)
				{
					_navSubs.Add(num);
				}
			}
			return _navSubs;
		}

		private void SwitchMainTo(int g)
		{
			g = (g % NavGroups.Length + NavGroups.Length) % NavGroups.Length;
			List<int> list = SubsOf(g);
			if (list.Count != 0)
			{
				int t = ((_navLastSub[g] >= 0 && list.Contains(_navLastSub[g])) ? _navLastSub[g] : list[0]);
				SwitchTabTo(t);
			}
		}

		private void SwitchMain(int delta)
		{
			SwitchMainTo(GroupOf((_tab < TabNames.Length) ? TabNames[_tab] : "Class") + delta);
		}

		private void SwitchSub(int delta)
		{
			List<int> list = SubsOf(GroupOf((_tab < TabNames.Length) ? TabNames[_tab] : "Class"));
			if (list.Count >= 2)
			{
				int num = Mathf.Max(0, list.IndexOf(_tab));
				SwitchTabTo(list[((num + delta) % list.Count + list.Count) % list.Count]);
			}
		}

		private void NoteNavTab(int t)
		{
			if (t >= 0 && t < TabNames.Length)
			{
				_navLastSub[GroupOf(TabNames[t])] = t;
			}
		}

		private int TabBadge(string tab)
		{
			int num = 0;
			foreach (ActionNotice item in Notices.Active)
			{
				if (item.Tab == tab && item.Important)
				{
					num++;
				}
			}
			if (RunReady)
			{
				if (tab == "Class" && CurrentProgress != null)
				{
					num += Mathf.Max(0, Leveling.AvailablePoints(CurrentProgress));
				}
				else if (tab == "Attributes")
				{
					num += Mathf.Max(0, Leveling.AvailableAttributePoints(CurrentProgress, _store.Data));
				}
			}
			return num;
		}

		private bool TabNew(string tab)
		{
			if (!(tab == "Gear") || !GearHasNew())
			{
				if (tab == "Contracts")
				{
					return ContractsNew();
				}
				return false;
			}
			return true;
		}

