		private static readonly SortedSet<string> Off = new SortedSet<string>();

		private static bool _noticeShown;

		private static string CheckApi(string type, char kind, string member, string returns, string[] args)
		{
			Type type2 = AccessTools.TypeByName(type);
			if (type2 == null)
			{
				return "type " + type + " is missing";
			}
			switch (kind)
			{
			case 'p':
			{
				PropertyInfo property = type2.GetProperty(member, BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				if (property == null)
				{
					return type + "." + member + " is missing";
				}
				if (!(property.PropertyType.FullName == returns))
				{
					return type + "." + member + " is " + property.PropertyType.FullName + ", not " + returns;
				}
				return "";
			}
			case 'f':
			{
				FieldInfo field = type2.GetField(member, BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				if (field == null)
				{
					return type + "." + member + " is missing";
				}
				if (!(field.FieldType.FullName == returns))
				{
					return type + "." + member + " is " + field.FieldType.FullName + ", not " + returns;
				}
				return "";
			}
			case 'e':
				if (!(type2.GetEvent(member, BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic) != null))
				{
					return "event " + type + "." + member + " is missing";
				}
				return "";
			default:
			{
				string text = string.Join(", ", args);
				string text2 = "";
				MethodInfo[] methods = type2.GetMethods(BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				foreach (MethodInfo methodInfo in methods)
				{
					if (methodInfo.Name != member || methodInfo.IsGenericMethodDefinition)
					{
						continue;
					}
					ParameterInfo[] parameters = methodInfo.GetParameters();
					string[] array = new string[parameters.Length];
					for (int j = 0; j < parameters.Length; j++)
					{
						array[j] = parameters[j].ParameterType.FullName ?? parameters[j].ParameterType.Name;
					}
					if (!(string.Join(", ", array) != text))
					{
						if (methodInfo.ReturnType.FullName == returns)
						{
							return "";
						}
						text2 = methodInfo.ReturnType.FullName ?? "";
					}
				}
				if (!(text2 != ""))
				{
					return type + "." + member + "(" + text + ") is missing";
				}
				return type + "." + member + "(" + text + ") returns " + text2 + ", not " + returns;
			}
			}
		}

		public static void Run(IEnumerable<string> skippedPatches)
		{
			foreach (string skippedPatch in skippedPatches)
			{
				string value;
				string text = (PatchFeature.TryGetValue(skippedPatch, out value) ? value : skippedPatch);
				Off.Add(text);
				Plugin.Log.LogWarning((object)("[compat] patch " + skippedPatch + " not applied (the game method changed or is missing): '" + text + "' is off."));
			}
			(string, string, string)[] members = Members;
			for (int i = 0; i < members.Length; i++)
			{
				(string, string, string) tuple = members[i];
				string item = tuple.Item1;
				string item2 = tuple.Item2;
				string item3 = tuple.Item3;
				Type type = AccessTools.TypeByName(item);
				if (!(type != null) || (!(AccessTools.Field(type, item2) != null) && !(AccessTools.Property(type, item2) != null)))
				{
					Off.Add(item3);
					Plugin.Log.LogWarning((object)("[compat] game member " + item + "." + item2 + " is missing (game update?): '" + item3 + "' may not work."));
				}
			}
			foreach (var (text2, text3) in Game.CheckAccessors())
			{
				Off.Add(text3);
				Plugin.Log.LogWarning((object)("[compat] accessor for " + text2 + " couldn't be made (game update?): '" + text3 + "' is off."));
			}
			int num = 0;
			(string, char, string, string, string[], string, string)[] unityApis = UnityApis;
			for (int i = 0; i < unityApis.Length; i++)
			{
				var (type2, kind, member, returns, args, text4, text5) = unityApis[i];
				string text6;
				try
				{
					text6 = CheckApi(type2, kind, member, returns, args);
				}
				catch (Exception ex)
				{
					text6 = ex.Message;
				}
				if (text6 == "")
				{
					num++;
					continue;
				}
				Off.Add(text4);
				if (text5 != "")
				{
					Guard.DisableForSession(text5);
				}
				Plugin.Log.LogWarning((object)("[compat] Unity API changed in this game version (" + Application.unityVersion + "): " + text6 + ". '" + text4 + "' is off" + ((text5 != "") ? "." : " where it's used (errors are caught).") + " An updated RepoRPG is needed."));
			}
			if (Off.Count == 0)
			{
				Plugin.Log.LogInfo((object)$"[compat] every patched method, game member, accessor and Unity API ({num}) the mod uses was found (Unity {Application.unityVersion}).");
			}
		}

		public static void TickNotice()
		{
			//IL_009d: Unknown result type (might be due to invalid IL or missing references)
			if (!_noticeShown && Off.Count != 0 && !((Object)(object)RpgRuntime.Instance == (Object)null) && Game.InLevel())
			{
				_noticeShown = true;
				string text = string.Join(", ", Off.Take(6)) + ((Off.Count > 6) ? $" and {Off.Count - 6} more" : "");
				RpgRuntime.Instance.Notify(RpgRuntime.PopupKind.Other, "RepoRPG: this game version changed something - off: " + text + ". See the log.", (Color?)new Color(1f, 0.7f, 0.4f), "");
			}
		}
	}
	internal static class Guard
	{
		private sealed class State
		{
			public int Total;

			public int ThisLevel;

			public bool Off;

			public bool Announced;

			public bool Permanent;
		}

		private static readonly Dictionary<string, State> States = new Dictionary<string, State>();

		private static readonly List<string> Pending = new List<string>();

		private const int FailLimit = 5;

		public static bool On(string feature)
		{
			if (States.TryGetValue(feature, out State value))
			{
				return !value.Off;
			}
			return true;
		}

		public static void Fail(string feature, Exception e)
		{
			try
			{
				if (!States.TryGetValue(feature, out State value))
				{
					value = (States[feature] = new State());
				}
				value.Total++;
				value.ThisLevel++;
				if (value.Total == 1)
				{
					Plugin.Log.LogError((object)$"[{feature}] error (logged once; the game carries on): {e}");
				}
				if (!value.Off && value.ThisLevel >= 5)
				{
					value.Off = true;
					if (!value.Announced)
					{
						value.Announced = true;
						Plugin.Log.LogWarning((object)$"[{feature}] failed {value.ThisLevel} times: switched off until the next level. Everything else keeps working.");
						Pending.Add(feature);
					}
				}
			}
			catch
			{
			}
		}

		public static void NewLevel()
		{
			foreach (State value in States.Values)
			{
				if (!value.Permanent)
				{
					value.Off = false;
				}
				value.ThisLevel = 0;
			}
		}

		public static void DisableForSession(string feature)
		{
			if (!States.TryGetValue(feature, out State value))
			{
				value = (States[feature] = new State());
			}
			value.Off = (value.Permanent = (value.Announced = true));
		}

		public static void TickNotice()
		{
			//IL_0059: Unknown result type (might be due to invalid IL or missing references)
			if (Pending.Count == 0 || (Object)(object)RpgRuntime.Instance == (Object)null)
			{
				return;
			}
			string text = string.Join(", ", Pending);
			Pending.Clear();
			try
			{
				RpgRuntime.Instance.Notify(RpgRuntime.PopupKind.Other, "RepoRPG: '" + text + "' hit an error and was switched off until the next level. The rest of the mod keeps working.", (Color?)new Color(1f, 0.6f, 0.4f), "");
			}
			catch
			{
			}
		}

		public static string Summary()
		{
			if (States.Count == 0)
			{
				return "no errors";
			}
			List<string> list = new List<string>();
			foreach (KeyValuePair<string, State> state in States)
			{
				list.Add(string.Format("{0} x{1}{2}", state.Key, state.Value.Total, state.Value.Off ? " (off)" : ""));
			}
			return string.Join(", ", list);
		}
	}
	internal static class LoopTrace
	{
		public static void Note(string what)
		{
			try
			{
				Plugin.Log.LogInfo((object)("[loop] " + Where() + " | " + what));
			}
			catch
			{
			}
		}

		public static string Where()
		{
			string text = (Game.InLevel() ? "level" : (Game.InShopLevel() ? "shop" : (Game.InLobby() ? "truck" : (Game.InLobbyMenu() ? "lobby" : "menu"))));
			return string.Format("{0} {1} {2} {3}p", Game.IsMaster() ? "host" : "client", text, RunInfo.LevelIndex + 1, Game.Players().Count);
		}

		public static string NameOf(PlayerAvatar? p)
		{
			if (!((Object)(object)p == (Object)null))
			{
				return Game.Get(p, "playerName", "?") + (((Object)(object)p == (Object)(object)Game.LocalPlayer()) ? " (you)" : "");
			}
			return "?";
		}
	}
	internal static class MenuLibCheck
	{
		public const string Guid = "nickklmao.menulib";

		public const string Package = "MenuLib by REPOModding";

		public const string DeprecatedPackage = "nickklmao-MenuLib";

		private static bool _checked;

		public static void CheckInstall()
		{
			try
			{
				string root = Paths.PluginPath;
				if (string.IsNullOrEmpty(root) || !Directory.Exists(root))
				{
					return;
				}
				List<string> list = new List<string>();
				string[] files = Directory.GetFiles(root, "MenuLib.dll", SearchOption.AllDirectories);
				foreach (string item in files)
				{
					list.Add(item);
				}
				List<string> list2 = list.FindAll((string f) => f.IndexOf("nickklmao", StringComparison.OrdinalIgnoreCase) >= 0);
				foreach (string item2 in list2)
				{
					Plugin.Log.LogWarning((object)("[MenuLib] The deprecated MenuLib by nickklmao is installed (" + Relative(root, item2) + "). Uninstall \"nickklmao-MenuLib\" in your mod manager and keep \"MenuLib by REPOModding\" (REPOModding-MenuLib). Both use the same id, so BepInEx loads only one of them."));
				}
				if (list.Count > 1 && list2.Count == 0)
				{
					Plugin.Log.LogWarning((object)(string.Format("[MenuLib] {0} copies of MenuLib.dll are installed ({1}). ", list.Count, string.Join(", ", list.ConvertAll((string c) => Relative(root, c)))) + "Keep only \"MenuLib by REPOModding\" (REPOModding-MenuLib) and remove the others."));
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogInfo((object)("[MenuLib] couldn't check the installed copies: " + ex.Message));
			}
		}

		public static void CheckLoaded(bool available)
		{
			if (_checked)
			{
				return;
			}
			_checked = true;
			try
			{
				PluginInfo value;
				if (!available)
				{
					Plugin.Log.LogWarning((object)"[MenuLib] MenuLib isn't installed (or failed to load). It's a listed dependency of RepoRPG (\"MenuLib by REPOModding\", REPOModding-MenuLib 2.6.0 or newer); install it from your mod manager's Online tab. Nothing is missing meanwhile: RepoRPG's menu opens with the K key (View on a controller).");
				}
				else if (Chainloader.PluginInfos.TryGetValue("nickklmao.menulib", out value) && value != null)
				{
					string text = value.Location ?? "";
					ManualLogSource log = Plugin.Log;
					BepInPlugin metadata = value.Metadata;
					log.LogInfo((object)$"[MenuLib] using MenuLib {((metadata != null) ? metadata.Version : null)} ({text}).");
					if (text.IndexOf("nickklmao", StringComparison.OrdinalIgnoreCase) >= 0)
					{
						Plugin.Log.LogWarning((object)"[MenuLib] the loaded MenuLib is the deprecated nickklmao package. Install \"MenuLib by REPOModding\" (REPOModding-MenuLib) and uninstall \"nickklmao-MenuLib\".");
					}
					if (value.Metadata != null && Version.TryParse(value.Metadata.Version?.ToString() ?? "", out Version result) && result < new Version(2, 6, 0))
					{
						Plugin.Log.LogWarning((object)string.Format("[MenuLib] MenuLib {0} is older than 2.6.0 (the version for R.E.P.O. 0.5.0): update \"{1}\".", value.Metadata.Version, "MenuLib by REPOModding"));
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogInfo((object)("[MenuLib] couldn't read the loaded plugin list: " + ex.Message));
			}
		}

		private static string Relative(string root, string path)
		{
			try
			{
				return path.StartsWith(root, StringComparison.OrdinalIgnoreCase) ? ("plugins" + path.Substring(root.Length)) : path;
			}
			catch
			{
				return path;
			}
		}
	}
	internal static class PerkEv
