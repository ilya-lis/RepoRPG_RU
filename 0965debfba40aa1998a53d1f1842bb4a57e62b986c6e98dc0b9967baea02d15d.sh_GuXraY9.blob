			HudChipRoute = c.Bind<bool>("HUD", "ChipRoute", true, "HUD card: the chosen route's chip (in levels).");
			HudChipPoints = c.Bind<bool>("HUD", "ChipPointsToSpend", true, "HUD card: the \"+N to spend\" chip.");
			HudChipCatchUp = c.Bind<bool>("HUD", "ChipCatchUp", true, "HUD card: the catch-up XP chip.");
			HudAlerts = c.Bind<bool>("HUD", "ActionNeededPanel", true, "Action needed: the banner and the on-screen list. Off: the tab badges in the menu stay, and a vote with a deadline still comes back once near its end (unless Notices > FinalReminder is off).");
			HudScanMarkers = c.Bind<bool>("HUD", "ScanMarkers", true, "Appraiser: the markers on scanned valuables (the scan still runs).");
			HudScanOutlines = c.Bind<bool>("HUD", "ScanOutlines", true, "Appraiser: the outlines on scanned valuables.");
			HudElementIcons = c.Bind<bool>("HUD", "MonsterElementIcons", true, "Elemental status icons above monsters.");
			HudThreatLabels = c.Bind<bool>("HUD", "ThreatLabels", true, "Lookout: monster names and threat above their heads.");
			HudHighlights = c.Bind<bool>("HUD", "HighlightsCard", true, "The highlights card when you reach the shop.");
			HudContracts = c.Bind<HudShow>("HUD", "ContractsPanel", HudShow.Always, "This level's contracts, bottom right: Always, TruckAndShop, LevelsOnly or Never (they only exist in levels).");
			HudEliteLines = c.Bind<bool>("HUD", "BossAndEliteText", true, "Boss and elite names and status, top right.");
			HudBeams = c.Bind<bool>("HUD", "LightBeams", true, "Light beams in the world: research samples' teal beam and light, and the beam where a cursed item turns up.");
