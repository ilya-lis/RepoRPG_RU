		public static readonly string[] VendorBrowse = new string[4] { "Everything's ninety percent original parts. Some of them are even original.", "Take your time. I've got nowhere to be. Literally. My wheels are bolted down.", "Fresh stock! Well. Fresh-ish.", "If it hums, don't lick it." };

