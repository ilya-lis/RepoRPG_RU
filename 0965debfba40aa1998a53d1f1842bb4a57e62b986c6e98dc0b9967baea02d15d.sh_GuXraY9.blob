		private string ShadowText(string text)
		{
			if (text.IndexOf("<color", StringComparison.Ordinal) < 0)
			{
				return text;
			}
			if (_shadowText.TryGetValue(text, out string value))
			{
				return value;
			}
			value = ColorTags.Replace(text, "");
			if (_shadowText.Count > 1000)
			{
				_shadowText.Clear();
			}
			_shadowText[text] = value;
			return value;
		}

		private Font? LoadFont()
		{
			string text = Plugin.Cfg.UiFont.Value.Trim();
			if (!string.Equals(text, "auto", StringComparison.OrdinalIgnoreCase) && text.Length > 0)
			{
				try
				{
					return Font.CreateDynamicFontFromOSFont(text, 32);
				}
