			GuideStep[] walkthrough = Guide.Data.walkthrough;
			if (walkthrough.Length == 0)
			{
				_guideWalk = false;
				return;
			}
			_guideStep = Mathf.Clamp(_guideStep, 0, walkthrough.Length - 1);
			GuideStep guideStep = walkthrough[_guideStep];
			float num = Mathf.Min(760f, ((Rect)(ref area)).width);
			string text = ResolveGuide(guideStep.text);
			float num2 = LineH(_h2);
			float num3 = TextH(text, _body, num - 24f);
			float num4 = 24f + num2 + 8f + num3 + 16f + BtnH;
			Rect r = default(Rect);
			((Rect)(ref r))..ctor(((Rect)(ref area)).x, ((Rect)(ref area)).y, num, Mathf.Min(num4, ((Rect)(ref area)).height));
			Box(r);
			ShadowLabel(new Rect(((Rect)(ref r)).x + 12f, ((Rect)(ref r)).y + 12f, ((Rect)(ref r)).width - 24f, num2 + 2f), guideStep.title, _h2, Accent);
			Label(new Rect(((Rect)(ref r)).x + 12f, ((Rect)(ref r)).y + 12f + num2 + 8f, ((Rect)(ref r)).width - 24f, num3 + 2f), text, _body);
			StringBuilder stringBuilder = new StringBuilder();
			for (int i = 0; i < walkthrough.Length; i++)
			{
				stringBuilder.Append((i == _guideStep) ? "● " : "○ ");
			}
			Label(new Rect(((Rect)(ref r)).x + 12f, ((Rect)(ref r)).yMax - 12f - BtnH, 140f, BtnH), stringBuilder.ToString(), _body);
			float num5 = Mathf.Min(170f, (((Rect)(ref r)).width - 24f - 150f - 16f) / 3f);
			bool flag = _guideStep == walkthrough.Length - 1;
			Rect r2 = default(Rect);
			((Rect)(ref r2))..ctor(((Rect)(ref r)).xMax - 12f - num5, ((Rect)(ref r)).yMax - 12f - BtnH, num5, BtnH);
			Rect r3 = default(Rect);
			((Rect)(ref r3))..ctor(((Rect)(ref r2)).x - 8f - num5, ((Rect)(ref r2)).y, num5, BtnH);
			Rect r4 = default(Rect);
			((Rect)(ref r4))..ctor(((Rect)(ref r3)).x - 8f - num5, ((Rect)(ref r2)).y, num5, BtnH);
			if (Btn(r4, flag ? "Close" : "Skip"))
			{
				FinishGuide();
			}
			if (Btn(r3, "Back", _guideStep > 0))
			{
				_guideStep--;
			}
			if (Btn(r2, flag ? "Start playing" : "Next"))
			{
				if (flag)
				{
					FinishGuide();
				}
				else
				{
					_guideStep++;
				}
			}
		}

