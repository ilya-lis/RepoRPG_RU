		private string TreeThemes(ClassDef vc)
		{
			if (_treeThemes.TryGetValue(vc, out string value))
			{
				return value;
			}
			List<string> list = new List<string>();
			BranchDef[] branches = vc.branches;
			foreach (BranchDef branchDef in branches)
			{
