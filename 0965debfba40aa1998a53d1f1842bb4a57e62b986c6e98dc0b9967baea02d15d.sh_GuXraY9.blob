		public static int TargetFor(string id, int players)
		{
			return id switch
			{
				"brass" => 4 + 2 * Mathf.Max(1, players), 
				"kaboom" => 20, 
				"hollis" => 2 + Mathf.Max(1, players), 
				"dispatch" => 8, 
				"auditor" => 3, 
				_ => 1, 
			};
		}

		public static string SponsorGoal(string id, int target)
		{
			return id switch
			{
				"brass" => $"Finish {target} contracts as a team", 
				"kaboom" => $"Take down {target} elites (a boss counts 3)", 
				"hollis" => $"Lose no more than {target} lives in the whole team (and clear 5 levels)", 
				"dispatch" => $"Reach a streak of {target} levels", 
				"auditor" => $"Reach {target} more milestones", 
				_ => "", 
			};
		}

		public static bool HasDrill(string id)
		{
			if (Research.On)
			{
				return Array.IndexOf(Cur.Drills, id) >= 0;
			}
			return false;
		}

		public static void Apply(State s)
		{
			State cur = Cur;
			if (s.DrillFor != cur.DrillFor)
			{
				MyDrillVote = -1;
			}
			if (string.Join(",", s.SponsorOffer) != string.Join(",", cur.SponsorOffer))
			{
				MySponsorVote = -1;
			}
			Cur = s;
			RpgRuntime.Instance?.OnCrewStateC(cur, s);
		}

		public static float ReviveHealthFloor(float health)
		{
			if (!HasDrill("recovery"))
			{
