		public static Color ParseColor(string hex)
		{
			//IL_0010: Unknown result type (might be due to invalid IL or missing references)
			//IL_000a: Unknown result type (might be due to invalid IL or missing references)
			Color result = default(Color);
			if (!ColorUtility.TryParseHtmlString(hex, ref result))
			{
				return Color.white;
			}
			return result;
		}

		private void Vendor(string[] lines)
		{
			_vendorLine = lines[Random.Range(0, lines.Length)];
			_vendorLineAt = Time.unscaledTime;
		}

		private void TickShop(PlayerAvatar local)
		{
			if (_cartQueue.Count > 0 && Time.unscaledTime >= _nextCartBuy)
			{
				_nextCartBuy = Time.unscaledTime + 0.6f;
				_cartQueue.Dequeue()();
			}
			float num = Mathf.Clamp(_stats.Custom("shop.medpatch"), 0f, 40f);
			if (num > 0f && Game.InLevel() && _medPatchLevel != (float)RunInfo.LevelIndex && (Object)(object)local.playerHealth != (Object)null && Game.IsAlive(local) && !Difficulty.IronBodies)
			{
				int num2 = Game.Health(local.playerHealth);
				int num3 = Mathf.Max(1, Game.MaxHealth(local.playerHealth));
				if ((float)num2 < (float)num3 * 0.3f)
				{
					_medPatchLevel = RunInfo.LevelIndex;
					Game.HealSelf(local.playerHealth, Mathf.RoundToInt(num));
					NoteHeal(Mathf.RoundToInt(num), HealKind.Instant, "Med Patch");
				}
			}
			if (!(Time.unscaledTime < _nextShopTick))
			{
				_nextShopTick = Time.unscaledTime + 1f;
				RunSave data = _store.Data;
				bool flag = Game.InShopLevel() && !Game.IsLoading();
				if (flag && !_shopRotatedScene && data.shopVisit != RunInfo.LevelIndex)
				{
					RotateStock();
				}
				else if (flag)
				{
					_shopRotatedScene = true;
				}
				else if (Plugin.Cfg.ShopAnywhere.Value && data.shopStock.Count == 0)
				{
					RotateStock();
				}
			}
		}

		private void RotateStock()
		{
			//IL_0174: Unknown result type (might be due to invalid IL or missing references)
			//IL_01b7: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			_shopRotatedScene = true;
			if (Account.Active("loyalty_card") && data.shopRep < ShopX.TierAt[1])
			{
				data.shopRep = ShopX.TierAt[1];
			}
			int shopTier = ShopTier;
			float luck = (float)Mathf.Max(0, RunInfo.LevelIndex) * 0.5f + Mathf.Max(0f, Difficulty.Payout() - 1f) * 10f + (float)shopTier * 3f + RunThreat.LuckBonus(RunThreat.Ahead) + RunShape.LuckBonus;
			Random rng = new Random();
			List<ShopEntry> shopStock = data.shopStock;
			data.shopStock = ShopX.Generate(rng, shopTier, luck, data.shopStock, (shopTier >= 1) ? data.wishlist : "", out var wished);
			ResearchRestockE(data, shopStock, rng, shopTier, luck);
			data.shopVisit = RunInfo.LevelIndex;
			data.buyback.Clear();
			data.consBought.Clear();
			data.consActive.Clear();
			data.attuneBoosted.Clear();
			_statsDirty = true;
			_store.MarkDirty();
			Vendor(ShopX.VendorBrowse);
			Notify(PopupKind.Other, "Rivet restocked the mod shop" + (data.shopStock.Exists((ShopEntry e) => e.featured && e.item != null && e.item.unique != "") ? " - a Unique is featured!" : ""), (Color?)new Color(1f, 0.74f, 0.22f), "restock");
			if (wished)
			{
				Notify(PopupKind.Loot, "Wishlist: " + ShopX.WishName(data.wishlist) + " is in the shop!", (Color?)new Color(1f, 0.85f, 0.35f), "");
			}
		}

		private void ShopOnLevelStart()
		{
			_shopRotatedScene = false;
			if (!Game.InShopLevel() && _store.Data.buyback.Count > 0)
			{
				_store.Data.buyback.Clear();
				_store.MarkDirty();
			}
		}

		private void AddReputation(int charged)
		{
			//IL_008d: Unknown result type (might be due to invalid IL or missing references)
			if (charged > 0)
			{
				RunSave data = _store.Data;
				int shopTier = ShopTier;
				data.shopRep += Mathf.RoundToInt((float)charged * Mathf.Clamp(Plugin.Cfg.ShopReputationSpeed.Value, 0f, 5f));
				Account.Count("shopspent", charged);
				int shopTier2 = ShopTier;
				if (shopTier2 > shopTier)
				{
					Notify(PopupKind.Other, "Shop reputation: " + ShopX.TierNames[shopTier2] + "! Unlocked " + ShopX.TierUnlocks[shopTier2], (Color?)new Color(1f, 0.85f, 0.35f), "");
				}
			}
		}

