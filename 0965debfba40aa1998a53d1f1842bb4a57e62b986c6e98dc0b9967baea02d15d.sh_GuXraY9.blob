		private static void OnLateJoinMsg(int sender, object data, bool master)
		{
			if (!(data is object[] array) || array.Length < 1)
			{
				return;
			}
			object obj = array[0];
			if (!(obj is byte))
			{
				return;
			}
			switch ((byte)obj)
			{
			case 1:
				if (IsFromHost(sender) && array.Length > 1 && array[1] is int num3)
				{
					RpgRuntime.Instance?.OnLateJoinWelcome(num3);
				}
				break;
			case 2:
				if (master)
				{
					LateJoinHost.OnModulesAsked(sender);
				}
				break;
			case 3:
				if (master)
				{
					LateJoinHost.OnJoinerReady(sender);
				}
				break;
			case 7:
			{
				if (!master)
				{
					break;
				}
				bool flag = default(bool);
				int num;
				if (array.Length > 1)
				{
					obj = array[1];
					if (obj is bool)
					{
						flag = (bool)obj;
						num = 1;
					}
					else
					{
						num = 0;
					}
				}
				else
				{
					num = 0;
				}
				LateJoinHost.OnSpawnAsked(sender, (byte)((uint)num & (flag ? 1u : 0u)) != 0);
				break;
			}
			case 4:
				if (IsFromHost(sender) && array.Length >= 5 && array[1] is int num4 && array[2] is float pickSeconds && array[3] is int num5 && array[4] is float shieldSeconds)
				{
					RpgRuntime.Instance?.OnLateJoinNote(num4, pickSeconds, Mathf.Clamp(num5, 0, 200), shieldSeconds);
				}
				break;
			case 5:
				if (IsFromHost(sender) && array.Length >= 3 && array[2] is int num2)
				{
					RpgRuntime.Instance?.OnLateJoinAnnounce(Cut(array[1], 40), num2);
				}
				break;
			case 6:
				if (IsFromHost(sender) && array.Length >= 3)
				{
					RpgRuntime.Instance?.OnLateJoinDestroyed((array[1] as int[]) ?? new int[0], (array[2] as int[]) ?? new int[0]);
				}
				break;
			}
		}

