		private static string PadButtons(string chord)
		{
			if (string.IsNullOrWhiteSpace(chord))
			{
				return "?";
			}
			string[] array = chord.Split('+');
			for (int i = 0; i < array.Length; i++)
			{
				string text = array[i].Trim().ToLowerInvariant();
				string[] array2 = array;
				int num = i;
				array2[num] = text switch
				{
					"select" => "VIEW", 
					"start" => "MENU", 
					"ls" => "L-STICK", 
					"rs" => "R-STICK", 
					"up" => "D-PAD UP", 
					"down" => "D-PAD DOWN", 
					"left" => "D-PAD LEFT", 
					"right" => "D-PAD RIGHT", 
					_ => text.ToUpperInvariant(), 
				};
			}
			return string.Join(" + ", array);
		}

