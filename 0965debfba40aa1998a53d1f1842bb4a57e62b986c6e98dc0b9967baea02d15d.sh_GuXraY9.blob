			{
				PoolItem poolItem = _scanPool[i];
				bool flag2 = (Object)(object)poolItem.Obj != (Object)null && ((Component)poolItem.Obj).gameObject.activeInHierarchy && num < _scanWant && !InCart(poolItem.Pgo, poolItem.Det);
