			string item = tuple.Item2;
			Color item2 = tuple.Item3;
			shopDetail.Name = name;
			shopDetail.NameColor = item2;
			shopDetail.Type = ((e.kind == "gear" && e.item != null) ? (Gear.SlotName(e.item.slot) + " · " + Cursed.RarityName(e.item)) : ((e.kind == "module") ? "Module" : "Consumable"));
			if (e.featured)
			{
				shopDetail.Status.Add((UiStatus.New, "Featured deal"));
			}
			if (e.sold)
			{
				shopDetail.Status.Add((UiStatus.Locked, "Sold"));
			}
			else if (e.locked)
			{
