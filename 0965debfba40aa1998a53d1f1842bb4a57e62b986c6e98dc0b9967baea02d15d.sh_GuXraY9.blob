					Plugin.Log.LogInfo((object)"[late join] PlayerSpawn skipped: everyone is already in.");
				}
			}
			else
			{
				Plugin.Log.LogInfo((object)$"[late join] PlayerSpawn only for the {list.Count - list2.Count} joiner(s); {list2.Count} already in stay put.");
				_held = new List<PlayerAvatar>(list);
				list.RemoveAll((PlayerAvatar a) => (Object)(object)a != (Object)null && Game.Get(a, "spawned", fallback: false));
			}
		}

		public static void AfterPlayerSpawn()
		{
			List<PlayerAvatar> held = _held;
			_held = null;
			if (held == null || held.Count == 0)
			{
				return;
			}
			GameDirector instance = GameDirector.instance;
			List<PlayerAvatar> list = (((Object)(object)instance != (Object)null) ? Game.Get<List<PlayerAvatar>>(instance, "PlayerList", null) : null);
			if (list == null)
			{
				return;
			}
