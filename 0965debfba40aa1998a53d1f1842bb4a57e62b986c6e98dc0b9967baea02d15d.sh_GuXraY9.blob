		private void OnDeathSaveUsed()
		{
			if (_stats.Custom("gear.save_armor") > 0f && _savesThisLevel < 3)
			{
				_savesThisLevel++;
				_statsDirty = true;
			}
		}

		private void OnTeammateDied()
		{
			if (Game.InLevel())
			{
				_debtDeaths = Mathf.Min(3, _debtDeaths + 1);
			}
		}

		private void OnEliteDiedNear()
		{
			if (_stats.Custom("gear.repo_luck") > 0f && _repoElites < 5)
			{
				_repoElites++;
				_statsDirty = true;
			}
		}

		private void ApplyDepthExtras()
		{
			if (Game.InLevel())
			{
				float staminaDrainPct = RunDepth.StaminaDrainPct;
				if (staminaDrainPct != 0f)
				{
					_stats.AddPerm(Stat.StaminaDrain, staminaDrainPct);
				}
				float num = _stats.Custom("gear.boss_hunter");
				if (num > 0f && _bossAlive)
				{
					_stats.AddPerm(Stat.WeaponDamage, num);
				}
				float num2 = _stats.Custom("gear.repo_luck");
				if (num2 > 0f && _repoElites > 0)
				{
					_stats.AddPerm(Stat.GearLuck, num2 * (float)Mathf.Min(5, _repoElites));
				}
				float num3 = _stats.Custom("gear.lone_speed");
				if (num3 > 0f && _alone)
				{
					_stats.AddPerm(Stat.MoveSpeed, num3);
					_stats.AddPerm(Stat.SprintSpeed, num3);
				}
				float num4 = _stats.Custom("gear.save_armor");
				if (num4 > 0f && _savesThisLevel > 0)
				{
					_stats.AddPerm(Stat.DamageTaken, (0f - num4) * (float)Mathf.Min(3, _savesThisLevel));
				}
				float num5 = _stats.Custom("gear.danger_scrap");
				if (num5 > 0f && RunDepth.HasMods)
				{
					_stats.AddPerm(Stat.ScrapBonus, num5);
				}
			}
		}

		private void TickDepth()
		{
			//IL_00f7: Unknown result type (might be due to invalid IL or missing references)
			//IL_0103: Unknown result type (might be due to invalid IL or missing references)
			//IL_0108: Unknown result type (might be due to invalid IL or missing references)
			//IL_010d: Unknown result type (might be due to invalid IL or missing references)
			if (Time.unscaledTime < _depthTickAt)
			{
				return;
			}
			_depthTickAt = Time.unscaledTime + 0.5f;
			AnnounceUnlocks();
			if (!Game.InLevel())
			{
				return;
			}
			bool flag = false;
			if (_stats.Custom("gear.boss_hunter") > 0f)
			{
				Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
				while (enumerator.MoveNext())
				{
					if (Elites.TryGet(enumerator.Current, out var info) && info.Tier >= 3)
					{
						flag = true;
						break;
					}
				}
			}
			bool flag2 = false;
			if (_stats.Custom("gear.lone_speed") > 0f)
			{
				PlayerAvatar val = Game.LocalPlayer();
				if ((Object)(object)val != (Object)null && Game.IsAlive(val))
				{
					flag2 = true;
					foreach (PlayerAvatar item in Game.Players())
					{
						if ((Object)(object)item != (Object)null && (Object)(object)item != (Object)(object)val && Game.IsAlive(item))
						{
							Vector3 val2 = ((Component)item).transform.position - ((Component)val).transform.position;
							if (((Vector3)(ref val2)).sqrMagnitude < 225f)
							{
								flag2 = false;
								break;
							}
						}
					}
				}
			}
			if (flag != _bossAlive || flag2 != _alone)
			{
				_bossAlive = flag;
				_alone = flag2;
				_statsDirty = true;
			}
		}

		private void AnnounceUnlocks()
		{
			//IL_00c4: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ef: Unknown result type (might be due to invalid IL or missing references)
			if (!RunDepth.Enabled || (!Game.InLobby() && !Game.InShopLevel()) || !RunReady)
			{
				return;
			}
			int levelIndex = RunInfo.LevelIndex;
			if (levelIndex == _announcedFor)
			{
				return;
			}
			_announcedFor = levelIndex;
			List<DepthUnlockDef> list = RunDepth.OpeningAt(levelIndex);
			if (list.Count == 0)
			{
				return;
			}
			List<string> list2 = new List<string>();
			foreach (DepthUnlockDef item in list)
			{
				list2.Add(item.name);
			}
			string text = "New deeper in the run: " + string.Join(" · ", list2);
			Banner("NEW: " + string.Join(" · ", list2).ToUpperInvariant(), new Color(1f, 0.82f, 0.35f));
			Notify(PopupKind.Other, text + " (the Guide has the details)", (Color?)new Color(1f, 0.82f, 0.35f), "unlocks");
			MenuSound(UiSound.Confirm);
			Plugin.Log.LogInfo((object)string.Format("[depth] unlocked at {0} levels cleared: {1}.", levelIndex, string.Join(", ", list2)));
		}

		public string DepthHudLine()
		{
			int num = RunInfo.LevelIndex * 2 + (Game.InLevel() ? 1 : 0);
			if (num == _depthHudFor)
			{
				return _depthHud;
			}
			_depthHudFor = num;
			_depthHud = "";
			if (!RunDepth.HasMods || (!Game.InLevel() && !Game.InLobby() && !Game.InShopLevel()))
			{
				return _depthHud;
			}
			List<string> list = new List<string>();
			foreach (MapModifierDef levelMod in RunDepth.LevelMods)
			{
				list.Add(levelMod.name);
			}
			_depthHud = (Game.InLevel() ? "MAP MODIFIER: " : "NEXT LEVEL: ") + string.Join(" + ", list);
			return _depthHud;
		}

		private bool MilestoneSwitch(ClassDef target, out int toLevel, out int milestone)
		{
			toLevel = 0;
			milestone = 0;
			if (RepickSwitch(target, out toLevel))
			{
				milestone = -1;
				return true;
			}
			if (!Plugin.Cfg.SwitchAtMilestones.Value || Current == null || CurrentProgress == null || target == Current)
			{
				return false;
			}
			if (!Game.InShopLevel() || RunInfo.LevelIndex <= 0 || !RunShape.IsMilestoneLevel(RunInfo.LevelIndex - 1))
			{
				return false;
			}
			milestone = RunInfo.LevelIndex / RunShape.Every;
			if (_store.Data.switchMilestone >= milestone)
			{
				return false;
			}
			ClassProgress classProgress = _store.Data.classes.Find((ClassProgress x) => x.classId == target.id);
			int num = Mathf.Min(Leveling.MaxLevel, Mathf.Max(1, Mathf.RoundToInt((float)CurrentProgress.level * Mathf.Clamp(Plugin.Cfg.SwitchShare.Value, 0f, 100f) / 100f)));
			if (classProgress != null && classProgress.level >= num)
			{
				return false;
			}
			toLevel = num;
			return true;
		}

		private string MilestoneSwitchText(ClassDef target)
		{
			if (!MilestoneSwitch(target, out var toLevel, out var milestone) || Current == null || CurrentProgress == null)
			{
				return "";
			}
			if (milestone < 0)
			{
				return $"\n\n<color=#ffd75a><b>FREE RE-PICK</b></color>: your class was replaced in this version, so {target.name} starts at <b>Lv {toLevel}</b>. " + $"You get its skill points to spend in its trees. Your {Current.name} stays at Lv {CurrentProgress.level} on the bench. Once only.";
			}
			int num = Leveling.EarnedAttributePoints(null, _store.Data);
			return $"\n\n<color=#ffd75a><b>MILESTONE {milestone} SWITCH</b></color>: {target.name} starts at <b>Lv {toLevel}</b> " + $"({Plugin.Cfg.SwitchShare.Value:0}% of your {Current.name} Lv {CurrentProgress.level}). You get its skill points to spend in the new trees, " + $"and your attribute points are refunded ({num} to spend). Your {Current.name} stays at Lv {CurrentProgress.level} on the bench. " + "XP toward the next level isn't carried over. Once per milestone.";
		}

		private void ApplyMilestoneSwitch(int toLevel, int milestone, string fromName)
		{
			if (Current == null || CurrentProgress == null || toLevel <= CurrentProgress.level)
			{
				return;
			}
			if (milestone < 0)
			{
				ApplyRepick(toLevel, fromName);
				return;
			}
			_store.Data.switchMilestone = milestone;
			int num = 0;
			for (int i = CurrentProgress.level; i < toLevel; i++)
			{
				num += Leveling.XpToNext(i);
			}
			CurrentProgress.xp = 0;
			Leveling.AddXp(CurrentProgress, num);
			_store.Data.attributes.Clear();
			_statsDirty = true;
			CheckPerkMilestones();
			Notify(PopupKind.Level, $"Milestone switch: {Current.name} starts at Lv {CurrentProgress.level} - {Leveling.AvailablePoints(CurrentProgress)} skill points and your attribute points to spend ({MenuPrompt}). Your {fromName} is on the bench.", null, "level");
			Plugin.Log.LogInfo((object)$"[class] milestone {milestone} switch: {fromName} -> {Current.id} at level {CurrentProgress.level}.");
			_store.SaveNow();
		}

		private void ApplyRepick(int toLevel, string fromName)
		{
			if (Current != null && CurrentProgress != null)
			{
				_store.Data.repickLevel = 0;
				_store.Data.repickSeen = false;
				int num = 0;
				for (int i = CurrentProgress.level; i < toLevel; i++)
				{
					num += Leveling.XpToNext(i);
				}
				CurrentProgress.xp = 0;
				Leveling.AddXp(CurrentProgress, num);
				_statsDirty = true;
				CheckPerkMilestones();
				Notify(PopupKind.Level, $"Free re-pick: {Current.name} starts at Lv {CurrentProgress.level} - {Leveling.AvailablePoints(CurrentProgress)} skill points to spend ({MenuPrompt}). Your {fromName} is on the bench.", null, "level");
				Plugin.Log.LogInfo((object)$"[migrate] free re-pick: {fromName} -> {Current.id} at level {CurrentProgress.level}.");
				_store.SaveNow();
			}
		}

		private string DepthGuideText()
		{
			StringBuilder stringBuilder = new StringBuilder();
			if (!RunDepth.Enabled)
			{
				return "<color=#9a9ca0>Deep-run content is off in this lobby (Unlocks/Enabled).</color>";
			}
			DepthUnlockDef[] unlocks = RunDepth.Data.unlocks;
			foreach (DepthUnlockDef depthUnlockDef in unlocks)
			{
				if (depthUnlockDef != null)
				{
					int num = RunDepth.LevelOf(depthUnlockDef.id);
					bool flag = RunDepth.Unlocked(depthUnlockDef.id);
					stringBuilder.Append(flag ? $"<color=#8cf2bf><b>{depthUnlockDef.name}</b></color>  <color=#9a9ca0>(level {num}, unlocked)</color>\n{depthUnlockDef.hint}\n" : $"<color=#ffd75a><b>{depthUnlockDef.name}</b></color>  <color=#9a9ca0>Unlocks at level {num}</color>\n");
				}
			}
			if (RunDepth.Data.modifiers.Length != 0)
			{
				stringBuilder.Append("\n<b>MAP MODIFIERS</b>\n");
				MapModifierDef[] modifiers = RunDepth.Data.modifiers;
				foreach (MapModifierDef mapModifierDef in modifiers)
				{
					stringBuilder.Append(RunDepth.Unlocked(mapModifierDef.unlock) ? ("<b>" + mapModifierDef.name + "</b>: " + mapModifierDef.risk + "; " + mapModifierDef.reward + "\n") : $"<color=#9a9ca0>{mapModifierDef.name}: unlocks at level {RunDepth.LevelOf(mapModifierDef.unlock)}</color>\n");
				}
			}
			return stringBuilder.ToString();
		}

		public void OnRunShape(RunShape.State old, RunShape.State s)
		{
			//IL_018d: Unknown result type (might be due to invalid IL or missing references)
			_rsHudFor = -1;
			_rsBannerFor = -1;
			_boonsTextFor = null;
			NoteRunShapeResults(old, s);
			if (s.CrewXp != old.CrewXp || s.Boons.Length != old.Boons.Length)
			{
				_statsDirty = true;
			}
			string[] boons = s.Boons;
			for (int i = 0; i < boons.Length; i++)
			{
				Account.SeeBoon(boons[i]);
			}
			if (s.Note != "" && s.Seq != _rsNoteSeq)
			{
				_rsNoteSeq = s.Seq;
				boons = s.Note.Split('\n');
				foreach (string text in boons)
				{
					if (text != "")
					{
						ShowRunNote(text);
					}
				}
			}
			Notices.Poke();
			if (s.RouteFor >= 0 && s.RouteChosen < 0 && (s.RouteFor != old.RouteFor || old.RouteChosen >= 0) && s.RouteOptions.Length > 1)
			{
				RunShape.MyRouteVote = -1;
			}
			if (s.HeatFor != 0 && s.HeatFor != old.HeatFor && s.HeatOffer.Length > 1)
			{
				RunShape.MyHeatVote = -1;
			}
			if (Heat.On && old.Seq > 0 && s.Milestones > old.Milestones && old.Heat > 0)
			{
				if (Account.Record("heat", old.Heat))
				{
					Notify(PopupKind.Other, $"New record: a chapter cleared at heat {old.Heat}", (Color?)new Color(1f, 0.85f, 0.35f), "heat-record");
				}
				Account.Record("heat." + DifficultyName(DifficultyPresets.Label), old.Heat);
			}
			if (s.Complete && !old.Complete && old.Seq > 0)
			{
				((MonoBehaviour)this).StartCoroutine(LeaveAfterEnd());
			}
		}

		private IEnumerator LeaveAfterEnd()
		{
			yield return (object)new WaitForSecondsRealtime(15f);
			if (!RunShape.Cur.Complete || Game.InLevel() || (Object)(object)RunManager.instance == (Object)null)
			{
				yield break;
			}
			Plugin.Log.LogInfo((object)"[season] run complete: back to the main menu.");
			try
			{
				((MonoBehaviour)RunManager.instance).StartCoroutine(RunManager.instance.LeaveToMainMenu());
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[season] couldn't go back to the main menu (" + ex.GetBaseException().Message + ") - leave from the game's menu."));
			}
		}

		private void ShowRunNote(string note)
		{
			//IL_0418: Unknown result type (might be due to invalid IL or missing references)
			//IL_03a0: Unknown result type (might be due to invalid IL or missing references)
			//IL_02ae: Unknown result type (might be due to invalid IL or missing references)
			//IL_02cf: Unknown result type (might be due to invalid IL or missing references)
			//IL_01de: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ff: Unknown result type (might be due to invalid IL or missing references)
			//IL_0352: Unknown result type (might be due to invalid IL or missing references)
			//IL_0373: Unknown result type (might be due to invalid IL or missing references)
			//IL_0300: Unknown result type (might be due to invalid IL or missing references)
			//IL_0321: Unknown result type (might be due to invalid IL or missing references)
			//IL_0282: Unknown result type (might be due to invalid IL or missing references)
			//IL_0180: Unknown result type (might be due to invalid IL or missing references)
			//IL_0230: Unknown result type (might be due to invalid IL or missing references)
			//IL_0251: Unknown result type (might be due to invalid IL or missing references)
			//IL_01ad: Unknown result type (might be due to invalid IL or missing references)
			int num = note.IndexOf('|');
			string text = ((num > 0) ? note.Substring(0, num) : "");
			string text2 = ((num > 0) ? note.Substring(num + 1) : note);
			switch (text)
			{
			case "streak+":
				Notify(PopupKind.Other, text2, (Color?)new Color(1f, 0.72f, 0.2f), "streak");
				MenuSound(UiSound.Confirm);
				break;
			case "streak-":
				Notify(PopupKind.Other, text2, (Color?)new Color(1f, 0.45f, 0.38f), "streak");
				MenuSound(UiSound.Back);
				break;
			case "milestone":
				Banner(text2.ToUpperInvariant(), new Color(1f, 0.85f, 0.35f));
				Notify(PopupKind.Other, text2, (Color?)new Color(1f, 0.85f, 0.35f), "");
				MenuSound(UiSound.Confirm);
				break;
			case "victory":
				Banner(text2.ToUpperInvariant(), new Color(1f, 0.85f, 0.35f), 10f);
				Notify(PopupKind.Other, text2, (Color?)new Color(1f, 0.85f, 0.35f), "victory");
				MenuSound(UiSound.Confirm);
				break;
			case "finale2":
				Banner(text2.ToUpperInvariant(), new Color(1f, 0.4f, 0.3f));
				MenuSound(UiSound.Error);
				break;
			case "season":
				Banner(text2.ToUpperInvariant(), new Color(0.6f, 0.9f, 1f), 8f);
				Notify(PopupKind.Other, text2, (Color?)new Color(0.6f, 0.9f, 1f), "season");
				MenuSound(UiSound.Confirm);
				break;
			case "heat":
				Banner(text2.ToUpperInvariant(), new Color(1f, 0.55f, 0.3f), 5f);
				Notify(PopupKind.Other, text2, (Color?)new Color(1f, 0.55f, 0.3f), "heat");
				MenuSound(UiSound.Confirm);
				break;
			case "crew":
				Banner(text2.ToUpperInvariant(), new Color(0.55f, 0.85f, 1f), 4f);
				Notify(PopupKind.Other, text2, (Color?)new Color(0.55f, 0.85f, 1f), "crew");
				MenuSound(UiSound.Confirm);
				break;
			case "sweep":
				Notify(PopupKind.Other, text2, (Color?)new Color(0.35f, 0.82f, 1f), "sweep");
				if (CurrentProgress != null && CurrentProgress.level < Leveling.MaxLevel)
				{
					GiveXp(Mathf.Max(1, Mathf.RoundToInt((float)Leveling.XpToNext(CurrentProgress.level) * 0.1f)), null, "Full Sweep");
				}
				break;
			default:
				Notify(PopupKind.Other, text2, (Color?)new Color(0.6f, 0.9f, 1f), "");
				break;
			}
		}

		private void ApplyRunExtras()
		{
			ApplyDepthExtras();
			if (RunShape.CrewHealthPct > 0f)
			{
				_stats.AddPerm(Stat.MaxHealth, RunShape.CrewHealthPct);
			}
			if (_loneWolf)
			{
				_stats.AddPerm(Stat.DamageTaken, -30f);
				_stats.AddPerm(Stat.MoveSpeed, 15f);
				_stats.AddPerm(Stat.SprintSpeed, 15f);
			}
		}

		private void TickRunShape()
		{
			//IL_0100: Unknown result type (might be due to invalid IL or missing references)
			TickNotices();
			TickRunSummary();
			TickDepth();
			TickMigration();
			if (Time.unscaledTime < _runTickAt)
			{
				return;
			}
			_runTickAt = Time.unscaledTime + 0.5f;
			_ = BehindXpMult;
			bool flag = false;
			if (RunShape.Has("lone_wolf") && Game.InLevel() && Game.IsMultiplayer())
			{
				PlayerAvatar val = Game.LocalPlayer();
				List<PlayerAvatar> list = Game.Players();
				if ((Object)(object)val != (Object)null && Game.IsAlive(val) && list.Count >= 2)
				{
					flag = true;
					foreach (PlayerAvatar item in list)
					{
						if ((Object)(object)item != (Object)null && (Object)(object)item != (Object)(object)val && Game.IsAlive(item))
						{
							flag = false;
							break;
						}
					}
				}
			}
			if (flag != _loneWolf)
			{
				_loneWolf = flag;
				_statsDirty = true;
				if (flag)
				{
					Toast("Lone Wolf: last one standing - 30% less damage, 15% faster", new Color(0.82f, 0.82f, 0.82f), 4f);
				}
			}
		}

		public void OnMilestoneTaken(int milestone, int choice, bool ok, int paid)
		{
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			//IL_0048: Unknown result type (might be due to invalid IL or missing references)
			_rsAsked.Remove(milestone);
			if (!ok)
			{
				Toast("That milestone reward was already taken", Bad);
				return;
			}
			if (choice == 1)
			{
				Notify(PopupKind.Other, $"Milestone {milestone}: +{paid} {Scrap.Short}", Scrap.Color);
				MenuSound(UiSound.Confirm);
				return;
			}
			HashSet<string> hashSet = new HashSet<string>();
			foreach (GearItem item in _store.Data.inventory)
			{
				if (!string.IsNullOrEmpty(item.unique))
				{
					hashSet.Add(item.unique);
				}
			}
			GearItem gearItem = Gear.RollUnique(new Random(), hashSet);
			gearItem.freeValue = SalvageCalc.Gross(gearItem);
			GiveGear(gearItem, $"milestone {milestone}");
			MenuSound(UiSound.Confirm);
		}

