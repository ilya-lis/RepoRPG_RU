								_pingedAt[EnemyKey((Component)(object)current)] = now;
								TeamPlay.HostAdd(sensor.Owner, TeamPlay.Ev.Spotted, 1f);
								ContractHost.ClsEv(sensor.Owner, "lookout");
							}
							break;
						}
					}
				}
			}
		}

