		private static int GroupOf(string tab)
		{
			for (int i = 0; i < NavGroups.Length; i++)
			{
				if (Array.IndexOf(NavGroups[i].subs, tab) >= 0)
				{
					return i;
				}
			}
			return NavGroups.Length - 1;
		}

		private static string TabPath(string tab)
		{
			if (!(tab == ""))
			{
				return NavGroups[GroupOf(tab)].name + " › " + tab;
			}
			return "";
		}

