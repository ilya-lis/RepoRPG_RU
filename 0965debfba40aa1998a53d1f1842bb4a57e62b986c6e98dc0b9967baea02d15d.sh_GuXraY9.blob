			{
				PhotonView val2 = PhotonView.Find(array[i]);
				if ((Object)(object)val2 != (Object)null)
				{
					Object.Destroy((Object)(object)((Component)val2).gameObject);
					num++;
				}
			}
			if (num > 0)
			{
				Plugin.Log.LogInfo((object)$"[late join] removed {num} objects destroyed before we joined.");
