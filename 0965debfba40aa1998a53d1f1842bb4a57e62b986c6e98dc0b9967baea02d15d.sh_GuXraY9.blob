			foreach (Roster.Row row in Roster.Rows)
			{
				bool flag = row.Actor == localActor || !Game.IsMultiplayer();
				RosterLine rosterLine = new RosterLine
				{
					Name = row.Name + (flag ? "  (you)" : ""),
					Self = flag,
					Host = row.Host,
					Picked = (row.Class != ""),
					Choosing = row.Choosing
				};
				if (rosterLine.Picked)
				{
					num++;
					if (!list.Contains(row.Class))
					{
						list.Add(row.Class);
					}
					rosterLine.Icon = ClassReadable(row.Class);
					rosterLine.Right = ClassName(row.Class) + ((row.Level > 0) ? $"  Lv {row.Level}" : "");
					rosterLine.RightCol = rosterLine.Icon;
				}
				else if (row.Choosing)
				{
					rosterLine.Right = "Choosing...";
					rosterLine.RightCol = Accent;
					rosterLine.Icon = Accent;
				}
				else
				{
					rosterLine.Right = "No class yet";
