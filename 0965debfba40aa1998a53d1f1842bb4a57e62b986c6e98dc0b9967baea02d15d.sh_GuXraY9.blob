		private void ResearchLevelStartClientE()
		{
			_resETracer.Clear();
			_resEHeld = null;
			_resESpotText = "";
		}

		public void OnTracerE(int viewId, float seconds)
		{
			if (viewId == 0)
			{
				return;
			}
			float time = Time.time;
			if (_resETracer.Count > 32)
			{
				List<int> list = new List<int>();
				foreach (KeyValuePair<int, float> item in _resETracer)
				{
					if (item.Value < time)
					{
						list.Add(item.Key);
					}
				}
				foreach (int item2 in list)
				{
					_resETracer.Remove(item2);
				}
			}
			_resETracer[viewId] = time + Mathf.Clamp(seconds, 0.5f, 6f);
		}

		private void ResearchRestockE(RunSave run, List<ShopEntry> prev, Random rng, int tier, float luck)
		{
			//IL_0175: Unknown result type (might be due to invalid IL or missing references)
			//IL_02a4: Unknown result type (might be due to invalid IL or missing references)
			//IL_03eb: Unknown result type (might be due to invalid IL or missing references)
			if (!Research.On)
			{
				return;
			}
			ResearchEconSave researchEconSave = Econ(run);
			foreach (GearItem item in run.inventory)
			{
				NoteUniqueFoundE(item);
			}
			if (Research.Has("price_board"))
			{
				if (researchEconSave.nextFeatured != null)
				{
					GearItem nextFeatured = researchEconSave.nextFeatured;
					ResolveE(nextFeatured);
					nextFeatured.freeValue = 0;
					string key = ShopX.StockKey(nextFeatured, researchEconSave.nextDiscount);
					ShopEntry shopEntry = new ShopEntry
					{
						kind = "gear",
						item = nextFeatured,
						key = key,
						price = ShopX.BasePrice(key),
						featured = true
					};
					int num = run.shopStock.FindIndex((ShopEntry e) => e.featured && !prev.Contains(e));
					if (num >= 0)
					{
						run.shopStock[num] = shopEntry;
					}
					else
					{
						run.shopStock.Insert(0, shopEntry);
					}
				}
				researchEconSave.nextFeatured = RollFeaturedE(rng, tier, luck, out var discount);
				researchEconSave.nextDiscount = discount;
				Notify(PopupKind.Other, "Price Board: next visit's featured deal is " + researchEconSave.nextFeatured.name + " (" + Cursed.RarityName(researchEconSave.nextFeatured) + ")", (Color?)new Color(1f, 0.85f, 0.35f), "priceboard");
			}
			if (Research.Has("blueprints"))
			{
				AccountFile data = Account.Data;
				List<string> list = data.uniquesFound ?? (data.uniquesFound = new List<string>());
				if (list.Count > 0)
				{
					GearItem gearItem = ShopX.MakeUnique(rng, list[rng.Next(list.Count)]);
					if (gearItem != null)
					{
						gearItem.freeValue = 0;
						string key2 = ShopX.StockKey(gearItem, discount: false);
						int num2 = run.shopStock.FindLastIndex((ShopEntry e) => e.kind == "gear" && e.section == "") + 1;
						run.shopStock.Insert(Mathf.Clamp(num2, 0, run.shopStock.Count), new ShopEntry
						{
							kind = "gear",
							item = gearItem,
							key = key2,
							price = ShopX.BasePrice(key2)
						});
						Notify(PopupKind.Loot, "Blueprint Archive: " + gearItem.name + " is in the Gear section", (Color?)new Color(1f, 0.85f, 0.35f), "");
					}
				}
			}
			if (Research.Has("prototype_lab") && !researchEconSave.protoBought && !run.shopStock.Exists((ShopEntry e) => !e.sold && ResearchEcon.IsProto(e.item)))
			{
				if (researchEconSave.proto == null)
				{
					researchEconSave.proto = MakePrototypeE(rng);
				}
				if (researchEconSave.proto != null)
				{
					GearItem gearItem2 = CopyE(researchEconSave.proto);
					ResolveE(gearItem2);
					gearItem2.freeValue = 0;
					string key3 = ShopX.StockKey(gearItem2, discount: false);
					int num3 = run.shopStock.FindLastIndex((ShopEntry e) => e.kind == "gear" && e.section == "") + 1;
					run.shopStock.Insert(Mathf.Clamp(num3, 0, run.shopStock.Count), new ShopEntry
					{
						kind = "gear",
						item = gearItem2,
						key = key3,
						price = ShopX.BasePrice(key3)
					});
					Notify(PopupKind.Loot, "Prototype Lab: " + gearItem2.name + " is in the Gear section", (Color?)new Color(0.6f, 0.9f, 1f), "");
				}
			}
			_store.MarkDirty();
		}

		private static GearItem RollFeaturedE(Random rng, int tier, float luck, out bool discount)
		{
			discount = false;
			float num = ((tier >= 4) ? 0.15f : 0.05f);
			if (rng.NextDouble() < (double)num)
			{
				return Gear.RollExact(rng, Gear.MaxRarity, null);
			}
			int num2 = Gear.RollRarity(rng, luck, (tier < 3) ? 1 : 3);
			if (rng.NextDouble() < 0.5)
			{
				num2 = Mathf.Min(num2 + 1, Gear.MaxRarity);
			}
			else
			{
				discount = true;
			}
			return Gear.RollExact(rng, num2, null, allowUnique: false);
		}

		private static GearItem? MakePrototypeE(Random rng)
		{
			List<GearBehaviorDef> list = new List<GearBehaviorDef>();
			GearBehaviorDef[] behaviors = GearX.Pack.behaviors;
			foreach (GearBehaviorDef gearBehaviorDef in behaviors)
			{
				if (gearBehaviorDef != null && gearBehaviorDef.id.StartsWith("proto_", StringComparison.Ordinal))
				{
					list.Add(gearBehaviorDef);
				}
			}
			if (list.Count == 0)
			{
				return null;
			}
			GearBehaviorDef gearBehaviorDef2 = list[rng.Next(list.Count)];
			string text = ResearchEcon.ProtoSlot(gearBehaviorDef2.id);
			if (Plugin.Rpg.SlotIndex(text) < 0)
			{
				return null;
			}
			GearItem gearItem = Gear.RollExact(rng, Mathf.Min(3, Gear.MaxRarity), text, allowUnique: false);
			List<EffectDef> list2 = new List<EffectDef>(gearItem.effects);
			GearBehaviorDef gearBehaviorDef3 = GearX.Behavior(gearItem.behavior);
			if (gearBehaviorDef3 != null && list2.Count >= gearBehaviorDef3.effects.Length)
			{
				list2.RemoveRange(list2.Count - gearBehaviorDef3.effects.Length, gearBehaviorDef3.effects.Length);
			}
			EffectDef[] effects = gearBehaviorDef2.effects;
			foreach (EffectDef effectDef in effects)
			{
				list2.Add(new EffectDef
				{
					stat = effectDef.stat,
					value = effectDef.value
				});
			}
			gearItem.effects = list2.ToArray();
			gearItem.behavior = gearBehaviorDef2.id;
			gearItem.name = "Prototype " + gearBehaviorDef2.name + " " + Gear.SlotName(text);
			if (gearItem.sockets == 0)
			{
				gearItem.sockets = 1;
				gearItem.modules = new string[1] { "" };
			}
			ClassDatabase.ResolveAll("gear " + gearItem.name, gearItem.effects);
			return gearItem;
		}

		private void NoteUniqueFoundE(GearItem g)
		{
			if (string.IsNullOrEmpty(g.unique) || Cursed.Is(g))
			{
				return;
			}
			AccountFile data = Account.Data;
			List<string> list = data.uniquesFound ?? (data.uniquesFound = new List<string>());
			if (!list.Contains(g.unique))
			{
				list.Add(g.unique);
				if (list.Count > 300)
				{
					list.RemoveAt(0);
				}
				Account.MarkDirty();
			}
		}

		private void UseFreeLockE()
		{
			Econ(_store.Data).freeLockVisit = _store.Data.shopVisit;
			_store.MarkDirty();
		}

		private bool ShopResearchAnyE()
		{
			if (Research.On)
			{
				if (!Research.Has("price_board") && !Research.Lobby("pawn_counter") && !Research.Lobby("futures") && !Research.Has("gun_bench") && !Research.Has("fusion_forge") && !Research.Has("blueprints"))
				{
					return Research.Has("prototype_lab");
				}
				return true;
			}
			return false;
		}

