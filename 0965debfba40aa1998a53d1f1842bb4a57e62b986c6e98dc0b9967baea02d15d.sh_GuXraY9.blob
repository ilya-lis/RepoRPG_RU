	public class AttrBonusFile
	{
		public int version;

		public AttrMilestone[] milestones = Array.Empty<AttrMilestone>();

		public AttrPairing[] pairings = Array.Empty<AttrPairing>();

		public AttrAffinity[] affinity = Array.Empty<AttrAffinity>();
