		}

		private static bool LowerIsBetter(Stat s)
		{
			if (s != Stat.DamageTaken && s != Stat.StaminaDrain)
			{
				return s == Stat.HoldingStaminaDrain;
			}
			return true;
		}

		private static (string value, string name) SplitStat(Stat s, float v)
		{
			string text = StatInfo.Describe(s, v);
			int num = text.IndexOf(' ');
			if (num >= 0)
			{
				return (value: text.Substring(0, num), name: text.Substring(num + 1));
			}
			return (value: text, name: "");
		}

