			if (text4 != "")
			{
				lines.Insert(((text != "") ? 1 : 0) + ((text2 != "") ? 1 : 0) + ((text3 != "") ? 1 : 0), (text4, new Color(1f, 0.6f, 0.25f)));
			}
			ItemUpgrade val2 = Game.HeldComponent<ItemUpgrade>();
			if ((Object)(object)val2 == (Object)null)
			{
				_heldUpgradeId = int.MinValue;
			}
			else
			{
				int num2 = Elites.ViewId((Component)(object)val2);
				if (num2 != _heldUpgradeId || Time.unscaledTime >= _heldUpgradeRefresh)
				{
					_heldUpgradeId = num2;
					_heldUpgradeRefresh = Time.unscaledTime + 0.5f;
					_heldUpgradeLines.Clear();
					string text5 = Upgrades.GuessKey((Component)(object)val2);
					int num3 = (Plugin.Cfg.UpgradeRarity.Value ? Upgrades.Rarity(num2) : 0);
					RarityDef rarityDef = Gear.Rarity(num3);
					bool flag = Current != null && text5 != "" && Current.HasAffinity(text5);
					Color white = default(Color);
					if (!ColorUtility.TryParseHtmlString(rarityDef.color, ref white))
					{
						white = Color.white;
					}
					_heldUpgradeLines.Add((rarityDef.name + " " + ((text5 == "") ? "" : (Upgrades.Name(text5) + " ")) + "upgrade" + (flag ? "  * class affinity" : ""), white));
					foreach (string item2 in Upgrades.DescribeReward(text5, num3, Current))
					{
						_heldUpgradeLines.Add(("  " + item2, new Color(0.9f, 0.9f, 0.9f)));
					}
				}
				lines.AddRange(_heldUpgradeLines);
			}
			ValuableObject val3 = Game.HeldValuable();
			if ((Object)(object)val3 != (Object)null && Plugin.Cfg.ValuableRarity.Value)
			{
				RarityDef rarityDef2 = Gear.Rarity(Gear.ValuableRarity(Elites.ViewId((Component)(object)val3)));
				Color item = default(Color);
				if (ColorUtility.TryParseHtmlString(rarityDef2.color, ref item))
				{
					lines.Add((string.Format("Holding: {0} valuable  ${1:N0}", rarityDef2.name, Game.Get(val3, "dollarValueCurrent", 0f)), item));
				}
			}
			for (int i = 0; i < lines.Count; i++)
			{
				lines[i] = (lines[i].Item1.ToUpperInvariant(), lines[i].Item2);
			}
		}

