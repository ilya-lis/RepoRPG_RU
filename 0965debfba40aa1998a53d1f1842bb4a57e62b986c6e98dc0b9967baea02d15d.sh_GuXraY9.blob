		public static void EnsureVision(EnemyVision vision, int viewId)
		{
			int instanceID = ((Object)vision).GetInstanceID();
			if (!_visionChecked.TryGetValue(instanceID, out HashSet<int> value))
			{
				value = (_visionChecked[instanceID] = new HashSet<int>());
			}
			if (!value.Add(viewId))
			{
				return;
			}
			try
			{
				bool flag = false;
				string[] array = new string[2] { "VisionsTriggered", "VisionTriggered" };
				foreach (string name in array)
				{
					if (Game.Get<object>(vision, name, null) is IDictionary dictionary && !dictionary.Contains(viewId))
					{
