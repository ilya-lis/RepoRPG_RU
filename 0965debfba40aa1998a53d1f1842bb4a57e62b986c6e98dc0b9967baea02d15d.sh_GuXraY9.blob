		private void ReleaseBrakes(Pilot pl)
		{
			if (pl.BrakesOff)
			{
				return;
			}
			pl.BrakesOff = true;
			PhysicsMaterial val = Game.Get<PhysicsMaterial>(pl.Cart, "physMaterialSlippery", null);
			List<Collider> list = Game.Get<List<Collider>>(pl.Cart, "capsuleColliders", null);
			if (!((Object)(object)val != (Object)null) || list == null)
			{
				return;
			}
			foreach (Collider item in list)
			{
				if ((Object)(object)item != (Object)null)
				{
					item.material = val;
				}
			}
		}

