			}
			_fights.Add(fight);
			Net.SendFx(Fx.Fight, ((Component)target).transform.position, 1.6f, seconds);
			Net.SendFx(Fx.FightLink, ((Component)attacker).transform.position, 0f, seconds);
			if (owner > 0)
			{
				ContractHost.ClsEv(owner, "instigator");
			}
			DiagLog(string.Format("host: fight {0}{1} -> {2} for {3:0.#}s", badBlood ? "(Bad Blood) " : "", EnemyName((Component)(object)attacker), EnemyName((Component)(object)target), seconds));
		}

