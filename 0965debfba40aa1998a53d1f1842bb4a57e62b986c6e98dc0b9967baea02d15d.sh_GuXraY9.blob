		private DetailInfo SettingsDetail()
		{
			DetailInfo setDetail = _setDetail;
			if (_setPickLabel == "")
			{
				if (setDetail.Name != "" || setDetail.EmptyTitle == "")
				{
					setDetail.Begin("");
					setDetail.EmptyTitle = "Select a setting";
					setDetail.EmptyText = "What it does, its default and what you changed show here.";
				}
				return setDetail;
			}
			ConfigEntryBase setPickEntry = _setPickEntry;
			object obj = ((setPickEntry != null) ? setPickEntry.BoxedValue : null);
			object obj2 = ((setPickEntry != null) ? SettingsSync.OriginalOf(setPickEntry) : null);
			bool flag = setPickEntry != null && obj2 != null && !object.Equals(obj2, obj);
			HashCode hashCode = default(HashCode);
			hashCode.Add(_setPickLabel);
			hashCode.Add(_setPickCat);
			hashCode.Add(_setPickExtra);
			hashCode.Add(FmtSetting(obj));
			hashCode.Add(flag);
			hashCode.Add(SettingsSync.History.Count);
			hashCode.Add(_layoutVersion);
			int num = hashCode.ToHashCode();
			if (num == _setDetailSig && setDetail.Name != "")
			{
				return setDetail;
			}
			_setDetailSig = num;
			setDetail.Begin(num.ToString());
			bool flag2 = setPickEntry != null && SettingsSync.IsSynced(setPickEntry.Definition);
			setDetail.Type = "Setting · " + _setPickCat + " · " + (flag2 ? "host setting" : "your game only");
			setDetail.Name = _setPickLabel;
			if (flag)
			{
				setDetail.Status.Add((UiStatus.Pending, "Changed, not saved"));
			}
			object obj3;
			if (setPickEntry == null)
			{
				obj3 = null;
			}
			else
			{
				ConfigDescription description = setPickEntry.Description;
				obj3 = ((description != null) ? description.Description : null);
			}
			if (obj3 == null)
			{
				obj3 = "";
			}
			string text = (string)obj3;
			setDetail.Now = ((text != "") ? text : (_setPickLabel + ".")) + ((_setPickExtra != "") ? ("\n" + _setPickExtra) : "") + ((setPickEntry != null) ? ("\n<color=#9a9ca0>Now: " + FmtSetting(obj) + "</color>") : "");
			if (flag)
			{
				setDetail.Next.Add((_setPickLabel, FmtSetting(obj2), FmtSetting(obj), true));
			}
			if (setPickEntry != null)
			{
				setDetail.Needs = "Default: " + FmtSetting(setPickEntry.DefaultValue) + ". Saved in the config file under [" + setPickEntry.Definition.Section + "] " + setPickEntry.Definition.Key + ".";
			}
			if (setPickEntry != null && !flag2)
			{
				ConfigEntryBase entry = setPickEntry;
				setDetail.Act("Default", BtnKind.Secondary, !object.Equals(setPickEntry.DefaultValue, obj), delegate
				{
					SettingsSync.SaveLocalChange(delegate
					{
						entry.BoxedValue = entry.DefaultValue;
					});
				}, "Already the default.");
			}
			return setDetail;
		}

		private void SettingsActionBar()
		{
			bool unsaved = SettingsSync.Unsaved;
			BarAct("Save", BtnKind.Primary, unsaved, delegate
			{
				//IL_0016: Unknown result type (might be due to invalid IL or missing references)
				SettingsSync.SaveAll();
				MenuSound(UiSound.Confirm);
				Toast("Settings saved", Good);
			}, right: false, "Nothing changed yet.");
			BarAct("Undo", BtnKind.Secondary, unsaved, delegate
			{
				SettingsSync.UndoLast();
				MenuSound(UiSound.Back);
			}, right: false, "Nothing to undo.");
			Action reset = _ctlReset;
			BarAct("Reset section", BtnKind.Secondary, reset != null, delegate
			{
				if (reset != null)
				{
					SettingsSync.SaveLocalChange(reset);
					MenuSound(UiSound.Back);
				}
			}, right: false, "This section has nothing to reset.");
			BarAct("Reset all", BtnKind.Danger, enabled: true, delegate
			{
				AskConfirm("RESET ALL SETTINGS?", "Every one of your own settings and key bindings goes back to its default. Undo takes it back until you save.", "Reset all", delegate
				{
					SettingsSync.SaveLocalChange(ResetAllSettings);
					_rebind = Rebind.None;
					MenuSound(UiSound.Back);
				}, focusCancel: true);
			}, right: true);
			int num = (unsaved ? SettingsSync.UnsavedCount() : 0);
			BarNote((num > 0) ? string.Format("{0} change{1} not saved · they apply now, Undo takes them back", num, (num == 1) ? "" : "s") : "Your own settings: they only change your game");
		}

