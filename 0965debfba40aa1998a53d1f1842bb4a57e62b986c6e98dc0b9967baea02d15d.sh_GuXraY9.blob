		private string CrewOptionText(bool drill, string id)
		{
			if (drill)
			{
				ResearchCrew.Drill drill2 = ResearchCrew.DrillDef(id);
				if (drill2 == null)
				{
					return id;
				}
				return "<b>" + drill2.Name + "</b>\n" + drill2.Desc;
			}
			int target = ResearchCrew.TargetFor(id, Game.Players().Count);
			float num = ResearchCrew.SponsorMult(id);
			return "<b>" + ResearchCrew.SponsorName(id) + "</b>\n" + ResearchCrew.SponsorGoal(id, target) + "\n<color=#9a9ca0>Pays " + Scrap.Price(Mathf.RoundToInt(150f * num)) + " each and Research Data at the run's end (half at half way).</color>";
		}

