		private void LateJoinCatchUp()
		{
			RunSave data = _store.Data;
			if (data.catchUpDone || data.catchUpLevel <= 1 || Current == null || CurrentProgress == null)
			{
				return;
			}
			data.catchUpDone = true;
			int num = Mathf.Min(data.catchUpLevel, Leveling.MaxLevel);
			int num2 = 0;
			for (int i = CurrentProgress.level; i < num; i++)
			{
				num2 += Leveling.XpToNext(i);
			}
			if (num2 > 0)
			{
				Leveling.AddXp(CurrentProgress, num2);
				_statsDirty = true;
				CheckPerkMilestones();
				Notify(PopupKind.Level, $"Catch-up: {Current.name} starts at Lv {CurrentProgress.level} - {Leveling.AvailablePoints(CurrentProgress)} skill points to spend ({MenuPrompt})", null, "level");
			}
			if (Plugin.Cfg.StartGear.Value)
			{
				int levelIndex = RunInfo.LevelIndex;
				int rarity = Mathf.Min(Gear.MaxRarity, (levelIndex >= 13) ? 3 : ((levelIndex >= 7) ? 2 : ((levelIndex >= 3) ? 1 : 0)));
				Random rng = new Random();
				SlotDef[] slots = Plugin.Rpg.slots;
				foreach (SlotDef slotDef in slots)
				{
					GearItem gearItem = Gear.RollExact(rng, rarity, slotDef.id, allowUnique: false);
					gearItem.freeValue = SalvageCalc.Gross(gearItem);
					GiveGear(gearItem, "catch-up kit");
				}
			}
			_store.SaveNow();
		}

		private void PerkBump(string counter, int amount)
		{
			//IL_009a: Unknown result type (might be due to invalid IL or missing references)
			RunSave data = _store.Data;
			if (amount <= 0 || !Perks.Tracking(data, counter))
			{
				return;
			}
			List<PerkDef> list = Perks.Bump(data, counter, amount);
			_store.MarkDirty();
			if (list.Count == 0)
			{
				return;
			}
			foreach (PerkDef item in list)
			{
				Notify(PopupKind.Perk, "Evolved! " + item.name + " → " + item.evolveName + ": " + item.evolveDesc, (Color?)new Color(1f, 0.85f, 0.35f), "");
				_perkFlash[item.id] = Time.unscaledTime;
			}
			MenuSound(UiSound.Confirm);
			_statsDirty = true;
			_store.SaveNow();
		}

		private void TickPerks(PlayerAvatar local)
		{
			//IL_0083: Unknown result type (might be due to invalid IL or missing references)
			//IL_0088: Unknown result type (might be due to invalid IL or missing references)
			//IL_00de: Unknown result type (might be due to invalid IL or missing references)
