		{
			public string Id = "";

			public string Name = "";

			public string Desc = "";
		}

		public sealed class State
		{
			public string[] Drills = Array.Empty<string>();

			public string[] DrillOffer = Array.Empty<string>();

			public string[] SponsorOffer = Array.Empty<string>();

			public int DrillFor;

			public int DrillVotes;

			public int SponsorVotes;

			public int Voters = 1;

			public int[] DrillBy = Array.Empty<int>();

			public int[] SponsorBy = Array.Empty<int>();

			public string Sponsor = "";

			public string SponsorLine = "";
		}

		public const string ArchivistId = "archivist";

		public static readonly Drill[] Drills = new Drill[8]
		{
			new Drill
			{
				Id = "tight_formation",
				Name = "Tight Formation",
				Desc = "Take 6% less damage while a living teammate is within 8 m."
