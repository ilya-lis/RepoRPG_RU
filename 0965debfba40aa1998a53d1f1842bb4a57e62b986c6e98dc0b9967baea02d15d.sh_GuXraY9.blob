		private void DebugSetLevel(int level)
		{
			//IL_0052: Unknown result type (might be due to invalid IL or missing references)
			//IL_00d8: Unknown result type (might be due to invalid IL or missing references)
			//IL_0090: Unknown result type (might be due to invalid IL or missing references)
			ClassProgress currentProgress = CurrentProgress;
			if (currentProgress != null)
			{
				DebugLog($"set level {level}");
				currentProgress.level = Mathf.Clamp(level, 1, Leveling.MaxLevel);
				currentProgress.xp = 0;
				_talentPending.Clear();
				if (Leveling.FixOverspend(currentProgress))
				{
					Toast("Skill tree refunded (fewer points at this level)", Color.white);
				}
				if (Leveling.AvailableAttributePoints(currentProgress, _store.Data) < 0)
				{
					_store.Data.attributes.Clear();
					Toast("Attribute points refunded", Color.white);
				}
				_statsDirty = true;
				CheckPerkMilestones();
				_store.MarkDirty();
				_store.SaveNow();
				Toast($"Debug: level {currentProgress.level}", Accent);
			}
		}

