						Col = new Color(0.55f, 0.9f, 0.75f),
						Done = true,
						Btn = "Dismiss",
						Text = $"<b>ROUTE (LEVEL {cur.RouteFor + 1}):</b> {Routes.Name(cur.RouteOptions[cur.RouteChosen])}"
