		public int AttributePoints(string id)
		{
			foreach (NodeRank attribute in attributes)
			{
				if (attribute.id == id)
				{
					return attribute.rank;
				}
			}
			return 0;
		}

		public int SpentAttributePoints()
		{
			int num = 0;
			foreach (NodeRank attribute in attributes)
			{
				num += attribute.rank;
			}
			return num;
		}

		public void SetAttribute(string id, int value)
		{
			foreach (NodeRank attribute in attributes)
			{
				if (!(attribute.id != id))
				{
					attribute.rank = value;
					return;
				}
			}
			attributes.Add(new NodeRank
			{
				id = id,
				rank = value
			});
		}

		public GearItem? FindItem(string uid)
		{
			if (string.IsNullOrEmpty(uid))
			{
				return null;
			}
			foreach (GearItem item in inventory)
			{
				if (item.uid == uid)
				{
					return item;
				}
			}
			return null;
		}

		public IEnumerable<GearItem> EquippedItems()
		{
			string[] array = equipped;
			foreach (string uid in array)
			{
				GearItem gearItem = FindItem(uid);
				if (gearItem != null)
				{
					yield return gearItem;
				}
			}
		}

		public bool IsEquipped(GearItem g)
		{
			return Array.IndexOf(equipped, g.uid) >= 0;
		}
	}
	internal sealed class Net : IOnEventCallback
	{
		public enum TeamXp : byte
		{
			Extraction = 1,
			LevelComplete
		}

		private static Net? _instance;

		public static readonly Dictionary<int, float> HeardFrom = new Dictionary<int, float>();

		private static readonly HashSet<int> OldVersionTold = new HashSet<int>();

		private static readonly HashSet<string> StarterPaid = new HashSet<string>();

		private static readonly Dictionary<int, float> AssistAt = new Dictionary<int, float>();

		private static bool Online
		{
			get
			{
				if (Game.IsMultiplayer())
				{
					return PhotonNetwork.InRoom;
				}
				return false;
			}
		}

		public static void Init()
		{
			if (_instance != null)
			{
				return;
			}
			_instance = new Net();
			try
			{
				PhotonNetwork.AddCallbackTarget((object)_instance);
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("Photon callbacks unavailable: " + ex.Message));
			}
		}

		private static object[] Wrap(byte type, object payload)
		{
			return new object[4] { 1397903431, 4, type, payload };
		}

		private static void Send(byte type, object payload, ReceiverGroup to)
		{
			//IL_003d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0042: Unknown result type (might be due to invalid IL or missing references)
			//IL_0043: Unknown result type (might be due to invalid IL or missing references)
			//IL_0044: Unknown result type (might be due to invalid IL or missing references)
			//IL_0049: Unknown result type (might be due to invalid IL or missing references)
			//IL_0053: Expected O, but got Unknown
			//IL_0009: Unknown result type (might be due to invalid IL or missing references)
			//IL_000b: Invalid comparison between Unknown and I4
			if (NetMeter.Counting)
			{
				NetMeter.Sent(type, payload, ((int)to == 2) ? 1 : Mathf.Max(1, (PhotonNetwork.CurrentRoom == null) ? 1 : (PhotonNetwork.CurrentRoom.PlayerCount - 1)));
			}
			PhotonNetwork.RaiseEvent((byte)150, (object)Wrap(type, payload), new RaiseEventOptions
			{
				Receivers = to
			}, SendOptions.SendReliable);
		}

		private static void SendTo(byte type, object payload, int actor)
		{
			//IL_001b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0021: Expected O, but got Unknown
			//IL_0032: Unknown result type (might be due to invalid IL or missing references)
			if (NetMeter.Counting)
			{
				NetMeter.Sent(type, payload, 1);
			}
			object[] array = Wrap(type, payload);
			RaiseEventOptions val = new RaiseEventOptions();
			val.TargetActors = new int[1] { actor };
			PhotonNetwork.RaiseEvent((byte)150, (object)array, val, SendOptions.SendReliable);
		}

		public static void SendEnemyEffect(Vector3 origin, float radius, int damage, float stunSeconds, float markPct = 0f, float markSeconds = 0f)
		{
			//IL_000e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0025: Unknown result type (might be due to invalid IL or missing references)
			//IL_0033: Unknown result type (might be due to invalid IL or missing references)
			//IL_0041: Unknown result type (might be due to invalid IL or missing references)
			if (!Online || PhotonNetwork.IsMasterClient)
			{
				ApplyEnemyEffect(origin, radius, damage, stunSeconds, markPct, markSeconds);
				return;
			}
			Send(1, new object[8] { origin.x, origin.y, origin.z, radius, damage, stunSeconds, markPct, markSeconds }, (ReceiverGroup)2);
		}

		public static void AskProgress(string key, string steamId)
		{
			if (Online && !PhotonNetwork.IsMasterClient)
			{
				Send(18, new object[2] { key, steamId }, (ReceiverGroup)2);
			}
		}

		public static void PushProgress(string key, string steamId, string json)
		{
			if (Online && !PhotonNetwork.IsMasterClient)
			{
				Send(20, new object[3] { key, steamId, json }, (ReceiverGroup)2);
			}
		}

		public static void RequestPushes()
		{
			if (Online && PhotonNetwork.IsMasterClient)
			{
				Send(21, (byte)0, (ReceiverGroup)0);
			}
		}

		private static string SenderSteamId(int actor, string claimed)
		{
			foreach (PlayerAvatar item in Game.Players())
			{
				if (!((Object)(object)item != (Object)null) || Game.ActorNumber(item) != actor)
				{
					continue;
				}
				string text = Game.SteamId(item);
				if (!string.IsNullOrEmpty(text))
				{
					if (text != claimed && claimed != "")
					{
						Plugin.Log.LogWarning((object)$"Player {actor} claimed Steam ID {claimed} but is {text}; using {text}.");
					}
					return text;
				}
			}
			return claimed;
		}

		public static string PlayerNameOf(int actor)
		{
			return PlayerName(actor);
		}

		private static string PlayerName(int actor)
		{
			try
			{
				Room currentRoom = PhotonNetwork.CurrentRoom;
				object obj;
				if (currentRoom == null)
				{
					obj = null;
				}
				else
				{
					Player player = currentRoom.GetPlayer(actor, false);
					obj = ((player != null) ? player.NickName : null);
				}
				if (obj == null)
				{
					obj = "";
				}
				return (string)obj;
			}
			catch
			{
				return "";
			}
		}

		public static void SendAura(RpgRuntime.Aura a)
		{
			if (Online)
			{
				Send(17, new object[10] { a.Guard, a.GuardRadius, a.Stabilize, a.StabilizeRadius, a.Link, a.LinkRadius, a.Inspire, a.InspireRadius, a.InspireSpeed, a.InspireGrip }, (ReceiverGroup)0);
			}
		}

		public static void BroadcastTeamXp(TeamXp kind)
		{
			if (!Online)
			{
				RpgRuntime.Instance?.OnTeamXp(kind);
			}
			else
			{
				Send(2, (byte)kind, (ReceiverGroup)1);
			}
		}

