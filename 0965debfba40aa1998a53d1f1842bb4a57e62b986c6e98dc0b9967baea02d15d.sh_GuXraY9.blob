				}
				else if (num > 0f)
				{
					lines.Add(((Mathf.Abs(num - num2) < 0.05f) ? $"Blood Price: {num:0.#} HP per hit / throw" : $"Blood Price: {num2:0.#} HP per hit, {num:0.#} per throw", val));
				}
				break;
			}
			case "cartwright":
				if (_cartState != "")
				{
					lines.Add(("Cart: " + _cartState, (Color)((_cartState == "stuck" || _cartState == "no route") ? new Color(1f, 0.55f, 0.45f) : val)));
				}
				break;
			case "undertaker":
				lines.AddRange(HeadSenseLines(val));
				break;
			}
			ThirdWaveHudLines(lines, val);
			if (_inspireFromAllies.speed > 0f || _inspireFromAllies.grip > 0f)
			{
				lines.Add(($"Inspired  +{_inspireFromAllies.speed:0.#}% speed, +{_inspireFromAllies.grip:0.#}% grip", new Color(1f, 0.75f, 0.55f)));
			}
			foreach (TimedBuff buff in _buffs)
			{
				if (buff.Source != "")
				{
					lines.Add(($"{buff.Source}  {BuffText(buff.Speed, buff.Grip, buff.Guard)}  {buff.Until - Time.time:0}s", new Color(0.85f, 0.9f, 1f)));
				}
			}
		}

