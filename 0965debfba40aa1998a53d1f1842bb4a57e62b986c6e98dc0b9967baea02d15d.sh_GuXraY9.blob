			d.Type = "Team contract" + ((contractGiverDef != null) ? (" · " + contractGiverDef.name) : "");
			d.Name = tcDef.name;
			d.NameColor = new Color(1f, 0.75f, 0.3f);
			switch (_tcState)
			{
			case 0:
				d.Status.Add(_tcVoted ? (UiStatus.Selected, "You've voted") : (UiStatus.Pending, "Waiting for your vote"));
				break;
			case 1:
				d.Status.Add((UiStatus.Available, IsTeamParticipant() ? "Accepted - you're in" : "Accepted - not in it"));
				break;
			case 2:
				d.Status.Add((UiStatus.Maxed, "Complete"));
				break;
			case 3:
				d.Status.Add((UiStatus.Locked, "Failed"));
				break;
			default:
				d.Status.Add((UiStatus.Locked, "Declined"));
				break;
			}
			d.NowHead = "OBJECTIVE";
			d.Now = TeamContracts.Goal(tcDef, _tcTarget) + ((TeamHaulLine() != "") ? ("\n<color=#ffd75a>" + TeamHaulLine() + "</color>") : "");
			d.NextHead = "REWARD";
			d.NextNote = TeamContracts.RewardText(tcDef, _tcScale) + " (everyone in it)";
			d.NeedsHead = "STAKES AND THE VOTE";
			string text = ((_tcState == 0) ? ("\n" + TeamVoteCount() + " · " + VoteRuleText() + (_tcBoardVote ? " · closes when the level starts" : $" · {Mathf.Max(0f, _tcVoteEnd - Time.time):0}s left")) : "");
			d.Needs = TeamContracts.LossText(tcDef, _tcScale) + text + ((TeamVoters() != "") ? ("\n" + TeamVoters()) : "") + "\n<color=#9a9ca0>In a level you can also hold the call-out key to accept.</color>";
			if (_tcState == 0)
			{
				bool enabled = TeamVoting && !_tcVoted;
				d.Act("Vote accept", BtnKind.Primary, enabled, delegate
				{
					VoteTeam(accept: true);
				}, "You've voted.");
				d.Act("Vote decline", BtnKind.Secondary, enabled, delegate
				{
					VoteTeam(accept: false);
				}, "You've voted.");
			}
		}

