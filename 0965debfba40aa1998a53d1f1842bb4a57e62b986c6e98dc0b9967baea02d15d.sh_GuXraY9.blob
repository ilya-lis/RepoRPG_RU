				Fill(val, Color.Lerp(ClassTheme.Cur.Panel, voteRow.Col * 0.4f, 0.25f));
				Fill(new Rect(((Rect)(ref val)).x, ((Rect)(ref val)).y, 5f, ((Rect)(ref val)).height), voteRow.Col);
				Border(val, (Color)(flag ? voteRow.Col : new Color(voteRow.Col.r, voteRow.Col.g, voteRow.Col.b, 0.5f)), flag ? 2f : 1f);
				float num = Mathf.Max(120f, TextW("> " + voteRow.Btn.ToUpperInvariant(), _btn) + 24f);
				((Rect)(ref val2))..ctor(((Rect)(ref val)).xMax - num - 4f, ((Rect)(ref val)).y + 2f, num, btnH - 4f);
				Label(new Rect(((Rect)(ref val)).x + 12f + 4f, ((Rect)(ref val)).y + (btnH - LineH(_smallLine)) / 2f, ((Rect)(ref val2)).x - ((Rect)(ref val)).x - 24f, LineH(_smallLine) + 2f), voteRow.Text, _smallLine);
				string label = (flag ? "Back to shop" : voteRow.Btn);
				if (Btn(val2, label))
				{
					if (voteRow.Done)
					{
						_routeSeenFor = RunShape.Cur.RouteFor;
						MenuSound(UiSound.Tick);
					}
					else
					{
						_shopVote = (flag ? "" : voteRow.Id);
						MenuSound(UiSound.Click);
					}
				}
				if (_shopVote == "" && voteRow.Mine && !voteRow.Done)
				{
					if (voteRow.Id == "run")
					{
						NoticeHighlight("milestone", val, val2);
						NoticeHighlight("boon", val, val2);
					}
					else
					{
						NoticeHighlight(voteRow.Id, val, val2);
					}
				}
				y += btnH + 4f;
			}
			return y + 8f - 4f;
		}

