			MarketMin = c.Bind<float>("Market", "MinMultiplier", 0.6f, new ConfigDescription("Lowest a category's price can go (x normal).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0.2f, 1f), Array.Empty<object>()));
			MarketMax = c.Bind<float>("Market", "MaxMultiplier", 1.6f, new ConfigDescription("Highest a category's price can go (x normal).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(1f, 3f), Array.Empty<object>()));
			MarketEventChance = c.Bind<float>("Market", "EventChance", 25f, new ConfigDescription("Chance (%) at each shop visit that a market event is announced (one at a time).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
			MarketRecovery = c.Bind<float>("Market", "RecoverySpeed", 15f, new ConfigDescription("How much of the way back to normal prices recover each level (%).", (AcceptableValueBase)(object)new AcceptableValueRange<float>(0f, 100f), Array.Empty<object>()));
