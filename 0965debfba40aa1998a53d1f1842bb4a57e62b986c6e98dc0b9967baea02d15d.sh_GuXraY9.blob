		private static (int points, int level) CapstoneNeed(BranchDef b, ClassProgress shown)
		{
			int num = 0;
			int num2 = 1;
			NodeDef[] nodes = b.nodes;
			foreach (NodeDef nodeDef in nodes)
			{
				int num3 = shown.RankOf(nodeDef.id);
				num2 = Mathf.Max(num2, ClassDatabase.UnlockLevel(nodeDef));
				if (nodeDef.capstone)
				{
					if (num3 < 1)
					{
						num++;
					}
					break;
				}
				if (num3 < 1)
				{
					num++;
				}
			}
			return (points: num, level: num2);
		}

		private string NodeValues(NodeDef n, int rank)
		{
			if (n.maxRank <= 1)
			{
				return "";
			}
			if (_nodeValueText.TryGetValue((n, rank), out string value))
			{
				return value;
			}
			value = ((rank <= 0) ? ("Rank 1: " + Fmt(1)) : ((rank >= n.maxRank) ? ("Now: " + Fmt(rank)) : ("Now: " + Fmt(rank) + "  ·  Next: " + Fmt(rank + 1))));
			if (_nodeValueText.Count > 2000)
			{
				_nodeValueText.Clear();
			}
			_nodeValueText[(n, rank)] = value;
			return value;
			string Fmt(int r)
			{
				List<string> list = new List<string>();
				EffectDef[] effects = n.effects;
				foreach (EffectDef effectDef in effects)
				{
					if (effectDef.StatIndex >= 0)
					{
						list.Add(StatInfo.Describe((Stat)effectDef.StatIndex, effectDef.value * (float)r));
					}
					else
					{
						list.Add($"{effectDef.value * (float)r:+0.##;-0.##}");
					}
				}
				if (list.Count != 0)
				{
					return string.Join(", ", list);
				}
				return "-";
			}
		}

