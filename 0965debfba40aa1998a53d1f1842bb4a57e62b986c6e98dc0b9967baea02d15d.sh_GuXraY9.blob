			PerkOnHit();
			AttrOnHit();
			AddScar();
			TeamPlay.Add(TeamPlay.Ev.Prevented, Mathf.Max(0, num2 - damage));
			TeamPlay.Add(TeamPlay.Ev.Taken, damage);
			if (damage > 0)
			{
				CEv("damage", damage);
			}
			if (_guardActor > 0 && _guardPct > 0f && _guardPct < 100f && damage > 0)
			{
				Net.SendContractAssist(_guardActor, "cls.juggernaut", Mathf.Min(100f, (float)damage * _guardPct / (100f - _guardPct)));
			}
			return true;
		}

