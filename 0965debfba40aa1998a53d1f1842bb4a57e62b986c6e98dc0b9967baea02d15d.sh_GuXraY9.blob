			//IL_0254: Unknown result type (might be due to invalid IL or missing references)
			into.Clear();
			ModConfig cfg = Plugin.Cfg;
			if (!cfg.HudExtraKeys.Value || Current == null)
			{
				return;
			}
			bool flag = Game.InLevel();
			switch (Current.id)
			{
			case "cartwright":
			{
				HcKey hcKey4 = AddKey(into, cfg.CartFollowKey.Value, cfg.PadCartFollowButton.Value, "Cart follow");
				if (ClassStat("cartwright.follow") <= 0f)
				{
					Grey(hcKey4, "not learned");
				}
				else if (hcKey4.Usable)
				{
					hcKey4.HasState = true;
					hcKey4.On = _cartFollowOn;
					hcKey4.State = (_cartFollowOn ? "ON" : "OFF");
				}
				break;
			}
			case "herald":
			{
				HcKey hcKey2 = AddKey(into, cfg.HumKey.Value, cfg.PadHumButton.Value, "Hum");
				if (hcKey2.Usable && HumHeld())
				{
					hcKey2.HasState = true;
					hcKey2.On = true;
					hcKey2.State = "humming";
				}
				break;
			}
			case "ventriloquist":
				if (!(ClassStat("ventriloquist.throw_dist") <= 0f))
				{
					HcKey hcKey3 = AddKey(into, cfg.HumKey.Value, cfg.PadHumButton.Value, "Throw voice");
					if (!flag)
					{
						Grey(hcKey3, "levels only");
					}
					else if (hcKey3.Usable && HumHeld())
					{
						hcKey3.HasState = true;
						hcKey3.On = true;
						hcKey3.State = "throwing";
					}
				}
				break;
			case "quartermaster":
				if (!(ClassStat("quartermaster.handoff") <= 0f))
				{
					HcKey k = AddKey(into, cfg.HandOffKey.Value, cfg.PadHandOffButton.Value, "Hand off");
					if (!flag)
					{
						Grey(k, "levels only");
					}
					else if ((Object)(object)Game.HeldComponent<PhysGrabObject>() == (Object)null)
					{
						Grey(k, "hold an item");
					}
				}
				break;
			case "mimic":
				if (!(ClassStat("mimic.dual") <= 0f))
				{
					HcKey hcKey = AddKey(into, cfg.MimicSwapKey.Value, cfg.PadMimicSwapButton.Value, "Swap copy");
					string text = _copies[1 - _copySlot];
					if (text == "")
					{
						Grey(hcKey, "no 2nd copy");
					}
					else if (hcKey.Usable)
					{
						hcKey.HasState = true;
						hcKey.State = Plugin.Db.Get(text)?.active.name ?? "";
					}
				}
				break;
			}
		}

		private bool HumHeld()
		{
			//IL_0018: Unknown result type (might be due to invalid IL or missing references)
			if (!_menuOpen)
			{
				if (!_held.Contains(Plugin.Cfg.HumKey.Value) || ChatOpen.Value())
				{
					if (Pad.Connected)
					{
						return Pad.ChordHeld(Plugin.Cfg.PadHumButton.Value);
					}
					return false;
				}
				return true;
			}
			return false;
		}

