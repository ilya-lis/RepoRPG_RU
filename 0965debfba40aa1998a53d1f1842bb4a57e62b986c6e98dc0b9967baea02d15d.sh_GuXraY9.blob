	}
	internal sealed class DetailInfo
	{
		public string Key = "\u0001";

		public string Type = "";

		public string Name = "";

		public Color? NameColor;

		public readonly List<(UiStatus st, string label)> Status = new List<(UiStatus, string)>();

		public string Now = "";

		public readonly List<(string label, string cur, string next, bool better)> Next = new List<(string, string, string, bool)>();

		public string NextNote = "";

		public string Needs = "";

		public readonly List<UiAction> Actions = new List<UiAction>();

		public Func<Rect, float>? Custom;

		public float CustomH;

		public string EmptyTitle = "";

		public string EmptyText = "";

		public string NowHead = "DOES NOW";

		public string NextHead = "CHANGES NEXT";

		public string NeedsHead = "NEEDS";

		public bool Is(string key)
		{
			return Key == key;
		}

		public void Begin(string key)
		{
			Key = key;
			Type = (Name = (Now = (NextNote = (Needs = (EmptyTitle = (EmptyText = ""))))));
			NameColor = null;
			Status.Clear();
			Next.Clear();
			Actions.Clear();
			Custom = null;
			CustomH = 0f;
			NowHead = "DOES NOW";
			NextHead = "CHANGES NEXT";
			NeedsHead = "NEEDS";
		}

		public UiAction Act(string label, BtnKind kind, bool enabled, Action run, string why = "")
		{
			UiAction uiAction = new UiAction
			{
				Label = label,
				Kind = kind,
				Enabled = enabled,
				Run = run,
				Why = why
			};
			Actions.Add(uiAction);
			return uiAction;
		}
	}
	internal static class VanillaStyle
	{
		[Serializable]
		public class StyleFile
		{
			public int version = 1;

			public string probedUtc = "";

			public string accent = "";

			public string text = "";

			public string muted = "";

			public string panel = "";

			public string shadow = "";

			public float shadowOffset = 2f;

			public string font = "";

			public int textsSeen;

			public int imagesSeen;

			public List<string> fonts = new List<string>();

			public List<string> textColors = new List<string>();

			public List<string> panelColors = new List<string>();

			public List<string> sounds = new List<string>();
		}

		private static readonly Color FallbackAccent = new Color(1f, 0.7f, 0.12f);

		private static readonly Color FallbackText = new Color(0.96f, 0.96f, 0.94f);

		private static readonly Color FallbackMuted = new Color(0.62f, 0.63f, 0.66f);

		private static readonly Color FallbackPanel = new Color(0.02f, 0.02f, 0.025f, 0.9f);

		private static int _probes;

		private static bool _done;

		public static Color Accent { get; private set; } = FallbackAccent;

		public static Color Text { get; private set; } = FallbackText;

		public static Color Muted { get; private set; } = FallbackMuted;

		public static Color Panel { get; private set; } = FallbackPanel;

		public static float ShadowOffset { get; private set; } = 2f;

		public static Color Shadow { get; private set; } = new Color(0f, 0f, 0f, 0.85f);

		public static string FontName { get; private set; } = "";

		public static bool FromGame { get; private set; }

		public static int Version { get; private set; }

		private static string FilePath => Path.Combine(ClassDatabase.Folder, "vanilla_style.json");

		private static string NotesPath => Path.Combine(ClassDatabase.Folder, "vanilla_style.md");

		public static string Hex(Color c)
		{
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			return "#" + ColorUtility.ToHtmlStringRGB(c).ToLowerInvariant();
		}

		public static void LoadSaved()
		{
			try
			{
				if (!File.Exists(FilePath))
				{
					Plugin.Log.LogInfo((object)"UI style: no vanilla style file yet; it's read from the game's menus once they show.");
				}
				else
				{
					Apply(Json.Deserialize<StyleFile>(File.ReadAllText(FilePath)), "saved");
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("UI style file unreadable (" + ex.Message + "); using the built-in style."));
			}
		}

		private static bool TryColor(string hex, out Color c)
		{
			return ColorUtility.TryParseHtmlString(hex ?? "", ref c);
		}

		private static void Apply(StyleFile f, string from)
		{
			//IL_0011: Unknown result type (might be due to invalid IL or missing references)
			//IL_0028: Unknown result type (might be due to invalid IL or missing references)
			//IL_003f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0058: Unknown result type (might be due to invalid IL or missing references)
			//IL_0073: Unknown result type (might be due to invalid IL or missing references)
			//IL_0092: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a3: Unknown result type (might be due to invalid IL or missing references)
			//IL_0112: Unknown result type (might be due to invalid IL or missing references)
			//IL_0127: Unknown result type (might be due to invalid IL or missing references)
			//IL_013c: Unknown result type (might be due to invalid IL or missing references)
			//IL_0152: Unknown result type (might be due to invalid IL or missing references)
			bool flag = false;
			if (TryColor(f.accent, out var c))
			{
				Accent = c;
				flag = true;
			}
			if (TryColor(f.text, out var c2))
			{
				Text = c2;
				flag = true;
			}
			if (TryColor(f.muted, out var c3))
			{
				Muted = c3;
				flag = true;
			}
			if (TryColor(f.panel, out var c4))
			{
				c4.a = Mathf.Clamp(c4.a, 0.75f, 0.96f);
				Panel = c4;
				flag = true;
			}
			if (TryColor(f.shadow, out var c5))
			{
				c5.a = Mathf.Max(0.6f, c5.a);
				Shadow = c5;
			}
			ShadowOffset = Mathf.Clamp(f.shadowOffset, 1f, 4f);
			FontName = f.font ?? "";
			FromGame = flag;
			Version++;
			if (flag)
			{
				Plugin.Log.LogInfo((object)("UI style (" + from + "): accent " + Hex(Accent) + ", text " + Hex(Text) + ", muted " + Hex(Muted) + ", panel " + Hex(Panel) + ", font '" + FontName + "'."));
			}
		}

		public static IEnumerator ProbeSoon()
		{
			if (_done || _probes >= 6)
			{
				yield break;
			}
			_probes++;
			yield return (object)new WaitForSecondsRealtime(3f);
			if (_done)
			{
				yield break;
			}
			try
			{
				Probe();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("UI style probe failed (" + ex.GetBaseException().Message + "); keeping the current style."));
			}
		}

		private static void Probe()
		{
			//IL_02cc: Unknown result type (might be due to invalid IL or missing references)
			//IL_02d1: Unknown result type (might be due to invalid IL or missing references)
			//IL_02d9: Unknown result type (might be due to invalid IL or missing references)
			//IL_015e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0163: Unknown result type (might be due to invalid IL or missing references)
			//IL_0165: Unknown result type (might be due to invalid IL or missing references)
			//IL_02e7: Unknown result type (might be due to invalid IL or missing references)
			//IL_0175: Unknown result type (might be due to invalid IL or missing references)
			//IL_02f5: Unknown result type (might be due to invalid IL or missing references)
			//IL_0305: Unknown result type (might be due to invalid IL or missing references)
			//IL_01d1: Unknown result type (might be due to invalid IL or missing references)
			//IL_0240: Unknown result type (might be due to invalid IL or missing references)
			Type type = AccessTools.TypeByName("TMPro.TMP_Text");
			Type type2 = AccessTools.TypeByName("UnityEngine.UI.Graphic");
			Type type3 = AccessTools.TypeByName("UnityEngine.UI.Image");
			if (type == null)
			{
				Game.WarnOnce("UI style: the game's TextMeshPro wasn't found; using the built-in style.");
				_done = true;
				return;
			}
			PropertyInfo propertyInfo = AccessTools.Property(type, "font");
			AccessTools.Property(type, "fontSize");
			PropertyInfo propertyInfo2 = AccessTools.Property(type, "color");
			PropertyInfo propertyInfo3 = AccessTools.Property(type, "fontSharedMaterial");
			PropertyInfo propertyInfo4 = ((type2 == null) ? null : AccessTools.Property(type2, "color"));
			Dictionary<string, int> dictionary = new Dictionary<string, int>();
			Dictionary<string, int> d = new Dictionary<string, int>();
			Dictionary<string, int> d2 = new Dictionary<string, int>();
			Dictionary<string, int> d3 = new Dictionary<string, int>();
			List<float> list = new List<float>();
			int num = 0;
			int num2 = 0;
			Object[] array = Object.FindObjectsByType(type, (FindObjectsSortMode)0);
			foreach (Object val in array)
			{
				Component val2 = (Component)(object)((val is Component) ? val : null);
				if (val2 == null || (Object)(object)val2 == (Object)null || !val2.gameObject.activeInHierarchy)
				{
					continue;
				}
				num++;
				object? obj = propertyInfo?.GetValue(val);
				Object val3 = (Object)((obj is Object) ? obj : null);
				if (val3 != (Object)null)
				{
					dictionary[val3.name] = ((!dictionary.TryGetValue(val3.name, out var value)) ? 1 : (value + 1));
				}
				if (propertyInfo2?.GetValue(val) is Color val4 && val4.a > 0.5f)
				{
					Count(d, Quant(val4));
				}
				object? obj2 = propertyInfo3?.GetValue(val);
				Material val5 = (Material)((obj2 is Material) ? obj2 : null);
				if (val5 == null || !((Object)(object)val5 != (Object)null))
				{
					continue;
				}
				if (val5.HasProperty("_UnderlayColor") && val5.IsKeywordEnabled("UNDERLAY_ON"))
				{
					Count(d3, Quant(val5.GetColor("_UnderlayColor")));
					if (val5.HasProperty("_UnderlayOffsetX"))
					{
						list.Add(Mathf.Abs(val5.GetFloat("_UnderlayOffsetX")));
					}
				}
				else if (val5.HasProperty("_OutlineColor") && val5.HasProperty("_OutlineWidth") && val5.GetFloat("_OutlineWidth") > 0.05f)
				{
					Count(d3, Quant(val5.GetColor("_OutlineColor")));
				}
			}
			if (type3 != null && propertyInfo4 != null)
			{
				array = Object.FindObjectsByType(type3, (FindObjectsSortMode)0);
				foreach (Object val6 in array)
				{
					Component val7 = (Component)(object)((val6 is Component) ? val6 : null);
					if (val7 != null && !((Object)(object)val7 == (Object)null) && val7.gameObject.activeInHierarchy && propertyInfo4.GetValue(val6) is Color val8)
					{
						num2++;
						if (val8.a > 0.3f && val8.a < 0.99f && Lum(val8) < 0.25f)
						{
							Count(d2, Quant(val8));
						}
					}
				}
			}
			if (num < 8)
			{
				Plugin.Log.LogDebug((object)$"UI style probe: only {num} game texts on screen, trying again later.");
				return;
			}
			StyleFile styleFile = new StyleFile
			{
				probedUtc = DateTime.UtcNow.ToString("o"),
				textsSeen = num,
				imagesSeen = num2,
				fonts = Top(dictionary, 6),
				textColors = Top(d, 10),
				panelColors = Top(d2, 6),
				sounds = MenuSoundNames()
			};
			styleFile.font = ((styleFile.fonts.Count > 0) ? Strip(styleFile.fonts[0]) : "");
			styleFile.text = Pick(d, (Color c) => Lum(c) > 0.7f && Sat(c) < 0.2f);
			styleFile.accent = Pick(d, (Color c) => Sat(c) > 0.45f && Value(c) > 0.55f);
			styleFile.muted = Pick(d, (Color c) => Lum(c) > 0.3f && Lum(c) <= 0.7f && Sat(c) < 0.25f);
			styleFile.panel = Pick(d2, (Color _) => true, withAlpha: true);
			styleFile.shadow = Pick(d3, (Color c) => Lum(c) < 0.3f, withAlpha: true);
			if (list.Count > 0)
			{
				list.Sort();
				styleFile.shadowOffset = Mathf.Clamp(1f + list[list.Count / 2] * 3f, 1f, 4f);
			}
			try
			{
				if (File.Exists(FilePath))
				{
					StyleFile styleFile2 = Json.Deserialize<StyleFile>(File.ReadAllText(FilePath));
					if (styleFile.accent == "")
					{
						styleFile.accent = styleFile2.accent;
					}
					if (styleFile.text == "")
					{
						styleFile.text = styleFile2.text;
					}
					if (styleFile.muted == "")
					{
						styleFile.muted = styleFile2.muted;
					}
					if (styleFile.panel == "")
					{
						styleFile.panel = styleFile2.panel;
					}
					if (styleFile.shadow == "")
					{
						styleFile.shadow = styleFile2.shadow;
					}
				}
			}
			catch
			{
			}
			Directory.CreateDirectory(ClassDatabase.Folder);
			File.WriteAllText(FilePath, Json.Serialize(styleFile));
			File.WriteAllText(NotesPath, Notes(styleFile));
			Apply(styleFile, "read from the game's menus");
			if (styleFile.accent == "" || styleFile.text == "")
			{
				Plugin.Log.LogWarning((object)"UI style: some of the game's colours weren't found; the built-in ones fill the gaps.");
			}
			if (num >= 30)
			{
				_done = true;
			}
		}

		private static void Count(Dictionary<string, int> d, string key)
		{
			d[key] = ((!d.TryGetValue(key, out var value)) ? 1 : (value + 1));
		}

		private static string Quant(Color c)
		{
			//IL_0002: Unknown result type (might be due to invalid IL or missing references)
			//IL_0019: Unknown result type (might be due to invalid IL or missing references)
			//IL_0030: Unknown result type (might be due to invalid IL or missing references)
			//IL_0047: Unknown result type (might be due to invalid IL or missing references)
			//IL_0068: Unknown result type (might be due to invalid IL or missing references)
			Color val = default(Color);
			((Color)(ref val))..ctor(Mathf.Round(c.r * 32f) / 32f, Mathf.Round(c.g * 32f) / 32f, Mathf.Round(c.b * 32f) / 32f, Mathf.Round(c.a * 16f) / 16f);
			return "#" + ColorUtility.ToHtmlStringRGBA(val).ToLowerInvariant();
		}

		private static float Lum(Color c)
		{
			//IL_0005: Unknown result type (might be due to invalid IL or missing references)
			//IL_0011: Unknown result type (might be due to invalid IL or missing references)
			//IL_001e: Unknown result type (might be due to invalid IL or missing references)
			return 0.2126f * c.r + 0.7152f * c.g + 0.0722f * c.b;
		}

		private static float Value(Color c)
		{
			//IL_0000: Unknown result type (might be due to invalid IL or missing references)
			//IL_0006: Unknown result type (might be due to invalid IL or missing references)
			//IL_000c: Unknown result type (might be due to invalid IL or missing references)
			return Mathf.Max(c.r, Mathf.Max(c.g, c.b));
		}

		private static float Sat(Color c)
		{
			//IL_0000: Unknown result type (might be due to invalid IL or missing references)
			//IL_0010: Unknown result type (might be due to invalid IL or missing references)
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			//IL_001c: Unknown result type (might be due to invalid IL or missing references)
			float num = Value(c);
			if (!(num <= 0f))
			{
				return (num - Mathf.Min(c.r, Mathf.Min(c.g, c.b))) / num;
			}
			return 0f;
		}

		private static string Pick(Dictionary<string, int> d, Func<Color, bool> ok, bool withAlpha = false)
		{
			//IL_002a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0045: Unknown result type (might be due to invalid IL or missing references)
			string result = "";
			int num = 0;
			Color val = default(Color);
			foreach (KeyValuePair<string, int> item in d)
			{
				if (ColorUtility.TryParseHtmlString(item.Key, ref val) && ok(val) && item.Value > num)
				{
					result = (withAlpha ? item.Key : ("#" + ColorUtility.ToHtmlStringRGB(val).ToLowerInvariant()));
					num = item.Value;
				}
			}
			return result;
		}

		private static List<string> Top(Dictionary<string, int> d, int n)
		{
			List<KeyValuePair<string, int>> list = new List<KeyValuePair<string, int>>(d);
			list.Sort((KeyValuePair<string, int> a, KeyValuePair<string, int> b) => b.Value.CompareTo(a.Value));
			List<string> list2 = new List<string>();
			for (int num = 0; num < list.Count && num < n; num++)
			{
				list2.Add($"{list[num].Key} x{list[num].Value}");
			}
			return list2;
		}

		private static string Strip(string s)
		{
			int num = s.LastIndexOf(" x", StringComparison.Ordinal);
			if (num <= 0)
			{
				return s;
			}
			return s.Substring(0, num);
		}

		private static List<string> MenuSoundNames()
		{
			List<string> list = new List<string>();
			try
			{
				Type type = AccessTools.TypeByName("MenuManager");
				if (type == null)
				{
					return list;
				}
				foreach (MethodInfo declaredMethod in AccessTools.GetDeclaredMethods(type))
				{
					if (!declaredMethod.Name.StartsWith("MenuEffect", StringComparison.Ordinal))
					{
						continue;
					}
					StringBuilder stringBuilder = new StringBuilder(declaredMethod.Name);
					ParameterInfo[] parameters = declaredMethod.GetParameters();
					foreach (ParameterInfo parameterInfo in parameters)
					{
						if (parameterInfo.ParameterType.IsEnum)
						{
							stringBuilder.Append(" (").Append(string.Join(", ", Enum.GetNames(parameterInfo.ParameterType))).Append(')');
						}
					}
					list.Add(stringBuilder.ToString());
				}
			}
			catch
			{
			}
			return list;
		}

		private static string Notes(StyleFile f)
		{
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.AppendLine("# R.E.P.O. UI style (read from the game by RepoRPG)");
			stringBuilder.AppendLine();
			stringBuilder.AppendLine($"Probed {f.probedUtc} from {f.textsSeen} game texts and {f.imagesSeen} images. Every RepoRPG screen uses these values.");
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("| Role | Value |");
			stringBuilder.AppendLine("|---|---|");
			stringBuilder.AppendLine("| Font (TextMeshPro) | " + f.font + " |");
			stringBuilder.AppendLine("| Accent (highlight / selected) | " + f.accent + " |");
			stringBuilder.AppendLine("| Text | " + f.text + " |");
			stringBuilder.AppendLine("| Secondary text | " + f.muted + " |");
			stringBuilder.AppendLine("| Panel | " + f.panel + " |");
			stringBuilder.AppendLine($"| Text shadow | {f.shadow}, offset {f.shadowOffset:0.#}px |");
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("Fonts seen: " + string.Join(", ", f.fonts));
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("Text colours seen: " + string.Join(", ", f.textColors));
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("Panel colours seen: " + string.Join(", ", f.panelColors));
			stringBuilder.AppendLine();
			stringBuilder.AppendLine("Menu sounds: " + string.Join("; ", f.sounds));
			return stringBuilder.ToString();
		}
	}
}
namespace System.Runtime.CompilerServices
{
	[AttributeUsage(AttributeTargets.Assembly, AllowMultiple = true)]
	internal sealed class IgnoresAccessChecksToAttribute : Attribute
	{
		public IgnoresAccessChecksToAttribute(string assemblyName)
		{
		}
	}
}
