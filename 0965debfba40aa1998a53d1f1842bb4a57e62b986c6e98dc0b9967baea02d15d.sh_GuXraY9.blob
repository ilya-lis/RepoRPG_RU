		private static void PresetTexts(HostSettings.PresetInfo p, bool isDef, bool isLoaded)
		{
			string text = p.Name.Replace("<", "‹").Replace(">", "›");
			p.UiDef = isDef;
			p.UiLoaded = isLoaded;
			p.UiTitle = ((!p.Valid) ? ("<b>" + text + "</b>  <color=#ff9999>INVALID</color>") : ("<b>" + text + "</b>" + (isDef ? "  <color=#ffcc66>DEFAULT</color>" : "") + (isLoaded ? "  <color=#8cf2bf>LOADED</color>" : "")));
			p.UiLine2 = (p.Valid ? ("<color=#9a9ca0>Saved " + p.Saved + "  ·  " + p.Detail + "</color>") : ("<color=#ff9999>" + p.Detail.Replace("<", "‹") + "</color><color=#9a9ca0>  ·  saved " + p.Saved + "  ·  only Delete is possible</color>"));
		}

		private void LoadPreset(string name)
		{
			if (CanEditHost)
			{
				int num = HostSettings.Load(name, _hostPending);
				HostSearchDirty();
				if (num < 0)
				{
					PresetNote("Couldn't read preset '" + name + "'", good: false);
					MenuSound(UiSound.Error);
				}
				else
				{
					_loadedPreset = HostSettings.Find(name)?.Name ?? name;
					_presetApplied = _hostPending.Count == 0;
					_stCount = -1;
				}
			}
		}

		private void DoSavePreset(string name)
		{
			if (!CanEditHost)
			{
				return;
			}
			name = HostSettings.CleanName(name);
			if (!HostSettings.Save(name, _hostPending))
			{
				PresetNote("Couldn't save preset '" + name + "' (see the log)", good: false);
				MenuSound(UiSound.Error);
				return;
			}
			if (_presetEdit != PresetEdit.None)
			{
				ClosePresetEdit();
			}
			_presetsOpen = true;
			_loadedPreset = name;
			_presetApplied = _hostPending.Count == 0;
			PresetNote("Saved preset '" + name + "'", good: true);
		}

		private void DoDeletePreset(string name)
		{
			if (!CanEditHost)
			{
				return;
			}
			if (!HostSettings.Delete(name))
			{
				PresetNote("Couldn't delete preset '" + name + "' (see the log)", good: false);
				MenuSound(UiSound.Error);
				return;
			}
			if (string.Equals(_loadedPreset, name, StringComparison.OrdinalIgnoreCase))
			{
				_loadedPreset = "";
			}
			PresetNote("Deleted preset '" + name + "'", good: true);
		}

		private void DoRenamePreset(string from, string to, bool replace)
		{
			if (!CanEditHost)
			{
				return;
			}
			string text = ((!replace) ? null : HostSettings.Find(to)?.Name);
			if (!HostSettings.Rename(from, to, replace))
			{
				PresetNote("Couldn't rename '" + from + "' (see the log)", good: false);
				MenuSound(UiSound.Error);
				return;
			}
			to = HostSettings.CleanName(to);
			if (text != null && string.Equals(_loadedPreset, text, StringComparison.OrdinalIgnoreCase))
			{
