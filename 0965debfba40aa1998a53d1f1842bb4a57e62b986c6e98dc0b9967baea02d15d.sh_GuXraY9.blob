				ResetClassView();
				OpenOnNotice();
				_tabSwitchedAt = -9f;
				ForceCursor();
			}
			else
			{
				_searching = false;
				CancelNumEdit();
				_osk = false;
				_comparePick = null;
				_newThisView.Clear();
				SaveTabMemory();
				Cursor.lockState = _cursorLockBefore;
				Cursor.visible = _cursorVisibleBefore;
			}
		}

