		private static double StepFrom(double v, double step, int dir, double lo, double hi)
		{
			if (step <= 0.0)
			{
				step = 1.0;
			}
			double num = v / step;
			double value = ((dir > 0) ? ((Math.Floor(num + 1E-06) + 1.0) * step) : ((Math.Ceiling(num - 1E-06) - 1.0) * step));
			value = Math.Round(value, 4);
			return Math.Max(lo, Math.Min(hi, value));
		}

		private static string VoteIdFor(string anchor)
		{
			return anchor switch
			{
				"route" => "route", 
				"heat" => "heat", 
				"boon" => "run", 
				"milestone" => "milestone", 
				"drill" => "drill", 
				"sponsor" => "sponsor", 
				"team" => "team", 
				_ => "", 
			};
		}

		private VCard NewCard()
		{
			int count = _vCards.Count;
			while (_vPool.Count <= count)
			{
				_vPool.Add(new VCard());
			}
			VCard vCard = _vPool[count];
			vCard.Id = (vCard.Kind = (vCard.Title = (vCard.Icon = (vCard.Deadline = (vCard.Rules = (vCard.Anchor = (vCard.Anchor2 = "")))))));
			vCard.Opts.Clear();
			vCard.Votes = 0;
			vCard.Voters = 1;
			vCard.By = Array.Empty<int>();
			vCard.Personal = (vCard.Mine = false);
			vCard.Public = Plugin.Cfg.VotesShowWho.Value;
			_vCards.Add(vCard);
			return vCard;
		}

		private VOpt NewOpt(VCard c, string name, string shortLine, string full, bool mine, bool enabled = true, string why = "")
		{
			while (_vOptPool.Count <= _vOptUsed)
			{
				_vOptPool.Add(new VOpt());
			}
			VOpt vOpt = _vOptPool[_vOptUsed++];
			vOpt.Name = name;
			vOpt.Short = shortLine;
			vOpt.Full = full;
			vOpt.Mine = mine;
			vOpt.Chosen = false;
			vOpt.Enabled = enabled;
			vOpt.Why = why;
			c.Opts.Add(vOpt);
			return vOpt;
		}

		private int VoteSig()
		{
			HashCode hashCode = default(HashCode);
			hashCode.Add(RuntimeHelpers.GetHashCode(RunShape.Cur));
			hashCode.Add(RuntimeHelpers.GetHashCode(ResearchCrew.Cur));
			hashCode.Add(RunShape.MyVote);
			hashCode.Add(RunShape.MyRouteVote);
			hashCode.Add(RunShape.MyHeatVote);
			hashCode.Add(ResearchCrew.MyDrillVote);
			hashCode.Add(ResearchCrew.MySponsorVote);
			hashCode.Add(_tcState);
			hashCode.Add(_tcVoted);
			hashCode.Add(_tcLevel);
			hashCode.Add(_tcYesBy.Length);
			hashCode.Add(_tcNoBy.Length);
			hashCode.Add(_tcDef?.id);
			hashCode.Add(Game.InLevel());
			hashCode.Add(Game.Players().Count);
			hashCode.Add(_rsAsked.Count);
			hashCode.Add(RunInfo.LevelIndex);
			hashCode.Add(Plugin.Cfg.VotesShowWho.Value);
			hashCode.Add(Game.ClassSelectionOpen());
			return hashCode.ToHashCode();
		}

