		private void ProvideNotices(List<ActionNotice> into)
		{
			if (!RunReady || !RunUnderWay)
			{
				return;
			}
			ProvideResearchNotices(into);
			RunShape.State cur = RunShape.Cur;
			bool flag = Game.InLevel();
			int total = Mathf.Max(1, Game.Players().Count);
			RunSave data = _store.Data;
			if (Season.On && cur.VoteFor != 0 && Season.IsSeasonVote(cur.VoteFor) && cur.VoteOptions.Length != 0 && RunShape.MyVote < 0 && !flag)
			{
				into.Add(new ActionNotice
				{
					Id = "vote.season",
					Title = "Vote: end the run or go Endless",
					Tab = "Votes",
					Anchor = "boon",
					Kind = NoticeKind.Vote,
					Responded = cur.Votes,
					Total = Mathf.Max(1, cur.Voters)
				});
			}
			else if (cur.VoteFor != 0 && cur.VoteOptions.Length != 0 && RunShape.MyVote < 0 && !flag)
			{
				into.Add(new ActionNotice
				{
					Id = "vote.boon." + cur.VoteFor,
					Title = "Vote on a run boon",
					Tab = "Votes",
					Anchor = "boon",
					Kind = NoticeKind.Vote,
					Responded = cur.Votes,
					Total = Mathf.Max(1, cur.Voters)
				});
			}
			if (Heat.On && cur.HeatFor != 0 && cur.HeatOffer.Length > 1 && RunShape.MyHeatVote < 0 && !flag)
			{
				into.Add(new ActionNotice
				{
					Id = "vote.heat." + cur.HeatFor,
					Title = "Vote on Heat",
					Detail = $"Heat {cur.Heat}: raise it for better rewards, or Skip",
					Tab = "Votes",
					Anchor = "heat",
					Kind = NoticeKind.Vote,
					Responded = cur.HeatVotes,
					Total = total
				});
			}
			if (Routes.On && cur.RouteFor >= 0 && cur.RouteChosen < 0 && cur.RouteOptions.Length > 1 && RunShape.MyRouteVote < 0 && !flag)
			{
				into.Add(new ActionNotice
				{
					Id = "vote.route." + cur.RouteFor,
					Title = "Choose the next level's route",
					Tab = "Votes",
					Anchor = "route",
					Kind = NoticeKind.Vote,
					Responded = cur.RouteVotes,
					Total = total
				});
			}
			if (TeamVoting && !_tcVoted && _tcDef != null)
			{
				into.Add(new ActionNotice
				{
					Id = $"vote.team.{_tcLevel}.{_tcDef.id}",
					Title = "Vote on the team contract",
					Detail = _tcDef.name,
					Tab = "Votes",
					Anchor = "team",
					Kind = NoticeKind.Vote,
					Responded = _tcVotes,
					Total = total,
					EndsAt = (_tcBoardVote ? (-1f) : (Time.unscaledTime + Mathf.Max(0f, _tcVoteEnd - Time.time)))
				});
			}
			if (Current == null)
			{
				into.Add(new ActionNotice
				{
					Id = "class",
					Title = "Choose your class",
					Tab = "Class",
					Anchor = "class",
					Kind = NoticeKind.Choice
				});
			}
			List<int> list = RunShape.MyOwed();
			if (list.Count > 0 && !flag)
			{
				into.Add(new ActionNotice
				{
					Id = "milestone." + list[0],
					Title = ((list.Count > 1) ? $"Choose your milestone rewards ({list.Count})" : "Choose your milestone reward"),
					Tab = "Votes",
					Anchor = "milestone",
					Kind = NoticeKind.Choice
				});
			}
			if (data.rewardQueue.Count > 0)
			{
				into.Add(new ActionNotice
				{
					Id = "reward",
					Title = ((data.rewardQueue.Count > 1) ? $"Choose contract rewards ({data.rewardQueue.Count})" : "Choose a contract reward"),
					Tab = "Contracts",
					Anchor = "reward",
					Kind = NoticeKind.Choice
				});
			}
			if (data.perkPicksPending > 0 && Current != null)
			{
				into.Add(new ActionNotice
				{
					Id = "perk",
					Title = ((data.perkPicksPending > 1) ? $"Pick your perks ({data.perkPicksPending})" : "Pick a perk"),
					Tab = "Perks",
					Anchor = "perk",
					Kind = NoticeKind.Choice
				});
			}
			if (Current != null && CurrentProgress != null)
			{
				int num = Leveling.AvailablePoints(CurrentProgress);
				int num2 = Leveling.AvailableAttributePoints(CurrentProgress, data);
				if (num > 0)
				{
					into.Add(new ActionNotice
					{
						Id = "points.skill",
						Title = string.Format("{0} skill point{1} to spend", num, (num == 1) ? "" : "s"),
						Short = $"{num} SKILL",
						Tab = "Class",
						Anchor = "skill",
						Kind = NoticeKind.Minor
					});
				}
				if (num2 > 0)
				{
					into.Add(new ActionNotice
					{
						Id = "points.attr",
						Title = string.Format("{0} attribute point{1} to spend", num2, (num2 == 1) ? "" : "s"),
						Short = $"{num2} ATTR",
						Tab = "Attributes",
						Anchor = "attr",
						Kind = NoticeKind.Minor
					});
				}
				if (MilestoneSwitchOpen(out var milestone))
				{
					into.Add(new ActionNotice
					{
						Id = "switch." + milestone,
						Title = "Milestone class switch available",
						Short = "SWITCH",
						Tab = "Class",
						Anchor = "switch",
						Kind = NoticeKind.Minor
					});
				}
			}
		}

		private bool MilestoneSwitchOpen(out int milestone)
		{
			milestone = 0;
			if (!Plugin.Cfg.SwitchAtMilestones.Value || !Game.InShopLevel() || RunInfo.LevelIndex <= 0 || !RunShape.IsMilestoneLevel(RunInfo.LevelIndex - 1))
			{
				return false;
			}
			milestone = RunInfo.LevelIndex / RunShape.Every;
			return _store.Data.switchMilestone < milestone;
		}

		private void TickNotices()
		{
			//IL_009d: Unknown result type (might be due to invalid IL or missing references)
			float unscaledTime = Time.unscaledTime;
			if (!_nRegistered)
			{
				_nRegistered = true;
				Notices.Register(ProvideNotices);
			}
			TickNoticeDismiss();
			if (!Notices.Dirty && unscaledTime < _nTickAt)
			{
				return;
			}
			_nTickAt = unscaledTime + 0.5f;
			Notices.Refresh(unscaledTime, _nArrived, _nClosed);
			bool runUnderWay = RunUnderWay;
			if (runUnderWay)
			{
				foreach (ActionNotice item in _nClosed)
				{
					Toast("Vote closed: " + item.Title, new Color(0.78f, 0.78f, 0.82f));
				}
			}
			bool flag = false;
			foreach (ActionNotice item2 in _nArrived)
			{
				if (item2.Important && runUnderWay)
				{
					if (!flag && (_nbFinal || _nbStart >= 0f))
					{
						_nbIds.Clear();
					}
					flag = true;
					if (!_nbIds.Contains(item2.Id))
					{
						_nbIds.Add(item2.Id);
					}
				}
			}
			if (flag)
			{
				_nbStart = -1f;
				_nbFinal = false;
				_nbBuilt = -1;
			}
			foreach (ActionNotice item3 in Notices.Active)
			{
				if (!item3.IsVote || item3.EndsAt <= 0f || item3.FinalReminded || item3.EndsAt - unscaledTime > 10.5f || unscaledTime - item3.Since < 3f)
				{
					continue;
				}
				item3.FinalReminded = true;
				if (Plugin.Cfg.NoticeFinalReminder.Value)
				{
					if (_nDismissed.Remove(item3.Id))
					{
						_nRecalled.Add(item3.Id);
						Plugin.Log.LogInfo((object)("[notices] " + item3.Id + ": dismissed, back for its last seconds."));
					}
					_nbIds.Clear();
					_nbIds.Add(item3.Id);
					_nbStart = -1f;
					_nbFinal = true;
					_nbBuilt = -1;
				}
			}
			if (_nDismissed.Count > 0)
			{
				_nDismissed.RemoveWhere((string id) => !id.Contains("@") && NoticeById(id) == null);
			}
			if (_nArrived.Count > 0 || _nClosed.Count > 0)
			{
				Plugin.Log.LogInfo((object)($"[notices] {Notices.Active.Count} waiting ({Notices.ImportantCount} important)" + ((_nArrived.Count > 0) ? ("; new: " + string.Join(", ", _nArrived.ConvertAll((ActionNotice x) => x.Id))) : "") + ((_nClosed.Count > 0) ? ("; closed: " + string.Join(", ", _nClosed.ConvertAll((ActionNotice x) => x.Id))) : "")));
			}
		}

		private static ActionNotice? NoticeById(string id)
		{
			foreach (ActionNotice item in Notices.Active)
			{
				if (item.Id == id)
				{
					return item;
				}
			}
			return null;
		}

		private int NoticeContext()
		{
			//IL_0060: Unknown result type (might be due to invalid IL or missing references)
			//IL_0066: Invalid comparison between Unknown and I4
			if (!Plugin.Cfg.ShowHud.Value || _menuOpen || _transitioning || !RunUnderWay || Game.InLobbyMenu())
			{
				return 0;
			}
			if ((Object)(object)Game.LocalPlayer() == (Object)null)
			{
				return 0;
			}
			if (Game.InLevel())
			{
				if (Game.IsLoading())
				{
					return 0;
				}
				try
				{
					GameDirector instance = GameDirector.instance;
					if ((Object)(object)instance != (Object)null && (int)instance.currentState != 2)
					{
						return 0;
					}
				}
				catch
				{
				}
				if (LocalDown())
				{
					return ((Object)(object)SpectateCamera.instance != (Object)null) ? 1 : 0;
				}
			}
			return 2;
		}

		private string NoticeWhere(ActionNotice n)
		{
			return "Open [" + MenuPrompt + "] RepoRPG → " + TabPath(n.Tab);
		}

		private static string Countdown(ActionNotice n)
		{
			List<string> list = new List<string>(2);
			if (n.Total > 0 && n.Responded >= 0)
			{
				list.Add($"{Mathf.Min(n.Responded, n.Total)}/{n.Total} voted");
			}
			if (n.EndsAt > 0f)
			{
				list.Add($"{Mathf.Max(0, Mathf.CeilToInt(n.EndsAt - Time.unscaledTime))}s left");
			}
			return string.Join(" · ", list);
		}

		private static Color NoticeColor(ActionNotice n)
		{
			//IL_001e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0018: Unknown result type (might be due to invalid IL or missing references)
			//IL_0012: Unknown result type (might be due to invalid IL or missing references)
			if (n.Kind != NoticeKind.Vote)
			{
				if (n.Kind != NoticeKind.Choice)
				{
					return NoticeMinorCol;
				}
				return NoticeChoiceCol;
			}
			return NoticeVoteCol;
		}

		private static string NoticeMark(ActionNotice n)
		{
			if (n.Kind != NoticeKind.Vote)
			{
				if (n.Kind != NoticeKind.Choice)
				{
					return "·";
				}
				return "•";
			}
			return "!";
		}

		private float DrawNotices(float vw, float vh)
