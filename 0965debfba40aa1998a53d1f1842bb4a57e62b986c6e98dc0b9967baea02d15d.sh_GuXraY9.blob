		private void StartPresetTyping()
		{
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			CancelNumEdit();
			_searching = true;
			_presetTyping = true;
			_searchEnd = (KeyCode)0;
		}

		private void ClosePresetEdit()
		{
			if (_presetTyping)
			{
				_searching = false;
			}
			_presetTyping = false;
			_presetEdit = PresetEdit.None;
			_presetName = "";
