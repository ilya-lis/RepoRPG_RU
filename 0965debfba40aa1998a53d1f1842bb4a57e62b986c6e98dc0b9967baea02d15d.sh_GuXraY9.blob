		public static GameObject? SpawnValuable(Vector3 at, params string[] lists)
		{
			//IL_0109: Unknown result type (might be due to invalid IL or missing references)
			//IL_010a: Unknown result type (might be due to invalid IL or missing references)
			//IL_00dc: Unknown result type (might be due to invalid IL or missing references)
			//IL_00dd: Unknown result type (might be due to invalid IL or missing references)
			ValuableDirector instance = ValuableDirector.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return null;
			}
			List<object> list = new List<object>();
			foreach (string name in lists)
			{
				if (!(Game.Get<object>(instance, name, null) is IList list2))
				{
					continue;
				}
				foreach (object item in list2)
				{
					if (item != null)
					{
						list.Add(item);
					}
				}
			}
			if (list.Count == 0)
			{
				Game.WarnOnce("Research: this level has no valuables to spawn from.");
				return null;
			}
			object o = list[Random.Range(0, list.Count)];
			try
			{
				if (Game.IsMultiplayer())
				{
					string text = Prop<string>(o, "ResourcePath") ?? "";
					return (text != "") ? PhotonNetwork.InstantiateRoomObject(text, at, Quaternion.identity, (byte)0, (object[])null) : null;
				}
				GameObject val = Prop<GameObject>(o, "Prefab");
				return ((Object)(object)val != (Object)null) ? Object.Instantiate<GameObject>(val, at, Quaternion.identity) : null;
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Research: couldn't spawn a valuable (" + ex.GetBaseException().Message + ").");
				return null;
			}
		}

		private static T? Prop<T>(object o, string name) where T : class
		{
			Type type = o.GetType();
			PropertyInfo property = type.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
			if (property != null)
			{
				return property.GetValue(o) as T;
			}
			return AccessTools.Field(type, name)?.GetValue(o) as T;
		}

		public static void ApplyHostLocal()
		{
			//IL_00a9: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ae: Unknown result type (might be due to invalid IL or missing references)
