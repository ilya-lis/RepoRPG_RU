		private void TickThirdWave(PlayerAvatar local, string id)
		{
			switch (id)
			{
			case "ventriloquist":
				TickVentriloquist(local);
				break;
			case "scavenger":
				TickRummage(local);
				break;
			case "grappler":
				TickPull(local);
				TickGrappler(local, (Current != null) ? (Current.active.radius * (1f + (_stats[Stat.ActiveArea] + _stats.Custom(Current.active.mods.area)) / 100f)) : 18f, copied: false);
				break;
			}
			if (id == "courier" || id == "instigator")
			{
				TickCourierInstigator(local, id);
			}
			if (id != "scavenger" && _rummageEnd > 0f)
			{
				_rummageEnd = 0f;
			}
			if (_pull != null && id != "grappler" && id != "mimic")
			{
				EndPull("class changed");
			}
			if (_pull != null && id == "mimic")
			{
				TickPull(local);
			}
		}

		private void ApplyThirdWaveExtras(string id)
		{
			switch (id)
			{
			case "ventriloquist":
				_stats.AddPerm(Stat.NoiseReduction, ClassStat("ventriloquist.quiet"));
				break;
			case "restorer":
				_stats.AddPerm(Stat.HoldingStaminaDrain, 0f - ClassStat("restorer.easy_carry"));
				break;
			case "lookout":
				_stats.AddPerm(Stat.DamageTaken, 0f - ClassStat("lookout.cover"));
				break;
			case "shepherd":
				_stats.AddPerm(Stat.WeaponDamage, ClassStat("shepherd.defend"));
				break;
			case "grappler":
				_stats.AddPerm(Stat.MaxHealth, ClassStat("grappler.sturdy"));
				break;
			}
		}

		private void ThirdWaveReset()
		{
			if (_pull != null)
			{
				EndPull("left the level / menu");
			}
			HookFx.Clear();
			_rummageEnd = 0f;
			_pings.Clear();
			_threats.Clear();
			_voiceThrown = false;
			_hookAim = HookAim.None;
			_hookChain = 0;
			_reachTarget = false;
			ThirdWaveFx.Clear();
			NewClassesReset();
		}

