	internal static class Season
	{
		public static SeasonFile Data = new SeasonFile();

		public const int VoteId = 9000;

		public const string OptEnd = "season:end";

		public const string OptEndless = "season:endless";

		public const string OptAscend = "season:ascend";

		private static int _phaseLevel = -1;

		private static ModConfig C => Plugin.Cfg;

		public static bool On
		{
			get
			{
				if (C.SeasonOn.Value)
				{
					return C.MilestonesOn.Value;
				}
				return false;
			}
		}

		public static int LevelsPerChapter => C.SeasonLength.Value switch
		{
			RunLength.Short => 5, 
			RunLength.Standard => 5, 
			RunLength.Marathon => 7, 
			_ => Mathf.Clamp(C.MilestoneEvery.Value, 2, 20), 
		};

		public static int Chapters => C.SeasonLength.Value switch
		{
			RunLength.Short => 5, 
			RunLength.Standard => 10, 
			RunLength.Marathon => 10, 
			_ => Mathf.Clamp(C.SeasonChapters.Value, 3, 20), 
		};

		public static int Levels => Chapters * LevelsPerChapter;

		public static bool Won => RunShape.Cur.SeasonWon;

		public static bool Endless => RunShape.Cur.Endless;

		public static float UnlockStretch
		{
			get
			{
				if (!On)
				{
					return 1f;
				}
				return Mathf.Max(1f, (float)Levels / 25f);
			}
		}

		public static float FinaleHealth => Mathf.Clamp(Data.finale.healthMult, 1f, 5f);

		public static int FinaleMods => Mathf.Clamp(Data.finale.extraModifiers, 0, 3);

		public static void Load()
		{
			try
			{
				Data = Json.Deserialize<SeasonFile>(ClassDatabase.ReadWithOverride("season", ClassDatabase.ReadEmbedded("season"))) ?? new SeasonFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("season data parse error: " + ex.Message));
				Data = new SeasonFile();
			}
			SeasonFile data = Data;
			if (data.chapters == null)
			{
				data.chapters = Array.Empty<SeasonChapterDef>();
			}
			data = Data;
			if (data.endless == null)
			{
				data.endless = new SeasonChapterDef
				{
					name = "Endless"
				};
			}
			data = Data;
			if (data.finale == null)
			{
				data.finale = new SeasonFinaleDef();
			}
		}

		public static bool IsFinaleLevel(int levelIndex)
		{
			if (On && !Won)
			{
				return levelIndex == Levels - 1;
			}
			return false;
		}

		public static int ChaptersPast(int levelIndex)
		{
			if (!On || !Won)
			{
				return 0;
			}
			return Mathf.Max(0, RunShape.ChapterAt(levelIndex) - Chapters);
		}

		public static string ChapterName(int chapter)
		{
			if (On && chapter > Chapters)
			{
				if (!(Data.endless.name != ""))
				{
					return "Endless";
				}
				return Data.endless.name;
			}
			SeasonChapterDef[] chapters = Data.chapters;
			if (chapters.Length == 0)
			{
				return "";
			}
			return chapters[Mathf.Clamp(chapter - 1, 0, chapters.Length - 1)].name;
		}

		public static string ChapterFlavor(int chapter)
		{
			if (On && chapter > Chapters)
			{
				return Data.endless.flavor;
			}
			SeasonChapterDef[] chapters = Data.chapters;
			if (chapters.Length != 0)
			{
				return chapters[Mathf.Clamp(chapter - 1, 0, chapters.Length - 1)].flavor;
			}
			return "";
		}

		public static string ChapterLabel(int chapter)
		{
			if (!On)
			{
				return "";
			}
			if (chapter > Chapters)
			{
				return $"Endless {chapter - Chapters}";
			}
			return $"Chapter {chapter}/{Chapters}";
		}

		public static float EndlessThreatCap(int levelIndex)
		{
			return (float)ChaptersPast(levelIndex) * Mathf.Clamp(Data.endlessThreatPerChapter, 0f, 5f);
		}

		public static int EndlessBossMods(int levelIndex)
		{
			return ChaptersPast(levelIndex) * Mathf.Clamp(Data.endlessBossModsPerChapter, 0, 3);
		}

		public static void NewLevel()
		{
			_phaseLevel = -1;
		}

		public static void HostTick()
		{
			//IL_014f: Unknown result type (might be due to invalid IL or missing references)
			//IL_015a: Unknown result type (might be due to invalid IL or missing references)
			//IL_015f: Unknown result type (might be due to invalid IL or missing references)
			//IL_0164: Unknown result type (might be due to invalid IL or missing references)
			//IL_024e: Unknown result type (might be due to invalid IL or missing references)
			if (!Game.IsMaster() || !IsFinaleLevel(RunInfo.LevelIndex) || _phaseLevel == RunInfo.LevelIndex)
			{
				return;
			}
			EnemyHealth val = null;
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				EnemyHealth current = enumerator.Current;
				if (Elites.TryGet(current, out var info) && info.Tier >= 3)
				{
					val = current;
					break;
				}
			}
			if ((Object)(object)val == (Object)null)
			{
				return;
			}
			int num = Game.Get(val, "health", 0);
			int num2 = Game.Get(val, "healthCurrent", 0);
			if (num <= 0 || (float)num2 > (float)num * Mathf.Clamp(Data.finale.secondPhaseAt, 0.1f, 0.9f))
			{
				return;
			}
			_phaseLevel = RunInfo.LevelIndex;
			try
			{
				int viewId = Elites.ViewId((Component)(object)val);
				if (Elites.TryGet(viewId, out var info2) && (info2.Mods & EliteMod.Enraged) == 0)
				{
					Elites.Set(viewId, info2.Mods | EliteMod.Enraged, info2.Tier);
					Net.BroadcastElite(viewId, info2.Mods | EliteMod.Enraged, info2.Tier);
				}
				EnemyHealth val2 = null;
				float num3 = float.MaxValue;
				enumerator = Game.LivingEnemies().GetEnumerator();
				while (enumerator.MoveNext())
				{
					EnemyHealth current2 = enumerator.Current;
					if (!((Object)(object)current2 == (Object)(object)val) && !Elites.TryGet(current2, out var _) && !BossGraveyard.IsRetired(current2))
					{
						Vector3 val3 = ((Component)current2).transform.position - ((Component)val).transform.position;
						float sqrMagnitude = ((Vector3)(ref val3)).sqrMagnitude;
						if (sqrMagnitude < num3)
						{
							num3 = sqrMagnitude;
							val2 = current2;
						}
					}
				}
				string text = "";
				if ((Object)(object)val2 != (Object)null)
				{
					Random random = new Random(RunInfo.Seed ^ (RunInfo.LevelIndex * 7919));
					EliteMod eliteMod = EliteMod.None;
					List<EliteMod> list = new List<EliteMod>(Elites.ModList);
					for (int i = 0; i < Mathf.Clamp(Data.finale.escortModifiers, 1, 3); i++)
					{
						if (list.Count <= 0)
						{
							break;
						}
						int index = random.Next(list.Count);
						eliteMod |= list[index];
						list.RemoveAt(index);
					}
					int num4 = Elites.ViewId((Component)(object)val2);
					Elites.Set(num4, eliteMod, 2);
					Net.BroadcastElite(num4, eliteMod, 2);
					HostDirector.Instance?.TrackElite(val2, num4);
					ClassHost.Investigate(((Component)val).transform.position, 40f);
					text = ClassHost.EnemyName((Component)(object)val2);
				}
				Plugin.Log.LogInfo((object)("[season] finale second phase: " + Bosses.NameFor(viewId) + " enraged" + ((text != "") ? (", " + text + " joins as an elite escort") : "") + "."));
				RunShape.HostNote("finale2|FINALE - SECOND PHASE: " + Bosses.NameFor(viewId) + " is enraged" + ((text != "") ? (" and calls " + text + " to its side!") : "!"));
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[season] finale second phase failed: " + ex.GetBaseException().Message));
			}
		}

		public static bool IsSeasonVote(int voteFor)
		{
			return voteFor == 9000;
		}

		public static string OptionName(string id)
		{
			return id switch
			{
				"season:ascend" => $"Ascend (Ascension {Ascension.Level + 1})", 
				"season:endless" => "Keep going (Endless)", 
				"season:end" => "End the run", 
				_ => id, 
			};
		}

		public static string OptionText(string id)
		{
			if (!(id == "season:ascend"))
			{
				if (!(id == "season:end"))
				{
					return "<b>Keep going: Endless.</b> Chapters keep coming. Each one past the last raises the threat cap and gives bosses another modifier. How deep can the team go?";
				}
				return "<b>End the run.</b> It's complete: the win is on everyone's record, and everyone goes back to the main menu. (The save stays; loading it again carries on as Endless.)";
			}
			return $"<b>Ascend.</b> The run is complete as a win, and the next run starts at Ascension {Ascension.Level + 1}: one more modifier on top of the ones you have, and better rewards. Everyone goes back to the main menu; start the next run from there.";
		}
	}
	internal static class SettingsSync
	{
		public sealed class Change
		{
			public ConfigEntryBase Entry;

			public object Old;

			public object New;
		}

		private static readonly HashSet<string> Sections = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
		{
			"Leveling", "XP Sources", "Rules", "Healing", "RPG", "Perks", "Shop", "Currency", "Classes", "Team",
			"Bosses", "Loot", "TeamContracts", "Contracts", "LateJoin", "Players", "Scaling", "Threat", "Account", "Difficulty",
			"Attributes", "Valuables", "Milestones", "Streaks", "Season", "Routes", "Heat", "Boons", "Crew", "Unlocks",
			"Market", "Research", "Ascension", "Elements", "Starters"
		};

		private static Dictionary<string, string>? _applied;

		private static readonly HashSet<string> LocalOnly = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Elements/Vfx" };

		private static int _clientVersion = -1;

		public static readonly List<string> LastChanges = new List<string>();

		public static bool Record;

		private static bool _replaying;

		public static readonly List<List<Change>> History = new List<List<Change>>();

		public static bool Overridden => _applied != null;

		public static bool Applying { get; private set; }

		private static ConfigFile Cfg => ((BaseUnityPlugin)Plugin.Instance).Config;

		public static int Version { get; private set; } = 1;

		public static bool VersionBlocked { get; private set; }

		public static string HostModVersion { get; private set; } = "";

		public static bool Unsaved => History.Count > 0;

		public static bool IsSynced(ConfigDefinition d)
		{
			if (Sections.Contains(d.Section))
			{
				return !LocalOnly.Contains(d.Section + "/" + d.Key);
			}
			return false;
		}

		private static string KeyOf(ConfigDefinition d)
		{
			return d.Section + "/" + d.Key;
		}

		public static void Snapshot(out string[] keys, out string[] values)
		{
			List<string> list = new List<string>();
			List<string> list2 = new List<string>();
			foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in Cfg)
			{
				if (IsSynced(item.Key))
				{
					list.Add(KeyOf(item.Key));
					list2.Add(item.Value.GetSerializedValue());
				}
			}
			keys = list.ToArray();
			values = list2.ToArray();
		}

		public static void BlockForVersion(string what)
		{
			if (!VersionBlocked && !Game.IsMaster())
			{
				VersionBlocked = true;
				HostModVersion = what;
				RpgRuntime.Instance?.OnVersionMismatch(what);
			}
		}

		public static bool IsOlder(string v)
		{
			if (v.StartsWith("an older"))
			{
				return true;
			}
			if (System.Version.TryParse(v, out Version result) && System.Version.TryParse("1.0.100", out Version result2))
			{
				return result < result2;
			}
			return false;
		}

		public static bool IsSyncedKey(string key)
		{
			if (Sections.Contains(key.Split('/')[0]))
			{
				return !LocalOnly.Contains(key);
			}
			return false;
		}

		public static void ApplyFromHost(string[] keys, string[] values, int version = 0, string modVersion = "")
		{
			if (Game.IsMaster())
			{
				return;
			}
			if (modVersion != "" && modVersion != "1.0.100")
			{
				HostModVersion = modVersion;
				if (!VersionBlocked)
				{
					VersionBlocked = true;
					Plugin.Log.LogWarning((object)("[settings] the host runs RepoRPG " + modVersion + ", you run 1.0.100: the mod is paused in this lobby."));
					RpgRuntime.Instance?.OnVersionMismatch(modVersion);
				}
				Net.SendSettingsAck(version, "1.0.100");
			}
			else
			{
				if (version > 0 && version < _clientVersion)
				{
					return;
				}
				Dictionary<string, string> dictionary = new Dictionary<string, string>();
				for (int i = 0; i < keys.Length && i < values.Length; i++)
				{
					if (keys[i] != null && values[i] != null && IsSyncedKey(keys[i]))
					{
						dictionary[keys[i]] = values[i];
					}
				}
				bool flag = _applied == null;
				LastChanges.Clear();
				if (!flag)
				{
					foreach (KeyValuePair<string, string> item in dictionary)
					{
						if (!_applied.TryGetValue(item.Key, out string value) || value != item.Value)
						{
							LastChanges.Add(item.Key + ": " + (value ?? "?") + " -> " + item.Value);
						}
					}
				}
				ApplyMap(dictionary);
				_applied = dictionary;
				_clientVersion = Mathf.Max(_clientVersion, version);
				if (flag)
				{
					Plugin.Log.LogInfo((object)$"Using the host's balance settings ({dictionary.Count} values, version {version}).");
				}
				Net.SendSettingsAck(version, "1.0.100");
				RpgRuntime.Instance?.OnSettingsChanged();
				if (!flag && LastChanges.Count > 0)
				{
					RpgRuntime.Instance?.OnHostSettingsUpdated(LastChanges.Count);
				}
			}
		}

		public static void HostApply(Dictionary<ConfigEntryBase, object> changes)
		{
			if (!Game.IsMaster() && Game.IsMultiplayer())
			{
				return;
			}
			Cfg.SaveOnConfigSet = true;
			LastChanges.Clear();
			foreach (KeyValuePair<ConfigEntryBase, object> change in changes)
			{
				try
				{
					string serializedValue = change.Key.GetSerializedValue();
					change.Key.BoxedValue = change.Value;
					if (!Valid(change.Key))
					{
						change.Key.BoxedValue = change.Key.DefaultValue;
					}
					LastChanges.Add(KeyOf(change.Key.Definition) + ": " + serializedValue + " -> " + change.Key.GetSerializedValue());
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("[settings] " + KeyOf(change.Key.Definition) + " not changed: " + ex.Message));
				}
			}
			Version++;
			Plugin.Log.LogInfo((object)$"[settings] host applied {changes.Count} change(s), version {Version}.");
			Net.BroadcastSettings();
			RpgRuntime.Instance?.OnSettingsChanged();
		}

		private static bool Valid(ConfigEntryBase e)
		{
			try
			{
				ConfigDescription description = e.Description;
				AcceptableValueBase val = ((description != null) ? description.AcceptableValues : null);
				return val == null || val.IsValid(e.BoxedValue);
			}
			catch
			{
				return true;
			}
		}

		private static void ApplyMap(Dictionary<string, string> map)
		{
			Applying = true;
			try
			{
				Cfg.SaveOnConfigSet = false;
				foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in Cfg)
				{
					if (!map.TryGetValue(KeyOf(item.Key), out string value))
					{
						continue;
					}
					try
					{
						item.Value.SetSerializedValue(value);
						if (!Valid(item.Value))
						{
							Plugin.Log.LogWarning((object)("[settings] host value for " + KeyOf(item.Key) + " (" + value + ") is out of range: using the default."));
							item.Value.BoxedValue = item.Value.DefaultValue;
						}
					}
					catch (Exception ex)
					{
						Plugin.Log.LogWarning((object)("Host setting " + KeyOf(item.Key) + " ignored (" + ex.Message + "): using the default."));
						try
						{
							item.Value.BoxedValue = item.Value.DefaultValue;
						}
						catch
						{
						}
					}
				}
			}
			finally
			{
				Applying = false;
			}
		}

		public static void RestoreLocal()
		{
			PlayerScaling.Reset();
			_clientVersion = -1;
			VersionBlocked = false;
			HostModVersion = "";
			if (_applied == null)
			{
				return;
			}
			_applied = null;
			Applying = true;
			try
			{
				Cfg.Reload();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("Config reload failed: " + ex.Message));
			}
			finally
			{
				Applying = false;
			}
			Cfg.SaveOnConfigSet = true;
			Plugin.Log.LogInfo((object)"Back to your own balance settings.");
			RpgRuntime.Instance?.OnSettingsChanged();
		}

		private static void RunRecorded(Action change)
		{
			if (!Record || _replaying)
			{
				change();
				return;
			}
			Dictionary<ConfigEntryBase, object> dictionary = new Dictionary<ConfigEntryBase, object>();
			foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item in Cfg)
			{
				dictionary[item.Value] = item.Value.BoxedValue;
			}
			change();
			List<Change> list = new List<Change>();
			foreach (KeyValuePair<ConfigDefinition, ConfigEntryBase> item2 in Cfg)
			{
				ConfigEntryBase value = item2.Value;
				if (dictionary.TryGetValue(value, out var value2) && !object.Equals(value2, value.BoxedValue))
				{
					list.Add(new Change
					{
						Entry = value,
						Old = value2,
						New = value.BoxedValue
					});
				}
			}
			if (list.Count > 0)
			{
				History.Add(list);
			}
		}

		public static object? OriginalOf(ConfigEntryBase e)
		{
			foreach (List<Change> item in History)
			{
				foreach (Change item2 in item)
				{
					if (item2.Entry == e)
					{
						return item2.Old;
					}
				}
			}
			return null;
		}

		public static int UnsavedCount()
		{
			HashSet<ConfigEntryBase> hashSet = new HashSet<ConfigEntryBase>();
			foreach (List<Change> item in History)
			{
				foreach (Change item2 in item)
				{
					if (!object.Equals(OriginalOf(item2.Entry), item2.Entry.BoxedValue))
					{
						hashSet.Add(item2.Entry);
					}
				}
			}
			return hashSet.Count;
		}

		public static void UndoLast()
		{
			if (History.Count == 0)
			{
				return;
			}
			List<Change> batch = History[History.Count - 1];
			History.RemoveAt(History.Count - 1);
			_replaying = true;
			try
			{
				SaveLocalChange(delegate
				{
					for (int num = batch.Count - 1; num >= 0; num--)
					{
						batch[num].Entry.BoxedValue = batch[num].Old;
					}
				});
			}
			finally
			{
				_replaying = false;
			}
		}

		public static void UndoAll()
		{
			while (History.Count > 0)
			{
				UndoLast();
			}
		}

		public static void SaveAll()
		{
			History.Clear();
		}

		public static void SaveLocalChange(Action change)
		{
			Action given = change;
			change = delegate
			{
				RunRecorded(given);
			};
			if (_applied == null)
			{
				change();
				return;
			}
			Dictionary<string, string> applied = _applied;
			Applying = true;
			try
			{
				Cfg.Reload();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("Couldn't save your setting right now: " + ex.Message));
				Applying = false;
				ApplyMap(applied);
				return;
			}
			finally
			{
				Applying = false;
			}
			try
			{
				Cfg.SaveOnConfigSet = true;
				change();
			}
			finally
			{
				ApplyMap(applied);
			}
		}
	}
	internal static class Shop
	{
		private const float MaxClassDiscount = 45f;

		private static readonly Dictionary<int, float> ReportedDiscount = new Dictionary<int, float>();

		private static readonly Dictionary<int, float> LastPurchase = new Dictionary<int, float>();

		private static readonly Dictionary<int, (int level, int n)> PerkRerolls = new Dictionary<int, (int, int)>();

		public static bool OpenNow
		{
			get
			{
				if (Difficulty.NoShop)
				{
					return false;
				}
				if (Plugin.Cfg.ShopAnywhere.Value)
				{
					return true;
				}
				try
				{
					return SemiFunc.RunIsShop();
				}
				catch
				{
					return false;
				}
			}
		}

		public static int Price(int baseK)
		{
			if (baseK <= 0)
			{
				return 0;
			}
			float num = Mathf.Clamp(RpgRuntime.Instance?.StatValue(Stat.ShopDiscount) ?? 0f, 0f, MaxLegitDiscount());
			float num2 = Mathf.Clamp(RpgRuntime.Instance?.ClassStat("quartermaster.discount") ?? 0f, 0f, 45f);
			float num3 = Mathf.Clamp(num + num2, 0f, 80f);
			float num4 = 1f + 0.25f * Mathf.Clamp01(RpgRuntime.Instance?.Curse("greed") ?? 0f);
			return Mathf.Max(1, Mathf.RoundToInt((float)baseK * (1f - num3 / 100f) * num4));
		}

		public static int GetCurrency()
		{
			try
			{
				MethodInfo methodInfo = Game.Method(typeof(SemiFunc), "StatGetRunCurrency");
				if (methodInfo != null && methodInfo.GetParameters().Length == 0)
				{
					object obj = methodInfo.Invoke(null, null);
					if (obj is int)
					{
						return (int)obj;
					}
				}
			}
			catch
			{
			}
			IDictionary dictionary = RunStats();
			if (dictionary != null && dictionary.Contains("currency"))
			{
				object obj = dictionary["currency"];
				if (obj is int)
				{
					return (int)obj;
				}
			}
			return -1;
		}

		private static void SetCurrency(int value)
		{
			bool flag = false;
			try
			{
				MethodInfo methodInfo = Game.Method(typeof(SemiFunc), "StatSetRunCurrency");
				if (methodInfo != null && methodInfo.GetParameters().Length == 1)
				{
					methodInfo.Invoke(null, new object[1] { value });
					flag = true;
				}
			}
			catch
			{
			}
			if (!flag)
			{
				IDictionary dictionary = RunStats();
				if (dictionary != null)
				{
					dictionary["currency"] = value;
				}
			}
			try
			{
				Type type = AccessTools.TypeByName("PunManager");
				object obj2 = ((type == null) ? null : AccessTools.Field(type, "instance")?.GetValue(null));
				MethodInfo methodInfo2 = ((type == null) ? null : AccessTools.Method(type, "SetRunStatSet", new Type[2]
				{
					typeof(string),
					typeof(int)
				}, (Type[])null));
				if (obj2 != null && methodInfo2 != null && Game.IsMultiplayer())
				{
					methodInfo2.Invoke(obj2, new object[2] { "currency", value });
				}
			}
			catch
			{
			}
		}

		private static IDictionary? RunStats()
		{
			try
			{
				return ((Object)(object)StatsManager.instance == (Object)null) ? null : Game.Get<IDictionary>(StatsManager.instance, "runStats", null);
			}
			catch
			{
				return null;
			}
		}

		public static int HostBasePrice(string key)
		{
			ModConfig cfg = Plugin.Cfg;
			switch (key)
			{
			case "crate":
				if (!cfg.ShopCrates.Value)
				{
					return -1;
				}
				return ShopX.CratePrice(premium: false);
			case "premium":
				if (!cfg.ShopCrates.Value)
				{
					return -1;
				}
				return ShopX.CratePrice(premium: true);
			case "reroll":
				return cfg.PriceGearReroll.Value;
			case "upgrade":
				return cfg.PriceGearUpgrade.Value;
			case "perkreroll":
				return cfg.PricePerkReroll.Value;
			case "respec":
				return cfg.PriceRespec.Value;
			case "moduleremove":
				return cfg.ModuleRemoveCost.Value;
			default:
				return ShopX.BasePrice(key);
			}
		}

		public static float MaxLegitDiscount()
		{
			float num = 0f;
			RpgData rpg = Plugin.Rpg;
			PerkDef[] perks = rpg.perks;
			foreach (PerkDef perkDef in perks)
			{
				num += SumDiscount(perkDef.effects);
			}
			UniqueDef[] uniques = rpg.uniques;
			foreach (UniqueDef uniqueDef in uniques)
			{
				num += SumDiscount(uniqueDef.effects);
			}
			return Mathf.Clamp(num, 0f, 80f);
		}

		private static float SumDiscount(EffectDef[] effects)
		{
			float num = 0f;
			foreach (EffectDef effectDef in effects)
			{
				if (effectDef.StatIndex == 42 && effectDef.value > 0f)
				{
					num += effectDef.value;
				}
			}
			return num;
		}

		public static void HostSetReportedPerks(int actor, string[] perkIds)
		{
			float num = 0f;
			foreach (string id in perkIds)
			{
				PerkDef perkDef = Plugin.Rpg.Perk(id);
				if (perkDef != null)
				{
					num += SumDiscount(perkDef.effects);
				}
			}
			ReportedDiscount[actor] = Mathf.Min(num, MaxLegitDiscount());
		}

		public static int HostPerkRerolls(int actor)
		{
			if (!PerkRerolls.TryGetValue(actor, out (int, int) value) || value.Item1 != RunInfo.LevelIndex)
			{
				return 0;
			}
			return value.Item2;
		}

		public static void HostNoteReroll(int actor)
		{
			PerkRerolls[actor] = (RunInfo.LevelIndex, HostPerkRerolls(actor) + 1);
		}

		public static void HostForget(int actor)
		{
			PerkRerolls.Remove(actor);
			ReportedDiscount.Remove(actor);
			LastPurchase.Remove(actor);
		}

		public static int HostPriceFor(int actor, int basePrice, bool isLocal)
		{
			float num = (isLocal ? Mathf.Clamp(RpgRuntime.Instance?.StatValue(Stat.ShopDiscount) ?? 0f, 0f, MaxLegitDiscount()) : (ReportedDiscount.TryGetValue(actor, out var value) ? value : 0f));
			float value2 = 0f;
			if (isLocal)
			{
				value2 = RpgRuntime.Instance?.ClassStat("quartermaster.discount") ?? 0f;
			}
			else
			{
				ClassStats.Entry entry = ClassStats.Of(actor);
				if (entry != null && entry.ClassId == "quartermaster")
				{
					entry.Stats.TryGetValue("quartermaster.discount", out value2);
				}
			}
			num = Mathf.Clamp(num + Mathf.Clamp(value2, 0f, 45f), 0f, 80f);
			float value3 = 0f;
			if (isLocal)
			{
				value3 = RpgRuntime.Instance?.Curse("greed") ?? 0f;
			}
			else
			{
				ClassStats.Of(actor)?.Stats.TryGetValue("gear.cursed.greed", out value3);
			}
			return Mathf.Max(1, Mathf.RoundToInt((float)basePrice * (1f - num / 100f) * (1f + 0.25f * Mathf.Clamp01(value3))));
		}

		public static bool HostRateOk(int actor)
		{
			float unscaledTime = Time.unscaledTime;
			if (LastPurchase.TryGetValue(actor, out var value) && unscaledTime - value < 0.4f)
			{
				return false;
			}
			LastPurchase[actor] = unscaledTime;
			return true;
		}

		public static bool DebugAdd(int amountK)
		{
			if (!Game.IsMaster())
			{
				return false;
			}
			int currency = GetCurrency();
			if (currency < 0)
			{
				return false;
			}
			Scrap.Suppress = true;
			try
			{
				SetCurrency(currency + amountK);
			}
			finally
			{
				Scrap.Suppress = false;
			}
			Scrap.ResetBaseline();
			return true;
		}
	}
