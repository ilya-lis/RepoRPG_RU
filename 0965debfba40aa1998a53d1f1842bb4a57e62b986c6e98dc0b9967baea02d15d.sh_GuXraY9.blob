		public static void HostContractPaid(PlayerAvatar p, string id, int tier)
		{
			try
			{
				if (!Game.IsMaster() || !Research.On || !Research.Lobby("archivist"))
				{
					return;
				}
				ContractDef contractDef = ContractBoard.Get(id);
				if (contractDef != null && !(contractDef.giver != "archivist"))
				{
					float num = Mathf.Round((float)ArchivistBase[Mathf.Clamp(tier, 0, 2)] * Research.DataMult());
					if (num > 0f)
					{
						Net.SendResearchData(p, num, "The Archivist");
					}
				}
			}
			catch (Exception ex)
			{
				Plugin.Log.LogWarning((object)("[research] archivist payout failed: " + ex.Message));
			}
		}

