		internal static int[] Ballots(object? o)
		{
			if (!(o is int[] array) || array.Length % 2 != 0 || array.Length > 128)
			{
				return Array.Empty<int>();
			}
			for (int i = 1; i < array.Length; i += 2)
			{
				if (array[i] < -1 || array[i] > 8)
				{
					return Array.Empty<int>();
				}
			}
			return array;
		}

		private static string[] Strs(object? o, int max, int len)
		{
			if (!(o is string[] array))
			{
				return Array.Empty<string>();
			}
			int num = Mathf.Min(array.Length, max);
			string[] array2 = new string[num];
			for (int i = 0; i < num; i++)
			{
				array2[i] = Cut(array[i], len);
			}
			return array2;
		}

		private static void OnRunShapeMsg(int sender, object data, bool master)
		{
			if (!(data is object[] array) || array.Length < 1 || !(array[0] is byte b))
			{
				return;
			}
			if (b >= 21 && b <= 30)
			{
				OnResearchMsg(sender, array, b, master);
				return;
			}
			if (b >= 31 && b <= 38)
			{
				OnResearchMsgE(sender, array, b, master);
				return;
			}
			if (b >= 39 && b <= 46)
			{
				OnResearchMsgX(sender, array, b, master);
				return;
			}
			if (b >= 47 && b <= 54)
			{
				OnResearchMsgC(sender, array, b, master);
				return;
			}
			if (b == 55)
			{
				if (IsFromHost(sender) && array.Length > 2 && array[1] is int[] array2 && array[2] is byte[] elems && array2.Length <= 32)
				{
					Elements.ApplyPlayers(array2, elems);
				}
				return;
			}
			switch (b)
			{
			case 20:
				if (IsFromHost(sender) && array.Length >= 9 && array[1] is float[] mult && array[2] is float[] prev && array[5] is int[] array4 && array4.Length >= 10)
				{
					string[] array5 = Strs(array[7], 64, 40);
					float[] array6 = (array[8] as float[]) ?? Array.Empty<float>();
					Market.Apply(new Market.State
					{
						Mult = mult,
						Prev = prev,
						Event = Cut(array[3], 40),
						EventItem = Cut(array[4], 80),
						EventCat = array4[0],
						EventSec = array4[1],
						EventFrom = array4[2],
						EventUntil = array4[3],
						ReqCat = array4[4],
						ReqNeed = Mathf.Clamp(array4[5], 0, 20),
						ReqHave = Mathf.Clamp(array4[6], 0, 99),
						ReqReward = Mathf.Clamp(array4[7], 0, 10000),
						ReqLevel = array4[8],
						Seq = array4[9],
						ReqGiver = Cut(array[6], 60),
						DemandKeys = array5,
						DemandMult = ((array6.Length == array5.Length) ? array6 : new float[array5.Length])
					});
				}
				break;
			case 1:
				if (IsFromHost(sender) && array.Length >= 6 && array[1] is int[] array3 && array3.Length >= 8)
				{
					RunShape.Apply(new RunShape.State
					{
						Streak = Mathf.Clamp(array3[0], 0, 10000),
						BestStreak = Mathf.Clamp(array3[1], 0, 10000),
						Milestones = Mathf.Clamp(array3[2], 0, 1000),
						VoteFor = Mathf.Clamp(array3[3], 0, 100000),
						Votes = Mathf.Clamp(array3[4], 0, 64),
						Voters = Mathf.Clamp(array3[5], 1, 64),
						SecondWindLevel = array3[6],
						Seq = array3[7],
						Boons = Strs(array[2], 40, 40),
						VoteOptions = Strs(array[3], 3, 40),
						Owed = Strs(array[4], 400, 80),
						Note = Cut(array[5], 300),
						CrewXp = ((array3.Length > 8) ? Mathf.Clamp(array3[8], 0, 1000000) : 0),
						TeamLevel10 = ((array3.Length > 9) ? Mathf.Clamp(array3[9], 0, 10000) : 0),
						BoonFrom = ((array.Length > 6) ? Strs(array[6], 40, 60) : Array.Empty<string>()),
						VoteFrom = ((array.Length > 7) ? Cut(array[7], 60) : ""),
						SeasonWon = (array3.Length > 10 && (array3[10] & 1) != 0),
						Endless = (array3.Length > 10 && (array3[10] & 2) != 0),
						Complete = (array3.Length > 10 && (array3[10] & 4) != 0),
						RouteFor = ((array3.Length > 11) ? Mathf.Clamp(array3[11], -1, 100000) : (-1)),
						RouteChosen = ((array3.Length > 12) ? Mathf.Clamp(array3[12], -1, 8) : (-1)),
						RouteVotes = ((array3.Length > 13) ? Mathf.Clamp(array3[13], 0, 64) : 0),
						RouteOptions = ((array.Length > 8) ? Strs(array[8], 4, 60) : Array.Empty<string>()),
						Heat = ((array3.Length > 14) ? Mathf.Clamp(array3[14], 0, 1000) : 0),
						HeatFor = ((array3.Length > 15) ? Mathf.Clamp(array3[15], 0, 100000) : 0),
						HeatVotes = ((array3.Length > 16) ? Mathf.Clamp(array3[16], 0, 64) : 0),
						HeatCards = ((array.Length > 9) ? Strs(array[9], 40, 40) : Array.Empty<string>()),
						HeatOffer = ((array.Length > 10) ? Strs(array[10], 6, 40) : Array.Empty<string>()),
						BoonBy = ((array.Length > 11) ? Ballots(array[11]) : Array.Empty<int>()),
						RouteBy = ((array.Length > 12) ? Ballots(array[12]) : Array.Empty<int>()),
						HeatBy = ((array.Length > 13) ? Ballots(array[13]) : Array.Empty<int>())
					});
				}
				break;
			case 2:
				if (master && array.Length >= 3 && array[1] is int milestone && array[2] is int option)
				{
					RunShape.HostVote(sender, milestone, option);
				}
				break;
			case 6:
				if (master)
				{
					if (array.Length >= 3 && array[1] is int milestone3 && array[2] is int option3)
					{
						RunShape.HostHeatVote(sender, milestone3, option3);
					}
				}
				else if (master && array.Length >= 2 && array[1] is int level)
				{
					RunShape.HostClaimSecondWind(level);
				}
				break;
			case 5:
				if (master)
				{
					if (array.Length >= 3 && array[1] is int levelIndex && array[2] is int option2)
					{
						RunShape.HostRouteVote(sender, levelIndex, option2);
					}
				}
				else if (IsFromHost(sender) && array.Length >= 2 && array[1] is string { Length: <60000 } text)
				{
					RpgRuntime.Instance?.OnRecap(text);
				}
				break;
			case 3:
				if (master && array.Length >= 3 && array[1] is int num2 && array[2] is int num3)
				{
					PlayerAvatar p = ContractHost.PlayerOf(sender);
					int num4 = RunShape.HostTake(sender, Game.SteamId(p), num2, Mathf.Clamp(num3, 0, 1));
					SendTo(62, new object[5]
					{
						(byte)4,
						num2,
						num3,
						num4 >= 0,
						Mathf.Max(0, num4)
					}, sender);
				}
				break;
			case 4:
				if (IsFromHost(sender) && array.Length >= 5 && array[1] is int milestone2 && array[2] is int choice && array[3] is bool ok && array[4] is int paid)
				{
					RpgRuntime.Instance?.OnMilestoneTaken(milestone2, choice, ok, paid);
				}
				break;
			case 7:
				if (master && array.Length >= 2 && array[1] is int id)
				{
					HostDirector.Instance?.VampHeal(id);
				}
				break;
			case 8:
				if (master)
				{
					PlayerAvatar val = ContractHost.PlayerOf(sender);
					if (array.Length >= 2 && array[1] is int num && (Object)(object)val != (Object)null)
					{
						Scrap.HostTake(val, Mathf.Clamp(num, 0, 2000), "Auditor contract failed");
					}
				}
				break;
			}
		}

