						}
						if ((info.Mods & EliteMod.Vampiric) != EliteMod.None)
						{
							num = num2;
						}
						if (info.Tier >= 3 && (Object)(object)__instance == (Object)(object)Game.LocalPlayer()?.playerHealth)
						{
