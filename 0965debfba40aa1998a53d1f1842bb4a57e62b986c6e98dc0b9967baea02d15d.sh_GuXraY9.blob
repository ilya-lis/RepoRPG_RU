			NoticeDismissKey = c.Bind<KeyCode>("Controls", "NoticeDismissKey", (KeyCode)120, "Action needed: hide the selected alert from the on-screen list (hold: all of them). It stays in the menu; nothing is voted or chosen for you. Only while the menu is closed.");
