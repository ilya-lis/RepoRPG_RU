			new EventDef
			{
				Id = "stimulus",
				Name = "Stimulus",
				Desc = "Every price resets to normal, and the haul pays 10% more Scrap.",
				Levels = 1
			}
		};

		public static readonly string[] Sections = new string[4] { "gear", "modules", "consumables", "crates" };

		public static readonly string[] SectionNames = new string[4] { "Gear", "Modules", "Consumables", "Crates" };

		public static State Cur = new State();

		private static float _nextTick;

		private static readonly List<string> BoughtThisVisit = new List<string>();

		private static int _dbgEvent = -1;

		private static ModConfig C => Plugin.Cfg;

		public static bool On => C.MarketOn.Value;

		public static bool EventAnnounced
		{
			get
			{
				if (On && Cur.Event != "")
				{
					return RunInfo.LevelIndex < Cur.EventFrom;
				}
				return false;
			}
		}

		public static float MinMult => Mathf.Clamp(C.MarketMin.Value, 0.2f, 1f);

		public static float MaxMult => Mathf.Clamp(C.MarketMax.Value, 1f, 3f);

		public static float HaulScrapMult
		{
			get
			{
				if (!EventActive("stimulus"))
				{
					return 1f;
				}
				return 1.1f;
			}
		}

		public static float ContractMult
		{
			get
			{
				if (!EventActive("recession"))
				{
					return 1f;
				}
				return 1.25f;
			}
		}

		private static TeamRunSave? Team => RpgRuntime.Instance?.HostRun?.team;

		public static void Load()
		{
			string embedded = ClassDatabase.ReadEmbedded("market");
			try
			{
				_file = Json.Deserialize<MarketFile>(ClassDatabase.ReadWithOverride("market", embedded)) ?? new MarketFile();
			}
			catch (Exception ex)
			{
				Plugin.Log.LogError((object)("market data parse error: " + ex.Message));
				_file = new MarketFile();
			}
			MarketFile file = _file;
			if (file.categories == null)
			{
				file.categories = Array.Empty<MarketCatDef>();
			}
			file = _file;
			if (file.overrides == null)
			{
				file.overrides = Array.Empty<MarketOverride>();
			}
			Overrides.Clear();
			CatCache.Clear();
			MarketOverride[] overrides = _file.overrides;
			foreach (MarketOverride marketOverride in overrides)
			{
				int num = Array.IndexOf(Ids, (marketOverride?.category ?? "").ToLowerInvariant());
				if (marketOverride != null && num >= 0 && marketOverride.valuable != "")
				{
					Overrides[marketOverride.valuable] = num;
				}
			}
		}

		public static int CategoryOf(string name)
		{
			if (CatCache.TryGetValue(name, out var value))
			{
				return value;
			}
			value = Classify(name);
			if (CatCache.Count < 2000)
			{
				CatCache[name] = value;
			}
			return value;
		}

		private static int Classify(string name)
		{
			if (Overrides.TryGetValue(name, out var value))
			{
				return value;
			}
			string text = " " + name.ToLowerInvariant().Replace("valuable", " ") + " ";
			MarketCatDef[] categories = _file.categories;
			foreach (MarketCatDef marketCatDef in categories)
			{
				int num = Array.IndexOf(Ids, marketCatDef.id);
				if (num < 0 || marketCatDef.keywords == null)
				{
					continue;
				}
				string[] keywords = marketCatDef.keywords;
				foreach (string text2 in keywords)
				{
					if (text2 != "" && text.IndexOf(text2, StringComparison.Ordinal) >= 0)
					{
						return num;
					}
				}
			}
			ValueScale.Item item = ValueScale.Find(name);
			if (item != null)
			{
				if (item.Size >= 3)
				{
					return 5;
				}
				float num2 = ValueScale.VanillaTopOf(item.Size);
				if (num2 > 0f && item.Max < num2 * 0.35f)
				{
					return 7;
				}
			}
			return 6;
		}

		private static float[] Weights()
		{
			float[] array = new float[8];
			foreach (ValueScale.Item allItem in ValueScale.AllItems)
			{
				array[CategoryOf(allItem.Name)] += 1f;
			}
			float num = 0f;
			for (int i = 0; i < 8; i++)
			{
				if (array[i] <= 0f)
				{
					array[i] = 0.25f;
				}
				num += array[i];
			}
			for (int j = 0; j < 8; j++)
			{
				array[j] /= num;
			}
			return array;
		}

		public static EventDef? EventOf(string id)
		{
			EventDef[] events = Events;
			foreach (EventDef eventDef in events)
			{
				if (eventDef.Id == id)
				{
					return eventDef;
				}
			}
			return null;
		}

		private static float[] Fill(float v)
		{
			float[] array = new float[8];
			for (int i = 0; i < 8; i++)
			{
				array[i] = v;
			}
			return array;
		}

		public static bool EventActive(string id)
		{
			if (On && Cur.Event == id && RunInfo.LevelIndex >= Cur.EventFrom)
			{
				return RunInfo.LevelIndex < Cur.EventUntil;
			}
			return false;
		}

		public static float CatMult(int c)
		{
			if (!On || c < 0 || c >= 8)
			{
				return 1f;
			}
			float num = Cur.Mult[c];
			if (EventActive("boom") && Cur.EventCat == c)
			{
				num *= 1.5f;
			}
			if (EventActive("crash") && Cur.EventCat == c)
			{
				num *= 0.6f;
			}
			if (EventActive("recession"))
			{
				num *= 0.9f;
			}
			if (EventActive("fragile_premium"))
			{
				num *= ((c == 4) ? 1.4f : 0.95f);
			}
			if (EventActive("scrap_drive") && c == 7)
			{
				num *= 2f;
			}
			if (EventActive("tech_rush"))
			{
				float num2 = num;
				float num3;
				switch (c)
				{
				default:
					num3 = 1f;
					break;
				case 0:
				case 1:
					num3 = 0.85f;
					break;
				case 2:
				case 3:
					num3 = 1.3f;
					break;
				}
				num = num2 * num3;
			}
			return Mathf.Clamp(num, MinMult, MaxMult);
		}

		public static float ValueMult(string name)
		{
			if (!On)
			{
				return 1f;
			}
			float num = CatMult(CategoryOf(name));
			if (EventActive("frenzy") && Cur.EventItem != "" && string.Equals(name, Cur.EventItem, StringComparison.OrdinalIgnoreCase))
			{
				num *= 2f;
			}
			return num;
		}

		public static string Tag(string name)
		{
			if (!On)
			{
				return "";
			}
			int num = CategoryOf(name);
			int num2 = Mathf.RoundToInt((ValueMult(name) - 1f) * 100f);
			if (num2 != 0)
			{
				return string.Format("{0} {1}{2}%", Names[num], (num2 > 0) ? "+" : "", num2);
			}
			return Names[num];
		}

		public static string Group(string key)
		{
			if (key.StartsWith("stock:", StringComparison.Ordinal))
			{
				string[] array = key.Split(':');
				if (array.Length <= 2 || !(array[2] == "1"))
				{
					return "gear" + ((array.Length > 1) ? array[1] : "0");
				}
				return "unique";
			}
			if (!key.StartsWith("cons:", StringComparison.Ordinal))
			{
				key.StartsWith("svc:", StringComparison.Ordinal);
			}
			return key;
		}

		public static int SectionOf(string group)
		{
			if (!group.StartsWith("gear", StringComparison.Ordinal) && !(group == "unique"))
			{
				if (!(group == "module"))
				{
					if (!group.StartsWith("cons:", StringComparison.Ordinal))
					{
						if (!(group == "crate") && !(group == "premium"))
						{
							return -1;
						}
						return 3;
					}
					return 2;
				}
				return 1;
			}
			return 0;
		}

		public static float PriceMult(string key)
		{
			if (!On || key == "lock")
			{
				return 1f;
			}
			string text = Group(key);
			float num = 1f;
			int num2 = Array.IndexOf(Cur.DemandKeys, text);
			if (num2 >= 0 && num2 < Cur.DemandMult.Length && Cur.DemandMult[num2] > 0.01f)
			{
				num = Cur.DemandMult[num2];
			}
			int num3 = SectionOf(text);
			if (num3 >= 0 && num3 == Cur.EventSec)
			{
				if (EventActive("shortage"))
				{
					num *= 1.25f;
				}
				if (EventActive("clearance"))
				{
					num *= 0.7f;
				}
			}
			return Mathf.Clamp(num, 0.5f, 1.6f);
		}

		public static bool Short(int section)
		{
			if (EventActive("shortage"))
			{
				return Cur.EventSec == section;
			}
			return false;
		}

		private static void Ensure(TeamRunSave t)
		{
			while (t.market.Count < 8)
			{
				t.market.Add(1f);
			}
			while (t.marketPrev.Count < 8)
			{
				t.marketPrev.Add(1f);
			}
			while (t.marketDelta.Count < 8)
			{
				t.marketDelta.Add(0f);
			}
			while (t.marketTaken.Count < 8)
			{
				t.marketTaken.Add(0);
			}
			while (t.demandMult.Count < t.demandKeys.Count)
			{
				t.demandMult.Add(1f);
			}
			while (t.demandIdle.Count < t.demandKeys.Count)
			{
				t.demandIdle.Add(0);
			}
		}

		public static void HostTick()
		{
			if (Game.IsMaster() && !(Time.unscaledTime < _nextTick))
			{
				_nextTick = Time.unscaledTime + 1f;
				HostEnsureCurrent();
			}
		}

		public static void HostEnsureCurrent()
		{
			TeamRunSave team = Team;
			if (team == null || !Game.IsMaster() || !RunReady())
			{
				return;
			}
			Ensure(team);
			int levelIndex = RunInfo.LevelIndex;
			if (team.marketLevel < 0 || levelIndex < team.marketLevel)
			{
				for (int i = 0; i < 8; i++)
				{
					team.market[i] = 1f;
					team.marketPrev[i] = 1f;
					team.marketDelta[i] = 0f;
					team.marketTaken[i] = 0;
				}
				team.marketEvent = "";
				team.marketEventCat = (team.marketEventSec = -1);
				team.marketEventFrom = (team.marketEventUntil = -1);
				team.marketEventItem = "";
				team.demandKeys.Clear();
				team.demandMult.Clear();
				team.demandIdle.Clear();
				team.reqCat = -1;
				team.reqLevel = -1;
				team.marketLevel = levelIndex;
				HostNewRequest(team, levelIndex);
				HostBroadcast();
			}
			else if (levelIndex == team.marketLevel)
			{
				if (Cur.Seq == 0)
				{
					HostBroadcast();
				}
			}
			else
			{
				int num = Mathf.Clamp(levelIndex - team.marketLevel, 1, 3);
				for (int j = 0; j < num; j++)
				{
					HostStep(team);
				}
				team.marketLevel = levelIndex;
				HostNewRequest(team, levelIndex);
				RpgRuntime.Instance?.MarkRunDirty();
				HostBroadcast();
			}
		}

		private static bool RunReady()
		{
			return RpgRuntime.Instance?.HostRun != null;
		}

		private static void HostStep(TeamRunSave t)
		{
			float num = Mathf.Clamp(C.MarketVolatility.Value, 0f, 3f);
			float num2 = Mathf.Clamp01(C.MarketRecovery.Value / 100f);
			for (int i = 0; i < 8; i++)
			{
				t.marketPrev[i] = t.market[i];
			}
			for (int j = 0; j < 8; j++)
			{
				float num3 = t.market[j] + t.marketDelta[j] * num;
				if (t.marketTaken[j] == 0)
				{
					num3 += 0.03f * num;
				}
				num3 = 1f + (num3 - 1f) * (1f - num2);
				t.market[j] = Mathf.Clamp(num3, MinMult, MaxMult);
				t.marketDelta[j] = 0f;
				t.marketTaken[j] = 0;
			}
			float[] array = Weights();
			float num4 = 0f;
			for (int k = 0; k < 8; k++)
			{
				num4 += array[k] * t.market[k];
			}
			if (num4 > 0.01f)
			{
				for (int l = 0; l < 8; l++)
				{
					t.market[l] = Mathf.Clamp(t.market[l] / num4, MinMult, MaxMult);
				}
			}
			foreach (string item in BoughtThisVisit)
			{
				if (!t.demandKeys.Contains(item))
				{
					t.demandKeys.Add(item);
					t.demandMult.Add(1f);
					t.demandIdle.Add(0);
				}
			}
			foreach (string item2 in KnownGroups())
			{
				if (!t.demandKeys.Contains(item2))
				{
					t.demandKeys.Add(item2);
					t.demandMult.Add(1f);
					t.demandIdle.Add(0);
				}
			}
			for (int m = 0; m < t.demandKeys.Count; m++)
			{
				float num5 = 1f + (t.demandMult[m] - 1f) * 0.8f;
				int num6 = 0;
				foreach (string item3 in BoughtThisVisit)
				{
					if (item3 == t.demandKeys[m])
					{
						num6++;
					}
				}
				if (num6 > 0)
				{
					num5 += 0.05f * (float)num6;
					t.demandIdle[m] = 0;
				}
				else if (++t.demandIdle[m] >= 2)
				{
					num5 -= 0.1f;
					t.demandIdle[m] = 0;
				}
				t.demandMult[m] = Mathf.Clamp(num5, 0.75f, 1.3f);
			}
			BoughtThisVisit.Clear();
			if (t.marketEvent != "" && RunInfo.LevelIndex >= t.marketEventUntil)
			{
				Plugin.Log.LogInfo((object)("[market] event over: " + t.marketEvent));
				t.marketEvent = "";
				t.marketEventCat = (t.marketEventSec = -1);
				t.marketEventItem = "";
			}
			Random random = new Random(RunInfo.Seed * 31 + RunInfo.LevelIndex * 7919);
			if (t.marketEvent == "" && random.NextDouble() * 100.0 < (double)Mathf.Clamp(C.MarketEventChance.Value, 0f, 100f))
			{
				EventDef eventDef = Events[random.Next(Events.Length)];
				t.marketEvent = eventDef.Id;
				t.marketEventFrom = RunInfo.LevelIndex;
				t.marketEventUntil = t.marketEventFrom + eventDef.Levels;
				t.marketEventCat = (eventDef.NeedsCat ? random.Next(8) : (-1));
				t.marketEventSec = (eventDef.NeedsSection ? random.Next(Sections.Length) : (-1));
				t.marketEventItem = (eventDef.NeedsItem ? PickValuable(random) : "");
				if (eventDef.Id == "frenzy" && t.marketEventItem == "")
				{
					t.marketEvent = "boom";
					t.marketEventCat = random.Next(8);
				}
				if (eventDef.Id == "stimulus")
				{
					for (int n = 0; n < 8; n++)
					{
						t.market[n] = 1f;
					}
				}
				Plugin.Log.LogInfo((object)$"[market] event announced: {t.marketEvent} (cat {t.marketEventCat}, section {t.marketEventSec}, item '{t.marketEventItem}') for levels {t.marketEventFrom + 1}-{t.marketEventUntil}.");
			}
			StringBuilder stringBuilder = new StringBuilder("[market] after level ").Append(RunInfo.LevelIndex).Append(':');
			for (int num7 = 0; num7 < 8; num7++)
			{
				stringBuilder.Append(' ').Append(Names[num7]).Append(' ')
					.Append(t.market[num7].ToString("0.00", CultureInfo.InvariantCulture));
			}
			Plugin.Log.LogInfo((object)stringBuilder.ToString());
			Tuning.Note("market", stringBuilder.ToString());
		}

		private static IEnumerable<string> KnownGroups()
		{
			for (int r = 0; r <= Gear.MaxRarity; r++)
			{
				yield return "gear" + r;
			}
			yield return "unique";
			yield return "module";
			yield return "crate";
			yield return "premium";
			foreach (ConsumableDef consumable in ShopX.Consumables)
			{
				if (!ResearchEcon.IsGunMod(consumable.id))
				{
					yield return "cons:" + consumable.id;
				}
			}
		}

		private static string PickValuable(Random rng)
		{
			List<string> list = new List<string>();
			foreach (ValueScale.Item allItem in ValueScale.AllItems)
			{
				list.Add(allItem.Name);
			}
			if (list.Count != 0)
			{
				return list[rng.Next(list.Count)];
			}
			return "";
		}

		private static void HostNewRequest(TeamRunSave t, int lvl)
		{
			if (!On)
			{
				t.reqCat = -1;
				return;
			}
			int num = 0;
			for (int i = 1; i < 8; i++)
			{
				if (t.market[i] > t.market[num])
				{
					num = i;
				}
			}
			if (EventActive("frenzy") || (t.marketEvent == "frenzy" && lvl >= t.marketEventFrom && lvl < t.marketEventUntil))
			{
				num = CategoryOf(t.marketEventItem);
			}
			t.reqCat = num;
			t.reqNeed = 3;
			t.reqHave = 0;
			t.reqLevel = lvl;
			t.reqPaid = false;
			t.reqReward = Mathf.RoundToInt(Mathf.Clamp(C.MarketRequestScrap.Value, 0f, 500f) * t.market[num]);
			ContractGiverDef[] givers = ContractBoard.Data.givers;
			t.reqGiver = ((givers.Length != 0) ? givers[Mathf.Abs(RunInfo.Seed + lvl) % givers.Length].name : "A collector");
		}

		public static void HostExtracted(ValuableObject v, float value)
		{
			TeamRunSave team = Team;
			if (!On || team == null || (Object)(object)v == (Object)null)
			{
				return;
			}
			Ensure(team);
			int num = CategoryOf(ValueScale.CleanName(((Object)((Component)v).gameObject).name));
			team.marketTaken[num]++;
			float num2 = Mathf.Max(1000f, ValueScale.LevelAverage);
			team.marketDelta[num] -= Mathf.Min(0.06f, 0.02f * value / num2);
			if (team.reqCat != num || team.reqLevel != RunInfo.LevelIndex || team.reqPaid)
			{
				return;
			}
			team.reqHave++;
			if (team.reqHave >= team.reqNeed)
			{
				team.reqPaid = true;
				foreach (PlayerAvatar item in Game.Players())
				{
					if ((Object)(object)item != (Object)null)
					{
						Scrap.HostGrant(item, team.reqReward, "Market request (" + Names[num] + ")");
					}
				}
				Plugin.Log.LogInfo((object)$"[market] request done: {team.reqNeed} {Names[num]} for {team.reqGiver}, {team.reqReward} Scrap each.");
			}
			HostBroadcast();
		}

		public static void HostBought(string key)
		{
			if (On && BoughtThisVisit.Count < 200)
			{
				BoughtThisVisit.Add(Group(key));
			}
		}

		public static void HostBroadcast()
		{
			TeamRunSave team = Team;
			if (team != null && Game.IsMaster())
			{
				Ensure(team);
				State s = new State
				{
					Mult = team.market.ToArray(),
					Prev = team.marketPrev.ToArray(),
					Event = team.marketEvent,
					EventItem = team.marketEventItem,
					EventCat = team.marketEventCat,
					EventSec = team.marketEventSec,
					EventFrom = team.marketEventFrom,
					EventUntil = team.marketEventUntil,
					ReqCat = team.reqCat,
					ReqNeed = team.reqNeed,
					ReqHave = team.reqHave,
					ReqReward = team.reqReward,
					ReqLevel = team.reqLevel,
					ReqGiver = team.reqGiver,
					DemandKeys = team.demandKeys.ToArray(),
					DemandMult = team.demandMult.ToArray(),
					Seq = Cur.Seq + 1
				};
				Apply(s);
				Net.SendMarket(s, -1);
			}
		}

		public static string DebugNextEvent()
		{
			TeamRunSave team = Team;
			if (!Game.IsMaster() || team == null)
			{
				return "host only, in a run";
			}
			if (!On)
			{
				return "the living economy is off (Market/On)";
			}
			Ensure(team);
			_dbgEvent = (_dbgEvent + 1) % Events.Length;
			EventDef eventDef = Events[_dbgEvent];
			Random random = new Random();
			team.marketEvent = eventDef.Id;
			team.marketEventFrom = RunInfo.LevelIndex;
			team.marketEventUntil = team.marketEventFrom + eventDef.Levels;
			team.marketEventCat = (eventDef.NeedsCat ? random.Next(8) : (-1));
			team.marketEventSec = (eventDef.NeedsSection ? random.Next(Sections.Length) : (-1));
			team.marketEventItem = (eventDef.NeedsItem ? PickValuable(random) : "");
			if (eventDef.Id == "frenzy" && team.marketEventItem == "")
			{
				team.marketEvent = "boom";
				team.marketEventCat = random.Next(8);
			}
			RpgRuntime.Instance?.MarkRunDirty();
			HostBroadcast();
			Plugin.Log.LogInfo((object)$"[market] debug event: {team.marketEvent} (cat {team.marketEventCat}, section {team.marketEventSec}, item '{team.marketEventItem}') for levels {team.marketEventFrom + 1}-{team.marketEventUntil}.");
			return "Market event: " + EventText(withTiming: false);
		}

		public static void HostSendTo(int actor)
		{
			if (Game.IsMaster() && Team != null)
			{
				Net.SendMarket(Cur, actor);
			}
		}

		public static void Apply(State s)
		{
			if (s.Mult.Length == 8 && s.Prev.Length == 8)
			{
				Cur = s;
				RpgRuntime.Instance?.OnMarketChanged();
			}
		}

		public static void Reset()
		{
			Cur = new State();
			BoughtThisVisit.Clear();
		}

		public static string Movers(int count = 3)
		{
			List<int> list = new List<int>();
			for (int i = 0; i < 8; i++)
			{
				list.Add(i);
			}
			list.Sort((int a, int b) => Mathf.Abs(Cur.Mult[b] - Cur.Prev[b]).CompareTo(Mathf.Abs(Cur.Mult[a] - Cur.Prev[a])));
			List<string> list2 = new List<string>();
			foreach (int item in list)
			{
				int num = Mathf.RoundToInt((Cur.Mult[item] / Mathf.Max(0.01f, Cur.Prev[item]) - 1f) * 100f);
				if (num != 0 && list2.Count < count)
				{
					list2.Add(string.Format("<color={0}>{1} {2}{3}%</color>", (num > 0) ? "#73ff66" : "#ff8a7a", Names[item], (num > 0) ? "+" : "", num));
				}
			}
			if (list2.Count != 0)
			{
				return string.Join("  ·  ", list2);
			}
			return "Prices steady";
		}

		public static string EventText(bool withTiming = true)
		{
			EventDef eventDef = EventOf(Cur.Event);
			if (eventDef == null || !On)
			{
				return "";
			}
			string text = eventDef.Desc.Replace("{cat}", (Cur.EventCat >= 0 && Cur.EventCat < 8) ? Names[Cur.EventCat] : "?").Replace("{sec}", (Cur.EventSec >= 0 && Cur.EventSec < SectionNames.Length) ? SectionNames[Cur.EventSec] : "?").Replace("{item}", ValueScale.ShortName(Cur.EventItem));
			if (!withTiming)
			{
				return eventDef.Name + ": " + text;
			}
			int levelIndex = RunInfo.LevelIndex;
			string text2 = ((levelIndex >= Cur.EventFrom) ? ((Cur.EventUntil - levelIndex <= 1) ? "this level" : $"{Cur.EventUntil - levelIndex} more levels") : ((Cur.EventUntil - Cur.EventFrom == 1) ? "next level" : $"from the next level, {Cur.EventUntil - Cur.EventFrom} levels"));
			return eventDef.Name + " (" + text2 + "): " + text;
		}

		public static string RequestText()
		{
			if (!On || Cur.ReqCat < 0 || Cur.ReqCat >= 8 || Cur.ReqLevel != RunInfo.LevelIndex)
			{
				return "";
			}
			if (Cur.ReqHave < Cur.ReqNeed)
			{
				return $"{Cur.ReqGiver} wants {Names[Cur.ReqCat]}: extract {Cur.ReqNeed} ({Cur.ReqHave}/{Cur.ReqNeed}) for +{Cur.ReqReward} {Scrap.Short} each";
			}
			return $"{Cur.ReqGiver}'s request for {Names[Cur.ReqCat]} done (+{Cur.ReqReward} {Scrap.Short} each)";
		}
	}
	internal static class NetMeter
	{
		public static long TotalOut;

		public static long TotalIn;

		private const float Window = 30f;

		private static readonly Dictionary<byte, (int msgs, long bytes)> Out = new Dictionary<byte, (int, long)>();

		private static readonly Dictionary<byte, (int msgs, long bytes)> In = new Dictionary<byte, (int, long)>();

		private static float _start = -1f;

		private static float _frameMax;

		private static float _frameSum;

		private static int _frames;

		private static double _modMs;

		private static double _modMax;

		private static double _hostMs;

		private static double _hostMax;

		private static long _photonOut0 = -1L;

		private static long _photonIn0 = -1L;

		private static object? _stats;

		private static bool _statsTried;

		public static bool On => Plugin.Cfg.NetMeter.Value;

		public static bool Counting
		{
			get
			{
				if (!Plugin.Cfg.NetMeter.Value)
				{
					return Perf.On;
				}
				return true;
			}
		}

		public static void Sent(byte type, object payload, int recipients)
		{
			TotalOut += Mathf.Max(1, recipients);
			if (On)
			{
				Out.TryGetValue(type, out (int, long) value);
				Out[type] = (value.Item1 + Mathf.Max(1, recipients), value.Item2 + Size(payload) * Mathf.Max(1, recipients));
			}
		}

		public static void Received(byte type, object payload)
		{
			TotalIn++;
			if (On)
			{
				In.TryGetValue(type, out (int, long) value);
				In[type] = (value.Item1 + 1, value.Item2 + Size(payload));
			}
		}

		private static int Size(object? o, int depth = 0)
		{
			if (o != null)
			{
				if (!(o is byte) && !(o is bool))
				{
					if (!(o is int) && !(o is float))
					{
						if (!(o is string text))
						{
							if (!(o is float[] array))
							{
								if (!(o is int[] array2))
								{
									if (!(o is byte[] array3))
									{
										if (!(o is object[] array4))
										{
											if (o is Array array5)
											{
												return 3 + array5.Length * 4;
											}
											return 8;
										}
										if (depth > 3)
										{
											return 3 + array4.Length * 4;
										}
										int num = 3;
										object[] array6 = array4;
										foreach (object o2 in array6)
										{
											num += Size(o2, depth + 1);
										}
										return num;
									}
									return 3 + array3.Length;
								}
								return 3 + array2.Length * 4;
							}
							return 3 + array.Length * 4;
						}
						return 3 + text.Length;
					}
					return 5;
				}
				return 2;
			}
			return 1;
		}

		public static long Begin()
		{
			if (!On)
			{
				return 0L;
			}
			return Stopwatch.GetTimestamp();
		}

		public static void EndMod(long t0)
		{
			if (t0 != 0L)
			{
				double num = (double)(Stopwatch.GetTimestamp() - t0) * 1000.0 / (double)Stopwatch.Frequency;
				_modMs += num;
				if (num > _modMax)
				{
					_modMax = num;
				}
			}
		}

		public static void EndHost(long t0)
		{
			if (t0 != 0L)
			{
				double num = (double)(Stopwatch.GetTimestamp() - t0) * 1000.0 / (double)Stopwatch.Frequency;
				_hostMs += num;
				if (num > _hostMax)
				{
					_hostMax = num;
				}
			}
		}

		public static void Tick()
		{
			if (!On)
			{
				if (_start >= 0f)
				{
					Reset();
					DisablePhotonStats();
				}
				return;
			}
			float unscaledTime = Time.unscaledTime;
			if (_start < 0f)
			{
				Reset();
				_start = unscaledTime;
				EnablePhotonStats();
				_photonOut0 = PhotonCount("TotalOutgoingMessageCount");
				_photonIn0 = PhotonCount("TotalIncomingMessageCount");
				return;
			}
			float unscaledDeltaTime = Time.unscaledDeltaTime;
			_frames++;
			_frameSum += unscaledDeltaTime;
			if (unscaledDeltaTime > _frameMax)
			{
				_frameMax = unscaledDeltaTime;
			}
			if (!(unscaledTime - _start < 30f))
			{
				Log(unscaledTime - _start);
				Reset();
				_statsTried = false;
				EnablePhotonStats();
				_start = unscaledTime;
				_photonOut0 = PhotonCount("TotalOutgoingMessageCount");
				_photonIn0 = PhotonCount("TotalIncomingMessageCount");
			}
		}

		private static void Reset()
		{
			Out.Clear();
			In.Clear();
			_start = -1f;
			_frames = 0;
			_frameSum = 0f;
			_frameMax = 0f;
			_modMs = (_modMax = (_hostMs = (_hostMax = 0.0)));
		}

		private static void Log(float secs)
		{
			int num = PlayerScaling.RoomPlayers();
			string text = (Game.IsMaster() ? "host" : "client");
			float num2 = ((_frameSum > 0f) ? ((float)_frames / _frameSum) : 0f);
			float msgPs;
			float bytesPs;
			string text2 = Top(Out, out msgPs, out bytesPs);
			float msgPs2;
			float bytesPs2;
			string text3 = Top(In, out msgPs2, out bytesPs2);
			long num3 = PhotonCount("TotalOutgoingMessageCount");
			long num4 = PhotonCount("TotalIncomingMessageCount");
			string text4 = ((num3 >= 0 && _photonOut0 >= 0) ? $"Photon (all of the game): {(float)(num3 - _photonOut0) / secs:0} out/s, {(float)(num4 - _photonIn0) / secs:0} in/s (room limit about 500 msg/s)" : "Photon totals unavailable");
			Plugin.Log.LogInfo((object)($"[netmeter] {text}, {num} players, {secs:0}s: FPS {num2:0} (worst frame {_frameMax * 1000f:0} ms) | " + $"mod per frame {((_frames > 0) ? (_modMs / (double)_frames) : 0.0):0.00} ms avg, {_modMax:0.0} ms max" + (Game.IsMaster() ? $" | host director {((_frames > 0) ? (_hostMs / (double)_frames) : 0.0):0.00} ms avg, {_hostMax:0.0} ms max" : "") + $" | RepoRPG sent {msgPs:0.0} msg/s ({bytesPs / 1024f:0.0} KB/s est.) [{text2}] | received {msgPs2:0.0} msg/s ({bytesPs2 / 1024f:0.0} KB/s est.) [{text3}] | {text4}"));
			string Top(Dictionary<byte, (int msgs, long bytes)> d, out float reference, out float reference2)
			{
				long num5 = 0L;
				long num6 = 0L;
				List<(byte, int, long)> list = new List<(byte, int, long)>();
				foreach (KeyValuePair<byte, (int, long)> item in d)
				{
					num5 += item.Value.Item1;
					num6 += item.Value.Item2;
					list.Add((item.Key, item.Value.Item1, item.Value.Item2));
				}
				list.Sort(((byte t, int m, long b) x, (byte t, int m, long b) y) => y.m.CompareTo(x.m));
				reference = (float)num5 / secs;
				reference2 = (float)num6 / secs;
				List<string> list2 = new List<string>();
				for (int num7 = 0; num7 < list.Count && num7 < 6; num7++)
				{
					list2.Add($"#{list[num7].Item1} {(float)list[num7].Item2 / secs:0.0}/s");
				}
				return string.Join(", ", list2);
			}
		}

		private static void EnablePhotonStats()
		{
			if (_statsTried)
			{
				return;
			}
			_statsTried = true;
			try
			{
				LoadBalancingClient networkingClient = PhotonNetwork.NetworkingClient;
				LoadBalancingPeer val = ((networkingClient != null) ? networkingClient.LoadBalancingPeer : null);
				if (val == null)
				{
					_statsTried = false;
					return;
				}
				((PhotonPeer)val).TrafficStatsEnabled = true;
				_stats = AccessTools.Property(((object)val).GetType(), "TrafficStatsGameLevel")?.GetValue(val);
			}
			catch
			{
				_stats = null;
			}
		}

		private static void DisablePhotonStats()
		{
			if (!_statsTried)
			{
				return;
			}
			_statsTried = false;
			_stats = null;
			try
			{
				LoadBalancingClient networkingClient = PhotonNetwork.NetworkingClient;
				LoadBalancingPeer val = ((networkingClient != null) ? networkingClient.LoadBalancingPeer : null);
				if (val != null)
				{
					((PhotonPeer)val).TrafficStatsEnabled = false;
				}
			}
			catch
			{
			}
		}

		private static long PhotonCount(string name)
		{
			try
			{
				if (_stats == null)
				{
					return -1L;
				}
				object obj = AccessTools.Property(_stats.GetType(), name)?.GetValue(_stats);
				return (obj == null) ? (-1) : Convert.ToInt64(obj);
			}
			catch
			{
				return -1L;
			}
		}
	}
	internal enum NoticeKind
	{
		Minor = 0,
		Choice = 2,
		Vote = 3
	}
	internal sealed class ActionNotice
	{
		public string Id = "";

		public string Title = "";

		public string Detail = "";

		public string Tab = "";

		public string Anchor = "";

		public string Short = "";

		public NoticeKind Kind = NoticeKind.Choice;

		public float EndsAt = -1f;

		public int Responded = -1;

		public int Total = -1;

		public float Since;

		public bool Bannered;

		public bool FinalReminded;

		public bool Important => Kind >= NoticeKind.Choice;

		public bool IsVote => Kind == NoticeKind.Vote;
	}
	internal static class Notices
	{
		public delegate void Provider(List<ActionNotice> into);

		private static readonly List<Provider> Providers = new List<Provider>();

		private static readonly Dictionary<string, ActionNotice> Posted = new Dictionary<string, ActionNotice>();

		private static readonly HashSet<string> ActedIds = new HashSet<string>();

		private static readonly HashSet<string> ExpiredIds = new HashSet<string>();

		private static readonly Dictionary<string, ActionNotice> ActiveById = new Dictionary<string, ActionNotice>();

		private static readonly List<ActionNotice> Scratch = new List<ActionNotice>();

		private static readonly HashSet<string> SeenIds = new HashSet<string>();

		public static readonly List<ActionNotice> Active = new List<ActionNotice>();

		public static int Version { get; private set; }

		public static bool Dirty { get; private set; } = true;

		public static ActionNotice? Top
		{
			get
			{
				if (Active.Count <= 0)
				{
					return null;
				}
				return Active[0];
			}
		}

		public static ActionNotice? TopImportant
		{
			get
			{
				if (Active.Count <= 0 || !Active[0].Important)
				{
					return null;
				}
				return Active[0];
			}
		}

		public static int ImportantCount
		{
			get
			{
				int num = 0;
				foreach (ActionNotice item in Active)
				{
					if (item.Important)
					{
						num++;
					}
				}
				return num;
			}
		}

		public static void Register(Provider p)
		{
			if (!Providers.Contains(p))
			{
				Providers.Add(p);
			}
			Dirty = true;
		}

		public static void Post(ActionNotice n)
		{
			if (n != null && !(n.Id == ""))
			{
				Posted[n.Id] = n;
				Dirty = true;
			}
		}

		public static void Clear(string id)
		{
			if (Posted.Remove(id))
			{
				Dirty = true;
			}
		}

		public static void Acted(string id)
		{
			ActedIds.Add(id);
			Dirty = true;
		}

		public static void ActedOn(string anchor)
		{
			foreach (ActionNotice item in Active)
			{
				if (item.Anchor == anchor)
				{
					ActedIds.Add(item.Id);
				}
			}
			Dirty = true;
		}

		public static void Poke()
		{
			Dirty = true;
		}

		public static void Reset()
		{
			Posted.Clear();
			ActedIds.Clear();
			ExpiredIds.Clear();
			ActiveById.Clear();
			Active.Clear();
			Version++;
			Dirty = true;
		}

		public static int CountForTab(string tab)
		{
			int num = 0;
			foreach (ActionNotice item in Active)
			{
				if (item.Tab == tab)
				{
					num++;
				}
			}
			return num;
		}

		public static ActionNotice? TopForTab(string tab)
		{
			foreach (ActionNotice item in Active)
			{
				if (item.Tab == tab)
				{
					return item;
				}
			}
			return null;
		}

		public static bool HasAnchor(string anchor)
		{
			foreach (ActionNotice item in Active)
			{
				if (item.Anchor == anchor)
				{
					return true;
				}
			}
			return false;
		}

		public static void Refresh(float now, List<ActionNotice> arrived, List<ActionNotice> closed)
		{
			Dirty = false;
			arrived.Clear();
			closed.Clear();
			Scratch.Clear();
			foreach (Provider provider in Providers)
			{
				try
				{
					provider(Scratch);
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("[notices] a provider failed: " + ex.GetBaseException().Message));
				}
			}
			foreach (KeyValuePair<string, ActionNotice> item in Posted)
			{
				Scratch.Add(item.Value);
			}
			bool flag = false;
			SeenIds.Clear();
			List<ActionNotice> list = new List<ActionNotice>(Scratch.Count);
			foreach (ActionNotice item2 in Scratch)
			{
				if (item2 == null || item2.Id == "" || !SeenIds.Add(item2.Id) || ExpiredIds.Contains(item2.Id) || ActedIds.Contains(item2.Id))
				{
					continue;
				}
				if (item2.EndsAt > 0f && now >= item2.EndsAt)
				{
					ExpiredIds.Add(item2.Id);
					if (ActiveById.TryGetValue(item2.Id, out ActionNotice value))
					{
						closed.Add(value);
					}
					Posted.Remove(item2.Id);
					continue;
				}
				if (ActiveById.TryGetValue(item2.Id, out ActionNotice value2))
				{
					if (value2.Title != item2.Title || value2.Detail != item2.Detail || value2.Responded != item2.Responded || value2.Total != item2.Total || value2.Short != item2.Short || Mathf.Abs(value2.EndsAt - item2.EndsAt) > 0.5f || value2.Tab != item2.Tab)
					{
						flag = true;
					}
					item2.Since = value2.Since;
					item2.Bannered = value2.Bannered;
					item2.FinalReminded = value2.FinalReminded;
				}
				else
				{
					item2.Since = now;
					arrived.Add(item2);
					flag = true;
				}
				list.Add(item2);
			}
			foreach (KeyValuePair<string, ActionNotice> item3 in ActiveById)
			{
				if (!SeenIds.Contains(item3.Key) || ActedIds.Contains(item3.Key) || ExpiredIds.Contains(item3.Key))
				{
					flag = true;
					ActionNotice value3 = item3.Value;
					if (value3.IsVote && !ActedIds.Contains(item3.Key) && !closed.Contains(value3) && !SeenIds.Contains(item3.Key))
					{
						closed.Add(value3);
					}
				}
			}
			ActedIds.RemoveWhere((string id) => !SeenIds.Contains(id) && !Posted.ContainsKey(id));
			ExpiredIds.RemoveWhere((string id) => !SeenIds.Contains(id));
			list.Sort((ActionNotice a, ActionNotice b) => (a.Kind == b.Kind) ? a.Since.CompareTo(b.Since) : b.Kind.CompareTo(a.Kind));
			ActiveById.Clear();
			foreach (ActionNotice item4 in list)
			{
				ActiveById[item4.Id] = item4;
			}
			if (!flag && list.Count == Active.Count)
			{
				for (int num = 0; num < list.Count; num++)
				{
					if (list[num].Id != Active[num].Id)
					{
						flag = true;
						break;
					}
				}
			}
			Active.Clear();
			Active.AddRange(list);
			if (flag)
			{
				Version++;
			}
		}
	}
	internal static class Perf
	{
		public enum S
		{
			ClientUpdate,
			Gui,
			LateUpdate,
			HostClass,
			HostPhysics,
			HostDirector,
			ClientShopContracts,
			ClientClassAbilities,
			ClientPerksGear,
			ClientResearch,
			ClientStats,
			ClientRegenAura,
			ClientScanSense,
			GuiHud,
			GuiMenu,
			GuiNotices,
			GuiWorld,
			GuiNameplates,
			GuiCard,
			GuiScan,
			GuiTeamHealth,
			GuiThirdWave,
			GuiElements,
			HostFx,
			HostSynergies,
			HostPilots,
			HostPerks,
			HostThirdWave,
			HostTeamHealth,
			HostScene,
			Count
		}

		public struct Mark
		{
			public long T;

			public long B;
		}

		private sealed class Coll
		{
			public string Name = "";

			public object? Owner;

			public FieldInfo F;

			public PropertyInfo Count;

			public int First = -1;

			public int Last;
		}

		private const int TopLevel = 6;

		private static readonly string[] Names = new string[30]
		{
			"client update (all)", "OnGUI: HUD and menu (all)", "LateUpdate (cursor, blocking UI)", "host: class host (all)", "host: physics step (carts, fields)", "host: director (elites, bosses...)", "client: shop and contracts", "client: class abilities", "client: perks, attributes, gear", "client: research",
			"client: stats applied", "client: regen, aura, heal over time", "client: scans and senses", "GUI: HUD (all of it)", "GUI: mod menu", "GUI: action needed", "GUI: world marks, call-outs, synergy lines, banners", "GUI: nameplates", "GUI: HUD card", "GUI: scan markers and outlines",
			"GUI: Medic health bars and list", "GUI: third-wave classes (threat labels, room marks...)", "GUI: element icons", "all: class visuals (rings, hook, guns)", "all: synergies", "host: self-driving carts", "host: perk effects", "host: third-wave classes", "host: team health", "host: scene scan, fields, beacons"
		};

		public static bool On;

		private static readonly long[] Ticks = new long[30];

		private static readonly long[] MaxTicks = new long[30];

		private static readonly long[] Bytes = new long[30];

		private static readonly int[] Calls = new int[30];

		private static long _frameTicks;

		private static long _frameMaxTicks;

		private static long _frameBytes;

		private static Func<long>? _alloc;

		private static bool _allocTried;

		private static bool _allocExact;

		private const float Window = 60f;

		private static float _start = -1f;

		private static float _sessionStart = -1f;

		private static readonly float[] Frames = new float[20000];

		private static int _frames;

		private static int _gc0;

		private static double _frameSum;

		private static double _gameFrameSum;

		private static long _netOut0;

		private static long _netIn0;

		private static long _sessionHeap0 = -1L;

		private static int _modFrames;

		private static readonly List<string> Trend = new List<string>();

		private static List<Coll>? _colls;

		private static string _growTop = "";

		private static string _growReport = "";

		public static Mark Start()
		{
			if (!On)
			{
				return default(Mark);
			}
			return new Mark
			{
				T = Stopwatch.GetTimestamp(),
				B = Allocated()
			};
		}

		public static void Stop(S s, Mark m)
		{
			if (m.T == 0L)
			{
				return;
			}
			long num = Stopwatch.GetTimestamp() - m.T;
			Ticks[(int)s] += num;
			Calls[(int)s]++;
			if (num > MaxTicks[(int)s])
			{
				MaxTicks[(int)s] = num;
			}
			long num2 = Allocated() - m.B;
			if (num2 > 0 && num2 < 67108864)
			{
				Bytes[(int)s] += num2;
			}
			if (s < S.ClientShopContracts)
			{
				_frameTicks += num;
				if (num2 > 0 && num2 < 67108864)
				{
					_frameBytes += num2;
				}
			}
		}

		private static long Allocated()
		{
			if (!_allocTried)
			{
				_allocTried = true;
				try
				{
					MethodInfo method = typeof(GC).GetMethod("GetAllocatedBytesForCurrentThread", BindingFlags.Static | BindingFlags.Public);
					if (method != null)
					{
						Func<long> obj = (Func<long>)Delegate.CreateDelegate(typeof(Func<long>), method);
						obj();
						_alloc = obj;
						_allocExact = true;
					}
				}
				catch
				{
					_alloc = null;
				}
				if (_alloc == null)
				{
					_alloc = Profiler.GetMonoUsedSizeLong;
				}
			}
			try
			{
				return _alloc();
			}
			catch
			{
				return 0L;
			}
		}

		public static void Tick()
		{
			if (!Plugin.Cfg.PerfProbe.Value)
			{
				if (On)
				{
					On = false;
					_start = -1f;
				}
				return;
			}
			float unscaledTime = Time.unscaledTime;
			if (!On)
			{
				On = true;
				ResetWindow(unscaledTime);
				if (_sessionStart < 0f)
				{
					_sessionStart = unscaledTime;
					_sessionHeap0 = Profiler.GetMonoUsedSizeLong();
				}
				return;
			}
			float unscaledDeltaTime = Time.unscaledDeltaTime;
			if (_frames < Frames.Length)
			{
				Frames[_frames] = unscaledDeltaTime;
			}
			_frames++;
			_gameFrameSum += unscaledDeltaTime;
			_frameSum += _frameTicks;
			if (_frameTicks > _frameMaxTicks)
			{
				_frameMaxTicks = _frameTicks;
			}
			_modFrames++;
			_frameTicks = 0L;
			if (unscaledTime - _start >= 60f)
			{
				try
				{
					WriteWindow(unscaledTime - _start);
				}
				catch (Exception ex)
				{
					Plugin.Log.LogWarning((object)("[perf] report failed: " + ex.Message));
				}
				ResetWindow(unscaledTime);
			}
		}

		private static void ResetWindow(float now)
		{
			Array.Clear(Ticks, 0, Ticks.Length);
			Array.Clear(MaxTicks, 0, MaxTicks.Length);
			Array.Clear(Bytes, 0, Bytes.Length);
			Array.Clear(Calls, 0, Calls.Length);
			_frames = 0;
			_modFrames = 0;
			_frameSum = 0.0;
			_gameFrameSum = 0.0;
			_frameTicks = 0L;
			_frameMaxTicks = 0L;
			_frameBytes = 0L;
			_gc0 = GC.CollectionCount(0);
			_netOut0 = NetMeter.TotalOut;
			_netIn0 = NetMeter.TotalIn;
			_start = now;
		}

		private static double Ms(long ticks)
		{
			return (double)ticks * 1000.0 / (double)Stopwatch.Frequency;
		}

		private static string Where()
		{
			if (Game.InLevel())
			{
				string text = "?";
				try
				{
					object obj = Game.Get<object>(RunManager.instance, "levelCurrent", null);
					object obj2 = ((obj is Object) ? obj : null);
					text = ((obj2 == null) ? null : ((Object)obj2).name?.Replace("Level - ", "")) ?? "?";
				}
				catch
				{
				}
				return "level " + text;
			}
			if (Game.InShopLevel())
			{
				return "shop";
			}
			if (Game.InLobby())
			{
				return "truck / lobby";
			}
			if (Game.InLobbyMenu())
			{
				return "lobby menu";
			}
			return "menu";
		}

		private static void WriteWindow(float secs)
		{
			int num = Mathf.Min(_frames, Frames.Length);
			if (num < 10)
			{
				return;
			}
			float num2 = (float)((double)num / Math.Max(0.001, _gameFrameSum));
			float[] array = new float[num];
			Array.Copy(Frames, array, num);
			Array.Sort(array);
			int num3 = Mathf.Max(0, num - 1 - num / 100);
			float num4 = ((array[num3] > 0f) ? (1f / array[num3]) : 0f);
			double num5 = _gameFrameSum * 1000.0 / (double)num;
			double num6 = Ms((long)(_frameSum / (double)Math.Max(1, _modFrames)));
			double num7 = Ms(_frameMaxTicks);
			double num8 = (double)_frameBytes / 1024.0 / (double)Math.Max(1, _modFrames);
			int num9 = GC.CollectionCount(0) - _gc0;
			long monoUsedSizeLong = Profiler.GetMonoUsedSizeLong();
			long totalAllocatedMemoryLong = Profiler.GetTotalAllocatedMemoryLong();
			float num10 = (float)(NetMeter.TotalOut - _netOut0) / secs;
			float num11 = (float)(NetMeter.TotalIn - _netIn0) / secs;
			int count = Game.Players().Count;
			int num12 = 0;
			Game.EnemyList.Enumerator enumerator = Game.LivingEnemies().GetEnumerator();
			while (enumerator.MoveNext())
			{
				_ = enumerator.Current;
				num12++;
			}
			string text = (Game.IsMaster() ? "host" : "client");
			int num13 = Mathf.RoundToInt((Time.unscaledTime - _sessionStart) / 60f);
			Growth();
			string text2 = $"{num13,4}  {Where(),-26} {text,-6} {count,2}p {num12,3}m  FPS {num2,5:0} (1% low {num4,4:0})  frame {num5,5:0.0} ms  RepoRPG {num6,5:0.00} ms (worst {num7,5:0.0})  " + string.Format("alloc {0,6:0.00} KB/frame{1}  GC {2,3}  heap {3,6:0} MB  total {4,6:0} MB  net {5,5:0.0} out/s {6,5:0.0} in/s  ", num8, _allocExact ? "" : "~", num9, (double)monoUsedSizeLong / 1048576.0, (double)totalAllocatedMemoryLong / 1048576.0, num10, num11) + "growing: " + ((_growTop != "") ? _growTop : "-");
			Trend.Add(text2);
			if (Trend.Count > 300)
			{
				Trend.RemoveAt(0);
			}
			Plugin.Log.LogInfo((object)("[perf] " + text2));
			StringBuilder stringBuilder = new StringBuilder(16384);
			string[] names = QualitySettings.names;
			string arg = ((names.Length != 0) ? names[Mathf.Clamp(QualitySettings.GetQualityLevel(), 0, names.Length - 1)] : "?");
			stringBuilder.Append(string.Format("RepoRPG {0} performance - {1:yyyy-MM-dd HH:mm} - {2}, {3} MB RAM, {4}, {5}x{6}, ", "1.0.100", DateTime.Now, SystemInfo.processorType, SystemInfo.systemMemorySize, SystemInfo.graphicsDeviceName, Screen.width, Screen.height) + $"quality {arg}, frame cap {Application.targetFrameRate}, vsync {QualitySettings.vSyncCount}\n");
			stringBuilder.Append("Allocation counter: " + (_allocExact ? "exact (this thread)" : "approximate (Mono heap growth; '~')") + ". RepoRPG ms = the mod's own work per frame, on the main thread.\n\n");
			stringBuilder.Append("SESSION (one line a minute)\n  min  where                      role   pl mon  ...\n");
			foreach (string item in Trend)
			{
				stringBuilder.Append("  ").Append(item).Append('\n');
			}
			stringBuilder.Append($"\nHOT SPOTS (last {secs:0} s, {_modFrames} frames, ranked by time per frame)\n");
			stringBuilder.Append("  rank  ms/frame   worst ms   calls/frame   KB/frame   section\n");
			List<int> list = new List<int>();
			for (int i = 0; i < 30; i++)
			{
				if (Calls[i] > 0)
				{
					list.Add(i);
				}
			}
			list.Sort((int a, int b) => Ticks[b].CompareTo(Ticks[a]));
			int num14 = 0;
			foreach (int item2 in list)
			{
				num14++;
				stringBuilder.Append(string.Format("  {0,4}  {1,8:0.000}   {2,8:0.00}   {3,11:0.00}   {4,8:0.00}   {5}{6}\n", num14, Ms(Ticks[item2]) / (double)Math.Max(1, _modFrames), Ms(MaxTicks[item2]), (double)Calls[item2] / (double)Math.Max(1, _modFrames), (double)Bytes[item2] / 1024.0 / (double)Math.Max(1, _modFrames), Names[item2], (item2 < 6) ? "  [entry point]" : ""));
			}
			stringBuilder.Append("\nCOLLECTIONS (RepoRPG's lists and maps: the largest, and what grew since the first window)\n");
			stringBuilder.Append(_growReport);
			stringBuilder.Append("\nNETWORK (RepoRPG messages per second, last window)\n").Append($"  sent {num10:0.0}/s, received {num11:0.0}/s\n");
			File.WriteAllText(Path.Combine(Paths.ConfigPath, "RepoRPG_perf.txt"), stringBuilder.ToString());
		}

		private static void Growth()
		{
			if (_colls == null)
			{
				_colls = new List<Coll>();
				new Dictionary<Type, object>();
				Type[] array;
				try
				{
					array = typeof(Perf).Assembly.GetTypes();
				}
				catch (ReflectionTypeLoadException ex)
				{
					array = Array.FindAll(ex.Types, (Type x) => x != null);
				}
				Type[] array2 = array;
				foreach (Type type in array2)
				{
					if (!type.IsGenericTypeDefinition)
					{
						try
						{
							Scan(type, null);
						}
						catch
						{
						}
					}
				}
				try
				{
					if ((Object)(object)RpgRuntime.Instance != (Object)null)
					{
						Scan(typeof(RpgRuntime), RpgRuntime.Instance);
					}
				}
				catch
				{
				}
				try
				{
					if ((Object)(object)ClassHost.Instance != (Object)null)
					{
						Scan(typeof(ClassHost), ClassHost.Instance);
					}
				}
				catch
				{
				}
				try
				{
					if ((Object)(object)HostDirector.Instance != (Object)null)
					{
						Scan(typeof(HostDirector), HostDirector.Instance);
					}
				}
				catch
				{
				}
			}
			List<Coll> list = new List<Coll>();
			List<Coll> list2 = new List<Coll>();
			foreach (Coll coll in _colls)
			{
				try
				{
					object obj5 = coll.Owner;
					if (coll.F.DeclaringType == typeof(RpgRuntime))
					{
						obj5 = RpgRuntime.Instance;
					}
					else if (coll.F.DeclaringType == typeof(ClassHost))
					{
						obj5 = ClassHost.Instance;
					}
					else if (coll.F.DeclaringType == typeof(HostDirector))
					{
						obj5 = HostDirector.Instance;
					}
					if (!coll.F.IsStatic && obj5 == null)
					{
						continue;
					}
					object value = coll.F.GetValue(obj5);
					if (value != null)
					{
						int num2 = (int)coll.Count.GetValue(value);
						if (coll.First < 0)
						{
							coll.First = num2;
						}
						coll.Last = num2;
						if (num2 - coll.First >= 50)
						{
							list.Add(coll);
						}
						list2.Add(coll);
					}
				}
				catch
				{
				}
			}
			list.Sort((Coll a, Coll b) => (b.Last - b.First).CompareTo(a.Last - a.First));
			list2.Sort((Coll a, Coll b) => b.Last.CompareTo(a.Last));
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append("  grew since the first window (+50 or more):\n");
			if (list.Count == 0)
			{
				stringBuilder.Append("    nothing\n");
			}
			for (int num3 = 0; num3 < list.Count && num3 < 12; num3++)
			{
				stringBuilder.Append($"    {list[num3].Name}: {list[num3].First} -> {list[num3].Last}\n");
			}
			stringBuilder.Append("  largest now:\n");
			for (int num4 = 0; num4 < list2.Count && num4 < 12; num4++)
			{
				stringBuilder.Append($"    {list2[num4].Name}: {list2[num4].Last}\n");
			}
			_growReport = stringBuilder.ToString();
			_growTop = ((list.Count == 0) ? "" : $"{list[0].Name} +{list[0].Last - list[0].First}");
			static void Scan(Type t, object? owner)
			{
				BindingFlags bindingAttr = (BindingFlags)(0x30 | ((owner == null) ? 8 : 4) | 2);
				FieldInfo[] fields = t.GetFields(bindingAttr);
				foreach (FieldInfo fieldInfo in fields)
				{
					Type fieldType = fieldInfo.FieldType;
					if (!fieldType.IsArray && !fieldType.IsValueType && !fieldInfo.IsLiteral)
					{
						PropertyInfo property = fieldType.GetProperty("Count", BindingFlags.Instance | BindingFlags.Public);
						if (!(property == null) && !(property.PropertyType != typeof(int)) && typeof(IEnumerable).IsAssignableFrom(fieldType))
						{
							_colls.Add(new Coll
							{
								Name = (t.Name + "." + fieldInfo.Name).Replace("<", "").Replace(">k__BackingField", ""),
								Owner = owner,
								F = fieldInfo,
								Count = property
							});
						}
					}
				}
			}
		}
	}
