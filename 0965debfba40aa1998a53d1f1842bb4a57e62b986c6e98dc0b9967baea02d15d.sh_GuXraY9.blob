			NoticeHideReminders = c.Bind<bool>("Notices", "HideReminders", false, "Action needed: don't show minor reminders (unspent skill / attribute points, the class switch) in the on-screen list.");
			NoticeOpenToTab = c.Bind<bool>("Notices", "OpenToNotice", true, "Action needed: the menu key opens the menu on the tab that needs you (the most important vote or choice), with it selected.");
			RunLineMode = c.Bind<RunLineShow>("Interface", "RunStatusLine", RunLineShow.Always, "The run status chips on the bottom-left HUD card (chapter, next milestone, streak, boons, heat, crew, payout, map modifier): Always, TruckAndShop (not in levels), or Never. The full details are in the team panel and Account > Runs.");
			RunSummaryCard = c.Bind<bool>("Interface", "RunSummaryCard", false, "A short run summary card for a few seconds when you reach the truck or shop, only when something changed (a new chapter, the threat rating went up, a new boon, more heat, crew level).");
			AbilityRingSeconds = c.Bind<bool>("Interface", "AbilityRingTimer", true, "HUD card: the time left in the middle of the ability circle (cooldown, next charge, or the effect running out). Off: a plain ring.");
