			{
				return text;
			}
			Color val = ContractBoard.TierColors[Mathf.Clamp(c.tier, 0, 2)];
			return text + "  ·  <color=#" + ColorUtility.ToHtmlStringRGB(val) + ">" + ContractBoard.TierNames[Mathf.Clamp(c.tier, 0, 2)].ToUpperInvariant() + "</color>";
