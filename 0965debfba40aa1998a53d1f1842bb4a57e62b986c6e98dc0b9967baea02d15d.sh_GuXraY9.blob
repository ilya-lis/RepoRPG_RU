		private static string[] Csv(object o)
		{
			string text = (o as string) ?? "";
			if (!(text == ""))
			{
				return text.Split(',');
			}
			return Array.Empty<string>();
		}

		private static bool OnResearchMsgC(int sender, object[] d, byte kind, bool master)
		{
			//IL_022f: Unknown result type (might be due to invalid IL or missing references)
			switch (kind)
			{
			case 47:
				if (IsFromHost(sender))
				{
					if (d.Length > 9 && d[2] is int drillFor && d[4] is int drillVotes && d[7] is int sponsorVotes && d[8] is int voters)
					{
						ResearchCrew.Apply(new ResearchCrew.State
						{
							Drills = Csv(d[1]),
							DrillFor = drillFor,
							DrillOffer = Csv(d[3]),
							DrillVotes = drillVotes,
							Sponsor = Cut(d[5], 40),
							SponsorOffer = Csv(d[6]),
							SponsorVotes = sponsorVotes,
							Voters = voters,
							SponsorLine = Cut(d[9], 200),
							DrillBy = ((d.Length > 10) ? Ballots(d[10]) : Array.Empty<int>()),
							SponsorBy = ((d.Length > 11) ? Ballots(d[11]) : Array.Empty<int>())
						});
					}
					return true;
				}
				break;
			case 48:
				if (master)
				{
					if (d.Length > 3 && d[1] is int which && d[2] is int forId && d[3] is int option)
					{
						ResearchCrew.HostVote(sender, which, forId, option);
					}
					return true;
				}
				break;
			case 49:
				if (d.Length > 5 && d[1] is int kind2 && d[2] is float num && d[3] is float num2 && d[4] is float num3)
				{
					RpgRuntime.Instance?.OnUplinkC(sender, kind2, new Vector3(num, num2, num3), Cut(d[5], 40));
				}
				return true;
			case 50:
				if (master)
				{
					if (d.Length > 3 && d[1] is int op && d[2] is int a && d[3] is string { Length: <=40 } text2)
					{
						RpgRuntime.HostTradeRequest(sender, op, a, text2);
					}
					return true;
				}
				break;
			case 51:
				if (IsFromHost(sender))
				{
					if (d.Length > 7 && d[1] is int id && d[2] is int state && d[3] is int other && d[5] is string { Length: <20000 } text)
					{
						RpgRuntime.Instance?.OnTradeC(id, state, other, Cut(d[4], 40), text, Cut(d[6], 40), Cut(d[7], 160));
					}
					return true;
				}
				break;
			case 52:
				if (master)
				{
					SendTo(62, new object[2]
					{
						(byte)53,
						ResearchCrew.HostBorrowList(sender)
					}, sender);
					return true;
				}
				break;
			case 53:
				if (IsFromHost(sender))
				{
					if (d.Length > 1 && d[1] is string[] array && array.Length <= 32)
					{
						RpgRuntime.Instance?.OnBorrowListC(array);
					}
					return true;
				}
				break;
			}
			if (kind >= 47)
			{
				return kind <= 54;
			}
			return false;
		}

		internal static string ResSteamIdE(int actor)
		{
			if (!Online || actor == ClassClaims.LocalActor)
			{
				PlayerAvatar val = Game.LocalPlayer();
				string text = (((Object)(object)val == (Object)null) ? "" : Game.SteamId(val));
				if (!string.IsNullOrEmpty(text))
				{
					return text;
				}
				return "local";
			}
			string text2 = SenderSteamId(actor, "");
			if (!(text2 == ""))
			{
				return text2;
			}
			return "?" + actor;
		}

