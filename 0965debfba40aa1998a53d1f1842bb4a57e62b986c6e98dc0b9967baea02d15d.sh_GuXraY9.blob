		public static bool InPickWindow(int actor)
		{
			if (_pickUntil.TryGetValue(actor, out var value))
			{
				return Time.unscaledTime < value;
			}
			return false;
		}

		public static void OnPlayerEntered(Player p)
		{
			if (p != null && CatchUpActive && !Game.InLobbyMenu())
			{
				_pending[p.ActorNumber] = new Joiner
				{
					Actor = p.ActorNumber,
					Name = (p.NickName ?? ""),
					Since = Time.unscaledTime,
					Where = WhereNow()
				};
				Plugin.Log.LogInfo((object)("[late join] " + p.NickName + " joined " + ((WhereNow() == 2) ? "mid-level" : ((WhereNow() == 1) ? "in the shop" : "in the truck")) + " - waiting for their game to build the scene."));
				Net.SendLateJoinWelcome(p.ActorNumber, WhereNow());
			}
		}

		private static void TickPending()
		{
			if (_pending.Count == 0)
			{
				return;
			}
			List<int> list = null;
			foreach (Joiner value in _pending.Values)
			{
				Room currentRoom = PhotonNetwork.CurrentRoom;
				if (((currentRoom != null) ? currentRoom.GetPlayer(value.Actor, false) : null) == null)
				{
					(list ?? (list = new List<int>())).Add(value.Actor);
				}
				else if (Time.unscaledTime - value.Since > 120f)
				{
					(list ?? (list = new List<int>())).Add(value.Actor);
					Plugin.Log.LogWarning((object)("[late join] " + value.Name + " never finished loading (2 min)."));
				}
			}
			if (list == null)
			{
				return;
			}
			foreach (int item in list)
			{
				_pending.Remove(item);
			}
		}

		public static void OnModulesAsked(int actor)
		{
			if (!Active || !_pending.ContainsKey(actor))
			{
				return;
			}
			Room currentRoom = PhotonNetwork.CurrentRoom;
			Player val = ((currentRoom != null) ? currentRoom.GetPlayer(actor, false) : null);
			if (val == null)
			{
				return;
			}
			int num = 0;
			Module[] array = Object.FindObjectsByType<Module>((FindObjectsSortMode)0);
			foreach (Module val2 in array)
			{
				if ((Object)(object)val2 == (Object)null || !Game.Get(val2, "SetupDone", fallback: false))
				{
					continue;
				}
				PhotonView component = ((Component)val2).GetComponent<PhotonView>();
				if ((Object)(object)component == (Object)null)
				{
					continue;
				}
				try
				{
					bool flag = Game.Get(val2, "ConnectingTopRight", fallback: false);
					bool flag2 = Game.Get(val2, "ConnectingTopLeft", fallback: false);
					bool flag3 = Game.Get(val2, "ConnectingRightTop", fallback: false);
					bool flag4 = Game.Get(val2, "ConnectingRightBot", fallback: false);
					bool flag5 = Game.Get(val2, "ConnectingBottomRight", fallback: false);
					bool flag6 = Game.Get(val2, "ConnectingBottomLeft", fallback: false);
					bool flag7 = Game.Get(val2, "ConnectingLeftTop", fallback: false);
					bool flag8 = Game.Get(val2, "ConnectingLeftBot", fallback: false);
					bool flag9 = Game.Get(val2, "First", fallback: false);
					if (flag || flag2 || flag3 || flag4 || flag5 || flag6 || flag7 || flag8)
					{
						component.RPC("ModuleConnectionSetMegaRPC", val, new object[9] { flag, flag2, flag3, flag4, flag5, flag6, flag7, flag8, flag9 });
					}
					else
					{
						component.RPC("ModuleConnectionSetRPC", val, new object[5]
						{
							Game.Get(val2, "ConnectingTop", fallback: false),
							Game.Get(val2, "ConnectingBottom", fallback: false),
							Game.Get(val2, "ConnectingRight", fallback: false),
							Game.Get(val2, "ConnectingLeft", fallback: false),
							flag9
						});
					}
					num++;
				}
				catch (Exception ex)
				{
					Game.WarnOnce("[late join] module connections: " + ex.Message);
					break;
				}
			}
			Plugin.Log.LogInfo((object)$"[late join] sent {num} module connections to {val.NickName}.");
		}

		public static void OnJoinerReady(int actor)
		{
			if (!CatchUpActive)
			{
				return;
			}
			Room currentRoom = PhotonNetwork.CurrentRoom;
			Player p = ((currentRoom != null) ? currentRoom.GetPlayer(actor, false) : null);
			if (p == null || !_pending.TryGetValue(actor, out Joiner j) || j.Synced)
			{
				return;
			}
			j.Synced = true;
			_pending.Remove(actor);
			HostDirector instance = HostDirector.Instance;
			if ((Object)(object)instance != (Object)null)
			{
				((MonoBehaviour)instance).StartCoroutine(SyncRoutine(p, j.Where));
				return;
			}
			PatchGuard.Run("late join sync", delegate
			{
				_syncBusyUntil = 0f;
				IEnumerator enumerator = SyncRoutine(p, j.Where);
				while (enumerator.MoveNext())
				{
				}
				_syncBusyUntil = 0f;
			});
		}

		private static IEnumerator SyncRoutine(Player p, int where)
		{
			yield return null;
			while (Time.unscaledTime < _syncBusyUntil)
			{
				yield return null;
			}
			_syncBusyUntil = Time.unscaledTime + 3f;
			if (Active)
			{
				PatchGuard.Run("late join: haul and extraction points", delegate
				{
					SyncRound(p);
				});
				yield return null;
				PatchGuard.Run("late join: valuables and shop", delegate
				{
					SyncValues(p);
				});
				yield return null;
				PatchGuard.Run("late join: monsters", delegate
				{
					SyncEnemies(p);
				});
				yield return null;
				PatchGuard.Run("late join: doors and destroyed objects", delegate
				{
					SyncDestroyed(p);
				});
				yield return null;
				PatchGuard.Run("late join: dead players", delegate
				{
					SyncDeaths(p);
				});
				PatchGuard.Run("late join: run stats", delegate
				{
					object obj = PunManagerInstance();
					if (obj != null)
					{
						AccessTools.Method(obj.GetType(), "SyncAllDictionaries", Type.EmptyTypes, (Type[])null)?.Invoke(obj, null);
					}
				});
			}
			yield return null;
			bool flag = where == 2 && Plugin.Cfg.LateJoinClassPick.Value;
			if (flag)
			{
				_pickUntil[p.ActorNumber] = Time.unscaledTime + 60f + 5f;
			}
			Net.SendLateJoinNote(p.ActorNumber, where, flag ? 60f : 0f, CatchUpLevelFor(p), Mathf.Clamp(Plugin.Cfg.LateJoinShield.Value, 0f, 30f));
			PatchGuard.Run("late join: starting Scrap", delegate
			{
				GiveStartScrap(p);
			});
			if (Plugin.Cfg.LateJoinAnnounce.Value)
			{
				Net.SendLateJoinAnnounce(p.NickName ?? "A player", where, p.ActorNumber);
			}
			Plugin.Log.LogInfo((object)("[late join] " + p.NickName + " is in: state sent."));
			_syncBusyUntil = Time.unscaledTime + 0.1f;
		}

		private static object? PunManagerInstance()
		{
			Type type = AccessTools.TypeByName("PunManager");
			if (!(type == null))
			{
				return AccessTools.Field(type, "instance")?.GetValue(null);
			}
			return null;
		}

		private static void RpcTo(Component? c, string method, Player p, params object[] args)
		{
			if ((Object)(object)c == (Object)null)
			{
				return;
			}
			PhotonView component = c.GetComponent<PhotonView>();
			if ((Object)(object)component == (Object)null)
			{
				return;
			}
			try
			{
				component.RPC(method, p, args);
			}
			catch (Exception ex)
			{
				Game.WarnOnce("[late join] " + ((object)c).GetType().Name + "." + method + ": " + ex.Message);
			}
		}

		private static void SyncRound(Player p)
		{
			RoundDirector instance = RoundDirector.instance;
			if ((Object)(object)instance == (Object)null)
			{
				return;
			}
			int num = Game.Get(instance, "haulGoal", 0);
			if (num > 0 && Game.InLevel())
			{
				RpcTo((Component?)(object)instance, "StartRoundRPC", p, num);
			}
			ExtractionPoint val = Game.Get<ExtractionPoint>(instance, "extractionPointCurrent", null);
			if (Game.Get(instance, "extractionPointActive", fallback: false) && (Object)(object)val != (Object)null)
			{
				PhotonView component = ((Component)val).GetComponent<PhotonView>();
				if ((Object)(object)component != (Object)null)
				{
					RpcTo((Component?)(object)instance, "ExtractionPointActivateRPC", p, component.ViewID);
				}
			}
			else if (Game.InLevel())
			{
				RpcTo((Component?)(object)instance, "ExtractionPointsUnlockRPC", p);
			}
			if (Game.Get<object>(instance, "extractionPointList", null) is IList list)
			{
				foreach (object item in list)
				{
					object obj = ((item is GameObject) ? item : null);
					ExtractionPoint val2 = ((obj != null) ? ((GameObject)obj).GetComponent<ExtractionPoint>() : null);
					if (!((Object)(object)val2 == (Object)null))
					{
						object obj2 = Game.Get<object>(val2, "currentState", null);
						if (obj2 != null)
						{
							RpcTo((Component?)(object)val2, "StateSetRPC", p, obj2);
						}
						if (Game.Get(val2, "haulGoalFetched", fallback: false))
						{
							RpcTo((Component?)(object)val2, "HaulGoalSetRPC", p, Game.Get(val2, "haulGoal", 0));
						}
						int num2 = Game.Get(instance, "extractionPointSurplus", 0);
						if (num2 > 0 && (Object)(object)val2 == (Object)(object)val)
						{
							RpcTo((Component?)(object)val2, "ExtractionPointSurplusRPC", p, num2);
						}
					}
				}
			}
			object? obj3 = PunManagerInstance();
			Component val3 = (Component)((obj3 is Component) ? obj3 : null);
			if ((Object)(object)val3 != (Object)null)
			{
				RpcTo(val3, "SyncHaul", p, Game.Get(instance, "totalHaul", 0));
			}
		}

		private static void SyncValues(Player p)
		{
			Game.ValuableList.Enumerator enumerator = Game.Valuables().GetEnumerator();
			while (enumerator.MoveNext())
			{
				ValuableObject item = enumerator.Current.obj;
				if ((Object)(object)item != (Object)null && Game.Get(item, "dollarValueSet", fallback: false))
				{
					RpcTo((Component?)(object)item, "DollarValueSetRPC", p, Game.Get(item, "dollarValueCurrent", 0f));
				}
			}
			if (Game.InShopLevel())
			{
				ItemAttributes[] array = Object.FindObjectsByType<ItemAttributes>((FindObjectsSortMode)0);
				foreach (ItemAttributes val in array)
				{
					if ((Object)(object)val != (Object)null && Game.Get(val, "shopItem", fallback: false))
					{
						RpcTo((Component?)(object)val, "GetValueRPC", p, Game.Get(val, "value", 0));
					}
				}
			}
			ValuableDirector val2 = Object.FindAnyObjectByType<ValuableDirector>();
			if ((Object)(object)val2 != (Object)null && Game.InLevel())
			{
				RpcTo((Component?)(object)val2, "VolumesAndSwitchSetupRPC", p);
			}
		}

		private static void SyncEnemies(Player p)
		{
			PlayerAvatar val = PlayerOf(p.ActorNumber);
			int num = (((Object)(object)val != (Object)null && (Object)(object)val.photonView != (Object)null) ? val.photonView.ViewID : 0);
			EnemyParent[] array = Object.FindObjectsByType<EnemyParent>((FindObjectsSortMode)0);
			foreach (EnemyParent val2 in array)
			{
				if (!((Object)(object)val2 == (Object)null))
				{
