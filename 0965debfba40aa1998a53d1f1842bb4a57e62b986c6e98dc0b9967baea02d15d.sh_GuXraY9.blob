			{
				try
				{
					string path = Path.Combine(Paths.ConfigPath, "RepoRPG_layout_check.txt");
					StringBuilder stringBuilder = new StringBuilder().AppendLine().AppendLine($"HUD: floating elements ({list.Count})" + ((list.Count == 0) ? ": none" : ""));
					foreach (var (it3, text4) in list)
					{
						stringBuilder.AppendLine("  " + Line(it3) + "   <- " + text4);
					}
					File.AppendAllText(path, stringBuilder.ToString());
					LayoutCheckSummary += ((list.Count == 0) ? "  HUD: no floating elements." : $"  HUD: {list.Count} floating element(s).");
				}
				catch
				{
				}
			}
