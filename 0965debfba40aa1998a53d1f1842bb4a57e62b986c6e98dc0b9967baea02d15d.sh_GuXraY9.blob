		private void OpenHelpFor(string tab)
		{
			int num = Array.IndexOf(TabNames, "Guide");
			if (num >= 0)
			{
				if (tab != "Guide")
				{
					SelectGuideTopic(Guide.TopicForTab(tab));
				}
				_guideWalk = false;
				SwitchTabTo(num);
			}
		}

		private void MaybeShowGuide()
		{
			if (!Plugin.Cfg.GuideSeen.Value)
			{
				int num = Array.IndexOf(TabNames, "Guide");
				if (num >= 0)
				{
					SelectGuideTopic("start");
					_guideWalk = true;
					_guideStep = 0;
					_tab = num;
				}
			}
		}

		private void FinishGuide()
		{
			if (!Plugin.Cfg.GuideSeen.Value)
			{
				Plugin.Cfg.GuideSeen.Value = true;
			}
			_guideWalk = false;
			int num = Array.IndexOf(TabNames, "Class");
			if (num >= 0 && Current == null)
			{
				SwitchTabTo(num);
			}
		}

		private void SelectGuideTopic(string id)
		{
			//IL_004b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0050: Unknown result type (might be due to invalid IL or missing references)
			GuideTopic guideTopic = Guide.Get(id) ?? ((Guide.Topics.Count > 0) ? Guide.Topics[0] : null);
			if (guideTopic != null && !(_guideTopic == guideTopic.id))
			{
				_guideTopic = guideTopic.id;
				_helpScroll = Vector2.zero;
			}
		}

		private ref string SearchTarget()
		{
			switch ((_tab < TabNames.Length) ? TabNames[_tab] : "")
			{
			case "Guide":
				return ref _guideQuery;
			case "Host":
				if (_presetTyping)
				{
					return ref _presetName;
				}
				return ref _hostQuery;
			case "Perks":
				return ref _perkQuery;
			case "Gear":
				return ref _gearQuery;
			default:
				return ref _classQuery;
			}
		}

		private List<GuideTopic> VisibleTopics()
		{
			if (_gVisible != null && _gVisibleKey == _guideQuery)
			{
				return _gVisible;
			}
			_gVisibleKey = _guideQuery;
			string text = _guideQuery.Trim().ToLowerInvariant();
			List<GuideTopic> list = new List<GuideTopic>();
			if (text == "")
			{
				list.AddRange(Guide.Topics);
			}
			else
			{
				string[] tokens = TextSearch.Tokens(text);
				foreach (GuideTopic topic in Guide.Topics)
				{
					if (topic.title.ToLowerInvariant().Contains(text))
					{
						list.Add(topic);
					}
				}
				foreach (GuideTopic topic2 in Guide.Topics)
				{
					if (!list.Contains(topic2))
					{
						if (!_guideDocs.TryGetValue(topic2, out SearchDoc value))
						{
							value = (_guideDocs[topic2] = TextSearch.Doc(topic2.title + " " + topic2.Haystack));
						}
						if (TextSearch.Matches(value, tokens))
						{
							list.Add(topic2);
						}
					}
				}
			}
			_gVisible = list;
			return list;
		}

		private DetailInfo GuideDetail()
		{
			DetailInfo guideDetail = _guideDetail;
			GuideTopic topic = Guide.Get(_guideTopic);
			if (topic == null)
			{
				if (guideDetail.EmptyTitle == "")
				{
					guideDetail.Begin("");
					guideDetail.EmptyTitle = "Pick a topic";
					guideDetail.EmptyText = "Its summary shows here.";
				}
				return guideDetail;
			}
			if (_guideDetailFor == topic.id && _guideDetailCfg == _cfgVersion && guideDetail.Name != "")
			{
				return guideDetail;
			}
			_guideDetailFor = topic.id;
			_guideDetailCfg = _cfgVersion;
			guideDetail.Begin(topic.id + "|" + _cfgVersion);
			guideDetail.Type = "Guide";
			guideDetail.Name = topic.title;
			guideDetail.Now = ResolveGuide(topic.summary);
			int num = Array.FindIndex(TabNames, (string n) => string.Equals(n, topic.title, StringComparison.OrdinalIgnoreCase) || string.Equals(n, topic.id, StringComparison.OrdinalIgnoreCase));
			if (num >= 0 && TabNames[num] != "Guide")
			{
				int ti = num;
				guideDetail.Act("Open the " + TabNames[num] + " tab", BtnKind.Secondary, enabled: true, delegate
				{
					SwitchTabTo(ti);
				});
			}
			return guideDetail;
		}

