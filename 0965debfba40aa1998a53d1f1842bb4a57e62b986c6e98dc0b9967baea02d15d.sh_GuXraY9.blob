		private void SetCartFollow(PlayerAvatar p, bool on)
		{
			int item = Game.ActorNumber(p);
			bool num = !_followOff.Contains(item);
			if (on)
			{
				_followOff.Remove(item);
			}
			else
			{
				_followOff.Add(item);
			}
			if (num != on)
			{
				DiagLog("host: " + Game.Get(p, "playerName", "?") + " turned cart follow " + (on ? "on" : "off"));
			}
			foreach (Pilot value in _pilots.Values)
			{
				if ((Object)(object)value.Owner == (Object)(object)p && value.St != CartSt.Overdrive)
				{
					if (on)
					{
						value.FollowOff = false;
						value.HasOffSpot = false;
					}
					else
					{
						BeginFollowOff(value);
					}
				}
			}
			if (on)
			{
				Net.SendNotice(p, Notice.CartState, 0f, "following");
			}
			else
			{
				Net.SendNotice(p, Notice.CartState, 0f, "follow off");
			}
		}

		private void BeginFollowOff(Pilot pl)
		{
			if (!pl.FollowOff)
			{
				pl.FollowOff = true;
				pl.HasOffSpot = false;
				pl.FollowOffUntil = Time.time + 6f;
				pl.AwaitOwner = false;
				CartLog(pl, "follow turned off: parking");
			}
		}

