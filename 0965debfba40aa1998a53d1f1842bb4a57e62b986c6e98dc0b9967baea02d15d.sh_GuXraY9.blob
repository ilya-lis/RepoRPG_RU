			{
				num = Mathf.Max(num, buff.Guard);
			}
			float num2 = 1f - Mathf.Clamp(num, 0f, 50f) / 100f;
			switch (CurrentId)
			{
			case "herald":
				if (_monsterNear)
				{
					num2 *= 1f - Mathf.Clamp(ClassStat("herald.near_guard"), 0f, 40f) / 100f;
				}
				if (_inspire > 50f)
				{
					num2 *= 1f - Mathf.Clamp(ClassStat("herald.rod_guard"), 0f, 40f) / 100f;
				}
				break;
			case "undertaker":
				if (HoldingHead())
				{
					num2 *= 1f - Mathf.Clamp(ClassStat("undertaker.carry_guard"), 0f, 40f) / 100f;
				}
				break;
			case "juggernaut":
			{
