		private static string BuildAscensionText()
		{
			AscensionSave mine = Ascension.Mine;
			StringBuilder stringBuilder = new StringBuilder();
			stringBuilder.Append("<b>ASCENSION</b>  <color=#c79aff>Highest won: " + ((mine.highest >= 0) ? ("A" + mine.highest) : "none yet") + "</color>  <color=#9a9ca0>Win a run (beat The Liquidator, the finale boss, and extract) to open the next level. Each level adds a modifier on top of the lower ones and better rewards: " + Ascension.RewardLine(1) + " per level. A win at each level for the first time gives Research Data (100 + 25 per level).</color>\n\n");
			Ascension.Mod[] mods = Ascension.Mods;
			foreach (Ascension.Mod mod in mods)
			{
				bool flag = mod.N <= mine.highest + 1;
				stringBuilder.Append(flag ? $"<b>A{mod.N} {mod.Name}</b>  {mod.Desc}" : $"<color=#9a9ca0>A{mod.N} - win A{mod.N - 1} to see</color>").Append((mine.highest >= mod.N) ? "  <color=#73ff66>won</color>" : "").Append('\n');
			}
			stringBuilder.Append("\n<b>REWARDS</b>\n");
			stringBuilder.Append("Titles: Ascended (A1), Ascendant (A5), Exalted (A10), Transcendent (A15), Apex (A20). Your rank (\"A7\") shows by your name.\n");
			stringBuilder.Append((mine.highest >= 10) ? "<color=#ffa62b>Crown of Ascent</color> (a Unique: your heat vote counts twice) can drop for you.\n" : "<color=#9a9ca0>Win A10: the Unique Crown of Ascent joins your drops.</color>\n");
			stringBuilder.Append((mine.highest >= 20) ? "<color=#E0344B>Apex Brand</color> (cursed) can drop for you from bosses.\n" : "<color=#9a9ca0>Win A20: the cursed Apex Brand joins your boss drops.</color>\n");
			stringBuilder.Append("\n<b>CLASS RECORDS</b>  <color=#9a9ca0>(highest Ascension won with each class)</color>\n");
			if (mine.classBest.Count == 0)
			{
				stringBuilder.Append("<color=#9a9ca0>None yet.</color>\n");
			}
			foreach (NodeRank item in mine.classBest)
			{
				ClassDef classDef = Plugin.Db.Get(item.id);
				if (classDef != null)
				{
					stringBuilder.Append($"<color={classDef.color}>A{item.rank - 1} {classDef.name}</color>   ");
				}
			}
			return stringBuilder.ToString();
		}

		private int AttrPendingTotal()
		{
			int num = 0;
			foreach (int value in (_attrInFlight ?? _attrPending).Values)
			{
				num += value;
			}
			return num;
		}

		private int AttrPendingOf(string id)
		{
			if (!(_attrInFlight ?? _attrPending).TryGetValue(id, out var value))
			{
				return 0;
			}
			return value;
		}

		private void AttrAddPending(AttributeDef a)
		{
			if (!AttrBusy)
			{
				_attrPending.TryGetValue(a.id, out var value);
				_attrPending[a.id] = value + 1;
				PushUndo(UndoKind.Attribute, a.id);
			}
		}

		private void AttrRemovePending(AttributeDef a)
		{
			if (!AttrBusy && _attrPending.TryGetValue(a.id, out var value))
			{
				if (value <= 1)
				{
					_attrPending.Remove(a.id);
				}
				else
				{
					_attrPending[a.id] = value - 1;
				}
			}
		}

		private bool CancelPending()
		{
			if (_attrPending.Count == 0)
			{
				return false;
			}
			_attrPending.Clear();
			return true;
		}

		private void ResetAttributes()
		{
			if (AttrBusy || !CancelPending())
			{
				MenuSound(UiSound.Error);
			}
			else
			{
				MenuSound(UiSound.Back);
			}
		}

		private void ConfirmAttributes()
		{
			if (AttrBusy || !AttrHasPending)
			{
				MenuSound(UiSound.Error);
				return;
			}
			Dictionary<string, int> dictionary = new Dictionary<string, int>(_attrPending);
			RunSave data = _store.Data;
			string text = AttributeAlloc.Validate(data, dictionary);
			if (text != "")
			{
				AttrRejected(text);
			}
			else if (DecideLocally)
			{
				AttributeAlloc.Apply(data, dictionary);
				_attrPending.Clear();
				_store.MarkDirty();
				if (Game.IsMaster())
				{
					_store.SaveNow();
				}
				_statsDirty = true;
				AttrApplied();
			}
			else
			{
				_store.SaveNow();
				_attrInFlight = dictionary;
				_attrPending.Clear();
				_attrRequestId++;
				_attrLateOk = false;
				_attrRetried = false;
				_attrSentAt = Time.unscaledTime;
				Net.SendAttributes(_attrRequestId, RunInfo.Key, AttributeAlloc.Encode(dictionary));
			}
		}

		public void OnAttributesResult(int requestId, bool ok, string reason, string totals)
		{
			_hostChecks = HostChecks.Yes;
			if (requestId != _attrRequestId || (_attrInFlight == null && (!ok || !_attrLateOk)))
			{
				return;
			}
			_attrLateOk = false;
			_attrInFlight = null;
			if (!ok)
			{
				AttrRejected(reason);
				return;
			}
			RunSave data = _store.Data;
			Dictionary<string, int> dictionary = AttributeAlloc.Decode(totals);
			if (dictionary != null)
			{
				foreach (KeyValuePair<string, int> item in dictionary)
				{
					AttributeDef attributeDef = AttributeAlloc.Find(item.Key);
					if (attributeDef != null)
					{
						data.SetAttribute(attributeDef.id, Mathf.Clamp(item.Value, 0, attributeDef.maxPoints));
					}
				}
			}
			_store.MarkDirty();
			_statsDirty = true;
			AttrApplied();
		}

		private void AttrApplied()
		{
			//IL_0017: Unknown result type (might be due to invalid IL or missing references)
			LoopTrace.Note("attribute points spent (applied)");
			MenuSound(UiSound.Confirm);
			Notify(PopupKind.Other, "Attributes updated", Accent);
			AttrNoteUnlocks();
		}

		private void AttrRejected(string reason)
		{
			//IL_0024: Unknown result type (might be due to invalid IL or missing references)
			_attrPending.Clear();
			_attrInFlight = null;
			MenuSound(UiSound.Error);
			Toast("Attributes not applied: " + reason, Bad, 4f);
			Plugin.Log.LogInfo((object)("Attribute allocation refused: " + reason + "."));
		}

		private void TickAttributes()
		{
			string key = RunInfo.Key;
			if (key != _attrRunKey)
			{
				_attrRunKey = key;
				_attrPending.Clear();
				_attrInFlight = null;
				_attrLateOk = false;
				DropAllPending();
				if (_dialogOpen)
				{
					_dialogOpen = false;
					_dialogAfter = null;
				}
			}
			if (AttrBusy && Time.unscaledTime - _attrSentAt > 5f)
			{
				if (!_attrRetried)
				{
					_attrRetried = true;
					_attrSentAt = Time.unscaledTime;
					Net.SendAttributes(_attrRequestId, RunInfo.Key, AttributeAlloc.Encode(_attrInFlight));
				}
				else
				{
					Plugin.Log.LogWarning((object)"[net] the host never answered an attribute confirm: not saved.");
					AttrRejected("couldn't reach the host");
					_attrLateOk = true;
				}
			}
		}

		private void OpenDialog(DialogKind kind, Action? after)
		{
			if (!_dialogOpen)
			{
				_dialogKind = kind;
				_dialogOpen = true;
				_dialogAfter = after;
				_dialogFocusSet = false;
				_dialogReturnFocus = _focusKey;
				CancelNumEdit();
				_holdKey = 0;
				_adjustKey = 0;
				_adjDec = (_adjInc = (_adjConfirm = null));
				_secondaryKey = 0;
				_secondaryAction = null;
				MenuSound(UiSound.Click);
			}
		}

		private void OpenLeaveDialog(Action after)
		{
			OpenDialog(DialogKind.Leave, after);
		}

		private void CloseDialog(DialogChoice choice)
		{
			if (!_dialogOpen)
			{
				return;
			}
			Action dialogAfter = _dialogAfter;
			DialogKind dialogKind = _dialogKind;
			_dialogOpen = false;
			_dialogAfter = null;
			_focusKey = _dialogReturnFocus;
			if (choice == DialogChoice.Cancel)
			{
				MenuSound(UiSound.Back);
				_playAsTarget = null;
				_salvageAsk = null;
				_salvageAskBulk = null;
				_craftPick = null;
				_purchaseAction = null;
				return;
			}
			switch (dialogKind)
			{
			case DialogKind.Purchase:
			{
				Action? purchaseAction = _purchaseAction;
				_purchaseAction = null;
				purchaseAction?.Invoke();
				return;
			}
			case DialogKind.Salvage:
				DoSalvageAsk();
				return;
			case DialogKind.PlayAs:
			{
				ClassDef playAsTarget = _playAsTarget;
				_playAsTarget = null;
				if (playAsTarget != null)
				{
					RequestClass(playAsTarget);
				}
				return;
			}
			}
			if (choice == DialogChoice.Confirm)
			{
				ConfirmAll();
				SettingsSync.SaveAll();
			}
			else
			{
				DiscardAll();
				SettingsSync.UndoAll();
				MenuSound(UiSound.Back);
			}
			dialogAfter?.Invoke();
		}

