		private void Update()
		{
			if (Guard.On("class host"))
			{
				Perf.Mark m = Perf.Start();
				try
				{
					UpdateMain();
				}
				catch (Exception e)
				{
					Guard.Fail("class host", e);
				}
				Perf.Stop(Perf.S.HostClass, m);
			}
		}

		private void UpdateMain()
		{
			//IL_0179: Unknown result type (might be due to invalid IL or missing references)
			//IL_017e: Unknown result type (might be due to invalid IL or missing references)
			if (Game.InLevel() && Game.IsLoading())
			{
				return;
			}
			Perf.Mark m = Perf.Start();
			ClassFx.Tick();
			try
			{
				ThirdWaveFx.TickSound();
				GunTuner.Tick();
				OverclockWeapons.Tick();
				HookFx.Tick();
				HookDebugDraw.Tick();
			}
			catch (Exception ex)
			{
				Game.WarnOnce("Class effects: " + ex.GetBaseException().Message);
			}
			TickClientCartLog();
			Perf.Stop(Perf.S.HostFx, m);
			Perf.Mark m2 = Perf.Start();
			if (Guard.On("synergies"))
			{
				try
				{
					Synergies.Tick();
				}
				catch (Exception e)
				{
					Guard.Fail("synergies", e);
				}
			}
			Perf.Stop(Perf.S.HostSynergies, m2);
			if (!Host || !Game.InLevel())
			{
				return;
			}
			float time = Time.time;
			if (time < _nextTick)
			{
				return;
			}
			_nextTick = time + 0.1f;
			Perf.Mark m3 = Perf.Start();
			RefreshScene();
			List<PlayerAvatar> list = Game.Players();
			TrackHolding(list);
			TickFields(time);
			TickBeacons(time);
			TickCharges(time);
			TickPlayerSpeeds(list, time);
			Perf.Stop(Perf.S.HostScene, m3);
			Perf.Mark m4 = Perf.Start();
			TickTeamHealth(list, time);
			Perf.Stop(Perf.S.HostTeamHealth, m4);
			Perf.Mark m5 = Perf.Start();
			TickPilots(time);
			Perf.Stop(Perf.S.HostPilots, m5);
			PhysGrabCart[] carts = _carts;
			foreach (PhysGrabCart val in carts)
			{
				if ((Object)(object)val == (Object)null)
				{
					continue;
				}
				string cls;
				PlayerAvatar val2 = CartPuller(val, out cls);
				if ((Object)(object)val2 == (Object)null)
				{
					continue;
				}
				Rigidbody component = ((Component)val).GetComponent<Rigidbody>();
				if ((Object)(object)component != (Object)null)
				{
					Vector3 linearVelocity = component.linearVelocity;
					if (((Vector3)(ref linearVelocity)).sqrMagnitude > 1f)
					{
						RamCheck(val, val2);
					}
				}
			}
			TickFloaters(time);
			TickThrown(time);
			Perf.Mark m6 = Perf.Start();
			if (Guard.On("perk host"))
			{
				try
				{
					TickPerks(list, time);
				}
				catch (Exception e2)
				{
					Guard.Fail("perk host", e2);
				}
			}
			Perf.Stop(Perf.S.HostPerks, m6);
			TickBets(time);
			for (int num = _zones.Count - 1; num >= 0; num--)
			{
				if (time >= _zones[num].End)
				{
					_zones.RemoveAt(num);
				}
			}
			TickBatteries(list);
			Perf.Mark m7 = Perf.Start();
			TickThirdWave(list, time);
			Perf.Stop(Perf.S.HostThirdWave, m7);
			if (!(time >= _nextSlow))
			{
				return;
			}
			_nextSlow = time + 1f;
			TickFalseSteps(list, time);
			TickCartFollowTargets(list);
			TickAbilityStates(list);
			foreach (PlayerAvatar item in list)
			{
				if ((Object)(object)item != (Object)null && (Object)(object)item != (Object)(object)Game.LocalPlayer())
				{
					ApplyGrabThrow(Game.ActorNumber(item));
				}
			}
		}

		private void FixedUpdate()
		{
			if (Host && Game.LevelReady() && Guard.On("class host physics"))
			{
				Perf.Mark m = Perf.Start();
				try
				{
					FixedMain();
				}
				catch (Exception e)
				{
					Guard.Fail("class host physics", e);
				}
				Perf.Stop(Perf.S.HostPhysics, m);
			}
		}

		private void FixedMain()
		{
			ScaleCartSpeed();
			DrivePilots();
			PullFields();
		}

		private static PhysGrabObject? HeldBy(PlayerAvatar p)
		{
			PhysGrabber physGrabber = p.physGrabber;
			if ((Object)(object)physGrabber == (Object)null || !Game.Get(physGrabber, "grabbed", fallback: false))
			{
				return null;
			}
			return Game.Get<PhysGrabObject>(physGrabber, "grabbedPhysGrabObject", null);
		}

		private void TrackHolding(List<PlayerAvatar> players)
		{
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player == (Object)null)
				{
					continue;
				}
				int num = Game.ActorNumber(player);
				string text = ClassStats.ClassOf(player);
				PhysGrabObject val = HeldBy(player);
				_held.TryGetValue(num, out PhysGrabObject value);
				if ((Object)(object)value != (Object)null && (Object)(object)value != (Object)(object)val)
				{
					OnReleased(player, text, value);
				}
				if ((Object)(object)val != (Object)null && (Object)(object)val != (Object)(object)value && _perkThrows.Count > 0)
				{
					PerkOnGrabbed(player, val);
				}
				bool fresh = (Object)(object)val != (Object)(object)value;
				_held[num] = val;
				if ((Object)(object)val == (Object)null)
				{
					continue;
				}
				AttrOnHolding(player, val, fresh);
				GearOnHolding(player, val, fresh);
				TeamPlay.HostHeld(val, num);
				if (text == "cartwright")
				{
					PhysGrabCart component = ((Component)val).GetComponent<PhysGrabCart>();
					if ((Object)(object)component != (Object)null)
					{
						_lastCart[num] = component;
					}
				}
				if (text == "physicist")
				{
					float num2 = Mathf.Clamp(ClassStats.Get(player, "physicist.held_mass"), 0f, 80f);
					if (num2 > 0f && (Object)(object)val.rb != (Object)null)
					{
						val.OverrideMass(Mathf.Max(0.1f, val.massOriginal * (1f - num2 / 100f)), 0.25f);
					}
					float num3 = ClassStats.Get(player, "physicist.held_drag");
					if (num3 > 0f)
					{
						val.OverrideAngularDrag(1f + num3 / 10f, 0.25f);
					}
				}
				float num4 = Mathf.Clamp(ClassStats.Get(player, "set.held_mass"), 0f, 60f);
				if (num4 > 0f && (Object)(object)val.rb != (Object)null && (Object)(object)((Component)val).GetComponent<ValuableObject>() != (Object)null)
				{
					val.OverrideMass(Mathf.Max(0.1f, val.massOriginal * (1f - num4 / 100f)), 0.25f);
				}
				if (text == "hauler" && Synergies.Has(player, "featherweight") && (Object)(object)val.rb != (Object)null)
				{
					val.OverrideMass(Mathf.Max(0.1f, val.massOriginal * (1f - Mathf.Clamp(Synergies.V("featherweight"), 0f, 50f) / 100f)), 0.25f);
				}
				if (text == "undertaker" && ClassStats.Get(player, "undertaker.head_guard") > 0f && (Object)(object)((Component)val).GetComponent<PlayerDeathHead>() != (Object)null)
				{
					val.OverrideIndestructible(0.25f);
				}
			}
		}

		private void OnReleased(PlayerAvatar p, string cls, PhysGrabObject obj)
		{
			//IL_001e: Unknown result type (might be due to invalid IL or missing references)
			//IL_0023: Unknown result type (might be due to invalid IL or missing references)
			if ((Object)(object)obj == (Object)null || (Object)(object)obj.rb == (Object)null)
			{
				return;
			}
			Vector3 linearVelocity = obj.rb.linearVelocity;
			bool flag = ((Vector3)(ref linearVelocity)).magnitude > 4f;
			bool flag2 = (Object)(object)((Component)obj).GetComponent<ValuableObject>() != (Object)null;
			float num = ((cls == "hauler") ? Mathf.Clamp(ClassStats.Get(p, "hauler.cap_conveyor"), 0f, 5f) : 0f);
			if (num > 0f && flag && flag2)
			{
				obj.OverrideIndestructible(num);
			}
			PerkOnReleased(p, obj, flag, flag2);
			if (cls == "physicist" && flag2)
			{
				float num2 = Mathf.Clamp(ClassStats.Get(p, "physicist.float_time"), 0f, 8f);
				if (num2 > 0f)
				{
					_floats.Add(new Floater
					{
						Obj = obj,
						End = Time.time + num2,
						Guard = Mathf.Clamp(ClassStats.Get(p, "physicist.float_guard"), 0f, 90f)
					});
				}
			}
			if (!flag)
			{
				return;
			}
			if (cls == "trickster" || cls == "physicist")
			{
				_thrown.Add(new Thrown
				{
					Obj = obj,
					By = p,
					Cls = cls,
					Start = Time.time,
					End = Time.time + 3f
				});
			}
			if (cls == "bloodbound")
			{
				float num3 = Mathf.Clamp(ClassStats.Get(p, "bloodbound.cost"), 0f, 20f);
				if (Synergies.Has(p, "transfusion"))
				{
					num3 = Mathf.Max(0f, num3 - Synergies.V("transfusion"));
				}
				if (num3 > 0f)
				{
					Net.SendNotice(p, Notice.BloodCost, num3, "");
				}
			}
		}

