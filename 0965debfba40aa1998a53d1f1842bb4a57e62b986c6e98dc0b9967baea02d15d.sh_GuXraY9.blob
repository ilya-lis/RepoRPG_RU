			}
			if (_tcDef != null && _tcLevel == RunInfo.LevelIndex && _tcState != 4)
			{
				Color val = default(Color);
				((Color)(ref val))..ctor(1f, 0.8f, 0.35f);
				lines.Add((_tcState switch
				{
					0 => "TEAM: " + _tcDef.name.ToUpperInvariant() + "  (" + TeamVoteCount().ToUpperInvariant() + ")", 
					1 => "TEAM: " + _tcDef.name.ToUpperInvariant() + (IsTeamParticipant() ? "" : "  (NOT IN IT)"), 
					2 => "[done] TEAM: " + _tcDef.name.ToUpperInvariant(), 
					_ => "[failed] TEAM: " + _tcDef.name.ToUpperInvariant(), 
				}, (Color)((_tcState == 3) ? new Color(0.6f, 0.6f, 0.6f) : ((_tcState == 2) ? new Color(0.6f, 1f, 0.6f) : val))));
				if (_tcState == 0 || _tcState == 1)
				{
					lines.Add((TeamContracts.Goal(_tcDef, _tcTarget).ToUpperInvariant(), new Color(0.95f, 0.85f, 0.6f)));
				}
				string text = TeamHaulLine();
				if (text != "" && _tcState != 0)
				{
