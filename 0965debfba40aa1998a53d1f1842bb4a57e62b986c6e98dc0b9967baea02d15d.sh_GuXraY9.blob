		private static void KeepCharging(ItemBattery bat, GameObject charger, float rate)
		{
			if (bat.batteryLife >= 99f)
			{
				ChargeRates.Remove(bat);
				return;
			}
			if (ChargeRates.TryGetValue(bat, out var value) && Mathf.Abs(value - rate) > 0.001f)
			{
				Game.Get<IList>(bat, "chargerList", null)?.Clear();
				Game.Set(bat, "chargeRate", 0f);
			}
			ChargeRates[bat] = rate;
			if (ChargeRates.Count > 64)
			{
				ChargeRates.Clear();
			}
			bat.ChargeBattery(charger, rate);
			Game.Set(bat, "chargeTimer", 0.25f);
		}

		private static string LedgerId(PlayerAvatar p)
		{
			string text = Game.SteamId(p);
			if (!string.IsNullOrEmpty(text))
			{
				return text;
			}
			if (!Game.IsMultiplayer())
			{
				return "local";
			}
			return "actor:" + Game.ActorNumber(p);
		}

		private AbilityLedger LedgerFor(PlayerAvatar p, out string id)
		{
			id = LedgerId(p);
			AbilityLedger value = (RunStore.IsTempKey(RunInfo.Key) ? null : SaveBook.Ledger(RunInfo.Key, id, Game.Get(p, "playerName", "")));
			string key = RunInfo.Key + "|" + id;
			if (value == null && !_memLedgers.TryGetValue(key, out value))
			{
				value = (_memLedgers[key] = new AbilityLedger());
			}
			bool flag = false;
			foreach (Bet bet in _bets)
			{
				if (bet.Id == id)
				{
					flag = true;
					break;
				}
			}
			if (value.betStake > 0.0 && !flag)
			{
				TakeScrap(id, Game.ActorNumber(p), value.betStake, "Unsettled bet");
				value.betStake = 0.0;
				SaveBook.MarkDirty();
			}
			if (value.level != RunInfo.LevelIndex)
			{
				value.level = RunInfo.LevelIndex;
				value.supplyUsed = 0;
				value.supplyBought = 0;
				value.supplied.Clear();
				value.betsUsed = 0;
				SaveBook.MarkDirty();
			}
			return value;
		}

		private static void TakeScrap(string id, int actor, double amount, string reason)
		{
			if (!(id == "") && !id.StartsWith("actor:"))
			{
				Scrap.HostTakeId(id, actor, amount, reason);
			}
		}

		private static float CopyScale(PlayerAvatar p)
		{
			return Mathf.Clamp(ClassStats.Get(p, "mimic.copy_power"), 10f, 100f) / 100f;
		}

		private static int SupplyCharges(PlayerAvatar p)
		{
			int value = Plugin.Cfg.ResupplyCharges.Value;
			if (ClassStats.ClassOf(p) == "mimic")
			{
				return Mathf.Max(1, Mathf.FloorToInt((float)value * CopyScale(p)));
			}
			return value + Mathf.Clamp(Mathf.FloorToInt(ClassStats.Get(p, "quartermaster.supply_extra") + 0.001f), 0, 3);
		}

		private static int BetUses(PlayerAvatar p)
		{
			int value = Plugin.Cfg.BetUsesPerLevel.Value;
			if (ClassStats.ClassOf(p) == "mimic")
			{
				return value;
			}
			return value + Mathf.Clamp(Mathf.FloorToInt(ClassStats.Get(p, "gambler.bet_uses") + 0.001f), 0, 3);
		}

		private int SupplyPrice(AbilityLedger l)
		{
			if (!Plugin.Cfg.ResupplyBuyWithScrap.Value)
			{
				return -1;
			}
			return Plugin.Cfg.ResupplyScrapPrice.Value + Plugin.Cfg.ResupplyScrapPriceStep.Value * l.supplyBought;
		}

		private void SendAbilityState(PlayerAvatar p, AbilityLedger l)
		{
			string text = ClassStats.ClassOf(p);
			int num = SupplyCharges(p);
			int num2 = BetUses(p);
			string text2 = $"{Mathf.Max(0, num - l.supplyUsed)}|{num}|{SupplyPrice(l)}|{Mathf.Max(0, num2 - l.betsUsed)}|{num2}|{l.level}";
			_stateSent[LedgerId(p) + "#" + Game.ActorNumber(p)] = text2.GetHashCode() ^ text.GetHashCode();
			Net.SendNotice(p, Notice.AbilityState, 0f, text2);
		}

		private void TickAbilityStates(List<PlayerAvatar> players)
		{
			foreach (PlayerAvatar player in players)
			{
				if ((Object)(object)player == (Object)null)
				{
					continue;
				}
				string text = ClassStats.ClassOf(player);
				string id;
				AbilityLedger abilityLedger = LedgerFor(player, out id);
				if (!(text != "quartermaster") || !(text != "gambler") || !(text != "mimic"))
				{
					int num = SupplyCharges(player);
					int num2 = BetUses(player);
					string text2 = $"{Mathf.Max(0, num - abilityLedger.supplyUsed)}|{num}|{SupplyPrice(abilityLedger)}|{Mathf.Max(0, num2 - abilityLedger.betsUsed)}|{num2}|{abilityLedger.level}";
					if (!_stateSent.TryGetValue(id + "#" + Game.ActorNumber(player), out var value) || value != (text2.GetHashCode() ^ text.GetHashCode()))
					{
						SendAbilityState(player, abilityLedger);
					}
				}
			}
		}

		private static void Refuse(PlayerAvatar p, string why)
		{
			if (why != "")
			{
				Net.SendNotice(p, Notice.Text, 0f, why);
			}
			Net.SendNotice(p, Notice.RefundAbility, 0f, "");
		}

		private static string ItemName(Component c)
