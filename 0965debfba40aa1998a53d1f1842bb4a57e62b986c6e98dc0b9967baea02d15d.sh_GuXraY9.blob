							}
						}
					}
					catch (Exception ex)
					{
						Game.WarnOnce("Hand-off release failed: " + ex.GetBaseException().Message);
					}
					((MonoBehaviour)this).StartCoroutine(HandOffMove(val, val2));
					return;
				}
			}
			Net.SendNotice(from, Notice.Text, 0f, "Hand-off: no teammate in reach");
		}

		private IEnumerator HandOffMove(PhysGrabObject obj, PlayerAvatar to)
		{
