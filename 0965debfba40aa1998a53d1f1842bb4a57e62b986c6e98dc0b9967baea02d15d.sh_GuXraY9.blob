			if (flag2)
			{
				bool num4 = HaggleMult(e.key) != 1f;
				bool haggledThisVisit = HaggledThisVisit;
				string label2 = ((!num4) ? (haggledThisVisit ? "Haggled this visit" : "Haggle (50/50)") : ((HaggleMult(e.key) < 1f) ? "Haggled: -25%" : "Haggled: +10%"));
				shopDetail.Act(label2, BtnKind.Secondary, !e.sold && open && !haggledThisVisit && e.key != "lock", delegate
				{
