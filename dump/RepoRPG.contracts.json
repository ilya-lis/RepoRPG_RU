{
  "version": 1,
  "givers": [
    {
      "id": "brass",
      "name": "Madame Brass",
      "title": "the Collector",
      "mono": "MB",
      "color": "#e0b048",
      "theme": "Rare valuables, careful hauls",
      "offer": [
        "Bring it back in one piece, darling. Pieces are worth less.",
        "I only collect the beautiful ones. Find me one.",
        "Money is vulgar. Valuables are art."
      ],
      "accept": [
        "Splendid. Do try not to sneeze on it.",
        "I knew you had taste.",
        "Gloves on, darling."
      ],
      "done": [
        "Exquisite. It goes on the mantel.",
        "You may kiss the ring. Metaphorically.",
        "My collection thanks you."
      ],
      "fail": [
        "Disappointing. Like a fake Fabergé.",
        "I'll pretend this never happened.",
        "Darling. No."
      ]
    },
    {
      "id": "kaboom",
      "name": "Kaboom & Sons",
      "title": "Demolition",
      "mono": "KS",
      "color": "#ff7a3c",
      "theme": "Monsters, elites, bosses",
      "offer": [
        "We don't do subtle. We do thorough.",
        "Dad says hit it until it stops moving.",
        "Family business since the first explosion."
      ],
      "accept": [
        "That's the spirit! Mind the shrapnel.",
        "Sons! We've got a live one!",
        "Earplugs are in the truck."
      ],
      "done": [
        "Beautiful mess. Dad's proud.",
        "Now THAT'S demolition.",
        "We'll frame the crater."
      ],
      "fail": [
        "Not even a dent? Really?",
        "Dad's not mad. Just loud.",
        "Back to the quarry with you."
      ]
    },
    {
      "id": "hollis",
      "name": "Hollis Underwood",
      "title": "Insurance Broker",
      "mono": "HU",
      "color": "#6fb7ff",
      "theme": "No deaths, no damage, no breakage",
      "offer": [
        "Risk is a four-letter word. Well. It's a word.",
        "Read the fine print. Then read it again.",
        "Accidents are just unpriced events."
      ],
      "accept": [
        "Signed in triplicate. Excellent.",
        "Your premium is... manageable.",
        "Try to stay in one piece. Contractually."
      ],
      "done": [
        "No claims! I may frame the form.",
        "A spotless record. Delicious.",
        "Actuarially speaking, you're a delight."
      ],
      "fail": [
        "That will raise your premium.",
        "I'm filing this under 'regrettable'.",
        "Please sign the incident report."
      ]
    },
    {
      "id": "dispatch",
      "name": "Dispatch",
      "title": "the Courier Union",
      "mono": "D",
      "color": "#7ddc6a",
      "theme": "Speed, extractions, getting home",
      "offer": [
        "Time is money. You're wasting both.",
        "Route's mapped. Clock's running.",
        "The Union delivers. So do you."
      ],
      "accept": [
        "Logged. Go go go.",
        "Clock in, semibot.",
        "Dispatch out."
      ],
      "done": [
        "On time. The Union salutes you.",
        "Signed, sealed, delivered.",
        "That's a bonus on the time sheet."
      ],
      "fail": [
        "Late. The Union remembers.",
        "Missed the window. Again.",
        "Union rule 1: don't be late."
      ]
    },
    {
      "id": "auditor",
      "name": "The Auditor",
      "title": "the Accountant of Last Resort",
      "mono": "AU",
      "color": "#9ad0ff",
      "theme": "High stakes, high pay - and a fine if you fail",
      "offer": [
        "Every figure checked twice. Every failure invoiced.",
        "The pay is generous. The penalty clause is too.",
        "Sign here. And here. And initial the fine print."
      ],
      "accept": [
        "Noted. Don't make me write a correction.",
        "The clock and I are both watching.",
        "Your signature is binding."
      ],
      "done": [
        "The books balance. Remarkable.",
        "Paid in full. I'm almost impressed.",
        "Filed under 'acceptable'."
      ],
      "fail": [
        "Invoiced. With interest.",
        "The penalty clause applies.",
        "I'll deduct it from your account."
      ]
    },
    {
      "id": "archivist",
      "name": "The Archivist",
      "title": "Keeper of the Research Archive",
      "mono": "AR",
      "color": "#40f2d9",
      "theme": "Research samples and specimens. Pays in Research Data",
      "offer": [
        "Knowledge is the only currency that keeps.",
        "Bring me something I have not catalogued.",
        "Samples, specimens, notes. Mind the glass."
      ],
      "accept": [
        "Catalogue number assigned.",
        "Handle the canisters gently.",
        "I will prepare a shelf."
      ],
      "done": [
        "Filed, indexed and cross-referenced.",
        "The archive grows. Thank you.",
        "A fine specimen. Your Data is sent."
      ],
      "fail": [
        "An empty shelf. A pity.",
        "The record will show nothing.",
        "We will try again next time."
      ]
    }
  ],
